er/configuration","tags":[],"type":"text","url":"/docs/server/configuration#memory_pool","content":"Reuse aligned buffers through the memory pool. Buffers are allocated on demand."},"3341":{"id":"/docs/server/configuration-375","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#memory_pool","content":"size"},"3342":{"id":"/docs/server/configuration-376","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#memory_pool","content":"\"4 GiB\""},"3343":{"id":"/docs/server/configuration-377","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#memory_pool","content":"Pool allocation budget, not a process memory limit. When the pool cannot supply a buffer within this budget, allocation continues outside it. Minimum 512 MiB; must be a multiple of 4096 (page size)."},"3344":{"id":"/docs/server/configuration-378","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#memory_pool","content":"bucket_capacity"},"3345":{"id":"/docs/server/configuration-379","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#memory_pool","content":"8192"},"3346":{"id":"/docs/server/configuration-380","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#memory_pool","content":"Maximum buffers per bucket. Must be a power of two; minimum 128."},"3347":{"id":"/docs/server/configuration-381","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#memory_pool","content":"The pool has 28 buckets with buffer sizes from 4 KiB to 512 MiB."},"3348":{"id":"/docs/server/configuration-382","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#data_maintenancemessages","content":"Key"},"3349":{"id":"/docs/server/configuration-383","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#data_maintenancemessages","content":"Default"},"3350":{"id":"/docs/server/configuration-384","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#data_maintenancemessages","content":"Description"},"3351":{"id":"/docs/server/configuration-385","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#data_maintenancemessages","content":"cleaner_enabled"},"3352":{"id":"/docs/server/configuration-386","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#data_maintenancemessages","content":"true"},"3353":{"id":"/docs/server/configuration-387","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#data_maintenancemessages","content":"Run the segment cleaner. It deletes the oldest sealed segments of topics with a finite message_expiry or max_topic_size, per partition, best-effort. The active segment is never touched, and stored consumer/group offsets can hold back deletion."},"3354":{"id":"/docs/server/configuration-388","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#data_maintenancemessages","content":"interval"},"3355":{"id":"/docs/server/configuration-389","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#data_maintenancemessages","content":"\"1 m\""},"3356":{"id":"/docs/server/configuration-390","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#data_maintenancemessages","content":"Cleaner run interval."},"3357":{"id":"/docs/server/configuration-391","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"Key"},"3358":{"id":"/docs/server/configuration-392","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"Default"},"3359":{"id":"/docs/server/configuration-393","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"Description"},"3360":{"id":"/docs/server/configuration-394","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"enabled"},"3361":{"id":"/docs/server/configuration-395","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"true"},"3362":{"id":"/docs/server/configuration-396","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"Verify client heartbeats."},"3363":{"id":"/docs/server/configuration-397","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"interval"},"3364":{"id":"/docs/server/configuration-398","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"\"30 s\""},"3365":{"id":"/docs/server/configuration-399","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"Expected heartbeat interval."},"3366":{"id":"/docs/server/configuration-400","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"When enabled, a connection that sends nothing (no request, no PING) for 1.2 x interval (36 s at the default) and still holds a consumer group membership has its session released, so its groups rebalance off it. The verifier checks once per interval, so eviction can occur later than the staleness threshold. A connection holding no membership is left alone and reaped when its socket closes."},"3367":{"id":"/docs/server/configuration-401","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"The Rust, Go, Python, Node, async Java, and C# TCP clients ping automatically every 5 s by default, well inside the staleness window. Call connect() to start the heartbeat in the Rust, Go, Python, and async Java high-level clients; logging in without it does not start their pingers. The blocking Java client has no automatic heartbeat, only a manual ping. Wherever nothing pings, an idle consumer group member is evicted, and only the application can keep it alive (ping) or bring it back (reconnect)."},"3368":{"id":"/docs/server/configuration-402","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"Server OTLP export is unavailable in this revision: grpc prevents startup, and http does not deliver logs or traces. Leave enabled = false."},"3369":{"id":"/docs/server/configuration-403","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"Key"},"3370":{"id":"/docs/server/configuration-404","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"Default"},"3371":{"id":"/docs/server/configuration-405","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"Description"},"3372":{"id":"/docs/server/configuration-406","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"enabled"},"3373":{"id":"/docs/server/configuration-407","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"false"},"3374":{"id":"/docs/server/configuration-408","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"Enable OpenTelemetry export."},"3375":{"id":"/docs/server/configuration-409","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"service_name"},"3376":{"id":"/docs/server/configuration-410","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"\"iggy\""},"3377":{"id":"/docs/server/configuration-411","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"Reported service name."},"3378":{"id":"/docs/server/configuration-412","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"telemetry.logs.transport"},"3379":{"id":"/docs/server/configuration-413","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"\"grpc\""},"3380":{"id":"/docs/server/configuration-414","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"Log export transport: \"grpc\" or \"http\"."},"3381":{"id":"/docs/server/configuration-415","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"telemetry.logs.endpoint"},"3382":{"id":"/docs/server/configuration-416","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"\"http://localhost:7281/v1/logs\""},"3383":{"id":"/docs/server/configuration-417","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"Log export endpoint."},"3384":{"id":"/docs/server/configuration-418","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"telemetry.traces.transport"},"3385":{"id":"/docs/server/configuration-419","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"\"grpc\""},"3386":{"id":"/docs/server/configuration-420","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"Trace export transport: \"grpc\" or \"http\"."},"3387":{"id":"/docs/server/configuration-421","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"telemetry.traces.endpoint"},"3388":{"id":"/docs/server/configuration-422","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"\"http://localhost:7281/v1/traces\""},"3389":{"id":"/docs/server/configuration-423","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"Trace export endpoint."},"3390":{"id":"/docs/server/configuration-424","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"Key"},"3391":{"id":"/docs/server/configuration-425","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"Default"},"3392":{"id":"/docs/server/configuration-426","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"Description"},"3393":{"id":"/docs/server/configuration-427","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"cpu_allocation"},"3394":{"id":"/docs/server/configuration-428","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"\"numa:auto\""},"3395":{"id":"/docs/server/configuration-429","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"Number of shards and their CPU affinity. See syntaxes below."},"3396":{"id":"/docs/server/configuration-430","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"pin_cores"},"3397":{"id":"/docs/server/configuration-431","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"true"},"3398":{"id":"/docs/server/configuration-432","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"Pin shard threads to dedicated cores, drawn from the process's allowed CPU set (cooperates with systemd AllowedCPUs= and container cpusets). Set false on hosts where the server shares cores with other workloads."},"3399":{"id":"/docs/server/configuration-433","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"inbox_capacity"},"3400":{"id":"/docs/server/configuration-434","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"1024"},"3401":{"id":"/docs/server/configuration-435","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"Per-shard inbox capacity for consensus, connection setup, and reconciliation. Raising [metadata] or [partition] prepare_queue_depth raises the capacity needed here."},"3402":{"id":"/docs/server/configuration-436","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"reply_inbox_capacity"},"3403":{"id":"/docs/server/configuration-437","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"1024"},"3404":{"id":"/docs/server/configuration-438","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"Separate per-shard channel for forwarded client replies. Size for peak reply fan-out; dropped replies have no bus retransmission."},"3405":{"id":"/docs/server/configuration-439","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"shutdown_drain_timeout"},"3406":{"id":"/docs/server/configuration-440","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"\"10 s\""},"3407":{"id":"/docs/server/configuration-441","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"Per-shard bus drain budget on shutdown. Slow-fsync hosts may need more."},"3408":{"id":"/docs/server/configuration-442","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"shutdown_poll_interval"},"3409":{"id":"/docs/server/configuration-443","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"\"50 ms\""},"3410":{"id":"/docs/server/configuration-444","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"Poll cadence for the shutdown flag. Must be less than or equal to shutdown_drain_timeout."},"3411":{"id":"/docs/server/configuration-445","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"shutdown_join_timeout"},"3412":{"id":"/docs/server/configuration-446","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"\"30 s\""},"3413":{"id":"/docs/server/configuration-447","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"Hard deadline for joining shard threads at exit; a wedged shard is abandoned with an error log. Must be at least shutdown_drain_timeout."},"3414":{"id":"/docs/server/configuration-448","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"reconcile_periodic_interval"},"3415":{"id":"/docs/server/configuration-449","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"\"1 s\""},"3416":{"id":"/docs/server/configuration-450","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"Safety tick for the partition reconciliation loop, which also wakes on every metadata commit."},"3417":{"id":"/docs/server/configuration-451","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"Valid cpu_allocation syntaxes:"},"3418":{"id":"/docs/server/configuration-452","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"\"all\": one shard per available CPU core"},"3419":{"id":"/docs/server/configuration-453","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"a number, e.g. 4: four shards on the first four CPUs in the process's allowed set when pin_cores is enabled"},"3420":{"id":"/docs/server/configuration-454","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"a range, e.g. \"5..8\": three shards on cores 5, 6, 7"},"3421":{"id":"/docs/server/configuration-455","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"\"numa:auto\": all NUMA nodes and cores, NUMA-aware"},"3422":{"id":"/docs/server/configuration-456","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"\"numa:nodes=0,1;cores=4;no_ht=true\": NUMA nodes 0 and 1, four cores each, no hyperthreads"},"3423":{"id":"/docs/server/configuration-457","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"Tunables for the metadata consensus plane (shard 0's VSR replica: users, streams, topics, sessions)."},"3424":{"id":"/docs/server/configuration-458","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"Key"},"3425":{"id":"/docs/server/configuration-459","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"Default"},"3426":{"id":"/docs/server/configuration-460","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"Description"},"3427":{"id":"/docs/server/configuration-461","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"prepare_queue_depth"},"3428":{"id":"/docs/server/configuration-462","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"32"},"3429":{"id":"/docs/server/configuration-463","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"Uncommitted metadata ops in flight at once. Submits beyond it are rejected with a transient error the SDKs retry. Capped at 127 by the view-change wire format."},"3430":{"id":"/docs/server/configuration-464","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"journal_slots"},"3431":{"id":"/docs/server/configuration-465","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"1024"},"3432":{"id":"/docs/server/configuration-466","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"In-memory index of the metadata WAL, in slots. Larger buys more headroom between forced checkpoints at the cost of memory and bigger WAL rewrites. Boot enforces journal_slots >= 4 x max(64, prepare_queue_depth)."},"3433":{"id":"/docs/server/configuration-467","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"clients_table_max"},"3434":{"id":"/docs/server/configuration-468","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"8192"},"3435":{"id":"/docs/server/configuration-469","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"Slots in the VSR client table: how many distinct clients (TCP/QUIC/WebSocket virtual clients and HTTP sessions together) hold live session state. When full, the client with the oldest last commit is evicted and re-registers on its next request. The HTTP session cap tracks this at half. Must be between 2 and 65536."},"3436":{"id":"/docs/server/configuration-470","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Partition storage and consensus tunables share this table. Unlike [metadata] (one plane on shard 0), a pipeline exists per partition, so raising per-partition budgets multiplies resource use by the partition count."},"3437":{"id":"/docs/server/configuration-471","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"durability, consumer_offset_durability, segment size, preallocation, and the message/byte flush thresholds are topic creation options. wal_bytes_max sizes the persistence machinery without selecting the topic's completion policy."},"3438":{"id":"/docs/server/configuration-472","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Key"},"3439":{"id":"/docs/server/configuration-473","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Default"},"3440":{"id":"/docs/server/configuration-474","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Description"},"3441":{"id":"/docs/server/configuration-475","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"prepare_queue_depth"},"3442":{"id":"/docs/server/configuration-476","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"32"},"3443":{"id":"/docs/server/configuration-477","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Uncommitted produce and consumer-offset ops in flight per partition. Submits past it spill into a request queue of twice this depth; once both are full the server rejects the request with TransientNotAccepted. A lost rejection reply can still make the client wait for its timeout. Must be between 1 and 127."},"3444":{"id":"/docs/server/configuration-478","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"validate_checksum"},"3445":{"id":"/docs/server/configuration-479","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"true"},"3446":{"id":"/docs/server/configuration-480","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Re-hash batches read from segment storage and report a mismatch instead of serving them."},"3447":{"id":"/docs/server/configuration-481","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"wal_bytes_max"},"3448":{"id":"/docs/server/configuration-482","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"\"256 MiB\""},"3449":{"id":"/docs/server/configuration-483","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Active WAL plus queued/in-flight prepare budget per multi-replica partition when either topic policy is persisted. A 4 KiB multiple, from 128 MiB + 8 KiB through 4 GiB. Checkpointing reclaims history only after materialized state is synchronized. Temporary rewrites require extra disk space. Environment override: IGGY_PARTITION_WAL_BYTES_MAX."},"3450":{"id":"/docs/server/configuration-484","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"dedup_clients_max"},"3451":{"id":"/docs/server/configuration-485","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"4096"},"3452":{"id":"/docs/server/configuration-486","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Client request watermarks retained per partition to deduplicate retries. At capacity, the client with the oldest latest commit is evicted and loses that coverage. Between 1 and 65536."},"3453":{"id":"/docs/server/configuration-487","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"consumer_offsets_max"},"3454":{"id":"/docs/server/configuration-488","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"4096"},"3455":{"id":"/docs/server/configuration-489","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Durable offset keys admitted per partition, counted separately for standalone consumers and groups. Existing keys remain writable at the limit; new keys are rejected with TooManyConsumerOffsets. Between 1 and 262144."},"3456":{"id":"/docs/server/configuration-490","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"offset_reservation_lease"},"3457":{"id":"/docs/server/configuration-491","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"65536"},"3458":{"id":"/docs/server/configuration-492","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Offsets reserved ahead in the superblock for single-replica partitions. Crash recovery skips the unused reservation to avoid reusing acknowledged offsets. Multi-replica groups ignore it. Between 1 and 16777216."},"3459":{"id":"/docs/server/configuration-493","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"evicted_ring_capacity"},"3460":{"id":"/docs/server/configuration-494","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"4096"},"3461":{"id":"/docs/server/configuration-495","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Entries retained per multi-replica partition for journal repair after a peer rejoins. Must be between 1 and 65536. Single-replica partitions retain nothing."},"3462":{"id":"/docs/server/configuration-496","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"evicted_ring_bytes_max"},"3463":{"id":"/docs/server/configuration-497","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"\"16 MiB\""},"3464":{"id":"/docs/server/configuration-498","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Byte ceiling for the evicted ring; whichever ring cap trips first evicts. At most \"256 MiB\"."},"3465":{"id":"/docs/server/configuration-499","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"transfer_served_cache_bytes_max"},"3466":{"id":"/docs/server/configuration-500","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"\"2176 MiB\""},"3467":{"id":"/docs/server/configuration-501","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Byte budget, per shard, for segment payloads kept resident to serve state-transfer chunk requests. The default fits two sealed segments at the 1 GiB ceiling, each with one max-message overshoot. Serving concurrency is floor(this / max(transfer_artifact_bytes_max, 1 GiB + 64 MiB)), minimum one; boot warns when it drops below two. At most \"64 GiB\"."},"3468":{"id":"/docs/server/configuration-502","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"transfer_artifact_bytes_max"},"3469":{"id":"/docs/server/configuration-503","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"\"1088 MiB\""},"3470":{"id":"/docs/server/configuration-504","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Allocation ceiling for one received state-transfer artifact, per shard (up to four transfers run at once). Boot enforces the floor 1 GiB + message_bus.max_message_size; the shipped value sits exactly at it. Raising message_bus.max_message_size alone therefore refuses boot: raise this by the same amount in the same edit. At most \"64 GiB\"."},"3471":{"id":"/docs/server/configuration-505","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Tunables for the internal bus that ships consensus traffic between replicas and client traffic between shards."},"3472":{"id":"/docs/server/configuration-506","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Key"},"3473":{"id":"/docs/server/configuration-507","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Default"},"3474":{"id":"/docs/server/configuration-508","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Description"},"3475":{"id":"/docs/server/configuration-509","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"max_batch"},"3476":{"id":"/docs/server/configuration-510","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"256"},"3477":{"id":"/docs/server/configuration-511","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Messages coalesced into one writev(2) call. Hard upper bound 512 (IOV_MAX/2 on Linux)."},"3478":{"id":"/docs/server/configuration-512","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"max_message_size"},"3479":{"id":"/docs/server/configuration-513","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"\"64 MiB\""},"3480":{"id":"/docs/server/configuration-514","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Wire-level cap on a single framed message, at most \"256 MiB\". Values above \"64 MiB\" exceed the Go SDK's frame limit. Coupled to partition.transfer_artifact_bytes_max and websocket.max_message_size (see those keys)."},"3481":{"id":"/docs/server/configuration-515","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"peer_queue_capacity"},"3482":{"id":"/docs/server/configuration-516","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"256"},"3483":{"id":"/docs/server/configuration-517","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Bound on the per-peer queue. cluster.repair_chunk_max must stay strictly below it."},"3484":{"id":"/docs/server/configuration-518","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"reconnect_period"},"3485":{"id":"/docs/server/configuration-519","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"\"5 s\""},"3486":{"id":"/docs/server/configuration-520","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Interval between outbound reconnect attempts to peers."},"3487":{"id":"/docs/server/configuration-521","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"close_peer_timeout"},"3488":{"id":"/docs/server/configuration-522","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"\"2 s\""},"3489":{"id":"/docs/server/configuration-523","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Per-peer close drain budget before force-cancellation."},"3490":{"id":"/docs/server/configuration-524","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"close_grace"},"3491":{"id":"/docs/server/configuration-525","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"\"2 s\""},"3492":{"id":"/docs/server/configuration-526","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Bound on a single stream shutdown in the TLS-family transports."},"3493":{"id":"/docs/server/configuration-527","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"handshake_grace"},"3494":{"id":"/docs/server/configuration-528","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"\"10 s\""},"3495":{"id":"/docs/server/configuration-529","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Bound on a connection's handshake phase, so a slowloris peer cannot pin per-connection resources indefinitely."},"3496":{"id":"/docs/server/configuration-530","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"Key"},"3497":{"id":"/docs/server/configuration-531","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"Default"},"3498":{"id":"/docs/server/configuration-532","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"Description"},"3499":{"id":"/docs/server/configuration-533","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"max_tokens_per_user"},"3500":{"id":"/docs/server/configuration-534","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"100"},"3501":{"id":"/docs/server/configuration-535","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"Maximum active tokens per user."},"3502":{"id":"/docs/server/configuration-536","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"personal_access_token.cleaner.enabled"},"3503":{"id":"/docs/server/configuration-537","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"true"},"3504":{"id":"/docs/server/configuration-538","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"Periodically remove expired tokens."},"3505":{"id":"/docs/server/configuration-539","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"personal_access_token.cleaner.interval"},"3506":{"id":"/docs/server/configuration-540","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"\"1 m\""},"3507":{"id":"/docs/server/configuration-541","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"Cleaner run interval."},"3508":{"id":"/docs/server/configuration-542","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#consumer_group","content":"Key"},"3509":{"id":"/docs/server/configuration-543","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#consumer_group","content":"Default"},"3510":{"id":"/docs/server/configuration-544","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#consumer_group","content":"Description"},"3511":{"id":"/docs/server/configuration-545","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#consumer_group","content":"rebalancing_timeout"},"3512":{"id":"/docs/server/configuration-546","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#consumer_group","content":"\"30s\""},"3513":{"id":"/docs/server/configuration-547","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#consumer_group","content":"Maximum time a partition can remain in pending revocation before being force-transferred to the target member."},"3514":{"id":"/docs/server/configuration-548","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#node","content":"This node's own client-facing identity. The address is read only while cluster.enabled = false: in cluster mode the roster answers the same question per node, so the address itself is ignored and the server says so at startup. The key is still validated in every mode, so a malformed value refuses boot even with cluster.enabled = true."},"3515":{"id":"/docs/server/configuration-549","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#node","content":"Key"},"3516":{"id":"/docs/server/configuration-550","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#node","content":"Default"},"3517":{"id":"/docs/server/configuration-551","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#node","content":"Description"},"3518":{"id":"/docs/server/configuration-552","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#node","content":"advertised_address"},"3519":{"id":"/docs/server/configuration-553","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#node","content":"unset"},"3520":{"id":"/docs/server/configuration-554","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#node","content":"The address clients dial, published in cluster metadata. A literal IP or a DNS hostname. Left unset, the server derives it from the bind address of the first enabled listener; that fails when the listener binds a wildcard, and the server refuses to start rather than publish an address no client can use. Declaring the unspecified address (0.0.0.0, ::) is refused for the same reason."},"3521":{"id":"/docs/server/configuration-555","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Cluster mode is configured here but documented in Clustering. The section contains:"},"3522":{"id":"/docs/server/configuration-556","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Key"},"3523":{"id":"/docs/server/configuration-557","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Default"},"3524":{"id":"/docs/server/configuration-558","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"One-liner"},"3525":{"id":"/docs/server/configuration-559","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"enabled"},"3526":{"id":"/docs/server/configuration-560","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"false"},"3527":{"id":"/docs/server/configuration-561","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Participate in a cluster. Requires --replica-id at launch."},"3528":{"id":"/docs/server/configuration-562","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"name"},"3529":{"id":"/docs/server/configuration-563","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"iggy-cluster\""},"3530":{"id":"/docs/server/configuration-564","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Permanent cluster identity, hashed into every superblock on first boot. Renaming against existing data refuses start."},"3531":{"id":"/docs/server/configuration-565","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"heartbeat_timeout"},"3532":{"id":"/docs/server/configuration-566","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"5s\""},"3533":{"id":"/docs/server/configuration-567","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Primary liveness window; a silent primary triggers a view change. At least \"2s\" and at least 4 x commit_broadcast_interval."},"3534":{"id":"/docs/server/configuration-568","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"commit_broadcast_interval"},"3535":{"id":"/docs/server/configuration-569","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"500ms\""},"3536":{"id":"/docs/server/configuration-570","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"How often the primary broadcasts its commit point; this is the liveness signal."},"3537":{"id":"/docs/server/configuration-571","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"prepare_retransmit_interval"},"3538":{"id":"/docs/server/configuration-572","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"250ms\""},"3539":{"id":"/docs/server/configuration-573","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Retransmit cadence for unacknowledged prepares."},"3540":{"id":"/docs/server/configuration-574","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"view_change_retransmit_interval"},"3541":{"id":"/docs/server/configuration-575","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"500ms\""},"3542":{"id":"/docs/server/configuration-576","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Retransmit cadence during a view change."},"3543":{"id":"/docs/server/configuration-577","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"view_change_status_timeout"},"3544":{"id":"/docs/server/configuration-578","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"5s\""},"3545":{"id":"/docs/server/configuration-579","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Backstop for a stalled view change; escalates to a fresh election. At least 4 x view_change_retransmit_interval."},"3546":{"id":"/docs/server/configuration-580","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"request_start_view_retransmit_interval"},"3547":{"id":"/docs/server/configuration-581","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"1s\""},"3548":{"id":"/docs/server/configuration-582","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Re-request cadence for the current view's StartView."},"3549":{"id":"/docs/server/configuration-583","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"view_probe_attempts_max"},"3550":{"id":"/docs/server/configuration-584","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"5"},"3551":{"id":"/docs/server/configuration-585","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Unanswered probes a recovering replica tolerates before electing on its recovered log. Between 1 and 100."},"3552":{"id":"/docs/server/configuration-586","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"repair_retry_interval"},"3553":{"id":"/docs/server/configuration-587","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"1s\""},"3554":{"id":"/docs/server/configuration-588","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Re-request cadence for a stalled journal-repair stream."},"3555":{"id":"/docs/server/configuration-589","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"repair_gap_debounce_interval"},"3556":{"id":"/docs/server/configuration-590","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"1s\""},"3557":{"id":"/docs/server/configuration-591","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"How long a committed journal gap waits before repair starts, floored at 500 ms. Nonzero. Separate from retries of an already-open repair stream."},"3558":{"id":"/docs/server/configuration-592","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"repair_chunk_max"},"3559":{"id":"/docs/server/configuration-593","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"128"},"3560":{"id":"/docs/server/configuration-594","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Prepares served per repair round. Must stay strictly below message_bus.peer_queue_capacity. Between 1 and 1024."},"3561":{"id":"/docs/server/configuration-595","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"superblock_wedged_fatal_timeout"},"3562":{"id":"/docs/server/configuration-596","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"2m\""},"3563":{"id":"/docs/server/configuration-597","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Exit if a metadata or partition superblock remains unwritable past this window. \"0\" leaves it fenced indefinitely; nonzero values must be at least \"30s\"."},"3564":{"id":"/docs/server/configuration-598","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Durations are rounded down to the consensus 10 ms tick. Values under 10 ms become one tick."},"3565":{"id":"/docs/server/configuration-599","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Sub-sections:"},"3566":{"id":"/docs/server/configuration-600","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"[cluster.auth]: replica-to-replica authentication (PSK plus BLAKE3 keyed-MAC handshake). shared_secret must be at least 32 bytes of CSPRNG output, identical on every node. Prefer IGGY_CLUSTER_AUTH_SHARED_SECRET. previous_shared_secret enables rolling key rotation."},"3567":{"id":"/docs/server/configuration-601","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"[cluster.coordinator]: skip_shard_zero_for_replicas = true and skip_shard_zero_for_clients = false control connection placement when more than one shard runs."},"3568":{"id":"/docs/server/configuration-602","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"[cluster.tls]: TLS 1.3 on the replica port. Requires cluster.auth.enabled. The PSK authenticates the peer, TLS supplies confidentiality."},"3569":{"id":"/docs/server/configuration-603","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"[[cluster.nodes]]: the full roster, byte-identical on every node. Each entry has name, ip, replica_id, and ports (tcp, quic, http, websocket, tcp_replica). In cluster mode ports is the single source of listener ports: tcp and tcp_replica ports are always required, and every other enabled transport also needs an explicit per-node port or the server refuses to start. advertised_address and per-CIDR advertised_addresses selectors control what clients are told to dial."},"3570":{"id":"/docs/server/docker","page_id":"/docs/server/docker","type":"page","content":"Docker & Helm","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/docker"},"3571":{"id":"/docs/server/docker-0","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker","content":"Run the Iggy server from the official Docker images, and deploy it with the Helm chart."},"3572":{"id":"/docs/server/docker-1","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#docker","content":"Docker"},"3573":{"id":"/docs/server/docker-2","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#why-these-capabilities","content":"Why these capabilities?"},"3574":{"id":"/docs/server/docker-3","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#available-images","content":"Available images"},"3575":{"id":"/docs/server/docker-4","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#building-from-source","content":"Building from source"},"3576":{"id":"/docs/server/docker-5","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#running-the-cli-inside-the-container","content":"Running the CLI inside the container"},"3577":{"id":"/docs/server/docker-6","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#helm-charts","content":"Helm charts"},"3578":{"id":"/docs/server/docker-7","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#quick-start","content":"Quick start"},"3579":{"id":"/docs/server/docker-8","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#chart-components","content":"Chart components"},"3580":{"id":"/docs/server/docker-9","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#key-values","content":"Key values"},"3581":{"id":"/docs/server/docker-10","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"You can easily run the Iggy server with Docker - the official images can be found here, use docker pull apache/iggy:0.9.0, or apache/iggy:latest for the newest stable release."},"3582":{"id":"/docs/server/docker-11","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"These properties of the published image matter for deployment:"},"3583":{"id":"/docs/server/docker-12","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"The working directory is /app and the iggy-server and iggy binaries are on PATH (/usr/local/bin). The default data directory local_data therefore resolves to /app/local_data - mount your volume there, or set IGGY_PATH and mount that path instead."},"3584":{"id":"/docs/server/docker-13","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"The image bakes in no address overrides, so the server binds the loopback defaults (127.0.0.1) and is unreachable from outside the container even with published ports. Set IGGY_TCP_ADDRESS=0.0.0.0:8090 (and the equivalent for every other transport you expose) alongside the -p flags."},"3585":{"id":"/docs/server/docker-14","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"The wildcard says nothing about where clients reach the container, so the server refuses to start until IGGY_NODE_ADVERTISED_ADDRESS supplies that address. Use localhost when the ports are published to the host, the compose service name when the clients are containers on the same network, and the external hostname or load balancer name when they are further away. The value reaches clients through cluster metadata, where it is the endpoint they reconnect through."},"3586":{"id":"/docs/server/docker-15","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"Below is an example docker-compose.yml which overrides the default configuration (see Configuration) with environment variables. If you prefer using the configuration file, you can mount it as a volume and provide the path to it with the IGGY_CONFIG_PATH environment variable."},"3587":{"id":"/docs/server/docker-16","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"The examples use a permissive syscall profile and unlimited locked memory for development. Production deployments can use a custom seccomp profile and a finite locked-memory budget that permit the server's required operations. See Linux tuning."},"3588":{"id":"/docs/server/docker-17","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"Or when running with docker run:"},"3589":{"id":"/docs/server/docker-18","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#why-these-capabilities","content":"SYS_NICE broadens scheduling and NUMA permissions. Pinning a thread owned by the process with sched_setaffinity does not by itself require this capability; container policies can impose additional restrictions. See Linux affinity permissions."},"3590":{"id":"/docs/server/docker-19","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#why-these-capabilities","content":"seccomp:unconfined permits io_uring calls blocked by Docker's default seccomp profile. A custom profile allowing the required syscalls is an alternative to disabling filtering. See Docker seccomp profiles."},"3591":{"id":"/docs/server/docker-20","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#why-these-capabilities","content":"memlock: -1 removes the process's locked-memory limit. A finite limit is valid if it covers the runtime's requirements; neither setting overrides the container's memory limit."},"3592":{"id":"/docs/server/docker-21","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#why-these-capabilities","content":"Host kernel 5.19 or newer is required. Containers use the host's kernel, so these settings alone are not enough. See System requirements."},"3593":{"id":"/docs/server/docker-22","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Image"},"3594":{"id":"/docs/server/docker-23","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Description"},"3595":{"id":"/docs/server/docker-24","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"apache/iggy"},"3596":{"id":"/docs/server/docker-25","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Server + CLI"},"3597":{"id":"/docs/server/docker-26","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"apache/iggy-web-ui"},"3598":{"id":"/docs/server/docker-27","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Standalone Web UI"},"3599":{"id":"/docs/server/docker-28","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"apache/iggy-connect"},"3600":{"id":"/docs/server/docker-29","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Connectors runtime"},"3601":{"id":"/docs/server/docker-30","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"apache/iggy-mcp"},"3602":{"id":"/docs/server/docker-31","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"MCP server"},"3603":{"id":"/docs/server/docker-32","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"apache/iggy-bench-dashboard"},"3604":{"id":"/docs/server/docker-33","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Benchmark dashboard (server + WASM frontend)"},"3605":{"id":"/docs/server/docker-34","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Images tagged latest are based on stable releases. Images tagged edge are built from the latest master branch."},"3606":{"id":"/docs/server/docker-35","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#building-from-source","content":"The repository root carries its own Dockerfile and docker-compose.yml for building from source (a multi-stage build: Rust compilation including the Web UI, then a minimal runtime image):"},"3607":{"id":"/docs/server/docker-36","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#building-from-source","content":"Or use docker compose up directly from the repository root. That image differs from the published one: it sets the 0.0.0.0 address of all four listeners via ENV and keeps its data at /local_data. Those wildcards are baked into the image, so a plain docker run of it refuses to start until you pass IGGY_NODE_ADVERTISED_ADDRESS yourself. The repository's compose file publishes the ports to the host, so it declares IGGY_NODE_ADVERTISED_ADDRESS=localhost."},"3608":{"id":"/docs/server/docker-37","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#running-the-cli-inside-the-container","content":"The iggy CLI is on PATH in the official image. With the compose example above (container iggy, password Secret123):"},"3609":{"id":"/docs/server/docker-38","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#helm-charts","content":"Helm charts for Kubernetes deployment are available in the repository. Almost everything server-related nests under the server: key in values.yaml. The chart also bundles a Web UI deployment under ui:."},"3610":{"id":"/docs/server/docker-39","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"Server Deployment - runs apache/iggy with the pod security context the server needs: seccomp profile Unconfined (for io_uring) plus the IPC_LOCK capability (for memory locking). Listener addresses are set to 0.0.0.0 via server.env, and the data volume mounts at /app/local_data. The chart supplies IGGY_NODE_ADVERTISED_ADDRESS as the in-cluster Service DNS name; override it with server.advertisedAddress when clients arrive through a LoadBalancer or an Ingress. The server image tag defaults to the chart's appVersion (0.9.0-edge.6 in this source revision). The quick start selects 0.9.0 explicitly."},"3611":{"id":"/docs/server/docker-40","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"Server Service - exposes the http (3000), quic (8080/UDP), tcp (8090), and websocket (8092) ports."},"3612":{"id":"/docs/server/docker-41","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"Web UI Deployment + Service - a separate apache/iggy-web-ui deployment on port 3050, enabled by default (ui.enabled)."},"3613":{"id":"/docs/server/docker-42","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"Secret - root user credentials from server.users.root (default iggy/changeit). Point server.users.root.existingSecret.name at your own Secret in production; usernameKey and passwordKey select its keys."},"3614":{"id":"/docs/server/docker-43","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"PersistentVolumeClaim - storage for /app/local_data, disabled by default (server.persistence.enabled), 8Gi when enabled."},"3615":{"id":"/docs/server/docker-44","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"ServiceAccount and Ingress - a shared ServiceAccount and separate optional server/UI ingresses. The chart has no HPA template. Server replicaCount must not exceed 1; cluster mode uses one release per node, each with its own replica ID and storage."},"3616":{"id":"/docs/server/docker-45","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"ServiceMonitor - Prometheus scrape config (optional). The /metrics endpoint requires a bearer credential like every other read, so wire a token (e.g. a personal access token stored in a Secret) into server.serviceMonitor.authorization - an unauthenticated scrape gets 401."},"3617":{"id":"/docs/server/docker-46","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#key-values","content":"Save the excerpt as my-values.yaml, customize it for your environment, and deploy with:"},"3618":{"id":"/docs/server/durability","page_id":"/docs/server/durability","type":"page","content":"Durability","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/durability"},"3619":{"id":"/docs/server/durability-0","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability","content":"What a completed write guarantees, how to select topic durability, and what survives a single-node crash."},"3620":{"id":"/docs/server/durability-1","page_id":"/docs/server/durability","type":"heading","tags":[],"url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"Select the policy when creating the topic"},"3621":{"id":"/docs/server/durability-2","page_id":"/docs/server/durability","type":"heading","tags":[],"url":"/docs/server/durability#the-single-node-write-path","content":"The single-node write path"},"3622":{"id":"/docs/server/durability-3","page_id":"/docs/server/durability","type":"heading","tags":[],"url":"/docs/server/durability#flush-scheduling-is-separate","content":"Flush scheduling is separate"},"3623":{"id":"/docs/server/durability-4","page_id":"/docs/server/durability","type":"heading","tags":[],"url":"/docs/server/durability#what-survives-a-failure","content":"What survives a failure"},"3624":{"id":"/docs/server/durability-5","page_id":"/docs/server/durability","type":"heading","tags":[],"url":"/docs/server/durability#which-responses-prove-completion","content":"Which responses prove completion"},"3625":{"id":"/docs/server/durability-6","page_id":"/docs/server/durability","type":"heading","tags":[],"url":"/docs/server/durability#recovery-and-cost","content":"Recovery and cost"},"3626":{"id":"/docs/server/durability-7","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability","content":"A successful write has the guarantee selected by the topic's durability\noption. The default, replicated, waits for consensus commit and local\napplication without an additional stable-storage barrier. persisted also\nrequires a recoverable copy on stable storage at the replication quorum."},"3627":{"id":"/docs/server/durability-8","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability","content":"Both policies write data to disk. The difference is what must have\ncompleted before the server reports success. On a single node the quorum is\none, so replicated provides no second copy and can acknowledge messages\nthat exist only in the server process's memory. For multiple replicas, see\nCluster Durability."},"3628":{"id":"/docs/server/durability-9","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"Topic option"},"3629":{"id":"/docs/server/durability-10","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"Default"},"3630":{"id":"/docs/server/durability-11","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"Controls"},"3631":{"id":"/docs/server/durability-12","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"durability"},"3632":{"id":"/docs/server/durability-13","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"replicated"},"3633":{"id":"/docs/server/durability-14","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"Message production"},"3634":{"id":"/docs/server/durability-15","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"consumer_offset_durability"},"3635":{"id":"/docs/server/durability-16","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"replicated"},"3636":{"id":"/docs/server/durability-17","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"Explicit consumer-offset stores and deletes"},"3637":{"id":"/docs/server/durability-18","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"Both accept replicated or persisted. They default independently:\nsetting durability=persisted leaves consumer offsets at replicated\nunless that option is also supplied. Neither inherits the other."},"3638":{"id":"/docs/server/durability-19","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"For persisted messages and consumer offsets, create a topic in an existing\nstream:"},"3639":{"id":"/docs/server/durability-20","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"These are topic creation options, not\nconfig.toml settings or server environment overrides. GetTopic reports\nthe effective values. Both policies are create-only; UpdateTopic cannot\nchange them on an existing topic."},"3640":{"id":"/docs/server/durability-21","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"The former enforce_fsync topic option is rejected. Use durability for\nmessages and consumer_offset_durability for offsets. The old server-wide\nconsumer_offset_enforce_fsync setting has also been removed."},"3641":{"id":"/docs/server/durability-22","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#the-single-node-write-path","content":"With replicated, the server commits and applies the operation locally.\nMessage batches can remain in the in-memory partition journal after success.\nOrdinary segment writes still happen when a flush trigger fires, and a write\nthat triggers a flush can wait for that I/O, but success does not require\nstable-storage synchronization."},"3642":{"id":"/docs/server/durability-23","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#the-single-node-write-path","content":"With persisted, successful message completion follows this path:"},"3643":{"id":"/docs/server/durability-24","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#the-single-node-write-path","content":"The committed batches are flushed even below the ordinary flush thresholds.\nSetting durability=persisted is sufficient; setting\nmessages_required_to_save=1 is not required. A single-replica partition\ndoes not use the cluster's prepare WAL."},"3644":{"id":"/docs/server/durability-25","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#the-single-node-write-path","content":"For explicit offset changes, consumer_offset_durability=persisted\nsimilarly waits for the required local file and directory synchronization\nbefore success. On a singleton, persisting an offset does not force earlier\nreplicated messages to be flushed. Select both policies as persisted\nwhen both messages and their stored offsets need that protection."},"3645":{"id":"/docs/server/durability-26","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"Topic option"},"3646":{"id":"/docs/server/durability-27","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"Default"},"3647":{"id":"/docs/server/durability-28","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"Effect"},"3648":{"id":"/docs/server/durability-29","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"messages_required_to_save"},"3649":{"id":"/docs/server/durability-30","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"1024"},"3650":{"id":"/docs/server/durability-31","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"Message-count trigger for ordinary segment writes"},"3651":{"id":"/docs/server/durability-32","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"size_of_messages_required_to_save"},"3652":{"id":"/docs/server/durability-33","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"1 MiB"},"3653":{"id":"/docs/server/durability-34","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"Byte-count trigger for ordinary segment writes"},"3654":{"id":"/docs/server/durability-35","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"segment_size"},"3655":{"id":"/docs/server/durability-36","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"1 GiB"},"3656":{"id":"/docs/server/durability-37","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"Soft segment limit; a whole batch can cross it"},"3657":{"id":"/docs/server/durability-38","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"A count or byte trigger, or a full active segment, can flush the committed\njournal prefix. Required persistence, capacity pressure, and lifecycle work\ncan flush earlier. These thresholds are not a maximum data-loss guarantee\nand do not specify a periodic flush interval. A quiet replicated topic\ncan retain messages in process memory while waiting for a trigger."},"3658":{"id":"/docs/server/durability-39","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"Reducing the thresholds changes batching and I/O frequency. It does not give\nreplicated the stable-storage guarantee of persisted."},"3659":{"id":"/docs/server/durability-40","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"This table describes acknowledged messages on one node, with no later\nretention, purge, or deletion:"},"3660":{"id":"/docs/server/durability-41","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"Failure"},"3661":{"id":"/docs/server/durability-42","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"replicated"},"3662":{"id":"/docs/server/durability-43","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"persisted"},"3663":{"id":"/docs/server/durability-44","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"Process crash, SIGKILL, panic, or OOM kill"},"3664":{"id":"/docs/server/durability-45","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"Unflushed messages can be lost"},"3665":{"id":"/docs/server/durability-46","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"Acknowledged messages are recoverable from local storage"},"3666":{"id":"/docs/server/durability-47","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"Machine crash, kernel panic, or power loss"},"3667":{"id":"/docs/server/durability-48","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"Unflushed messages and unsynchronized file writes can be lost"},"3668":{"id":"/docs/server/durability-49","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"Acknowledged messages are recoverable if the storage honors synchronization"},"3669":{"id":"/docs/server/durability-50","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"Storage device lost or irreparably damaged"},"3670":{"id":"/docs/server/durability-51","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"No surviving local copy is guaranteed"},"3671":{"id":"/docs/server/durability-52","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"No surviving local copy is guaranteed"},"3672":{"id":"/docs/server/durability-53","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"Completed buffered file writes normally remain in Linux's page cache after\nthe server process dies. Messages still in the process's journal do not.\nPage cache alone does not protect against machine or power failure."},"3673":{"id":"/docs/server/durability-54","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"A graceful shutdown drains work and forces a final flush of committed\nmessages, regardless of the thresholds. This depends on the shutdown\nfinishing and its I/O succeeding. A container or service termination that\nexpires its grace period and sends SIGKILL is a process crash, not a\ncompleted graceful shutdown."},"3674":{"id":"/docs/server/durability-55","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"The policy applies to the completed server operation, not merely to enqueueing\na request in a producer or receiving an early dispatch response."},"3675":{"id":"/docs/server/durability-56","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"For HTTP production:"},"3676":{"id":"/docs/server/durability-57","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"Request"},"3677":{"id":"/docs/server/durability-58","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"Response"},"3678":{"id":"/docs/server/durability-59","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"Meaning"},"3679":{"id":"/docs/server/durability-60","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"Default, or ?ack=replicated"},"3680":{"id":"/docs/server/durability-61","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"201 Created, Iggy-Durability: replicated or persisted"},"3681":{"id":"/docs/server/durability-62","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"The write completed under the topic's message policy"},"3682":{"id":"/docs/server/durability-63","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"?ack=none"},"3683":{"id":"/docs/server/durability-64","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"202 Accepted, Iggy-Durability: none"},"3684":{"id":"/docs/server/durability-65","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"Dispatch was accepted; commit and persistence were not awaited"},"3685":{"id":"/docs/server/durability-66","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"The query value ack=replicated selects the awaited path even when the\ntopic uses persisted. It does not override the topic policy."},"3686":{"id":"/docs/server/durability-67","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"Poll auto-commit is asynchronous. A successful poll does not confirm\nthat its offset write committed or became durable, even with\nconsumer_offset_durability=persisted. When processing needs an explicit\noffset completion guarantee, store the offset explicitly and await success."},"3687":{"id":"/docs/server/durability-68","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#recovery-and-cost","content":"Recovery validates segment batches and partition identity. It can truncate\nan incomplete tail and rebuild a missing or torn sparse index. Interior\ndamage, gaps, or intact records beyond damaged data can require refusal or\npeer repair instead of truncation. A single node cannot fetch a missing copy\nfrom another replica. See Storage Engine."},"3688":{"id":"/docs/server/durability-69","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#recovery-and-cost","content":"persisted adds synchronization to the completion path. Its latency and\nthroughput depend on storage, filesystem, batching, and concurrency. Measure\nboth policies on the intended hardware rather than applying results from the\nremoved enforce_fsync configuration. The\nbenchmarking guide explains how to reproduce a\nworkload."},"3689":{"id":"/docs/server/durability-70","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#recovery-and-cost","content":"The implementation references are the\ntopic policy definitions,\npartition completion paths,\nand HTTP response handling."},"3690":{"id":"/docs/server/introduction","page_id":"/docs/server/introduction","type":"page","content":"Introduction","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/introduction"},"3691":{"id":"/docs/server/introduction-0","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"What the Iggy server does, and where its releases and Docker images are published."},"3692":{"id":"/docs/server/introduction-1","page_id":"/docs/server/introduction","type":"heading","tags":[],"url":"/docs/server/introduction#system-requirements","content":"System requirements"},"3693":{"id":"/docs/server/introduction-2","page_id":"/docs/server/introduction","type":"heading","tags":[],"url":"/docs/server/introduction#running-the-server","content":"Running the server"},"3694":{"id":"/docs/server/introduction-3","page_id":"/docs/server/introduction","type":"heading","tags":[],"url":"/docs/server/introduction#authentication","content":"Authentication"},"3695":{"id":"/docs/server/introduction-4","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"Iggy server is the most important part of the system as it's responsible for handling all the incoming connections, managing the data and providing the API for the clients. The server is written in Rust. It uses io_uring on Linux and a polling backend on macOS."},"3696":{"id":"/docs/server/introduction-5","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"The releases are published to GitHub and can be found here. The official Docker images can be found here, use docker pull apache/iggy:0.9.0, or apache/iggy:latest for the newest stable release."},"3697":{"id":"/docs/server/introduction-6","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"If you compile the source code in release mode, linking takes longer because LTO is enabled in the [profile.release] section of the workspace Cargo.toml."},"3698":{"id":"/docs/server/introduction-7","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#system-requirements","content":"The server uses io_uring on Linux, which sets a minimum kernel version."},"3699":{"id":"/docs/server/introduction-8","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#system-requirements","content":"Linux kernel 5.19 or newer is required. The shard executors create their rings with IORING_SETUP_COOP_TASKRUN and IORING_SETUP_TASKRUN_FLAG, which older kernels reject, and the server refuses to start rather than run without them. Check yours with uname -r."},"3700":{"id":"/docs/server/introduction-9","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#system-requirements","content":"Kernel 6.1 or newer is worth having. It is the first version with the kernel.io_uring_disabled sysctl, so the startup diagnostics can tell you io_uring was disabled by policy instead of failing obscurely. See Linux tuning."},"3701":{"id":"/docs/server/introduction-10","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#system-requirements","content":"Ubuntu 22.04 LTS ships 5.15 and will not run the server. Its hardware enablement kernel is new enough, and so are Ubuntu 24.04 LTS and Debian 12 as they ship."},"3702":{"id":"/docs/server/introduction-11","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#system-requirements","content":"WSL2 often ships incomplete io_uring, missing setup flags or operations even on a kernel that reports 5.19 or newer. Run wsl --update first."},"3703":{"id":"/docs/server/introduction-12","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#system-requirements","content":"macOS uses a polling backend rather than io_uring when the server runs natively, so this requirement does not apply there."},"3704":{"id":"/docs/server/introduction-13","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#system-requirements","content":"Docker Desktop needs one extra setting on 0.9.0. Its Linux VM reports a single NUMA node but rejects binding memory to it, so the server exits with failed to bind shard 0 memory to its NUMA node. Add -e IGGY_SHARDING_CPU_ALLOCATION=all to the docker run command. Each shard stays pinned to its own core; only the memory binding is skipped, and on a single node it does nothing useful. The same applies to WSL2 and any other host with one NUMA node."},"3705":{"id":"/docs/server/introduction-14","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#system-requirements","content":"Containers use the host's kernel, so it is the host that has to meet this requirement. See Docker & Helm."},"3706":{"id":"/docs/server/introduction-15","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"One iggy-server binary serves both the single-node and the clustered deployment. The loaded configuration decides which one you get. The server accepts these startup flags, plus --help and --version:"},"3707":{"id":"/docs/server/introduction-16","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"Flag"},"3708":{"id":"/docs/server/introduction-17","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"Purpose"},"3709":{"id":"/docs/server/introduction-18","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"--fresh"},"3710":{"id":"/docs/server/introduction-19","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"Delete the data directory before starting. This wipes all data on that node."},"3711":{"id":"/docs/server/introduction-20","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"--with-default-root-credentials"},"3712":{"id":"/docs/server/introduction-21","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"Set the root credentials to iggy/iggy on first start, unless IGGY_ROOT_USERNAME/IGGY_ROOT_PASSWORD are already set. Development only."},"3713":{"id":"/docs/server/introduction-22","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"--replica-id <N>"},"3714":{"id":"/docs/server/introduction-23","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"Select this node's entry in cluster.nodes. Required when cluster.enabled = true. See Clustering."},"3715":{"id":"/docs/server/introduction-24","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"Configuration comes from the TOML file named by IGGY_CONFIG_PATH, or core/server/config.toml relative to the working directory. If that file is missing, the server uses the defaults embedded in the binary. Any key can be overridden with an IGGY_-prefixed environment variable, and a .env file in the working directory or its parents (or the file named by IGGY_ENV_PATH) is loaded at startup. See Configuration for the full reference."},"3716":{"id":"/docs/server/introduction-25","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"When no root credentials are provided on the first single-node start, the server generates a random root password and prints it to the log. That's the only time it can be read."},"3717":{"id":"/docs/server/introduction-26","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"The HTTP API endpoints can be found in server.http file, which can be used with REST Client extension for VS Code."},"3718":{"id":"/docs/server/introduction-27","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"In order to see the detailed logs from the server, run it with RUST_LOG=trace environment variable."},"3719":{"id":"/docs/server/introduction-28","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"To seed the example data, start a development server with known credentials from the root of the repository:"},"3720":{"id":"/docs/server/introduction-29","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"In another terminal at the repository root:"},"3721":{"id":"/docs/server/introduction-30","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"The seeder logs in as iggy/iggy by default. Pass --username and --password to use other credentials."},"3722":{"id":"/docs/server/introduction-31","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#authentication","content":"For broker API commands, only the ping liveness probe and the login handshake itself (username/password, personal access token, or HTTP token refresh, all of which prove a credential) are served without an authenticated session. Every other request requires one and is subject to permissions: fetching server stats, for example, needs the read_servers permission (the root user has it), and even the Prometheus /metrics scrape must present a bearer credential. A stateful connection authenticates by logging in with the user's credentials or personal access token. Logout, disconnection, or heartbeat eviction releases its session. Over the HTTP API, authentication is done by providing the Authorization header with a Bearer JWT or personal access token. HTTP CORS preflight responses and embedded /ui static assets are public; the UI's broker API calls still require authentication."},"3723":{"id":"/docs/server/linux-tuning","page_id":"/docs/server/linux-tuning","type":"page","content":"Linux tuning","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/linux-tuning"},"3724":{"id":"/docs/server/linux-tuning-0","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning","content":"Prepare Linux hosts for Iggy and measure the effects of memory, CPU, storage, and network tuning."},"3725":{"id":"/docs/server/linux-tuning-1","page_id":"/docs/server/linux-tuning","type":"heading","tags":[],"url":"/docs/server/linux-tuning#inspect-the-host-first","content":"Inspect the host first"},"3726":{"id":"/docs/server/linux-tuning-2","page_id":"/docs/server/linux-tuning","type":"heading","tags":[],"url":"/docs/server/linux-tuning#runtime-access-and-process-limits","content":"Runtime access and process limits"},"3727":{"id":"/docs/server/linux-tuning-3","page_id":"/docs/server/linux-tuning","type":"heading","tags":[],"url":"/docs/server/linux-tuning#swapping-and-writeback","content":"Swapping and writeback"},"3728":{"id":"/docs/server/linux-tuning-4","page_id":"/docs/server/linux-tuning","type":"heading","tags":[],"url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"Huge pages and mimalloc"},"3729":{"id":"/docs/server/linux-tuning-5","page_id":"/docs/server/linux-tuning","type":"heading","tags":[],"url":"/docs/server/linux-tuning#explicit-large-pages","content":"Explicit large pages"},"3730":{"id":"/docs/server/linux-tuning-6","page_id":"/docs/server/linux-tuning","type":"heading","tags":[],"url":"/docs/server/linux-tuning#transparent-huge-pages","content":"Transparent huge pages"},"3731":{"id":"/docs/server/linux-tuning-7","page_id":"/docs/server/linux-tuning","type":"heading","tags":[],"url":"/docs/server/linux-tuning#cpu-placement-and-numa","content":"CPU placement and NUMA"},"3732":{"id":"/docs/server/linux-tuning-8","page_id":"/docs/server/linux-tuning","type":"heading","tags":[],"url":"/docs/server/linux-tuning#network-and-storage","content":"Network and storage"},"3733":{"id":"/docs/server/linux-tuning-9","page_id":"/docs/server/linux-tuning","type":"heading","tags":[],"url":"/docs/server/linux-tuning#apply-verify-and-reproduce","content":"Apply, verify, and reproduce"},"3734":{"id":"/docs/server/linux-tuning-10","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning","content":"Host settings affect both production latency and benchmark results. Start with the distribution defaults, satisfy Iggy's runtime requirements, then change one setting at a time. The examples below are experiments for dedicated Linux hosts, not a configuration to apply unchanged to every VM."},"3735":{"id":"/docs/server/linux-tuning-11","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning","content":"Use the benchmarking guide to compare throughput, p50, p99 and p99.9 latency, memory use, and errors under the same workload. Keep the server version, transport, topic durability, CPU allocation, and storage identical between runs."},"3736":{"id":"/docs/server/linux-tuning-12","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#inspect-the-host-first","content":"Run these read-only checks before changing the VM image or starting a benchmark:"},"3737":{"id":"/docs/server/linux-tuning-13","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#inspect-the-host-first","content":"The shell's limits are not necessarily the service's limits. For a running process, inspect /proc/PID/limits, /proc/PID/status, and its cgroup limits. Replace PID with that process's ID. Record the VM type, vCPU topology, memory limit, disk type and provisioned throughput, filesystem, and network bandwidth with the result."},"3738":{"id":"/docs/server/linux-tuning-14","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#runtime-access-and-process-limits","content":"Iggy uses io_uring. The kernel must implement the operations required by the server build, and the service or container must be allowed to use them. The server's startup diagnostics identify failed ring creation and unsupported operations. Where the kernel exposes them, inspect:"},"3739":{"id":"/docs/server/linux-tuning-15","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#runtime-access-and-process-limits","content":"io_uring_disabled=0 permits ring creation. With 1, an unprivileged service needs membership in the configured io_uring_group. With 2, creation is disabled. Container syscall filters can independently deny access. Configure access for the service rather than assuming that a root shell proves the container can start. See the kernel's io_uring controls and Docker deployment guidance."},"3740":{"id":"/docs/server/linux-tuning-16","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#runtime-access-and-process-limits","content":"Size file-descriptor limits for connections, partitions, open segment files, and runtime overhead. LimitNOFILE=65536 is an example starting budget, not an Iggy requirement. Increase it if measurements justify more. A systemd service can use the following drop-in:"},"3741":{"id":"/docs/server/linux-tuning-17","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#runtime-access-and-process-limits","content":"Unlimited locked memory is an option for a dedicated service with a planned memory budget. A finite limit is also valid if it covers the runtime's locked-memory requirements. Neither setting creates RAM or overrides a container's memory ceiling."},"3742":{"id":"/docs/server/linux-tuning-18","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#runtime-access-and-process-limits","content":"Recheck the actual process limits after restarting the service. PAM settings in /etc/security/limits.conf do not configure a system service. See systemd resource limits."},"3743":{"id":"/docs/server/linux-tuning-19","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#swapping-and-writeback","content":"On a host with disk-backed swap and enough RAM for the workload, try vm.swappiness=10 and compare it with the existing value. It reduces the preference for swapping relative to reclaiming file cache. It does not disable swapping, and even 0 permits swapping under sufficient pressure. zram and zswap can warrant different values. See Linux swappiness."},"3744":{"id":"/docs/server/linux-tuning-20","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#swapping-and-writeback","content":"Leave memory for the kernel, page cache, other processes, and Iggy's buffers. Watch swap-in/out with vmstat 1 and memory pressure in /proc/pressure/memory. Disabling swap does not fix an undersized memory budget."},"3745":{"id":"/docs/server/linux-tuning-21","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#swapping-and-writeback","content":"Dirty-page limits govern buffered writeback. Large percentage limits, such as dirty_background_ratio=10 and dirty_ratio=30, can permit large bursts on high-memory VMs. If writeback coincides with latency spikes, compare explicit byte limits sized from disk throughput and the acceptable backlog."},"3746":{"id":"/docs/server/linux-tuning-22","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#swapping-and-writeback","content":"Byte and ratio forms are alternatives. Writing one disables its corresponding other form. These settings do not replace Iggy's persistence barriers. See Linux writeback controls."},"3747":{"id":"/docs/server/linux-tuning-23","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"Huge pages can reduce translation overhead, but they consume memory differently from ordinary pages. Measure both throughput and tail latency. Iggy's default server build uses mimalloc. Check the startup allocator message, since builds that disable mimalloc do not use its environment options."},"3748":{"id":"/docs/server/linux-tuning-24","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"There are three distinct controls:"},"3749":{"id":"/docs/server/linux-tuning-25","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"Control"},"3750":{"id":"/docs/server/linux-tuning-26","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"Meaning"},"3751":{"id":"/docs/server/linux-tuning-27","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"Transparent huge pages (THP)"},"3752":{"id":"/docs/server/linux-tuning-28","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"Kernel promotion of eligible mappings. Inspect the top-level and per-size THP policies."},"3753":{"id":"/docs/server/linux-tuning-29","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"Linux HugeTLB pools"},"3754":{"id":"/docs/server/linux-tuning-30","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"Explicitly reserved pages. vm.nr_hugepages counts pages of the default size reported by Hugepagesize."},"3755":{"id":"/docs/server/linux-tuning-31","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"mimalloc environment options"},"3756":{"id":"/docs/server/linux-tuning-32","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"Tell the allocator which page mechanisms to request. They are not kernel pool sizes."},"3757":{"id":"/docs/server/linux-tuning-33","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#explicit-large-pages","content":"First verify the default page size and leave sufficient ordinary memory. If Hugepagesize is 2048 kB, 512 reserved pages consume 1 GiB:"},"3758":{"id":"/docs/server/linux-tuning-34","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#explicit-large-pages","content":"The requested count may not be allocated on a fragmented host. Boot-time reservation is more reliable. Reserved HugeTLB memory is unavailable for ordinary allocations or page cache, even while unused. Check NUMA placement and the actual pool, not just the requested count. See HugeTLB administration."},"3759":{"id":"/docs/server/linux-tuning-35","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#explicit-large-pages","content":"Try the allocator option on a mimalloc-enabled server, with access to the pool configured for its service account:"},"3760":{"id":"/docs/server/linux-tuning-36","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#explicit-large-pages","content":"Set allocator variables in the launching environment or the service's Environment= entries before process startup. The server can allocate before loading its .env file. Verbose allocator output is useful for checking the experiment, then turn it off for timed runs."},"3761":{"id":"/docs/server/linux-tuning-37","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#explicit-large-pages","content":"Do not copy a Linux page count into MIMALLOC_RESERVE_HUGE_OS_PAGES. That mimalloc option counts 1 GiB pages. A value of 2048 requests 2 TiB, whereas vm.nr_hugepages=2048 represents 4 GiB only when the default HugeTLB page size is 2 MiB. A 2 MiB pool does not provide a matching 1 GiB reservation."},"3762":{"id":"/docs/server/linux-tuning-38","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#explicit-large-pages","content":"A separate 1 GiB-page experiment requires platform support, a suitable pool, and a budget for each process. mimalloc advises normally choosing this reservation mode separately from MIMALLOC_ALLOW_LARGE_OS_PAGES. See mimalloc environment options. HugeTLB allocation can require CAP_IPC_LOCK or membership in vm.hugetlb_shm_group, as described in mmap permissions."},"3763":{"id":"/docs/server/linux-tuning-39","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#transparent-huge-pages","content":"Inspect the current policy instead of universally enabling or disabling THP:"},"3764":{"id":"/docs/server/linux-tuning-40","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#transparent-huge-pages","content":"Compare the existing policy with madvise if allocator page promotion or compaction is relevant. Direct reclaim and compaction can stall allocations. On recent kernels, per-size policies and explicit MADV_COLLAPSE requests also matter, so the top-level switch alone does not describe all behavior. See transparent huge-page controls."},"3765":{"id":"/docs/server/linux-tuning-41","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#transparent-huge-pages","content":"Verify actual usage in /proc/PID/smaps: AnonHugePages reports PMD-sized anonymous THP, while Private_Hugetlb and Shared_Hugetlb identify explicit huge-page mappings. A successful pool reservation alone does not prove Iggy used it."},"3766":{"id":"/docs/server/linux-tuning-42","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#cpu-placement-and-numa","content":"Allocate dedicated CPUs where possible. On the current server, [sharding] cpu_allocation and pin_cores control shard placement, and the process's allowed CPU set constrains allocation. Check the embedded configuration for the exact version being deployed. Separate server CPUs from a colocated load generator and leave capacity for kernel and network work."},"3767":{"id":"/docs/server/linux-tuning-43","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#cpu-placement-and-numa","content":"Inspect NUMA topology with lscpu or numactl --hardware. Compare physical-core-only placement with SMT when relevant. Match memory placement and any per-node huge-page reservation to the CPUs running the shards. Avoid assuming that allocating a pool on one NUMA node helps shards running on another."},"3768":{"id":"/docs/server/linux-tuning-44","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#cpu-placement-and-numa","content":"For a reproducible dedicated-host experiment, compare the performance CPU governor with the current governor if the guest exposes CPU frequency control. Power and thermal limits can still constrain frequency. Many cloud guests cannot control the host's governor. Record the setting rather than assuming a command changed it. See CPU performance scaling."},"3769":{"id":"/docs/server/linux-tuning-45","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#cpu-placement-and-numa","content":"Inspect CPU steal time, cgroup throttling, and per-core utilization before increasing shard counts. If one core handles most interrupts or receive processing, inspect RSS queue distribution and IRQ affinity. Do not disable irqbalance or assign every IRQ to a fixed core without measuring. See Linux network scaling."},"3770":{"id":"/docs/server/linux-tuning-46","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#network-and-storage","content":"Socket-buffer requirements depend on bandwidth and round-trip time. For example, 10 Gbit/s across 10 ms has a bandwidth-delay product of about 12.5 MB. If the connection is window-limited, inspect net.core.rmem_max, net.core.wmem_max, net.ipv4.tcp_rmem, and net.ipv4.tcp_wmem. Larger ceilings permit larger buffers, but do not force the application to use them or guarantee higher throughput."},"3771":{"id":"/docs/server/linux-tuning-47","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#network-and-storage","content":"Raise somaxconn, tcp_max_syn_backlog, or netdev_max_backlog only when backlog pressure or drops show the need. QUIC uses UDP, so TCP tuning does not configure its flow-control windows or UDP receive buffers."},"3772":{"id":"/docs/server/linux-tuning-48","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#network-and-storage","content":"Keep changes such as tcp_tw_reuse, shorter TCP timeouts, and wider ephemeral-port ranges tied to a demonstrated connection-churn problem. See TCP controls and core networking controls."},"3773":{"id":"/docs/server/linux-tuning-49","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#network-and-storage","content":"Use storage with measured sustained bandwidth and latency, and record cloud volume and instance limits. Keep free space for segments, WAL, and recovery. Compare warm-cache and cold-cache runs explicitly. Do not periodically drop caches or disable storage flushes to improve a benchmark number. Storage, retention, and the selected durability policy must match the workload being evaluated."},"3774":{"id":"/docs/server/linux-tuning-50","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#apply-verify-and-reproduce","content":"Trial a change with a runtime setting first. Keep the previous value for rollback. Persist accepted sysctl values in a dedicated /etc/sysctl.d/ file and accepted service limits or allocator variables in that service's systemd drop-in. THP sysfs writes require a boot-time mechanism of their own. Recheck effective values after reboot and process restart."},"3775":{"id":"/docs/server/linux-tuning-51","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#apply-verify-and-reproduce","content":"Collect vmstat 1, iostat -xz 1, mpstat -P ALL 1, pressure counters, and network drop/retransmission counters alongside benchmark results. The iostat and mpstat tools are provided by the sysstat package. Run long enough to include segment flushes, WAL checkpoints, and sustained device limits, rather than measuring only buffered admission."},"3776":{"id":"/docs/server/linux-tuning-52","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#apply-verify-and-reproduce","content":"Iggy's topic durability and consumer_offset_durability independently default to replicated. persisted changes completion guarantees, and huge pages or sysctl settings do not replace it. Poll auto-commit remains asynchronous. Record both policies, replication-group size, payload and batch sizes, warmup, CPU allocation, and the exact host changes with each benchmark result."},"3777":{"id":"/docs/server/monitoring","page_id":"/docs/server/monitoring","type":"page","content":"Monitoring","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/monitoring"},"3778":{"id":"/docs/server/monitoring-0","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring","content":"Scrape the server's Prometheus metrics: the token the endpoint needs, what it exports, and which metrics are worth alerting on."},"3779":{"id":"/docs/server/monitoring-1","page_id":"/docs/server/monitoring","type":"heading","tags":[],"url":"/docs/server/monitoring#get-a-token-for-the-scraper","content":"Get a token for the scraper"},"3780":{"id":"/docs/server/monitoring-2","page_id":"/docs/server/monitoring","type":"heading","tags":[],"url":"/docs/server/monitoring#whats-exported","content":"What's exported"},"3781":{"id":"/docs/server/monitoring-3","page_id":"/docs/server/monitoring","type":"heading","tags":[],"url":"/docs/server/monitoring#what-to-alert-on","content":"What to alert on"},"3782":{"id":"/docs/server/monitoring-4","page_id":"/docs/server/monitoring","type":"heading","tags":[],"url":"/docs/server/monitoring#grafana-and-opentelemetry","content":"Grafana and OpenTelemetry"},"3783":{"id":"/docs/server/monitoring-5","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring","content":"The server exports Prometheus metrics on its HTTP API at /metrics. Both the HTTP API and the metrics endpoint are on by default. See [http.metrics] to change the path or turn it off."},"3784":{"id":"/docs/server/monitoring-6","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring","content":"This page covers the server's own metrics. The connectors runtime has a separate endpoint with its own metric names; see Connectors observability."},"3785":{"id":"/docs/server/monitoring-7","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#get-a-token-for-the-scraper","content":"/metrics needs a bearer token, like every other read on the HTTP API. Any logged-in user can scrape it; there's no separate monitoring permission. Prometheus can't log in, so create a personal access token and put it in the scrape config:"},"3786":{"id":"/docs/server/monitoring-8","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#get-a-token-for-the-scraper","content":"The token is printed once. The Prometheus scrape config is in [http.metrics]."},"3787":{"id":"/docs/server/monitoring-9","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#get-a-token-for-the-scraper","content":"The token can read every metric the server exports, so store it like any other secret: in a Kubernetes Secret or your secrets manager, not in a file you commit. With the Helm chart, set it through server.serviceMonitor.authorization. See Docker & Helm."},"3788":{"id":"/docs/server/monitoring-10","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"The core metrics are below. The gauges are read fresh on every scrape."},"3789":{"id":"/docs/server/monitoring-11","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"Metric"},"3790":{"id":"/docs/server/monitoring-12","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"Type"},"3791":{"id":"/docs/server/monitoring-13","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"What it counts"},"3792":{"id":"/docs/server/monitoring-14","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"http_requests_total"},"3793":{"id":"/docs/server/monitoring-15","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"counter"},"3794":{"id":"/docs/server/monitoring-16","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"HTTP API requests"},"3795":{"id":"/docs/server/monitoring-17","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"streams, topics, partitions, segments"},"3796":{"id":"/docs/server/monitoring-18","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"gauge"},"3797":{"id":"/docs/server/monitoring-19","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"Current number of each"},"3798":{"id":"/docs/server/monitoring-20","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"messages"},"3799":{"id":"/docs/server/monitoring-21","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"gauge"},"3800":{"id":"/docs/server/monitoring-22","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"Messages stored"},"3801":{"id":"/docs/server/monitoring-23","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"users"},"3802":{"id":"/docs/server/monitoring-24","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"gauge"},"3803":{"id":"/docs/server/monitoring-25","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"Users"},"3804":{"id":"/docs/server/monitoring-26","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"clients"},"3805":{"id":"/docs/server/monitoring-27","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"gauge"},"3806":{"id":"/docs/server/monitoring-28","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"Connected clients"},"3807":{"id":"/docs/server/monitoring-29","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"The names have no iggy_ prefix, so watch for clashes if Prometheus scrapes other exporters with similar names."},"3808":{"id":"/docs/server/monitoring-30","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"Each shard also exports its own lower-level metrics, labelled shard=\"<id>\". These cover the write-ahead log (the partition_wal_* series), partition housekeeping (partitions_*), and requests or frames the server refused or dropped. To see the full list with descriptions, scrape a running server:"},"3809":{"id":"/docs/server/monitoring-31","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#what-to-alert-on","content":"frame_drops_total{variant=\"forward_client_send\"}. Any increase means a client never got a reply to a request. Most other frame_drops_total variants are retried or repaired automatically. This series only appears after the first drop, so on a healthy server it won't be in the scrape at all. Write the alert so that a missing series counts as no drops."},"3810":{"id":"/docs/server/monitoring-32","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#what-to-alert-on","content":"stats_rollup_underflows_total. It goes up when a stream, topic or partition total would have dropped below zero and was held at zero instead. A few during deletes, purges or restores are expected. A steady rise at other times is worth a look."},"3811":{"id":"/docs/server/monitoring-33","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#grafana-and-opentelemetry","content":"Add Prometheus as a data source in Grafana, then build panels from the metric names above."},"3812":{"id":"/docs/server/monitoring-34","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#grafana-and-opentelemetry","content":"The server doesn't export metrics over OTLP. To bring them into an OpenTelemetry pipeline, scrape /metrics with the collector's Prometheus receiver, using the same bearer token. Server export of logs and traces over OTLP isn't available yet; see [telemetry]."},"3813":{"id":"/docs/server/networking","page_id":"/docs/server/networking","type":"page","content":"Networking","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/networking"},"3814":{"id":"/docs/server/networking-0","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking","content":"The four transports Iggy serves simultaneously, TCP, QUIC, WebSocket and HTTP, and what each is best suited to."},"3815":{"id":"/docs/server/networking-1","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#transport-protocols","content":"Transport protocols"},"3816":{"id":"/docs/server/networking-2","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#binary-protocol","content":"Binary protocol"},"3817":{"id":"/docs/server/networking-3","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#connection-handling-across-shards","content":"Connection handling across shards"},"3818":{"id":"/docs/server/networking-4","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#tcp","content":"TCP"},"3819":{"id":"/docs/server/networking-5","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#quic","content":"QUIC"},"3820":{"id":"/docs/server/networking-6","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#http","content":"HTTP"},"3821":{"id":"/docs/server/networking-7","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#websocket","content":"WebSocket"},"3822":{"id":"/docs/server/networking-8","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#tls","content":"TLS"},"3823":{"id":"/docs/server/networking-9","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#heartbeat","content":"Heartbeat"},"3824":{"id":"/docs/server/networking-10","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#cluster-networking","content":"Cluster networking"},"3825":{"id":"/docs/server/networking-11","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking","content":"Iggy supports four transport protocols simultaneously, each optimized for different use cases. All stateful protocols (TCP, QUIC, WebSocket) use the same custom binary wire protocol, while HTTP provides a standard REST API."},"3826":{"id":"/docs/server/networking-12","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Protocol"},"3827":{"id":"/docs/server/networking-13","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Default Address"},"3828":{"id":"/docs/server/networking-14","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Implementation"},"3829":{"id":"/docs/server/networking-15","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Best for"},"3830":{"id":"/docs/server/networking-16","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"TCP"},"3831":{"id":"/docs/server/networking-17","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"127.0.0.1:8090"},"3832":{"id":"/docs/server/networking-18","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"compio + custom binary protocol"},"3833":{"id":"/docs/server/networking-19","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Highest throughput, lowest latency"},"3834":{"id":"/docs/server/networking-20","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"QUIC"},"3835":{"id":"/docs/server/networking-21","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"127.0.0.1:8080"},"3836":{"id":"/docs/server/networking-22","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"compio-quic (quinn)"},"3837":{"id":"/docs/server/networking-23","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Secure connections out of the box"},"3838":{"id":"/docs/server/networking-24","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"HTTP"},"3839":{"id":"/docs/server/networking-25","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"127.0.0.1:3000"},"3840":{"id":"/docs/server/networking-26","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"axum"},"3841":{"id":"/docs/server/networking-27","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"REST API, web integrations"},"3842":{"id":"/docs/server/networking-28","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"WebSocket"},"3843":{"id":"/docs/server/networking-29","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"127.0.0.1:8092"},"3844":{"id":"/docs/server/networking-30","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"compio-ws"},"3845":{"id":"/docs/server/networking-31","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Browser clients, bidirectional streaming"},"3846":{"id":"/docs/server/networking-32","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Performance ranking (lowest to highest overhead): TCP > QUIC > WebSocket > HTTP"},"3847":{"id":"/docs/server/networking-33","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#binary-protocol","content":"Every request and reply on the stateful transports starts with a fixed 256-byte header (the same Viewstamped Replication header layout the cluster uses internally), followed by the command payload. The iggy_binary_protocol crate provides zero-copy serialization for these headers, and foreign SDKs implement the same contract natively. See the Binary Protocol section for the full specification."},"3848":{"id":"/docs/server/networking-34","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#connection-handling-across-shards","content":"The server runs one thread and runtime per selected shard (thread-per-core, shared-nothing), with CPU selection and optional pinning controlled by [sharding]. All listeners (every client transport) bind on shard 0 only. Shard 0's coordinator hands accepted plaintext TCP and WebSocket connections to peer shards round-robin by transferring the file descriptor at accept time. From then on the connection lives entirely on its shard. QUIC, TCP with TLS, WebSocket with TLS, and HTTP terminate on shard 0, because their per-connection state cannot move between threads. Sockets never migrate after accept: an operation that touches a partition owned by another shard rides the internal message bus instead."},"3849":{"id":"/docs/server/networking-35","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tcp","content":"TCP provides the highest performance as it works directly with binary data without the overhead of HTTP or TLS handshakes (unless TLS is enabled). The full set of keys:"},"3850":{"id":"/docs/server/networking-36","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"QUIC runs the same binary protocol over UDP, on top of the quinn library, with TLS built in. It isn't quite as fast as TCP, but security comes out of the box (TLS is mandatory). Defaults:"},"3851":{"id":"/docs/server/networking-37","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"A few of these are deliberate rather than arbitrary:"},"3852":{"id":"/docs/server/networking-38","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"max_concurrent_bidi_streams = 1: the Rust SDK opens a fresh stream per command and the server accepts one at a time, so a connection carries one in-flight command. Raising the cap does not make handlers concurrent."},"3853":{"id":"/docs/server/networking-39","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"initial_mtu = \"1200 B\" is the QUIC minimum. MTU discovery probes upward automatically, and boot rejects values below 1200."},"3854":{"id":"/docs/server/networking-40","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"stream_receive_window is the per-stream slice of receive_window, equal to it because there is a single stream. Lower it if you ever raise the stream cap."},"3855":{"id":"/docs/server/networking-41","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"keep_alive_interval is one third of max_idle_timeout, so two consecutive lost keep-alives fit before the idle timer closes the connection."},"3856":{"id":"/docs/server/networking-42","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"The HTTP API is built on axum and provides a standard REST interface. It includes JWT authentication, CORS configuration, and optional TLS."},"3857":{"id":"/docs/server/networking-43","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"HTTP is the most accessible protocol but has the highest overhead due to JSON serialization and the stateless nature of HTTP (no persistent connections for consumer groups). You can find request examples in the server.http file."},"3858":{"id":"/docs/server/networking-44","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"The HTTP server also hosts:"},"3859":{"id":"/docs/server/networking-45","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"Prometheus metrics at /metrics (endpoint configurable via [http.metrics]). The route authenticates like every other read: scrapers must present a bearer credential (JWT or personal access token). The /ping API route, CORS preflight responses, and enabled /ui static assets are public. Login and refresh routes prove credentials in the request body."},"3860":{"id":"/docs/server/networking-46","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"Embedded Web UI at /ui, which requires web_ui = true in [http] (off by default) on a server built with the iggy-web feature (part of the default build) and the Web UI static assets. Build the assets before compiling the server; see Configuration."},"3861":{"id":"/docs/server/networking-47","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"WebSocket provides bidirectional streaming over HTTP upgrade. Iggy uses the compio-ws crate to connect tungstenite framing to compio's completion-based I/O. The default WebSocket read buffer is 128 KiB and the default maximum message size is 64 MiB; these are separate settings."},"3862":{"id":"/docs/server/networking-48","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"The [websocket] section exposes the frame-tuning knobs (read_buffer_size, write_buffer_size, max_write_buffer_size, max_message_size, max_frame_size, accept_unmasked_frames). See Configuration. TLS for WebSocket has its own [websocket.tls] section."},"3863":{"id":"/docs/server/networking-49","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"Historical benchmark comparison from the WebSocket implementation article (AWS i3en.3xlarge, 4 producers or consumers, 40M messages, 1,000 messages per batch, fsync enabled). These measurements predate 0.9.0:"},"3864":{"id":"/docs/server/networking-50","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"Producer avg latency: TCP 2.61ms vs WebSocket 3.43ms (+31%)"},"3865":{"id":"/docs/server/networking-51","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"Consumer avg latency: TCP 0.70ms vs WebSocket 1.44ms (+106%)"},"3866":{"id":"/docs/server/networking-52","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Each transport configures TLS in its own section, and the self_signed semantics differ per transport:"},"3867":{"id":"/docs/server/networking-53","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Transport"},"3868":{"id":"/docs/server/networking-54","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Section"},"3869":{"id":"/docs/server/networking-55","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Behavior"},"3870":{"id":"/docs/server/networking-56","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"TCP"},"3871":{"id":"/docs/server/networking-57","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"[tcp.tls]"},"3872":{"id":"/docs/server/networking-58","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"self_signed = true generates an ephemeral certificate only while cert_file does not exist; an existing PEM pair is loaded instead."},"3873":{"id":"/docs/server/networking-59","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"WebSocket"},"3874":{"id":"/docs/server/networking-60","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"[websocket.tls]"},"3875":{"id":"/docs/server/networking-61","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Same load-or-generate rule as TCP."},"3876":{"id":"/docs/server/networking-62","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"QUIC"},"3877":{"id":"/docs/server/networking-63","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"[quic.certificate]"},"3878":{"id":"/docs/server/networking-64","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"TLS is mandatory (part of the QUIC spec). self_signed = true always generates an ephemeral certificate and ignores cert_file/key_file, logging a warning if the files exist."},"3879":{"id":"/docs/server/networking-65","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"HTTP"},"3880":{"id":"/docs/server/networking-66","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"[http.tls]"},"3881":{"id":"/docs/server/networking-67","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"No self_signed option: HTTPS requires certificate and key files in cert_file/key_file."},"3882":{"id":"/docs/server/networking-68","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"With self_signed = false, cert_file and key_file must both exist. For production, provide proper certificate files everywhere. Ephemeral certificates change on every start, so a trust configuration pinned to one generated certificate does not survive a restart."},"3883":{"id":"/docs/server/networking-69","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#heartbeat","content":"The verifier checks once per interval and releases a session whose last heartbeat is more than 1.2x the interval old, so its consumer groups rebalance off it. Requests and pings refresh the heartbeat. Only connections holding a consumer-group membership are evicted. Others are left alone until their socket closes."},"3884":{"id":"/docs/server/networking-70","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#heartbeat","content":"The Rust, Go, Python, Node, async Java and C# TCP clients have automatic heartbeats, normally every 5 seconds once connected. This is below the default 36-second inactivity threshold; the periodic verifier means eviction does not occur at an exact 36-second deadline. The blocking Java client has no automatic heartbeat, so an idle consumer-group member must ping manually or reconnect after eviction."},"3885":{"id":"/docs/server/networking-71","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#cluster-networking","content":"In cluster mode, listener ports come exclusively from each node's cluster.nodes ports entry, including the tcp_replica port for the consensus plane, and nodes can advertise different client-facing addresses per client network. Replica-to-replica traffic can be authenticated with a pre-shared key and wrapped in TLS 1.3. See Clustering configuration and Clustering security."},"3886":{"id":"/docs/server/security","page_id":"/docs/server/security","type":"page","content":"Security","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/security"},"3887":{"id":"/docs/server/security-0","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security","content":"Authentication, authorization, transport encryption and encryption at rest in the Iggy server."},"3888":{"id":"/docs/server/security-1","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#authentication","content":"Authentication"},"3889":{"id":"/docs/server/security-2","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#username-and-password","content":"Username and password"},"3890":{"id":"/docs/server/security-3","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#personal-access-tokens-pat","content":"Personal Access Tokens (PAT)"},"3891":{"id":"/docs/server/security-4","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#authorization","content":"Authorization"},"3892":{"id":"/docs/server/security-5","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#permission-matrix","content":"Permission matrix"},"3893":{"id":"/docs/server/security-6","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#scoped-permissions","content":"Scoped permissions"},"3894":{"id":"/docs/server/security-7","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#how-permissions-cascade","content":"How permissions cascade"},"3895":{"id":"/docs/server/security-8","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#transport-encryption-tls","content":"Transport encryption (TLS)"},"3896":{"id":"/docs/server/security-9","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#data-encryption-at-rest","content":"Data encryption at rest"},"3897":{"id":"/docs/server/security-10","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#jwt-http-api","content":"JWT (HTTP API)"},"3898":{"id":"/docs/server/security-11","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#cluster-security","content":"Cluster security"},"3899":{"id":"/docs/server/security-12","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security","content":"Iggy provides multiple layers of security covering authentication, authorization, transport encryption, and data encryption at rest."},"3900":{"id":"/docs/server/security-13","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authentication","content":"Iggy supports two authentication mechanisms:"},"3901":{"id":"/docs/server/security-14","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#username-and-password","content":"Users authenticate with a username and password, for example via the Rust SDK's login_user(). Passwords are hashed using Argon2id (a memory-hard hashing algorithm). On first single-node startup, the server generates a random password for the initial root account (username iggy by default) and writes it to the logs. A first cluster boot requires explicit root credentials. You can override this by setting environment variables:"},"3902":{"id":"/docs/server/security-15","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#username-and-password","content":"Or use the --with-default-root-credentials flag for development (sets root credentials to iggy/iggy)."},"3903":{"id":"/docs/server/security-16","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#username-and-password","content":"These variables initialize the root account only when it is first created. Supplied values are still validated on later starts, but they do not replace the stored credentials. Use the password-change API or iggy user password with the current password to change an existing account. The --fresh flag deletes all data; it is not needed for a password change."},"3904":{"id":"/docs/server/security-17","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#username-and-password","content":"The root user cannot be deleted, and its permissions are fixed: it always holds every permission."},"3905":{"id":"/docs/server/security-18","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#personal-access-tokens-pat","content":"PATs provide programmatic access with optional expiry. Each user can have up to max_tokens_per_user (default 100) stored tokens, including expired tokens until the cleaner removes them. Tokens are hashed before storage and can be revoked at any time."},"3906":{"id":"/docs/server/security-19","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#personal-access-tokens-pat","content":"An automatic cleaner removes expired tokens at a configurable interval."},"3907":{"id":"/docs/server/security-20","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#personal-access-tokens-pat","content":"Broker API commands require an authenticated session or bearer credential, except for ping and the login/refresh flows that establish or prove a credential. The Prometheus /metrics scrape requires a JWT or personal access token. HTTP CORS preflight responses and embedded /ui static assets are public; the UI's broker API calls still require authentication."},"3908":{"id":"/docs/server/security-21","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"Iggy provides granular permissions at three levels:"},"3909":{"id":"/docs/server/security-22","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"Global permissions - apply to the whole server and all streams"},"3910":{"id":"/docs/server/security-23","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"Stream permissions - scoped to one stream and all its topics"},"3911":{"id":"/docs/server/security-24","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"Topic permissions - scoped to one topic within a stream"},"3912":{"id":"/docs/server/security-25","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"The root user has full access to everything and bypasses all permission checks. Other users can be assigned specific permissions using the CLI, HTTP API, SDK, or Web UI."},"3913":{"id":"/docs/server/security-26","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"The global permissions and the operations they unlock:"},"3914":{"id":"/docs/server/security-27","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Operation"},"3915":{"id":"/docs/server/security-28","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Required global permission"},"3916":{"id":"/docs/server/security-29","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Get server stats"},"3917":{"id":"/docs/server/security-30","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"read_servers"},"3918":{"id":"/docs/server/security-31","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"List clients, get client"},"3919":{"id":"/docs/server/security-32","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"read_servers"},"3920":{"id":"/docs/server/security-33","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Create, update, delete users; update permissions; change passwords"},"3921":{"id":"/docs/server/security-34","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"manage_users"},"3922":{"id":"/docs/server/security-35","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Get user, list users"},"3923":{"id":"/docs/server/security-36","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"read_users"},"3924":{"id":"/docs/server/security-37","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Create, update, delete streams"},"3925":{"id":"/docs/server/security-38","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"manage_streams"},"3926":{"id":"/docs/server/security-39","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Get stream, list streams"},"3927":{"id":"/docs/server/security-40","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"read_streams"},"3928":{"id":"/docs/server/security-41","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Create, update, delete topics"},"3929":{"id":"/docs/server/security-42","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"manage_topics"},"3930":{"id":"/docs/server/security-43","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Get topic, list topics"},"3931":{"id":"/docs/server/security-44","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"read_topics"},"3932":{"id":"/docs/server/security-45","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Consumer groups: create, delete, join, leave, get"},"3933":{"id":"/docs/server/security-46","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"read_topics"},"3934":{"id":"/docs/server/security-47","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Poll messages"},"3935":{"id":"/docs/server/security-48","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"poll_messages"},"3936":{"id":"/docs/server/security-49","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Send messages"},"3937":{"id":"/docs/server/security-50","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"send_messages"},"3938":{"id":"/docs/server/security-51","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Two kinds of implication apply on top of the table:"},"3939":{"id":"/docs/server/security-52","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Supersets: every manage_* permission includes its read_* counterpart. In addition manage_streams includes manage_topics, read_streams includes read_topics, and read_topics includes poll_messages. manage_topics also includes send_messages, so manage_streams permits sending too."},"3940":{"id":"/docs/server/security-53","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Self-service: an authenticated user can always read their own account, change their own password, and manage their own personal access tokens, without any of the user permissions above."},"3941":{"id":"/docs/server/security-54","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#scoped-permissions","content":"Instead of (or in addition to) global grants, permissions can be scoped per stream and per topic:"},"3942":{"id":"/docs/server/security-55","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#scoped-permissions","content":"Stream scope: manage_stream, read_stream, manage_topics, read_topics, poll_messages, send_messages, plus an optional per-topic map. read_stream includes read_topics and poll_messages within that stream."},"3943":{"id":"/docs/server/security-56","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#scoped-permissions","content":"Topic scope: manage_topic, read_topic, poll_messages, send_messages. read_topic includes poll_messages on that topic."},"3944":{"id":"/docs/server/security-57","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"Permissions are checked from top to bottom: global, then stream, then topic. A permission granted at a higher level covers everything below it:"},"3945":{"id":"/docs/server/security-58","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"Global poll_messages lets the user poll messages from all streams and topics."},"3946":{"id":"/docs/server/security-59","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"Stream-scoped poll_messages on stream 1 lets the user poll from all topics in stream 1, but not from other streams."},"3947":{"id":"/docs/server/security-60","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"Topic-scoped poll_messages on topic 5 of stream 1 lets the user poll only from that topic."},"3948":{"id":"/docs/server/security-61","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"If a stream has no entry in the user's stream permissions, only global permissions apply to it. The same holds for topics within a stream."},"3949":{"id":"/docs/server/security-62","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"For example, a user that may only consume from stream 42 needs no global permissions at all: grant stream-scoped read_stream and poll_messages on stream 42, and the user can read that stream, list its topics, and poll messages from any topic in it. The read grant also permits consumer-group operations in that stream. For polling without those read and group permissions, grant only poll_messages."},"3950":{"id":"/docs/server/security-63","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"Each transport configures TLS in its own section, and the self_signed semantics differ per transport:"},"3951":{"id":"/docs/server/security-64","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"Transport"},"3952":{"id":"/docs/server/security-65","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"Section"},"3953":{"id":"/docs/server/security-66","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"Behavior"},"3954":{"id":"/docs/server/security-67","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"TCP"},"3955":{"id":"/docs/server/security-68","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"[tcp.tls]"},"3956":{"id":"/docs/server/security-69","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"self_signed = true generates an ephemeral certificate only while cert_file does not exist; an existing PEM pair is loaded instead."},"3957":{"id":"/docs/server/security-70","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"WebSocket"},"3958":{"id":"/docs/server/security-71","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"[websocket.tls]"},"3959":{"id":"/docs/server/security-72","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"Same load-or-generate rule as TCP."},"3960":{"id":"/docs/server/security-73","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"QUIC"},"3961":{"id":"/docs/server/security-74","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"[quic.certificate]"},"3962":{"id":"/docs/server/security-75","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"TLS is mandatory (part of the QUIC spec). self_signed = true always generates an ephemeral certificate and ignores cert_file/key_file, logging a warning if the files exist."},"3963":{"id":"/docs/server/security-76","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"HTTP"},"3964":{"id":"/docs/server/security-77","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"[http.tls]"},"3965":{"id":"/docs/server/security-78","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"No self_signed option: HTTPS requires certificate and key files in cert_file/key_file."},"3966":{"id":"/docs/server/security-79","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"For production deployments, provide proper certificates via cert_file and key_file. Ephemeral certificates change on every start, so a trust configuration pinned to one generated certificate does not survive a restart. See Networking for the surrounding transport configuration."},"3967":{"id":"/docs/server/security-80","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#data-encryption-at-rest","content":"Iggy supports optional AES-256-GCM encryption for message payloads and user headers. They are encrypted before storage and decrypted for polling. Metadata journals, metadata snapshots, and structural record headers remain unencrypted. This option does not provide whole-directory encryption. The encryption key must decode from base64 to 32 bytes."},"3968":{"id":"/docs/server/security-81","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#jwt-http-api","content":"The HTTP API uses JWT (JSON Web Tokens) for session management. Tokens are signed with HS256 by default and have configurable expiry, clock skew tolerance, and audience/issuer validation:"},"3969":{"id":"/docs/server/security-82","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#jwt-http-api","content":"Further keys (valid_issuers, valid_audiences, not_before, use_base64_secret, the signing secrets) are covered in Configuration."},"3970":{"id":"/docs/server/security-83","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#jwt-http-api","content":"Signing secrets: encoding_secret and decoding_secret default to empty. Without cluster.auth, the server generates a secure random secret on every start. That's a safe single-node default with two consequences: issued tokens die on restart, and in a cluster each node signs with its own key, so bearers are node-local and follower-to-primary request forwarding stays disabled. For clusters, configure an identical secret on every node (prefer the IGGY_HTTP_JWT_ENCODING_SECRET/IGGY_HTTP_JWT_DECODING_SECRET environment variables over on-disk config), or enable cluster.auth so the JWT key derives from the cluster's shared PSK."},"3971":{"id":"/docs/server/security-84","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#jwt-http-api","content":"Refresh tokens: POST /users/refresh-token re-issues an access token from a still-valid one presented in the request body, answering the same identity shape as login, so HTTP clients can extend a session without re-sending credentials."},"3972":{"id":"/docs/server/security-85","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#jwt-http-api","content":"Federated issuers: the opt-in [[http.jwt.trusted_issuers]] list accepts tokens minted by external identity providers for application-to-application flows. Each entry names an issuer, audience, and jwks_url. Signatures are verified against the issuer's JWKS (fetches are rate-limited), and every token from that issuer is remapped onto the configured non-root user_id. With no entries configured, the listener accepts only self-issued tokens. See Configuration for the key reference."},"3973":{"id":"/docs/server/security-86","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#cluster-security","content":"In cluster mode, replica-to-replica traffic can require an authenticated handshake based on a pre-shared key (with a documented rolling rotation procedure) and can be wrapped in TLS 1.3. With cluster.auth enabled and no JWT secrets configured, the PSK also becomes the cluster-wide JWT key source. See Clustering security."},"3974":{"id":"/docs/server/storage-engine","page_id":"/docs/server/storage-engine","type":"page","content":"Storage Engine","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/storage-engine"},"3975":{"id":"/docs/server/storage-engine-0","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine","content":"The segmented append-only log, and how streams, topics, partitions and segments map onto files on disk."},"3976":{"id":"/docs/server/storage-engine-1","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#directory-layout","content":"Directory layout"},"3977":{"id":"/docs/server/storage-engine-2","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#segmented-log","content":"Segmented log"},"3978":{"id":"/docs/server/storage-engine-3","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#on-disk-batch-format","content":"On-disk batch format"},"3979":{"id":"/docs/server/storage-engine-4","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#indexes","content":"Indexes"},"3980":{"id":"/docs/server/storage-engine-5","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#write-pipeline","content":"Write pipeline"},"3981":{"id":"/docs/server/storage-engine-6","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#boot-time-segment-recovery","content":"Boot-time segment recovery"},"3982":{"id":"/docs/server/storage-engine-7","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#read-integrity","content":"Read integrity"},"3983":{"id":"/docs/server/storage-engine-8","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#memory-pool","content":"Memory pool"},"3984":{"id":"/docs/server/storage-engine-9","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#retention-and-cleanup","content":"Retention and cleanup"},"3985":{"id":"/docs/server/storage-engine-10","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#metadata-plane","content":"Metadata plane"},"3986":{"id":"/docs/server/storage-engine-11","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#encryption","content":"Encryption"},"3987":{"id":"/docs/server/storage-engine-12","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#compression","content":"Compression"},"3988":{"id":"/docs/server/storage-engine-13","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"Removed and relocated settings"},"3989":{"id":"/docs/server/storage-engine-14","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine","content":"Iggy's storage engine is built around the concept of a segmented append-only log. Message data follows a hierarchy: System -> Streams -> Topics -> Partitions -> Segments. This page covers how data is stored, indexed, flushed, recovered, and cleaned up on disk."},"3990":{"id":"/docs/server/storage-engine-15","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#directory-layout","content":"All data lives under the root path directory (default local_data, overridden with IGGY_PATH):"},"3991":{"id":"/docs/server/storage-engine-16","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#directory-layout","content":"Stream, topic, and partition ids are numeric and 0-based. Each partition directory holds pairs of .log and .index files. The filename is the segment's start offset, zero-padded to 20 digits. Recovery can create an empty active segment at a reserved offset beyond the last stored message. Next to the segments, every partition keeps its own superblock pair (replica identity and consensus state for that partition) and an offsets/ tree for consumer offset storage. Multi-replica partitions also keep a prepare WAL when either topic durability policy is persisted."},"3992":{"id":"/docs/server/storage-engine-17","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#segmented-log","content":"Each partition is a segmented log: an ordered list of sealed (read-only) segments plus one active (writable) segment. When the active segment reaches the topic's segment_size (default 1 GiB), it is sealed and a new active segment starts at the next offset."},"3993":{"id":"/docs/server/storage-engine-18","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#segmented-log","content":"segment_size is a per-topic creation option, bounded to a 512-byte multiple between 1 MiB and 1 GiB. It's a soft limit: rotation fires after the append that crosses it, so the crossing batch lands whole and a sealed segment may run one batch past the configured size. preallocate_segments (also per topic) reserves each segment's bytes up front on filesystems that support it. See Topic options."},"3994":{"id":"/docs/server/storage-engine-19","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#on-disk-batch-format","content":"Segments store batch records, not individual messages. The record is byte-identical to the wire encoding: the one layout a SendMessages body, the replicated prepare, the persisted segment record, and the poll reply all share. There is no other message encoding."},"3995":{"id":"/docs/server/storage-engine-20","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#on-disk-batch-format","content":"The 256-byte batch header carries partition_id, base_offset, base_timestamp, origin_timestamp, batch_length, batch_checksum (XxHash3-64), and message_count. The rest is reserved and must be zero. Each 48-byte frame header carries checksum (XxHash3-64), id (u128), offset_delta (u32), timestamp_delta (u32), and the two lengths. A message's absolute offset is base_offset + offset_delta; its server timestamp is the flat base_timestamp, while timestamp_delta resolves producer time against origin_timestamp. All fields are little-endian, and records are stored contiguously with no padding."},"3996":{"id":"/docs/server/storage-engine-21","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#on-disk-batch-format","content":"The full byte-level tables live on the Message batches page. Absent at-rest encryption, what lands on disk is exactly what the producer sent, with the server stamping partition_id at admission and base_offset / base_timestamp (plus a batch_checksum recompute) at journal append."},"3997":{"id":"/docs/server/storage-engine-22","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Each segment has an accompanying .index file holding a sparse index: one 24-byte entry per flushed write, not per message."},"3998":{"id":"/docs/server/storage-engine-23","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Field"},"3999":{"id":"/docs/server/storage-engine-24","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Bytes"},"4000":{"id":"/docs/server/storage-engine-25","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Type"},"4001":{"id":"/docs/server/storage-engine-26","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Description"},"4002":{"id":"/docs/server/storage-engine-27","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"offset"},"4003":{"id":"/docs/server/storage-engine-28","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"0..8"},"4004":{"id":"/docs/server/storage-engine-29","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"u64"},"4005":{"id":"/docs/server/storage-engine-30","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Absolute offset of the flushed batch"},"4006":{"id":"/docs/server/storage-engine-31","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"timestamp"},"4007":{"id":"/docs/server/storage-engine-32","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"8..16"},"4008":{"id":"/docs/server/storage-engine-33","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"u64"},"4009":{"id":"/docs/server/storage-engine-34","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Timestamp of the flushed batch"},"4010":{"id":"/docs/server/storage-engine-35","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"position"},"4011":{"id":"/docs/server/storage-engine-36","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"16..24"},"4012":{"id":"/docs/server/storage-engine-37","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"u64"},"4013":{"id":"/docs/server/storage-engine-38","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Byte position of the batch start in the .log file"},"4014":{"id":"/docs/server/storage-engine-39","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Little-endian, no header, no padding. To serve a poll, the server binary-searches the index for the closest entry at or below the target offset (or timestamp), seeks to its position, and walks batch records from there. Because the index is a sparse hint, a lookup below the indexed range falls back to the segment start rather than failing."},"4015":{"id":"/docs/server/storage-engine-40","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"There is no index caching configuration: the in-memory index cache is an internal per-segment structure the server manages itself."},"4016":{"id":"/docs/server/storage-engine-41","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"Messages are admitted, stamped, and buffered in the partition journal. Their completion path depends on the topic's durability policy:"},"4017":{"id":"/docs/server/storage-engine-42","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"The flush thresholds and completion policies are per-topic creation options:"},"4018":{"id":"/docs/server/storage-engine-43","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"messages_required_to_save (default 1024): count threshold."},"4019":{"id":"/docs/server/storage-engine-44","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"size_of_messages_required_to_save (default 1 MiB): byte threshold."},"4020":{"id":"/docs/server/storage-engine-45","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"durability (default replicated): message completion policy; persisted requires recoverable stable storage at the replication quorum."},"4021":{"id":"/docs/server/storage-engine-46","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"consumer_offset_durability (default replicated): the independent policy for explicit offset stores and deletes."},"4022":{"id":"/docs/server/storage-engine-47","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"A full active segment also triggers an ordinary flush. These are soft limits: a flush writes whole committed batches, so the actual count or size can overshoot. Required persistence, capacity pressure, and lifecycle operations can flush below the thresholds. The settings do not define a periodic flush interval. The MessagesWriter uses vectored I/O with up to 1024 buffers per syscall, so many buffered batches can land in one write."},"4023":{"id":"/docs/server/storage-engine-48","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"With replicated, completion does not wait for an additional stable-storage barrier. With persisted, a single-replica partition flushes and synchronizes committed segment state before success. A multi-replica partition instead gates the required prepare acknowledgements on recoverable WAL history, so persisted success can precede an ordinary segment flush. messages_required_to_save=1 is not required."},"4024":{"id":"/docs/server/storage-engine-49","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"For multi-replica partitions, the disk prepare WAL is enabled when either policy is persisted and includes message payloads even if only the offset policy is persisted. Checkpoints synchronize materialized files before reclaiming WAL history. See Durability and Cluster Durability for completion guarantees and failure behavior."},"4025":{"id":"/docs/server/storage-engine-50","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#boot-time-segment-recovery","content":"At startup, recovery validates batch checksums, partition identity, and the segment chain before serving data. With message durability replicated, it walks the log from byte zero because buffered writeback can preserve later pages before earlier ones. With persisted, completed durable segment flushes allow an index-anchored recovery path."},"4026":{"id":"/docs/server/storage-engine-51","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#boot-time-segment-recovery","content":"A missing or torn sparse index can be rebuilt from valid log data. An incomplete tail can be truncated, but an interior gap, intact records after damage, or a contradiction with durable history can require recovery refusal. Recovery does not blindly truncate at the first invalid batch."},"4027":{"id":"/docs/server/storage-engine-52","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#boot-time-segment-recovery","content":"When a prepare WAL exists, recovery reconciles it with materialized segment and offset state. Unrecoverable partition data is fenced and repaired from peers when available. It must not be replaced by an empty healthy partition. A singleton has no peer copy to fetch."},"4028":{"id":"/docs/server/storage-engine-53","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#read-integrity","content":"Disk reads are verified before they reach a consumer:"},"4029":{"id":"/docs/server/storage-engine-54","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#read-integrity","content":"With validate_checksum = true (the default), every batch a disk poll reads is re-hashed and compared against its stored checksum. A mismatch stops the disk walk and logs an error on the server. The consumer receives any valid prefix already read, or an ordinary empty poll if none was read; the protocol does not report the checksum failure to the consumer. Repeated polls can therefore wait indefinitely at damaged data. Setting it to false skips the re-hash and serves whatever decodes, which can hand a consumer bytes provably not the ones written. Only disable it with a corruption guard elsewhere in the stack."},"4030":{"id":"/docs/server/storage-engine-55","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#read-integrity","content":"Binary polls reuse the stored batch layout. A reply may slice a larger stored batch and rewrite its header, and at-rest encryption requires decryption before the reply. HTTP additionally serializes the result as JSON."},"4031":{"id":"/docs/server/storage-engine-56","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#memory-pool","content":"Iggy includes a custom memory pool to reuse buffers on the hot path. The pool has 28 buckets with buffer sizes from 4 KiB up to 512 MiB (non-uniform spacing, denser around common message sizes, with sizes above 2 MiB rounded to hugepage-friendly steps). Components request a buffer from the appropriate bucket and return it when done."},"4032":{"id":"/docs/server/storage-engine-57","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#memory-pool","content":"Buffers are allocated lazily. A pool miss can allocate outside the pool, so message processing is not allocation-free. Internal components can pass ownership of existing buffers without copying their contents."},"4033":{"id":"/docs/server/storage-engine-58","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#retention-and-cleanup","content":"Two independent retention policies exist, both per-topic options configurable at creation or update (see Topic options). The segment cleaner enforces them:"},"4034":{"id":"/docs/server/storage-engine-59","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#retention-and-cleanup","content":"Size-based retention (max_topic_size): the cluster has no single owner of a topic-wide total, so each partition enforces an equal share: max_topic_size / partition_count, counted over sealed bytes. The share is floored at one sealed-segment ceiling (segment_size plus the maximum message-bus frame, since a sealed segment can overshoot by one batch). A cap that divides below that floor is raised to it, so the policy always means at least \"keep the newest sealed segment\". Once sealed bytes exceed the budget, the oldest sealed segments are trimmed. There is no percentage-based early trigger."},"4035":{"id":"/docs/server/storage-engine-60","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#retention-and-cleanup","content":"Time-based retention (message_expiry): sealed segments whose newest message is older than the expiry are deleted."},"4036":{"id":"/docs/server/storage-engine-61","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#retention-and-cleanup","content":"Both policies can be active at once. They only ever touch sealed segments. Deletion also stops at the minimum committed consumer or consumer-group offset, and pending persistence checkpoints can defer it. The active segment is never deleted by retention, even if its messages have expired."},"4037":{"id":"/docs/server/storage-engine-62","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#metadata-plane","content":"Metadata operations (create stream, delete topic, create user, and so on) do not use the partition storage above. They replicate through the metadata consensus group and persist in local_data/metadata/:"},"4038":{"id":"/docs/server/storage-engine-63","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#metadata-plane","content":"journal.wal: the prepare journal. Each entry is a 256-byte PrepareHeader (the consensus header carrying checksums, view, op and commit numbers, operation discriminant, and acting user) followed by the operation's wire-format body, exactly as replicated. This is the write-ahead log: an operation is journaled before it is applied."},"4039":{"id":"/docs/server/storage-engine-64","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#metadata-plane","content":"snapshot.bin: a MessagePack (rmp-serde) snapshot of the whole metadata state machine, written at checkpoints so the journal can be truncated. Recovery loads the snapshot, then replays journal entries newer than it, rebuilding the client session table alongside."},"4040":{"id":"/docs/server/storage-engine-65","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#metadata-plane","content":"superblock.a / superblock.b: a ping-pong pair of checkpoint records, where the newest valid slot wins by sequence number. The superblock records which checkpoint is current and the snapshot's checksum. Boot cross-checks the pairing: a superblock pointing at a checkpoint newer than the on-disk snapshot, or a snapshot whose checksum doesn't match the record, refuses to boot rather than silently rewinding committed state."},"4041":{"id":"/docs/server/storage-engine-66","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#metadata-plane","content":"Partition directories carry the same superblock mechanism for their own consensus state (replica identity, view), which is how a restarted replica proves it is itself rather than a blank impostor."},"4042":{"id":"/docs/server/storage-engine-67","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#encryption","content":"Iggy supports optional AES-256-GCM encryption for message payloads and user headers. They are encrypted before storage and decrypted for polling. Metadata journals, metadata snapshots, and structural record headers remain unencrypted. The key must decode from base64 to 32 bytes. See Security."},"4043":{"id":"/docs/server/storage-engine-68","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#compression","content":"The compression_algorithm topic option accepts none (default) and gzip, but it is a placeholder today: the value is persisted and reported back, but no message compression is applied. Payload encryption still applies when enabled. To compress today, do it client-side and tag messages via user headers - see the message headers examples in the Iggy repo."},"4044":{"id":"/docs/server/storage-engine-69","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"Earlier releases documented several storage features and [system.*] keys that no longer exist:"},"4045":{"id":"/docs/server/storage-engine-70","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"cache_indexes: removed. Index caching is internal now (see Indexes)."},"4046":{"id":"/docs/server/storage-engine-71","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"[system.message_deduplication]: removed configuration; it does not configure the partition request deduplication table."},"4047":{"id":"/docs/server/storage-engine-72","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"Segment archiving / S3 backup placeholders: removed. Delete archive_expired and the old [system.segment] table rather than retaining a false value."},"4048":{"id":"/docs/server/storage-engine-73","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"enforce_fsync: replaced by the topic durability policy. Consumer-offset completion has its own consumer_offset_durability policy. Both default independently to replicated."},"4049":{"id":"/docs/server/storage-engine-74","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"[system.*] tables: removed or moved to root tables. Retention, segment size, preallocation, and flush thresholds are per-topic options."},"4050":{"id":"/docs/server/storage-engine-75","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"The config loader rejects the old [system] table and IGGY_SYSTEM_* environment mappings. The full mapping is in Relocated configuration keys."},"4051":{"id":"/docs/server/testing","page_id":"/docs/server/testing","type":"page","content":"Testing with Iggy","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/testing"},"4052":{"id":"/docs/server/testing-0","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing","content":"Run the Iggy Docker image from your own test suite, with examples for Rust, Python and Node.js."},"4053":{"id":"/docs/server/testing-1","page_id":"/docs/server/testing","type":"heading","tags":[],"url":"/docs/server/testing#what-the-container-needs","content":"What the container needs"},"4054":{"id":"/docs/server/testing-2","page_id":"/docs/server/testing","type":"heading","tags":[],"url":"/docs/server/testing#rust","content":"Rust"},"4055":{"id":"/docs/server/testing-3","page_id":"/docs/server/testing","type":"heading","tags":[],"url":"/docs/server/testing#python","content":"Python"},"4056":{"id":"/docs/server/testing-4","page_id":"/docs/server/testing","type":"heading","tags":[],"url":"/docs/server/testing#nodejs","content":"Node.js"},"4057":{"id":"/docs/server/testing-5","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing","content":"Iggy has no embedded, in-process test server. The server ships as a binary, not a library, so a test suite can't start it in-process. To test against a real server, start the published Docker image when your tests start and stop it when they finish. The examples below use each language's testcontainers library to do that."},"4058":{"id":"/docs/server/testing-6","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#what-the-container-needs","content":"These settings apply whichever language your tests are in:"},"4059":{"id":"/docs/server/testing-7","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#what-the-container-needs","content":"seccomp=unconfined as a security option. Docker's default seccomp profile blocks the io_uring calls the server needs."},"4060":{"id":"/docs/server/testing-8","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#what-the-container-needs","content":"IGGY_ROOT_USERNAME and IGGY_ROOT_PASSWORD. Without them the server generates a random root password and only logs it once, which a test can't easily pick up."},"4061":{"id":"/docs/server/testing-9","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#what-the-container-needs","content":"IGGY_TCP_ADDRESS=0.0.0.0:8090 and IGGY_NODE_ADVERTISED_ADDRESS=localhost. By default the server listens on 127.0.0.1 inside the container, which a mapped port can't reach. Listening on all addresses also needs an advertised address, or the server won't start."},"4062":{"id":"/docs/server/testing-10","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#what-the-container-needs","content":"IGGY_SHARDING_CPU_ALLOCATION=all on Docker Desktop, WSL2 and other hosts with a single NUMA node. Without it, 0.9.0 exits with failed to bind shard 0 memory to its NUMA node. It does no harm elsewhere."},"4063":{"id":"/docs/server/testing-11","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#what-the-container-needs","content":"Wait for the server client listeners started log line before connecting. The server logs server running; waiting on shard threads earlier, before the port is open, and connecting on that line fails some of the time."},"4064":{"id":"/docs/server/testing-12","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#what-the-container-needs","content":"If the server exits with io_uring was denied locked memory, the container's locked-memory limit is too low for it. Raise it, as the --ulimit memlock=-1:-1 flag does in Docker & Helm."},"4065":{"id":"/docs/server/testing-13","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#rust","content":"This example uses testcontainers 0.27 and the iggy crate 0.11, which goes with server 0.9.0."},"4066":{"id":"/docs/server/testing-14","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#rust","content":"Run it with cargo test."},"4067":{"id":"/docs/server/testing-15","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#python","content":"This example uses testcontainers, pytest and pytest-asyncio with apache-iggy 0.9.0:"},"4068":{"id":"/docs/server/testing-16","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#python","content":"Run it with pytest -v."},"4069":{"id":"/docs/server/testing-17","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#nodejs","content":"This example uses testcontainers with apache-iggy 0.10.0, the Node.js SDK that goes with server 0.9.0, and the built-in node:test runner. testcontainers needs Node.js 22.19 or newer."},"4070":{"id":"/docs/server/testing-18","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#nodejs","content":"Save it as iggy.test.mjs and run it with node --test."},"4071":{"id":"/docs/server/topic-options","page_id":"/docs/server/topic-options","type":"page","content":"Topic Options","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/topic-options"},"4072":{"id":"/docs/server/topic-options-0","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options","content":"Per-topic retention, durability and segment layout options, set when the topic is created."},"4073":{"id":"/docs/server/topic-options-1","page_id":"/docs/server/topic-options","type":"heading","tags":[],"url":"/docs/server/topic-options#the-catalog","content":"The catalog"},"4074":{"id":"/docs/server/topic-options-2","page_id":"/docs/server/topic-options","type":"heading","tags":[],"url":"/docs/server/topic-options#setting-options","content":"Setting options"},"4075":{"id":"/docs/server/topic-options-3","page_id":"/docs/server/topic-options","type":"heading","tags":[],"url":"/docs/server/topic-options#create-only-vs-updatable","content":"Create-only vs updatable"},"4076":{"id":"/docs/server/topic-options-4","page_id":"/docs/server/topic-options","type":"heading","tags":[],"url":"/docs/server/topic-options#discovering-the-catalog","content":"Discovering the catalog"},"4077":{"id":"/docs/server/topic-options-5","page_id":"/docs/server/topic-options","type":"heading","tags":[],"url":"/docs/server/topic-options#durability","content":"Durability"},"4078":{"id":"/docs/server/topic-options-6","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options","content":"Retention, durability, and segment layout are per-topic decisions, made when the topic is created. They used to be server-wide [system.*] keys, which gave every knob two homes. The server now refuses to boot on the old keys, and each topic carries its own values instead."},"4079":{"id":"/docs/server/topic-options-7","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options","content":"Options are key-value pairs sent with CreateTopic. Unknown keys are rejected at the edge, never skipped: a silently ignored knob would leave the client on server defaults with no way to find out. The same mechanism exists for streams and users, but their catalogs are empty today. Only topics have option keys."},"4080":{"id":"/docs/server/topic-options-8","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Option"},"4081":{"id":"/docs/server/topic-options-9","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Default"},"4082":{"id":"/docs/server/topic-options-10","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Constraints"},"4083":{"id":"/docs/server/topic-options-11","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Description"},"4084":{"id":"/docs/server/topic-options-12","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"max_topic_size"},"4085":{"id":"/docs/server/topic-options-13","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"unlimited"},"4086":{"id":"/docs/server/topic-options-14","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"finite values at least segment_size"},"4087":{"id":"/docs/server/topic-options-15","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Per-partition limit on sealed segment bytes. Delete the oldest sealed segments once that partition exceeds it."},"4088":{"id":"/docs/server/topic-options-16","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"message_expiry"},"4089":{"id":"/docs/server/topic-options-17","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"none"},"4090":{"id":"/docs/server/topic-options-18","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Delete the oldest sealed segments whose newest message timestamp is older than this duration."},"4091":{"id":"/docs/server/topic-options-19","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"compression_algorithm"},"4092":{"id":"/docs/server/topic-options-20","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"none"},"4093":{"id":"/docs/server/topic-options-21","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"none or gzip"},"4094":{"id":"/docs/server/topic-options-22","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Placeholder: stored and reported, no compression applied yet."},"4095":{"id":"/docs/server/topic-options-23","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"segment_size"},"4096":{"id":"/docs/server/topic-options-24","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"1 GiB"},"4097":{"id":"/docs/server/topic-options-25","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"0 selects the default; otherwise a 512-byte multiple from 1 MiB through 1 GiB"},"4098":{"id":"/docs/server/topic-options-26","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Soft size limit per segment: a segment may close one whole batch past it."},"4099":{"id":"/docs/server/topic-options-27","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"durability"},"4100":{"id":"/docs/server/topic-options-28","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"replicated"},"4101":{"id":"/docs/server/topic-options-29","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"replicated or persisted"},"4102":{"id":"/docs/server/topic-options-30","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Message completion policy. persisted requires recoverable stable-storage copies at the replication quorum before success."},"4103":{"id":"/docs/server/topic-options-31","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"consumer_offset_durability"},"4104":{"id":"/docs/server/topic-options-32","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"replicated"},"4105":{"id":"/docs/server/topic-options-33","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"replicated or persisted"},"4106":{"id":"/docs/server/topic-options-34","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Completion policy for explicit consumer-offset stores and deletes, independent of message durability."},"4107":{"id":"/docs/server/topic-options-35","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"messages_required_to_save"},"4108":{"id":"/docs/server/topic-options-36","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"1024"},"4109":{"id":"/docs/server/topic-options-37","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"non-zero, at most 16777216"},"4110":{"id":"/docs/server/topic-options-38","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Flush the journal once it holds this many messages."},"4111":{"id":"/docs/server/topic-options-39","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"size_of_messages_required_to_save"},"4112":{"id":"/docs/server/topic-options-40","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"1 MiB"},"4113":{"id":"/docs/server/topic-options-41","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"0 selects the default; at most 1 GiB"},"4114":{"id":"/docs/server/topic-options-42","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Flush the journal once it holds this many bytes. Paired with the message count; whichever threshold trips first flushes."},"4115":{"id":"/docs/server/topic-options-43","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"preallocate_segments"},"4116":{"id":"/docs/server/topic-options-44","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"false"},"4117":{"id":"/docs/server/topic-options-45","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"segment_size x partitions at most 64 GiB per create"},"4118":{"id":"/docs/server/topic-options-46","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Reserve each segment's bytes up front where the filesystem supports it."},"4119":{"id":"/docs/server/topic-options-47","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Both retention policies can be active at once. The active segment is never touched, and its bytes are excluded from the size limit. A segment whose end offset exceeds the lowest stored consumer or consumer-group offset is retained; with no stored offsets, this barrier is absent. Deletion is done by the server's segment cleaner ([data_maintenance.messages], enabled by default)."},"4120":{"id":"/docs/server/topic-options-48","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Both durability policies write data to disk and default independently to replicated. Neither inherits the other. Flush thresholds schedule ordinary segment writes; required persistence, capacity pressure, or lifecycle operations can flush earlier. They do not weaken the persisted completion guarantee."},"4121":{"id":"/docs/server/topic-options-49","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Value forms are forgiving: byte sizes accept a raw number of bytes or a string like \"128 MiB\", expiry accepts microseconds or a humantime string like \"7 days\", booleans accept true/false. Create admission re-parses and re-encodes what you send, so a string segment_size=128MiB is stored as the number it names."},"4122":{"id":"/docs/server/topic-options-50","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"preallocate_segments requests a segment_size reservation for each partition's segment file when it is opened, including during topic creation and rotation. On Linux this reserves disk space without changing the file's logical length. Unsupported or failed reservations log a warning and fall back to ordinary allocation. With the default 1 GiB segment size, the request is 1 GiB per partition up front, which is why it's opt-in and why one create is capped at 64 GiB of requested reservation."},"4123":{"id":"/docs/server/topic-options-51","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#setting-options","content":"At creation, every interface takes the same keys:"},"4124":{"id":"/docs/server/topic-options-52","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#setting-options","content":"In the CLI, both durability policies have named flags. --set is repeatable and covers other storage options, such as segment_size. compression_algorithm, message_expiry, and max_topic_size also have first-class parameters. Run iggy options topic to discover what the server accepts."},"4125":{"id":"/docs/server/topic-options-53","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#setting-options","content":"SDKs expose typed durability values in their topic creation options. In Rust, set TopicCreateOptions::durability and TopicCreateOptions::consumer_offset_durability to Durability::Replicated or Durability::Persisted. The HTTP API takes \"durability\" and \"consumer_offset_durability\" as string values in the create body's options map."},"4126":{"id":"/docs/server/topic-options-54","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#setting-options","content":"Keys absent from the wire request are resolved by the admitting server and stored as derived entries. Typed SDKs can send their default durability values explicitly. Binary GetTopic responses carry explicit and derived blocks; HTTP reports an explicit flag per option. Both report option values and the provenance of the request. See the update limitation below."},"4127":{"id":"/docs/server/topic-options-55","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#create-only-vs-updatable","content":"Only three options can change after creation, via UpdateTopic:"},"4128":{"id":"/docs/server/topic-options-56","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#create-only-vs-updatable","content":"compression_algorithm"},"4129":{"id":"/docs/server/topic-options-57","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#create-only-vs-updatable","content":"message_expiry"},"4130":{"id":"/docs/server/topic-options-58","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#create-only-vs-updatable","content":"max_topic_size"},"4131":{"id":"/docs/server/topic-options-59","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#create-only-vs-updatable","content":"Updates are patches: a key you don't send keeps its current value."},"4132":{"id":"/docs/server/topic-options-60","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#create-only-vs-updatable","content":"The storage options (segment_size, durability, consumer_offset_durability, messages_required_to_save, size_of_messages_required_to_save, preallocate_segments) are create-only. A topic gets them at creation and keeps them. UpdateTopic rejects changes to either durability policy, so select both before creating the topic."},"4133":{"id":"/docs/server/topic-options-61","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#create-only-vs-updatable","content":"An update that explicitly sends server_default (zero) for message_expiry or max_topic_size has inconsistent reporting: the server retains the previous fixed response fields but stores zero in the corresponding option entries. The CLI sends these sentinels when those update arguments are omitted. Supply explicit expiry and size values when updating a topic; do not rely on zero to reset or preserve its retention settings."},"4134":{"id":"/docs/server/topic-options-62","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#discovering-the-catalog","content":"Ask the server which keys it accepts, with their types, defaults, and descriptions:"},"4135":{"id":"/docs/server/topic-options-63","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#discovering-the-catalog","content":"For HTTP, set IGGY_TOKEN to a valid JWT or personal access token:"},"4136":{"id":"/docs/server/topic-options-64","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#discovering-the-catalog","content":"The Rust SDK exposes the same call as describe_options. The scope is topic, stream, or user."},"4137":{"id":"/docs/server/topic-options-65","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#discovering-the-catalog","content":"Discovery matters most on the binary transports: TCP, QUIC, and WebSocket carry only an error code for a rejected key, not its name, so the catalog is how a client finds out what this server supports. Over HTTP the error message names the offending key directly."},"4138":{"id":"/docs/server/topic-options-66","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#durability","content":"replicated waits for quorum commit and application without an additional stable-storage barrier. persisted also requires recoverable stable-storage copies at the required quorum. On a single node that means recoverable local persistence before success; in a cluster it uses durable prepare history. Setting messages_required_to_save=1 is not required for persisted."},"4139":{"id":"/docs/server/topic-options-67","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#durability","content":"The former enforce_fsync option is rejected. Use durability for messages and consumer_offset_durability for explicit offset changes. Poll auto-commit remains asynchronous, and HTTP ack=none confirms dispatch only, regardless of these policies."},"4140":{"id":"/docs/server/topic-options-68","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#durability","content":"See Durability for single-node failure behavior and Cluster Durability for the quorum and WAL guarantees."},"4141":{"id":"/docs/server/upgrading","page_id":"/docs/server/upgrading","type":"page","content":"Upgrading from 0.8 to 0.9","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/upgrading"},"4142":{"id":"/docs/server/upgrading-0","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading","content":"What you need to change when moving from Apache Iggy 0.8 to 0.9: a fresh data directory, matching SDKs, and config changes."},"4143":{"id":"/docs/server/upgrading-1","page_id":"/docs/server/upgrading","type":"heading","tags":[],"url":"/docs/server/upgrading#start-from-a-fresh-data-directory","content":"Start from a fresh data directory"},"4144":{"id":"/docs/server/upgrading-2","page_id":"/docs/server/upgrading","type":"heading","tags":[],"url":"/docs/server/upgrading#upgrade-the-server-and-every-sdk-together","content":"Upgrade the server and every SDK together"},"4145":{"id":"/docs/server/upgrading-3","page_id":"/docs/server/upgrading","type":"heading","tags":[],"url":"/docs/server/upgrading#review-your-configuration","content":"Review your configuration"},"4146":{"id":"/docs/server/upgrading-4","page_id":"/docs/server/upgrading","type":"heading","tags":[],"url":"/docs/server/upgrading#set-an-advertised-address-when-listening-on-all-interfaces","content":"Set an advertised address when listening on all interfaces"},"4147":{"id":"/docs/server/upgrading-5","page_id":"/docs/server/upgrading","type":"heading","tags":[],"url":"/docs/server/upgrading#if-you-build-connectors-in-rust","content":"If you build connectors in Rust"},"4148":{"id":"/docs/server/upgrading-6","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading","content":"0.9.0 is a major upgrade with breaking changes to the data format, the wire protocol and the server configuration. Work through this list before moving an existing deployment. The 0.9.0 release post has the full list of changes."},"4149":{"id":"/docs/server/upgrading-7","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#start-from-a-fresh-data-directory","content":"The on-disk format changed, and 0.9.0 can't read a data directory written by 0.8. There is no migration. Copy out anything you need to keep before switching over, then start 0.9.0 with an empty data directory."},"4150":{"id":"/docs/server/upgrading-8","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#upgrade-the-server-and-every-sdk-together","content":"0.8 clients can't talk to a 0.9.0 server, and 0.9 clients can't talk to a 0.8 server. There is no fallback between the two protocols, so plan a cutover where the server and all your clients change at the same time, rather than a rolling upgrade."},"4151":{"id":"/docs/server/upgrading-9","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#upgrade-the-server-and-every-sdk-together","content":"Check Server compatibility for the SDK version that goes with the 0.9.0 server in each language."},"4152":{"id":"/docs/server/upgrading-10","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#review-your-configuration","content":"Don't carry the old config.toml or IGGY_* environment variables across unchanged. The server refuses to start if it finds a setting that has moved or been removed."},"4153":{"id":"/docs/server/upgrading-11","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#review-your-configuration","content":"The [system] table is gone. Its path key and the tables under it (runtime, logging, encryption, partition, sharding and memory_pool) move to the top level of the config. Environment variables lose SYSTEM_, so IGGY_SYSTEM_PATH becomes IGGY_PATH."},"4154":{"id":"/docs/server/upgrading-12","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#review-your-configuration","content":"The [stream] and [topic] tables are gone. Settings like segment_size, messages_required_to_save and size_of_messages_required_to_save are now set per topic when the topic is created. See Topic options."},"4155":{"id":"/docs/server/upgrading-13","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#review-your-configuration","content":"enforce_fsync and consumer_offset_enforce_fsync are gone. Durability is now chosen per topic, with durability and consumer_offset_durability. See Durability."},"4156":{"id":"/docs/server/upgrading-14","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#review-your-configuration","content":"The [cluster] and sharding sections were reworked. Compare yours with Configuration."},"4157":{"id":"/docs/server/upgrading-15","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#set-an-advertised-address-when-listening-on-all-interfaces","content":"If a listener binds to a wildcard address such as 0.0.0.0, the server now needs an advertised address too, set with IGGY_NODE_ADVERTISED_ADDRESS or node.advertised_address. 0.8 allowed a wildcard bind without one; 0.9.0 won't start. This affects most Docker deployments. See Docker & Helm."},"4158":{"id":"/docs/server/upgrading-16","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#if-you-build-connectors-in-rust","content":"In the connector SDK, ConnectivityConfig is replaced by RetryPolicy. This only affects Rust code written against the SDK. Connector plugins that are already built are unaffected."},"4159":{"id":"/docs/web_ui/start","page_id":"/docs/web_ui/start","type":"page","content":"Iggy Web UI","breadcrumbs":["Documentation","Web UI"],"tags":[],"url":"/docs/web_ui/start"},"4160":{"id":"/docs/web_ui/start-0","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start","content":"The Iggy Web UI dashboard, for monitoring server health and browsing streams, topics, messages and users."},"4161":{"id":"/docs/web_ui/start-1","page_id":"/docs/web_ui/start","type":"heading","tags":[],"url":"/docs/web_ui/start#how-it-connects","content":"How it connects"},"4162":{"id":"/docs/web_ui/start-2","page_id":"/docs/web_ui/start","type":"heading","tags":[],"url":"/docs/web_ui/start#running-modes","content":"Running modes"},"4163":{"id":"/docs/web_ui/start-3","page_id":"/docs/web_ui/start","type":"heading","tags":[],"url":"/docs/web_ui/start#embedded-mode","content":"Embedded mode"},"4164":{"id":"/docs/web_ui/start-4","page_id":"/docs/web_ui/start","type":"heading","tags":[],"url":"/docs/web_ui/start#standalone-mode","content":"Standalone mode"},"4165":{"id":"/docs/web_ui/start-5","page_id":"/docs/web_ui/start","type":"heading","tags":[],"url":"/docs/web_ui/start#local-development","content":"Local development"},"4166":{"id":"/docs/web_ui/start-6","page_id":"/docs/web_ui/start","type":"heading","tags":[],"url":"/docs/web_ui/start#features","content":"Features"},"4167":{"id":"/docs/web_ui/start-7","page_id":"/docs/web_ui/start","type":"heading","tags":[],"url":"/docs/web_ui/start#docker-compose-example","content":"Docker Compose example"},"4168":{"id":"/docs/web_ui/start-8","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start","content":"Iggy Web UI provides a comprehensive dashboard for Iggy server. It allows you to monitor the server's health, streams, topics, browse the messages, users and more. The dashboard is built with SvelteKit and TypeScript and is available as open-source as well as the Docker image on Docker Hub."},"4169":{"id":"/docs/web_ui/start-9","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start","content":"These instructions target Iggy server 0.9.0. Use a matching source checkout for local builds."},"4170":{"id":"/docs/web_ui/start-10","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#how-it-connects","content":"The Web UI is a purely client-side application: every call to the Iggy HTTP API is issued by your browser, not by the Web UI container or server. Two things follow from this:"},"4171":{"id":"/docs/web_ui/start-11","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#how-it-connects","content":"PUBLIC_IGGY_API_URL must be a URL that the browser can reach (e.g. http://localhost:3010), not an internal Docker network hostname like http://iggy:80."},"4172":{"id":"/docs/web_ui/start-12","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#how-it-connects","content":"The Iggy server must allow cross-origin requests from the Web UI origin. CORS is enabled for all origins by default ([http.cors] in the server config). If you restricted allowed_origins, add the Web UI origin."},"4173":{"id":"/docs/web_ui/start-13","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#how-it-connects","content":"In embedded mode neither applies: the UI is served from the same origin as the HTTP API and uses relative URLs."},"4174":{"id":"/docs/web_ui/start-14","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#embedded-mode","content":"The Web UI is compiled directly into the Iggy server binary via the iggy-web cargo feature, which is enabled by default (official binaries and Docker images include it). To serve it at the /ui endpoint, flip the web_ui flag (disabled by default):"},"4175":{"id":"/docs/web_ui/start-15","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#embedded-mode","content":"When building from source, generate the static assets before compiling the server. Run from the repository root:"},"4176":{"id":"/docs/web_ui/start-16","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#embedded-mode","content":"The feature alone does not generate these assets. A server binary built without them returns 404 at /ui."},"4177":{"id":"/docs/web_ui/start-17","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#embedded-mode","content":"If the server is compiled without the iggy-web feature and web_ui = true, a warning is logged but the server continues to run normally."},"4178":{"id":"/docs/web_ui/start-18","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#standalone-mode","content":"Start an Iggy server with HTTP enabled, as shown in Getting started, then run the Web UI as a separate container:"},"4179":{"id":"/docs/web_ui/start-19","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#standalone-mode","content":"PUBLIC_IGGY_API_URL is consumed by the browser: if the Iggy server also runs in Docker, use the host-published HTTP port here, not the container's network alias."},"4180":{"id":"/docs/web_ui/start-20","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#local-development","content":"The Web UI lives in the web/ folder of the repository. Use a Node.js version supported by the frontend toolchain (^20.19.0 || ^22.13.0 || >=24, for example Node.js 22.13 or later in the 22.x series) and npm (pnpm and yarn are not part of the supported workflow):"},"4181":{"id":"/docs/web_ui/start-21","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#local-development","content":"Point the UI at your Iggy server's HTTP API via a .env file in the web/ folder, e.g. PUBLIC_IGGY_API_URL=http://127.0.0.1:3000."},"4182":{"id":"/docs/web_ui/start-22","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"The Web UI provides the following pages and functionality:"},"4183":{"id":"/docs/web_ui/start-23","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"Overview - server health and key metrics"},"4184":{"id":"/docs/web_ui/start-24","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"Streams - list, create, and manage streams"},"4185":{"id":"/docs/web_ui/start-25","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"Topics - create and delete topics, and edit their name and message expiry"},"4186":{"id":"/docs/web_ui/start-26","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"Partitions - view partition details per topic"},"4187":{"id":"/docs/web_ui/start-27","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"Messages - browse messages per partition with built-in decoders:"},"4188":{"id":"/docs/web_ui/start-28","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"JSON decoder (formatted JSON output)"},"4189":{"id":"/docs/web_ui/start-29","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"String decoder (UTF-8 text)"},"4190":{"id":"/docs/web_ui/start-30","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"XML decoder"},"4191":{"id":"/docs/web_ui/start-31","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"Users - list and create users, including their initial permissions"},"4192":{"id":"/docs/web_ui/start-32","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"Settings - Web UI preferences"},"4193":{"id":"/docs/web_ui/start-33","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"Topic updates share the HTTP API's retention update limitations. Other topic options require the CLI or HTTP API."},"4194":{"id":"/docs/web_ui/start-34","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"The Clients, Logs and terminal routes are placeholders hidden from navigation. The Server settings page displays information, but saving settings is disabled. Editing and deleting existing users, changing their permissions and bulk user actions are also placeholders. See the roadmap for what is planned."},"4195":{"id":"/docs/web_ui/start-35","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#docker-compose-example","content":"Here's the full example of the docker-compose.yml file that starts the Iggy server, initializes it with the my-stream stream and my-topic topic with the help of Iggy CLI, and starts the Iggy Web UI:"},"4196":{"id":"/docs/connectors/sinks/clickhouse","page_id":"/docs/connectors/sinks/clickhouse","type":"page","content":"ClickHouse Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/clickhouse"},"4197":{"id":"/docs/connectors/sinks/clickhouse-0","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse","content":"Insert messages from Iggy streams into ClickHouse tables over the HTTP interface."},"4198":{"id":"/docs/connectors/sinks/clickhouse-1","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#configuration","content":"Configuration"},"4199":{"id":"/docs/connectors/sinks/clickhouse-2","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#options","content":"Options"},"4200":{"id":"/docs/connectors/sinks/clickhouse-3","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"Insert Formats"},"4201":{"id":"/docs/connectors/sinks/clickhouse-4","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#error-handling--delivery-semantics","content":"Error Handling & Delivery Semantics"},"4202":{"id":"/docs/connectors/sinks/clickhouse-5","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#transforms","content":"Transforms"},"4203":{"id":"/docs/connectors/sinks/clickhouse-6","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse","content":"The ClickHouse sink connector consumes messages from Iggy streams and inserts them into ClickHouse tables over the HTTP interface. It supports three insert formats: json_each_row (default), row_binary, and string passthrough for pre-formatted CSV/TSV/JSON payloads."},"4204":{"id":"/docs/connectors/sinks/clickhouse-7","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse","content":"This page is a curated subset of the documentation. The canonical reference is the upstream clickhouse_sink README in the apache/iggy repository."},"4205":{"id":"/docs/connectors/sinks/clickhouse-8","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.9.0/edge repository root, build the plugin:"},"4206":{"id":"/docs/connectors/sinks/clickhouse-9","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#configuration","content":"The sample expects a local ClickHouse HTTP endpoint with user default and an empty password. Create a test table with matching columns:"},"4207":{"id":"/docs/connectors/sinks/clickhouse-10","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#configuration","content":"Save the configuration below in the runtime's connector directory. Set the endpoint, credentials, database, and table for your deployment."},"4208":{"id":"/docs/connectors/sinks/clickhouse-11","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#configuration","content":"Create the Iggy stream and topic, then send a JSON row before starting the runtime:"},"4209":{"id":"/docs/connectors/sinks/clickhouse-12","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"Option"},"4210":{"id":"/docs/connectors/sinks/clickhouse-13","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"Type"},"4211":{"id":"/docs/connectors/sinks/clickhouse-14","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"Default"},"4212":{"id":"/docs/connectors/sinks/clickhouse-15","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"Description"},"4213":{"id":"/docs/connectors/sinks/clickhouse-16","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"url"},"4214":{"id":"/docs/connectors/sinks/clickhouse-17","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"string"},"4215":{"id":"/docs/connectors/sinks/clickhouse-18","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"required"},"4216":{"id":"/docs/connectors/sinks/clickhouse-19","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"ClickHouse HTTP endpoint"},"4217":{"id":"/docs/connectors/sinks/clickhouse-20","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"table"},"4218":{"id":"/docs/connectors/sinks/clickhouse-21","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"string"},"4219":{"id":"/docs/connectors/sinks/clickhouse-22","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"required"},"4220":{"id":"/docs/connectors/sinks/clickhouse-23","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"Target table name"},"4221":{"id":"/docs/connectors/sinks/clickhouse-24","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"database"},"4222":{"id":"/docs/connectors/sinks/clickhouse-25","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"string"},"4223":{"id":"/docs/connectors/sinks/clickhouse-26","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"default"},"4224":{"id":"/docs/connectors/sinks/clickhouse-27","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"ClickHouse database"},"4225":{"id":"/docs/connectors/si