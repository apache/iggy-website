inks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#configuration","content":"Wait for the readiness command to report accepting connections. Save this connector file in the runtime's connector directory. Replace the URI for your deployment. Startup opens the SQLx pool and runs SELECT 1. It creates the table only when requested."},"6051":{"id":"/docs/connectors/sinks/postgres-20","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#configuration","content":"Create the Iggy resources and send a message:"},"6052":{"id":"/docs/connectors/sinks/postgres-21","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"Option"},"6053":{"id":"/docs/connectors/sinks/postgres-22","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"Type"},"6054":{"id":"/docs/connectors/sinks/postgres-23","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"Default"},"6055":{"id":"/docs/connectors/sinks/postgres-24","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"Description"},"6056":{"id":"/docs/connectors/sinks/postgres-25","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"connection_string"},"6057":{"id":"/docs/connectors/sinks/postgres-26","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"string"},"6058":{"id":"/docs/connectors/sinks/postgres-27","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"requ