,"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"verbose_logging"},"4765":{"id":"/docs/connectors/sinks/mongodb-55","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"bool"},"4766":{"id":"/docs/connectors/sinks/mongodb-56","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"false"},"4767":{"id":"/docs/connectors/sinks/mongodb-57","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"Enable detailed logging"},"4768":{"id":"/docs/connectors/sinks/mongodb-58","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"max_retries"},"4769":{"id":"/docs/connectors/sinks/mongodb-59","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"u32"},"4770":{"id":"/docs/connectors/sinks/mongodb-60","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"3"},"4771":{"id":"/docs/connectors/sinks/mongodb-61","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"Total attempts per transiently failing insert call, including the first; 0 and 1 both allow one attempt"},"4772":{"id":"/docs/connectors/sinks/mongodb-62","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"retry_delay"},"4773":{"id":"/docs/connectors/sinks/mongodb-63","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"string"},"4774":{"id":"/docs/connectors/sinks/mongodb-64","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"\"1s\""},"4775":{"id":"/docs/connectors/sinks/mongodb-65","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"Base for linear backoff: delay multiplied by the retry number"},"4776":{"id":"/docs/connectors/sinks/mongodb-66","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#stored-documents","content":"Every document has a generated _id of stream:topic:partition:message_id and a payload field. The offset is not part of the ID. Payload fields remain nested under payload, so a payload's own _id does not replace the connector's ID. Message headers are not stored."},"4777":{"id":"/docs/connectors/sinks/mongodb-67","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#stored-documents","content":"json parses the payload and converts it to a BSON value under payload, including objects, arrays and scalars. Invalid JSON or an unsupported BSON conversion rejects the whole chunk before insertion."},"4778":{"id":"/docs/connectors/sinks/mongodb-68","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#stored-documents","content":"string and its text alias require valid UTF-8 and store a BSON string."},"4779":{"id":"/docs/connectors/sinks/mongodb-69","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#stored-documents","content":"binary stores BSON Binary with the generic subtype. Use schema = \"raw\" and no payload-changing transform to preserve original bytes."},"4780":{"id":"/docs/connectors/sinks/mongodb-70","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#stored-documents","content":"Format names are case-insensitive. Formatting happens after stream decoding and transforms, so JSON decoding can change the original bytes."},"4781":{"id":"/docs/connectors/sinks/mongodb-71","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#stored-documents","content":"With include_metadata = true, documents contain iggy_offset, iggy_timestamp, iggy_stream, iggy_topic and iggy_partition_id. Offsets above the signed 64-bit range use iggy_offset_str instead. Partition IDs use a BSON 32-bit integer when possible and a 64-bit integer otherwise. iggy_checksum is a 64-bit integer when possible and a decimal string otherwise. Message and origin timestamps become BSON datetimes, truncating microseconds to milliseconds. Checksum and origin timestamp flags are independent of include_metadata; _id and payload are always present."},"4782":{"id":"/docs/connectors/sinks/mongodb-72","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#delivery-semantics","content":"Each polled batch is split into chunks of at most batch_size messages. Chunks are inserted immediately with unordered insert_many; other documents can succeed when one is rejected. Later chunks are still attempted after a failure, and the last chunk error is returned. There is no accumulation across polls and no transaction covering the batch."},"4783":{"id":"/docs/connectors/sinks/mongodb-73","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#delivery-semantics","content":"The connector retries transient insert failures up to max_retries total attempts, with linear waits of retry_delay, twice that delay, and so on. An invalid delay silently falls back to 1s. Driver-level retryable writes may add retries independently, according to the URI and MongoDB deployment. Startup has no connector-level retry loop."},"4784":{"id":"/docs/connectors/sinks/mongodb-74","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#delivery-semantics","content":"An insert error containing only duplicate-key errors (11000) and no write-concern error is treated as success. This covers all unique indexes, not only _id, and does not compare payload contents. Reusing a message ID in one stream/topic/partition preserves the existing document. A conflict on another unique index can also discard a distinct message while runtime reports it processed. Account for this when choosing collection indexes."},"4785":{"id":"/docs/connectors/sinks/mongodb-75","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#delivery-semantics","content":"The runtime auto-commits while polling, records plugin errors and continues without replaying the failed batch. Earlier or later chunks may already be stored, and a timeout can leave the write outcome uncertain. Duplicate tolerance and retries do not provide an end-to-end at-least-once guarantee."},"4786":{"id":"/docs/connectors/sinks/mongodb-76","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#transforms","content":"You can apply transforms before writing to MongoDB. Every [transforms.*] section requires enabled = true. See the transforms documentation for details."},"4787":{"id":"/docs/connectors/sinks/postgres","page_id":"/docs/connectors/sinks/postgres","type":"page","content":"Postgres Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/postgres"},"4788":{"id":"/docs/connectors/sinks/postgres-0","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres","content":"Store messages from Iggy topics in a PostgreSQL table, with optional table creation and configurable payload storage."},"4789":{"id":"/docs/connectors/sinks/postgres-1","page_id":"/docs/connectors/sinks/postgres","type":"heading","tags":[],"url":"/docs/connectors/sinks/postgres#features","content":"Features"},"4790":{"id":"/docs/connectors/sinks/postgres-2","page_id":"/docs/connectors/sinks/postgres","type":"heading","tags":[],"url":"/docs/connectors/sinks/postgres#configuration","content":"Configuration"},"4791":{"id":"/docs/connectors/sinks/postgres-3","page_id":"/docs/connectors/sinks/postgres","type":"heading","tags":[],"url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"Plugin config options"},"4792":{"id":"/docs/connectors/sinks/postgres-4","page_id":"/docs/connectors/sinks/postgres","type":"heading","tags":[],"url":"/docs/connectors/sinks/postgres#payload-format","content":"Payload Format"},"4793":{"id":"/docs/connectors/sinks/postgres-5","page_id":"/docs/connectors/sinks/postgres","type":"heading","tags":[],"url":"/docs/connectors/sinks/postgres#table-schema","content":"Table Schema"},"4794":{"id":"/docs/connectors/sinks/postgres-6","page_id":"/docs/connectors/sinks/postgres","type":"heading","tags":[],"url":"/docs/connectors/sinks/postgres#querying-the-data","content":"Querying the Data"},"4795":{"id":"/docs/connectors/sinks/postgres-7","page_id":"/docs/connectors/sinks/postgres","type":"heading","tags":[],"url":"/docs/connectors/sinks/postgres#delivery-semantics","content":"Delivery Semantics"},"4796":{"id":"/docs/connectors/sinks/postgres-8","page_id":"/docs/connectors/sinks/postgres","type":"heading","tags":[],"url":"/docs/connectors/sinks/postgres#performance-considerations","content":"Performance Considerations"},"4797":{"id":"/docs/connectors/sinks/postgres-9","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres","content":"The PostgreSQL sink connector consumes messages from Iggy topics and stores them in a PostgreSQL table, with optional automatic table creation and configurable payload storage."},"4798":{"id":"/docs/connectors/sinks/postgres-10","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres","content":"This page is a curated subset of the documentation. The canonical reference, including SQL query recipes for each payload format, is the upstream postgres_sink README in the apache/iggy repository."},"4799":{"id":"/docs/connectors/sinks/postgres-11","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#features","content":"Automatic Table Creation: Optionally create the target table on startup"},"4800":{"id":"/docs/connectors/sinks/postgres-12","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#features","content":"Batch Processing: Insert messages in configurable batches for performance"},"4801":{"id":"/docs/connectors/sinks/postgres-13","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#features","content":"Metadata Storage: Store Iggy message metadata (offset, timestamp, topic, etc.)"},"4802":{"id":"/docs/connectors/sinks/postgres-14","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#features","content":"Configurable Payload Storage: Store the payload as raw bytes, native JSONB, or text"},"4803":{"id":"/docs/connectors/sinks/postgres-15","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#features","content":"Automatic Retries: Transient database errors are retried with a configurable delay"},"4804":{"id":"/docs/connectors/sinks/postgres-16","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#features","content":"Connection Pooling: Efficient database connection management"},"4805":{"id":"/docs/connectors/sinks/postgres-17","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postg