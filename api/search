rotocol/encodings#header-kinds","content":"Int128"},"665":{"id":"/docs/binary-protocol/encodings-80","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"Integers are little-endian. Bool is one byte."},"666":{"id":"/docs/binary-protocol/encodings-81","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#user-headers-block","content":"A user headers block (inside a message frame) is a flat run of TLV fields:"},"667":{"id":"/docs/binary-protocol/encodings-82","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#user-headers-block","content":"Fields pair up: first the key, then the value. Keys and values can both use the header kinds above. Every length must be 1..=255, kind 0 is rejected, and the block must consume its byte range exactly. The wire validator preserves unknown non-zero kind codes. A typed SDK accessor may still reject a kind it does not recognize."},"668":{"id":"/docs/binary-protocol/encodings-83","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"CreateStream, UpdateStream, CreateTopic, UpdateTopic, CreateUser, and UpdateUser end with a key-value options block that reuses the user-headers TLV encoding. The block runs from its start to the end of the payload (no length prefix, and the validator requires exact consumption) and may be empty."},"669":{"id":"/docs/binary-protocol/encodings-84","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"On top of the TLV walk, options enforce: string keys only (kind 2, valid UTF-8), no duplicate keys, at most 1024 entries, and at most 100000 bytes total."},"670":{"id":"/docs/binary-protocol/encodings-85","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"Semantics:"},"671":{"id":"/docs/binary-protocol/encodings-86","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"Create requests resolve absent keys to server defaults and persist the effective values. An update using a zero retention sentinel can make GetTopic option values disagree with its fixed expiry/size fields; see update semantics."},"672":{"id":"/docs/binary-protocol/encodings-87","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"Update requests are patches: keys absent from the block are left alone, never reset. A client built before a key existed cannot erase it."},"673":{"id":"/docs/binary-protocol/encodings-88","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"Unknown keys are rejected at the wire edge, never silently skipped."},"674":{"id":"/docs/binary-protocol/encodings-89","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"The catalog is discoverable at runtime with DESCRIBE_OPTIONS (code 13), payload [scope: u8] with scope 1 = topic, 2 = stream, 3 = user (HTTP: GET /options/topic). Today only topics have keys. The stream and user catalogs are empty, and any key sent for them is rejected. The topic catalog (segment_size, durability, consumer_offset_durability, message_expiry, max_topic_size, and the rest) with defaults and constraints is documented on the Topic options page. UpdateTopic accepts only compression_algorithm, message_expiry, and max_topic_size. Both durability policies and the storage-layout knobs are create-only."},"675":{"id":"/docs/binary-protocol/encodings-90","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"The compression_algorithm value used by topic options:"},"676":{"id":"/docs/binary-protocol/encodings-91","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"Code / name"},"677":{"id":"/docs/binary-protocol/encodings-92","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"Algorithm"},"678":{"id":"/docs/binary-protocol/encodings-93","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"1, none"},"679":{"id":"/docs/binary-protocol/encodings-94","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"No compression (default)"},"680":{"id":"/docs/binary-protocol/encodings-95","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"2, gzip"},"681":{"id":"/docs/binary-protocol/encodings-96","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"Gzip"},"682":{"id":"/docs/binary-protocol/encodings-97","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"Any other value is rejected. The option is a placeholder today: the value is validated, persisted, and echoed back, but it does not enable automatic payload compression or decompression. To compress today, do it client-side and tag messages via user headers - see the message headers examples in the Iggy repo."},"683":{"id":"/docs/binary-protocol/framing","page_id":"/docs/binary-protocol/framing","type":"page","content":"Framing","breadcrumbs":["Documentation","Binary Protocol"],"tags":[],"url":"/docs/binary-protocol/framing"},"684":{"id":"/docs/binary-protocol/framing-0","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"The fixed 256-byte header every binary-transport message rides in, and the request, reply and eviction shapes it carries."},"685":{"id":"/docs/binary-protocol/framing-1","page_id":"/docs/binary-protocol/framing","type":"heading","tags":[],"url":"/docs/binary-protocol/framing#requestheader","content":"RequestHeader"},"686":{"id":"/docs/binary-protocol/framing-2","page_id":"/docs/binary-protocol/framing","type":"heading","tags":[],"url":"/docs/binary-protocol/framing#operation-discriminants","content":"Operation discriminants"},"687":{"id":"/docs/binary-protocol/framing-3","page_id":"/docs/binary-protocol/framing","type":"heading","tags":[],"url":"/docs/binary-protocol/framing#request-numbering","content":"Request numbering"},"688":{"id":"/docs/binary-protocol/framing-4","page_id":"/docs/binary-protocol/framing","type":"heading","tags":[],"url":"/docs/binary-protocol/framing#replyheader","content":"ReplyHeader"},"689":{"id":"/docs/binary-protocol/framing-5","page_id":"/docs/binary-protocol/framing","type":"heading","tags":[],"url":"/docs/binary-protocol/framing#result-section","content":"Result section"},"690":{"id":"/docs/binary-protocol/framing-6","page_id":"/docs/binary-protocol/framing","type":"heading","tags":[],"url":"/docs/binary-protocol/framing#evictionheader","content":"EvictionHeader"},"691":{"id":"/docs/binary-protocol/framing-7","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"Every message on a binary transport is a fixed 256-byte header followed by an optional body. The header is a #[repr(C)] struct decoded by pointer cast (zero-copy), so field offsets are fixed and enforced at compile time in the server. Three header shapes cross the client boundary:"},"692":{"id":"/docs/binary-protocol/framing-8","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"RequestHeader: client to server."},"693":{"id":"/docs/binary-protocol/framing-9","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"ReplyHeader: server to client, answers one request."},"694":{"id":"/docs/binary-protocol/framing-10","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"EvictionHeader: server to client, session-terminal rejection with no body."},"695":{"id":"/docs/binary-protocol/framing-11","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"The header shape is identified by the command byte at offset 60. Values a client sends or receives:"},"696":{"id":"/docs/binary-protocol/framing-12","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"command"},"697":{"id":"/docs/binary-protocol/framing-13","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"Value"},"698":{"id":"/docs/binary-protocol/framing-14","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"Direction"},"699":{"id":"/docs/binary-protocol/framing-15","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"Meaning"},"700":{"id":"/docs/binary-protocol/framing-16","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"Request"},"701":{"id":"/docs/binary-protocol/framing-17","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"5"},"702":{"id":"/docs/binary-protocol/framing-18","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"client to server"},"703":{"id":"/docs/binary-protocol/framing-19","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"A command request"},"704":{"id":"/docs/binary-protocol/framing-20","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"Reply"},"705":{"id":"/docs/binary-protocol/framing-21","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"8"},"706":{"id":"/docs/binary-protocol/framing-22","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"server to client"},"707":{"id":"/docs/binary-protocol/framing-23","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"Answer to one request"},"708":{"id":"/docs/binary-protocol/framing-24","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"Eviction"},"709":{"id":"/docs/binary-protocol/framing-25","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"13"},"710":{"id":"/docs/binary-protocol/framing-26","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"server to client"},"711":{"id":"/docs/binary-protocol/framing-27","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"Session is dead, no per-request correlation"},"712":{"id":"/docs/binary-protocol/framing-28","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"Other command values (Prepare, PrepareOk, view-change traffic, and so on) are replica-to-replica consensus messages and never appear on a client connection. They are documented on the Server-to-server page."},