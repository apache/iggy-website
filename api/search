179":{"id":"/docs/sdk/connection-strings-151","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"false"},"3180":{"id":"/docs/sdk/connection-strings-152","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"tls_domain"},"3181":{"id":"/docs/sdk/connection-strings-153","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"Name for TLS validation. When empty, use the connected IP"},"3182":{"id":"/docs/sdk/connection-strings-154","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"empty"},"3183":{"id":"/docs/sdk/connection-strings-155","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"tls_ca_file"},"3184":{"id":"/docs/sdk/connection-strings-156","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"PEM file of trusted CA certificates when validation is enabled"},"3185":{"id":"/docs/sdk/connection-strings-157","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"none"},"3186":{"id":"/docs/sdk/connection-strings-158","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"tls_validate_certificate"},"3187":{"id":"/docs/sdk/connection-strings-159","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"Validate the server certificate (true/false)"},"3188":{"id":"/docs/sdk/connection-strings-160","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"false"},"3189":{"id":"/docs/sdk/connection-strings-161","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"WebSocket TLS does not validate the server certificate unless tls_validate_certificate=true. With validation enabled, tls_ca_file replaces the built-in Mozilla roots. Size limits cannot be removed through connection strings. Use the WebSocket configuration object for an unlimited message or frame size."},"3190":{"id":"/docs/sdk/connection-strings-162","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#http-options","content":"Key"},"3191":{"id":"/docs/sdk/connection-strings-163","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#http-options","content":"Description"},"3192":{"id":"/docs/sdk/connection-strings-164","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#http-options","content":"Default"},"3193":{"id":"/docs/sdk/connection-strings-165","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#http-options","content":"heartbeat_interval"},"3194":{"id":"/docs/sdk/connection-strings-166","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#http-options","content":"Duration between heartbeats"},"3195":{"id":"/docs/sdk/connection-strings-167","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#http-options","content":"5s"},"3196":{"id":"/docs/sdk/connection-strings-168","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#http-options","content":"retries"},"3197":{"id":"/docs/sdk/connection-strings-169","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#http-options","content":"Maximum retries for transient request failures"},"3198":{"id":"/docs/sdk/connection-strings-170","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#http-options","content":"3"},"3199":{"id":"/docs/sdk/connection-strings-171","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#http-options","content":"The HTTP scheme constructs a plain http:// API URL. Use the Rust HTTP builder's with_api_url() for HTTPS. HTTP parses the credential field but does not log in with it. In Rust, call login_user() or login_with_personal_access_token() explicitly before protected requests."},"3200":{"id":"/docs/sdk/connection-strings-172","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#usage","content":"In Rust, construct clients inside a Tokio runtime, which QUIC needs even before connect(). The following snippet assumes an async function returning Result<_, IggyError> and the matching Rust SDK setup."},"3201":{"id":"/docs/sdk/connection-strings-173","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#usage","content":"When you need settings a connection string cannot express (client-side encryption, a custom Partitioner, and similar), start from IggyClientBuilder::from_connection_string() and extend the builder on top."},"3202":{"id":"/docs/sdk/connection-strings-174","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#pending-operation-limits","content":"Rust binary transport strings accept max_pending_operations and max_pending_operation_bytes. Defaults are 256 operations and 67108864 bytes. Both must be positive. The byte budget includes frozen headers and bodies, so it must fit the largest mutation you need to send."},"3203":{"id":"/docs/sdk/connection-strings-175","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#pending-operation-limits","content":"Committing fetches use a separate pool with the same configured limits. That pool stores target metadata, not reply bodies, and retains unknown progress across sessions. Exhausting a limit rejects or delays further work according to the operation path. See Client failover."},"3204":{"id":"/docs/sdk/connection-strings-176","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#native-sdk-differences","content":"Java accepts only TCP schemes, username/password credentials, tls and tls_ca_file. It rejects PAT connection strings and other options. Go's client.ParseConnectionString returns options for client.WithTcp. Node.js constructors accept a string except SimpleClient, which wraps an existing raw client. C# exposes its connection-string factory described in the C# guide."},"3205":{"id":"/docs/sdk/connection-strings-177","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#native-sdk-differences","content":"Swift accepts the TCP option names, but checks and then ignores pending mutation limits because it has no retained mutation pool. Its reconnect interval is a full pause between endpoint rounds. Node.js accepts reestablish_after for format compatibility without applying a Node equivalent. Do not assume one SDK's parser and timing behavior across all languages."},"3206":{"id":"/docs/sdk/deferred-polling","page_id":"/docs/sdk/deferred-polling","type":"page","content":"Deferred Polling","breadcrumbs":["Documentation","SDK"],"tags":[],"url":"/docs/sdk/deferred-polling"},"3207":{"id":"/docs/sdk/deferred-polling-0","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling","content":"Wait for messages, read several partitions and choose when to store consumer offsets."},"3208":{"id":"/docs/sdk/deferred-polling-1","page_id":"/docs/sdk/deferred-polling","type":"heading","tags":[],"url":"/docs/sdk/deferred-polling#choose-read-limits","content":"Choose read limits"},"3209":{"id":"/docs/sdk/deferred-polling-2","page_id":"/docs/sdk/deferred-polling","type":"heading","tags":[],"url":"/docs/sdk/deferred-polling#read-several-partitions","content":"Read several partitions"},"3210":{"id":"/docs/sdk/deferred-polling-3","page_id":"/docs/sdk/deferred-polling","type":"heading","tags":[],"url":"/docs/sdk/deferred-polling#choose-when-to-commit","content":"Choose when to commit"},"3211":{"id":"/docs/sdk/deferred-polling-4","page_id":"/docs/sdk/deferred-polling","type":"heading","tags":[],"url":"/docs/sdk/deferred-polling#cancellation-and-uncertain-results","content":"Cancellation and uncertain results"},"3212":{"id":"/docs/sdk/deferred-polling-5","page_id":"/docs/sdk/deferred-polling","type":"heading","tags":[],"url":"/docs/sdk/deferred-polling#http-reads","content":"HTTP reads"},"3213":{"id":"/docs/sdk/deferred-polling-6","page_id":"/docs/sdk/deferred-polling","type":"heading","tags":[],"url":"/docs/sdk/deferred-polling#server-capacity","content":"Server capacity"},"3214":{"id":"/docs/sdk/deferred-polling-7","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling","content":"Deferred polling lets the server wait for messages before answering a read. The read returns when enough messages are available or its wait ends. A quiet partition does not need a repeated request loop."},"3215":{"id":"/docs/sdk/deferred-polling-8","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"PollOptions separates read limits from the polling strategy and consumer identity. A strategy selects the starting position, such as a specific offset or the next stored offset."},"3216":{"id":"/docs/sdk/deferred-polling-9","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"Field"},"3217":{"id":"/docs/sdk/deferred-polling-10","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"Default"},"3218":{"id":"/docs/sdk/deferred-polling-11","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"Meaning"},"3219":{"id":"/docs/sdk/deferred-polling-12","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"count"},"3220":{"id":"/docs/sdk/deferred-polling-13","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"1000"},"3221":{"id":"/docs/sdk/deferred-polling-14","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"Maximum messages in one read"},"3222":{"id":"/docs/sdk/deferred-polling-15","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"max_wait"},"3223":{"id":"/docs/sdk/deferred-polling-16","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"Zero"},"3224":{"id":"/docs/sdk/deferred-polling-17","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"Zero returns immediately. A positive duration enables waiting"},"3225":{"id":"/docs/sdk/deferred-polling-18","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"min_count"},"3226":{"id":"/docs/sdk/deferred-polling-19","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"1"},"3227":{"id":"/docs/sdk/deferred-polling-20","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"Messages needed to finish the wait early, from 1 through count"},"3228":{"id":"/docs/sdk/deferred-polling-21","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"max_bytes"},"3229":{"id":"/docs/sdk/deferred-polling-22","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"1 MiB"},"3230":{"id":"/docs/sdk/deferred-polling-23","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"Reply budget, including binary metadata and batch framing"},"3231":{"id":"/docs/sdk/deferred-polling-24","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"commit"},"3232":{"id":"/docs/sdk/deferred-polling-25","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"Manual"},"3233":{"id":"/docs/sdk/deferred-polling-26","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"When to store the returned position"},"3234":{"id":"/docs/sdk/deferred-polling-27","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"These are the shared poll defaults. High-level consumers can select a positive wait by default. The SDK derives a request timeout from the wait plus 10 seconds. The wire protocol permits waits up to 600 seconds, but the server caps them at sharding.deferred_poll_max_wait, 30 seconds by default."},"3235":{"id":"/docs/sdk/deferred-polling-28","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-read-limits","content":"A reply can contain fewer than min_count messages when the wait ends. The first message can exceed max_bytes and return alone, so a large message does not prevent progress. Treat the byte budget as a batching limit, not an absolute allocation guarantee."},"3236":{"id":"/docs/sdk/deferred-polling-29","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#read-several-partitions","content":"A partition reader groups targets by their current primary and uses FetchMessages. Each fetch applies count, min_count and max_bytes across its targets together. The reader can keep several fetches active. It can return a partition with messages without waiting for a quiet partition first."},"3237":{"id":"/docs/sdk/deferred-polling-30","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#read-several-partitions","content":"A group consumer uses its assigned partitions. Assignment changes and primary changes require a refresh before further reads. Use the SDK reader or consumer to manage this state. A raw fetch caller must also supply the route and ownership information required by the protocol."},"3238":{"id":"/docs/sdk/deferred-polling-31","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-when-to-commit","content":"Policy"},"3239":{"id":"/docs/sdk/deferred-polling-32","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-when-to-commit","content":"Behavior"},"3240":{"id":"/docs/sdk/deferred-polling-33","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-when-to-commit","content":"Manual"},"3241":{"id":"/docs/sdk/deferred-polling-34","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-when-to-commit","content":"The application stores checkpoints after successful processing"},"3242":{"id":"/docs/sdk/deferred-polling-35","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-when-to-commit","content":"On read"},"3243":{"id":"/docs/sdk/deferred-polling-36","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-when-to-commit","content":"The server submits the last returned offset as part of the read"},"3244":{"id":"/docs/sdk/deferred-polling-37","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-when-to-commit","content":"Automatic"},"3245":{"id":"/docs/sdk/deferred-polling-38","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-when-to-commit","content":"A reader or consumer tracks progress and stores it by interval or message count"},"3246":{"id":"/docs/sdk/deferred-polling-39","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-when-to-commit","content":"A one-shot poll rejects an automatic policy because it has no continuing processing state. On-read commits can precede application processing. A failover before offset replication can also deliver the last batch again. Use manual commits or automatic commits after processing when messages must be processed before their offsets advance."},"3247":{"id":"/docs/sdk/deferred-polling-40","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#choose-when-to-commit","content":"The Rust automatic policy defaults to every 10,000 messages or five seconds, whichever happens first, after processing. It also stores progress on close, shutdown and partition revocation. Processing counts when the application requests the next item, a handler succeeds, or the reader closes. Marked progress supports applications that finish work concurrently. Do not close a reader as if processing succeeded after a failed handler."},"3248":{"id":"/docs/sdk/deferred-polling-41","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#cancellation-and-uncertain-results","content":"Cancellation removes a parked request when the server receives it. If a committing poll loses its reply, the client cannot assume that its offset stayed unchanged. SDK recovery tracks the uncertain operation and blocks conflicting work until the application resolves or abandons it. Abandoning permits later work but does not undo an offset that already committed."},"3249":{"id":"/docs/sdk/deferred-polling-42","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#http-reads","content":"Use GET /streams/{stream_id}/topics/{topic_id}/messages/deferred for a deferred read without offset commits. A read that sets auto_commit=true must use POST on that path. The server rejects a committing GET."},"3250":{"id":"/docs/sdk/deferred-polling-43","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#http-reads","content":"Raw HTTP defaults differ from PollOptions: count is 10, wait is one second, and request timeout is 11 seconds. Minimum count is one and the byte budget is 1 MiB."},"3251":{"id":"/docs/sdk/deferred-polling-44","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#http-reads","content":"The query uses wait_us, min_count, max_bytes and request_timeout_us alongside the normal consumer, partition, strategy and count fields. A positive wait needs at least one second between the wait and request timeout. Configure a proxy timeout long enough to receive the reply."},"3252":{"id":"/docs/sdk/deferred-polling-45","page_id":"/docs/sdk/deferred-polling","tags":[],"type":"text","url":"/docs/sdk/deferred-polling#server-capacity","content":"The sharding configuration bounds parked requests, per-session requests, disk reads and completion delivery. HTTP requests without a binary session count against their user. Capacity exhaustion can return a retryable error. Keep retries within a bounded application deadline."},"3253":{"id":"/docs/sdk/idempotent-producers","page_id":"/docs/sdk/idempotent-producers","type":"page","content":"Idempotent Producers","breadcrumbs":["Documentation","SDK"],"tags":[],"url":"/docs/sdk/idempotent-producers"},"3254":{"id":"/docs/sdk/idempotent-producers-0","page_id":"/docs/sdk/idempotent-producers","tags":[],"type":"text","url":"/docs/sdk/idempotent-producers","content":"Prevent duplicate appends of a retried producer batch and understand the limits of that guarantee."},"3255":{"id":"/docs/sdk/idempotent-producers-1","page_id":"/docs/sdk/idempotent-producers","type":"heading","tags":[],"url":"/docs/sdk/idempotent-producers#rust-producer","content":"Rust producer"},"3256":{"id":"/docs/sdk/idempotent-producers-2","page_id":"/docs/sdk/idempotent-producers","type":"heading","tags":[],"url":"/docs/sdk/idempotent-producers#kafka-gateway","content":"Kafka gateway"},"3257":{"id":"/docs/sdk/idempotent-producers-3","page_id":"/docs/sdk/idempotent-producers","type":"heading","tags":[],"url":"/docs/sdk/idempotent-producers#retained-producer-history","content":"Retained producer history"},"3258":{"id":"/docs/sdk/idempotent-producers-4","page_id":"/docs/sdk/idempotent-producers","type":"heading","tags":[],"url":"/docs/sdk/idempotent-producers#compatibility-and-recovery","content":"Compatibility and recovery"},"3259":{"id":"/docs/sdk/idempotent-producers-5","page_id":"/docs/sdk/idempotent-producers","tags":[],"type":"text","url":"/docs/sdk/idempotent-producers","content":"An idempotent producer lets a partition recognize a batch it already accepted. Each batch carries a producer ID, epoch and sequence. This identity survives a reconnect under a new client session. It is separate from the ID field of an individual message."},"3260":{"id":"/docs/sdk/idempotent-producers-6","page_id":"/docs/sdk/idempotent-producers","tags":[],"type":"text","url":"/docs/sdk/idempotent-producers#rust-producer","content":"The Rust high-level producer supports opt-in idempotence on binary transports:"},"3261":{"id":"/docs/sdk/idempotent-producers-7","page_id":"/docs/sdk/idempotent-producers","tags":[],"type":"text","url":"/docs/sdk/idempotent-producers#rust-producer","content":"The fragment assumes a connected IggyClient in an async function. Initialization obtains the producer ID. The producer selects each chunk's partition and sends chunks for that partition in sequence. The default producer does not enable this mode."},"3262":{"id":"/docs/sdk/idempotent-producers-8","page_id":"/docs/sdk/idempotent-producers","tags":[],"type":"text","url":"/docs/sdk/idempotent-producers#rust-producer","content":"Do not treat a message ID as a deduplication key. Recreating a producer or submitting the same business event as a new batch is not the same as retrying the original producer batch. Consumers still need application-level handling for repeated work."},"3263":{"id":"/docs/sdk/idempotent-producers-9","page_id":"/docs/sdk/idempotent-producers","tags":[],"type":"text","url":"/docs/sdk/idempotent-producers#kafka-gateway","content":"Set IGGY_KAFKA_IDEMPOTENT_PRODUCERS=true on the Kafka gateway to enable its idempotent producer path. The bridge must also be enabled. The default is false. Without this switch, a Kafka producer can obtain an ID but its retries do not receive the batch deduplication guarantee."},"3264":{"id":"/docs/sdk/idempotent-producers-10","page_id":"/docs/sdk/idempotent-producers","tags":[],"type":"text","url":"/docs/sdk/idempotent-producers#kafka-gateway","content":"The gateway does not support transactions. Idempotent appends do not make application processing and offset commits one atomic operation. See Kafka gateway."},"3265":{"id":"/docs/sdk/idempotent-producers-11","page_id":"/docs/sdk/idempotent-producers","tags":[],"type":"text","url":"/docs/sdk/idempotent-producers#retained-producer-history","content":"Each partition retains the last five batches of each producer and at most 4096 producers. A producer idle for 24 hours can expire. A retry outside this retained history can append a duplicate. These limits also apply to the gateway and source connector paths."},"3266":{"id":"/docs/sdk/idempotent-producers-12","page_id":"/docs/sdk/idempotent-producers","tags":[],"type":"text","url":"/docs/sdk/idempotent-producers#compatibility-and-recovery","content":"Upgrade every reader of the topic to a compatible 0.10 client before writing producer-aware batches. The batch format contains additional producer fields. The older SDKs cannot safely decode it."},"3267":{"id":"/docs/sdk/idempotent-producers-13","page_id":"/docs/sdk/idempotent-producers","tags":[],"type":"text","url":"/docs/sdk/idempotent-producers#compatibility-and-recovery","content":"Session retry protection and producer idempotence solve different problems. A client can retain an uncertain request and resolve it using its original identity. Ending that session can remove receipt access. An idempotent producer adds batch identity at the partition level, but does not turn an uncertain application operation into a confirmed success."},"3268":{"id":"/docs/sdk/introduction","page_id":"/docs/sdk/introduction","type":"page","content":"Introduction","breadcrumbs":["Documentation","SDK"],"tags":[],"url":"/docs/sdk/introduction"},"3269":{"id":"/docs/sdk/introduction-0","page_id":"/docs/sdk/introduction","tags":[],"type":"text","url":"/docs/sdk/introduction","content":"The official Iggy client SDKs, their packages and registries, and the transports each one supports."},"3270":{"id":"/docs/sdk/introduction-1","page_id":"/docs/sdk/introduction","type":"heading","tags":[],"url":"/docs/sdk/introduction#server-compatibility","content":"Server compatibility"},"3271":{"id":"/docs/sdk/introduction-2","page_id":"/docs/sdk/introduction","type":"heading","tags":[],"url":"/docs/sdk/introduction#prerequisites","content":"Prerequisites"},"3272":{"id":"/docs/sdk/introduction-3","page_id":"/docs/sdk/introduction","type":"heading","tags":[],"url":"/docs/sdk/introduction#connection-string","content":"Connection string"},"3273":{"id":"/docs/sdk/introduction-4","page_id":"/docs/sdk/introduction","type":"heading","tags":[],"url":"/docs/sdk/introduction#common-operations","content":"Common operations"},"3274":{"id":"/docs/sdk/introduction-5","page_id":"/docs/sdk/introduction","type":"heading","tags":[],"url":"/docs/sdk/introduction#polling-strategies","content":"Polling strategies"},"3275":{"id":"/docs/sdk/introduction-6","page_id":"/docs/sdk/introduction","type":"heading","tags":[],"url":"/docs/sdk/introduction#partitioning-strategies","content":"Partitioning strategies"},"3276":{"id":"/docs/sdk/introduction-7","page_id":"/docs/sdk/introduction","type":"heading","tags":[],"url":"/docs/sdk/introduction#read-and-recovery-apis","content":"Read and recovery APIs"},"3277":{"id":"/docs/sdk/introduction-8","page_id":"/docs/sdk/introduction","tags":[],"type":"text","url":"/docs/sdk/introduction","content":"Iggy provides official client SDKs in multiple languages. The Rust SDK is the most feature-complete, offering both a high-level API (with auto-batching, consumer groups, offset management, retry logic) and a low-level API for direct protocol operations."},"3278":{"id":"/docs/sdk/introduction-9","page_id":"/docs/sdk/introduction","tags":[],"type":"text","url":"/docs/sdk/introduction","content":"Language"},"3279":{"id":"/docs/sdk/introduction-10","page_id":"/docs/sdk/introduction","tags":[],"type":"text","url":"/docs/sdk/introduction","content":"Package"},"3280":{"id":"/docs/sdk/introduction-11","page_id":"/docs/sdk/introduction","tags":[],"type":"text","url":"/docs/sdk/introduction","content":"Registry"},"3281":{"id":"/docs/sdk/introduction-12","page_id":"/docs/sdk/introduction","tags":[],"type":"text","url":"/docs/sdk/introduction","content":"Transport"},"3282":{"id":"/docs/sdk/introduction-13","page_id":"/docs/sdk/introduction","tags":[],"type":"text","url":"/d