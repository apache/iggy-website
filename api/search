s are selected. Limits range from 1 through 1000. Time bounds are not valid with Latest or Current starts."},"3443":{"id":"/docs/sdk/metadata-changes-18","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#handle-each-response","content":"Status"},"3444":{"id":"/docs/sdk/metadata-changes-19","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#handle-each-response","content":"Action"},"3445":{"id":"/docs/sdk/metadata-changes-20","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#handle-each-response","content":"Ok"},"3446":{"id":"/docs/sdk/metadata-changes-21","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#handle-each-response","content":"Apply records or current items and save the returned position"},"3447":{"id":"/docs/sdk/metadata-changes-22","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#handle-each-response","content":"Behind"},"3448":{"id":"/docs/sdk/metadata-changes-23","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#handle-each-response","content":"Wait and retry without advancing the position"},"3449":{"id":"/docs/sdk/metadata-changes-24","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#handle-each-response","content":"Expired"},"3450":{"id":"/docs/sdk/metadata-changes-25","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#handle-each-response","content":"Rebuild because the requested history is no longer retained"},"3451":{"id":"/docs/sdk/metadata-changes-26","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#handle-each-response","content":"Reset"},"3452":{"id":"/docs/sdk/metadata-changes-27","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#handle-each-response","content":"Rebuild because the cursor belongs to a different history"},"3453":{"id":"/docs/sdk/metadata-changes-28","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#handle-each-response","content":"A rebuild reads Current pages, then follows changes from the returned anchor. Keep the rebuilt state private until a change page reports no more records and reaches at least the last current page's head_op. A sequence of current pages alone does not establish that the mirror caught up."},"3454":{"id":"/docs/sdk/metadata-changes-29","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#handle-each-response","content":"Unknown record kinds retain their codes and raw bodies. Stop without advancing the cursor when the application cannot apply a record. Skipping it can leave a mirror inconsistent. Key material is never exposed in stream records. Their public options contain only the key source and fingerprints."},"3455":{"id":"/docs/sdk/metadata-changes-30","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#sdk-methods","content":"SDK"},"3456":{"id":"/docs/sdk/metadata-changes-31","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#sdk-methods","content":"Method"},"3457":{"id":"/docs/sdk/metadata-changes-32","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#sdk-methods","content":"Rust"},"3458":{"id":"/docs/sdk/metadata-changes-33","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#sdk-methods","content":"get_metadata_changes"},"3459":{"id":"/docs/sdk/metadata-changes-34","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#sdk-methods","content":"Python"},"3460":{"id":"/docs/sdk/metadata-changes-35","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#sdk-methods","content":"get_metadata_changes"},"3461":{"id":"/docs/sdk/metadata-changes-36","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#sdk-methods","content":"Node.js"},"3462":{"id":"/docs/sdk/metadata-changes-37","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#sdk-methods","content":"system.getMetadataChanges"},"3463":{"id":"/docs/sdk/metadata-changes-38","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#sdk-methods","content":"Go"},"3464":{"id":"/docs/sdk/metadata-changes-39","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#sdk-methods","content":"GetMetadataChanges"},"3465":{"id":"/docs/sdk/metadata-changes-40","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#sdk-methods","content":"Java"},"3466":{"id":"/docs/sdk/metadata-changes-41","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#sdk-methods","content":"getMetadataChanges on the system client"},"3467":{"id":"/docs/sdk/metadata-changes-42","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#sdk-methods","content":"C#"},"3468":{"id":"/docs/sdk/metadata-changes-43","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#sdk-methods","content":"GetMetadataChangesAsync"},"3469":{"id":"/docs/sdk/metadata-changes-44","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#sdk-methods","content":"C++"},"3470":{"id":"/docs/sdk/metadata-changes-45","page_id":"/docs/sdk/metadata-changes","tags":[],"type":"text","url":"/docs/sdk/metadata-changes#sdk-methods","content":"GetMetadataChanges"},"3471":{"id":"/do