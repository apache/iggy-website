ng","tags":[],"url":"/docs/binary-protocol/commands#partition-routes","content":"Partition routes"},"322":{"id":"/docs/binary-protocol/commands-16","page_id":"/docs/binary-protocol/commands","type":"heading","tags":[],"url":"/docs/binary-protocol/commands#deferred-polls","content":"Deferred polls"},"323":{"id":"/docs/binary-protocol/commands-17","page_id":"/docs/binary-protocol/commands","type":"heading","tags":[],"url":"/docs/binary-protocol/commands#grouped-fetches","content":"Grouped fetches"},"324":{"id":"/docs/binary-protocol/commands-18","page_id":"/docs/binary-protocol/commands","type":"heading","tags":[],"url":"/docs/binary-protocol/commands#metadata-changes","content":"Metadata changes"},"325":{"id":"/docs/binary-protocol/commands-19","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#catalog","content":"The u32 command codes. Replicated commands are identified on the wire by their `operation` byte (see Operation discriminants). The code column below is the protocol-level registry and, for non-replicated commands, the value carried in header bytes 196..200."},"326":{"id":"/docs/binary-protocol/commands-20","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#catalog","content":"Codes 14, 35, 102, 103, 104, 107, 123, 124, 204, 205, 304 and 305 are retired. They are not alternate names for current commands. Use UpdateResource for resource patches and topic durability for persistence requirements."},"327":{"id":"/docs/binary-protocol/commands-21","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#payloads","content":"Payloads below are the request **body** (the bytes after the 256-byte header). Types reference the shared encodings. Empty payload means the body has zero bytes."},"328":{"id":"/docs/binary-protocol/commands-22","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"**Ping. Code: 1.** Empty payload. The only command accepted before login."},"329":{"id":"/docs/binary-protocol/commands-23","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"**Get stats. Code: 10.** Empty payload."},"330":{"id":"/docs/binary-protocol/commands-24","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"**Get snapshot. Code: 11.**"},"331":{"id":"/docs/binary-protocol/commands-25","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"Compression codes: 1 = Stored, 2 = Deflated, 3 = Bzip2, 4 = Zstd, 5 = Lzma, 6 = Xz. Snapshot type codes: 1 = FilesystemOverview, 2 = ProcessList, 3 = ResourceUsage, 4 = Test, 5 = ServerLogs, 6 = ServerConfig, 100 = All."},"332":{"id":"/docs/binary-protocol/commands-26","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"**Get cluster metadata. Code: 12.** Empty payload."},"333":{"id":"/docs/binary-protocol/commands-27","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"**Describe options. Code: 13.**"},"334":{"id":"/docs/binary-protocol/commands-28","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"Scope: 1 = topic, 2 = stream, 3 = user. Returns the option catalog for the scope: keys, value kinds, defaults, and descriptions. See Options block."},"335":{"id":"/docs/binary-protocol/commands-29","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"**Get me. Code: 20.** Empty payload."},"336":{"id":"/docs/binary-protocol/commands-30","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"**Get client. Code: 21.**"},"337":{"id":"/docs/binary-protocol/commands-31","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"**Get clients. Code: 22.** Empty payload."},"338":{"id":"/docs/binary-protocol/commands-32","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#streams","content":"**Get stream. Code: 200.**"},"339":{"id":"/docs/binary-protocol/commands-33","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#streams","content":"**Get streams. Code: 201.** Empty payload."},"340":{"id":"/docs/binary-protocol/commands-34","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#streams","content":"**Create stream. Code: 202.**"},"341":{"id":"/docs/binary-protocol/commands-35","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#streams","content":"The stream catalog accepts a create-only, write-only `encryption_key`. An omitted key uses the server creation default. See Stream options."},"342":{"id":"/docs/binary-protocol/commands-36","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#streams","content":"**Delete stream. Code: 203.**"},"343":{"id":"/docs/binary-protocol/commands-37","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#topics","content":"**Get topic. Code: 300.**"},"344":{"id":"/docs/binary-protocol/commands-38","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#topics","content":"**Get topics. Code: 301.**"},"345":{"id":"/docs/binary-protocol/commands-39","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#topics","content":"**Create topic. Code: 302.**"},"346":{"id":"/docs/binary-protocol/commands-40","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#topics","content":"The fixed fields are the shape of the operation: which stream, how many partitions, what name. Every topic setting (`compression_algorithm`, `message_expiry`, `max_topic_size`, `segment_size`, `durability`, `consumer_offset_durability`, `messages_required_to_save`, `size_of_messages_required_to_save`, `preallocate_segments`, `partition_resize_policy`, `replication_factor`) rides the options block. See Topic options. `partitions_count` is an argument, not a setting: it is consumed at admission and never persisted as an option."},"347":{"id":"/docs/binary-protocol/commands-41","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#topics","content":"**Delete topic. Code: 303.**"},"348":{"id":"/docs/binary-protocol/commands-42","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#partitions","content":"**Create partitions. Code: 402.**"},"349":{"id":"/docs/binary-protocol/commands-43","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#partitions","content":"**Delete partitions. Code: 403.**"},"350":{"id":"/docs/binary-protocol/commands-44","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#segments","content":"**Delete segments. Code: 503.**"},"351":{"id":"/docs/binary-protocol/commands-45","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#segments","content":"Deletes up to `segments_count` oldest sealed segments of the partition. The active segment is retained."},"352":{"id":"/docs/binary-protocol/commands-46","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#messages","content":"**Poll messages. Code: 100.**"},"353":{"id":"/docs/binary-protocol/commands-47","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#messages","content":"`strategy` is a polling strategy. `count` is the requested number of messages. `auto_commit = 1` asks the server to advance the consumer offset. A primary submits a quorum offset write before replying, but the poll does not wait for that write to commit. Partition reads route to their current primary. See Client failover."},"354":{"id":"/docs/binary-protocol/commands-48","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#messages","content":"The response body:"},"355":{"id":"/docs/binary-protocol/commands-49","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#messages","content":"The 40-byte prefix is followed by a stream of batch records: each record's header carries the stamped `base_offset` and `base_timestamp`, and each frame's deltas resolve against them. A record may be a server-sliced view of a larger stored batch, so the first polled offset is `base_offset + offset_delta` of the first frame, not necessarily `base_offset` itself. `current_offset` is the partition's newest offset at poll time. The server rebuilds records when decrypting encrypted payloads."},"356":{"id":"/docs/binary-protocol/commands-50","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#messages","content":"**Send messages. Code: 101.**"},"357":{"id":"/docs/binary-protocol/commands-51","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#messages","content":"`metadata_length` counts the bytes from `stream_id` through `messages_count` inclusive, so a reader can skip straight to the batch. The producer leaves `partition_id`, `base_offset`, and `base_timestamp` zero in the batch header, and the server stamps them. Every checksum is producer-computed and verified at admission. The reserved regions must be zero."},"358":{"id":"/docs/binary-protocol/commands-52","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#messages","content":"A committed append returns offset confirmations without a metadata result section:"},"359":{"id":"/docs/binary-protocol/commands-53","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#messages","content":"Each confirmation is 20 bytes. The server reports one partition per append. A zero count or an empty successful body supplies no offset information. A retry can return the retained result rather than append again. Retry coverage is bounded, and crash durability depends on the topic's durability policy."},"360":{"id":"/docs/binary-protocol/commands-54","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"**Get consumer offset. Code: 120.**"},"361":{"id":"/docs/binary-protocol/commands-55","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"When an offset is stored, the response body is 20 bytes. When none is stored, a successful reply has an empty body."},"362":{"id":"/docs/binary-protocol/commands-56","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"**Store consumer offset. Code: 121.**"},"363":{"id":"/docs/binary-protocol/commands-57","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"**Delete consumer offset. Code: 122.**"},"364":{"id":"/docs/binary-protocol/commands-58","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"The trailing `ack` byte is mandatory on both write commands. A payload without it fails to decode. Ack levels:"},"365":{"id":"/docs/binary-protocol/commands-59","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"| Value | Level   | Meaning                                                                                                  |\n| ----- | ------- | -------------------------------------------------------------------------------------------------------- |\n| 0     | `NoAck` | Local write on a single-replica partition. Replicated partitions use the same consensus path as `Quorum` |","table":"table-0"},"366":{"id":"/docs/binary-protocol/commands-60","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"| Value | Level    | Meaning                                                                                            |\n| ----- | -------- | -------------------------------------------------------------------------------------------------- |\n| 1     | `Quorum` | Replicate through partition consensus. Respond after a quorum commit (default for explicit writes) |","table":"table-0"},"367":{"id":"/docs/binary-protocol/commands-61","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-groups","content":"**Get consumer group. Code: 600.**"},"368":{"id":"/docs/binary-protocol/commands-62","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-groups","content":"**Get consumer groups. Code: 601.**"},"369":{"id":"/docs/binary-protocol/commands-63","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-groups","content":"**Create consumer group. Code: 602.**"},"370":{"id":"/docs/binary-protocol/commands-64","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-groups","content":"**Delete consumer group. Code: 603.**"},"371":{"id":"/docs/binary-protocol/commands-65","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-groups","content":"**Join consumer group. Code: 604.**"},"372":{"id":"/docs/binary-protocol/commands-66","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-groups","content":"**Leave consumer group. Code: 605.**"},"373":{"id":"/docs/binary-protocol/commands-67","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-groups","content":"**Sync consumer group. Code: 606.**"},"374":{"id":"/docs/binary-protocol/commands-68","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-groups","content":"Read-only: a member asks for its current partition assignment and the group generation, so it can select partitions to poll client-side."},"375":{"id":"/docs/binary-protocol/commands-69","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#users","content":"**Get user. Code: 31.**"},"376":{"id":"/docs/binary-protocol/commands-70","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#users","content":"**Get users. Code: 32.** Empty payload."},"377":{"id":"/docs/binary-protocol/commands-71","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#users","content":"**Create user. Code: 33.**"},"378":{"id":"/docs/binary-protocol/commands-72","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#users","content":"`permissions_len` and the permissions bytes are present **only** when `has_permissions = 1`. When it is 0 the options block follows immediately. The user catalog includes `username` and `status` for updates. Creation carries those values in its fixed fields. `status`: 1 = active, 2 = inactive."},"379":{"id":"/docs/binary-protocol/commands-73","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#users","content":"**Delete user. Code: 34.**"},"380":{"id":"/docs/binary-protocol/commands-74","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#users","content":"**Update permissions. Code: 36.**"},"381":{"id":"/docs/binary-protocol/commands-75","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#users","content":"As in `CreateUser`, the length field is conditional: with `has_permissions = 0` the payload ends at the flag."},"382":{"id":"/docs/binary-protocol/commands-76","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#users","content":"**Change password. Code: 37.**"},"383":{"id":"/docs/binary-protocol/commands-77","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#authentication","content":"Login and logout are part of the connection lifecycle:"},"384":{"id":"/docs/binary-protocol/commands-78","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#authentication","content":"**Login register. Code: 40.** `Operation::Register`. The body is `ClientVersionInfo` + credentials, described in Login-register."},"385":{"id":"/docs/binary-protocol/commands-79","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#authentication","content":"**Login register with PAT. Code: 45.** `Operation::Register`. The body is `ClientVersionInfo` + token."},"386":{"id":"/docs/binary-protocol/commands-80","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#authentication","content":"**Logout user. Code: 39.** `Operation::Logout`. Empty payload."},"387":{"id":"/docs/binary-protocol/commands-81","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#authentication","content":"Codes **38** and **44** are the pre-register login shapes. The server rejects both with a `MalformedLogin` eviction."},"388":{"id":"/docs/binary-protocol/commands-82","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#personal-access-tokens","content":"**Get personal access tokens. Code: 41.** Empty payload."},"389":{"id":"/docs/binary-protocol/commands-83","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#personal-access-tokens","content":"**Create personal access token. Code: 42.**"},"390":{"id":"/docs/binary-protocol/commands-84","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#personal-access-tokens","content":"`expiry` is a duration in **microseconds**. Two sentinel values exist: `0` (server default, which currently means no expiry) and `u64::MAX` (never expires)."},"391":{"id":"/docs/binary-protocol/commands-85","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#personal-access-tokens","content":"**Delete personal access token. Code: 43.**"},"392":{"id":"/docs/binary-protocol/commands-86","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#resource-patches","content":"UpdateResource is code 16, operation 150:"},"393":{"id":"/docs/binary-protocol/commands-87","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#resource-patches","content":"Scope 1 selects a topic with stream and topic identifiers. Scope 2 selects a stream. Scope 3 selects a user. Empty patches, duplicate keys and keys that are both set and reset are rejected. The catalog defines update and reset permissions for each key."},"394":{"id":"/docs/binary-protocol/commands-88","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#partition-routes","content":"GetPartitionRoute is code 105. Its request contains stream and topic identifiers followed by a u32 partition ID. The response is exactly 25 bytes:"},"395":{"id":"/docs/binary-protocol/commands-89","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#partition-routes","content":"The primary value is a configured replica ID, not a roster position. Retain the incarnation and metadata operation when constructing a request. Group ownership adds its own generation."},"396":{"id":"/docs/binary-protocol/commands-90","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#deferred-polls","content":"PollMessagesDeferred is code 106. It extends the PollMessages body:"},"397":{"id":"/docs/binary-protocol/commands-91","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#deferred-polls","content":"The response uses the same 40-byte prefix as PollMessages. Waiting requests need a positive count, `min_count` from 1 through count and a byte budget of at least 344. A positive wait requires at least one second of reply margin. Waits cannot exceed 600 seconds, and request timeouts cannot exceed 630 seconds. The server can shorten waits through its configuration."},"398":{"id":"/docs/binary-protocol/commands-92","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#deferred-polls","content":"CancelDeferredRequest is code 108. It has an empty body and identifies the original request through the header request number on the same authenticated connection. The cancel command has no success reply. A committing deferred read still has one terminal reply that tells the caller whether the cancel won or an offset was stored."},"399":{"id":"/docs/binary-protocol/commands-93","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#grouped-fetches","content":"FetchMessages is code 109:"},"400":{"id":"/docs/binary-protocol/commands-94","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#grouped-fetches","content":"Targets have unique partition IDs and use offset or next strategies. The request applies its count, minimum count and byte limit across all targets. Each target also has a byte limit no greater than the request limit. A fetch requires the one-second reply margin even when its wait is zero."},"401":{"id":"/docs/binary-protocol/commands-95","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#grouped-fetches","content":"The response starts with a u32 section count, followed by a table of 56-byte section headers:"},"402":{"id":"/docs/binary-protocol/commands-96","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#grouped-fetches","content":"All section headers precede the records. Records follow in table order. A failed section has no records. Inspect every section status before accepting progress. See Deferred polling for SDK use."},"403":{"id":"/docs/binary-protocol/commands-97","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#metadata-changes","content":"GetMetadataChanges is code 17. It supports Earliest, Latest, After and Current starts, group selection, bounded result counts and optional time bounds. The request codec defines its flags and position encodings. See Metadata changes for the follow and rebuild contract."},"404":{"id":"/docs/binary-protocol/connection-lifecycle","page_id":"/docs/binary-protocol/connection-lifecycle","type":"page","content":"Connection lifecycle","breadcrumbs":["Documentation","Binary Protocol"],"tags":[],"url":"/docs/binary-protocol/connection-lifecycle"},"405":{"id":"/docs/binary-protocol/connection-lifecycle-0","page_id":"/docs/binary-protocol/connection-lifecycle","tags":[],"type":"text","url":"/docs/binary-protocol/connection-lifecycle","content":"How the protocol version is packed and checked, and the login-register handshake that authenticates a connection."},"406":{"id":"/docs/binary-protocol/connection-lifecycle-1","page_id":"/docs/binary-protocol/connection-lifecycle","type":"heading","tags":[],"url":"/docs/binary-protocol/connection-lifecycle#protocol-version","content":"Protocol version"},"407":{"id":"/docs/binary-protocol/connection-lifecycle-2","page_id":"/docs/binary-protocol/connection-lifecycle","type":"heading","tags":[],"url":"/docs/binary-protocol/connection-lifecycle#login-register","content":"Login-register"},"408":{"id":"/docs/binary-protocol/connection-lifecycle-3","page_id":"/docs/binary-protocol/connection-lifecycle","type":"heading","tags":[],"url":"/docs/binary-protocol/connection-lifecycle#bind-a-retained-session","content":"Bind a retained session"},"409":{"id":"/docs/binary-protocol/connection-lifecycle-4","page_id":"/docs/binary-protocol/connection-lifecycle","tags":[],"type":"text","url":"/docs/binary-protocol/connection-lifecycle","content":"Server 0.10.0 uses binary protocol 0.12.0. Clients must use a compatible release."},"410":{"id":"/docs/binary-protocol/connection-lifecycle-5","page_id":"/docs/binary-protocol/connection-lifecycle","tags":[],"type":"text","url":"/docs/binary-protocol/connection-lifecycle#protocol-version","content":"The protocol version is a semver packed into one u32, 10 bits per component (each must be below 1024):"},"411":{"id":"/docs/binary-protocol/connection-lifecycle-6","page_id":"/docs/binary-protocol/connection-lifecycle","tags":[],"type":"text","url":"/docs/binary-protocol/connection-lifecycle#protocol-version","content":"Integer order equals semver order. The value tracks the `iggy_binary_protocol` crate release. Under 0.x the compatibility gate is minor-scoped: the server accepts a client whose packed version is at least the server's minimum and whose `major.minor` is at most the server's. Patch releases never change the wire, so the upper bound ignores patch. The implemented minimum is the current version with its patch component zeroed. Compatibility across minor versions after 1.0.0 requires a future change to that calculation."},"412":{"id":"/docs/binary-protocol/connection-lifecycle-7","page_id":"/docs/binary-protocol/connection-lifecycle","tags":[],"type":"text","url":"/docs/binary-protocol/connection-lifecycle#login-register","content":"A new logical session authenticates through the register handshake: command code **40** (`LOGIN_REGISTER`, username and password) or **45** (`LOGIN_REGISTER_WITH_PAT`, personal access token). Both ride `operation = 1` (`Register`) with `session = 0`, `request = 0`, and a non-zero `client` id. Mint a fresh id for a new logical client. A reconnect retains its request identities and binds the existing session. A matching registration retry preserves its epoch."},"413":{"id":"/docs/binary-protocol/connection-lifecycle-8","page_id":"/docs/binary-protocol/connection-lifecycle","tags":[],"type":"text","url":"/docs/binary-protocol/connection-lifecycle#login-register","content":"Both request bodies begin with the `ClientVersionInfo` prefix, so the server can gate on the version before touching credentials:"},"414":{"id":"/docs/binary-protocol/connection-lifecycle-9","page_id":"/docs/binary-protocol/connection-lifecycle","tags":[],"type":"text","url":"/docs/binary-protocol/connection-lifecycle#login-register","content":"`protocol_version` is the packed version of the protocol the client was built against. `sdk_name` identifies the SDK (for example `rust-sdk`, `go-sdk`). `sdk_version` is the SDK's own build version."},"415":{"id":"/docs/binary-protocol/connection-lifecycle-10","page_id":"/docs/binary-protocol/connection-lifecycle","tags":[],"type":"text","url":"/docs/binary-protocol/connection-lifecycle#login-register","content":"After the prefix:"},"416":{"id":"/docs/binary-protocol/connection-lifecycle-11","page_id":"/docs/binary-protocol/connection-lifecycle","tags":[],"type":"text","url":"/docs/binary-protocol/connection-lifecycle#login-register","content":"**`LOGIN_REGISTER` (code 40):**"},"417":{"id":"/docs/binary-protocol/connection-lifecycle-12","page_id":"/docs/binary-protocol/connection-lifecycle","tags":[],"type":"text","url":"/docs/binary-protocol/connection-lifecycle#login-register","content":"**`LOGIN_REGISTER_WITH_PAT` (code 45):**"},"418":{"id":"/docs/binary-protocol/connection-lifecycle-13","page_id":"/docs/binary-protocol/connection-lifecycle","tags":[],"type":"text","url":"/docs/binary-protocol/connection-lifecycle#login-register","content":"An incompatible protocol version is answered with a 256-byte `Eviction` frame, reason `14` (`IncompatibleProtocol`), carrying the accepted window at bytes 144 (max) and 148 (min) as packed u32 versions. A body without a decodable `ClientVersionInfo` prefix gets reason `15` (`MalformedLogin`) with a zero window. Bad credentials get reasons 9-11. See EvictionHeader for the frame layout."},"419":{"id":"/docs/binary-protocol/connection-lifecycle-14","page_id":"/docs/binary-protocol/connection-lifecycle","tags":[],"type":"text","url":"/docs/binary-protocol/connection-lifecycle#login-register","content":"A successful login is a normal `Reply` with `status = 0`. Its body includes an empty result section before the login payload:"},"420":{"id":"/docs/binary-protocol/connection-lifecycle-15","page_id":"/docs/binary-protocol/connection-lifecycle","tags":[],"type":"text","url":"/docs/binary-protocol/connection-lifecycle#login-register","content":"The client stores `session` and echoes it in every subsequent request header. Logout is command code **39** (`LOGOUT_USER`), `operation = 3` (`Logout`), empty body."},"421":{"id":"/docs/binary-protocol/connection-lifecycle-16","page_id":"/docs/binary-protocol/connection-lifecycle","tags":[],"type":"text","url":"/docs/binary-protocol/connection-lifecycle#login-register","content":"The legacy login commands **38** (`LOGIN_USER`) and **44** (`LOGIN_WITH_PERSONAL_ACCESS_TOKEN`) are refused: the server answers them with an `Eviction` frame, reason `15` (`MalformedLogin`). Before authentication, a connection can ping or use the registration and binding flows. Protected commands require an authenticated session."},"422":{"id":"/docs/binary-protocol/connection-lifecycle-17","page_id":"/docs/binary-protocol/connection-lifecycle","tags":[],"type":"text","url":"/docs/binary-protocol/connection-lifecycle#bind-a-retained-session","content":"BindSession, code 15, authenticates another connection for the same logical session without another Register:"},"423":{"id":"/docs/binary-protocol/connection-lifecycle-18","page_id":"/docs/binary-protocol/connection-lifecycle","tags":[],"type":"text","url":"/docs/binary-protocol/connection-lifecycle#bind-a-retained-session","content":"The client creates and protects the random binding secret for its session. The server stores a verifier. Session zero can resolve a lost registration reply using this retained secret. Binding supports connections to different partition primaries while preserving one session identity."},"424":{"id":"/docs/binary-protocol/connection-lifecycle-19","page_id":"/docs/binary-protocol/connection-lifecycle","tags":[],"type":"text","url":"/docs/binary-protocol/connection-lifecycle#bind-a-retained-session","content":"Transport loss alone does not end a retained session. Logout, session expiry and account deactivation do. A password or PAT change does not revoke an already established session. Once the original session ends, unresolved operations cannot recover their old receipts through a new login."},"425":{"id":"/docs/binary-protocol/encodings","page_id":"/docs/binary-protocol/encodings","type":"page","content":"Shared encodings","breadcrumbs":["Documentation","Binary Protocol"],"tags":[],"url":"/docs/binary-protocol/encodings"},"426":{"id":"/docs/binary-protocol/encodings-0","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings","content":"The primitives command payloads are built from: names, identifiers, consumers and the other shared encodings."},"427":{"id":"/docs/binary-protocol/encodings-1","page_id":"/docs/binary-protocol/encodings","type":"heading","tags":[],"url":"/docs/binary-protocol/encodings#name","content":"Name"},"428":{"id":"/docs/binary-protocol/encodings-2","page_id":"/docs/binary-protocol/encodings","type":"heading","tags":[],"url":"/docs/binary-protocol/encodings#identifier","content":"Identifier"},"429":{"id":"/docs/binary-protocol/encodings-3","page_id":"/docs/binary-protocol/encodings","type":"heading","tags":[],"url":"/docs/binary-protocol/encodings#consumer","content":"Consumer"},"430":{"id":"/docs/binary-protocol/encodings-4","page_id":"/docs/binary-protocol/encodings","type":"heading","tags":[],"url":"/docs/binary-protocol/encodings#optional-partition-id","content":"Optional partition id"},"431":{"id":"/docs/binary-protocol/encodings-5","page_id":"/docs/binary-protocol/encodings","type":"heading","tags":[],"url":"/docs/binary-protocol/encodings#partitioning","content":"Partitioning"},"432":{"id":"/docs/binary-protocol/encodings-6","page_id":"/docs/binary-protocol/encodings","type":"heading","tags":[],"url":"/docs/binary-protocol/encodings#polling-strategy","content":"Polling strategy"},"433":{"id":"/docs/binary-protocol/encodings-7","page_id":"/docs/binary-protocol/encodings","type":"heading","tags":[],"url":"/docs/binary-protocol/encodings#header-kinds","content":"Header kinds"},"434":{"id":"/docs/binary-protocol/encodings-8","page_id":"/docs/binary-protocol/encodings","type":"heading","tags":[],"url":"/docs/binary-protocol/encodings#user-headers-block","content":"User headers block"},"435":{"id":"/docs/binary-protocol/encodings-9","page_id":"/docs/binary-protocol/encodings","type":"heading","tags":[],"url":"/docs/binary-protocol/encodings#options-block","content":"Options block"},"436":{"id":"/docs/binary-protocol/encodings-10","page_id":"/docs/binary-protocol/encodings","type":"heading","tags":[],"url":"/docs/binary-protocol/encodings#compression","content":"Compression"},"437":{"id":"/docs/binary-protocol/encodings-11","page_id":"/docs/binary-protocol/encodings","type":"heading","tags":[],"url":"/docs/binary-protocol/encodings#partition-context","content":"Partition context"},"438":{"id":"/docs/binary-protocol/encodings-12","page_id":"/docs/binary-protocol/encodings","type":"heading","tags":[],"url":"/docs/binary-protocol/encodings#option-catalog-flags","content":"Option catalog flags"},"439":{"id":"/docs/binary-protocol/encodings-13","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings","content":"Primitives the command payloads are built from."},"440":{"id":"/docs/binary-protocol/encodings-14","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#name","content":"Length-prefixed UTF-8 string, used for stream, topic, group, user, and token names:"},"441":{"id":"/docs/binary-protocol/encodings-15","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#identifier","content":"Polymorphic identifier of a stream, topic, user, or consumer group:"},"442":{"id":"/docs/binary-protocol/encodings-16","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#identifier","content":"Numeric: `kind = 1`, `length = 4`, value is a u32."},"443":{"id":"/docs/binary-protocol/encodings-17","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#identifier","content":"String: `kind = 2`, `length = 1..255`, value is UTF-8 bytes."},"444":{"id":"/docs/binary-protocol/encodings-18","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#consumer","content":"Identifies a consumer or a consumer group in message and offset commands:"},"445":{"id":"/docs/binary-protocol/encodings-19","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#consumer","content":"`kind = 1`: consumer."},"446":{"id":"/docs/binary-protocol/encodings-20","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#consumer","content":"`kind = 2`: consumer group."},"447":{"id":"/docs/binary-protocol/encodings-21","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#consumer","content":"`kind = 3`: externally managed group offsets. This kind cannot poll or join native consumer groups."},"448":{"id":"/docs/binary-protocol/encodings-22","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#optional-partition-id","content":"Several commands take an optional partition id encoded as 5 fixed bytes:"},"449":{"id":"/docs/binary-protocol/encodings-23","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#optional-partition-id","content":"`flag = 1` means the id is set. `flag = 0` means none (the value bytes are then zero). Group polls and group offset writes require an explicit assigned partition. Plain-consumer polls and consumer-offset reads use partition 0 when the id is omitted."},"450":{"id":"/docs/binary-protocol/encodings-24","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#partitioning","content":"How `SendMessages` picks the target partition:"},"451":{"id":"/docs/binary-protocol/encodings-25","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#partitioning","content":"`Balanced`: `kind = 1`, `length = 0`, no value. The binary client resolves it to an explicit partition before sending."},"452":{"id":"/docs/binary-protocol/encodings-26","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#partitioning","content":"`PartitionId`: `kind = 2`, `length = 4`, value is a u32 partition id."},"453":{"id":"/docs/binary-protocol/encodings-27","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#partitioning","content":"`MessagesKey`: `kind = 3`, `length = 1..255`, value is a routing key hashed to a partition."},"454":{"id":"/docs/binary-protocol/encodings-28","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#partitioning","content":"The Rust binary SDK resolves balanced and key routing client-side and sends `kind = 2`. The binary server requires explicit partition routing. The HTTP API can resolve the other strategies."},"455":{"id":"/docs/binary-protocol/encodings-29","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#polling-strategy","content":"Fixed 9 bytes:"},"456":{"id":"/docs/binary-protocol/encodings-30","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#polling-strategy","content":"| Kind | Name   | Meaning of `value`   |\n| ---- | ------ | -------------------- |\n| 1    | Offset | Start at this offset |","table":"table-0"},"457":{"id":"/docs/binary-protocol/encodings-31","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#polling-strategy","content":"| Kind | Name      | Meaning of `value`                     |\n| ---- | --------- | -------------------------------------- |\n| 2    | Timestamp | Start at this timestamp (microseconds) |","table":"table-0"},"458":{"id":"/docs/binary-protocol/encodings-32","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#polling-strategy","content":"| Kind | Name  | Meaning of `value`                         |\n| ---- | ----- | ------------------------------------------ |\n| 3    | First | Start from the beginning (`value` ignored) |","table":"table-0"},"459":{"id":"/docs/binary-protocol/encodings-33","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#polling-strategy","content":"| Kind | Name | Meaning of `value`                   |\n| ---- | ---- | ------------------------------------ |\n| 4    | Last | Start from the end (`value` ignored) |","table":"table-0"},"460":{"id":"/docs/binary-protocol/encodings-34","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#polling-strategy","content":"| Kind | Name | Meaning of `value`                                          |\n| ---- | ---- | ----------------------------------------------------------- |\n| 5    | Next | Continue after the stored consumer offset (`value` ignored) |","table":"table-0"},"461":{"id":"/docs/binary-protocol/encodings-35","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"Typed values used by user headers and option values. The kind byte:"},"462":{"id":"/docs/binary-protocol/encodings-36","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"| Code | Kind | Code | Kind  |\n| ---- | ---- | ---- | ----- |\n| 1    | Raw  | 9    | Uint8 |","table":"table-1"},"463":{"id":"/docs/binary-protocol/encodings-37","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"| Code | Kind   | Code | Kind   |\n| ---- | ------ | ---- | ------ |\n| 2    | String | 10   | Uint16 |","table":"table-1"},"464":{"id":"/docs/binary-protocol/encodings-38","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"| Code | Kind | Code | Kind   |\n| ---- | ---- | ---- | ------ |\n| 3    | Bool | 11   | Uint32 |","table":"table-1"},"465":{"id":"/docs/binary-protocol/encodings-39","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"| Code | Kind | Code | Kind   |\n| ---- | ---- | ---- | ------ |\n| 4    | Int8 | 12   | Uint64 |","table":"table-1"},"466":{"id":"/docs/binary-protocol/encodings-40","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"| Code | Kind  | Code | Kind    |\n| ---- | ----- | ---- | ------- |\n| 5    | Int16 | 13   | Uint128 |","table":"table-1"},"467":{"id":"/docs/binary-protocol/encodings-41","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"| Code | Kind  | Code | Kind    |\n| ---- | ----- | ---- | ------- |\n| 6    | Int32 | 14   | Float32 |","table":"table-1"},"468":{"id":"/docs/binary-protocol/encodings-42","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"| Code | Kind  | Code | Kind    |\n| ---- | ----- | ---- | ------- |\n| 7    | Int64 | 15   | Float64 |","table":"table-1"},"469":{"id":"/docs/binary-protocol/encodings-43","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"| Code | Kind   | Code | Kind |\n| ---- | ------ | ---- | ---- |\n| 8    | Int128 |      |      |","table":"table-1"},"470":{"id":"/docs/binary-protocol/encodings-44","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"Integers are little-endian. `Bool` is one byte."},"471":{"id":"/docs/binary-protocol/encodings-45","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#user-headers-block","content":"A user headers block (inside a message frame) is a flat run of TLV fields:"},"472":{"id":"/docs/binary-protocol/encodings-46","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#user-headers-block","content":"Fields pair up: first the key, then the value. Keys and values can both use the header kinds above. Every `length` must be 1..=255, kind 0 is rejected, and the block must consume its byte range exactly. The wire validator preserves unknown non-zero kind codes. A typed SDK accessor may still reject a kind it does not recognize."},"473":{"id":"/docs/binary-protocol/encodings-47","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"`CreateStream`, `CreateTopic`, `CreateUser` and `UpdateResource` end with a key-value **options block** that reuses the user-headers TLV encoding. The block runs from its start to the end of the payload (no length prefix, and the validator requires exact consumption) and may be empty."},"474":{"id":"/docs/binary-protocol/encodings-48","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"On top of the TLV walk, options enforce: string keys only (kind 2, valid UTF-8), no duplicate keys, at most 1024 entries, and at most 100000 bytes total."},"475":{"id":"/docs/binary-protocol/encodings-49","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"Semantics:"},"476":{"id":"/docs/binary-protocol/encodings-50","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"**Create** requests resolve absent keys to server defaults and persist the effective values. Updates use explicit reset keys to restore defaults. Zero retention sentinels do not reset a value. See update semantics."},"477":{"id":"/docs/binary-protocol/encodings-51","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"**Update** requests are patches: keys absent from the block are left alone, never reset. A client built before a key existed cannot erase it."},"478":{"id":"/docs/binary-protocol/encodings-52","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"Unknown keys are rejected at the wire edge, never silently skipped."},"479":{"id":"/docs/binary-protocol/encodings-53","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"The catalog is discoverable with DescribeOptions, code 13, using scope 1 for topics, 2 for streams and 3 for users. All three catalogs have entries. Stream keys are create-only and secret. Stream and topic names and user identity/status can be updated. Topic retention fields can be reset, while compression and storage policies are fixed at creation. See Topic options and Stream options."},"480":{"id":"/docs/binary-protocol/encodings-54","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"The `compression_algorithm` value used by topic options:"},"481":{"id":"/docs/binary-protocol/encodings-55","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"| Code / name | Algorithm                |\n| ----------- | ------------------------ |\n| 1, `none`   | No compression (default) |","table":"table-2"},"482":{"id":"/docs/binary-protocol/encodings-56","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"| Code / name | Algorithm |\n| ----------- | --------- |\n| 2, `gzip`   | Gzip      |","table":"table-2"},"483":{"id":"/docs/binary-protocol/encodings-57","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"Any other value is rejected. The option is a **placeholder today**: the value is validated, persisted, and echoed back, but it does not enable automatic payload compression or decompression. To compress today, do it client-side and tag messages via user headers - see the message headers examples in the Iggy repo."},"484":{"id":"/docs/binary-protocol/encodings-58","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#partition-context","content":"A served partition context is 24 bytes:"},"485":{"id":"/docs/binary-protocol/encodings-59","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#partition-context","content":"The incarnation identifies the partition history. The owner generation identifies group ownership and is zero for ordinary consumers. The metadata operation establishes the minimum metadata needed to interpret the context. Poll replies, continuations and checkpoints preserve these fields."},"486":{"id":"/docs/binary-protocol/encodings-60","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#option-catalog-flags","content":"DescribeOptions entries report mutability and visibility. Bit 0 means updatable, bit 1 resettable, bit 2 secret, bit 3 read-only and bit 4 critical. A critical key must be understood before a node serves the resource. Unknown client option keys are rejected."},"487":{"id":"/docs/binary-protocol/framing","page_id":"/docs/binary-protocol/framing","type":"page","content":"Framing","breadcrumbs":["Documentation","Binary Protocol"],"tags":[],"url":"/docs/binary-protocol/framing"},"488":{"id":"/docs/binary-protocol/framing-0","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"The fixed 256-byte header every binary-transport message rides in, and the request, reply and eviction shapes it carries."},"489":{"id":"/docs/binary-protocol/framing-1","page_id":"/docs/binary-protocol/framing","type":"heading","tags":[],"url":"/docs/binary-protocol/framing#requestheader","content":"RequestHeader"},"490":{"id":"/docs/binary-protocol/framing-2","page_id":"/docs/binary-protocol/framing","type":"heading","tags":[],"url":"/docs/binary-protocol/framing#operation-discriminants","content":"Operation discriminants"},"491":{"id":"/docs/binary-protocol/framing-3","page_id":"/docs/binary-protocol/framing","type":"heading","tags":[],"url":"/docs/binary-protocol/framing#request-numbering","content":"Request numbering"},"492":{"id":"/docs/binary-protocol/framing-4","page_id":"/docs/binary-protocol/framing","type":"heading","tags":[],"url":"/docs/binary-protocol/framing#replyheader","content":"ReplyHeader"},"493":{"id":"/docs/binary-protocol/framing-5","page_id":"/docs/binary-protocol/framing","type":"heading","tags":[],"url":"/docs/binary-protocol/framing#result-section","content":"Result section"},"494":{"id":"/docs/binary-protocol/framing-6","page_id":"/docs/binary-protocol/framing","type":"heading","tags":[],"url":"/docs/binary-protocol/framing#evictionheader","content":"EvictionHeader"},"495":{"id":"/docs/binary-protocol/framing-7","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"Every message on a binary transport is a fixed **256-byte header** followed by an optional body. The header is a `#[repr(C)]` struct decoded by pointer cast (zero-copy), so field offsets are fixed and enforced at compile time in the server. Three header shapes cross the client boundary:"},"496":{"id":"/docs/binary-protocol/framing-8","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"`RequestHeader`: client to server."},"497":{"id":"/docs/binary-protocol/framing-9","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"`ReplyHeader`: server to client, answers one request."},"498":{"id":"/docs/binary-protocol/framing-10","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"`EvictionHeader`: server to client, connection rejection with no body."},"499":{"id":"/docs/binary-protocol/framing-11","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"The header shape is identified by the `command` byte at offset 60. Values a client sends or receives:"},"500":{"id":"/docs/binary-protocol/framing-12","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"| `command` | Value | Direction        | Meaning           |\n| --------- | ----- | ---------------- | ----------------- |\n| `Request` | 5     | client to server | A command request |","table":"table-0"},"501":{"id":"/docs/binary-protocol/framing-13","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"| `command` | Value | Direction        | Meaning               |\n| --------- | ----- | ---------------- | --------------------- |\n| `Reply`   | 8     | server to client | Answer to one request |","table":"table-0"},"502":{"id":"/docs/binary-protocol/framing-14","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"| `command`  | Value | Direction        | Meaning                                         |\n| ---------- | ----- | ---------------- | ----------------------------------------------- |\n| `Eviction` | 13    | server to client | Connection rejected, no per-request correlation |","table":"table-0"},"503":{"id":"/docs/binary-protocol/framing-15","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"Other `command` values (Prepare, PrepareOk, view-change traffic, and so on) are replica-to-replica consensus messages and never appear on a client connection. They are documented on the Server-to-server page."},"504":{"id":"/docs/binary-protocol/framing-16","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"The `size` field at offset 48 is the total frame length in bytes, header included. A body, when present, immediately follows the 256 header bytes and has length `size - 256`. Readers can decode `size` before typing the header. That offset is a protocol constant."},"505":{"id":"/docs/binary-protocol/framing-17","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing#requestheader","content":"Client to server. 256 bytes."},"506":{"id":"/docs/binary-protocol/framing-18","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing#requestheader","content":"| Offset | Size | Field      | Type | Description                                              |\n| ------ | ---- | ---------- | ---- | -------------------------------------------------------- |\n| 0      | 16   | `checksum` | u128 | Frame seal. Not used on client-facing frames. Send zero. |","table":"table-1"},"507":{"id":"/docs/binary-protocol/framing-19","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing#requestheader","content":"| Offset | Size | Field           | Type | Description                                             |\n| ------ | ---- | --------------- | ---- | ------------------------------------------------------- |\n| 16     | 16   | `checksum_body` | u128 | Body seal. Not used on client-facing frames. Send zero. |","table":"table-1"},"508":{"id":"/docs/binary-protocol/framing-20","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing#requestheader","content":"| Offset | Size | Field     | Type | Description            |\n| ------ | ---- | --------- | ---- | ---------------------- |\n| 32     | 16   | `cluster` | u128 | Cluster id. Send zero. |","table":"table-1"},"509":{"id":"/docs/binary-protocol/framing-21","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing#requestheader","content":"| Offset | Size | Field  | Type | Description                            |\n| ------ | ---- | ------ | ---- | -------------------------------------- |\n| 48     | 4    | `size` | u32  | Total frame length: 256 + body length. |","table":"table-1"},"510":{"id":"/docs/binary-protocol/framing-22","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing#requestheader","content":"| Offset | Size | Field  | Type | Description                |\n| ------ | ---- | ------ | ---- | -------------------------- |\n| 52     | 4    | `view` | u32  | Consensus view. Send zero. |","table":"table-1"},"511":{"id":"/docs/binary-protocol/framing-23","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing#requestheader","content":"| Offset | Size | Field     | Type | Description   |\n| ------ | ---- | --------- | ---- | ------------- |\n| 56  