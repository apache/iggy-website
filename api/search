ring with InvalidConnectionString instead of ignoring the key, so a typo fails fast rather than silently falling back to a default."},"2281":{"id":"/docs/sdk/connection-strings-14","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"The scheme picks the transport. Each transport has its own default server port:"},"2282":{"id":"/docs/sdk/connection-strings-15","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"Scheme"},"2283":{"id":"/docs/sdk/connection-strings-16","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"Transport"},"2284":{"id":"/docs/sdk/connection-strings-17","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"Default server port"},"2285":{"id":"/docs/sdk/connection-strings-18","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"iggy://"},"2286":{"id":"/docs/sdk/connection-strings-19","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"TCP (default)"},"2287":{"id":"/docs/sdk/connection-strings-20","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"8090"},"2288":{"id":"/docs/sdk/connection-strings-21","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"iggy+tcp://"},"2289":{"id":"/docs/sdk/connection-strings-22","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"TCP"},"2290":{"id":"/docs/sdk/connection-strings-23","page_id":"/docs/sdk/