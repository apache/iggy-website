lete topics"},"3390":{"id":"/docs/sdk/introduction-121","page_id":"/docs/sdk/introduction","tags":[],"type":"text","url":"/docs/sdk/introduction#common-operations","content":"PartitionClient - create, delete partitions"},"3391":{"id":"/docs/sdk/introduction-122","page_id":"/docs/sdk/introduction","tags":[],"type":"text","url":"/docs/sdk/introduction#common-operations","content":"SegmentClient - delete segments"},"3392":{"id":"/docs/sdk/introduction-123","page_id":"/docs/sdk/introduction","tags":[],"type":"text","url":"/docs/sdk/introduction#common-operations","content":"MessageClient - send, poll messages"},"3393":{"id":"/docs/sdk/introduction-124","page_id":"/docs/sdk/introduction","tags":[],"type":"text","url":"/docs/sdk/introduction#common-operations","content":"ConsumerOffsetClient - get, store, delete consumer offsets"},"3394":{"id":"/docs/sdk/introduction-125","page_id":"/docs/sdk/introduction","tags":[],"type":"text","url":"/docs/sdk/introduction#common-operations","content":"ConsumerGroupClient - create, get, list, delete consumer groups"},"3395":{"id":"/docs/sdk/introduction-126","page_id":"/docs/sdk/introduction","tags":[],"type":"text","url":"/docs/sdk/introduction#common-operations","content":"UserClient - create, get, list, update, delete users, change password, update permissions"},"3396":{"id":"/docs/sdk/introduction-127","page_id":"/docs/sdk/introduction","tags":[],"type":"text","url":"/docs/sdk/introduction#common-operations","content":"PersonalAccessTokenClient - create, list, delete PATs"},"3397":{"id":"/docs/sdk/introduction-128","page_id":"/docs/sdk/introduction","tags":[],"type":"text","url":"/docs/sdk/introduction#common-operations","content":"ClusterClient - cluster metadata"},"3398":{"id":"/docs/sdk/introduction-129","page_id":"/docs/sdk/introduction","tags":[],"type":"text","url":"/docs/sdk/introduction#polling-strategies","content":"When polling messages, you can choose from several strategies (Rust method names are shown):"},"3399":{"id":