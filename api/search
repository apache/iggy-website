s-71","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"Description"},"1730":{"id":"/docs/cli/commands-72","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"-m, --message-count <N>"},"1731":{"id":"/docs/cli/commands-73","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"Number of messages to poll (default: 1)"},"1732":{"id":"/docs/cli/commands-74","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"-a, --auto-commit"},"1733":{"id":"/docs/cli/commands-75","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"Submit the current batch's last offset asynchronously before delivering the poll reply. Not an acknowledged offset store"},"1734":{"id":"/docs/cli/commands-76","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"-c, --consumer <ID>"},"1735":{"id":"/docs/cli/commands-77","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"Consumer name or ID to poll as (default: 0)"},"1736":{"id":"/docs/cli/commands-78","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"-s, --show-headers"},"1737":{"id":"/docs/cli/commands-79","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"Include message headers in the output"},"1738":{"id":"/docs/cli/commands-80","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"--output-file <FILE>"},"1739":{"id":"/docs/cli/commands-81","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"Append polled messages to a binary file instead of printing"},"1740":{"id":"/docs/cli/commands-82","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"Polled messages can be replayed later, for example into another topic:"},"1741":{"id":"/docs/cli/commands-83","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#user","content":"Manage users and their permissions. Subcommands: create, delete, get, list, name, status, password, permissions."},"1742":{"id":"/docs/cli/commands-84","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"user create and user permissions accept the same permission flags:"},"1743":{"id":"/docs/cli/commands-85","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"Flag"},"1744":{"id":"/docs/cli/commands-86","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"Description"},"1745":{"id":"/docs/cli/commands-87","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"-g, --global-permissions <PERMS>"},"1746":{"id":"/docs/cli/commands-88","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"Comma-separated global permissions"},"1747":{"id":"/docs/cli/commands-89","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"-s, --stream-permissions <SPEC>"},"1748":{"id":"/docs/cli/commands-90","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"Per-stream (and per-topic) permissions, repeatable"},"1749":{"id":"/docs/cli/commands-91","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"-u, --user-status <active|inactive>"},"1750":{"id":"/docs/cli/commands-92","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"Initial status (create only, default: active)"},"1751":{"id":"/docs/cli/commands-93","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"Global permission tokens (long / short): manage_servers/m_srv, read_servers/r_srv, manage_users/m_usr, read_users/r_usr, manage_streams/m_str, read_streams/r_str, manage_topics/m_top, read_topics/r_top, poll_messages/p_msg, send_messages/s_msg."},"1752":{"id":"/docs/cli/commands-94","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"The stream permission format is STREAM_ID[:STREAM_PERMISSIONS][#TOPIC_ID[:TOPIC_PERMISSIONS]]:"},"1753":{"id":"/docs/cli/commands-95","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#pat","content":"Manage personal access tokens for the authenticated user. Subcommands: create, delete, list."},"1754":{"id":"/docs/cli/commands-96","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#pat","content":"--store-token and an expiry are mutually exclusive: stored tokens never expire."},"1755":{"id":"/docs/cli/commands-97","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#client","content":"Inspect the clients currently connected to the server. Clients are connections, not users."},"1756":{"id":"/docs/cli/commands-98","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#cluster","content":"Cluster operations. The only subcommand is metadata (alias m)."},"1757":{"id":"/docs/cli/commands-99","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#consumer-group","content":"Manage consumer groups of a topic. Subcommands: create, delete, get, list."},"1758":{"id":"/docs/cli/commands-100","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#consumer-offset","content":"Read or set the stored offset of a consumer for one partition. Subcommands: get, set. Both accept -k, --kind <consumer|consumer-group> (default: consumer)."},"1759":{"id":"/docs/cli/commands-101","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#context","content":"Manage named connection profiles. Subcommands: list, use, create, delete, show. See connection contexts for details."},"1760":{"id":"/docs/cli/commands-102","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#options","content":"Print the server's option catalog for one scope: topic, stream or user, with key kinds, defaults, and bounds. All three scopes have catalogs. stream update and topic update accept --set KEY=VALUE and --reset KEY. A stream key is supplied at creation through --stream-key-file."},"1761":{"id":"/docs/cli/commands-103","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#ping","content":"Check that the server is up and measure the response time. -c, --count <N> sends N pings (default: 1)."},"1762":{"id":"/docs/cli/commands-104","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#me","content":"Show info about the current connection: client ID, user ID, client address as seen by the server, protocol. Supported on TCP, QUIC and WebSocket. HTTP returns FeatureUnavailable."},"1763":{"id":"/docs/cli/commands-105","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#stats","content":"Show server statistics: streams, topics, partitions, messages, plus host OS details. -o, --output <table|list|json|toml> selects the format (default: table)."},"1764":{"id":"/docs/cli/commands-106","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#snapshot","content":"Collect server troubleshooting data into an archive. This requires manage_servers because the archive can include logs and host diagnostics."},"1765":{"id":"/docs/cli/commands-107","page_id":"/docs/cli/commands","tags":[],"type":"text","u