csharp/guide#reconnectionsettings","content":"UseExponentialBackoff"},"4808":{"id":"/docs/sdk/csharp/guide-133","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"bool"},"4809":{"id":"/docs/sdk/csharp/guide-134","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"true"},"4810":{"id":"/docs/sdk/csharp/guide-135","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"Use exponential backoff for delays"},"4811":{"id":"/docs/sdk/csharp/guide-136","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"BackoffMultiplier"},"4812":{"id":"/docs/sdk/csharp/guide-137","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"double"},"4813":{"id":"/docs/sdk/csharp/guide-138","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"2.0"},"4814":{"id":"/docs/sdk/csharp/guide-139","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"Multiplier for exponential backoff"},"4815":{"id":"/docs/sdk/csharp/guide-140","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"Warning: Reconnection is on by default with unlimited retries. Only a failed dial is retried. A rejected certificate, bad credentials, or a missing leader is thrown right away. With the default MaxRetries = 0 an unreachable server is retried forever, so a request that passes no CancellationToken waits for as long as the server stays down. Set MaxRetries or pass a token to bound the wait, and set Enabled = false to opt out of reconnection entirely. Reconnection only replays a request when auto-login can restore the session. A client that logged in by hand fails fast on a lost connection."},"4816":{"id":"/docs/sdk/csharp/guide-141","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Property"},"4817":{"id":"/docs/sdk/csharp/guide-142","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Type"},"4818":{"id":"/docs/sdk/csharp/guide-143","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Default"},"4819":{"id":"/docs/sdk/csharp/guide-144","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Description"},"4820":{"id":"/docs/sdk/csharp/guide-145","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Enabled"},"4821":{"id":"/docs/sdk/csharp/guide-146","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"bool"},"4822":{"id":"/docs/sdk/csharp/guide-147","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"false"},"4823":{"id":"/docs/sdk/csharp/guide-148","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Log in automatically once connected"},"4824":{"id":"/docs/sdk/csharp/guide-149","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Username"},"4825":{"id":"/docs/sdk/csharp/guide-150","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"string"},"4826":{"id":"/docs/sdk/csharp/guide-151","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"\"\""},"4827":{"id":"/docs/sdk/csharp/guide-152","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Username for auto-login"},"4828":{"id":"/docs/sdk/csharp/guide-153","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Password"},"4829":{"id":"/docs/sdk/csharp/guide-154","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"string"},"4830":{"id":"/docs/sdk/csharp/guide-155","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"\"\""},"4831":{"id":"/docs/sdk/csharp/guide-156","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Password for auto-login"},"4832":{"id":"/docs/sdk/csharp/guide-157","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"PersonalAccessToken"},"4833":{"id":"/docs/sdk/csharp/guide-158","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"string"},"4834":{"id":"/docs/sdk/csharp/guide-159","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"\"\""},"4835":{"id":"/docs/sdk/csharp/guide-160","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Personal access token to sign in with instead of a username and password; takes precedence over them when set"},"4836":{"id":"/docs/sdk/csharp/guide-161","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"All properties are init-only: build the settings with an object initializer or the static factories AutoLoginSettings.For(username, password) and AutoLoginSettings.ForPersonalAccessToken(token). Configuring auto-login is what enables transparent request replay after a reconnect. Without stored credentials a reconnect cannot restore the session, and requests fail until the client logs in again."},"4837":{"id":"/docs/sdk/csharp/guide-162","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#message-encryption","content":"Set IggyClientConfigurator.MessageEncryptor to encrypt message payloads and user headers client-side - they are encrypted on send and decrypted on poll, so the server only ever sees ciphertext. The built-in AesMessageEncryptor uses AES-GCM (confidentiality + authenticity) and takes a 16-, 24-, or 32-byte key for AES-128/192/256:"},"4838":{"id":"/docs/sdk/csharp/guide-163","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#message-encryption","content":"For a custom scheme, implement IMessageEncryptor."},"4839":{"id":"/docs/sdk/csharp/guide-164","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#message-encryption","content":"Things to know:"},"4840":{"id":"/docs/sdk/csharp/guide-165","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#message-encryption","content":"The encryptor applies to every message on the connection - topics mixing encrypted and plaintext messages are not supported."},"4841":{"id":"/docs/sdk/csharp/guide-166","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#message-encryption","content":"You own the encryptor and must dispose it once the client is done with it."},"4842":{"id":"/docs/sdk/csharp/guide-167","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#message-encryption","content":"With an encryptor configured, polling with autoCommit: true throws InvalidOperationException by default: the server commits the offset before the client decrypts, so a decryption failure would silently skip the whole batch. Poll with autoCommit: false and store offsets after processing, or opt in with AllowAutoCommitWithEncryptor = true. This guard does not affect the high-level IggyConsumer commit modes."},"4843":{"id":"/docs/sdk/csharp/guide-168","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#message-encryption","content":"On the high-level builders, WithEncryptor(...) is only valid when the builder creates its own client; for an external client, set MessageEncryptor on the configurator instead."},"4844":{"id":"/docs/sdk/csharp/guide-169","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#connection-events","content":"Subscribe to connection state changes - useful for reacting to reconnects (e.g. rejoining a consumer group):"},"4845":{"id":"/docs/sdk/csharp/guide-170","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#identifiers","content":"Streams, topics, users, and consumer groups are referenced by an Identifier, which can be either numeric or a name:"},"4846":{"id":"/docs/sdk/csharp/guide-171","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#identifiers","content":"Server-assigned ids are 0-based: the first stream, topic, partition, or consumer group gets id 0. The root user has id 0 as well."},"4847":{"id":"/docs/sdk/csharp/guide-172","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#user-login","content":"Begin with the root account (iggy / iggy):"},"4848":{"id":"/docs/sdk/csharp/guide-173","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#creating-users","content":"Create new users with customizable permissions:"},"4849":{"id":"/docs/sdk/csharp/guide-174","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#creating-users","content":"Besides Global, Permissions.Streams scopes permissions to specific streams (keyed by numeric stream id), and each StreamPermissions can in turn scope down to specific topics:"},"4850":{"id":"/docs/sdk/csharp/guide-175","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#personal-access-tokens","content":"Create and use Personal Access Tokens (PAT) for programmatic access:"},"4851":{"id":"/docs/sdk/csharp/guide-176","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#topics","content":"Every stream contains topics that organize messages into partitions:"},"4852":{"id":"/docs/sdk/csharp/guide-177","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#topics","content":"compressionAlgorithm, messageExpiry, and maxTopicSize are optional. messageExpiry is a nullable TimeSpan."},"4853":{"id":"/docs/sdk/csharp/guide-178","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#topic-options","content":"CreateTopicAsync also accepts an options dictionary for settings that have no parameter of their own. Build it with the TopicOptions helper (in Apache.Iggy.Contracts):"},"4854":{"id":"/docs/sdk/csharp/guide-179","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#topic-options","content":"A property left null emits no key and keeps the server default. These keys are settable at creation only: UpdateTopicAsync refuses them by name, the same way it refuses a key outside the server's catalog, so a mistyped key fails the call instead of being silently ignored. Use DescribeOptionsAsync to enumerate the keys a server accepts."},"4855":{"id":"/docs/sdk/csharp/guide-180","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#topic-options","content":"There is no on-demand flush command. Durability is configured per topic through EnforceFsync and the flush thresholds above."},"4856":{"id":"/docs/sdk/csharp/guide-181","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#partitions","content":"Add partitions to or remove them from an existing topic:"},"4857":{"id":"/docs/sdk/csharp/guide-182","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#sending-messages","content":"A Message takes an id (Guid or UInt128) and a payload:"},"4858":{"id":"/docs/sdk/csharp/guide-183","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#sending-messages","content":"SendMessagesAsync returns a SendMessagesResponse whose Confirmations carry StreamId, TopicId, PartitionId, and BaseOffset (the offset of the first message of the batch) per committed batch. An empty list means the batch committed with no offsets to report. A single-message overload is also available: SendMessagesAsync(streamId, topicId, partitioning, message)."},"4859":{"id":"/docs/sdk/csharp/guide-184","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#sending-messages","content":"To send many payloads without a byte[] allocation per message, build them into a single pooled buffer with RentedMessageBatchBuilder - see Publishing with rented batches."},"4860":{"id":"/docs/sdk/csharp/guide-185","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#partitioning-strategies","content":"Control which partition receives each message:"},"4861":{"id":"/docs/sdk/csharp/guide-186","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#partitioning-strategies","content":"Partition selection is resolved client-side on both transports. Balanced partitioning round-robins over the topic's partitions, and key-based routing hashes the key with xxHash32 modulo the partition count, consistent with the Rust SDK."},"4862":{"id":"/docs/sdk/csharp/guide-187","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#user-defined-headers","content":"Add typed custom headers to messages. Build keys with HeaderKey.FromString and values with the HeaderValue.From* factories:"},"4863":{"id":"/docs/sdk/csharp/guide-188","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#user-defined-headers","content":"Available value factories: FromString, FromBool, FromBytes, FromUInt8, FromInt32, FromInt64, FromInt128, FromUInt32, FromUInt64, FromUInt128, FromFloat, FromDouble, FromGuid."},"4864":{"id":"/docs/sdk/csharp/guide-189","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#fetching-messages","content":"Poll a batch of messages. The partitionId may be null to consume from any partition:"},"4865":{"id":"/docs/sdk/csharp/guide-190","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#fetching-messages","content":"A convenience overload accepts a MessageFetchRequest if you prefer named fields:"},"4866":{"id":"/docs/sdk/csharp/guide-191","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#polling-with-rented-buffers","content":"PollMessagesAsync copies each payload into its own byte[]. On hot paths that allocation adds up. PollMessagesRentedAsync instead returns a PolledMessagesRental whose payloads and raw headers are slices over a single buffer rented from a shared pool - no per-message allocation."},"4867":{"id":"/docs/sdk/csharp/guide-192","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#polling-with-rented-buffers","content":"The rental owns that buffer, so you must dispose it, and the payload/header memory is only valid until you do. Wrap it in using and never hold a Payload/RawUserHeaders reference past the block:"},"4868":{"id":"/docs/sdk/csharp/guide-193","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#polling-with-rented-buffers","content":"A Messag