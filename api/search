server/configuration#data_maintenancemessages","content":"Run the segment cleaner. It deletes the oldest sealed segments of topics with a finite message_expiry or max_topic_size, per partition, best-effort. The active segment is never touched, and stored consumer/group offsets can hold back deletion."},"4036":{"id":"/docs/server/configuration-418","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#data_maintenancemessages","content":"interval"},"4037":{"id":"/docs/server/configuration-419","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#data_maintenancemessages","content":"\"1 m\""},"4038":{"id":"/docs/server/configuration-420","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#data_maintenancemessages","content":"Cleaner run interval."},"4039":{"id":"/docs/server/configuration-421","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"Key"},"4040":{"id":"/docs/server/configuration-422","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"Default"},"4041":{"id":"/docs/server/configuration-423","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"Description"},"4042":{"id":"/docs/server/configuration-424","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"enabled"},"4043":{"id":"/docs/server/configuration-425","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"true"},"4044":{"id":"/docs/server/configuration-426","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"Verify client heartbeats."},"4045":{"id":"/docs/server/configuration-427",