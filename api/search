to 1, and cursor handling can enlarge $limit"},"5135":{"id":"/docs/connectors/sources/influxdb-50","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"cursor_field"},"5136":{"id":"/docs/connectors/sources/influxdb-51","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"string"},"5137":{"id":"/docs/connectors/sources/influxdb-52","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"_time (v2), time (v3)"},"5138":{"id":"/docs/connectors/sources/influxdb-53","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"Column used as the cursor"},"5139":{"id":"/docs/connectors/sources/influxdb-54","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"initial_offset"},"5140":{"id":"/docs/connectors/sources/influxdb-55","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"string"},"5141":{"id":"/docs/connectors/sources/influxdb-56","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"1970-01-01T00:00:00Z"},"5142":{"id":"/docs/connectors/sources/influxdb-57","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"Starting RFC3339 cursor when no checkpoint exists"},"5143":{"id":"/docs/connectors/sources/influxdb-58","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"payload_format"},"5144":{"id":"/docs/connectors/sources/influxdb-59","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"string"},"5145":{"id":"/docs/connectors/sources/influxdb-60","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"json"},"5146":{"id":"/docs/connectors/sources/influxdb-61","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"json, text, or raw"},"5147":{"id":"/docs/connectors/sources/influxdb-62","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"include_metadata"},"5148":{"id":"/docs/connectors/sources/influxdb-63","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"bool"},"5149":{"id":"/docs/connectors/sources/influxdb-64","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"true"},"5150":{"id":"/docs/connectors/sources/influxdb-65","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"Controls columns in the whole-row JSON payload. See below"},"5151":{"id":"/docs/connectors/sources/influxdb-66","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"stuck_batch_cap_factor"},"5152":{"id":"/docs/connectors/sources/influxdb-67","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"u32"},"5153":{"id":"/docs/connectors/sources/influxdb-68","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"10"},"5154":{"id":"/docs/connectors/sources/influxdb-69","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"V3 only: inflation cap. Accepts 2 through 100, or 0 to disable the guards"},"5155":{"id":"/docs/connectors/sources/influxdb-70","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"payload_column extracts one column. Without it, every payload_format setting emits whole-row JSON. With it, the selected json, text or raw format applies, and the destination streams.schema should match. Selecting a column that is missing from a row causes a poll error."},"5156":{"id":"/docs/connectors/sources/influxdb-71","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"Resilience defaults are timeout = \"10s\", max_retries = 3, retry_delay = \"1s\", retry_max_delay = \"5s\", max_open_retries = 10, open_retry_max_delay = \"60s\", circuit_breaker_threshold = 5, and circuit_breaker_cool_down = \"30s\". Attempt counts include the first attempt and are clamped to at least one. Query retries cover network errors, HTTP 429 and 5xx, with exponential backoff and jitter. An integer-seconds Retry-After on 429 can override the delay cap. Other HTTP failures and malformed successful responses return poll errors. Invalid duration strings warn and fall back to 1s. Zero durations are accepted. verbose_logging defaults to false."},"5157":{"id":"/docs/connectors/sources/influxdb-72","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#cursor-based-polling","content":"The connector substitutes its RFC3339 cursor into the query. Both versions require ascending timestamps and a stable, unique order within each timestamp group. Include all necessary tag or key columns after the timestamp in the sort. The examples use host because their data model has one point per host and timestamp."},"5158":{"id":"/docs/connectors/sources/influxdb-73","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#cursor-based-polling","content":"V2 uses an inclusive cursor, such as range(start: time(v: \"$cursor\")). Flux sorts and limits each table separately, so the example groups its selected numeric field into one table before sorting. A persisted count skips rows already acknowledged at the cursor timestamp. $limit is the base batch size plus that count, capped at eleven times the base size. Dense timestamp groups can exhaust the skip allowance and produce a stuck-cursor error without advancing the cursor. A strict > query can lose unseen ties and is unsuitable for this skip-count scheme."},"5159":{"id":"/docs/connectors/sources/influxdb-74","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#cursor-based-polling","content":"V3 requires strict WHERE time > '$cursor'. Inclusive >= templates are rejected. A full batch containing one timestamp retains the previous cursor, advances $offset, and doubles the next query size up to the configured cap. A full batch containing several timestamps defers the final timestamp group to the next poll. Reaching the inflation cap emits no messages, resets the effective size to the base size, preserves the offset, and records a circuit-breaker failure. The breaker opens only when its failure threshold is reached. Setting the cap factor to 0 disables these guards and can skip unseen tied rows."},"5160":{"id":"/docs/connectors/sources/influxdb-75","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#cursor-based-polling","content":"A timestamp watermark is not change-data capture. Late inserts, edits and backdated points at or below an acknowledged watermark can be missed, and changing the order of tied rows invalidates offset-based progress. Neither version tracks deletions. The connector's timestamp-plus-position message IDs can also collide for distinct rows across batches. They are not unique database-row keys."},"5161":{"id":"/docs/connectors/sources/influxdb-76","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#payload-formats","content":"Whole-row json: V3 emits a flat object with native JSON types. include_metadata = false removes only the cursor column. V2 emits an envelope with measurement, field, timestamp, value and row. Its parser reads CSV cells as strings and ignores the #datatype and #default values. Payload conversion tries bool, integer and finite float, then string. An empty cell becomes null. Thus a string field containing \"42\" becomes the number 42 in V2 but stays a string in V3. With metadata disabled, V2's row retains only _time and _value. The envelope remains."},"5162":{"id":"/docs/connectors/sources/influxdb-77","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#payload-formats","content":"Selected-column json: V2 parses the cell as JSON. V3 serializes the column's existing JSON value, so a string containing JSON remains a JSON string."},"5163":{"id":"/docs/connectors/sources/influxdb-78","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#payload-formats","content":"Selected-column text: V2 emits the cell as UTF-8. V3 emits strings directly and serializes other JSON values as text."},"5164":{"id":"/docs/connectors/sources/influxdb-79","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#payload-formats","content":"Selected-column raw: the column must contain standard base64 text, which is decoded into raw bytes."},"5165":{"id":"/docs/connectors/sources/influxdb-80","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#payload-formats","content":"Missing selected columns, invalid JSON cells in V2, and invalid base64 reject the poll. V3 also rejects any row with a missing, non-string or invalid cursor. V2 can emit rows without valid cursors if another row supplies a usable watermark. Keep the cursor column in every row. V3 timestamps without a timezone suffix are treated as UTC, preserving nanoseconds. Keep database timestamps in the payload when consumers need them. The runtime does not transfer the plugin's timestamp fields into broker message metadata."},"5166":{"id":"/docs/connectors/sources/influxdb-81","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#state-and-failures","content":"Successful polls return a versioned MessagePack checkpoint, including empty polls. After forwarding messages, the runtime saves it and sends Ack. Only then does the plugin apply its candidate cursor and row count. Nack discards that candidate so the next poll can fetch the records again. A failure after forwarding but before acknowledgement can produce duplicates."},"5167":{"id":"/docs/connectors/sources/influxdb-82","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#state-and-failures","content":"The default file backend stores source_influxdb.state under the runtime's state path (default local_state). The runtime also supports an HTTP state backend. V2 restores versioned state or its legacy unversioned state. V3 requires versioned V3 state. Corrupt checkpoints, invalid saved timestamps and mismatched versions prevent startup. To reset file-backed progress, stop the runtime and remove the source's checkpoint, then restart with the desired initial_offset."},"5168":{"id":"/docs/connectors/sources/influxdb-83","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#state-and-failures","content":"Query and parsing failures leave the acknowledged cursor unchanged and are logged as poll errors. They do not increment the runtime's forwarding-error counter or change its running status. While its circuit breaker is open, the plugin waits and returns empty batches without checkpoints. On cooldown expiry it permits another query. A V3 response reporting that the database was not found is treated as an empty result, so create the database before starting the source."},"5169":{"id":"/docs/connectors/sources/mqtt","page_id":"/docs/connectors/sources/mqtt","type":"page","content":"MQTT","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/mqtt"},"5170":{"id":"/docs/connectors/sources/mqtt-0","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt","content":"Read MQTT subscriptions and acknowledge broker messages after Iggy accepts their batch."},"5171":{"id":"/docs/connectors/sources/mqtt-1","page_id":"/docs/connectors/sources/mqtt","type":"heading","tags":[],"url":"/docs/connectors/sources/mqtt#configuration","content":"Configuration"},"5172":{"id":"/docs/connectors/sources/mqtt-2","page_id":"/docs/connectors/sources/mqtt","type":"heading","tags":[],"url":"/docs/connectors/sources/mqtt#tls","content":"TLS"},"5173":{"id":"/docs/connectors/sources/mqtt-3","page_id":"/docs/connectors/sources/mqtt","type":"heading","tags":[],"url":"/docs/connectors/sources/mqtt#batching","content":"Batching"},"5174":{"id":"/docs/connectors/sources/mqtt-4","page_id":"/docs/connectors/sources/mqtt","type":"heading","tags":[],"url":"/docs/connectors/sources/mqtt#delivery-behavior","content":"Delivery behavior"},"5175":{"id":"/docs/connectors/sources/mqtt-5","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt","content":"The MQTT source subscribes to an MQTT broker and sends payloads to one Iggy stream and topic. It supports MQTT 3.1.1 and MQTT 5, TLS, optional client certificates and per-filter QoS. MQTT 5 is the default."},"5176":{"id":"/docs/connectors/sources/mqtt-6","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#configuration","content":"Build iggy_connector_mqtt_source from the same release source as the runtime. Create the destination stream and topic before starting the connector. Add this file to the local provider:"},"5177":{"id":"/docs/connectors/sources/mqtt-7","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#configuration","content":"broker_url and a nonempty subscriptions list are required. Broker URLs accept mqtt://, mqtts:// or ssl://. Supply username and password together when the broker requires credentials. subscription_qos can override the default QoS for a filter already listed in subscriptions. Each value must be zero, one or two."},"5178":{"id":"/docs/connectors/sources/mqtt-8","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#configuration","content":"Use a stable client_id, clean_start=false and a nonzero MQTT 5 session expiry to resume broker sessions. With include_metadata=true, the source places MQTT 5 properties in a JSON envelope. Without it, payloads remain raw bytes."},"5179":{"id":"/docs/connectors/sources/mqtt-9","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#tls","content":"plugin_config.tls.ca_file selects a CA bundle. client_cert_file and client_key_file must be supplied together for mutual TLS. Certificate hostname validation uses the host in broker_url. A separate server-name override is not available."},"5180":{"id":"/docs/connectors/sources/mqtt-10","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#batching","content":"batch_size defaults to 100 and batch_timeout to 10 milliseconds after the first message. poll_timeout defaults to one second. request_capacity defaults to 32. The source keeps one batch in flight until the runtime reports its result."},"5181":{"id":"/docs/connectors/sources/mqtt-11","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#batching","content":"These plugin limits are separate from the runtime producer's batch_length and linger_time. Configure only one destination [[streams]] entry per source instance. There is no per-message destination routing."},"5182":{"id":"/docs/connectors/sources/mqtt-12","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#delivery-behavior","content":"For QoS 1 and QoS 2, the source defers broker acknowledgements until Iggy accepts the batch. An Iggy failure causes a negative batch result, and the plugin retains the batch for replay. A crash after Iggy accepts it but before the broker receives the acknowledgement can produce duplicates."},"5183":{"id":"/docs/connectors/sources/mqtt-13","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#delivery-behavior","content":"max_retries defaults to five retries after the first broker acknowledgement attempt. If these attempts fail, the source abandons that acknowledgement and continues. Broker redelivery can then duplicate the message. QoS 0 has no acknowledgement token and cannot use this recovery mechanism."},"5184":{"id":"/docs/connectors/sources/mqtt-14","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#delivery-behavior","content":"The source returns no durable connector checkpoint. Recovery after restart depends on the broker retaining the MQTT session. MQTT packet IDs are temporary and cannot serve as durable deduplication keys. The source does not provide an end-to-end exactly-once guarantee, including when MQTT uses QoS 2."},"5185":{"id":"/docs/connectors/sources/mqtt-15","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#delivery-behavior","content":"Select the destination topic's durability before creation. An Iggy acknowledgement under replicated does not imply stable-storage persistence. The MQTT source reference includes broker setup and recovery examples."},"5186":{"id":"/docs/connectors/sources/postgres","page_id":"/docs/connectors/sources/postgres","type":"page","content":"Postgres Source","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/postgres"},"5187":{"id":"/docs/connectors/sources/postgres-0","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres","content":"Stream rows from PostgreSQL into Iggy topics by incremental table polling or change data capture over logical replication."},"5188":{"id":"/docs/connectors/sources/postgres-1","page_id":"/docs/connectors/sources/postgres","type":"heading","tags":[],"url":"/docs/connectors/sources/postgres#features","content":"Features"},"5189":{"id":"/docs/connectors/sources/postgres-2","page_id":"/docs/connectors/sources/postgres","type":"heading","tags":[],"url":"/docs/connectors/sources/postgres#configuration","content":"Configuration"},"5190":{"id":"/docs/connectors/sources/postgres-3","page_id":"/docs/connectors/sources/postgres","type":"heading","tags":[],"url":"/docs/connectors/sources/postgres#plugin-config-options","content":"Plugin config options"},"5191":{"id":"/docs/connectors/sources/postgres-4","page_id":"/docs/connectors/sources/postgres","type":"heading","tags":[],"url":"/docs/connectors/sources/postgres#polling-and-delivery","content":"Polling and Delivery"},"5192":{"id":"/docs/connectors/sources/postgres-5","page_id":"/docs/connectors/sources/postgres","type":"heading","tags":[],"url":"/docs/connectors/sources/postgre