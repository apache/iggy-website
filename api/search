/docker-31","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"Deployment - the Iggy server pod with required security context (SYS_NICE, seccomp unconfined, unlimited memlock)"},"1036":{"id":"/docs/server/docker-32","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"Service - exposes TCP (8090), QUIC (8080), HTTP (3000), and WebSocket (8092) ports"},"1037":{"id":"/docs/server/docker-33","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"ServiceAccount - dedicated service account"},"1038":{"id":"/docs/server/docker-34","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"PersistentVolumeClaim - persistent storage for local_data"},"1039":{"id":"/docs/server/docker-35","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"HPA - Horizontal Pod Autoscaler (optional)"},"1040":{"id":"/docs/server/docker-36","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"Ingress - optional ingress for HTTP access"},"1041":{"id":"/docs/server/docker-37","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"ServiceMonitor - Prometheus ServiceMonitor for metrics collection (optional)"},"1042":{"id":"/docs/server/docker-38","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"Secret - root user credentials"},"1043":{"id":"/docs/server/docker-39","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#key-values","content":"Customize the values file for your environment and deploy with:"},"1044":{"id":"/docs/server/introduction","page_id":"/docs/server/introduction","type":"page","content":"Introduction","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/introduction"},"1045":{"id":"/docs/server/introduction-0","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"Iggy server is the most important part of the system as it's responsible for handling all the incoming connections, managing the data and providing the API for the clients. The server is written in Rust and can be run on any platform that supports it."},"1046":{"id":"/docs/server/introduction-1","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"The releases are published to GitHub and can be found here. The official Docker images can be found here, simply type docker pull apache/iggy."},"1047":{"id":"/docs/server/introduction-2","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"Keep in mind, that if you were to compile the source code in release mode, the longer compilation time is due to LTO enabled in profile."},"1048":{"id":"/docs/server/introduction-3","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"The HTTP API endpoints can be found in server.http file, which can be used with REST Client extension for VS Code."},"1049":{"id":"/docs/server/introduction-4","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"In order to see the detailed logs from the server, run it with RUST_LOG=trace environment variable."},"1050":{"id":"/docs/server/introduction-5","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"And finally, to seed the example data, simply execute cargo r --bin data-seeder-tool from the root of the repository while running your Iggy server."},"1051":{"id":"/docs/server/introduction-6","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"All the requests to the server except of sending a ping, fetching the stats or logging in, require the session to be authenticated. The session is created by logging in with the user's credentials or personal access token and is valid for the duration of the session or until the user logs out or the connection is lost. In case of HTTP API, the authentication is done by providing the Authorization header with the Bearer token."},"1052":{"id":"/docs/server/networking","page_id":"/docs/server/networking","type":"page","content":"Networking","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/networking"},"1053":{"id":"/docs/server/networking-0","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#transport-protocols","content":"Transport protocols"},"1054":{"id":"/docs/server/networking-1","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#binary-protocol","content":"Binary protocol"},"1055":{"id":"/docs/server/networking-2","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#protocol-distribution-across-shards","content":"Protocol distribution across shards"},"1056":{"id":"/docs/server/networking-3","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#tcp","content":"TCP"},"1057":{"id":"/docs/server/networking-4","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#quic","content":"QUIC"},"1058":{"id":"/docs/server/networking-5","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#http","content":"HTTP"},"1059":{"id":"/docs/server/networking-6","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#websocket","content":"WebSocket"},"1060":{"id":"/docs/server/networking-7","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#tls","content":"TLS"},"1061":{"id":"/docs/server/networking-8","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#heartbeat","content":"Heartbeat"},"1062":{"id":"/docs/server/networking-9","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking","content":"Iggy supports four transport protocols simultaneously, each optimized for different use cases. All stateful protocols (TCP, QUIC, WebSocket) use the same custom binary wire protocol, while HTTP provides a standard REST API."},"1063":{"id":"/docs/server/networking-10","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Protocol"},"1064":{"id":"/docs/server/networking-11","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Default Address"},"1065":{"id":"/docs/server/networking-12","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Implementation"},"1066":{"id":"/docs/server/networking-13","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Best for"},"1067":{"id":"/docs/server/networking-14","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"TCP"},"1068":{"id":"/docs/server/networking-15","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"127.0.0.1:8090"},"1069":{"id":"/docs/server/networking-16","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"compio + custom binary framing"},"1070":{"id":"/docs/server/networking-17","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Highest throughput, lowest latency"},"1071":{"id":"/docs/server/networking-18","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"QUIC"},"1072":{"id":"/docs/server/networking-19","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"127.0.0.1:8080"},"1073":{"id":"/docs/server/networking-20","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"compio-quic (quinn)"},"1074":{"id":"/docs/server/networking-21","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Secure connections, multiplexing"},"1075":{"id":"/docs/server/networking-22","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"HTTP"},"1076":{"id":"/docs/server/networking-23","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"127.0.0.1:3000"},"1077":{"id":"/docs/server/networking-24","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"axum"},"1078":{"id":"/docs/server/networking-25","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"REST API, web integrations"},"1079":{"id":"/docs/server/networking-26","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"WebSocket"},"1080":{"id":"/docs/server/networking-27","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"127.0.0.1:8092"},"1081":{"id":"/docs/server/networking-28","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"compio-ws"},"1082":{"id":"/docs/server/networking-29","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Browser clients, bidirectional streaming"},"1083":{"id":"/docs/server/networking-30","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Performance ranking (lowest to highest overhead): TCP > QUIC > WebSocket > HTTP"},"1084":{"id":"/docs/server/networking-31","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#binary-protocol","content":"TCP, QUIC, and WebSocket all use the same binary protocol format. Each request/response frame consists of:"},"1085":{"id":"/docs/server/networking-32","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#binary-protocol","content":"The iggy_binary_protocol crate provides zero-copy serialization for all protocol frames. Foreign SDKs implement this protocol natively."},"1086":{"id":"/docs/server/networking-33","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#protocol-distribution-across-shards","content":"The transport servers are distributed across shards based on their requirements:"},"1087":{"id":"/docs/server/networking-34","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#protocol-distribution-across-shards","content":"Shard 0: HTTP server (axum) and QUIC server"},"1088":{"id":"/docs/server/networking-35","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#protocol-distribution-across-shards","content":"All shards: TCP and WebSocket servers"},"1089":{"id":"/docs/server/networking-36","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#protocol-distribution-across-shards","content":"This distribution means TCP and WebSocket connections can be served by any shard, which works well with TCP socket migration."},"1090":{"id":"/docs/server/networking-37","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tcp","content":"TCP provides the highest performance as it works directly with binary data without the overhead of HTTP or TLS handshakes (unless TLS is enabled). Key features:"},"1091":{"id":"/docs/server/networking-38","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tcp","content":"Socket migration: when enabled (default), TCP sockets can be migrated between shards. If a client's request targets a partition owned by a different shard, the socket moves to the owning shard instead of forwarding the request, eliminating cross-shard hops on the data path."},"1092":{"id":"/docs/server/networking-39","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tcp","content":"IPv6 support: configurable via ipv6 = true"},"1093":{"id":"/docs/server/networking-40","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tcp","content":"Socket tuning: configurable buffer sizes, keepalive, nodelay (Nagle algorithm), and linger timeout"},"1094":{"id":"/docs/server/networking-41","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"QUIC provides built-in TLS encryption and stream multiplexing. It uses the same binary protocol as TCP but runs over UDP. QUIC support is built on top of the quinn library. While not quite as fast as TCP, QUIC provides better security out of the box (TLS is mandatory)."},"1095":{"id":"/docs/server/networking-42","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"The HTTP API is built on axum and provides a standard REST interface. It includes JWT authentication, Prometheus metrics, CORS configuration, and optional TLS."},"1096":{"id":"/docs/server/networking-43","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"HTTP is the most accessible protocol but has the highest overhead due to JSON serialization and the stateless nature of HTTP (no persistent connections for consumer groups). You can find all the available endpoints in the server.http file."},"1097":{"id":"/docs/server/networking-44","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"The HTTP server also hosts:"},"1098":{"id":"/docs/server/networking-45","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"Prometheus metrics at /metrics (configurable endpoint)"},"1099":{"id":"/docs/server/networking-46","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"Embedded Web UI at /ui (when compiled with iggy-web feature)"},"1100":{"id":"/docs/server/networking-47","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"WebSocket provides bidirectional streaming over HTTP upgrade. Iggy uses a custom compio-ws implementation that bridges the gap between tungstenite's poll-based model and compio's completion-based model."},"1101":{"id":"/docs/server/networking-48","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"The challenge was fundamental: traditional WebSocket libraries expect std::io::Read (caller owns the buffer), while compio's AsyncRead takes ownership of the buffer (kernel owns it temporarily). The solution is a GrowableSyncStream that dynamically grows from a 128 KB base, with linear growth in base capacity increments, a 64 MB cap, and auto-shrink when the buffer exceeds 4x the base and data is consumed."},"1102":{"id":"/docs/server/networking-49","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"WebSocket runs on all shards (not just shard 0) and supports optional TLS."},"1103":{"id":"/docs/server/networking-50","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"Benchmark comparison (AWS i3en.3xlarge, fsync per message, 4 producers, 40M messages):"},"1104":{"id":"/docs/server/networking-51","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"Producer avg latency: TCP 2.61ms vs WebSocket 3.43ms (+31%)"},"1105":{"id":"/docs/server/networking-52","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"Consumer avg latency: TCP 0.70ms vs WebSocket 1.44ms (+106%)"},"1106":{"id":"/docs/server/networking-53","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"All transport protocols support TLS encryption:"},"1107":{"id":"/docs/server/networking-54","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Transport"},"1108":{"id":"/docs/server/networking-55","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"TLS Mechanism"},"1109":{"id":"/docs/server/networking-56","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"TCP"},"1110":{"id":"/docs/server/networking-57","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Optional, via rustls"},"1111":{"id":"/docs/server/networking-58","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"QUIC"},"1112":{"id":"/docs/server/networking-59","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Built-in, mandatory (part of QUIC spec)"},"1113":{"id":"/docs/server/networking-60","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"HTTP"},"1114":{"id":"/docs/server/networking-61","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Optional HTTPS"},"1115":{"id":"/docs/server/networking-62","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"WebSocket"},"1116":{"id":"/docs/server/networking-63","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Inherits from its transport"},"1117":{"id":"/docs/server/networking-64","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"All protocols support self-signed certificate generation when self_signed = true and the cert files don't exist. For production, provide proper certificate files via the cert_file and key_file settings."},"1118":{"id":"/docs/server/networking-65","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#heartbeat","content":"An optional heartbeat mechanism can verify client liveness:"},"1119":{"id":"/docs/server/networking-66","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#heartbeat","content":"When enabled, the server expects periodic heartbeat messages from connected clients. Clients that miss heartbeats may be disconnected."},"1120":{"id":"/docs/server/schema","page_id":"/docs/server/schema","type":"page","content":"Schema","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/schema"},"1121":{"id":"/docs/server/schema-0","page_id":"/docs/server/schema","type":"heading","tags":[],"url":"/docs/server/schema#request-schema","content":"Request schema"},"1122":{"id":"/docs/server/schema-1","page_id":"/docs/serv