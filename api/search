l measurement name"},"5853":{"id":"/docs/connectors/sinks/influxdb-45","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"precision"},"5854":{"id":"/docs/connectors/sinks/influxdb-46","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"string"},"5855":{"id":"/docs/connectors/sinks/influxdb-47","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"us"},"5856":{"id":"/docs/connectors/sinks/influxdb-48","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"Timestamp precision: ns, us, ms, or s"},"5857":{"id":"/docs/connectors/sinks/influxdb-49","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"batch_size"},"5858":{"id":"/docs/connectors/sinks/influxdb-50","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"u32"},"5859":{"id":"/docs/connectors/sinks/influxdb-51","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"500"},"5860":{"id":"/docs/connectors/sinks/influxdb-52","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"Maximum messages per write request. 0 behaves as 1"},"5861":{"id":"/docs/connectors/sinks/influxdb-53","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"payload_format"},"5862":{"id":"/docs/connectors/sinks/influxdb-54","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"string"},"5863":{"id":"/docs/connectors/sinks/influxdb-55","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"json"},"5864":{"id":"/docs/connectors/sinks/influxdb-56","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"json, text, or base64"},"5865":{"id":"/docs/connectors/sinks/influxdb-57","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"include_metadata"},"5866":{"id":"/docs/connectors/sinks/influxdb-58","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"bool"},"5867":{"id":"/docs/connectors/sinks/influxdb-59","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"true"},"5868":{"id":"/docs/connectors/sinks/influxdb-60","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"Include stream/topic/partition metadata as tags or fields. Independent of checksum and origin timestamp"},"5869":{"id":"/docs/connectors/sinks/influxdb-61","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"The include_checksum, include_origin_timestamp, include_stream_tag, include_topic_tag, and include_partition_tag flags also default to true."},"5870":{"id":"/docs/connectors/sinks/influxdb-62","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"message_id is always a string field and offset is always a tag."},"5871":{"id":"/docs/connectors/sinks/influxdb-63","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"With include_metadata = true, stream, topic and partition are tags by default. Disabling an individual include_*_tag flag writes that value as an iggy_stream, iggy_topic, or iggy_partition field instead."},"5872":{"id":"/docs/connectors/sinks/influxdb-64","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"include_metadata = false omits those three values. It does not disable the independently controlled iggy_checksum and iggy_origin_timestamp fields."},"5873":{"id":"/docs/connectors/sinks/influxdb-65","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"Point timestamps come from the Iggy message timestamp in microseconds, converted to precision. A zero timestamp uses the current wall-clock time. Millisecond and second precision discard finer timestamp digits."},"5874":{"id":"/docs/connectors/sinks/influxdb-66","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"InfluxDB identifies points by measurement/table, tags and timestamp. Removing stream, topic or partition tags can merge distinct messages that share an offset and timestamp. Moving those values to fields does not preserve their identity. See the V2 and V3 duplicate-point rules."},"5875":{"id":"/docs/connectors/sinks/influxdb-67","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"Resilience options include timeout (30s), max_retries (3 total write attempts), retry_delay (1s), retry_max_delay (5s), max_open_retries (10 total health-check attempts), open_retry_max_delay (60s), circuit_breaker_threshold (5), and circuit_breaker_cool_down (30s). Invalid duration strings warn and fall back to 1s. See the upstream influxdb_sink README for the full list."},"5876":{"id":"/docs/connectors/sinks/influxdb-68","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#payload-formats","content":"json (default): the message payload is validated as JSON, compact-serialized, and written as a single payload_json string field (individual JSON fields do not become separate field entries)."},"5877":{"id":"/docs/connectors/sinks/influxdb-69","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#payload-formats","content":"text: the payload must be valid UTF-8 and is written as a single payload_text string field."},"5878":{"id":"/docs/connectors/sinks/influxdb-70","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#payload-formats","content":"base64: the payload bytes are base64-encoded into a payload_base64 string field."},"5879":{"id":"/docs/connectors/sinks/influxdb-71","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#payload-formats","content":"payload_format selects the stored representation after stream decoding and transforms. For arbitrary bytes, use schema = \"raw\" with payload_format = \"base64\" and no payload-changing transform. For plain text, use schema = \"text\" with payload_format = \"text\". JSON stream decoding can change the original byte representation."},"5880":{"id":"/docs/connectors/sinks/influxdb-72","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#payload-formats","content":"Text carriage returns and newlines become the literal sequences \\r and \\n in the stored string. Use base64 if those original bytes must round-trip. Tabs in measurement names or tag values are rejected. Quoted text fields allow tabs."},"5881":{"id":"/docs/connectors/sinks/influxdb-73","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#payload-formats","content":"Format names are case-insensitive. utf8 aliases text and raw aliases base64. An unrecognized payload_format logs a warning and falls back to json."},"5882":{"id":"/docs/connectors/sinks/influxdb-74","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#reliability","content":"Messages are serialized to line protocol and each polled batch is split into chunks of at most batch_size messages, one HTTP POST per chunk. The final partial chunk is written immediately. The connector does not accumulate messages across polls. A serialization error rejects its entire chunk. Later chunks are still attempted after a failure, and the first error is returned after the loop."},"5883":{"id":"/docs/connectors/sinks/influxdb-75","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#reliability","content":"HTTP 429, all 5xx responses, and network errors are retried. max_retries = 3 allows the initial attempt plus two retries. 0 and 1 both allow one attempt. Backoff starts at retry_delay, doubles, adds ±20% jitter, and is capped by retry_max_delay. An integer-seconds Retry-After on a 429 overrides that cap. HTTP-date values are ignored. Startup health checks use a separate attempt budget and cap, retrying any failed check."},"5884":{"id":"/docs/connectors/sinks/influxdb-76","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#reliability","content":"The circuit breaker counts at most one failure per consumed batch, based on its first error. A permanent HTTP error does not increment the counter. A fully successful batch resets it. While the breaker is open, incoming batches fail without a write. After the cool-down window, writes resume and the failure counter resets."},"5885":{"id":"/docs/connectors/sinks/influxdb-77","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#reliability","content":"The runtime records a plugin error and continues polling with consumer auto-commit. Failed chunks and batches skipped by the circuit breaker are not queued for replay, so retries and the circuit breaker do not provide an end-to-end at-least-once guarantee. Other chunks from the same batch may already have reached InfluxDB."},"5886":{"id":"/docs/connectors/sinks/influxdb-78","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#transforms","content":"Transforms can be applied before writing to InfluxDB. See the transforms documentation for the available types and their configuration."},"5887":{"id":"/docs/connectors/sinks/meilisearch","page_id":"/docs/connectors/sinks/meilisearch","type":"page","content":"Meilisearch Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/meilisearch"},"5888":{"id":"/docs/connectors/sinks/meilisearch-0","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch","content":"Index messages from Iggy streams as documents in a Meilisearch index through the official Rust SDK."},"5889":{"id":"/docs/connectors/sinks/meilisearch-1","page_id":"/docs/connectors/sinks/meilisearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/meilisearch#configuration","content":"Configuration"},"5890":{"id":"/docs/connectors/sinks/meilisearch-2","page_id":"/docs/connectors/sinks/meilisearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/meilisearch#common-options","content":"Common Options"},"5891":{"id":"/docs/connectors/sinks/meilisearch-3","page_id":"/docs/connectors/sinks/meilisearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/meilisearch#document-mapping","content":"Document Mapping"},"5892":{"id":"/docs/connectors/sinks/meilisearch-4","page_id":"/docs/connectors/sinks/meilisearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/meilisearch#delivery-semantics","content":"Delivery Semantics"},"5893":{"id":"/docs/connectors/sinks/meilisearch-5","page_id":"/docs/connectors/sinks/meilisearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/meilisearch#transforms","content":"Transforms"},"5894":{"id":"/docs/connectors/sinks/meilisearch-6","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch","content":"The Meilisearch sink connector consumes messages from Iggy streams and indexes them as documents in a Meilisearch index through the official Rust SDK. It can create the index on startup and waits for Meilisearch indexing tasks to complete by default, so task failures surface as connector errors."},"5895":{"id":"/docs/connectors/sinks/meilisearch-7","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch","content":"This page is a curated subset of the documentation. The canonical reference is the upstream meilisearch_sink README in the apache/iggy repository."},"5896":{"id":"/docs/connectors/sinks/meilisearch-8","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.10.0 repository root, build the plugin:"},"5897":{"id":"/docs/connectors/sinks/meilisearch-9","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#configuration","content":"Save this connector file in the runtime's connector directory. Replace the URL and API key with your Meilisearch endpoint and credentials. The key needs permission to inspect the index, submit documents and read tasks, plus create the index when needed. Startup checks health, checks the index, and waits for index creation to succeed even when wait_for_tasks = false. Set primary_key to match an existing index. A mismatch only produces a startup warning. The connector does not change the index key, and document tasks can fail."},"5898":{"id":"/docs/connectors/sinks/meilisearch-10","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#configuration","content":"Create the Iggy resources and send a document:"},"5899":{"id":"/docs/connectors/sinks/meilisearch-11","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"Option"},"5900":{"id":"/docs/connectors/sinks/meilisearch-12","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"Type"},"5901":{"id":"/docs/connectors/sinks/meilisearch-13","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"Default"},"5902":{"id":"/docs/connectors/sinks/meilisearch-14","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"Description"},"5903":{"id":"/docs/connectors/sinks/meilisearch-15","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"url"},"5904":{"id":"/docs/connectors/sinks/meilisearch-16","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"string"},"5905":{"id":"/docs/connectors/sinks/meilisearch-17","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"required"},"5906":{"id":"/docs/connectors/sinks/meilisearch-18","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearc