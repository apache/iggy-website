:"/docs/cli/commands-103","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#snapshot","content":"Description"},"1311":{"id":"/docs/cli/commands-104","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#snapshot","content":"-c, --compression <TYPE>"},"1312":{"id":"/docs/cli/commands-105","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#snapshot","content":"stored, deflated, bzip2, zstd, lzma, xz"},"1313":{"id":"/docs/cli/commands-106","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#snapshot","content":"-s, --snapshot-types <TYPES>"},"1314":{"id":"/docs/cli/commands-107","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#snapshot","content":"Space-separated subset of filesystem_overview, process_list, resource_usage, test, server_logs, server_config, all"},"1315":{"id":"/docs/cli/commands-108","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#snapshot","content":"-o, --out-dir <DIR>"},"1316":{"id":"/docs/cli/commands-109","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#snapshot","content":"Output directory for the snapshot file"},"1317":{"id":"/docs/cli/commands-110","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#login-logout-session","content":"Manage login sessions backed by the platform keyring. iggy login [EXPIRY] stores a session token (default expiry: 15 minutes, none disables expiry), iggy logout removes it, and iggy session status reports whether a token exists locally. See login sessions for the full flow."},"1318":{"id":"/docs/cli/start","page_id":"/docs/cli/start","type":"page","content":"Iggy CLI","breadcrumbs":["Documentation","CLI"],"tags":[],"url":"/docs/cli/start"},"1319":{"id":"/docs/cli/start-0","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start","content":"Install the Iggy CLI, 