stering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"core/simulator"},"1609":{"id":"/docs/clustering/vsr-36","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"Deterministic failures, delays, and network partitions"},"1610":{"id":"/docs/clustering/vsr-37","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"Rust SDK"},"1611":{"id":"/docs/clustering/vsr-38","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"core/sdk"},"1612":{"id":"/docs/clustering/vsr-39","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"VSR framing, sessions, retries, and leader redirection"},"1613":{"id":"/docs/clustering/vsr-40","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Iggy splits replication by namespace:"},"1614":{"id":"/docs/clustering/vsr-41","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Plane"},"1615":{"id":"/docs/clustering/vsr-42","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Consensus group"},"1616":{"id":"/docs/clustering/vsr-43","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Replicated work"},"1617":{"id":"/docs/clustering/vsr-44","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Metadata"},"1618":{"id":"/docs/clustering/vsr-45","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"One group on shard 0"},"1619":{"id":"/docs/clustering/vsr-46","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Streams, topics, users, permissions, consumer groups, and access tokens"},"1620":{"id":"/docs/clustering/vsr-47","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Partition"},"1621":{"id":"/docs/clustering/vsr-48","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"One group per partition"},"1622":{"id":"/docs/clustering/vsr-49","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Messages and consumer offsets"},"1623":{"id":"/docs/clustering/vsr-50","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Each group can have a different primary. Metadata writes route through the metadata primary. Partition writes route through the primary for that partition."},"1624":{"id":"/docs/clustering/vsr-51","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Reads use the local replicated state where possible. Writes return after the required VSR commit or return a retryable error when the replica is changing view or catching up. See Client failover for how the SDKs handle both."},"1625":{"id":"/docs/clustering/vsr-52","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#failure-handling","content":"VSR uses three main flows:"},"1626":{"id":"/docs/clustering/vsr-53","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#failure-handling","content":"Normal operation: the primary assigns an operation number, sends Prepare, and commits after a quorum sends PrepareOk."},"1627":{"id":"/docs/clustering/vsr-54","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#failure-handling","content":"View change: replicas exchange StartViewChange and DoViewChange, then the new primary sends StartView."},"1628":{"id":"/docs/clustering/vsr-55","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#failure-handling","content":"Recovery: a restarted or lagging replica requests the current view and repairs missing WAL ranges before serving current state."},"1629":{"id":"/docs/clustering/vsr-56","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#failure-handling","content":"A cluster of 2f + 1 replicas tolerates f unavailable replicas. Use at least three replicas for one-node fault tolerance. A two-node cluster is useful for development, but it cannot make progress after either node fails."},"1630":{"id":"/docs/clustering/vsr-57","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#wire-protocol-and-sdks","content":"VSR framing is the only wire protocol. Every SDK (Rust, Go, Java, C#, C++, Node.js, Python) speaks it, and every BDD suite runs against the clustered-capable iggy-server. Clients built before the VSR migration cannot talk to current servers."},"1631":{"id":"/docs/clustering/vsr-58","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#wire-protocol-and-sdks","content":"The Rust SDK needs no feature flags. Depend on the published crate:"},"1632":{"id":"/docs/clustering/vsr-59","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#wire-protocol-and-sdks","content":"or track the repository directly with iggy = { git = \"https://github.com/apache/iggy\" }."},"1633":{"id":"/docs/clustering/vsr-60","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#wire-protocol-and-sdks","content":"The client API is the same in single-node and cluster mode:"},"1634":{"id":"/docs/clustering/vsr-61","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#status","content":"VSR started as a parallel server-ng implementation behind a vsr build feature. That phase is over. The VSR server moved into the mainline core/server crate and the iggy-server binary, the feature flag is gone, and the legacy server and its wire format were deleted. What this page describes is the only server implementation."},"1635":{"id":"/docs/clustering/vsr-62","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#next-steps","content":"Deploy a cluster: build the binaries and run a three-node cluster"},"1636":{"id":"/docs/clustering/vsr-63","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#next-steps","content":"Configuration: every [cluster] setting and its validation rules"},"1637":{"id":"/docs/clustering/vsr-64","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#next-steps","content":"Security: replica authentication, key rotation, and TLS"},"1638":{"id":"/docs/clustering/vsr-65","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#next-steps","content":"Client failover: reads, writes, and leader redirection from the client side"},"1639":{"id":"/docs/connectors/introduction","page_id":"/docs/connectors/introduction","type":"page","content":"Introduction","breadcrumbs":["Documentation","Connectors"],"tags":[],"url":"/docs/connectors/introduction"},"1640":{"id":"/docs/connectors/introduction-0","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction","content":"The connector runtime: dynamically loaded source and sink plugins, how data flows through them, and what ships today."},"1641":{"id":"/docs/connectors/introduction-1","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#architecture","content":"Architecture"},"1642":{"id":"/docs/connectors/introduction-2","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#data-flow","content":"Data Flow"},"1643":{"id":"/docs/connectors/introduction-3","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#available-connectors","content":"Available Connectors"},"1644":{"id":"/docs/connectors/introduction-4","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#transforms","content":"Transforms"},"1645":{"id":"/docs/connectors/introduction-5","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#supported-schemas","content":"Supported Schemas"},"1646":{"id":"/docs/connectors/introduction-6","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#features","content":"Features"},"1647":{"id":"/docs/connectors/introduction-7","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#quick-start","content":"Quick Start"},"1648":{"id":"/docs/connectors/introduction-8","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#configuration","content":"Configuration"},"1649":{"id":"/docs/connectors/introduction-9","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#runtime","content":"Runtime"},"1650":{"id":"/docs/connectors/introduction-10","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#sink","content":"Sink"},"1651":{"id":"/docs/connectors/introduction-11","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#source","content":"Source"},"1652":{"id":"/docs/connectors/introduction-12","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#building-the-connectors","content":"Building the connectors"},"1653":{"id":"/docs/connectors/introduction-13","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#transformations","content":"Transformations"},"1654":{"id":"/docs/connectors/introduction-14","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction","content":"The highly performant and modular runtime for statically typed, yet dynamically loaded connectors. Ingest the data from the external sources and push it further to the Iggy streams, or fetch the data from the Iggy streams and push it further to the external sources. Create your own Rust plugins by simply implementing either the Source or Sink trait and build custom pipelines for the data processing."},"1655":{"id":"/docs/connectors/introduction-15","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction","content":"The docker image is available, and can be fetched via docker pull apache/iggy-connect."},"1656":{"id":"/docs/connectors/introduction-16","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#architecture","content":"Connectors are dynamically loaded shared libraries (.so on Linux, .dylib on macOS, .dll on Windows) loaded at runtime via dlopen2. Data crossing the FFI boundary between the runtime and plugins is serialized using postcard, a compact binary format. Each plugin receives its own Tokio runtime inside the SDK, ensuring isolation."},"1657":{"id":"/docs/connectors/introduction-17","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"The connector runtime operates in two directions - source (ingest) and sink (egress):"},"1658":{"id":"/docs/connectors/introduction-18","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"Key details:"},"1659":{"id":"/docs/connectors/introduction-19","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"Transforms run inside the runtime process, not inside the plugins. They are applied after decoding for sources (before sending to Iggy) and after consuming from Iggy for sinks (before forwarding to the external system)."},"1660":{"id":"/docs/connectors/introduction-20","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"State persistence is file-based (using MessagePack serialization) and applies to source connectors only, tracking the last polled position."},"1661":{"id":"/docs/connectors/introduction-21","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"Consumer groups handle offset tracking for sink connectors automatically, so sinks do not need to manage their own offsets."},"1662":{"id":"/docs/connectors/introduction-22","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"Type"},"1663":{"id":"/docs/connectors/introduction-23","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"Connectors"},"1664":{"id":"/docs/connectors/introduction-24","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"Source"},"1665":{"id":"/docs/connectors/introduction-25","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"Elasticsearch, InfluxDB, PostgreSQL, Random"},"1666":{"id":"/docs/connectors/introduction-26","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"Sink"},"1667":{"id":"/docs/connectors/introduction-27","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"ClickHouse, Delta Lake, Apache Doris, Elasticsearch, HTTP, Apache Iceberg, InfluxDB, Meilisearch, MongoDB, PostgreSQL, Quickwit, S3, Stdout, SurrealDB"},"1668":{"id":"/docs/connectors/introduction-28","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"The following built-in transforms are available:"},"1669":{"id":"/docs/connectors/introduction-29","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"add_fields - add new fields to the message payload."},"1670":{"id":"/docs/connectors/introduction-30","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"delete_fields - remove existing fields from the message payload."},"1671":{"id":"/docs/connectors/introduction-31","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"filter_fields - keep or drop fields based on key and value patterns."},"1672":{"id":"/docs/connectors/introduction-32","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"update_fields - update existing fields with static or computed values such as timestamp_millis or uuid_v7."},"1673":{"id":"/docs/connectors/introduction-33","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"proto_convert - convert messages between Protocol Buffers and other formats."},"1674":{"id":"/docs/connectors/introduction-34","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"flat_buffer_convert - convert messages between FlatBuffers and other formats."},"1675":{"id":"/docs/connectors/introduction-35","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"avro_convert - convert messages between Avro and other formats."},"1676":{"id":"/docs/connectors/introduction-36","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"unwrap_envelope - promote a nested field of a JSON envelope to the top-level payload."},"1677":{"id":"/docs/connectors/introduction-37","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"See the Transforms documentation for the configuration of each transform."},"1678":{"id":"/docs/connectors/introduction-38","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#supported-schemas","content":"Messages can be decoded and encoded using the following formats: JSON, Raw bytes, Text, Protocol Buffers, FlatBuffers, and Avro. For Avro, the schema can be provided per stream via the avro_schema_json or avro_schema_path keys in the [[streams]] section."},"1679":{"id":"/docs/connectors/introduction-39","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"High Performance: Utilizes Rust's performance characteristics to ensure fast data ingestion and egress."},"1680":{"id":"/docs/connectors/introduction-40","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Low memory footprint: Designed with memory efficiency in mind, minimizing the memory footprint of the connectors."},"1681":{"id":"/docs/connectors/introduction-41","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Modular Design: Designed with modularity in mind, allowing for easy extension and customization."},"1682":{"id":"/docs/connectors/introduction-42","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Dynamic Loading: Supports dynamic loading of plugins, allowing integration with various data sources and sinks at runtime."},"1683":{"id":"/docs/connectors/introduction-43","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Statically Typed: Ensures type safety and compile-time checks, reducing runtime errors."},"1684":{"id":"/docs/connectors/introduction-44","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Easy Customization: Provides a simple interface for implementing custom connectors, making it easy to create new plugins."},"1685":{"id":"/docs/connectors/introduction-45","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Data transformation: Supports data transformation with the help of existing functions."},"1686":{"id":"/docs/connectors/introduction-46","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Powerful configuration: Define your sinks, sources, and transformations in the configuration file or fetch them from a remote HTTP API."},"1687":{"id":"/docs/connectors/introduction-47","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Flexible configuration providers: Support for local file-based and HTTP-based configuration providers for centralized configuration management."},"1688":{"id":"/docs/connectors/introduction-48","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Build the project in release mode (or debug, and update the connectors paths in the config accordingly), and make sure that the plugins specified in core/connectors/runtime/example_config/connectors/ directory under path are available. The configuration must be provided in toml format. The example directory also enables connectors for ClickHouse, Delta Lake, Apache Doris, Apache Iceberg, and InfluxDB. Without their backing services (or their compiled plugins) these are reported with the Error status, but they don't block the remaining connectors. Set enabled = false in their files to skip them entirely."},"1689":{"id":"/docs/connectors/introduction-49","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Run docker compose up -d from /examples/rust/src/sink-data-producer which will start the Quickwit server to be used by an example sink connector. At this point, you can access the Quickwit UI at http://localhost:7280 - check this dashboard again later on, after the events index will be created."},"1690":{"id":"/docs/connectors/introduction-50","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Set environment variable IGGY_CONNECTORS_CONFIG_PATH=core/connectors/runtime/example_config/config.toml (adjust the path as needed) pointing to the runtime configuration file."},"1691":{"id":"/docs/connectors/introduction-51","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Start the Iggy server and invoke the following commands via Iggy CLI to create the example streams and topics used by the sample connectors."},"1692":{"id":"/docs/connectors/introduction-52","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Execute cargo run --example sink-data-producer -r which will start the example data producer application, sending the messages to previously created qw stream and records topic (this will be used by the Quickwit sink connector)."},"1693":{"id":"/docs/connectors/introduction-53","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Start the connector runtime cargo run --bin iggy-connectors -r - you should be able to browse Quickwit UI with records being constantly added to the events index. At the same time, you should see the new messages being added to the example_stream stream and example_topic topic by the Random source connector - you can use Iggy Web UI to browse the data. The messages will have applied the basic fields transformations."},"1694":{"id":"/docs/connectors/introduction-54","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#configuration","content":"Overriding the configuration via environment variables follows the same rules as the main Iggy server."},"1695":{"id":"/docs/connectors/introduction-55","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#configuration","content":"You can provide the following envs during the runtime startup:"},"1696":{"id":"/docs/connectors/introduction-56","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#configuration","content":"Any configuration section can be overridden with IGGY_CONNECTORS_ prefix, followed by the section name and the key name, e.g. IGGY_CONNECTORS_IGGY_USERNAME."},"1697":{"id":"/docs/connectors/introduction-57","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#runtime","content":"All the connectors are implemented as Rust libraries and can be used as a part of the connector runtime. The runtime is responsible for managing the lifecycle of the connectors and providing the necessary infrastructure for the connectors to run. For more information, please refer to the runtime documentation."},"1698":{"id":"/docs/connectors/introduction-58","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#sink","content":"Sinks are responsible for consuming the messages from the configured stream(s) and topic(s) and sending them further to the specified destination. For example, the Quickwit sink connector is responsible for sending the messages to the Quickwit indexer."},"1699":{"id":"/docs/connectors/introduction-59","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#sink","content":"Please refer to the Sink documentation for the details about the configuration and the sample implementation."},"1700":{"id":"/docs/connectors/introduction-60","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#sink","content":"When implementing Sink, make sure to use the sink_connector! macro to expose the FFI interface and allow the connector runtime to register the sink with the runtime.\nEach sink should have its own, custom configuration, which is passed along with the unique plugin ID via expected new() method."},"1701":{"id":"/docs/connectors/introduction-61","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#source","content":"Sources are responsible for producing the messages to the configured stream(s) and topic(s). For example, the Random source connector generates random messages that are then sent to the configured stream and topic."},"1702":{"id":"/docs/connectors/introduction-62","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#source","content":"Please refer to the Source documentation for the details about the configuration and the sample implementation."},"1703":{"id":"/docs/connectors/introduction-63","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#building-the-connectors","content":"New connector can be built simply by implementing either Sink or Source trait. Please check the sink or source documentation, as well as the existing examples under /sinks and /sources directories."},"1704":{"id":"/docs/connectors/introduction-64","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transformations","content":"Field transformations (depending on the supported payload formats) can be applied to the messages either before they are sent to the specified topic (e.g. when produced by the source connectors), or before consumed by the sink connectors. To add a new transformation, implement the Transform trait in a new module under the SDK's transforms directory, add a variant to the TransformType enum, and extend its from_config function - the runtime picks it up without any further changes. Each transform may have its own, custom configuration."},"1705":{"id":"/docs/connectors/introduction-65","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transformations","content":"To find out more about the transforms, please refer to the Transforms documentation. For the stream decoders and encoders, see the SDK documentation."},"1706":{"id":"/docs/connectors/observability","page_id":"/docs/connectors/observability","type":"page","content":"Observability","breadcrumbs":["Documentation","Connectors"],"tags":[],"url":"/docs/connectors/observability"},"1707":{"id":"/docs/connectors/observability-0","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability","content":"Logs, Prometheus metrics, the stats endpoint, OpenTelemetry export and per-source state files for the connector runtime."},"1708":{"id":"/docs/connectors/observability-1","page_id":"/docs/connectors/observability","type":"heading","tags":[],"url":"/docs/connectors/observability#logging","content":"Logging"},"1709":{"id":"/docs/connectors/observability-2","page_id":"/docs/connectors/observability","type":"heading","tags":[],"url":"/docs/connectors/observability#prometheus-metrics","content":"Prometheus metrics"},"1710":{"id":"/docs/connectors/observability-3","page_id":"/docs/connectors/observability","type":"heading","tags":[],"url":"/docs/connectors/observability#runtime-stats","content":"Runtime stats"},"1711":{"id":"/docs/connectors/observability-4","page_id":"/docs/connectors/observability","type":"heading","tags":[],"url":"/docs/connectors/observability#opentelemetry","content":"OpenTelemetry"},"1712":{"id":"/docs/connectors/observability-5","page_id":"/docs/connectors/observability","type":"heading","tags":[],"url":"/docs/connectors/observability#state-files","content":"State files"},"1713":{"id":"/docs/connectors/observability-6","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability","content":"The connector runtime exposes its health through logs, Prometheus metrics, a stats endpoint, OpenTelemetry export, and per-source state files."},"1714":{"id":"/docs/connectors/observability-7","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#logging","content":"The runtime logs via the tracing crate. The output format is configured in the [logging] section:"},"1715":{"id":"/docs/connectors/observability-8","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#logging","content":"Two per-connector flags in the connector configuration files add more detail:"},"1716":{"id":"/docs/connectors/observability-9","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#logging","content":"verbose: logs additional per-batch details for the connector."},"1717":{"id":"/docs/connectors/observability-10","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#logging","content":"benchmark: emits per-batch timing events on the iggy_connectors::benchmark tracing target."},"1718":{"id":"/docs/connectors/observability-11","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"Metrics are served by the runtime HTTP API when the [http.metrics] section is enabled (the HTTP API itself is on by default at 127.0.0.1:8081):"},"1719":{"id":"/docs/connectors/observability-12","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"Runtime-level gauges:"},"1720":{"id":"/docs/connectors/observability-13","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connectors_sources_total - configured source connectors."},"1721":{"id":"/docs/connectors/observability-14","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connectors_sources_running - sources in the Running status."},"1722":{"id":"/docs/connectors/observability-15","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connectors_sinks_total - configured sink connectors."},"1723":{"id":"/docs/connectors/observability-16","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connectors_sinks_running - sinks in the Running status."},"1724":{"id":"/docs/connectors/observability-17","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"Per-connector counters, labeled with connector_key and connector_type (source or sink):"},"1725":{"id":"/docs/connectors/observability-18","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connector_messages_produced_total - messages received from a source plugin's poll."},"1726":{"id":"/docs/connectors/observability-19","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connector_messages_sent_total - messages sent to Iggy (source)."},"1727":{"id":"/docs/connectors/observability-20","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connector_messages_consumed_total - messages consumed from Iggy (sink)."},"1728":{"id":"/docs/connectors/observability-21","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connector_messages_processed_total - messages processed and delivered to the sink plugin."},"1729":{"id":"/docs/connectors/observability-22","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connector_messages_filtered_total - messages intentionally dropped by transforms."},"1730":{"id":"/docs/connectors/observability-23","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connector_errors_total - errors encountered."},"1731":{"id":"/docs/connectors/observability-24","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"Per-batch stage timings are recorded in the iggy_connector_stage_duration_seconds histogram, labeled with connector_key, connector_type, and stage (prepare, ffi, decode, iggy_send, state_save, total), with buckets ranging from 50 microseconds to 5 seconds."},"1732":{"id":"/docs/connectors/observability-25","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#runtime-stats","content":"GET /stats on the HTTP API returns a JSON snapshot of the runtime: version, process ID, CPU and memory usage (cgroup-aware in containers), uptime, the source/sink totals, and a connectors array with per-connector details - key, name, type, plugin version, enabled, message counters, error count, and the current status."},"1733":{"id":"/docs/connectors/observability-26","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#runtime-stats","content":"The connector statuses are Starting, Running, Stopping, Stopped, and Error. A connector whose plugin fails to load (missing library, bad configuration) is reported with the Error status and the failure message, without blocking the remaining connectors."},"1734":{"id":"/docs/connectors/observability-27","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#opentelemetry","content":"The [telemetry] section enables OTLP export of logs and traces:"},"1735":{"id":"/docs/connectors/observability-28","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#state-files","content":"Source connectors can persist their position (see the SDK documentation) into the directory configured in the [state] section:"},"1736":{"id":"/docs/connectors/observability-29","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#state-files","content":"Each source gets one file named source_{key}.state (e.g. local_state/source_random.state) holding the raw state bytes - by convention MessagePack produced by the SDK helpers. Sinks have no state files. Their progress lives in Iggy consumer groups."},"1737":{"id":"/docs/connectors/observability-30","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#state-files","content":"The write is crash-safe: the state is written and fsynced to a .tmp file, atomically renamed over the previous file, and the directory entry is fsynced. Files are created with owner-only permissions (0600), since state may carry cursors or tokens. An empty or missing state file means the source starts fresh - deleting a state file resets that source's position."},"1738":{"id":"/docs/connectors/runtime","page_id":"/docs/connectors/runtime","type":"page","content":"Runtime","breadcrumbs":["Documentation","Connectors"],"tags":[],"url":"/docs/connectors/runtime"},"1739":{"id":"/docs/connectors/runtime-0","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"How the connector runtime loads plugins, resolves its configuration, and manages connector lifecycles."},"1740":{"id":"/docs/connectors/runtime-1","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"How configuration is resolved"},"1741":{"id":"/docs/connectors/runtime-2","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"How plugins are resolved"},"1742":{"id":"/docs/connectors/runtime-3","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#minimal-configuration","content":"Minimal configuration"},"1743":{"id":"/docs/connectors/runtime-4","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#configuration-providers","content":"Configuration Providers"},"1744":{"id":"/docs/connectors/runtime-5","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#local-file-provider","content":"Local File Provider"},"1745":{"id":"/docs/connectors/runtime-6","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#http-configuration-provider","content":"HTTP Configuration Provider"},"1746":{"id":"/docs/connectors/runtime-7","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#configuration-options","content":"Configuration Options"},"1747":{"id":"/docs/connectors/runtime-8","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#default-url-templates","content":"Default URL Templates"},"1748":{"id":"/docs/connectors/runtime-9","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#http-api","content":"HTTP API"},"1749":{"id":"/docs/connectors/runtime-10","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"Runtime is responsible for managing the lifecycle of the connectors and providing the necessary infrastructure for the connectors to run."},"1750":{"id":"/docs/connectors/runtime-11","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"The runtime uses a shared Tokio runtime to manage the asynchronous tasks and events across all connectors. Additionally, it has built-in support for logging via tracing crate."},"1751":{"id":"/docs/connectors/runtime-12","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"The connector are implemented as Rust libraries, and these are loaded dynamically during the runtime initialization process."},"1752":{"id":"/docs/connectors/runtime-13","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"Internally, dlopen2 provides a safe and efficient way of loading the plugins via C FFI."},"1753":{"id":"/docs/connectors/runtime-14","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"By default, runtime will look for the configuration file, to decide which connectors to load and how to configure them."},"1754":{"id":"/docs/connectors/runtime-15","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"To start the connector runtime, simply run cargo run --bin iggy-connectors."},"1755":{"id":"/docs/connectors/runtime-16","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"The docker image is available, and can be fetched via docker pull apache/iggy-connect."},"1756":{"id":"/docs/connectors/runtime-17","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"The configuration file path defaults to core/connectors/runtime/config.toml and can be overridden by the IGGY_CONNECTORS_CONFIG_PATH environment variable."},"1757":{"id":"/docs/connectors/runtime-18","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"A default configuration is embedded in the binary and always merged as the base, so every section has sane defaults even when the file omits it."},"1758":{"id":"/docs/connectors/runtime-19","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"On startup the runtime loads environment variables from a .env file in the working directory, or from the file pointed to by IGGY_CONNECTORS_ENV_PATH."},"1759":{"id":"/docs/connectors/runtime-20","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"Each configuration key can be additionally overridden by an environment variable using the IGGY_CONNECTORS_<SECTION>_<KEY> convention (nested keys joined by underscores), e.g. IGGY_CONNECTORS_IGGY_USERNAME or IGGY_CONNECTORS_HTTP_ADDRESS."},"1760":{"id":"/docs/connectors/runtime-21","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"The path field of a connector configuration accepts both plugin.so and plugin - the OS-specific extension (.so / .dylib / .dll) is appended when missing. Absolute paths are checked at the literal location. Relative paths are searched in order:"},"1761":{"id":"/docs/connectors/runtime-22","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"Literal path (relative to the working directory)"},"1762":{"id":"/docs/connectors/runtime-23","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"Directory of the runtime binary"},"1763":{"id":"/docs/connectors/runtime-24","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"Current working directory (filename only)"},"1764":{"id":"/docs/connectors/runtime-25","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"/usr/lib, /usr/lib64, /lib, /lib64, /usr/local/lib, /usr/local/lib64"},"1765":{"id":"/docs/connectors/runtime-26","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"A connector whose plugin cannot be resolved or loaded is surfaced with the Error status via the HTTP API instead of blocking the remaining connectors."},"1766":{"id":"/docs/connectors/runtime-27","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#minimal-configuration","content":"The minimal viable configuration requires at least the Iggy credentials to create 2 separate instances of producer & consumer connections, the state directory path where source connectors can store their optional state, and the connectors configuration provider settings."},"1767":{"id":"/docs/connectors/runtime-28","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#minimal-configuration","content":"Beyond these sections, the runtime configuration also supports [http] for the HTTP API (see below), and [telemetry], [logging], and [http.metrics] covered on the Observability page."},"1768":{"id":"/docs/connectors/runtime-29","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-providers","content":"The runtime supports two types of configuration providers for managing connector configurations:"},"1769":{"id":"/docs/connectors/runtime-30","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#local-file-provider","content":"The default configuration provider reads connector configurations from local files. Each connector (source or sink) is configured in its own separate file within the directory specified by connectors.config_dir. An empty config_dir is a fatal startup error. A missing directory is created automatically with a warning, and no connectors are loaded from it."},"1770":{"id":"/docs/connectors/runtime-31","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#local-file-provider","content":"Additional mechanics of the local provider:"},"1771":{"id":"/docs/connectors/runtime-32","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#local-file-provider","content":"Only *.toml files are loaded - hidden files (starting with .) and Cargo.toml are skipped."},"1772":{"id":"/docs/connectors/runtime-33","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#local-file-provider","content":"Multiple files sharing the same connector key form a version history (each file carries its own version). The active version of each connector is persisted in {config_dir}/.active_versions.toml and can be switched via the HTTP API."},"1773":{"id":"/docs/connectors/runtime-34","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#local-file-provider","content":"Individual plugin_config fields can be overridden per connector via environment variables using the IGGY_CONNECTORS_{SINK|SOURCE}_{KEY}_PLUGIN_CONFIG_<FIELD> convention, e.g. IGGY_CONNECTORS_SINK_QUICKWIT_PLUGIN_CONFIG_URL."},"1774":{"id":"/docs/connectors/runtime-35","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-configuration-provider","content":"The HTTP configuration provider allows the runtime to fetch connector configurations from a remote HTTP/REST API. This enables centralized configuration management and dynamic configuration updates."},"1775":{"id":"/docs/connectors/runtime-36","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"base_url (required): Base URL of the configuration API endpoint"},"1776":{"id":"/docs/connectors/runtime-37","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"timeout (optional): HTTP request timeout (default: 10s)"},"1777":{"id":"/docs/connectors/runtime-38","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"request_headers (optional): Custom headers to include in all HTTP requests (e.g., authentication headers)"},"1778":{"id":"/docs/connectors/runtime-39","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"url_templates (optional): Custom URL templates for API endpoints. Supports variable substitution with {key} and {version} placeholders."},"1779":{"id":"/docs/connectors/runtime-40","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"response.data_path (optional): JSON path to extract response data from nested structures (e.g., \"data.config\")"},"1780":{"id":"/docs/connectors/runtime-41","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"response.error_path (optional): JSON path to check for errors in responses"},"1781":{"id":"/docs/connectors/runtime-42","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"If not customized, the HTTP provider uses the following RESTful URL patterns:"},"1782":{"id":"/docs/connectors/runtime-43","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Create sink config: POST {base_url}/sinks/{key}/configs"},"1783":{"id":"/docs/connectors/runtime-44","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Create source config: POST {base_url}/sources/{key}/configs"},"1784":{"id":"/docs/connectors/runtime-45","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get active configs: GET {base_url}/configs/active"},"1785":{"id":"/docs/connectors/runtime-46","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get active versions: GET {base_url}/configs/active/versions"},"1786":{"id":"/docs/connectors/runtime-47","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Set active sink version: PUT {base_url}/sinks/{key}/configs/active"},"1787":{"id":"/docs/connectors/runtime-48","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/co