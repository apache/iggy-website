4122":{"id":"/docs/server/configuration-504","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"Safety tick for the partition reconciliation loop, which also wakes on every metadata commit."},"4123":{"id":"/docs/server/configuration-505","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"Valid cpu_allocation syntaxes:"},"4124":{"id":"/docs/server/configuration-506","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"\"all\": one shard per available CPU core"},"4125":{"id":"/docs/server/configuration-507","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"a number, e.g. 4: four shards on the first four CPUs in the process's allowed set when pin_cores is enabled"},"4126":{"id":"/docs/server/configuration-508","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"a range, e.g. \"5..8\": three shards on cores 5, 6, 7"},"4127":{"id":"/docs/server/configuration-509","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"\"numa:auto\": all NUMA nodes and cores, NUMA-aware"},"4128":{"id":"/docs/server/configuration-510","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#sharding","content":"\"numa:nodes=0,1;cores=4;no_ht=true\": NUMA nodes 0 and 1, four cores each, no hyperthreads"},"4129":{"id":"/docs/server/configuration-511","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"Tunables for the metadata consensus plane (shard 0's VSR replica: users, streams, topics, sessions)."},"4130":{"id":"/docs/server/configuration-512","page_id":"/docs/server/configuration","tags":[],"typ