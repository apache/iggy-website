rs/sinks/clickhouse-29","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"string"},"3890":{"id":"/docs/connectors/sinks/clickhouse-30","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"\"\""},"3891":{"id":"/docs/connectors/sinks/clickhouse-31","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"ClickHouse password"},"3892":{"id":"/docs/connectors/sinks/clickhouse-32","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"insert_format"},"3893":{"id":"/docs/connectors/sinks/clickhouse-33","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"string"},"3894":{"id":"/docs/connectors/sinks/clickhouse-34","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"json_each_row"},"3895":{"id":"/docs/connectors/sinks/clickhouse-35","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"json_each_row, row_binary, or string"},"3896":{"id":"/docs/connectors/sinks/clickhouse-36","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"string_format"},"3897":{"id":"/docs/connectors/sinks/clickhouse-37","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"string"},"3898":{"id":"/docs/connectors/sinks/clickhouse-38","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"json_each_row"},"3899":{"id":"/docs/connectors/sinks/clickhouse-39","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"ClickHouse format for string mode: json_each_row, csv, or tsv"},"3900":{"id":"/docs/connectors/sinks/clickhouse-40","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"timeout_seconds"},"3901":{"id":"/docs/connectors/sinks/clickhouse-41","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"u64"},"3902":{"id":"/docs/connectors/sinks/clickhouse-42","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"30"},"3903":{"id":"/docs/connectors/sinks/clickhouse-43","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"HTTP request timeout"},"3904":{"id":"/docs/connectors/sinks/clickhouse-44","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"max_retries"},"3905":{"id":"/docs/connectors/sinks/clickhouse-45","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"u32"},"3906":{"id":"/docs/connectors/sinks/clickhouse-46","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"3"},"3907":{"id":"/docs/connectors/sinks/clickhouse-47","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"Total insert attempts on transient errors"},"3908":{"id":"/docs/connectors/sinks/clickhouse-48","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"retry_delay"},"3909":{"id":"/docs/connectors/sinks/clickhouse-49","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"u64"},"3910":{"id":"/docs/connectors/sinks/clickhouse-50","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"1"},"3911":{"id":"/docs/connectors/sinks/clickhouse-51","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"Delay between retries, in seconds"},"3912":{"id":"/docs/connectors/sinks/clickhouse-52","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"verbose_logging"},"3913":{"id":"/docs/connectors/sinks/clickhouse-53","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"bool"},"3914":{"id":"/docs/connectors/sinks/clickhouse-54","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"false"},"3915":{"id":"/docs/connectors/sinks/clickhouse-55","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"Log inserts at info level instead of debug"},"3916":{"id":"/docs/connectors/sinks/clickhouse-56","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"json_each_row (default): accepts JSON payloads. Each message is sent as one JSON object per line using ClickHouse's JSONEachRow format. ClickHouse coerces JSON values to the column types, so the table can have any schema."},"3917":{"id":"/docs/connectors/sinks/clickhouse-57","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"row_binary: accepts JSON payloads and serializes them to ClickHouse's RowBinaryWithDefaults binary format, which is more efficient than JSON at high volume. The table must already exist. Its schema is fetched from system.columns and validated at startup. Requires ClickHouse 23.7 or newer. Columns with a DEFAULT expression may be omitted from messages. MATERIALIZED, ALIAS, and EPHEMERAL columns are dropped from the schema. Unsupported column types (128/256-bit integers, Variant, native JSON, geo types) cause startup to fail."},"3918":{"id":"/docs/connectors/sinks/clickhouse-58","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"string: accepts text payloads and passes them through unchanged. Use string_format to tell ClickHouse which format the payload is in (csv, tsv, or json_each_row)."},"3919":{"id":"/docs/connectors/sinks/clickhouse-59","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"In row_binary mode the schema is captured once at startup and the insert stream is positional. An ALTER TABLE on the target while the connector runs can silently corrupt inserted rows, so restart the connector after any schema change. The self-describing json_each_row format (including string mode with string_format = \"json_each_row\") maps values by field name and tolerates schema changes. string passthrough with csv or tsv sends plain positional ClickHouse formats mapped by the current table column order."},"3920":{"id":"/docs/connectors/sinks/clickhouse-60","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#error-handling--delivery-semantics","content":"Failed inserts are attempted up to max_retries total times with exponential backoff and full jitter, starting from retry_delay. A message whose payload type doesn't match the chosen format is skipped with an error log and the rest of the batch is still sent, in every mode. In row_binary mode there is an additional failure class: a JSON row whose values cannot be converted to the column types fails the whole batch (a half-written binary row would corrupt the rows after it)."},"3921":{"id":"/docs/connectors/sinks/clickhouse-61","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#error-handling--delivery-semantics","content":"Delivery is at-least-once: retries resend the full batch without an insert_deduplication_token, so a lost acknowledgement can insert the same rows twice. ReplicatedMergeTree tables suppress duplicates via implicit block-level deduplication in the common retry case. Plain MergeTree tables store them. If duplicates matter, deduplicate at the table engine or query level as described in the upstream clickhouse_sink README."},"3922":{"id":"/docs/connectors/sinks/clickhouse-62","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#transforms","content":"Transforms can be applied before inserting into ClickHouse. See the transforms documentation for the available types and their configuration."},"3923":{"id":"/docs/connectors/sinks/delta","page_id":"/docs/connectors/sinks/delta","type":"page","content":"Delta Lake Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/delta"},"3924":{"id":"/docs/connectors/sinks/delta-0","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta","content":"Write messages from Iggy streams into Delta Lake tables on local disk, S3, Azure Blob Storage or Google Cloud Storage."},"3925":{"id":"/docs/connectors/sinks/delta-1","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#configuration","content":"Configuration"},"3926":{"id":"/docs/connectors/sinks/delta-2","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#options","content":"Options"},"3927":{"id":"/docs/connectors/sinks/delta-3","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#s3-example","content":"S3 example"},"3928":{"id":"/docs/connectors/sinks/delta-4","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#type-coercion","content":"Type Coercion"},"3929":{"id":"/docs/connectors/sinks/delta-5","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#batching--transactions","content":"Batching & Transactions"},"3930":{"id":"/docs/connectors/sinks/delta-6","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#transforms","content":"Transforms"},"3931":{"id":"/docs/connectors/sinks/delta-7","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta","content":"The Delta Lake sink connector consumes messages from Iggy streams and writes them to Delta Lake tables on the local filesystem, AWS S3, Azure Blob Storage, or Google Cloud Storage. Each batch is flushed and committed as one atomic Delta transaction."},"3932":{"id":"/docs/connectors/sinks/delta-8","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta","content":"This page is a curated subset of the documentation. The canonical reference is the upstream delta_sink README in the apache/iggy repository."},"3933":{"id":"/docs/connectors/sinks/delta-9","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#configuration","content":"The target Delta table must already exist at table_uri: the connector opens it at startup and fails if it's missing. It doesn't create tables. Only JSON payloads are supported (schema = \"json\" on the stream). A batch containing another payload type fails."},"3934":{"id":"/docs/connectors/sinks/delta-10","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Option"},"3935":{"id":"/docs/connectors/sinks/delta-11","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Type"},"3936":{"id":"/docs/connectors/sinks/delta-12","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Default"},"3937":{"id":"/docs/connectors/sinks/delta-13","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Description"},"3938":{"id":"/docs/connectors/sinks/delta-14","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"table_uri"},"3939":{"id":"/docs/connectors/sinks/delta-15","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"string"},"3940":{"id":"/docs/connectors/sinks/delta-16","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"required"},"3941":{"id":"/docs/connectors/sinks/delta-17","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Path or URI of the Delta table: file://, s3://, az://, or gs://"},"3942":{"id":"/docs/connectors/sinks/delta-18","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"storage_backend_type"},"3943":{"id":"/docs/connectors/sinks/delta-19","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"string"},"3944":{"id":"/docs/connectors/sinks/delta-20","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"none"},"3945":{"id":"/docs/connectors/sinks/delta-21","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"s3, azure, or gcs. Omit for local filesystem tables"},"3946":{"id":"/docs/connectors/sinks/delta-22","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Each backend has its own credential options, required when storage_backend_type selects it:"},"3947":{"id":"/docs/connectors/sinks/delta-23","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"S3: aws_s3_access_key, aws_s3_secret_key, aws_s3_region, aws_s3_endpoint_url (for S3-compatible stores like MinIO), aws_s3_allow_http (default false, for local development)."},"3948":{"id":"/docs/connectors/sinks/delta-24","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Azure: azure_storage_account_name, azure_container_name, and either azure_storage_account_key or azure_storage_sas_token (not both)."},"3949":{"id":"/docs/connectors/sinks/delta-25","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"GCS: gcs_service_account_key (the service account JSON as a string, with the bucket taken from the gs:// URI)."},"3950":{"id":"/docs/connectors/sinks/delta-26","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"JSON values are coerced to the Delta table schema before writing:"},"3951":{"id":"/docs/connectors/sinks/delta-27","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"Timestamp columns: ISO 8601 / RFC 3339 strings (e.g. \"2021-11-11T22:11:58Z\") are converted to microsecond timestamps. Numeric timestamps pass through."},"3952":{"id":"/docs/connectors/sinks/delta-28","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"String columns: non-string values are converted to their string representation."},"3953":{"id":"/docs/connectors/sinks/delta-29","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"Coercions apply recursively to nested structs and arrays."},"3954":{"id":"/docs/connectors/sinks/delta-30","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"The table schema is captured once at startup and not refreshed, so restart the connector after changing it."},"3955":{"id":"/docs/connectors/sinks/delta-31","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#batching--transactions","content":"Every poll batch is written to Parquet buffers and committed to the Delta log as a single transaction. The stream's batch_length therefore controls Delta commit granularity: small batches produce many small files and table versions, so prefer larger batches for production tables (and compact periodically). There is no retry on failed writes. A failed batch surfaces as a connector error."},"3956":{"id":"/docs/connectors/sinks/delta-32","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#transforms","content":"Transforms can be applied before writing to Delta Lake. See the transforms documentation for the available types and their configuration."},"3957":{"id":"/docs/connectors/sinks/doris","page_id":"/docs/connectors/sinks/doris","type":"page","content":"Apache Doris Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/doris"},"3958":{"id":"/docs/connectors/sinks/doris-0","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris","content":"Load JSON messages from Iggy streams into a pre-created Apache Doris table through the Stream Load HTTP API."},"3959":{"id":"/docs/connectors/sinks/doris-1","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#configuration","content":"Configuration"},"3960":{"id":"/docs/connectors/sinks/doris-2","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#common-options","content":"Common Options"},"3961":{"id":"/docs/connectors/sinks/doris-3","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#output-formats","content":"Output Formats"},"3962":{"id":"/docs/connectors/sinks/doris-4","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#delivery-semantics","content":"Delivery Semantics"},"3963":{"id":"/docs/connectors/sinks/doris-5","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#security-notes","content":"Security Notes"},"3964":{"id":"/docs/connectors/sinks/doris-6","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#transforms","content":"Transforms"},"3965":{"id":"/docs/connectors/sinks/doris-7","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris","content":"The Apache Doris sink connector consumes JSON messages from Iggy streams and writes them to a pre-created Doris table via Doris's Stream Load HTTP API. Batches are loaded under deterministic labels so that in-request retries deduplicate instead of doubling rows."},"3966":{"id":"/docs/connectors/sinks/doris-8","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris","content":"This page is a curated subset of the documentation. The canonical reference, including the label scheme, redirect security model, and operational guidance, is the upstream doris_sink README in the apache/iggy repository."},"3967":{"id":"/docs/connectors/sinks/doris-9","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#configuration","content":"The target database and table must be pre-created. The connector never issues DDL. database and table must match [A-Za-z0-9_]+ or startup fails. Streams must use schema = \"json\"."},"3968":{"id":"/docs/connectors/sinks/doris-10","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Option"},"3969":{"id":"/docs/connectors/sinks/doris-11","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Type"},"3970":{"id":"/docs/connectors/sinks/doris-12","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Default"},"3971":{"id":"/docs/connectors/sinks/doris-13","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Description"},"3972":{"id":"/docs/connectors/sinks/doris-14","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"fe_url"},"3973":{"id":"/docs/connectors/sinks/doris-15","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"3974":{"id":"/docs/connectors/sinks/doris-16","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"required"},"3975":{"id":"/docs/connectors/sinks/doris-17","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Doris frontend HTTP base URL, e.g. http://localhost:8030"},"3976":{"id":"/docs/connectors/sinks/doris-18","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"database"},"3977":{"id":"/docs/connectors/sinks/doris-19","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"3978":{"id":"/docs/connectors/sinks/doris-20","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"required"},"3979":{"id":"/docs/connectors/sinks/doris-21","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Target database, [A-Za-z0-9_]+"},"3980":{"id":"/docs/connectors/sinks/doris-22","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"table"},"3981":{"id":"/docs/connectors/sinks/doris-23","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"3982":{"id":"/docs/connectors/sinks/doris-24","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"required"},"3983":{"id":"/docs/connectors/sinks/doris-25","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Target table, [A-Za-z0-9_]+"},"3984":{"id":"/docs/connectors/sinks/doris-26","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"username"},"3985":{"id":"/docs/connectors/sinks/doris-27","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"3986":{"id":"/docs/connectors/sinks/doris-28","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"required"},"3987":{"id":"/docs/connectors/sinks/doris-29","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Doris user with LOAD_PRIV on the table"},"3988":{"id":"/docs/connectors/sinks/doris-30","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"password"},"3989":{"id":"/docs/connectors/sinks/doris-31","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"3990":{"id":"/docs/connectors/sinks/doris-32","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"required"},"3991":{"id":"/docs/connectors/sinks/doris-33","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Doris user password, never logged"},"3992":{"id":"/docs/connectors/sinks/doris-34","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"batch_size"},"3993":{"id":"/docs/connectors/sinks/doris-35","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"u32"},"3994":{"id":"/docs/connectors/sinks/doris-36","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"1000"},"3995":{"id":"/docs/connectors/sinks/doris-37","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Maximum messages per Stream Load request"},"3996":{"id":"/docs/connectors/sinks/doris-38","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"output_format"},"3997":{"id":"/docs/connectors/sinks/doris-39","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"3998":{"id":"/docs/connectors/sinks/doris-40","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"json"},"3999":{"id":"/docs/connectors/sinks/doris-41","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"json or csv; CSV is opt-in for throughput and requires columns"},"4000":{"id":"/docs/connectors/sinks/doris-42","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"columns"},"4001":{"id":"/docs/connectors/sinks/doris-43","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"4002":{"id":"/docs/connectors/sinks/doris-44","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"unset"},"4003":{"id":"/docs/connectors/sinks/doris-45","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Forwarded as the columns Stream Load header; pins column order for CSV"},"4004":{"id":"/docs/connectors/sinks/doris-46","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"timeout"},"4005":{"id":"/docs/connectors/sinks/doris-47","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"4006":{"id":"/docs/connectors/sinks/doris-48","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"30s"},"4007":{"id":"/docs/connectors/sinks/doris-49","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Per-request HTTP timeout"},"4008":{"id":"/docs/connectors/sinks/doris-50","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"max_retries"},"4009":{"id":"/docs/connectors/sinks/doris-51","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"u32"},"4010":{"id":"/docs/connectors/sinks/doris-52","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"3"},"4011":{"id":"/docs/connectors/sinks/doris-53","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Total Stream Load attempts per batch on transient failures"},"4012":{"id":"/docs/connectors/sinks/doris-54","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Further options cover the label prefix, connect timeout, retry backoff (retry_delay, max_retry_delay), max_filter_ratio, a where filter, and redirect security (allow_insecure_redirect, allowed_redirect_hosts). See the upstream doris_sink README for the full table with defaults."},"4013":{"id":"/docs/connectors/sinks/doris-55","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#output-formats","content":"json (default): payloads are sent as a JSON array with strip_outer_array: true. Values map to columns by name, so the JSON shape must match the table (use columns if the JSON field names differ from the table columns or you need derived expressions)."},"4014":{"id":"/docs/connectors/sinks/doris-56","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#output-formats","content":"csv: opt-in for throughput. Doris CSV is positional, so output_format = \"csv\" requires columns to pin the column order. Startup fails without it. Rows are framed with control-character separators and quoted with enclose/escape, so embedded commas and newlines are safe. JSON null and missing keys become SQL NULL, and nested objects or arrays are stringified as JSON."},"4015":{"id":"/docs/connectors/sinks/doris-57","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#delivery-semantics","content":"Each batch is loaded under a deterministic label derived from the stream, topic, partition, and offset range. Transient failures (HTTP 5xx/408/429, transport errors) are retried in-request with exponential backoff and jitter under the same label, which Doris deduplicates, so an ambiguous success is absorbed rather than doubled. Permanent errors (4xx, Fail status, malformed responses) are never retried."},"4016":{"id":"/docs/connectors/sinks/doris-58","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#delivery-semantics","content":"The runtime commits consumer offsets at poll time and doesn't inspect consume()'s return value, so delivery is at-most-once across polls: a failure that outlives the retry budget, or a crash mid-load, is not replayed. Keep batch_size stable across a manual redrive, since changing it shifts chunk boundaries and defeats label deduplication."},"4017":{"id":"/docs/connectors/sinks/doris-59","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#security-notes","content":"Use https:// for fe_url in production: credentials travel as HTTP Basic auth."},"4018":{"id":"/docs/connectors/sinks/doris-60","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#security-notes","content":"The connector preserves the Authorization header across the Doris FE-to-BE 307 redirect, validating the target first: scheme downgrades are refused unless allow_insecure_redirect = true, and allowed_redirect_hosts can pin redirects to known backend endpoints."},"4019":{"id":"/docs/connectors/sinks/doris-61","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#security-notes","content":"columns and where are forwarded verbatim to Doris and evaluated as SQL expressions. Keep this config trusted."},"4020":{"id":"/docs/connectors/sinks/doris-62","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#transforms","content":"Transforms can be applied before loading into Doris. See the transforms documentation for the available types and their configuration."},"4021":{"id":"/docs/connectors/sinks/elasticsearch","page_id":"/docs/connectors/sinks/elasticsearch","type":"page","content":"Elasticsearch Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/elasticsearch"},"4022":{"id":"/docs/connectors/sinks/elasticsearch-0","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch","content":"Index messages from Iggy streams into an Elasticsearch index using the bulk API."},"4023":{"id":"/docs/connectors/sinks/elasticsearch-1","page_id":"/docs/connectors/sinks/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/elasticsearch#configuration","content":"Configuration"},"4024":{"id":"/docs/connectors/sinks/elasticsearch-2","page_id":"/docs/connectors/sinks/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"Plugin config options"},"4025":{"id":"/docs/connectors/sinks/elasticsearch-3","page_id":"/docs/connectors/sinks/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/elasticsearch