------------------------------------- |\n| 7     | `SessionTooLow` | Session epoch below the cluster's retained minimum |","table":"table-5"},"616":{"id":"/docs/binary-protocol/framing-128","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing#evictionheader","content":"| Value | Reason                   | Meaning                              |\n| ----- | ------------------------ | ------------------------------------ |\n| 8     | `SessionReleaseMismatch` | Session bound to a different release |","table":"table-5"},"617":{"id":"/docs/binary-protocol/framing-129","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing#evictionheader","content":"| Value | Reason               | Meaning                                 |\n| ----- | -------------------- | --------------------------------------- |\n| 9     | `InvalidCredentials` | Login refused: bad username or password |","table":"table-5"},"618":{"id":"/docs/binary-protocol/framing-130","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing#evictionheader","content":"| Value | Reason         | Meaning                                  |\n| ----- | -------------- | ---------------------------------------- |\n| 10    | `InvalidToken` | Login refused: bad personal access token |","table":"table-5"},"619":{"id":"/docs/binary-protocol/framing-131","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing#evictionheader","content":"| Value | Reason         | Meaning                      |\n| ----- | -------------- | ---------------------------- |\n| 11    | `UserInactive` | Login refused: user inactive |","table":"table-5"},"620":{"id":"/docs/binary-protocol/framing-132","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing#evictionheader","content":"| Value | Reason         | Meaning               |\n| ----- | -------------- | --------------------- |\n| 12    | `SessionError` | Session-level failure |","table":"table-5"},"621":{"id":"/docs/binary-protocol/framing-133","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing#evictionheader","content":"| Value | Reason        | Meaning                                       |\n| ----- | ------------- | --------------------------------------------- |\n| 13    | `StaleClient` | Missed heartbeats. Server evicted the session |","table":"table-5"},"622":{"id":"/docs/binary-protocol/framing-134","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing#evictionheader","content":"| Value | Reason                 | Meaning                                                                  |\n| ----- | ---------------------- | ------------------------------------------------------------------------ |\n| 14    | `IncompatibleProtocol` | Client protocol version outside the accepted window (see bytes 144..152) |","table":"table-5"},"623":{"id":"/docs/binary-protocol/framing-135","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing#evictionheader","content":"| Value | Reason           | Meaning                                                               |\n| ----- | ---------------- | --------------------------------------------------------------------- |\n| 15    | `MalformedLogin` | Login body without a decodable version prefix, or a legacy login code |","table":"table-5"},"624":{"id":"/docs/binary-protocol/framing-136","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing#evictionheader","content":"Value 0 is reserved and never sent."},"625":{"id":"/docs/binary-protocol","page_id":"/docs/binary-protocol","type":"page","content":"Binary Protocol","breadcrumbs":["Documentation","Binary Protocol"],"tags":[],"url":"/docs/binary-protocol"},"626":{"id":"/docs/binary-protocol-0","page_id":"/docs/binary-protocol","tags":[],"type":"text","url":"/docs/binary-protocol","content":"Binary protocol 0.12.0: one wire format across TCP, QUIC and WebSocket, covering both the client and replica planes."},"627":{"id":"/docs/binary-protocol-1","page_id":"/docs/binary-protocol","tags":[],"type":"text","url":"/docs/binary-protocol","content":"Iggy speaks one binary protocol over its three binary transports: TCP, QUIC, and WebSocket. Commands, responses, data models, and status codes are the same on all of them. The HTTP transport is separate: it exposes JSON REST endpoints for a subset of these operations, listed in server.http."},"628":{"id":"/docs/binary-protocol-2","page_id":"/docs/binary-protocol","tags":[],"type":"text","url":"/docs/binary-protocol","content":"This section describes **binary protocol version 0.12.0**. The protocol version is the `major.minor.patch` of the `iggy_binary_protocol` crate, ignoring prerelease tags, and it's exchanged and checked during login (see Connection lifecycle). The crate itself is the source of truth: request and response types document their payload layouts, and the server dispatch defines which operations are supported."},"629":{"id":"/docs/binary-protocol-3","page_id":"/docs/binary-protocol","tags":[],"type":"text","url":"/docs/binary-protocol","content":"All multi-byte integers are **little-endian** unless stated otherwise."},"630":{"id":"/docs/binary-protocol-4","page_id":"/docs/binary-protocol","tags":[],"type":"text","url":"/docs/binary-protocol","content":"The same 256-byte header layout carries two traffic planes. The pages below cover both:"},"631":{"id":"/docs/binary-protocol-5","page_id":"/docs/binary-protocol","tags":[],"type":"text","url":"/docs/binary-protocol","content":"**Server ↔ SDK client**, everything a client sends or receives:"},"632":{"id":"/docs/binary-protocol-6","page_id":"/docs/binary-protocol","tags":[],"type":"text","url":"/docs/binary-protocol","content":"Framing: the 256-byte headers every client-facing message rides in."},"633":{"id":"/docs/binary-protocol-7","page_id":"/docs/binary-protocol","tags":[],"type":"text","url":"/docs/binary-protocol","content":"Connection lifecycle: protocol versioning and the login-register handshake."},"634":{"id":"/docs/binary-protocol-8","page_id":"/docs/binary-protocol","tags":[],"type":"text","url":"/docs/binary-protocol","content":"Commands: the command codes and per-command payload layouts."},"635":{"id":"/docs/binary-protocol-9","page_id":"/docs/binary-protocol","tags":[],"type":"text","url":"/docs/binary-protocol","content":"Shared encodings: primitives the payloads are built from."},"636":{"id":"/docs/binary-protocol-10","page_id":"/docs/binary-protocol","tags":[],"type":"text","url":"/docs/binary-protocol","content":"Message batches: the one layout messages travel and rest in."},"637":{"id":"/docs/binary-protocol-11","page_id":"/docs/binary-protocol","tags":[],"type":"text","url":"/docs/binary-protocol","content":"**Server ↔ server**, the replica-to-replica consensus traffic that never appears on a client connection:"},"638":{"id":"/docs/binary-protocol-12","page_id":"/docs/binary-protocol","tags":[],"type":"text","url":"/docs/binary-protocol","content":"Server-to-server: prepare/ack replication, view changes, and state transfer."},"639":{"id":"/docs/binary-protocol/messages","page_id":"/docs/binary-protocol/messages","type":"page","content":"Message batches","breadcrumbs":["Documentation","Binary Protocol"],"tags":[],"url":"/docs/binary-protocol/messages"},"640":{"id":"/docs/binary-protocol/messages-0","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages","content":"The batch layout messages travel and rest in, from the 256-byte batch header down to individual message frames."},"641":{"id":"/docs/binary-protocol/messages-1","page_id":"/docs/binary-protocol/messages","type":"heading","tags":[],"url":"/docs/binary-protocol/messages#batch-header-256-bytes","content":"Batch header (256 bytes)"},"642":{"id":"/docs/binary-protocol/messages-2","page_id":"/docs/binary-protocol/messages","type":"heading","tags":[],"url":"/docs/binary-protocol/messages#message-frame-header-48-bytes","content":"Message frame header (48 bytes)"},"643":{"id":"/docs/binary-protocol/messages-3","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages","content":"Messages travel and rest in exactly one layout, the **batch**: the `SendMessages` body, the replicated record, the persisted segment record, and the poll reply all share it. There is no other message encoding."},"644":{"id":"/docs/binary-protocol/messages-4","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#batch-header-256-bytes","content":"| Offset | Size | Field          | Type | Description                                       |\n| ------ | ---- | -------------- | ---- | ------------------------------------------------- |\n| 0      | 8    | `partition_id` | u64  | Server-stamped at admission. Producers send zero. |","table":"table-0"},"645":{"id":"/docs/binary-protocol/messages-5","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#batch-header-256-bytes","content":"| Offset | Size | Field         | Type | Description                                                                              |\n| ------ | ---- | ------------- | ---- | ---------------------------------------------------------------------------------------- |\n| 8      | 8    | `base_offset` | u64  | Server-stamped when the batch is appended to the partition journal. Producers send zero. |","table":"table-0"},"646":{"id":"/docs/binary-protocol/messages-6","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#batch-header-256-bytes","content":"| Offset | Size | Field            | Type | Description                                                           |\n| ------ | ---- | ---------------- | ---- | --------------------------------------------------------------------- |\n| 16     | 8    | `base_timestamp` | u64  | Server-stamped at journal append (microseconds). Producers send zero. |","table":"table-0"},"647":{"id":"/docs/binary-protocol/messages-7","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#batch-header-256-bytes","content":"| Offset | Size | Field              | Type | Description                                                                              |\n| ------ | ---- | ------------------ | ---- | ---------------------------------------------------------------------------------------- |\n| 24     | 8    | `origin_timestamp` | u64  | Producer-set: the earliest `origin_timestamp` among the batch's messages (microseconds). |","table":"table-0"},"648":{"id":"/docs/binary-protocol/messages-8","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#batch-header-256-bytes","content":"| Offset | Size | Field          | Type | Description                          |\n| ------ | ---- | -------------- | ---- | ------------------------------------ |\n| 32     | 8    | `batch_length` | u64  | Total batch size: 256 + blob length. |","table":"table-0"},"649":{"id":"/docs/binary-protocol/messages-9","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#batch-header-256-bytes","content":"| Offset | Size | Field            | Type | Description                                                                                                                                                                                                                                                                                                                                |\n| ------ | ---- | ---------------- | ---- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| 40     | 8    | `batch_checksum` | u64  | XxHash3-64 over the header fields (`partition_id`, `base_offset`, `base_timestamp`, `origin_timestamp`, `batch_length`, `message_count`, in that order, little-endian bytes) followed, when present, by the producer flag, ID, epoch and sequence, then each frame's 8 checksum bytes. Recomputed by the server when it stamps the header. |","table":"table-0"},"650":{"id":"/docs/binary-protocol/messages-10","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#batch-header-256-bytes","content":"| Offset | Size | Field           | Type | Description                   |\n| ------ | ---- | --------------- | ---- | ----------------------------- |\n| 48     | 4    | `message_count` | u32  | Number of frames in the blob. |","table":"table-0"},"651":{"id":"/docs/binary-protocol/messages-11","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#batch-header-256-bytes","content":"| Offset | Size | Field | Type | Description                                                       |\n| ------ | ---- | ----- | ---- | ----------------------------------------------------------------- |\n| 52     | 1    | flags | u8   | Bit 0 means producer fields are present. Other bits are rejected. |","table":"table-0"},"652":{"id":"/docs/binary-protocol/messages-12","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#batch-header-256-bytes","content":"| Offset | Size | Field    | Type  | Description |\n| ------ | ---- | -------- | ----- | ----------- |\n| 53     | 3    | reserved | bytes | Zero.       |","table":"table-0"},"653":{"id":"/docs/binary-protocol/messages-13","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#batch-header-256-bytes","content":"| Offset | Size | Field         | Type | Description                                           |\n| ------ | ---- | ------------- | ---- | ----------------------------------------------------- |\n| 56     | 8    | `producer_id` | u64  | Producer identity, at most the signed 64-bit maximum. |","table":"table-0"},"654":{"id":"/docs/binary-protocol/messages-14","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#batch-header-256-bytes","content":"| Offset | Size | Field   | Type | Description                                        |\n| ------ | ---- | ------- | ---- | -------------------------------------------------- |\n| 64     | 2    | `epoch` | u16  | Producer epoch, at most the signed 16-bit maximum. |","table":"table-0"},"655":{"id":"/docs/binary-protocol/messages-15","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#batch-header-256-bytes","content":"| Offset | Size | Field    | Type  | Description |\n| ------ | ---- | -------- | ----- | ----------- |\n| 66     | 2    | reserved | bytes | Zero.       |","table":"table-0"},"656":{"id":"/docs/binary-protocol/messages-16","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#batch-header-256-bytes","content":"| Offset | Size | Field           | Type | Description                                                |\n| ------ | ---- | --------------- | ---- | ---------------------------------------------------------- |\n| 68     | 4    | `base_sequence` | u32  | First message sequence, at most the signed 32-bit maximum. |","table":"table-0"},"657":{"id":"/docs/binary-protocol/messages-17","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#batch-header-256-bytes","content":"| Offset | Size | Field    | Type  | Description |\n| ------ | ---- | -------- | ----- | ----------- |\n| 72     | 184  | reserved | bytes | Zero.       |","table":"table-0"},"658":{"id":"/docs/binary-protocol/messages-18","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#batch-header-256-bytes","content":"Without the producer-present flag, every producer field is zero. With it, the partition can deduplicate producer retries. Sequence numbers wrap after the signed 32-bit maximum. See Idempotent producers."},"659":{"id":"/docs/binary-protocol/messages-19","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#message-frame-header-48-bytes","content":"| Offset | Size | Field      | Type | Description                                                                                                           |\n| ------ | ---- | ---------- | ---- | --------------------------------------------------------------------------------------------------------------------- |\n| 0      | 8    | `checksum` | u64  | XxHash3-64 over frame bytes 8..48 followed by `payload` and `user_headers`. Producer-computed. Verified at admission. |","table":"table-1"},"660":{"id":"/docs/binary-protocol/messages-20","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#message-frame-header-48-bytes","content":"| Offset | Size | Field | Type | Description                      |\n| ------ | ---- | ----- | ---- | -------------------------------- |\n| 8      | 16   | `id`  | u128 | Message id (for example a UUID). |","table":"table-1"},"661":{"id":"/docs/binary-protocol/messages-21","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#message-frame-header-48-bytes","content":"| Offset | Size | Field          | Type | Description                                                                                   |\n| ------ | ---- | -------------- | ---- | --------------------------------------------------------------------------------------------- |\n| 24     | 4    | `offset_delta` | u32  | Message offset = `base_offset + offset_delta`. Producer sends the frame's index in the batch. |","table":"table-1"},"662":{"id":"/docs/binary-protocol/messages-22","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#message-frame-header-48-bytes","content":"| Offset | Size | Field             | Type | Description                                                                                                                                |\n| ------ | ---- | ----------------- | ---- | ------------------------------------------------------------------------------------------------------------------------------------------ |\n| 28     | 4    | `timestamp_delta` | u32  | Microsecond delta against the batch `origin_timestamp`. One batch spans at most about 71.6 minutes of producer clock (`u32` microseconds). |","table":"table-1"},"663":{"id":"/docs/binary-protocol/messages-23","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#message-frame-header-48-bytes","content":"| Offset | Size | Field                 | Type | Description                            |\n| ------ | ---- | --------------------- | ---- | -------------------------------------- |\n| 32     | 4    | `user_headers_length` | u32  | Byte length of the user headers block. |","table":"table-1"},"664":{"id":"/docs/binary-protocol/messages-24","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#message-frame-header-48-bytes","content":"| Offset | Size | Field            | Type | Description                 |\n| ------ | ---- | ---------------- | ---- | --------------------------- |\n| 36     | 4    | `payload_length` | u32  | Byte length of the payload. |","table":"table-1"},"665":{"id":"/docs/binary-protocol/messages-25","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#message-frame-header-48-bytes","content":"| Offset | Size | Field    | Type | Description   |\n| ------ | ---- | -------- | ---- | ------------- |\n| 40     | 8    | reserved | u64  | Must be zero. |","table":"table-1"},"666":{"id":"/docs/binary-protocol/messages-26","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#message-frame-header-48-bytes","content":"After the 48 header bytes: `payload` (`payload_length` bytes), then `user_headers` (`user_headers_length` bytes). The payload comes **first**."},"667":{"id":"/docs/binary-protocol/messages-27","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#message-frame-header-48-bytes","content":"A frame's absolute position is derived, not stored: offset = `base_offset + offset_delta`. The server-stamped time is the flat batch `base_timestamp` (the delta does not apply to it). Producer time resolves as `origin_timestamp + timestamp_delta`."},"668":{"id":"/docs/binary-protocol/messages-28","page_id":"/docs/binary-protocol/messages","tags":[],"type":"text","url":"/docs/binary-protocol/messages#message-frame-header-48-bytes","content":"The 64-byte `IggyMessageHeader` (checksum, id, offset, timestamp, origin_timestamp, lengths, reserved) that earlier protocol generations put in front of every message **no longer exists on the wire or on disk**. It survives only as an in-memory model."},"669":{"id":"/docs/cli/commands","page_id":"/docs/cli/commands","type":"page","content":"Command Reference","breadcrumbs":["Documentation","CLI"],"tags":[],"url":"/docs/cli/commands"},"670":{"id":"/docs/cli/commands-0","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands","content":"Every iggy CLI command with its arguments, flags, and a runnable example"},"671":{"id":"/docs/cli/commands-1","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#stream","content":"stream"},"672":{"id":"/docs/cli/commands-2","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#topic","content":"topic"},"673":{"id":"/docs/cli/commands-3","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#partition","content":"partition"},"674":{"id":"/docs/cli/commands-4","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#segment","content":"segment"},"675":{"id":"/docs/cli/commands-5","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#message","content":"message"},"676":{"id":"/docs/cli/commands-6","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#message-send","content":"message send"},"677":{"id":"/docs/cli/commands-7","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#message-poll","content":"message poll"},"678":{"id":"/docs/cli/commands-8","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#user","content":"user"},"679":{"id":"/docs/cli/commands-9","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#permissions","content":"Permissions"},"680":{"id":"/docs/cli/commands-10","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#pat","content":"pat"},"681":{"id":"/docs/cli/commands-11","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#client","content":"client"},"682":{"id":"/docs/cli/commands-12","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#cluster","content":"cluster"},"683":{"id":"/docs/cli/commands-13","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#consumer-group","content":"consumer-group"},"684":{"id":"/docs/cli/commands-14","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#consumer-offset","content":"consumer-offset"},"685":{"id":"/docs/cli/commands-15","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#context","content":"context"},"686":{"id":"/docs/cli/commands-16","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#options","content":"options"},"687":{"id":"/docs/cli/commands-17","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#ping","content":"ping"},"688":{"id":"/docs/cli/commands-18","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#me","content":"me"},"689":{"id":"/docs/cli/commands-19","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#stats","content":"stats"},"690":{"id":"/docs/cli/commands-20","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#snapshot","content":"snapshot"},"691":{"id":"/docs/cli/commands-21","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#login-logout-session","content":"login, logout, session"},"692":{"id":"/docs/cli/commands-22","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#metadata","content":"metadata"},"693":{"id":"/docs/cli/commands-23","page_id":"/docs/cli/commands","type":"heading","tags":[],"url":"/docs/cli/commands#resource-update-examples","content":"Resource update examples"},"694":{"id":"/docs/cli/commands-24","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands","content":"This page lists every top-level `iggy` command. Examples assume you're already authenticated, for example via `iggy login`. See installation and authentication. Run `iggy <command> --help` for the full flag list of any command."},"695":{"id":"/docs/cli/commands-25","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands","content":"Conventions used throughout:"},"696":{"id":"/docs/cli/commands-26","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands","content":"Commands that address an existing stream, topic, user, or consumer group accept its numeric ID or name (for example, `iggy topic get dev events`). Numeric IDs identify the same resources only when those are the IDs assigned by the server. The numeric stream/topic IDs inside permission specifications are an exception: names are not accepted there."},"697":{"id":"/docs/cli/commands-27","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands","content":"Subcommands have single-letter aliases too: `c` (create), `d` (delete), `g` (get), `l` (list), `u` (update). So `iggy s l` is `iggy stream list`."},"698":{"id":"/docs/cli/commands-28","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands","content":"Every `list` command accepts `-l, --list-mode <table|list>` (default: `table`)."},"699":{"id":"/docs/cli/commands-29","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands","content":"`-q, --quiet` suppresses ordinary status output. `stats` still prints its result, and `pat create` still prints an unstored token. Interactive password changes also print their confirmation. `-d, --debug <file>` writes verbose logs to a file."},"700":{"id":"/docs/cli/commands-30","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#stream","content":"Manage streams, the top-level containers for topics. Subcommands: `create`, `delete`, `update`, `get`, `list`. The legacy creation flags `stream create -s`, `topic create -t`, and `consumer-group create -g` are accepted but ignored. IDs are always assigned by the server."},"701":{"id":"/docs/cli/commands-31","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#topic","content":"Manage topics within a stream. Subcommands: `create`, `delete`, `update`, `get`, `list`. These examples require an existing `dev` stream."},"702":{"id":"/docs/cli/commands-32","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#topic","content":"Compression is a **required positional**: `none` or `gzip`. It is stored as topic metadata, but compression is not applied. Expiry is a human-readable duration (`7d`, `1day 12h`, `unlimited`). Omitting expiry at creation selects no expiration."},"703":{"id":"/docs/cli/commands-33","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#topic","content":"For updates, supply expiry and `--max-topic-size` explicitly. Omitted values are sent as `server_default` (zero): the server retains the previous expiry/size fields but reports zero in their option entries. See Topic options for this inconsistency."},"704":{"id":"/docs/cli/commands-34","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#topic","content":"| Flag                  | Description                                                 |\n| --------------------- | ----------------------------------------------------------- |\n| `-t, --topic-id <ID>` | Accepted at creation but ignored. The server assigns the ID |","table":"table-0"},"705":{"id":"/docs/cli/commands-35","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#topic","content":"| Flag                          | Description                                                                                 |\n| ----------------------------- | ------------------------------------------------------------------------------------------- |\n| `-m, --max-topic-size <SIZE>` | Retention size, e.g. `15GB`, `unlimited` (default: `server_default`. Unlimited at creation) |","table":"table-0"},"706":{"id":"/docs/cli/commands-36","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#topic","content":"| Flag                    | Description                                                                    |\n| ----------------------- | ------------------------------------------------------------------------------ |\n| `--durability <POLICY>` | Message completion policy: `replicated` (default) or `persisted` (create only) |","table":"table-0"},"707":{"id":"/docs/cli/commands-37","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#topic","content":"| Flag                                    | Description                                                                                 |\n| --------------------------------------- | ------------------------------------------------------------------------------------------- |\n| `--consumer-offset-durability <POLICY>` | Independent offset-store/delete policy: `replicated` (default) or `persisted` (create only) |","table":"table-0"},"708":{"id":"/docs/cli/commands-38","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#topic","content":"| Flag                | Description                                                         |\n| ------------------- | ------------------------------------------------------------------- |\n| `--set <KEY=VALUE>` | Server-side option, repeatable. Updates accept only updatable keys. |","table":"table-0"},"709":{"id":"/docs/cli/commands-39","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#partition","content":"Add or remove partitions of a topic."},"710":{"id":"/docs/cli/commands-40","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#segment","content":"Delete up to the requested number of oldest sealed segments of a partition. The active segment is retained."},"711":{"id":"/docs/cli/commands-41","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message","content":"Send and poll messages. Subcommands: `send` and `poll`. The flush command is removed."},"712":{"id":"/docs/cli/commands-42","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-send","content":"| Flag                      | Description                  |\n| ------------------------- | ---------------------------- |\n| `-p, --partition-id <ID>` | Send to a specific partition |","table":"table-1"},"713":{"id":"/docs/cli/commands-43","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-send","content":"| Flag                      | Description                                                                                                                                      |\n| ------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `-m, --message-key <KEY>` | Route by a 1-255 byte message key. Binary transports hash it client-side. HTTP resolves it server-side. Mutually exclusive with `--partition-id` |","table":"table-1"},"714":{"id":"/docs/cli/commands-44","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-send","content":"| Flag                             | Description                                                                                                                |\n| -------------------------------- | -------------------------------------------------------------------------------------------------------------------------- |\n| `-H, --headers <KEY:KIND:VALUE>` | Message headers, comma separated. Kinds: `raw`, `string`, `bool`, `int8`-`int128`, `uint8`-`uint128`, `float32`, `float64` |","table":"table-1"},"715":{"id":"/docs/cli/commands-45","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-send","content":"| Flag                  | Description                                                      |\n| --------------------- | ---------------------------------------------------------------- |\n| `--input-file <FILE>` | Send messages from a binary file written by `poll --output-file` |","table":"table-1"},"716":{"id":"/docs/cli/commands-46","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"**Exactly one** polling strategy is required:"},"717":{"id":"/docs/cli/commands-47","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"| Strategy                | Description                 |\n| ----------------------- | --------------------------- |\n| `-o, --offset <OFFSET>` | Start from the given offset |","table":"table-2"},"718":{"id":"/docs/cli/commands-48","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"| Strategy      | Description                                   |\n| ------------- | --------------------------------------------- |\n| `-f, --first` | Start from the first message in the partition |","table":"table-2"},"719":{"id":"/docs/cli/commands-49","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"| Strategy     | Description                 |\n| ------------ | --------------------------- |\n| `-l, --last` | Start from the last message |","table":"table-2"},"720":{"id":"/docs/cli/commands-50","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"| Strategy     | Description                               |\n| ------------ | ----------------------------------------- |\n| `-n, --next` | Continue after the stored consumer offset |","table":"table-2"},"721":{"id":"/docs/cli/commands-51","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"| Flag                      | Description                             |\n| ------------------------- | --------------------------------------- |\n| `-m, --message-count <N>` | Number of messages to poll (default: 1) |","table":"table-3"},"722":{"id":"/docs/cli/commands-52","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"| Flag                | Description                                                                                                              |\n| ------------------- | ------------------------------------------------------------------------------------------------------------------------ |\n| `-a, --auto-commit` | Submit the current batch's last offset asynchronously before delivering the poll reply. Not an acknowledged offset store |","table":"table-3"},"723":{"id":"/docs/cli/commands-53","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"| Flag                  | Description                                   |\n| --------------------- | --------------------------------------------- |\n| `-c, --consumer <ID>` | Consumer name or ID to poll as (default: `0`) |","table":"table-3"},"724":{"id":"/docs/cli/commands-54","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"| Flag                 | Description                           |\n| -------------------- | ------------------------------------- |\n| `-s, --show-headers` | Include message headers in the output |","table":"table-3"},"725":{"id":"/docs/cli/commands-55","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"| Flag                   | Description                                                 |\n| ---------------------- | ----------------------------------------------------------- |\n| `--output-file <FILE>` | Append polled messages to a binary file instead of printing |","table":"table-3"},"726":{"id":"/docs/cli/commands-56","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#message-poll","content":"Polled messages can be replayed later, for example into another topic:"},"727":{"id":"/docs/cli/commands-57","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#user","content":"Manage users and their permissions. Subcommands: `create`, `delete`, `get`, `list`, `name`, `status`, `password`, `permissions`."},"728":{"id":"/docs/cli/commands-58","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"`user create` and `user permissions` accept the same permission flags:"},"729":{"id":"/docs/cli/commands-59","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"| Flag                               | Description                        |\n| ---------------------------------- | ---------------------------------- |\n| `-g, --global-permissions <PERMS>` | Comma-separated global permissions |","table":"table-4"},"730":{"id":"/docs/cli/commands-60","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"| Flag                              | Description                                        |\n| --------------------------------- | -------------------------------------------------- |\n| `-s, --stream-permissions <SPEC>` | Per-stream (and per-topic) permissions, repeatable |","table":"table-4"},"731":{"id":"/docs/cli/commands-61","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"| Flag                                   | Description                                     |\n| -------------------------------------- | ----------------------------------------------- |\n| `-u, --user-status <active\\|inactive>` | Initial status (create only, default: `active`) |","table":"table-4"},"732":{"id":"/docs/cli/commands-62","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"Global permission tokens (long / short): `manage_servers`/`m_srv`, `read_servers`/`r_srv`, `manage_users`/`m_usr`, `read_users`/`r_usr`, `manage_streams`/`m_str`, `read_streams`/`r_str`, `manage_topics`/`m_top`, `read_topics`/`r_top`, `poll_messages`/`p_msg`, `send_messages`/`s_msg`."},"733":{"id":"/docs/cli/commands-63","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"The stream permission format is `STREAM_ID[:STREAM_PERMISSIONS][#TOPIC_ID[:TOPIC_PERMISSIONS]]`:"},"734":{"id":"/docs/cli/commands-64","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#pat","content":"Manage personal access tokens for the authenticated user. Subcommands: `create`, `delete`, `list`."},"735":{"id":"/docs/cli/commands-65","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#pat","content":"`--store-token` and an expiry are mutually exclusive: stored tokens **never expire**."},"736":{"id":"/docs/cli/commands-66","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#client","content":"Inspect the clients currently connected to the server. Clients are **connections, not users**."},"737":{"id":"/docs/cli/commands-67","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#cluster","content":"Cluster operations. The only subcommand is `metadata` (alias `m`)."},"738":{"id":"/docs/cli/commands-68","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#consumer-group","content":"Manage consumer groups of a topic. Subcommands: `create`, `delete`, `get`, `list`."},"739":{"id":"/docs/cli/commands-69","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#consumer-offset","content":"Read or set the stored offset of a consumer for one partition. Subcommands: `get`, `set`. Both accept `-k, --kind <consumer|consumer-group>` (default: `consumer`)."},"740":{"id":"/docs/cli/commands-70","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#context","content":"Manage named connection profiles. Subcommands: `list`, `use`, `create`, `delete`, `show`. See connection contexts for details."},"741":{"id":"/docs/cli/commands-71","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#options","content":"Print the server's option catalog for one scope: `topic`, `stream` or `user`, with key kinds, defaults, and bounds. All three scopes have catalogs. `stream update` and `topic update` accept `--set KEY=VALUE` and `--reset KEY`. A stream key is supplied at creation through `--stream-key-file`."},"742":{"id":"/docs/cli/commands-72","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#ping","content":"Check that the server is up and measure the response time. `-c, --count <N>` sends N pings (default: 1)."},"743":{"id":"/docs/cli/commands-73","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#me","content":"Show info about the current connection: client ID, user ID, client address as seen by the server, protocol. Supported on TCP, QUIC and WebSocket. HTTP returns `FeatureUnavailable`."},"744":{"id":"/docs/cli/commands-74","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#stats","content":"Show server statistics: streams, topics, partitions, messages, plus host OS details. `-o, --output <table|list|json|toml>` selects the format (default: `table`)."},"745":{"id":"/docs/cli/commands-75","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#snapshot","content":"Collect server troubleshooting data into an archive. This requires `manage_servers` because the archive can include logs and host diagnostics."},"746":{"id":"/docs/cli/commands-76","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#snapshot","content":"| Flag                       | Description                                         |\n| -------------------------- | --------------------------------------------------- |\n| `-c, --compression <TYPE>` | `stored`, `deflated`, `bzip2`, `zstd`, `lzma`, `xz` |","table":"table-5"},"747":{"id":"/docs/cli/commands-77","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#snapshot","content":"| Flag                           | Description                                                                                                                      |\n| ------------------------------ | -------------------------------------------------------------------------------------------------------------------------------- |\n| `-s, --snapshot-types <TYPES>` | Space-separated subset of `filesystem_overview`, `process_list`, `resource_usage`, `test`, `server_logs`, `server_config`, `all` |","table":"table-5"},"748":{"id":"/docs/cli/commands-78","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#snapshot","content":"| Flag                  | Description                                     |\n| --------------------- | ----------------------------------------------- |\n| `-o, --out-dir <DIR>` | Existing output directory for the snapshot file |","table":"table-5"},"749":{"id":"/docs/cli/commands-79","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#login-logout-session","content":"Manage login sessions backed by the platform keyring. `iggy login [EXPIRY]` stores a session token (default expiry: 15 minutes, `none` disables expiry), `iggy logout` removes it, and `iggy session status` reports whether a token exists locally. See login sessions for the full flow."},"750":{"id":"/docs/cli/commands-80","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#metadata","content":"Read or follow the metadata change log. The command needs root or `manage_servers` and prints one JSON page per line:"},"751":{"id":"/docs/cli/commands-81","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#metadata","content":"`--after` resumes from a returned cursor. `--limit` accepts 1 through 1000 and defaults to 100. `--interval` defaults to one second while following. `--since` and `--until` use microseconds since the epoch. A follower rebuilds from current state when its saved history expires."},"752":{"id":"/docs/cli/commands-82","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#resource-update-examples","content":"Updates preserve omitted fields. Compression and storage options remain fixed at creation. `topic get` displays partition details and explicit and derived options. See Topic options."},"753":{"id":"/docs/cli/start","page_id":"/docs/cli/start","type":"page","content":"Iggy CLI","breadcrumbs":["Documentation","CLI"],"tags":[],"url":"/docs/cli/start"},"754":{"id":"/docs/cli/start-0","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start","content":"Install the Iggy CLI, connect to a server, authenticate, and manage connection contexts."},"755":{"id":"/docs/cli/start-1","page_id":"/docs/cli/start","type":"heading","tags":[],"url":"/docs/cli/start#installation","content":"Installation"},"756":{"id":"/docs/cli/start-2","page_id":"/docs/cli/start","type":"heading","tags":[],"url":"/docs/cli/start#cargo","content":"Cargo"},"757":{"id":"/docs/cli/start-3","page_id":"/docs/cli/start","type":"heading","tags":[],"url":"/docs/cli/start#docker","content":"Docker"},"758":{"id":"/docs/cli/start-4","page_id":"/docs/cli/start","type":"heading","tags":[],"url":"/docs/cli/start#connecting-to-a-server","content":"Connecting to a server"},"759":{"id":"/docs/cli/start-5","page_id":"/docs/cli/start","type":"heading","tags":[],"url":"/docs/cli/start#tls-and-encryption","content":"TLS and encryption"},"760":{"id":"/docs/cli/start-6","page_id":"/docs/cli/start","type":"heading","tags":[],"url":"/docs/cli/start#authentication","content":"Authentication"},"761":{"id":"/docs/cli/start-7","page_id":"/docs/cli/start","type":"heading","tags":[],"url":"/docs/cli/start#login-sessions","content":"Login sessions"},"762":{"id":"/docs/cli/start-8","page_id":"/docs/cli/start","type":"heading","tags":[],"url":"/docs/cli/start#personal-access-tokens","content":"Personal access tokens"},"763":{"id":"/docs/cli/start-9","page_id":"/docs/cli/start","type":"heading","tags":[],"url":"/docs/cli/start#connection-contexts","content":"Connection contexts"},"764":{"id":"/docs/cli/start-10","page_id":"/docs/cli/start","type":"heading","tags":[],"url":"/docs/cli/start#shell-completions","content":"Shell completions"},"765":{"id":"/docs/cli/start-11","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start","content":"The Iggy CLI is a command-line interface for managing an Iggy server: streams, topics, partitions, messages, users, tokens and more. It lives in the core repository under the `core/cli` directory. The crate is named `iggy-cli`, the installed binary `iggy`."},"766":{"id":"/docs/cli/start-12","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start","content":"This page covers installing the CLI, connecting to a server, authenticating, and managing connection contexts. The full command tree is documented in the command reference."},"767":{"id":"/docs/cli/start-13","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#cargo","content":"These docs target server 0.10.0 and CLI 0.15.0, prepared for the same release. The CLI has its own version number, so use the version that matches your server. Install it from crates.io with:"},"768":{"id":"/docs/cli/start-14","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#cargo","content":"This builds and installs the `iggy` binary. With cargo-binstall, you can download a prebuilt binary instead. It builds from source if there isn't one for your platform:"},"769":{"id":"/docs/cli/start-15","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#cargo","content":"To build it from source instead, use the same checkout as your server and run this from its root:"},"770":{"id":"/docs/cli/start-16","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#docker","content":"The official `apache/iggy` image ships the CLI alongside the server, installed as `/usr/local/bin/iggy`. The image entrypoint is the server, so override it to run the CLI:"},"771":{"id":"/docs/cli/start-17","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#docker","content":"`--network host` works on **Linux**. On macOS and Windows, point the CLI at the host instead: `--tcp-server-address host.docker.internal:8090`."},"772":{"id":"/docs/cli/start-18","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#docker","content":"Once installed, run `iggy` without arguments to print an overview of the available commands, or see the command reference."},"773":{"id":"/docs/cli/start-19","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"The CLI talks to the server over one of four transports, selected with `--transport`. Accepted values are `tcp`, `quic`, `http` and `ws` (**not** `websocket`). The default is `tcp`."},"774":{"id":"/docs/cli/start-20","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"| Transport | Address flag           | Default          |\n| --------- | ---------------------- | ---------------- |\n| `tcp`     | `--tcp-server-address` | `127.0.0.1:8090` |","table":"table-0"},"775":{"id":"/docs/cli/start-21","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"| Transport | Address flag            | Default          |\n| --------- | ----------------------- | ---------------- |\n| `quic`    | `--quic-server-address` | `127.0.0.1:8080` |","table":"table-0"},"776":{"id":"/docs/cli/start-22","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"| Transport | Address flag     | Default                 |\n| --------- | ---------------- | ----------------------- |\n| `http`    | `--http-api-url` | `http://localhost:3000` |","table":"table-0"},"777":{"id":"/docs/cli/start-23","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"| Transport | Address flag                 | Default          |\n| --------- | ---------------------------- | ---------------- |\n| `ws`      | `--websocket-server-address` | `127.0.0.1:8092` |","table":"table-0"},"778":{"id":"/docs/cli/start-24","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#tls-and-encryption","content":"| Flag                | Description                      |\n| ------------------- | -------------------------------- |\n| `--tcp-tls-enabled` | Enable TLS for the TCP transport |","table":"table-1"},"779":{"id":"/docs/cli/start-25","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#tls-and-encryption","content":"| Flag               | Description                                             |\n| ------------------ | ------------------------------------------------------- |\n| `--tcp-tls-domain` | TLS domain for the TCP transport (default: `localhost`) |","table":"table-1"},"780":{"id":"/docs/cli/start-26","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#tls-and-encryption","content":"| Flag                          | Description                            |\n| ----------------------------- | -------------------------------------- |\n| `--quic-validate-certificate` | Enable certificate validation for QUIC |","table":"table-1"},"781":{"id":"/docs/cli/start-27","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#tls-and-encryption","content":"| Flag               | Description                                                               |\n| ------------------ | ------------------------------------------------------------------------- |\n| `--encryption-key` | Base64-encoded AES-256-GCM key for client-side message payload encryption |","table":"table-1"},"782":{"id":"/docs/cli/start-28","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#tls-and-encryption","content":"Each transport also exposes reconnection and tuning flags (retry counts, intervals, QUIC window sizes and MTU). Run `iggy --help` for the complete list with defaults."},"783":{"id":"/docs/cli/start-29","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#authentication","content":"Broker commands require credentials, except for `ping`. For commands other than `login`, the CLI resolves credentials in this order, **first match wins**:"},"784":{"id":"/docs/cli/start-30","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#authentication","content":"A cached login session token (created by `iggy login`)."},"785":{"id":"/docs/cli/start-31","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#authentication","content":"`-n, --token-name <name>`: a personal access token stored in the platform keyring under that name."},"786":{"id":"/docs/cli/start-32","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#authentication","content":"`-t, --token <token>`: a personal access token passed directly."},"787":{"id":"/docs/cli/start-33","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#authentication","content":"`-u, --username <user>` with `-p, --password <password>`. When `-p` is omitted, the CLI prompts for the password interactively (or reads one line from stdin when piped)."},"788":{"id":"/docs/cli/start-34","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#authentication","content":"A nonempty `IGGY_TOKEN` environment variable."},"789":{"id":"/docs/cli/start-35","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#authentication","content":"The `IGGY_USERNAME` and `IGGY_PASSWORD` environment variables (both must be set)."},"790":{"id":"/docs/cli/start-36","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#authentication","content":"`iggy login` tries the supplied credentials before a cached session, so it can replace an expired login. Other commands fail if their cached token is rejected. They do not retry with the next credential source in the same invocation."},"791":{"id":"/docs/cli/start-37","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#authentication","content":"`-u`, `-t` and `-n` are **mutually exclusive**. Avoid passing the password inline with `-p`: it lands in your **shell history**. Prefer `iggy login`, the interactive prompt, or the environment variables."},"792":{"id":"/docs/cli/start-38","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#login-sessions","content":"`iggy login` authenticates once and stores a session token in the platform's secure credential store: Secret Service on Linux and the BSDs, Keychain on macOS, Credential Manager on Windows. Subsequent commands use the cached token automatically. This requires the default `login-session` feature and an available credential-store backend. Linux and BSD need a running Secret Service provider on the D-Bus session."},"793":{"id":"/docs/cli/start-39","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#login-sessions","content":"`iggy session status` only checks whether a token exists in the local keyring. An expired token **still reports as active**. On TCP, QUIC and WebSocket, run `iggy me` to verify the session against the server. HTTP does not support `me`. Use an authenticated command such as `iggy stream list` with the required permissions."},"794":{"id":"/docs/cli/start-40","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#personal-access-tokens","content":"Create a token once, then authenticate with it instead of a username and password:"},"795":{"id":"/docs/cli/start-41","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#personal-access-tokens","content":"`--store-token` is mutually exclusive with an expiry: stored tokens **never expire**. They're also **namespaced per server address**, so a token stored for one server isn't visible when connecting to another. Alternatively, create a token with an expiry and pass its value with `-t`:"},"796":{"id":"/docs/cli/start-42","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connection-contexts","content":"Contexts are named connection profiles (transport, addresses, TLS settings, credentials) for working with multiple environments. Subcommands: `list`, `use`, `create`, `delete`, `show`."},"797":{"id":"/docs/cli/start-43","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connection-contexts","content":"Creating and activating a context are two separate steps:"},"798":{"id":"/docs/cli/start-44","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connection-contexts","content":"There's no `--context` flag: the active context is persistent state, switched with `iggy context use <name>`. Flags passed on the command line override the corresponding values from the active context. Credential fields merge independently: supplying `--username` does not clear a context token, which still has higher authentication priority."},"799":{"id":"/docs/cli/start-45","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connection-contexts","content":"Contexts are stored in `contexts.toml`, and the active context name in `.active_context`, both under the Iggy home directory: `~/.iggy` by default, overridable with the `IGGY_HOME` environment variable. The `default` context always exists and **cannot be deleted or recreated through context commands**. Deleting the currently active context switches back to `default`. Context names may contain letters, digits, hyphens and underscores. Passwords and raw tokens supplied to `context create` are stored as plaintext in `contexts.toml` (owner-only permissions on Unix). Use a stored token name when the credential should stay in the keyring."},"800":{"id":"/docs/cli/start-46","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#shell-completions","content":"Generate completions for bash, zsh, fish, elvish or powershell with `--generate`:"},"801":{"id":"/docs/cli/start-47","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#shell-completions","content":"For zsh, add `~/.zfunc` to `fpath` before running `compinit` in your shell configuration."},"802":{"id":"/docs/clustering/client-failover","page_id":"/docs/clustering/client-failover","type":"page","content":"Client Failover","breadcrumbs":["Documentation","Clustering"],"tags":[],"url":"/docs/clustering/client-failover"},"803":{"id":"/docs/clustering/client-failover-0","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover","content":"Route requests to partition primaries and handle reconnects without losing an uncertain operation's identity."},"804":{"id":"/docs/clustering/client-failover-1","page_id":"/docs/clustering/client-failover","type":"heading","tags":[],"url":"/docs/clustering/client-failover#where-requests-are-served","content":"Where requests are served"},"805":{"id":"/docs/clustering/client-failover-2","page_id":"/docs/clustering/client-failover","type":"heading","tags":[],"url":"/docs/clustering/client-failover#reconnect-and-bind","content":"Reconnect and bind"},"806":{"id":"/docs/clustering/client-failover-3","page_id":"/docs/clustering/client-failover","type":"heading","tags":[],"url":"/docs/clustering/client-failover#retain-uncertain-mutations","content":"Retain uncertain mutations"},"807":{"id":"/docs/clustering/client-failover-4","page_id":"/docs/clustering/client-failover","type":"heading","tags":[],"url":"/docs/clustering/client-failover#consumer-progress","content":"Consumer progress"},"808":{"id":"/docs/clustering/client-failover-5","page_id":"/docs/clustering/client-failover","type":"heading","tags":[],"url":"/docs/clustering/client-failover#http-forwarding","content":"HTTP forwarding"},"809":{"id":"/docs/clustering/client-failover-6","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover","content":"A cluster has a metadata primary and separate partition primaries. SDKs discover both. Reaching the metadata primary does not mean that the same node owns every partition request."},"810":{"id":"/docs/clustering/client-failover-7","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#where-requests-are-served","content":"Metadata reads can use a replica's local state. A caller that needs a known metadata change can carry a minimum metadata operation and wait for that node to catch up. Counters on other nodes can lag a successful write until a later prepare or commit broadcast."},"811":{"id":"/docs/clustering/client-failover-8","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#where-requests-are-served","content":"Partition requests use the partition route. It identifies the primary, view, partition incarnation and metadata progress. An incarnation identifies one history of a partition. Recreating a partition changes that identity. Consumer group operations also carry an ownership generation, so a former member cannot store progress for a new owner."},"812":{"id":"/docs/clustering/client-failover-9","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#where-requests-are-served","content":"The SDK retains this context with a request. A route refresh does not replace the history of an already uncertain operation. `HistoryUnavailable` requires an application decision about the new history. Readers expose a seek operation to choose a new start."},"813":{"id":"/docs/clustering/client-failover-10","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#reconnect-and-bind","content":"Binary login registers a logical session and a binding secret. Additional connections and reconnects bind that session. The client can therefore keep connections to several partition primaries without creating an unrelated identity for every link."},"814":{"id":"/docs/clustering/client-failover-11","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#reconnect-and-bind","content":"A stale link does not always mean the logical session ended. The SDK closes that link and tries to bind again. A terminal session refusal requires new registration. Logout, session expiry and account deactivation end the session. A password or PAT change does not revoke a session already established with those credentials."},"815":{"id":"/docs/clustering/client-failover-12","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#reconnect-and-bind","content":"Advertised endpoints must be reachable from the client network. The SDK uses the endpoints returned by cluster metadata. See Configuration for network selectors and TLS names."},"816":{"id":"/docs/clustering/client-failover-13","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#retain-uncertain-mutations","content":"A request rejected before admission can be retried within its deadline. A lost reply after sending is different: the operation can already be committed. Retained-operation SDKs preserve its original identity and payload instead of submitting a fresh mutation."},"817":{"id":"/docs/clustering/client-failover-14","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#retain-uncertain-mutations","content":"Resolution requires a matching final committed-result proof. A successful status or a nonzero log position alone is insufficient. A committed business rejection is also a definitive result. An uncertain operation remains retained when resolution times out."},"818":{"id":"/docs/clustering/client-failover-15","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#retain-uncertain-mutations","content":"`resolve_operation` and its language equivalents retry a retained mutation. `abandon_operation` frees local state without undoing or determining the server result. `OperationNotRetained` does not prove that nothing committed. Keep the same client for recovery and handle the error before retrying application work."},"819":{"id":"/docs/clustering/client-failover-16","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#retain-uncertain-mutations","content":"Once the original session ends, the client cannot recover its receipt through a new login. Bounded client retention can also prevent recovery. The SDK guides describe each language's error types and limits. Swift does not expose retained mutation resolution."},"820":{"id":"/docs/clustering/client-failover-17","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#consumer-progress","content":"Use checkpoint commits after processing. A checkpoint retains the partition history and owner that delivered the data. Committing only a numeric offset loses that context."},"821":{"id":"/docs/clustering/client-failover-18","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#consumer-progress","content":"A committing deferred read can lose its reply after storing an offset. The client reports uncertain fetch progress and blocks affected progress calls until recovery or explicit abandonment. Stateless reads and offset inspection remain available. Abandonment does not roll back a stored offset."},"822":{"id":"/docs/clustering/client-failover-19","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#consumer-progress","content":"Readers group targets by primary and refresh routes after changes. They can stop a partition on a history change or an undecodable message. Inspect the reported error before seeking past it."},"823":{"id":"/docs/clustering/client-failover-20","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#http-forwarding","content":"A contacted HTTP node can forward to the correct primary in one hop. The route and request carry a signed relay proof, and the destination authenticates the bearer independently. Configure shared JWT key material and synchronize clocks. Proofs expire after ten seconds."},"824":{"id":"/docs/clustering/client-failover-21","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#http-forwarding","content":"Forwarding does not make every ambiguous operation safe to replay. HTTP `ack=none` confirms dispatch only. A deferred read that commits uses POST, and a lost reply can leave its progress uncertain. See Cluster security."},"825":{"id":"/docs/clustering/configuration","page_id":"/docs/clustering/configuration","type":"page","content":"Cluster Configuration","breadcrumbs":["Documentation","Clustering"],"tags":[],"url":"/docs/clustering/configuration"},"826":{"id":"/docs/clustering/configuration-0","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration","content":"Reference for the [cluster] settings, consensus timing, and node roster"},"827":{"id":"/docs/clustering/configuration-1","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#top-level-settings","content":"Top-level settings"},"828":{"id":"/docs/clustering/configuration-2","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#consensus-timing","content":"Consensus timing"},"829":{"id":"/docs/clustering/configuration-3","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#validation-rules","content":"Validation rules"},"830":{"id":"/docs/clustering/configuration-4","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#default-replication-factor","content":"Default replication factor"},"831":{"id":"/docs/clustering/configuration-5","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#superblock-failure-handling","content":"Superblock failure handling"},"832":{"id":"/docs/clustering/configuration-6","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#coordinator-placement","content":"Coordinator placement"},"833":{"id":"/docs/clustering/configuration-7","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#node-roster","content":"Node roster"},"834":{"id":"/docs/clustering/configuration-8","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#name","content":"`name`"},"835":{"id":"/docs/clustering/configuration-9","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#ip","content":"`ip`"},"836":{"id":"/docs/clustering/configuration-10","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#replica_id","content":"`replica_id`"},"837":{"id":"/docs/clustering/configuration-11","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#ports","content":"`ports`"},"838":{"id":"/docs/clustering/configuration-12","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#advertised_address","content":"`advertised_address`"},"839":{"id":"/docs/clustering/configuration-13","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#advertised_addresses","content":"`advertised_addresses`"},"840":{"id":"/docs/clustering/configuration-14","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#authentication-and-tls","content":"Authentication and TLS"},"841":{"id":"/docs/clustering/configuration-15","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration","content":"All clustering settings live in the `[cluster]` section of the server configuration. The authoritative defaults with detailed comments are in `core/server/config.toml`. Every value can also be set through an `IGGY_`-prefixed environment variable, for example `IGGY_CLUSTER_ENABLED=true` or `IGGY_CLUSTER_NODES_0_IP=10.0.1.5`."},"842":{"id":"/docs/clustering/configuration-16","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration","content":"With clustering enabled, the server validates the section at boot and **refuses to start** on an invalid value, printing the rule that failed. The repair chunk limit and superblock failure timeout are validated even when clustering is disabled."},"843":{"id":"/docs/clustering/configuration-17","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"| Setting   | Default | Purpose                                                                                                     |\n| --------- | ------- | ----------------------------------------------------------------------------------------------------------- |\n| `enabled` | `false` | Enables cluster mode. When disabled, the node runs single-node and the rest of the section is mostly inert. |","table":"table-0"},"844":{"id":"/docs/clustering/configuration-18","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"| Setting | Default          | Purpose                                                                                    |\n| ------- | ---------------- | ------------------------------------------------------------------------------------------ |\n| `name`  | `\"iggy-cluster\"` | Unique cluster name shared by every node. Prevents accidental cross-cluster communication. |","table":"table-0"},"845":{"id":"/docs/clustering/configuration-19","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"> `cluster.name` is a **permanent on-disk identity**, not a label. It's hashed into the cluster id stamped into every metadata and partition superblock on first boot, and the consensus layer derives its cluster id from the name unconditionally. Nodes with different names cannot connect to each other, and changing the name later makes the server refuse to start against existing data."},"846":{"id":"/docs/clustering/configuration-20","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Consensus runs on a **fixed 10ms tick**. Every duration below is converted to whole ticks: values are **rounded down** to a multiple of 10ms, and anything under 10ms is raised to a single tick rather than firing sooner. `repair_gap_debounce_interval` has an additional 500ms floor."},"847":{"id":"/docs/clustering/configuration-21","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"| Setting             | Default | Purpose                                                                                           |\n| ------------------- | ------- | ------------------------------------------------------------------------------------------------- |\n| `heartbeat_timeout` | `5s`    | Backup liveness window: a replica that sees no primary traffic for this long starts a view change |","table":"table-1"},"848":{"id":"/docs/clustering/configuration-22","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"| Setting                     | Default | Purpose                                                                                            |\n| --------------------------- | ------- | -------------------------------------------------------------------------------------------------- |\n| `commit_broadcast_interval` | `500ms` | How often the primary broadcasts its commit point. This broadcast is the cluster's liveness signal |","table":"table-1"},"849":{"id":"/docs/clustering/configuration-23","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"| Setting                       | Default | Purpose                                           |\n| ----------------------------- | ------- | ------------------------------------------------- |\n| `prepare_retransmit_interval` | `250ms` | Retry prepares that backups have not acknowledged |","table":"table-1"},"850":{"id":"/docs/clustering/configuration-24","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"| Setting                           | Default | Purpose                                                                     |\n| --------------------------------- | ------- | --------------------------------------------------------------------------- |\n| `view_change_retransmit_interval` | `500ms` | Retry `StartViewChange` / `DoViewChange` while a view change is in progress |","table":"table-1"},"851":{"id":"/docs/clustering/configuration-25","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"| Setting                      | Default | Purpose                                                                              |\n| ---------------------------- | ------- | ------------------------------------------------------------------------------------ |\n| `view_change_status_timeout` | `5s`    | Escalate a view change that does not conclude within this window to a fresh election |","table":"table-1"},"852":{"id":"/docs/clustering/configuration-26","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"| Setting                                  | Default | Purpose                                                                   |\n| ---------------------------------------- | ------- | ------------------------------------------------------------------------- |\n| `request_start_view_retransmit_interval` | `1s`    | How often a recovering replica re-requests the current view's `StartView` |","table":"table-1"},"853":{"id":"/docs/clustering/configuration-27","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"| Setting                   | Default | Purpose                                                                                                |\n| ------------------------- | ------- | ------------------------------------------------------------------------------------------------------ |\n| `view_probe_attempts_max` | `5`     | Unanswered `RequestStartView` probes a recovering replica tolerates before falling back to an election |","table":"table-1"},"854":{"id":"/docs/clustering/configuration-28","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"| Setting                 | Default | Purpose                                                                                  |\n| ----------------------- | ------- | ---------------------------------------------------------------------------------------- |\n| `repair_retry_interval` | `1s`    | How long a stalled journal-repair stream waits before re-requesting its remaining window |","table":"table-1"},"855":{"id":"/docs/clustering/configuration-29","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"| Setting                        | Default | Purpose                                                                                  |\n| ------------------------------ | ------- | ---------------------------------------------------------------------------------------- |\n| `repair_gap_debounce_interval` | `1s`    | How long a committed-history gap waits before opening a repair session. Floored at 500ms |","table":"table-1"},"856":{"id":"/docs/clustering/configuration-30","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"| Setting            | Default | Purpose                                 |\n| ------------------ | ------- | --------------------------------------- |\n| `repair_chunk_max` | `128`   | Prepares a peer serves per repair round |","table":"table-1"},"857":{"id":"/docs/clustering/configuration-31","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Raise `heartbeat_timeout` on oversubscribed hosts where scheduling stalls fake primary death. Otherwise keep the defaults unless tests show a specific scheduling or network problem."},"858":{"id":"/docs/clustering/configuration-32","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#validation-rules","content":"Boot-time validation enforces these constraints:"},"859":{"id":"/docs/clustering/configuration-33","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#validation-rules","content":"Every duration must be **nonzero**. The `0`, `disabled`, and `unlimited` sentinels all parse to a zero duration and are rejected. There's no way to switch the liveness window off."},"860":{"id":"/docs/clustering/configuration-34","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#validation-rules","content":"`heartbeat_timeout` must be at least `2s` and at least 4x `commit_broadcast_interval`, so one delayed broadcast never trips an election on a healthy primary."},"861":{"id":"/docs/clustering/configuration-35","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#validation-rules","content":"`view_change_status_timeout` must be at least 4x `view_change_retransmit_interval`, so a few dropped view-change messages retransmit instead of escalating into a fresh cluster-wide election."},"862":{"id":"/docs/clustering/configuration-36","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#validation-rules","content":"`view_probe_attempts_max` must be between 1 and 100."},"863":{"id":"/docs/clustering/configuration-37","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#validation-rules","content":"`repair_chunk_max` must be between 1 and 1024, and strictly below `message_bus.peer_queue_capacity`: each repair frame rides the per-peer message-bus queue, and a full round above that capacity would overrun the queue and drop frames."},"864":{"id":"/docs/clustering/configuration-38","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#default-replication-factor","content":"`cluster.default_replication_factor` defaults to `\"all\"`. It applies to new topics whose creation request omits `replication_factor`. An explicit value must be from 1 through 32 and no greater than the cluster node count. The resolved value is stored with the topic. Changing this default does not change existing topics."},"865":{"id":"/docs/clustering/configuration-39","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#default-replication-factor","content":"See Multi-leader partitions for primary placement and the availability consequences of each factor."},"866":{"id":"/docs/clustering/configuration-40","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#superblock-failure-handling","content":"`superblock_wedged_fatal_timeout` defaults to `2m`. It controls how long repeated superblock persistence failures can continue before the process exits. The affected consensus group stays fenced while persistence is failing. `0`, `disabled`, or `unlimited` disables the process exit, leaving the group fenced. A nonzero value must be at least `30s`."},"867":{"id":"/docs/clustering/configuration-41","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#coordinator-placement","content":"These settings live under `[cluster.coordinator]` and apply when the server has more than one shard:"},"868":{"id":"/docs/clustering/configuration-42","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#coordinator-placement","content":"| Setting                        | Default | Purpose                                                      |\n| ------------------------------ | ------- | ------------------------------------------------------------ |\n| `skip_shard_zero_for_replicas` | `true`  | Places replica connections on peer shards instead of shard 0 |","table":"table-2"},"869":{"id":"/docs/clustering/configuration-43","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#coordinator-placement","content":"| Setting                        | Default | Purpose                                                     |\n| ------------------------------ | ------- | ----------------------------------------------------------- |\n| `replica_connections_per_peer` | `1`     | Replica links per peer. Every node must use the same value. |","table":"table-2"},"870":{"id":"/docs/clustering/configuration-44","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#coordinator-placement","content":"| Setting                       | Default | Purpose                                                         |\n| ----------------------------- | ------- | --------------------------------------------------------------- |\n| `skip_shard_zero_for_clients` | `false` | When enabled, excludes shard 0 from client connection placement |","table":"table-2"},"871":{"id":"/docs/clustering/configuration-45","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#node-roster","content":"`cluster.nodes` is the full roster of cluster members and is intended to be **byte-identical on every node**. The running node finds its own entry through the `--replica-id` CLI flag. Environment variables replace the entire `cluster.nodes` array rather than merging individual fields into TOML entries. If you configure any roster entry through environment variables, provide the complete roster that way."},"872":{"id":"/docs/clustering/configuration-46","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#name","content":"Node name, unique within the roster and non-empty."},"873":{"id":"/docs/clustering/configuration-47","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#ip","content":"The node's roster address. Replica-to-replica consensus traffic and follower-to-primary HTTP forwarding dial it, so it must be a **literal IPv4 or IPv6 address**. Hostnames and unspecified addresses (`0.0.0.0` or `::`) are rejected when the server resolves the roster at startup."},"874":{"id":"/docs/clustering/configuration-48","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#ip","content":"`ip` is **not the bind interface** for the client transports. `tcp`, `quic`, `http`, and `websocket` bind whatever their own `address` settings say. The roster supplies only their ports. The defaults bind loopback, so a cluster spread across hosts needs each transport's `address` set to `0.0.0.0` or the routable interface. The server warns at startup when a bind cannot serve the advertised `ip`."},"875":{"id":"/docs/clustering/configuration-49","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#replica_id","content":"Numeric replica id for VSR consensus, `0`-based. Ids must be unique and strictly less than the roster size, which makes them contiguous from `0`. Rosters with more than 32 replicas are rejected at startup."},"876":{"id":"/docs/clustering/configuration-50","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#ports","content":"Per-node listener ports: `tcp`, `quic`, `http`, `websocket`, and `tcp_replica`. In cluster mode `ports` is the **single source of listener ports**: every enabled transport needs an explicit per-node port, otherwise the server refuses to start. `tcp` and `tcp_replica` are always required, even when client TCP is disabled. `tcp_replica` carries consensus traffic. Port `0` is rejected, and no two roster entries may claim the same `ip:port`."},"877":{"id":"/docs/clustering/configuration-51","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_address","content":"Optional client-facing address handed out in cluster metadata and leader redirects. Set it when `ip` is a private replica-network address unreachable by clients (Docker, Kubernetes, NAT). Accepts a literal IP or an RFC 1123 DNS hostname: ASCII letters, digits, `-` and `.`, no port, no trailing dot. When unset, clients receive `ip`."},"878":{"id":"/docs/clustering/configuration-52","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Per-client-network overrides for split networks, where one catch-all `advertised_address` would route in-VPC clients out through the public side:"},"879":{"id":"/docs/clustering/configuration-53","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Clients whose transport-level peer IP falls inside `client_cidr` are handed `address` instead of the catch-all. The **longest matching prefix** wins. Clients matching no selector fall back to `advertised_address`, then `ip`. `address` takes the same forms as `advertised_address` (literal IP or hostname, never a port)."},"880":{"id":"/docs/clustering/configuration-54","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Rules and caveats:"},"881":{"id":"/docs/clustering/configuration-55","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"At most 16 selectors per node. Boot rejects duplicate `client_cidr` entries on one node (compared truncated, so `10.0.1.0/16` duplicates `10.0.0.0/16`) and any two nodes advertising one `host:port` to overlapping client sets."},"882":{"id":"/docs/clustering/configuration-56","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Matching is **per address family**: `0.0.0.0/0` matches no IPv6 client and `::/0` matches no IPv4 client, so covering both families takes one selector per family. IPv4-mapped IPv6 CIDRs (`::ffff:10.0.0.0/104`) match like their IPv4 form only at prefix length 96 or longer."},"883":{"id":"/docs/clustering/configuration-57","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Matching sees the transport-level peer address, so clients behind a proxy or load balancer match the proxy's network, not their own."},"884":{"id":"/docs/clustering/configuration-58","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Every `address` must be routable from inside its own `client_cidr`: leader-aware clients redial whatever address metadata advertises, and a selector pointing at an unreachable host strands them mid-redirect."},"885":{"id":"/docs/clustering/configuration-59","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Prefer literal IPs over hostnames. SDKs differ in how they compare an advertised hostname against the address they dialed, and a mismatch costs a reconnect on every fresh connect."},"886":{"id":"/docs/clustering/configuration-60","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Every node must run the same server version. Do not mix 0.9 and 0.10 nodes during an upgrade."},"887":{"id":"/docs/clustering/configuration-61","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#authentication-and-tls","content":"`[cluster.auth]` configures the pre-shared-key replica handshake and `[cluster.tls]` wraps replica connections in TLS. Both are covered in Security."},"888":{"id":"/docs/clustering/deploy","page_id":"/docs/clustering/deploy","type":"page","content":"Deploy a Cluster","breadcrumbs":["Documentation","Clustering"],"tags":[],"url":"/docs/clustering/deploy"},"889":{"id":"/docs/clustering/deploy-0","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy","content":"Build the binaries and run a three-node Apache Iggy cluster"},"890":{"id":"/docs/clustering/deploy-1","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#build-from-source","content":"Build from source"},"891":{"id":"/docs/clustering/deploy-2","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#run-one-development-node","content":"Run one development node"},"892":{"id":"/docs/clustering/deploy-3","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"Run a three-node cluster"},"893":{"id":"/docs/clustering/deploy-4","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#spanning-multiple-hosts","content":"Spanning multiple hosts"},"894":{"id":"/docs/clustering/deploy-5","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#containers","content":"Containers"},"895":{"id":"/docs/clustering/deploy-6","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#check-cluster-metadata","content":"Check cluster metadata"},"896":{"id":"/docs/clustering/deploy-7","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#reset-a-replica","content":"Reset a replica"},"897":{"id":"/docs/clustering/deploy-8","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#run-the-cluster-test-suites","content":"Run the cluster test suites"},"898":{"id":"/docs/clustering/deploy-9","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy","content":"Build `iggy-server` and the `iggy` CLI, run a single development node, then bring up a three-node cluster on one machine. See Configuration for the full `[cluster]` reference."},"899":{"id":"/docs/clustering/deploy-10","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#build-from-source","content":"Build the server and CLI from the repository root:"},"900":{"id":"/docs/clustering/deploy-11","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#build-from-source","content":"The binaries are:"},"901":{"id":"/docs/clustering/deploy-12","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#build-from-source","content":"The server uses Linux `io_uring`. Use a recent Linux kernel and a sufficient locked-memory limit."},"902":{"id":"/docs/clustering/deploy-13","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-one-development-node","content":"The default `core/server/config.toml` has clustering disabled, so a plain run starts a single node:"},"903":{"id":"/docs/clustering/deploy-14","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-one-development-node","content":"`--with-default-root-credentials` sets the root user to `iggy`/`iggy` unless `IGGY_ROOT_USERNAME` and `IGGY_ROOT_PASSWORD` are already exported. These values initialize the root user **only on its first creation**. Later starts recover the stored user. Supplied environment values are still validated at boot."},"904":{"id":"/docs/clustering/deploy-15","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-one-development-node","content":"When clustering is disabled, `--replica-id 0` is still accepted. Any other id is rejected because it would have to match a `cluster.nodes` entry."},"905":{"id":"/docs/clustering/deploy-16","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"Every node loads the same configuration. Nodes are told apart *only* by `--replica-id`, which selects that node's own entry in the `cluster.nodes` roster."},"906":{"id":"/docs/clustering/deploy-17","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"Save this as `/tmp/iggy-vsr.toml`:"},"907":{"id":"/docs/clustering/deploy-18","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"> `cluster.name` is a **permanent on-disk identity**. It is hashed into the cluster id stamped into every metadata and partition superblock on first boot. Changing the name later makes the server **refuse to start** against the existing data, so renaming a cluster means starting from an empty data directory."},"908":{"id":"/docs/clustering/deploy-19","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"Export the settings shared by all three processes:"},"909":{"id":"/docs/clustering/deploy-20","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"Root credentials are **mandatory on the first boot of each replica** when clustering is enabled. Restarts recover the stored root user. The shared secret must be **at least 32 bytes**. See Security for how it's used and rotated."},"910":{"id":"/docs/clustering/deploy-21","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"Start each replica in a separate terminal. Use a different data path for every process:"},"911":{"id":"/docs/clustering/deploy-22","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"The exported settings must be present in all three terminals."},"912":{"id":"/docs/clustering/deploy-23","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"In cluster mode:"},"913":{"id":"/docs/clustering/deploy-24","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"`--replica-id` is required and must match exactly one `cluster.nodes` entry"},"914":{"id":"/docs/clustering/deploy-25","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"`replica_id` values must be unique and contiguous from `0`"},"915":{"id":"/docs/clustering/deploy-26","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"`ports` is the single source of listener ports: every enabled transport needs an explicit per-node port, otherwise the server **refuses to start**"},"916":{"id":"/docs/clustering/deploy-27","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"`tcp` and `tcp_replica` ports are **always required**, even when client TCP is disabled. `tcp_replica` carries replica-to-replica consensus traffic"},"917":{"id":"/docs/clustering/deploy-28","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"`ip` must be a **literal IP address**. Use `advertised_address` when clients can't reach it (see Configuration)"},"918":{"id":"/docs/clustering/deploy-29","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"use a different root `path` for each process on the same host"},"919":{"id":"/docs/clustering/deploy-30","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#spanning-multiple-hosts","content":"The roster `ip` is the address other replicas dial. It's **not the bind interface** for the client transports: `tcp`, `quic`, `http`, and `websocket` bind whatever their own `address` settings say, and the roster supplies only the port. The defaults listen on loopback, so a cluster spread across hosts needs each transport's `address` set to `0.0.0.0` or the routable interface. The server warns at startup when a bind cannot serve the advertised `ip`."},"920":{"id":"/docs/clustering/deploy-31","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#containers","content":"Every roster field can be provided through typed environment variables instead of TOML, which suits container deployments:"},"921":{"id":"/docs/clustering/deploy-32","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#containers","content":"Give each container a static IP and put that IP in the roster: `cluster.nodes[*].ip` does **not** accept hostnames or Docker service names. The repository ships a working reference in `bdd/docker-compose.cluster.yml`, a real two-node cluster used by the BDD suites."},"922":{"id":"/docs/clustering/deploy-33","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#check-cluster-metadata","content":"Ask any node for the cluster state with the CLI:"},"923":{"id":"/docs/clustering/deploy-34","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#check-cluster-metadata","content":"The response lists the cluster name, nodes, client endpoints, and current roles. `cluster m` is a shorthand for `cluster metadata`."},"924":{"id":"/docs/clustering/deploy-35","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#reset-a-replica","content":"`iggy-server --fresh` deletes the configured data directory before boot. In cluster mode this wipes **that replica only**: it rejoins the cluster and refills its state by transfer from the other replicas. Wiping a quorum of replicas at the same time **destroys committed data**, and a service unit that always passes `--fresh` re-transfers the whole dataset on every restart."},"925":{"id":"/docs/clustering/deploy-36","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-the-cluster-test-suites","content":"The cross-SDK BDD suites use a standalone server for basic features and add the two-node cluster from `bdd/docker-compose.cluster.yml` for `leader_redirection` or `all`:"},"926":{"id":"/docs/clustering/deploy-37","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-the-cluster-test-suites","content":"The first argument selects the SDK (`rust`, `python`, `php`, `go`, `go-race`, `node`, `csharp`, `java`, `cpp`, `swift`, or `all`) and the optional second argument selects one feature (`basic_messaging`, `leader_redirection`, `raw_command`, `session_contract`, `stream_crud`, `stream_options`, `resource_options_patch`, `metadata_changes`, `deferred_polling`, or `all`). `leader_redirection` is the clustered feature. Coverage depends on the selected SDK and feature. Use `--help` for the runner's current selections."},"927":{"id":"/docs/clustering/durability","page_id":"/docs/clustering/durability","type":"page","content":"Cluster Durability","breadcrumbs":["Documentation","Clustering"],"tags":[],"url":"/docs/clustering/durability"},"928":{"id":"/docs/clustering/durability-0","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability","content":"Quorum completion, persisted prepare history, and the failures each topic policy covers."},"929":{"id":"/docs/clustering/durability-1","page_id":"/docs/clustering/durability","type":"heading","tags":[],"url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"What an acknowledgement means"},"930":{"id":"/docs/clustering/durability-2","page_id":"/docs/clustering/durability","type":"heading","tags":[],"url":"/docs/clustering/durability#replicated-completion","content":"Replicated completion"},"931":{"id":"/docs/clustering/durability-3","page_id":"/docs/clustering/durability","type":"heading","tags":[],"url":"/docs/clustering/durability#persisted-completion","content":"Persisted completion"},"932":{"id":"/docs/clustering/durability-4","page_id":"/docs/clustering/durability","type":"heading","tags":[],"url":"/docs/clustering/durability#recovery-and-failure-limits","content":"Recovery and failure limits"},"933":{"id":"/docs/clustering/durability-5","page_id":"/docs/clustering/durability","type":"heading","tags":[],"url":"/docs/clustering/durability#choosing-the-policies","content":"Choosing the policies"},"934":{"id":"/docs/clustering/durability-6","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability","content":"Iggy uses Viewstamped Replication to commit partition operations. The topic's `durability` and `consumer_offset_durability` options select the storage guarantee required for message production and explicit offset changes, respectively. Both default independently to `replicated`. Both continue to write data to disk."},"935":{"id":"/docs/clustering/durability-7","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability","content":"For the creation options and single-node behavior, see Durability."},"936":{"id":"/docs/clustering/durability-8","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"For an operation that waits for completion:"},"937":{"id":"/docs/clustering/durability-9","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"| Policy       | Required before success                                                               |\n| ------------ | ------------------------------------------------------------------------------------- |\n| `replicated` | VSR quorum commit and local application, without an additional stable-storage barrier |","table":"table-0"},"938":{"id":"/docs/clustering/durability-10","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"| Policy      | Required before success                                                                                             |\n| ----------- | ------------------------------------------------------------------------------------------------------------------- |\n| `persisted` | VSR quorum commit backed by recoverable stable-storage copies at the required quorum, followed by local application |","table":"table-0"},"939":{"id":"/docs/clustering/durability-11","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"The policy changes what a replica must retain before its acknowledgement can count toward commit. It does not replace quorum commit with a primary-only disk write."},"940":{"id":"/docs/clustering/durability-12","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"Iggy's replication quorum is not a strict majority for every group size:"},"941":{"id":"/docs/clustering/durability-13","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"| Replicas | Replication quorum | View-change quorum |\n| -------- | ------------------ | ------------------ |\n| 1        | 1                  | 1                  |","table":"table-1"},"942":{"id":"/docs/clustering/durability-14","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"| Replicas | Replication quorum | View-change quorum |\n| -------- | ------------------ | ------------------ |\n| 2        | 2                  | 2                  |","table":"table-1"},"943":{"id":"/docs/clustering/durability-15","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"| Replicas | Replication quorum | View-change quorum |\n| -------- | ------------------ | ------------------ |\n| 3        | 2                  | 2                  |","table":"table-1"},"944":{"id":"/docs/clustering/durability-16","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"| Replicas | Replication quorum | View-change quorum |\n| -------- | ------------------ | ------------------ |\n| 4        | 2                  | 3                  |","table":"table-1"},"945":{"id":"/docs/clustering/durability-17","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"| Replicas | Replication quorum | View-change quorum |\n| -------- | ------------------ | ------------------ |\n| 5        | 3                  | 3                  |","table":"table-1"},"946":{"id":"/docs/clustering/durability-18","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"| Replicas | Replication quorum | View-change quorum |\n| -------- | ------------------ | ------------------ |\n| 6        | 3                  | 4                  |","table":"table-1"},"947":{"id":"/docs/clustering/durability-19","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"Except for two replicas, the replication quorum is `min(ceil(n / 2), 3)` and the view-change quorum is `n - replication_quorum + 1`. Two replicas require both for either quorum. The quorums therefore intersect. These are the implemented quorum rules, not a configurable acknowledgement count."},"948":{"id":"/docs/clustering/durability-20","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#replicated-completion","content":"With both policies set to `replicated`, partition prepares stay off the disk prepare-WAL path. Replicas retain the prepares in memory, and committed messages reach segment files through ordinary flush scheduling."},"949":{"id":"/docs/clustering/durability-21","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#replicated-completion","content":"Success therefore does not prove that the operation reached stable storage on any replica. Replication protects against failures while sufficient peers retain the history and can form the quorums needed for recovery and progress. For example, a healthy three-replica group can continue after one replica fails."},"950":{"id":"/docs/clustering/durability-22","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#replicated-completion","content":"Failure independence matters. A shared power loss, an OOM cascade, or a crash triggered on every replica can destroy multiple volatile copies at once. A process-only failure can lose messages still in the processes' journals, even while the kernels and their page caches remain alive. Replication count alone does not establish a bound on that loss."},"951":{"id":"/docs/clustering/durability-23","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#persisted-completion","content":"When either policy is `persisted`, each multi-replica partition uses a bounded on-disk prepare WAL. Message prepares contain headers and segment references. Their payloads live in segment files retained by hard links until the WAL history can be reclaimed. Other operations are stored inline. A prepare requiring persistence cannot release its `PrepareOk` until its message bodies, WAL history, and durable frontier are recoverable."},"952":{"id":"/docs/clustering/durability-24","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#persisted-completion","content":"Prepares can be forwarded while local persistence is pending. Once enough replicas have met the required barrier, the operation can commit and the primary can apply it and reply. An acknowledged message can be recovered through the WAL before ordinary segment materialization and index updates finish. Recovery does not depend on first reaching a segment flush threshold."},"953":{"id":"/docs/clustering/durability-25","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#persisted-completion","content":"The WAL also retains predecessors across message and offset operations. Consequently:"},"954":{"id":"/docs/clustering/durability-26","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#persisted-completion","content":"`durability=persisted` does not make an offset response persisted when `consumer_offset_durability=replicated`."},"955":{"id":"/docs/clustering/durability-27","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#persisted-completion","content":"`consumer_offset_durability=persisted` with replicated messages still retains message payloads through WAL segment references. A durable offset's predecessor history must remain recoverable."},"956":{"id":"/docs/clustering/durability-28","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#persisted-completion","content":"A shared barrier can also persist co-batched operations with the weaker policy. That incidental persistence does not strengthen what their earlier `replicated` acknowledgements promised."},"957":{"id":"/docs/clustering/durability-29","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#persisted-completion","content":"Only the `replicated` / `replicated` combination avoids the disk prepare WAL entirely."},"958":{"id":"/docs/clustering/durability-30","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#persisted-completion","content":"WAL history is reclaimed only after the materialized segment and offset state needed to replace it has been synchronized. The server's `[partition] wal_bytes_max` setting, default `256 MiB`, bounds retained and queued/in-flight prepare bytes per partition. The accounting includes message bodies even when the WAL stores only references to them. Capacity pressure causes checkpointing and backpressure. It does not downgrade a persisted operation. Temporary rewrites need additional disk space."},"959":{"id":"/docs/clustering/durability-31","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#recovery-and-failure-limits","content":"A restarting replica loads segment and offset state and, when enabled, reconciles the durable prepare WAL with that state. It also restores durable consensus state and follows the recovery protocol before serving as a healthy replica. It does not treat every locally recovered prepare as committed."},"960":{"id":"/docs/clustering/durability-32","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#recovery-and-failure-limits","content":"Missing required history, checksum failures, or contradictory materialized state must not become an empty healthy partition. Recovery can fence a partition and repair it from peers. Storage errors withhold successful completion. A locally failed application of a committed operation fences the partition and initiates server shutdown."},"961":{"id":"/docs/clustering/durability-33","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#recovery-and-failure-limits","content":"`persisted` protects acknowledged operations across process and power failures when the required storage copies remain intact and the storage honors synchronization. Recovery and availability still require the protocol's quorums. It cannot protect against destruction of all durable copies, nor does it prevent configured retention or explicit deletion."},"962":{"id":"/docs/clustering/durability-34","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#choosing-the-policies","content":"Use `replicated` when the workload accepts the risk of losing acknowledged operations after correlated failures in exchange for avoiding a required storage barrier at completion. Isolate replicas across failure domains. See Deployment."},"963":{"id":"/docs/clustering/durability-35","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#choosing-the-policies","content":"Use `durability=persisted` when acknowledged messages must be recoverable after volatile copies are lost. Select `consumer_offset_durability=persisted` independently when explicit offset stores and deletes need the same guarantee. Ordinary flush thresholds can remain at their defaults."},"964":{"id":"/docs/clustering/durability-36","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#choosing-the-policies","content":"Neither policy turns HTTP `ack=none` or a poll's auto-commit into an awaited durable result. See Which responses prove completion."},"965":{"id":"/docs/clustering/durability-37","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#choosing-the-policies","content":"The storage mechanisms are implemented in the partition persistence worker and prepare journal. The crash-recovery tests exercise acknowledged persisted messages and offsets below ordinary flush thresholds, on both a singleton and a three-replica cluster."},"966":{"id":"/docs/clustering/multi-leader","page_id":"/docs/clustering/multi-leader","type":"page","content":"Multi-Leader Partitions","breadcrumbs":["Documentation","Clustering"],"tags":[],"url":"/docs/clustering/multi-leader"},"967":{"id":"/docs/clustering/multi-leader-0","page_id":"/docs/clustering/multi-leader","tags":[],"type":"text","url":"/docs/clustering/multi-leader","content":"How partition primaries, replication factors and client routing distribute work across Iggy nodes."},"968":{"id":"/docs/clustering/multi-leader-1","page_id":"/docs/clustering/multi-leader","type":"heading","tags":[],"url":"/docs/clustering/multi-leader#place-partition-primaries","content":"Place partition primaries"},"969":{"id":"/docs/clustering/multi-leader-2","page_id":"/docs/clustering/multi-leader","type":"heading","tags":[],"url":"/docs/clustering/multi-leader#select-copies-per-topic","content":"Select copies per topic"},"970":{"id":"/docs/clustering/multi-leader-3","page_id":"/docs/clustering/multi-leader","type":"heading","tags":[],"url":"/docs/clustering/multi-leader#route-clients","content":"Route clients"},"971":{"id":"/docs/clustering/multi-leader-4","page_id":"/docs/clustering/multi-leader","type":"heading","tags":[],"url":"/docs/clustering/multi-leader#operate-the-cluster","content":"Operate the cluster"},"972":{"id":"/docs/clustering/multi-leader-5","page_id":"/docs/clustering/multi-leader","tags":[],"type":"text","url":"/docs/clustering/multi-leader","content":"A primary orders writes for one consensus group. Iggy has one metadata group and a separate group for each partition. Multi-leader partitions let different nodes lead different partitions at the same time."},"973":{"id":"/docs/clustering/multi-leader-6","page_id":"/docs/clustering/multi-leader","tags":[],"type":"text","url":"/docs/clustering/multi-leader#place-partition-primaries","content":"New partitions spread their primaries across eligible nodes. The metadata primary also rebalances existing primaries one at a time. This restores the distribution after changes such as a failed node returning. Each partition still has one primary at a time, and its messages retain a partition-local order."},"974":{"id":"/docs/clustering/multi-leader-7","page_id":"/docs/clustering/multi-leader","tags":[],"type":"text","url":"/docs/clustering/multi-leader#place-partition-primaries","content":"Metadata leadership does not tell a client where every message write belongs. Clients discover a partition's current primary and send partition requests there. A route also identifies the partition's history and ownership generation, so an old request cannot act on a replacement partition."},"975":{"id":"/docs/clustering/multi-leader-8","page_id":"/docs/clustering/multi-leader","tags":[],"type":"text","url":"/docs/clustering/multi-leader#select-copies-per-topic","content":"`replication_factor` selects how many nodes store each partition of a topic. The value is fixed at topic creation. It must be from 1 through 32 and no greater than the cluster node count."},"976":{"id":"/docs/clustering/multi-leader-9","page_id":"/docs/clustering/multi-leader","tags":[],"type":"text","url":"/docs/clustering/multi-leader#select-copies-per-topic","content":"When the request omits it, `cluster.default_replication_factor` applies. Its default is `all`. The metadata group always uses the full cluster roster. A topic with fewer copies does not reduce the metadata quorum requirement."},"977":{"id":"/docs/clustering/multi-leader-10","page_id":"/docs/clustering/multi-leader","tags":[],"type":"text","url":"/docs/clustering/multi-leader#select-copies-per-topic","content":"This configuration requires at least three cluster nodes. A topic can override it at creation. Increasing the number of partitions does not change the factor."},"978":{"id":"/docs/clustering/multi-leader-11","page_id":"/docs/clustering/multi-leader","tags":[],"type":"text","url":"/docs/clustering/multi-leader#select-copies-per-topic","content":"A factor of one provides no replica redundancy. A factor of two stops writes when either copy is unavailable. With three copies, the partition can tolerate one unavailable replica. See Durability for the quorum rules and persistence policies."},"979":{"id":"/docs/clustering/multi-leader-12","page_id":"/docs/clustering/multi-leader","tags":[],"type":"text","url":"/docs/clustering/multi-leader#route-clients","content":"Rust, Go, Java, C# and Node.js have native partition routing. Python, C++ and PHP use the Rust SDK through bindings. Swift has its own TCP client. Follow the individual SDK guides for supported recovery operations."},"980":{"id":"/docs/clustering/multi-leader-13","page_id":"/docs/clustering/multi-leader","tags":[],"type":"text","url":"/docs/clustering/multi-leader#route-clients","content":"HTTP can forward a request to the correct primary in one hop. It needs the cluster authentication and shared JWT configuration described in Security. Keep clocks synchronized because forwarding proofs expire after ten seconds."},"981":{"id":"/docs/clustering/multi-leader-14","page_id":"/docs/clustering/multi-leader","tags":[],"type":"text","url":"/docs/clustering/multi-leader#operate-the-cluster","content":"Every node must run the same server version and the same `cluster.coordinator.replica_connections_per_peer`. There is no rolling upgrade between 0.9 and 0.10. The roster supports at most 32 nodes."},"982":{"id":"/docs/clustering/multi-leader-15","page_id":"/docs/clustering/multi-leader","tags":[],"type":"text","url":"/docs/clustering/multi-leader#operate-the-cluster","content":"More replica connections per peer can spread replication traffic across shards. This does not change the replication factor or quorum. Retain separate data directories for nodes and advertise addresses reachable by clients."},"983":{"id":"/docs/clustering/security","page_id":"/docs/clustering/security","type":"page","content":"Cluster Security","breadcrumbs":["Documentation","Clustering"],"tags":[],"url":"/docs/clustering/security"},"984":{"id":"/docs/clustering/security-0","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security","content":"Replica authentication, shared-secret rotation, and TLS for replica traffic"},"985":{"id":"/docs/clustering/security-1","page_id":"/docs/clustering/security","type":"heading","tags":[],"url":"/docs/clustering/security#replica-authentication","content":"Replica authentication"},"986":{"id":"/docs/clustering/security-2","page_id":"/docs/clustering/security","type":"heading","tags":[],"url":"/docs/clustering/security#rotating-the-shared-secret","content":"Rotating the shared secret"},"987":{"id":"/docs/clustering/security-3","page_id":"/docs/clustering/security","type":"heading","tags":[],"url":"/docs/clustering/security#replica-tls","content":"Replica TLS"},"988":{"id":"/docs/clustering/security-4","page_id":"/docs/clustering/security","type":"heading","tags":[],"url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"HTTP tokens across the cluster"},"989":{"id":"/docs/clustering/security-5","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security","content":"Replica-to-replica security has two layers, both in the `[cluster]` configuration: a pre-shared-key handshake that authenticates peers (`[cluster.auth]`) and optional TLS that encrypts the replica connection (`[cluster.tls]`)."},"990":{"id":"/docs/clustering/security-6","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-authentication","content":"Replica authentication uses a cluster-wide pre-shared key (PSK) and a BLAKE3 keyed-MAC handshake. With `cluster.auth.enabled = true`, every replica peer must complete the authenticated handshake or be rejected:"},"991":{"id":"/docs/clustering/security-7","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-authentication","content":"The secret must be **at least 32 bytes** of CSPRNG output and **byte-identical on every node**."},"992":{"id":"/docs/clustering/security-8","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-authentication","content":"Prefer the `IGGY_CLUSTER_AUTH_SHARED_SECRET` environment variable over storing the secret in TOML. The value is masked in logs and never written into the runtime configuration snapshot."},"993":{"id":"/docs/clustering/security-9","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-authentication","content":"Authentication is **off by default**, which leaves replica traffic unauthenticated. Enabling it is a **coordinated-restart change**: flip every node in one restart."},"994":{"id":"/docs/clustering/security-10","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-authentication","content":"The 32-byte minimum is enforced whenever the cluster is enabled, even with `auth.enabled = false`: a configured non-empty secret shorter than 32 bytes fails boot."},"995":{"id":"/docs/clustering/security-11","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#rotating-the-shared-secret","content":"`previous_shared_secret` enables a rolling key rotation without an authentication outage. The retiring key is accepted *for verification only*. Every MAC a node produces uses `shared_secret`. Rotate in three rolls, restarting every node after each step:"},"996":{"id":"/docs/clustering/security-12","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#rotating-the-shared-secret","content":"`shared_secret = old`, `previous_shared_secret = new` on every node"},"997":{"id":"/docs/clustering/security-13","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#rotating-the-shared-secret","content":"`shared_secret = new`, `previous_shared_secret = old` on every node"},"998":{"id":"/docs/clustering/security-14","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#rotating-the-shared-secret","content":"`shared_secret = new` alone, closing the window"},"999":{"id":"/docs/clustering/security-15","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#rotating-the-shared-secret","content":"Leave `previous_shared_secret` **empty outside a rotation**. It has the same 32-byte floor and the same environment-variable preference as the primary key (`IGGY_CLUSTER_AUTH_PREVIOUS_SHARED_SECRET`), and it must differ from `shared_secret`. An identical value is refused at boot because the rotation would be a no-op."},"1000":{"id":"/docs/clustering/security-16","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-tls","content":"`[cluster.tls]` wraps every replica connection on the `tcp_replica` port in TLS 1.3 (ALPN `iggy-replica`) before the replica handshake runs:"},"1001":{"id":"/docs/clustering/security-17","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-tls","content":"TLS requires `cluster.auth.enabled = true`, and the server **refuses to start** otherwise. The reason: replica TLS carries no client certificates, so it authenticates the acceptor only. The PSK handshake authenticates the peer. TLS supplies confidentiality. Without the PSK requirement, any TLS-capable host could register as a replica."},"1002":{"id":"/docs/clustering/security-18","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-tls","content":"Enabling TLS is also a coordinated-restart change: a TLS dialer can't talk to a plaintext acceptor or vice versa."},"1003":{"id":"/docs/clustering/security-19","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-tls","content":"Two certificate modes exist:"},"1004":{"id":"/docs/clustering/security-20","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-tls","content":"**CA mode** (`self_signed = false`, the default): `cert_file`, `key_file`, and `ca_file` are all required. Each node presents `cert_file` on its acceptor side, and dialers verify peer certificates against the `ca_file` trust anchors. The dialer verifies each peer against the `ip` string from that peer's `cluster.nodes` entry, so certificates need matching IP SANs."},"1005":{"id":"/docs/clustering/security-21","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-tls","content":"**Self-signed mode** (`self_signed = true`): the node auto-generates a certificate at boot and the dialer accepts ANY peer certificate. This gives you encrypted replica traffic without certificate management, but **no acceptor authentication at all**: peer authenticity rests entirely on the PSK handshake. Use CA mode when the replica network is not trusted."},"1006":{"id":"/docs/clustering/security-22","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"Follower nodes forward control-plane HTTP requests (stream, topic, user, and similar metadata operations) to the current metadata primary, so **any node can answer any control-plane request**. This requires JWT key material that every node can verify, from either of two sources:"},"1007":{"id":"/docs/clustering/security-23","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"explicitly configured `http.jwt` signing secrets, identical on every node, or"},"1008":{"id":"/docs/clustering/security-24","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"the cluster PSK: when HTTP is enabled, cluster auth is enabled, and no `http.jwt` secrets are configured, the signing key is derived from `shared_secret`."},"1009":{"id":"/docs/clustering/security-25","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"Either way, matching JWT key material lets a bearer token minted on one node verify on another. If JWT keys are derived from the PSK, rotating the PSK also changes the JWT key: `previous_shared_secret` applies only to replica authentication. Use independently configured, shared JWT keys when HTTP tokens must remain valid across PSK rotation. Forwarded requests dial the primary at its roster `ip` and `ports.http`. The follower verifies the caller's bearer locally before forwarding, and the primary re-authenticates the request through its normal stack."},"1010":{"id":"/docs/clustering/security-26","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"Partition requests use the current partition route and can be forwarded in one hop to its primary. The contacted node signs the route and request with a relay proof. The destination rejects invalid or stale proofs and authenticates the caller separately. Proofs live for ten seconds, so synchronize node clocks. An uncertain result is returned without treating it as proof that a fresh replay is safe. `ack=none` confirms dispatch only."},"1011":{"id":"/docs/clustering/security-27","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"When HTTP TLS is enabled, forwarding uses HTTPS and pins the destination certificate to the forwarding node's own HTTP leaf certificate. All nodes therefore need the same HTTP certificate for forwarding. Distinct per-node HTTP certificates fail verification. Replica TLS is configured separately and does not encrypt the HTTP forwarding hop."},"1012":{"id":"/docs/clustering/vsr","page_id":"/docs/clustering/vsr","type":"page","content":"Viewstamped Replication","breadcrumbs":["Documentation","Clustering"],"tags":[],"url":"/docs/clustering/vsr"},"1013":{"id":"/docs/clustering/vsr-0","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr","content":"How Apache Iggy replicates data across a cluster with VSR"},"1014":{"id":"/docs/clustering/vsr-1","page_id":"/docs/clustering/vsr","type":"heading","tags":[],"url":"/docs/clustering/vsr#current-implementation","content":"Current implementation"},"1015":{"id":"/docs/clustering/vsr-2","page_id":"/docs/clustering/vsr","type":"heading","tags":[],"url":"/docs/clustering/vsr#replication-model","content":"Replication model"},"1016":{"id":"/docs/clustering/vsr-3","page_id":"/docs/clustering/vsr","type":"heading","tags":[],"url":"/docs/clustering/vsr#failure-handling","content":"Failure handling"},"1017":{"id":"/docs/clustering/vsr-4","page_id":"/docs/clustering/vsr","type":"heading","tags":[],"url":"/docs/clustering/vsr#wire-protocol-and-sdks","content":"Wire protocol and SDKs"},"1018":{"id":"/docs/clustering/vsr-5","page_id":"/docs/clustering/vsr","type":"heading","tags":[],"url":"/docs/clustering/vsr#status","content":"Status"},"1019":{"id":"/docs/clustering/vsr-6","page_id":"/docs/clustering/vsr","type":"heading","tags":[],"url":"/docs/clustering/vsr#next-steps","content":"Next steps"},"1020":{"id":"/docs/clustering/vsr-7","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr","content":"Apache Iggy replicates clusters with **Viewstamped Replication Revisited (VSR)**. VSR keeps an ordered state machine consistent across replicas and elects a new primary when the current primary fails."},"1021":{"id":"/docs/clustering/vsr-8","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr","content":"Clustering is built into the standard `iggy-server` binary. There's **no separate build, binary, or Cargo feature**: the same server runs single-node or clustered, and `cluster.enabled` in the configuration decides which one you get. Clustering is **disabled by default**."},"1022":{"id":"/docs/clustering/vsr-9","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr","content":"Read the VSR paper used by the project for the protocol specification."},"1023":{"id":"/docs/clustering/vsr-10","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr","content":"> Iggy hasn't reached a 1.0 production release yet. The cluster protocol and configuration described here can still change between pre-release versions."},"1024":{"id":"/docs/clustering/vsr-11","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"The implementation includes:"},"1025":{"id":"/docs/clustering/vsr-12","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"normal operation with quorum commits"},"1026":{"id":"/docs/clustering/vsr-13","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"view changes and deterministic primary selection"},"1027":{"id":"/docs/clustering/vsr-14","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"metadata and partition replication"},"1028":{"id":"/docs/clustering/vsr-15","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"persistent WAL recovery and snapshots"},"1029":{"id":"/docs/clustering/vsr-16","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"replica rejoin with journal repair"},"1030":{"id":"/docs/clustering/vsr-17","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"client sessions, request fencing, and duplicate detection"},"1031":{"id":"/docs/clustering/vsr-18","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"replica authentication and optional TLS"},"1032":{"id":"/docs/clustering/vsr-19","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"leader redirection in the client SDKs"},"1033":{"id":"/docs/clustering/vsr-20","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"deterministic simulation and cross-SDK BDD coverage"},"1034":{"id":"/docs/clustering/vsr-21","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"The main components are:"},"1035":{"id":"/docs/clustering/vsr-22","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"| Component | Source        | Responsibility                                             |\n| --------- | ------------- | ---------------------------------------------------------- |\n| Server    | `core/server` | Sharded runtime, listeners, recovery, and request dispatch |","table":"table-0"},"1036":{"id":"/docs/clustering/vsr-23","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"| Component | Source           | Responsibility                                        |\n| --------- | ---------------- | ----------------------------------------------------- |\n| Consensus | `core/consensus` | VSR state machine, quorum, view changes, and timeouts |","table":"table-0"},"1037":{"id":"/docs/clustering/vsr-24","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"| Component     | Source                               | Responsibility                              |\n| ------------- | ------------------------------------ | ------------------------------------------- |\n| Wire protocol | `core/binary_protocol/src/consensus` | Fixed-size VSR headers and replica messages |","table":"table-0"},"1038":{"id":"/docs/clustering/vsr-25","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"| Component | Source           | Responsibility                                         |\n| --------- | ---------------- | ------------------------------------------------------ |\n| Simulator | `core/simulator` | Deterministic failures, delays, and network partitions |","table":"table-0"},"1039":{"id":"/docs/clustering/vsr-26","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"| Component | Source     | Responsibility                                         |\n| --------- | ---------- | ------------------------------------------------------ |\n| Rust SDK  | `core/sdk` | VSR framing, sessions, retries, and leader redirection |","table":"table-0"},"1040":{"id":"/docs/clustering/vsr-27","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Iggy splits replication by namespace:"},"1041":{"id":"/docs/clustering/vsr-28","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"| Plane    | Consensus group      | Replicated work                                                         |\n| -------- | -------------------- | ----------------------------------------------------------------------- |\n| Metadata | One group on shard 0 | Streams, topics, users, permissions, consumer groups, and access tokens |","table":"table-1"},"1042":{"id":"/docs/clustering/vsr-29","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"| Plane     | Consensus group         | Replicated work               |\n| --------- | ----------------------- | ----------------------------- |\n| Partition | One group per partition | Messages and consumer offsets |","table":"table-1"},"1043":{"id":"/docs/clustering/vsr-30","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"New partitions spread their primaries across eligible nodes, and the metadata primary rebalances them one at a time. Each group can have a different primary. Metadata writes route through the metadata primary. Partition writes route through the primary for that partition."},"1044":{"id":"/docs/clustering/vsr-31","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Metadata reads can use local replicated state. Partition requests route to the current partition primary. Writes return after the required VSR commit or return a retryable error when the replica is changing view or catching up. See Client failover for how the SDKs handle both."},"1045":{"id":"/docs/clustering/vsr-32","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#failure-handling","content":"VSR uses three main flows:"},"1046":{"id":"/docs/clustering/vsr-33","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#failure-handling","content":"**Normal operation**: the primary assigns an operation number, sends `Prepare`, and commits after a quorum sends `PrepareOk`."},"1047":{"id":"/docs/clustering/vsr-34","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#failure-handling","content":"**View change**: replicas exchange `StartViewChange` and `DoViewChange`, then the new primary sends `StartView`."},"1048":{"id":"/docs/clustering/vsr-35","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#failure-handling","content":"**Recovery**: a restarted or lagging replica requests the current view and repairs missing WAL ranges before serving current state."},"1049":{"id":"/docs/clustering/vsr-36","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#failure-handling","content":"Three replicas tolerate one unavailable replica. Five tolerate two. Larger groups use a capped replication quorum and a growing view-change quorum, so the usual `2f + 1` rule does not apply to every group size. See Cluster durability for the quorum rules. Use **at least three replicas** for one-node fault tolerance. A two-node cluster is useful for development, but it **cannot make progress** after either node fails."},"1050":{"id":"/docs/clustering/vsr-37","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#wire-protocol-and-sdks","content":"VSR framing is the *only binary* wire protocol, used by TCP, QUIC, and WebSocket connections. HTTP uses the REST API. Every SDK (Rust, Go, Java, C#, C++, Node.js, Python, PHP, Swift) speaks it, and every BDD suite runs against the clustered-capable `iggy-server`. Binary clients built before the VSR migration **cannot talk to current servers**."},"1051":{"id":"/docs/clustering/vsr-38","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#wire-protocol-and-sdks","content":"The Rust SDK needs no feature flags. Depend on the published crate:"},"1052":{"id":"/docs/clustering/vsr-39","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#wire-protocol-and-sdks","content":"or track the repository directly with `iggy = { git = \"https://github.com/apache/iggy\" }`."},"1053":{"id":"/docs/clustering/vsr-40","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#wire-protocol-and-sdks","content":"The client API is the same in single-node and cluster mode. This example uses the `iggy` / `iggy` credentials explicitly provisioned in Getting started:"},"1054":{"id":"/docs/clustering/vsr-41","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#status","content":"VSR started as a parallel `server-ng` implementation behind a `vsr` build feature. That phase is over. The VSR server moved into the mainline `core/server` crate and the `iggy-server` binary, the feature flag is gone, and the legacy server and its wire format were deleted. What this page describes is the only server implementation."},"1055":{"id":"/docs/clustering/vsr-42","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#next-steps","content":"Deploy a cluster: build the binaries and run a three-node cluster"},"1056":{"id":"/docs/clustering/vsr-43","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#next-steps","content":"Configuration: every `[cluster]` setting and its validation rules"},"1057":{"id":"/docs/clustering/vsr-44","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#next-steps","content":"Security: replica authentication, key rotation, and TLS"},"1058":{"id":"/docs/clustering/vsr-45","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#next-steps","content":"Client failover: reads, writes, and leader redirection from the client side"},"1059":{"id":"/docs/connectors/introduction","page_id":"/docs/connectors/introduction","type":"page","content":"Introduction","breadcrumbs":["Documentation","Connectors"],"tags":[],"url":"/docs/connectors/introduction"},"1060":{"id":"/docs/connectors/introduction-0","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction","content":"The connector runtime: dynamically loaded source and sink plugins, how data flows through them, and what ships today."},"1061":{"id":"/docs/connectors/introduction-1","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#architecture","content":"Architecture"},"1062":{"id":"/docs/connectors/introduction-2","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#data-flow","content":"Data Flow"},"1063":{"id":"/docs/connectors/introduction-3","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#available-connectors","content":"Available Connectors"},"1064":{"id":"/docs/connectors/introduction-4","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#transforms","content":"Transforms"},"1065":{"id":"/docs/connectors/introduction-5","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#supported-schemas","content":"Supported Schemas"},"1066":{"id":"/docs/connectors/introduction-6","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#features","content":"Features"},"1067":{"id":"/docs/connectors/introduction-7","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#quick-start","content":"Quick Start"},"1068":{"id":"/docs/connectors/introduction-8","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#configuration","content":"Configuration"},"1069":{"id":"/docs/connectors/introduction-9","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#runtime","content":"Runtime"},"1070":{"id":"/docs/connectors/introduction-10","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#sink","content":"Sink"},"1071":{"id":"/docs/connectors/introduction-11","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#source","content":"Source"},"1072":{"id":"/docs/connectors/introduction-12","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#building-the-connectors","content":"Building the connectors"},"1073":{"id":"/docs/connectors/introduction-13","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#transformations","content":"Transformations"},"1074":{"id":"/docs/connectors/introduction-14","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction","content":"The highly performant and modular runtime for statically typed, yet dynamically loaded connectors. Ingest the data from the external sources and push it further to the Iggy streams, or fetch the data from the Iggy streams and push it further to the external sources. Create your own Rust plugins by simply implementing either the `Source` or `Sink` trait and build custom pipelines for the data processing."},"1075":{"id":"/docs/connectors/introduction-15","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction","content":"The Docker image for this release is `apache/iggy-connect:0.6.0`."},"1076":{"id":"/docs/connectors/introduction-16","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#architecture","content":"Connectors are dynamically loaded shared libraries (`.so` on Linux, `.dylib` on macOS, `.dll` on Windows) loaded at runtime via `dlopen2`. Message batches and metadata crossing the FFI boundary between the runtime and plugins are serialized using **postcard**, a compact binary format. Plugin configuration is passed as JSON. The SDK initializes one Tokio runtime per loaded plugin library, shared by its connector instances. All plugins run in the same process."},"1077":{"id":"/docs/connectors/introduction-17","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"The connector runtime operates in two directions - **source** (ingest) and **sink** (egress):"},"1078":{"id":"/docs/connectors/introduction-18","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"**Key details:**"},"1079":{"id":"/docs/connectors/introduction-19","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"**Transforms** run inside the runtime process, not inside the plugins. They are applied after decoding for sources (before sending to Iggy) and after consuming from Iggy for sinks (before forwarding to the external system)."},"1080":{"id":"/docs/connectors/introduction-20","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"**State persistence** applies to source connectors and stores the optional checkpoint bytes supplied by the plugin, using a local file or an HTTP backend. The SDK provides MessagePack helpers. The runtime acknowledges a source batch after forwarding it to Iggy and saving its optional checkpoint. See state storage."},"1081":{"id":"/docs/connectors/introduction-21","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"**Consumer groups** track sink offsets automatically. Offsets are committed when messages are polled, before processing by the external sink completes."},"1082":{"id":"/docs/connectors/introduction-22","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"| Type   | Connectors                                              |\n| ------ | ------------------------------------------------------- |\n| Source | Elasticsearch, HTTP, InfluxDB, PostgreSQL, Random, MQTT |","table":"table-0"},"1083":{"id":"/docs/connectors/introduction-23","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"| Type | Connectors                                                                                                                                                                           |\n| ---- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| Sink | BigQuery, ClickHouse, Delta Lake, Apache Doris, Elasticsearch, HTTP, Apache Iceberg, InfluxDB, Meilisearch, MongoDB, PostgreSQL, Quickwit, RabbitMQ, Redshift, S3, Stdout, SurrealDB |","table":"table-0"},"1084":{"id":"/docs/connectors/introduction-24","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"The following built-in transforms are available:"},"1085":{"id":"/docs/connectors/introduction-25","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"**add_fields** - add new fields to the message payload."},"1086":{"id":"/docs/connectors/introduction-26","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"**delete_fields** - remove existing fields from the message payload."},"1087":{"id":"/docs/connectors/introduction-27","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"**filter_fields** - keep or drop fields based on key and value patterns."},"1088":{"id":"/docs/connectors/introduction-28","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"**update_fields** - update existing fields with static or computed values such as `timestamp_millis` or `uuid_v7`."},"1089":{"id":"/docs/connectors/introduction-29","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"**proto_convert** - convert messages between Protocol Buffers and other formats."},"1090":{"id":"/docs/connectors/introduction-30","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"**flat_buffer_convert** - convert messages between FlatBuffers and other formats."},"1091":{"id":"/docs/connectors/introduction-31","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"**avro_convert** - convert messages between Avro and other formats."},"1092":{"id":"/docs/connectors/introduction-32","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"**unwrap_envelope** - promote a nested field of a JSON envelope to the top-level payload."},"1093":{"id":"/docs/connectors/introduction-33","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"See the **Transforms documentation** for the configuration of each transform."},"1094":{"id":"/docs/connectors/introduction-34","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#supported-schemas","content":"Messages can be decoded and encoded using the following formats: **JSON**, **Raw bytes**, **Text**, **Protocol Buffers**, **FlatBuffers**, and **Avro**. For Avro, the schema can be provided per stream via the `avro_schema_json` or `avro_schema_path` keys in the `[[streams]]` section."},"1095":{"id":"/docs/connectors/introduction-35","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#supported-schemas","content":"The BigQuery sink writes through the Storage Write API. The MQTT source supports deferred broker acknowledgements."},"1096":{"id":"/docs/connectors/introduction-36","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"**High Performance**: Utilizes Rust's performance characteristics to ensure fast data ingestion and egress."},"1097":{"id":"/docs/connectors/introduction-37","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"**Low memory footprint**: Designed with memory efficiency in mind, minimizing the memory footprint of the connectors."},"1098":{"id":"/docs/connectors/introduction-38","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"**Modular Design**: Designed with modularity in mind, allowing for easy extension and customization."},"1099":{"id":"/docs/connectors/introduction-39","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"**Dynamic Loading**: Supports dynamic loading of plugins, allowing integration with various data sources and sinks at runtime."},"1100":{"id":"/docs/connectors/introduction-40","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"**Statically Typed**: Ensures type safety and compile-time checks, reducing runtime errors."},"1101":{"id":"/docs/connectors/introduction-41","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"**Easy Customization**: Provides a simple interface for implementing custom connectors, making it easy to create new plugins."},"1102":{"id":"/docs/connectors/introduction-42","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"**Data transformation**: Supports data transformation with the help of existing functions."},"1103":{"id":"/docs/connectors/introduction-43","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"**Powerful configuration**: Define your sinks, sources, and transformations in the configuration file or fetch them from a remote HTTP API."},"1104":{"id":"/docs/connectors/introduction-44","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"**Flexible configuration providers**: Support for local file-based and HTTP-based configuration providers for centralized configuration management."},"1105":{"id":"/docs/connectors/introduction-45","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Run these commands from the root of the same Iggy source checkout used for the server and plugins. This guide targets server 0.10.0."},"1106":{"id":"/docs/connectors/introduction-46","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Build the server, CLI, runtime and quick-start plugins:"},"1107":{"id":"/docs/connectors/introduction-47","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"For a debug build, omit `--release` and replace `target/release` with `target/debug` in both the commands and plugin paths. Make sure that the plugins specified in `core/connectors/runtime/example_config/connectors/` directory under `path` are available. The configuration must be provided in `toml` format. The example directory also enables connectors for ClickHouse, Delta Lake, Apache Doris, Apache Iceberg, and InfluxDB. Without their backing services (or their compiled plugins) these are reported with the `Error` status, but they don't block the remaining connectors. Set `enabled = false` in their files to skip them entirely."},"1108":{"id":"/docs/connectors/introduction-48","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Run `docker compose -f examples/rust/src/sink-data-producer/docker-compose.yml up -d`, which will start the Quickwit server to be used by an example sink connector. At this point, you can access the Quickwit UI at http://localhost:7280 - check this dashboard again later on, after the `events` index will be created."},"1109":{"id":"/docs/connectors/introduction-49","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"In the terminal that will run the connectors, set the runtime configuration path:"},"1110":{"id":"/docs/connectors/introduction-50","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Start the Iggy server in a separate terminal with credentials matching the sample connector configuration:"},"1111":{"id":"/docs/connectors/introduction-51","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"With the server running, create the example streams and topics using the CLI from this checkout. An existing server must have these credentials, or you must adjust the commands and connector configuration to match it."},"1112":{"id":"/docs/connectors/introduction-52","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Execute `cargo run --example sink-data-producer --release`, which sends 100 batches of messages to previously created `qw` stream and `records` topic (this will be used by the Quickwit sink connector)."},"1113":{"id":"/docs/connectors/introduction-53","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Start the connector runtime `cargo run --bin iggy-connectors --release` in the terminal configured in step 3. The Quickwit sink indexes the produced records in the `events` index. At the same time, you should see the new messages being added to the `example_stream` stream and `example_topic` topic by the Random source connector - you can start the Iggy Web UI to browse the data. The messages will have applied the basic fields transformations."},"1114":{"id":"/docs/connectors/introduction-54","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#configuration","content":"Overriding the configuration via environment variables follows the same rules as the main Iggy server."},"1115":{"id":"/docs/connectors/introduction-55","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#configuration","content":"You can provide the following envs during the runtime startup:"},"1116":{"id":"/docs/connectors/introduction-56","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#configuration","content":"Supported scalar fields and indexed list entries can be overridden with the `IGGY_CONNECTORS_` prefix, followed by section and key names joined by underscores, e.g. `IGGY_CONNECTORS_IGGY_USERNAME`. Header and URL-template maps are configured in TOML. Local connector settings use a per-connector prefix, described in the runtime configuration guide."},"1117":{"id":"/docs/connectors/introduction-57","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#runtime","content":"All the connectors are implemented as Rust libraries and can be used as a part of the connector runtime. The runtime is responsible for managing the lifecycle of the connectors and providing the necessary infrastructure for the connectors to run. For more information, please refer to the **runtime documentation**."},"1118":{"id":"/docs/connectors/introduction-58","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#sink","content":"Sinks are responsible for consuming the messages from the configured stream(s) and topic(s) and sending them further to the specified destination. For example, the Quickwit sink connector is responsible for sending the messages to the Quickwit indexer."},"1119":{"id":"/docs/connectors/introduction-59","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#sink","content":"Please refer to the **Sink documentation** for the details about the configuration and the sample implementation."},"1120":{"id":"/docs/connectors/introduction-60","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#sink","content":"When implementing `Sink`, make sure to use the `sink_connector!` macro to expose the FFI interface and allow the connector runtime to register the sink with the runtime. Each sink should have its own, custom configuration, which is passed along with the unique plugin ID via expected `new()` method."},"1121":{"id":"/docs/connectors/introduction-61","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#source","content":"Sources produce messages to an Iggy stream and topic. Configure one `[[streams]]` entry per source instance: the runtime currently retains only the last configured producer. For example, the Random source connector generates random messages that are then sent to the configured stream and topic."},"1122":{"id":"/docs/connectors/introduction-62","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#source","content":"Please refer to the **Source documentation** for the details about the configuration and the sample implementation."},"1123":{"id":"/docs/connectors/introduction-63","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#building-the-connectors","content":"New connector can be built simply by implementing either `Sink` or `Source` trait. Please check the **sink** or **source** documentation, as well as the existing examples under `core/connectors/sinks` and `core/connectors/sources`."},"1124":{"id":"/docs/connectors/introduction-64","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transformations","content":"Field transformations (depending on the supported payload formats) can be applied to the messages either before they are sent to the specified topic (e.g. when produced by the source connectors), or before consumed by the sink connectors. To add a new transformation, implement the `Transform` trait in a new module under the SDK's `transforms` directory, add a variant to the `TransformType` enum, and extend its `from_config` function - the runtime picks it up without any further changes. Each transform may have its own, custom configuration."},"1125":{"id":"/docs/connectors/introduction-65","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transformations","content":"To find out more about the transforms, please refer to the **Transforms documentation**. For the stream decoders and encoders, see the **SDK documentation**."},"1126":{"id":"/docs/connectors/observability","page_id":"/docs/connectors/observability","type":"page","content":"Observability","breadcrumbs":["Documentation","Connectors"],"tags":[],"url":"/docs/connectors/observability"},"1127":{"id":"/docs/connectors/observability-0","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability","content":"Logs, Prometheus metrics, the stats endpoint, OpenTelemetry export and per-source state files for the connector runtime."},"1128":{"id":"/docs/connectors/observability-1","page_id":"/docs/connectors/observability","type":"heading","tags":[],"url":"/docs/connectors/observability#logging","content":"Logging"},"1129":{"id":"/docs/connectors/observability-2","page_id":"/docs/connectors/observability","type":"heading","tags":[],"url":"/docs/connectors/observability#prometheus-metrics","content":"Prometheus metrics"},"1130":{"id":"/docs/connectors/observability-3","page_id":"/docs/connectors/observability","type":"heading","tags":[],"url":"/docs/connectors/observability#runtime-stats","content":"Runtime stats"},"1131":{"id":"/docs/connectors/observability-4","page_id":"/docs/connectors/observability","type":"heading","tags":[],"url":"/docs/connectors/observability#opentelemetry","content":"OpenTelemetry"},"1132":{"id":"/docs/connectors/observability-5","page_id":"/docs/connectors/observability","type":"heading","tags":[],"url":"/docs/connectors/observability#state-files","content":"State files"},"1133":{"id":"/docs/connectors/observability-6","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability","content":"The connector runtime exposes its health through logs, Prometheus metrics, a stats endpoint, OpenTelemetry export, and per-source state files."},"1134":{"id":"/docs/connectors/observability-7","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#logging","content":"The runtime logs via the tracing crate. Merge the runtime configuration snippets on this page into the minimal runtime configuration. The output format is configured in the `[logging]` section:"},"1135":{"id":"/docs/connectors/observability-8","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#logging","content":"Two per-connector flags, both disabled by default, add more detail. Set them at the top level of an existing connector configuration file, before any TOML section headers:"},"1136":{"id":"/docs/connectors/observability-9","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#logging","content":"**`verbose`**: logs additional per-batch details for the connector."},"1137":{"id":"/docs/connectors/observability-10","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#logging","content":"**`benchmark`**: emits per-batch timing events on the `iggy_connectors::benchmark` tracing target."},"1138":{"id":"/docs/connectors/observability-11","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"Metrics are served by the runtime HTTP API when the `[http.metrics]` section is enabled (the HTTP API itself is on by default at `127.0.0.1:8081`). Metrics are disabled by default. Change `enabled` to `true` to expose them:"},"1139":{"id":"/docs/connectors/observability-12","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"Runtime-level gauges:"},"1140":{"id":"/docs/connectors/observability-13","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"`iggy_connectors_sources_total` - configured source connectors."},"1141":{"id":"/docs/connectors/observability-14","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"`iggy_connectors_sources_running` - sources in the `Running` status."},"1142":{"id":"/docs/connectors/observability-15","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"`iggy_connectors_sinks_total` - configured sink connectors."},"1143":{"id":"/docs/connectors/observability-16","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"`iggy_connectors_sinks_running` - sinks in the `Running` status."},"1144":{"id":"/docs/connectors/observability-17","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"Per-connector counters, labeled with `connector_key` and `connector_type` (`source` or `sink`):"},"1145":{"id":"/docs/connectors/observability-18","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"`iggy_connector_messages_produced_total` - messages received from a source plugin's poll."},"1146":{"id":"/docs/connectors/observability-19","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"`iggy_connector_messages_sent_total` - messages sent to Iggy (source)."},"1147":{"id":"/docs/connectors/observability-20","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"`iggy_connector_messages_consumed_total` - messages consumed from Iggy (sink)."},"1148":{"id":"/docs/connectors/observability-21","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"`iggy_connector_messages_processed_total` - messages passed to the sink plugin in batches that returned success. A failed batch adds an error and no processed messages. The runtime cannot infer partial delivery inside the plugin."},"1149":{"id":"/docs/connectors/observability-22","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"`iggy_connector_messages_filtered_total` - messages intentionally dropped by transforms returning `Ok(None)`, excluding transform errors."},"1150":{"id":"/docs/connectors/observability-23","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"`iggy_connector_errors_total` - errors encountered."},"1151":{"id":"/docs/connectors/observability-24","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"Per-batch stage timings are recorded in the `iggy_connector_stage_duration_seconds` histogram independently of the `benchmark` flag, labeled with `connector_key`, `connector_type`, and `stage`. Both connector types record `decode`, `prepare`, and `total`. Sinks also record `ffi`, while sources record `iggy_send` and successful checkpoint writes record `state_save`. Finite buckets range from 50 microseconds to 5 seconds."},"1152":{"id":"/docs/connectors/observability-25","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#runtime-stats","content":"`GET /stats` on the HTTP API returns a JSON snapshot of the runtime: version, process ID, CPU and memory usage (cgroup-aware in containers), uptime, the source/sink totals, and a `connectors` array with per-connector details - key, name, type, plugin version, `enabled`, message counters, error count, and the current status."},"1153":{"id":"/docs/connectors/observability-26","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#runtime-stats","content":"Memory values are in bytes. `run_time` is elapsed microseconds, and `start_time` is microseconds since the Unix epoch."},"1154":{"id":"/docs/connectors/observability-27","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#runtime-stats","content":"The JSON status values are `starting`, `running`, `stopping`, `stopped`, and `error`. A connector whose plugin fails to load (for example, a missing library) is reported with `error` without blocking the remaining connectors. Retrieve its `last_error` from `GET /sources/{key}` or `GET /sinks/{key}`. `/stats` does not include the failure message."},"1155":{"id":"/docs/connectors/observability-28","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#opentelemetry","content":"The `[telemetry]` section configures OTLP export of logs and traces. Set `enabled = true` to export to a running collector:"},"1156":{"id":"/docs/connectors/observability-29","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#opentelemetry","content":"For `transport = \"http\"`, use complete signal URLs, for example `http://localhost:4318/v1/logs` for logs and `http://localhost:4318/v1/traces` for traces. The runtime does not append those paths."},"1157":{"id":"/docs/connectors/observability-30","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#state-files","content":"With the default `file` state backend, source plugins can supply checkpoints (see the SDK documentation) for the directory configured in the `[state]` section. An HTTP state backend is also available:"},"1158":{"id":"/docs/connectors/observability-31","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#state-files","content":"A source that supplies checkpoint bytes gets a file named `source_{key}.state` (e.g. `local_state/source_random.state`) holding the raw state bytes - by convention MessagePack produced by the SDK helpers. Sinks have no state files. Their progress lives in Iggy consumer groups."},"1159":{"id":"/docs/connectors/observability-32","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#state-files","content":"On Unix, the file backend writes and synchronizes a `.tmp` file, atomically renames it over the previous checkpoint, and synchronizes the parent directory. Newly created files have owner-only permissions (`0600`), since state may carry cursors or tokens."},"1160":{"id":"/docs/connectors/observability-33","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#state-files","content":"An empty or missing state file supplies no previous checkpoint when the connector starts. Loading fails if the file cannot be read or its parent directory is unavailable at load time. Stop the runtime before deleting a checkpoint to reset that source on its next start. Deleting it while the connector runs does not reset its in-memory position."},"1161":{"id":"/docs/connectors/runtime","page_id":"/docs/connectors/runtime","type":"page","content":"Runtime","breadcrumbs":["Documentation","Connectors"],"tags":[],"url":"/docs/connectors/runtime"},"1162":{"id":"/docs/connectors/runtime-0","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"How the connector runtime loads plugins, resolves its configuration, and manages connector lifecycles."},"1163":{"id":"/docs/connectors/runtime-1","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"How configuration is resolved"},"1164":{"id":"/docs/connectors/runtime-2","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"How plugins are resolved"},"1165":{"id":"/docs/connectors/runtime-3","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#minimal-configuration","content":"Minimal configuration"},"1166":{"id":"/docs/connectors/runtime-4","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#state-storage","content":"State storage"},"1167":{"id":"/docs/connectors/runtime-5","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#configuration-providers","content":"Configuration Providers"},"1168":{"id":"/docs/connectors/runtime-6","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#local-file-provider","content":"Local File Provider"},"1169":{"id":"/docs/connectors/runtime-7","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#http-configuration-provider","content":"HTTP Configuration Provider"},"1170":{"id":"/docs/connectors/runtime-8","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#configuration-options","content":"Configuration Options"},"1171":{"id":"/docs/connectors/runtime-9","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#default-url-templates","content":"Default URL Templates"},"1172":{"id":"/docs/connectors/runtime-10","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#http-api","content":"HTTP API"},"1173":{"id":"/docs/connectors/runtime-11","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#deferred-sink-reads","content":"Deferred sink reads"},"1174":{"id":"/docs/connectors/runtime-12","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#exactly-once-sources","content":"Exactly-once sources"},"1175":{"id":"/docs/connectors/runtime-13","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"Runtime is responsible for managing the lifecycle of the connectors and providing the necessary infrastructure for the connectors to run."},"1176":{"id":"/docs/connectors/runtime-14","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"The runtime uses a shared Tokio runtime for its connector-management and forwarding tasks. Each loaded plugin library also has an SDK Tokio runtime shared by its instances. Additionally, it has built-in support for logging via tracing crate."},"1177":{"id":"/docs/connectors/runtime-15","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"The connector are implemented as Rust libraries, and these are loaded dynamically during the runtime initialization process."},"1178":{"id":"/docs/connectors/runtime-16","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"Internally, dlopen2 loads plugin libraries and resolves their C FFI symbols. Plugins execute inside the runtime process."},"1179":{"id":"/docs/connectors/runtime-17","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"By default, runtime will look for the configuration file, to decide which connectors to load and how to configure them."},"1180":{"id":"/docs/connectors/runtime-18","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"Set the broker credentials and connector configuration directory before starting the runtime. The embedded default has an empty connector directory and cannot start unchanged. For a complete setup, follow the quick start."},"1181":{"id":"/docs/connectors/runtime-19","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"The Docker image for this release is `apache/iggy-connect:0.6.0`."},"1182":{"id":"/docs/connectors/runtime-20","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"The configuration file path defaults to `core/connectors/runtime/config.toml` and can be overridden by the `IGGY_CONNECTORS_CONFIG_PATH` environment variable."},"1183":{"id":"/docs/connectors/runtime-21","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"A default configuration is embedded in the binary and always merged as the base, so omitted settings inherit its values. A local provider still needs a nonempty `connectors.config_dir`."},"1184":{"id":"/docs/connectors/runtime-22","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"On startup the runtime loads environment variables from the first `.env` file found in the working directory or its parents, or from the file pointed to by `IGGY_CONNECTORS_ENV_PATH`."},"1185":{"id":"/docs/connectors/runtime-23","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"Supported scalar fields and indexed list entries can be overridden by environment variables using the `IGGY_CONNECTORS_<SECTION>_<KEY>` convention (nested keys joined by underscores), e.g. `IGGY_CONNECTORS_IGGY_USERNAME` or `IGGY_CONNECTORS_HTTP_ADDRESS`."},"1186":{"id":"/docs/connectors/runtime-24","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"Run `iggy-connectors --list-config-env-vars` to print the supported names and templates, then exit before dotenv and configuration loading, runtime creation, plugin loading, or other startup activity. The output is sorted and uses these placeholders:"},"1187":{"id":"/docs/connectors/runtime-25","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"`<N>` is a vector index from `0` through `255` for connector stream fields. Whole-value vectors are listed once without a placeholder."},"1188":{"id":"/docs/connectors/runtime-26","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"`<KEY>` is the configured connector key, uppercased. These per-connector overrides are available only with the local configuration provider."},"1189":{"id":"/docs/connectors/runtime-27","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"`<FIELD>` sets one lowercased top-level plugin configuration key. Underscores are preserved (`A_B` becomes `a_b`, not nested `a.b`), and nested plugin configuration keys cannot be set through environment variables. `FORMAT` is reserved and is listed separately as `..._PLUGIN_CONFIG_FORMAT`. The passthrough template does not guarantee that a plugin accepts every field."},"1190":{"id":"/docs/connectors/runtime-28","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"The `path` field of a connector configuration accepts both `plugin.so` and `plugin` - the OS-specific extension (`.so` / `.dylib` / `.dll`) is appended when missing. Absolute paths are checked at the literal location. Relative paths are searched in order:"},"1191":{"id":"/docs/connectors/runtime-29","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"Literal path (relative to the working directory)"},"1192":{"id":"/docs/connectors/runtime-30","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"Directory of the runtime binary (filename only)"},"1193":{"id":"/docs/connectors/runtime-31","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"Current working directory (filename only)"},"1194":{"id":"/docs/connectors/runtime-32","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"`/usr/lib`, `/usr/lib64`, `/lib`, `/lib64`, `/usr/local/lib`, `/usr/local/lib64`"},"1195":{"id":"/docs/connectors/runtime-33","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"A connector whose plugin cannot be resolved or loaded is surfaced with the `Error` status via the HTTP API instead of blocking the remaining connectors."},"1196":{"id":"/docs/connectors/runtime-34","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#minimal-configuration","content":"The runtime opens two Iggy TCP clients, one for producers and one for consumers. Set credentials matching the broker and a connector configuration provider. Omitted settings use the embedded defaults, including file-based source state storage. Save this example as `connectors.toml` in the repository root and replace `path/to/connectors` with your connector configuration directory."},"1197":{"id":"/docs/connectors/runtime-35","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#minimal-configuration","content":"Start it from the repository root:"},"1198":{"id":"/docs/connectors/runtime-36","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#minimal-configuration","content":"Beyond these sections, the runtime configuration also supports `[http]` for the HTTP API (see below), and `[telemetry]`, `[logging]`, and `[http.metrics]` covered on the **Observability page**."},"1199":{"id":"/docs/connectors/runtime-37","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"Source plugins supply optional checkpoint bytes. The default `file` backend writes them to `{state.path}/source_{key}.state` using a temporary file, file synchronization and atomic rename. On Unix, it also synchronizes the parent directory. The runtime stores these bytes unchanged. The SDK provides MessagePack serialization helpers."},"1200":{"id":"/docs/connectors/runtime-38","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"To use an HTTP state server, replace the `[state]` section above and add:"},"1201":{"id":"/docs/connectors/runtime-39","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"The runtime appends `source_{key}` as a URL path segment, preserving any query string. URL query values are redacted from runtime configuration logs and transport errors. Static request headers are passed to the state server. Configure this map in TOML. The other state settings support environment overrides such as `IGGY_CONNECTORS_STATE_STORAGE` and `IGGY_CONNECTORS_STATE_HTTP_URL`."},"1202":{"id":"/docs/connectors/runtime-40","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"The HTTP server must implement this checkpoint contract:"},"1203":{"id":"/docs/connectors/runtime-41","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"Load uses `GET` by default, or `POST`. Return `200` with the stored bytes and a strong `ETag`, or `404` when no state exists. An empty `200` body is valid state."},"1204":{"id":"/docs/connectors/runtime-42","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"Save uses `PUT` by default, or `POST`/`PATCH`, with `Content-Type: application/octet-stream`. Atomically enforce `If-Match` for a known ETag or `If-None-Match: *` for a new checkpoint. Successful `200`, `201` or `204` responses must include the new strong `ETag`."},"1205":{"id":"/docs/connectors/runtime-43","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"Each logical save has an `Idempotency-Key`, reused across retries and resolution of an uncertain write. The server must replay the original outcome for that key without applying the write again."},"1206":{"id":"/docs/connectors/runtime-44","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"`If-Match`, `If-None-Match`, `Idempotency-Key` and `Content-Type` are managed by the runtime and cannot be overridden in `request_headers`."},"1207":{"id":"/docs/connectors/runtime-45","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"Timeouts, connection failures, `425`, `429` and `5xx` responses are retried. `max_attempts` counts retries after the first request, so the default 4 allows up to 5 requests. Integer-seconds `Retry-After` values are honored up to `max_backoff`. Other save failures, including version conflicts or missing ETags, latch the provider: further saves fail until the connector restarts. An HTTP state-load failure while an enabled source starts aborts runtime startup."},"1208":{"id":"/docs/connectors/runtime-46","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"The runtime forwards a source batch to Iggy, saves its optional checkpoint, then acknowledges the batch to the plugin. A failed send or checkpoint save produces a negative acknowledgement. Remote checkpoint durability depends on the state server. Connector lifecycle operations do not delete remote state."},"1209":{"id":"/docs/connectors/runtime-47","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-providers","content":"The runtime supports two types of configuration providers for managing connector configurations:"},"1210":{"id":"/docs/connectors/runtime-48","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#local-file-provider","content":"The default configuration provider reads connector configurations from local files. Each connector (source or sink) is configured in its own separate file within the directory specified by `connectors.config_dir`. An empty `config_dir` is a fatal startup error. A missing directory is created automatically with a warning, and no connectors are loaded from it."},"1211":{"id":"/docs/connectors/runtime-49","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#local-file-provider","content":"Additional mechanics of the local provider:"},"1212":{"id":"/docs/connectors/runtime-50","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#local-file-provider","content":"Only `*.toml` files directly inside the directory are loaded - hidden files (starting with `.`) and `Cargo.toml` are skipped."},"1213":{"id":"/docs/connectors/runtime-51","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#local-file-provider","content":"Multiple files sharing the same connector `key` form a version history (each file carries its own `version`). The active version of each connector is persisted in `{config_dir}/.active_versions.toml` and can be selected via the HTTP API for the next process startup. Without a saved selection, the highest version is used. Changing this selection does not update a running connector. The connector restart endpoint currently loads the highest local version, which can differ from the selected active version."},"1214":{"id":"/docs/connectors/runtime-52","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#local-file-provider","content":"Top-level `plugin_config` fields can be overridden per connector via environment variables using the `IGGY_CONNECTORS_{SINK|SOURCE}_{KEY}_PLUGIN_CONFIG_<FIELD>` convention, e.g. `IGGY_CONNECTORS_SINK_QUICKWIT_PLUGIN_CONFIG_URL`."},"1215":{"id":"/docs/connectors/runtime-53","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-configuration-provider","content":"The HTTP configuration provider allows the runtime to fetch connector configurations from a remote HTTP/REST API. The provider fetches active configurations at startup and handles configuration operations requested through the runtime API. It does not periodically poll for remote changes."},"1216":{"id":"/docs/connectors/runtime-54","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"**base_url** (required): Base URL of the configuration API endpoint"},"1217":{"id":"/docs/connectors/runtime-55","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"**timeout** (optional): HTTP request timeout (default: 10s)"},"1218":{"id":"/docs/connectors/runtime-56","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"**request_headers** (optional): Custom headers to include in all HTTP requests (e.g., authentication headers)"},"1219":{"id":"/docs/connectors/runtime-57","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"**url_templates** (optional): Custom URL templates for API endpoints. Supports variable substitution with `{key}` and `{version}` placeholders."},"1220":{"id":"/docs/connectors/runtime-58","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"**response.data_path** (optional): Dot-separated object keys or numeric array indexes used to extract data (e.g., `data.config` or `data.0`)."},"1221":{"id":"/docs/connectors/runtime-59","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"**response.error_path** (optional): A path with the same syntax. Any non-null value at this path is treated as an error, including `false` or an empty string."},"1222":{"id":"/docs/connectors/runtime-60","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"If not customized, the HTTP provider uses the following RESTful URL patterns:"},"1223":{"id":"/docs/connectors/runtime-61","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Create sink config: `POST {base_url}/sinks/{key}/configs`"},"1224":{"id":"/docs/connectors/runtime-62","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Create source config: `POST {base_url}/sources/{key}/configs`"},"1225":{"id":"/docs/connectors/runtime-63","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get active configs: `GET {base_url}/configs/active`"},"1226":{"id":"/docs/connectors/runtime-64","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get active versions: `GET {base_url}/configs/active/versions`"},"1227":{"id":"/docs/connectors/runtime-65","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Set active sink version: `PUT {base_url}/sinks/{key}/configs/active`"},"1228":{"id":"/docs/connectors/runtime-66","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Set active source version: `PUT {base_url}/sources/{key}/configs/active`"},"1229":{"id":"/docs/connectors/runtime-67","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get sink configs: `GET {base_url}/sinks/{key}/configs`"},"1230":{"id":"/docs/connectors/runtime-68","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get sink config by version: `GET {base_url}/sinks/{key}/configs/{version}`"},"1231":{"id":"/docs/connectors/runtime-69","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get active sink config: `GET {base_url}/sinks/{key}/configs/active`"},"1232":{"id":"/docs/connectors/runtime-70","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get source configs: `GET {base_url}/sources/{key}/configs`"},"1233":{"id":"/docs/connectors/runtime-71","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get source config by version: `GET {base_url}/sources/{key}/configs/{version}`"},"1234":{"id":"/docs/connectors/runtime-72","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get active source config: `GET {base_url}/sources/{key}/configs/active`"},"1235":{"id":"/docs/connectors/runtime-73","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Delete sink config: `DELETE {base_url}/sinks/{key}/configs`"},"1236":{"id":"/docs/connectors/runtime-74","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Delete source config: `DELETE {base_url}/sources/{key}/configs`"},"1237":{"id":"/docs/connectors/runtime-75","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"The HTTP provider expects the remote API to implement these endpoints and return connector configuration data in the same format as used by the local provider."},"1238":{"id":"/docs/connectors/runtime-76","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"Connector runtime has an HTTP API which is **enabled by default** at `127.0.0.1:8081`. It can be disabled by setting the `enabled` flag to `false` in the `[http]` section."},"1239":{"id":"/docs/connectors/runtime-77","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"When `api_key` is set, every request must carry it in the `api-key` header - except `GET /` and `GET /health`, which stay public. An empty key disables authentication. Configuration endpoints return plugin credentials and accept configuration changes, so set an API key before exposing this API to other hosts. Enable TLS or use a trusted TLS proxy for remote access."},"1240":{"id":"/docs/connectors/runtime-78","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"Currently, it does expose the following endpoints:"},"1241":{"id":"/docs/connectors/runtime-79","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`GET /`: welcome message."},"1242":{"id":"/docs/connectors/runtime-80","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`GET /health`: process liveness response. It does not check connector health. Inspect `/stats`, `/sources` or `/sinks` for connector status."},"1243":{"id":"/docs/connectors/runtime-81","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`GET /stats`: runtime statistics (process info plus per-connector status and message counters)."},"1244":{"id":"/docs/connectors/runtime-82","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`GET /metrics`: Prometheus metrics, available when `[http.metrics]` is enabled (path configurable via its `endpoint` key)."},"1245":{"id":"/docs/connectors/runtime-83","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`GET /sinks`: list of sinks."},"1246":{"id":"/docs/connectors/runtime-84","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`GET /sinks/{key}`: sink details."},"1247":{"id":"/docs/connectors/runtime-85","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`GET /sinks/{key}/configs`: list of configuration versions for the sink."},"1248":{"id":"/docs/connectors/runtime-86","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`POST /sinks/{key}/configs`: add a new configuration version for the sink."},"1249":{"id":"/docs/connectors/runtime-87","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`DELETE /sinks/{key}/configs`: delete one configuration version, chosen by the `version` query parameter or the locally saved active selection."},"1250":{"id":"/docs/connectors/runtime-88","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`GET /sinks/{key}/configs/{version}`: configuration details for a specific version."},"1251":{"id":"/docs/connectors/runtime-89","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`GET /sinks/{key}/configs/active`: active configuration details."},"1252":{"id":"/docs/connectors/runtime-90","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`PUT /sinks/{key}/configs/active`: activate a specific configuration version for the sink."},"1253":{"id":"/docs/connectors/runtime-91","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`GET /sinks/{key}/configs/plugin`: sink plugin config, including the optional `format` query parameter to specify the config format."},"1254":{"id":"/docs/connectors/runtime-92","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`GET /sinks/{key}/transforms`: sink transforms to be applied to the fields."},"1255":{"id":"/docs/connectors/runtime-93","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`POST /sinks/{key}/restart`: restart the sink connector."},"1256":{"id":"/docs/connectors/runtime-94","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`GET /sources`: list of sources."},"1257":{"id":"/docs/connectors/runtime-95","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`GET /sources/{key}`: source details."},"1258":{"id":"/docs/connectors/runtime-96","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`GET /sources/{key}/configs`: list of configuration versions for the source."},"1259":{"id":"/docs/connectors/runtime-97","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`POST /sources/{key}/configs`: add a new configuration version for the source."},"1260":{"id":"/docs/connectors/runtime-98","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`DELETE /sources/{key}/configs`: delete one configuration version, chosen by the `version` query parameter or the locally saved active selection."},"1261":{"id":"/docs/connectors/runtime-99","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`GET /sources/{key}/configs/{version}`: configuration details for a specific version."},"1262":{"id":"/docs/connectors/runtime-100","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`GET /sources/{key}/configs/active`: active configuration details."},"1263":{"id":"/docs/connectors/runtime-101","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`PUT /sources/{key}/configs/active`: activate a specific configuration version for the source."},"1264":{"id":"/docs/connectors/runtime-102","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`GET /sources/{key}/configs/plugin`: source plugin config, including the optional `format` query parameter to specify the config format."},"1265":{"id":"/docs/connectors/runtime-103","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`GET /sources/{key}/transforms`: source transforms to be applied to the fields."},"1266":{"id":"/docs/connectors/runtime-104","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"`POST /sources/{key}/restart`: restart the source connector."},"1267":{"id":"/docs/connectors/runtime-105","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#deferred-sink-reads","content":"Sink stream entries use `max_wait` and `min_count`. The default wait is one second and the minimum count is one. `batch_length` limits returned messages. A wait must be positive, and `min_count` must be from one through the batch length. The server can cap a requested wait."},"1268":{"id":"/docs/connectors/runtime-106","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#deferred-sink-reads","content":"The sink starts processing when the read is ready, its byte budget is reached or the wait ends. Replace the old `poll_interval` field. A sink that still supplies it fails to start, even when `max_wait` is also present."},"1269":{"id":"/docs/connectors/runtime-107","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#deferred-sink-reads","content":"The runtime selects `CommitPolicy::OnRead`. Offsets can advance before a plugin finishes its callback. A failed sink callback is recorded and does not cause the runtime to replay that batch. Deferred reads change waiting and batching, not this delivery guarantee."},"1270":{"id":"/docs/connectors/runtime-108","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#exactly-once-sources","content":"`exactly_once=true` enables producer batch identity for a source. The plugin must reproduce the same messages from its saved state. The runtime stores producer ID, epoch, sequence and partition with the plugin checkpoint before sending."},"1271":{"id":"/docs/connectors/runtime-109","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#exactly-once-sources","content":"All batches go to one partition, zero when omitted. Each plugin batch is one request. `batch_length` and `linger_time` do not apply in this mode. Use a topic with `persisted` durability and upgrade every node and reader before enabling producer-aware batches."},"1272":{"id":"/docs/connectors/runtime-110","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#exactly-once-sources","content":"The guarantee has limits. A partition retains five batches per producer, at most 4096 producers, and expires producers idle for 24 hours. A changed batch count, a changed partition, expired producer state, or more than five unsaved batches can cause duplicates after recovery. The plugin must return new checkpoint state often enough to preserve its replay position."},"1273":{"id":"/docs/connectors/runtime-111","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#exactly-once-sources","content":"Turning the mode off preserves plugin state in the ordinary format after the next save. Before rolling back to an older runtime, disable it and wait for that save. Older runtimes do not understand the producer record. See Idempotent producers."},"1274":{"id":"/docs/connectors/sdk","page_id":"/docs/connectors/sdk","type":"page","content":"SDK","breadcrumbs":["Documentation","Connectors"],"tags":[],"url":"/docs/connectors/sdk"},"1275":{"id":"/docs/connectors/sdk-0","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk","content":"The Sink and Source traits, the connector macros, and the decoders and encoders used to read and write Iggy streams."},"1276":{"id":"/docs/connectors/sdk-1","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#traits","content":"Traits"},"1277":{"id":"/docs/connectors/sdk-2","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#state","content":"State"},"1278":{"id":"/docs/connectors/sdk-3","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#retry-utilities","content":"Retry utilities"},"1279":{"id":"/docs/connectors/sdk-4","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#transforms","content":"Transforms"},"1280":{"id":"/docs/connectors/sdk-5","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#protocol-buffers-support","content":"Protocol Buffers Support"},"1281":{"id":"/docs/connectors/sdk-6","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#configuration-example","content":"Configuration Example"},"1282":{"id":"/docs/connectors/sdk-7","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#key-configuration-options","content":"Key Configuration Options"},"1283":{"id":"/docs/connectors/sdk-8","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#programmatic-encoder-and-decoder-configuration","content":"Programmatic Encoder and Decoder Configuration"},"1284":{"id":"/docs/connectors/sdk-9","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#transform-options","content":"Transform Options"},"1285":{"id":"/docs/connectors/sdk-10","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#supported-features","content":"Supported Features"},"1286":{"id":"/docs/connectors/sdk-11","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#programmatic-usage","content":"Programmatic Usage"},"1287":{"id":"/docs/connectors/sdk-12","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#dynamic-schema-loading","content":"Dynamic Schema Loading"},"1288":{"id":"/docs/connectors/sdk-13","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#creating-converters-with-schema","content":"Creating Converters with Schema"},"1289":{"id":"/docs/connectors/sdk-14","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#usage-notes","content":"Usage Notes"},"1290":{"id":"/docs/connectors/sdk-15","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk","content":"SDK provides the commonly used structs and traits such as `Sink` and `Source`, along with the `sink_connector` and `source_connector` macros to be used when developing connectors."},"1291":{"id":"/docs/connectors/sdk-16","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk","content":"Moreover, it contains both, the `decoders` and `encoders` modules, implementing either `StreamDecoder` or `StreamEncoder` traits, which are used when consuming or producing data from/to Iggy streams. All the supported schemas - **JSON**, **Raw bytes**, **Text**, **Protocol Buffers**, **FlatBuffers**, and **Avro** - have both a decoder and an encoder."},"1292":{"id":"/docs/connectors/sdk-17","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#traits","content":"A source produces messages to the configured stream and topic. A sink consumes messages from the configured stream(s) and topic(s):"},"1293":{"id":"/docs/connectors/sdk-18","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#traits","content":"Expose the implementation with `sink_connector!(MySink)` or `source_connector!(MySource)`. The sink constructor has the signature `new(id: u32, config: MySinkConfig) -> Self`. The source constructor also takes `state: Option<ConnectorState>`. The **sink guide** and **source guide** provide complete plugin implementations and build setup."},"1294":{"id":"/docs/connectors/sdk-19","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#traits","content":"The macros generate the C FFI symbols loaded by the runtime: `iggy_sink_open`, `iggy_sink_consume`, `iggy_sink_close`, and `iggy_sink_version` for sinks, and `iggy_source_open`, `iggy_source_handle_v2`, `iggy_source_batch_result`, `iggy_source_close`, and `iggy_source_version` for sources. Configurations cross FFI as JSON, message batches and metadata use postcard, and source checkpoint bytes are opaque. The SDK creates one Tokio runtime per loaded plugin library, shared by that library's connector instances."},"1295":{"id":"/docs/connectors/sdk-20","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#state","content":"Source connectors can persist their position between restarts. Each batch of `ProducedMessages` may carry an optional `ConnectorState`. After processing and sending the batch to Iggy, the runtime saves that state through the configured file or HTTP backend before acknowledging the batch. The last saved state is passed to `new()` on the next startup. `ConnectorState` wraps raw bytes and provides `serialize`/`deserialize` helpers backed by MessagePack."},"1296":{"id":"/docs/connectors/sdk-21","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#state","content":"Sources with cursors or destructive operations must stage changes during `poll()` and apply them on `SourceBatchResult::Ack`. `Nack` discards staged progress so the batch can be polled again. The SDK allows one batch in flight and stops polling if `on_batch_result()` returns an error. Its default no-op is suitable only for sources without staged work."},"1297":{"id":"/docs/connectors/sdk-22","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#state","content":"Sinks can keep in-memory state, but the runtime does not persist it. Their consumer-group offsets are tracked by Iggy. See the **Observability page** for checkpoint storage and the **sink guide** for offset handling."},"1298":{"id":"/docs/connectors/sdk-23","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#retry-utilities","content":"The `retry` module ships helpers for connectors talking to flaky external systems: a `CircuitBreaker`, an `HttpRetryMiddleware` for `reqwest`-based clients, and a `build_retry_client` factory that wraps a reqwest client with the retry middleware (the circuit breaker is wired separately)."},"1299":{"id":"/docs/connectors/sdk-24","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#transforms","content":"Last but not least, the different `transforms` are available, to transform (add, update, delete etc.) the particular fields of the data being processed via external configuration. It's as simple as adding a new transform to the `transforms` section of the particular connector configuration file:"},"1300":{"id":"/docs/connectors/sdk-25","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#transforms","content":"All the available transforms and their configuration options are documented on the **Transforms page**."},"1301":{"id":"/docs/connectors/sdk-26","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#protocol-buffers-support","content":"The SDK includes support for Protocol Buffers (protobuf) format with both encoding and decoding capabilities. Protocol Buffers provide efficient serialization and are particularly useful for high-performance data streaming scenarios."},"1302":{"id":"/docs/connectors/sdk-27","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#configuration-example","content":"This example uses the Random source and Stdout sink from the matching checkout. Start a server using the **getting-started guide**, then build the plugins, runtime, and CLI from the repository root:"},"1303":{"id":"/docs/connectors/sdk-28","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#configuration-example","content":"The source's `schema = \"proto\"` selects the default protobuf encoder, which wraps each JSON record in a `google.protobuf.StringValue` inside `google.protobuf.Any`. The sink reads raw bytes and applies `proto_convert` to expose the Any envelope as JSON. This does not unpack a custom protobuf message schema."},"1304":{"id":"/docs/connectors/sdk-29","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#configuration-example","content":"**Main runtime config (connectors.toml):**"},"1305":{"id":"/docs/connectors/sdk-30","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#configuration-example","content":"**Source connector config (connectors/protobuf_source.toml):**"},"1306":{"id":"/docs/connectors/sdk-31","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#configuration-example","content":"**Sink connector config (connectors/protobuf_sink.toml):**"},"1307":{"id":"/docs/connectors/sdk-32","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#configuration-example","content":"Create the stream and topic, then start the runtime from the repository root:"},"1308":{"id":"/docs/connectors/sdk-33","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#configuration-example","content":"The source sends 100 records, then continues polling without new messages. Stdout logs message offsets and the serialized JSON envelope bytes, containing `type_url` and base64 `value`. The sink's `raw` schema also determines how the plugin receives those transformed bytes."},"1309":{"id":"/docs/connectors/sdk-34","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#configuration-example","content":"The format-conversion transforms define no per-key defaults. Every non-optional key shown above must be present, or the configuration fails to deserialize (`schema_path`, `message_type`, `field_mappings`, and `descriptor_set` are optional)."},"1310":{"id":"/docs/connectors/sdk-35","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#configuration-example","content":"The two `[[streams]]` shapes differ: a source produces to a single `topic` and can tune batching via `batch_length` and `linger_time`, while a sink consumes from a list of `topics` and can additionally set `batch_length`, `max_wait`, `min_count`, and `consumer_group`."},"1311":{"id":"/docs/connectors/sdk-36","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#programmatic-encoder-and-decoder-configuration","content":"These are SDK configuration fields, not Random or Stdout `plugin_config` keys. The runtime's `schema = \"proto\"` uses the default encoder or decoder."},"1312":{"id":"/docs/connectors/sdk-37","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#programmatic-encoder-and-decoder-configuration","content":"**`schema_path`**: Path to the `.proto` file containing message definitions"},"1313":{"id":"/docs/connectors/sdk-38","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#programmatic-encoder-and-decoder-configuration","content":"**`message_type`**: Fully qualified name of the protobuf message type to use"},"1314":{"id":"/docs/connectors/sdk-39","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#programmatic-encoder-and-decoder-configuration","content":"**`use_any_wrapper`**: Selects the Any fallback when no message descriptor is loaded. A loaded descriptor takes precedence"},"1315":{"id":"/docs/connectors/sdk-40","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#transform-options","content":"**`proto_convert`**: Transform for converting between protobuf and other formats"},"1316":{"id":"/docs/connectors/sdk-41","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#transform-options","content":"**`source_format`** / **`target_format`**: Formats to convert between - any schema value (`json`, `raw`, `text`, `proto`, `flat_buffer`, `avro`)"},"1317":{"id":"/docs/connectors/sdk-42","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#transform-options","content":"**`preserve_unknown_fields`**: Accepted by `proto_convert`, but currently has no effect"},"1318":{"id":"/docs/connectors/sdk-43","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#transform-options","content":"**`include_paths`**: Additional directories searched for imported `.proto` files"},"1319":{"id":"/docs/connectors/sdk-44","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#transform-options","content":"**`field_mappings`**: Renames fields in a JSON input object before conversion (e.g., `\"old_field\" = \"new_field\"`)"},"1320":{"id":"/docs/connectors/sdk-45","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#transform-options","content":"**`conversion_options`**: `pretty_json` controls JSON text output and `include_metadata` enriches supported protobuf-to-JSON paths. `validate_messages`, `type_url_prefix`, and `strict_mode` are accepted but currently have no effect"},"1321":{"id":"/docs/connectors/sdk-46","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#transform-options","content":"The `schema_registry_url` field is reserved and currently not implemented. The SDK never contacts a schema registry, and schemas are loaded only from `schema_path` or `descriptor_set`."},"1322":{"id":"/docs/connectors/sdk-47","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#supported-features","content":"**Encoding**: A loaded message descriptor encodes matching JSON fields. The encoder supports booleans, strings, all protobuf integer types, and base64 strings for bytes or already-encoded nested messages. Float, double, and enum fields are unsupported by the encoder. Nested JSON objects, repeated fields, maps, and proto2 groups are not a general-purpose schema conversion path."},"1323":{"id":"/docs/connectors/sdk-48","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#supported-features","content":"**Decoding**: A loaded descriptor extracts present fields. Integer, boolean, and string fields become JSON values. Bytes become base64 and nested messages become metadata with base64 content. Missing fields are not filled with protobuf defaults, and float/double fields produce `unsupported_wire_type` placeholders. Without a descriptor, the default decoder returns an Any envelope's `type_url` and base64 `value`."},"1324":{"id":"/docs/connectors/sdk-49","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#supported-features","content":"**Transforms**: `proto_convert` supports JSON-to-protobuf schema encoding for scalar fields, including floating-point numbers and numeric enum values. Bytes and already-encoded nested messages use base64 strings. It logs and omits fields it cannot encode. Its protobuf-to-JSON path exposes Any metadata or raw-data metadata rather than decoding a custom message descriptor. Converting protobuf to `flat_buffer` or `avro` rewraps bytes without transcoding them."},"1325":{"id":"/docs/connectors/sdk-50","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#supported-features","content":"**Field Mapping**: Encoder/decoder mappings use protobuf field names as keys and JSON field names as values. The encoder applies that mapping in reverse. Transform mappings rename JSON input keys directly."},"1326":{"id":"/docs/connectors/sdk-51","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#supported-features","content":"**Any Wrapper**: The default encoder puts JSON/text in a `google.protobuf.StringValue`, or binary data in a `google.protobuf.BytesValue`, inside `google.protobuf.Any`. The default decoder exposes the envelope without unpacking its inner message."},"1327":{"id":"/docs/connectors/sdk-52","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#programmatic-usage","content":"From the matching repository root, create an example crate and schema directory:"},"1328":{"id":"/docs/connectors/sdk-53","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#programmatic-usage","content":"Save this as `connector-sdk-example/Cargo.toml`. The path dependency uses the SDK from the same checkout as the runtime:"},"1329":{"id":"/docs/connectors/sdk-54","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#programmatic-usage","content":"Save this as `schemas/user.proto`:"},"1330":{"id":"/docs/connectors/sdk-55","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#programmatic-usage","content":"Each Rust example below is a complete `connector-sdk-example/src/main.rs`. Run it from the repository root so the relative schema path resolves:"},"1331":{"id":"/docs/connectors/sdk-56","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#dynamic-schema-loading","content":"You can load or reload schemas programmatically:"},"1332":{"id":"/docs/connectors/sdk-57","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#dynamic-schema-loading","content":"The encoder follows the same pattern:"},"1333":{"id":"/docs/connectors/sdk-58","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#creating-converters-with-schema","content":"The loaded schema is used for JSON-to-protobuf conversion. This example maps `user_id` and `full_name` to the schema's field names:"},"1334":{"id":"/docs/connectors/sdk-59","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#usage-notes","content":"**Automatic Loading**: Constructors attempt to load `schema_path` or `descriptor_set`. `schema_path` takes precedence when both are set. Constructors log loading errors and return an instance without a loaded schema."},"1335":{"id":"/docs/connectors/sdk-60","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#usage-notes","content":"**Manual Loading**: `load_schema()` reloads the configured source. A returned error preserves an already-loaded schema. `update_config(config, true)` also restores the previous configuration on error. `false` changes the configuration while retaining the cached schema."},"1336":{"id":"/docs/connectors/sdk-61","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#usage-notes","content":"**Fallbacks**: Missing files, compilation failures, absent schema sources, or an unmatched `message_type` can return `Ok(())` without an active message descriptor. Successful reloads into fallback mode clear the previous descriptor. Invalid protobuf syntax and malformed descriptor bytes return errors. Check the actual encoded/decoded result when validating a schema setup."},"1337":{"id":"/docs/connectors/sdk-62","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#usage-notes","content":"**Encoding Errors**: Errors encoding a loaded message descriptor are returned to the caller. The encoder does not retry that message as Any. The decoder attempts Any after a schema decoding error."},"1338":{"id":"/docs/connectors/sdk-63","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#usage-notes","content":"**Transform Configuration**: Create a new converter to change its configuration. `load_schema()` can reload its existing source. Without a descriptor, JSON-to-protobuf conversion produces JSON text in `Payload::Proto`, not a schema-encoded binary message."},"1339":{"id":"/docs/connectors/sdk-64","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#usage-notes","content":"**Format Options**: Encoder `preserve_unknown_fields`, `compact_encoding`, `validate_message`, and `deterministic_encoding` are accepted but have no effect. Decoder `preserve_unknown_fields` retains unknown varints as numbers and length-delimited data as base64. Fixed-width unknown fields become placeholders. It does not retain the original wire encoding. See the Transforms page for conversion-specific limits."},"1340":{"id":"/docs/connectors/sdk-65","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#usage-notes","content":"Protocol Buffers provide efficient binary serialization compared to JSON"},"1341":{"id":"/docs/connectors/sinks/bigquery","page_id":"/docs/connectors/sinks/bigquery","type":"page","content":"BigQuery","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/bigquery"},"1342":{"id":"/docs/connectors/sinks/bigquery-0","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery","content":"Write Iggy messages to an existing BigQuery table through the Storage Write API."},"1343":{"id":"/docs/connectors/sinks/bigquery-1","page_id":"/docs/connectors/sinks/bigquery","type":"heading","tags":[],"url":"/docs/connectors/sinks/bigquery#configuration","content":"Configuration"},"1344":{"id":"/docs/connectors/sinks/bigquery-2","page_id":"/docs/connectors/sinks/bigquery","type":"heading","tags":[],"url":"/docs/connectors/sinks/bigquery#credentials","content":"Credentials"},"1345":{"id":"/docs/connectors/sinks/bigquery-3","page_id":"/docs/connectors/sinks/bigquery","type":"heading","tags":[],"url":"/docs/connectors/sinks/bigquery#row-mapping","content":"Row mapping"},"1346":{"id":"/docs/connectors/sinks/bigquery-4","page_id":"/docs/connectors/sinks/bigquery","type":"heading","tags":[],"url":"/docs/connectors/sinks/bigquery#batching-and-failures","content":"Batching and failures"},"1347":{"id":"/docs/connectors/sinks/bigquery-5","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery","content":"The BigQuery sink writes Arrow record batches through the Storage Write API `_default` stream. The target table must already exist. Startup reads its schema and rejects unsupported column types before consuming messages."},"1348":{"id":"/docs/connectors/sinks/bigquery-6","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#configuration","content":"Build `iggy_connector_bigquery_sink` with the same release source as the runtime. Add this connector file to the local provider, then set your project, dataset and table:"},"1349":{"id":"/docs/connectors/sinks/bigquery-7","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#configuration","content":"With metadata enabled, the table needs `iggy_stream` and `iggy_topic` as STRING, `iggy_partition_id` and `iggy_offset` as INT64, `iggy_timestamp` as TIMESTAMP and `iggy_id` as STRING. `include_headers=true` also needs `iggy_headers` as JSON or STRING."},"1350":{"id":"/docs/connectors/sinks/bigquery-8","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#credentials","content":"Set either `credentials_path` or `credentials_json`, never both. Without either, the connector uses Application Default Credentials. The identity needs table schema read and row append permissions, `bigquery.tables.get` and `bigquery.tables.updateData`."},"1351":{"id":"/docs/connectors/sinks/bigquery-9","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#credentials","content":"The optional `emulator_endpoint` and `emulator_grpc_endpoint` must be supplied together. They disable credentials and use plaintext connections. Use them only for local test services."},"1352":{"id":"/docs/connectors/sinks/bigquery-10","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#row-mapping","content":"In `mapped` mode, each payload must be a JSON object. Top-level fields map to table columns by name. Unknown fields are ignored. Required columns without defaults must have non-null values. Missing or null repeated columns become empty arrays."},"1353":{"id":"/docs/connectors/sinks/bigquery-11","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#row-mapping","content":"In `raw` mode, `payload_column` defaults to `payload`. A JSON column requires valid JSON. A STRING column requires text or UTF-8 bytes. A BYTES column accepts raw bytes from any payload type. Other required columns must have defaults."},"1354":{"id":"/docs/connectors/sinks/bigquery-12","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#row-mapping","content":"NUMERIC and BIGNUMERIC values must fit the declared precision and scale without rounding. Strings preserve decimal precision when JSON floating-point values cannot. INTERVAL and RANGE columns are unsupported."},"1355":{"id":"/docs/connectors/sinks/bigquery-13","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#batching-and-failures","content":"`max_request_bytes` defaults to 8 MiB and is clamped from 64 KiB through 9 MiB. The sink splits batches to stay below the API request limit. `max_retries` defaults to three total attempts, including the first. Retry delay starts at one second and is capped at 30 seconds. Each request and startup operation has a 30-second default timeout."},"1356":{"id":"/docs/connectors/sinks/bigquery-14","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#batching-and-failures","content":"A row that cannot be encoded or accepted is logged and dropped while other rows can proceed. Transient request failures retry with jittered exponential backoff. The `_default` stream does not provide exactly-once append semantics. A lost response can lead to duplicate rows."},"1357":{"id":"/docs/connectors/sinks/bigquery-15","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#batching-and-failures","content":"The runtime commits offsets on read and does not replay a failed sink callback. A successful processed count does not prove that every row reached BigQuery. Preserve Iggy metadata when downstream deduplication or reconciliation is required. See the source reference for type mappings and row-error handling."},"1358":{"id":"/docs/connectors/sinks/clickhouse","page_id":"/docs/connectors/sinks/clickhouse","type":"page","content":"ClickHouse Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/clickhouse"},"1359":{"id":"/docs/connectors/sinks/clickhouse-0","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse","content":"Insert messages from Iggy streams into ClickHouse tables over the HTTP interface."},"1360":{"id":"/docs/connectors/sinks/clickhouse-1","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#configuration","content":"Configuration"},"1361":{"id":"/docs/connectors/sinks/clickhouse-2","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#options","content":"Options"},"1362":{"id":"/docs/connectors/sinks/clickhouse-3","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"Insert Formats"},"1363":{"id":"/docs/connectors/sinks/clickhouse-4","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#error-handling--delivery-semantics","content":"Error Handling & Delivery Semantics"},"1364":{"id":"/docs/connectors/sinks/clickhouse-5","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#transforms","content":"Transforms"},"1365":{"id":"/docs/connectors/sinks/clickhouse-6","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse","content":"The ClickHouse sink connector consumes messages from Iggy streams and inserts them into ClickHouse tables over the HTTP interface. It supports three insert formats: `json_each_row` (default), `row_binary`, and `string` passthrough for pre-formatted CSV/TSV/JSON payloads."},"1366":{"id":"/docs/connectors/sinks/clickhouse-7","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse","content":"This page is a curated subset of the documentation. The canonical reference is the upstream clickhouse_sink README in the `apache/iggy` repository."},"1367":{"id":"/docs/connectors/sinks/clickhouse-8","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.10.0 repository root, build the plugin:"},"1368":{"id":"/docs/connectors/sinks/clickhouse-9","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#configuration","content":"The sample expects a local ClickHouse HTTP endpoint with user `default` and an empty password. Create a test table with matching columns:"},"1369":{"id":"/docs/connectors/sinks/clickhouse-10","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#configuration","content":"Save the configuration below in the runtime's connector directory. Set the endpoint, credentials, database, and table for your deployment."},"1370":{"id":"/docs/connectors/sinks/clickhouse-11","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#configuration","content":"Create the Iggy stream and topic, then send a JSON row before starting the runtime:"},"1371":{"id":"/docs/connectors/sinks/clickhouse-12","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"| Option | Type   | Default      | Description              |\n| ------ | ------ | ------------ | ------------------------ |\n| `url`  | string | **required** | ClickHouse HTTP endpoint |","table":"table-0"},"1372":{"id":"/docs/connectors/sinks/clickhouse-13","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"| Option  | Type   | Default      | Description       |\n| ------- | ------ | ------------ | ----------------- |\n| `table` | string | **required** | Target table name |","table":"table-0"},"1373":{"id":"/docs/connectors/sinks/clickhouse-14","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"| Option     | Type   | Default   | Description         |\n| ---------- | ------ | --------- | ------------------- |\n| `database` | string | `default` | ClickHouse database |","table":"table-0"},"1374":{"id":"/docs/connectors/sinks/clickhouse-15","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"| Option     | Type   | Default   | Description         |\n| ---------- | ------ | --------- | ------------------- |\n| `username` | string | `default` | ClickHouse username |","table":"table-0"},"1375":{"id":"/docs/connectors/sinks/clickhouse-16","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"| Option     | Type   | Default | Description         |\n| ---------- | ------ | ------- | ------------------- |\n| `password` | string | `\"\"`    | ClickHouse password |","table":"table-0"},"1376":{"id":"/docs/connectors/sinks/clickhouse-17","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"| Option          | Type   | Default         | Description                                |\n| --------------- | ------ | --------------- | ------------------------------------------ |\n| `insert_format` | string | `json_each_row` | `json_each_row`, `row_binary`, or `string` |","table":"table-0"},"1377":{"id":"/docs/connectors/sinks/clickhouse-18","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"| Option          | Type   | Default         | Description                                                           |\n| --------------- | ------ | --------------- | --------------------------------------------------------------------- |\n| `string_format` | string | `json_each_row` | ClickHouse format for `string` mode: `json_each_row`, `csv`, or `tsv` |","table":"table-0"},"1378":{"id":"/docs/connectors/sinks/clickhouse-19","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"| Option            | Type | Default | Description                     |\n| ----------------- | ---- | ------- | ------------------------------- |\n| `timeout_seconds` | u64  | `30`    | HTTP request timeout in seconds |","table":"table-0"},"1379":{"id":"/docs/connectors/sinks/clickhouse-20","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"| Option        | Type | Default | Description                                                                                 |\n| ------------- | ---- | ------- | ------------------------------------------------------------------------------------------- |\n| `max_retries` | u32  | `3`     | Total attempts for startup requests and transient insert errors. At least one even when `0` |","table":"table-0"},"1380":{"id":"/docs/connectors/sinks/clickhouse-21","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"| Option        | Type | Default | Description                                  |\n| ------------- | ---- | ------- | -------------------------------------------- |\n| `retry_delay` | u64  | `1`     | Base for exponential retry delay, in seconds |","table":"table-0"},"1381":{"id":"/docs/connectors/sinks/clickhouse-22","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"| Option            | Type | Default | Description                                |\n| ----------------- | ---- | ------- | ------------------------------------------ |\n| `verbose_logging` | bool | `false` | Log inserts at info level instead of debug |","table":"table-0"},"1382":{"id":"/docs/connectors/sinks/clickhouse-23","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"**`json_each_row`** (default): accepts JSON payloads. Each payload is serialized on its own line using ClickHouse's `JSONEachRow` format. Send JSON objects whose fields and values are compatible with the existing table and its ClickHouse input settings. The connector does not validate JSON rows against the table schema before sending them."},"1383":{"id":"/docs/connectors/sinks/clickhouse-24","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"**`row_binary`**: accepts JSON payloads and serializes them to ClickHouse's `RowBinaryWithDefaults` binary format, which is more efficient than JSON at high volume. The table must already exist. Its schema is fetched from `system.columns` and validated at startup. Requires ClickHouse 23.7 or newer, which introduced this format. Columns with a `DEFAULT` expression may be omitted from messages. An explicit JSON `null` requires a nullable column and is stored as `NULL`, even when that column has a default. Missing columns without defaults must be nullable. `MATERIALIZED`, `ALIAS`, and `EPHEMERAL` columns are dropped from the schema. Unsupported column types (128/256-bit integers, `Variant`, native `JSON`, geo types) cause startup to fail."},"1384":{"id":"/docs/connectors/sinks/clickhouse-25","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"**`string`**: accepts text payloads and appends a newline to each payload that does not already end with one. Set the stream `schema = \"text\"`. Use `string_format` to tell ClickHouse which format the payload is in (`csv`, `tsv`, or `json_each_row`)."},"1385":{"id":"/docs/connectors/sinks/clickhouse-26","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"In `row_binary` mode the schema is captured once at startup and the insert stream is positional. An `ALTER TABLE` on the target while the connector runs can silently corrupt inserted rows, so restart the connector after any schema change. The self-describing `json_each_row` format (including `string` mode with `string_format = \"json_each_row\"`) maps values by field name, but changed column names, types, or constraints can still make inserts fail. `string` passthrough with `csv` or `tsv` sends plain positional ClickHouse formats mapped by the current table column order."},"1386":{"id":"/docs/connectors/sinks/clickhouse-27","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#error-handling--delivery-semantics","content":"Insert requests retry HTTP 408, 429, and 5xx responses, plus network and timeout errors. Other unsuccessful HTTP statuses fail immediately. `max_retries` is the total attempt limit, with at least one attempt even when set to `0`. Before retry number `n` (starting at 1), the delay is sampled from zero through `min(retry_delay * 2^n, 60)` seconds. With the defaults, there are at most three attempts and the first retry waits between zero and two seconds. The startup ping and, in `row_binary` mode, schema fetch use the same limit and backoff but retry every error."},"1387":{"id":"/docs/connectors/sinks/clickhouse-28","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#error-handling--delivery-semantics","content":"A message whose payload type does not match the chosen format is skipped with an error log. The rest of the batch is still sent. A batch with no serializable payloads returns success without an insert. In `row_binary` mode, a JSON row whose values cannot be converted to the column types fails the whole batch before any insert request, so it does not enter the plugin's insert retry loop."},"1388":{"id":"/docs/connectors/sinks/clickhouse-29","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#error-handling--delivery-semantics","content":"The runtime uses consumer auto-commit and does not replay a failed sink batch. See sink guide. End-to-end at-least-once delivery is therefore not guaranteed. Plugin retries resend the same batch without an `insert_deduplication_token`, so a lost acknowledgement can also produce duplicate rows."},"1389":{"id":"/docs/connectors/sinks/clickhouse-30","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#error-handling--delivery-semantics","content":"ClickHouse deduplication depends on the table engine, query settings, identical retry data, and the retained deduplication window. `ReplicatedMergeTree` enables a deduplication log by default. Non-replicated `MergeTree` can also deduplicate when `non_replicated_deduplication_window` is positive. Its default is zero. See ClickHouse insert deduplication for the settings and limits."},"1390":{"id":"/docs/connectors/sinks/clickhouse-31","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#transforms","content":"Transforms can be applied before inserting into ClickHouse. See the transforms documentation for the available types and their configuration."},"1391":{"id":"/docs/connectors/sinks/delta","page_id":"/docs/connectors/sinks/delta","type":"page","content":"Delta Lake Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/delta"},"1392":{"id":"/docs/connectors/sinks/delta-0","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta","content":"Write messages from Iggy streams into Delta Lake tables on local disk, S3, Azure Blob Storage or Google Cloud Storage."},"1393":{"id":"/docs/connectors/sinks/delta-1","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#configuration","content":"Configuration"},"1394":{"id":"/docs/connectors/sinks/delta-2","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#options","content":"Options"},"1395":{"id":"/docs/connectors/sinks/delta-3","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#s3-example","content":"S3 example"},"1396":{"id":"/docs/connectors/sinks/delta-4","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#type-coercion","content":"Type Coercion"},"1397":{"id":"/docs/connectors/sinks/delta-5","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#batching--transactions","content":"Batching & Transactions"},"1398":{"id":"/docs/connectors/sinks/delta-6","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#transforms","content":"Transforms"},"1399":{"id":"/docs/connectors/sinks/delta-7","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta","content":"The Delta Lake sink connector consumes messages from Iggy streams and writes them to Delta Lake tables on the local filesystem, AWS S3, Azure Blob Storage, or Google Cloud Storage. Each successful nonempty batch is flushed and appended in one Delta transaction."},"1400":{"id":"/docs/connectors/sinks/delta-8","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta","content":"This page is a curated subset of the documentation. The canonical reference is the upstream delta_sink README in the `apache/iggy` repository."},"1401":{"id":"/docs/connectors/sinks/delta-9","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#configuration","content":"Use the broker credentials and runtime setup from the sink guide. Save the configuration below in the runtime's connector directory. From the matching 0.10.0 repository root, build the plugin:"},"1402":{"id":"/docs/connectors/sinks/delta-10","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#configuration","content":"Create the target table with your Delta Lake tools before starting the connector. The table must already exist at `table_uri`: the connector opens it at startup and fails if it's missing. It doesn't create tables. Only JSON payloads are supported (`schema = \"json\"` on the stream). A batch containing another payload type fails."},"1403":{"id":"/docs/connectors/sinks/delta-11","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#configuration","content":"For a table with columns `id` (long) and `name` (string), create the Iggy resources and send a row:"},"1404":{"id":"/docs/connectors/sinks/delta-12","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#configuration","content":"Use a `file:///...` URI for an absolute local path. Bare filesystem paths are not accepted."},"1405":{"id":"/docs/connectors/sinks/delta-13","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"| Option      | Type   | Default      | Description                                                              |\n| ----------- | ------ | ------------ | ------------------------------------------------------------------------ |\n| `table_uri` | string | **required** | Absolute URI of the Delta table: `file://`, `s3://`, `az://`, or `gs://` |","table":"table-0"},"1406":{"id":"/docs/connectors/sinks/delta-14","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"| Option                 | Type   | Default | Description                                               |\n| ---------------------- | ------ | ------- | --------------------------------------------------------- |\n| `storage_backend_type` | string | none    | `s3`, `azure`, or `gcs`. Omit for local filesystem tables |","table":"table-0"},"1407":{"id":"/docs/connectors/sinks/delta-15","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"When `storage_backend_type` selects a backend, the connector validates these credential options:"},"1408":{"id":"/docs/connectors/sinks/delta-16","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"**S3**: `aws_s3_region` is required. Explicit `aws_s3_access_key` and `aws_s3_secret_key` are optional and must be supplied together. Without them, credentials come from the supported provider chain. `aws_s3_endpoint_url` is optional, for S3-compatible stores like MinIO. `aws_s3_allow_http` is optional and defaults to `false`."},"1409":{"id":"/docs/connectors/sinks/delta-17","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"**Azure**: `azure_storage_account_name`, `azure_container_name`, and either `azure_storage_account_key` or `azure_storage_sas_token` (not both)."},"1410":{"id":"/docs/connectors/sinks/delta-18","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"**GCS**: `gcs_service_account_key` (the service account JSON as a string, with the bucket taken from the `gs://` URI)."},"1411":{"id":"/docs/connectors/sinks/delta-19","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#s3-example","content":"A custom S3 endpoint restricts the default credential chain. Set `AWS_FORCE_CREDENTIAL_LOAD=true` in the runtime environment when shared profile or SSO credentials are required. Static keys, web identity, container credentials and instance metadata remain available without that override."},"1412":{"id":"/docs/connectors/sinks/delta-20","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"JSON values are coerced to the Delta table schema before writing:"},"1413":{"id":"/docs/connectors/sinks/delta-21","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"**Timestamp columns**: ISO 8601 / RFC 3339 strings (e.g. `\"2021-11-11T22:11:58Z\"`) are converted to microsecond timestamps. Integer timestamps pass through as epoch microseconds. Space-separated timestamps such as `\"2021-11-11 22:11:58\"` are interpreted as UTC. Invalid timestamp strings fail the batch."},"1414":{"id":"/docs/connectors/sinks/delta-22","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"**String columns**: non-null, non-string values are converted to their JSON string representation. Nulls remain null."},"1415":{"id":"/docs/connectors/sinks/delta-23","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"Coercions cover nested structs, arrays of strings or timestamps, and arrays of structs. Nested arrays, maps, and variant columns pass through without these coercions."},"1416":{"id":"/docs/connectors/sinks/delta-24","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"The table schema is captured once at startup and not refreshed, so restart the connector after changing it."},"1417":{"id":"/docs/connectors/sinks/delta-25","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#batching--transactions","content":"Each nonempty batch passed to the plugin is written to Parquet buffers and appended in a single Delta log transaction. Empty batches create no transaction in `consume()`. The stream's `batch_length` is a polling limit, so it influences Delta commit granularity: small batches produce many small files and table versions, so prefer larger batches for production tables (and compact periodically). The plugin has no retry loop for failed batches, though the Delta library retries eligible commit conflicts and storage requests. A write or commit failure clears the writer buffers and returns a connector error. The runtime uses consumer auto-commit and does not replay that failed batch, so the Delta transaction does not provide an end-to-end at-least-once guarantee."},"1418":{"id":"/docs/connectors/sinks/delta-26","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#transforms","content":"Transforms can be applied before writing to Delta Lake. See the transforms documentation for the available types and their configuration."},"1419":{"id":"/docs/connectors/sinks/doris","page_id":"/docs/connectors/sinks/doris","type":"page","content":"Apache Doris Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/doris"},"1420":{"id":"/docs/connectors/sinks/doris-0","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris","content":"Load JSON messages from Iggy streams into a pre-created Apache Doris table through the Stream Load HTTP API."},"1421":{"id":"/docs/connectors/sinks/doris-1","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#configuration","content":"Configuration"},"1422":{"id":"/docs/connectors/sinks/doris-2","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#common-options","content":"Common Options"},"1423":{"id":"/docs/connectors/sinks/doris-3","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#output-formats","content":"Output Formats"},"1424":{"id":"/docs/connectors/sinks/doris-4","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#delivery-semantics","content":"Delivery Semantics"},"1425":{"id":"/docs/connectors/sinks/doris-5","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#security-notes","content":"Security Notes"},"1426":{"id":"/docs/connectors/sinks/doris-6","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#transforms","content":"Transforms"},"1427":{"id":"/docs/connectors/sinks/doris-7","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris","content":"The Apache Doris sink connector consumes JSON messages from Iggy streams and writes them to a pre-created Doris table via Doris's Stream Load HTTP API. Batches are loaded under deterministic labels so that retries deduplicate while Doris retains those labels."},"1428":{"id":"/docs/connectors/sinks/doris-8","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris","content":"This page is a curated subset of the documentation. The canonical reference, including the label scheme, redirect security model, and operational guidance, is the upstream doris_sink README in the `apache/iggy` repository."},"1429":{"id":"/docs/connectors/sinks/doris-9","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#configuration","content":"Use the broker credentials and runtime setup from the sink guide. Save the configuration below in the runtime's connector directory and replace the Doris password with your own. From the matching 0.10.0 repository root, build the plugin:"},"1430":{"id":"/docs/connectors/sinks/doris-10","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#configuration","content":"The target database and table must be pre-created. The connector never issues DDL. `database` and `table` must match `[A-Za-z0-9_]+` or startup fails. Streams must use `schema = \"json\"`. Startup validates the configuration but does not check the table or connection. These are first used when a batch arrives."},"1431":{"id":"/docs/connectors/sinks/doris-11","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#configuration","content":"For a table with columns `id` (`BIGINT`) and `name` (`STRING`), create the Iggy resources and send a row:"},"1432":{"id":"/docs/connectors/sinks/doris-12","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"| Option   | Type   | Default      | Description                                                |\n| -------- | ------ | ------------ | ---------------------------------------------------------- |\n| `fe_url` | string | **required** | Doris frontend HTTP base URL, e.g. `http://localhost:8030` |","table":"table-0"},"1433":{"id":"/docs/connectors/sinks/doris-13","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"| Option     | Type   | Default      | Description                      |\n| ---------- | ------ | ------------ | -------------------------------- |\n| `database` | string | **required** | Target database, `[A-Za-z0-9_]+` |","table":"table-0"},"1434":{"id":"/docs/connectors/sinks/doris-14","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"| Option  | Type   | Default      | Description                   |\n| ------- | ------ | ------------ | ----------------------------- |\n| `table` | string | **required** | Target table, `[A-Za-z0-9_]+` |","table":"table-0"},"1435":{"id":"/docs/connectors/sinks/doris-15","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"| Option     | Type   | Default      | Description                                                                            |\n| ---------- | ------ | ------------ | -------------------------------------------------------------------------------------- |\n| `username` | string | **required** | Doris user authorized for Stream Load. Check the grants required by your Doris version |","table":"table-0"},"1436":{"id":"/docs/connectors/sinks/doris-16","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"| Option     | Type   | Default      | Description                       |\n| ---------- | ------ | ------------ | --------------------------------- |\n| `password` | string | **required** | Doris user password, never logged |","table":"table-0"},"1437":{"id":"/docs/connectors/sinks/doris-17","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"| Option       | Type | Default | Description                                                     |\n| ------------ | ---- | ------- | --------------------------------------------------------------- |\n| `batch_size` | u32  | `1000`  | Maximum messages per Stream Load request. `0` is treated as `1` |","table":"table-0"},"1438":{"id":"/docs/connectors/sinks/doris-18","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"| Option          | Type   | Default | Description                                                          |\n| --------------- | ------ | ------- | -------------------------------------------------------------------- |\n| `output_format` | string | `json`  | `json` or `csv`. CSV is opt-in for throughput and requires `columns` |","table":"table-0"},"1439":{"id":"/docs/connectors/sinks/doris-19","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"| Option    | Type   | Default | Description                                                              |\n| --------- | ------ | ------- | ------------------------------------------------------------------------ |\n| `columns` | string | unset   | Forwarded as the `columns` Stream Load header. Pins column order for CSV |","table":"table-0"},"1440":{"id":"/docs/connectors/sinks/doris-20","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"| Option    | Type   | Default | Description                                               |\n| --------- | ------ | ------- | --------------------------------------------------------- |\n| `timeout` | string | `30s`   | Per-request HTTP timeout, including each redirect request |","table":"table-0"},"1441":{"id":"/docs/connectors/sinks/doris-21","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"| Option        | Type | Default | Description                                                                              |\n| ------------- | ---- | ------- | ---------------------------------------------------------------------------------------- |\n| `max_retries` | u32  | `3`     | Total Stream Load attempts per chunk on transient failures. `0` or `1` means one attempt |","table":"table-0"},"1442":{"id":"/docs/connectors/sinks/doris-22","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Further options cover the label prefix, connect timeout, retry backoff (`retry_delay`, `max_retry_delay`), `max_filter_ratio`, a `where` filter, and redirect security (`allow_insecure_redirect`, `allowed_redirect_hosts`). See the upstream doris_sink README for the full table with defaults."},"1443":{"id":"/docs/connectors/sinks/doris-23","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#output-formats","content":"**`json`** (default): payloads are sent as a JSON array with `strip_outer_array: true`. Values map to columns by name, so the JSON shape must match the table (use `columns` if the JSON field names differ from the table columns or you need derived expressions)."},"1444":{"id":"/docs/connectors/sinks/doris-24","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#output-formats","content":"**`csv`**: opt-in for throughput. Doris CSV is positional, so `output_format = \"csv\"` **requires `columns`** to pin the column order. Startup fails without it. List bare JSON field names in order before any derived expressions in `columns`. CSV reads only the leading names before the first `=` expression. Rows are framed with control-character separators and quoted with `enclose`/`escape`, so embedded commas and newlines are safe. JSON `null` and missing keys become SQL `NULL`, empty strings remain empty, and nested objects or arrays are stringified as JSON. The target Doris column types must accept the resulting values."},"1445":{"id":"/docs/connectors/sinks/doris-25","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#delivery-semantics","content":"Each poll is split into chunks of at most `batch_size` messages. Each chunk gets a deterministic label based on `label_prefix`, the target table, stream, topic, partition, and first/last offsets. Transient failures (HTTP 5xx/408/429, transport errors, empty or unreadable successful responses) are retried under the same label. Backoff starts at `retry_delay`, doubles for each retry, applies ±20% jitter, and never exceeds `max_retry_delay`. Other HTTP 4xx responses, `Fail` status, and nonempty malformed responses are permanent errors and are not retried."},"1446":{"id":"/docs/connectors/sinks/doris-26","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#delivery-semantics","content":"`Label Already Exists` is accepted only when the existing job is `FINISHED`. `RUNNING` and `CANCELLED` are retried. `Publish Timeout` is accepted as committed, although rows may not yet be visible. Deduplication lasts only while Doris retains the label. Check the retention settings for your Doris version. Doris 4.0.3 uses `streaming_label_keep_max_second` (default 12 hours) for Stream Load. See Doris FE configuration."},"1447":{"id":"/docs/connectors/sinks/doris-27","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#delivery-semantics","content":"The runtime uses consumer auto-commit before the sink finishes. After a chunk fails, the plugin still attempts later chunks and returns the first error. The runtime logs and counts that error, adds no processed messages for the failed batch, and continues polling without replaying it. A crash or exhausted retry budget can therefore lose data. A non-JSON payload aborts the remaining chunks immediately."},"1448":{"id":"/docs/connectors/sinks/doris-28","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#delivery-semantics","content":"For a manual redrive, preserve the label inputs and chunk boundaries, including both `batch_length` and `batch_size`. Poll sizes can also vary, so unchanged settings alone do not guarantee the same labels. Changed boundaries or expired labels can produce duplicates. This is not an end-to-end exactly-once guarantee."},"1449":{"id":"/docs/connectors/sinks/doris-29","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#delivery-semantics","content":"If `max_filter_ratio` permits malformed rows, Doris can accept a load while dropping those rows. The plugin logs a warning when Doris reports them. The `where` option deliberately excludes rows before loading."},"1450":{"id":"/docs/connectors/sinks/doris-30","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#security-notes","content":"Use `https://` for `fe_url` in production: credentials travel as HTTP Basic auth."},"1451":{"id":"/docs/connectors/sinks/doris-31","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#security-notes","content":"The connector preserves the `Authorization` header across Doris FE-to-BE 307/308 redirects, validating each target first. When `fe_url` uses HTTPS, an HTTP redirect target is refused unless `allow_insecure_redirect = true`. `Location` must be absolute, and at most five redirects are followed per attempt. A nonempty `allowed_redirect_hosts` list restricts destinations to the listed hosts or `host:port` endpoints. An unset or empty list does not restrict hosts."},"1452":{"id":"/docs/connectors/sinks/doris-32","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#security-notes","content":"`columns` and `where` are forwarded verbatim to Doris and evaluated as SQL expressions. Keep this config trusted."},"1453":{"id":"/docs/connectors/sinks/doris-33","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#transforms","content":"Transforms can be applied before loading into Doris. See the transforms documentation for the available types and their configuration."},"1454":{"id":"/docs/connectors/sinks/elasticsearch","page_id":"/docs/connectors/sinks/elasticsearch","type":"page","content":"Elasticsearch Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/elasticsearch"},"1455":{"id":"/docs/connectors/sinks/elasticsearch-0","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch","content":"Index messages from Iggy streams into an Elasticsearch index using the bulk API."},"1456":{"id":"/docs/connectors/sinks/elasticsearch-1","page_id":"/docs/connectors/sinks/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/elasticsearch#configuration","content":"Configuration"},"1457":{"id":"/docs/connectors/sinks/elasticsearch-2","page_id":"/docs/connectors/sinks/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"Plugin config options"},"1458":{"id":"/docs/connectors/sinks/elasticsearch-3","page_id":"/docs/connectors/sinks/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/elasticsearch#index-mapping","content":"Index mapping"},"1459":{"id":"/docs/connectors/sinks/elasticsearch-4","page_id":"/docs/connectors/sinks/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/elasticsearch#payload-handling","content":"Payload handling"},"1460":{"id":"/docs/connectors/sinks/elasticsearch-5","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch","content":"The Elasticsearch sink connector consumes messages from Iggy streams and indexes them into an Elasticsearch index using the bulk API."},"1461":{"id":"/docs/connectors/sinks/elasticsearch-6","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#configuration","content":"Use the broker credentials and runtime setup from the sink guide. Save the configuration below in the runtime's connector directory and replace the Elasticsearch credentials with your own. From the matching 0.10.0 repository root, build the plugin:"},"1462":{"id":"/docs/connectors/sinks/elasticsearch-7","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#configuration","content":"Create the Iggy resources and send a JSON document:"},"1463":{"id":"/docs/connectors/sinks/elasticsearch-8","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"| Option | Type   | Default  | Description               |\n| ------ | ------ | -------- | ------------------------- |\n| `url`  | string | required | Elasticsearch cluster URL |","table":"table-0"},"1464":{"id":"/docs/connectors/sinks/elasticsearch-9","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"| Option  | Type   | Default  | Description       |\n| ------- | ------ | -------- | ----------------- |\n| `index` | string | required | Target index name |","table":"table-0"},"1465":{"id":"/docs/connectors/sinks/elasticsearch-10","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"| Option                  | Type   | Default | Description                                                              |\n| ----------------------- | ------ | ------- | ------------------------------------------------------------------------ |\n| `username` / `password` | string | none    | Optional basic authentication. Both values must be supplied to enable it |","table":"table-0"},"1466":{"id":"/docs/connectors/sinks/elasticsearch-11","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"| Option                       | Type | Default | Description                                    |\n| ---------------------------- | ---- | ------- | ---------------------------------------------- |\n| `create_index_if_not_exists` | bool | `true`  | Create the index on startup when it is missing |","table":"table-0"},"1467":{"id":"/docs/connectors/sinks/elasticsearch-12","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"| Option          | Type  | Default | Description                                           |\n| --------------- | ----- | ------- | ----------------------------------------------------- |\n| `index_mapping` | table | none    | Body of the create-index request (mappings, settings) |","table":"table-0"},"1468":{"id":"/docs/connectors/sinks/elasticsearch-13","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"| Option       | Type    | Default | Description                                      |\n| ------------ | ------- | ------- | ------------------------------------------------ |\n| `batch_size` | integer | unused  | Accepted but currently not read by the connector |","table":"table-0"},"1469":{"id":"/docs/connectors/sinks/elasticsearch-14","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"| Option            | Type    | Default | Description                                                                                   |\n| ----------------- | ------- | ------- | --------------------------------------------------------------------------------------------- |\n| `timeout_seconds` | integer | `30`    | HTTP request timeout in seconds, from connection through response body. `0` is treated as `1` |","table":"table-0"},"1470":{"id":"/docs/connectors/sinks/elasticsearch-15","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"The stream-level `batch_length` governs batching: each consume cycle submits its supported messages in one bulk request. The connector performs no retries of its own. Request, HTTP-status, and response-decoding failures return an error. The runtime logs and counts it, adds no processed messages for that batch, and continues polling. Consumer auto-commit occurs before indexing completes, and the failed poll is not replayed."},"1471":{"id":"/docs/connectors/sinks/elasticsearch-16","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"Individual document errors inside a successful bulk response are logged and counted in the plugin's closing statistics, but the plugin still returns success. The runtime's processed-message count can therefore include documents rejected by Elasticsearch. Monitor the document-error logs as well as runtime errors."},"1472":{"id":"/docs/connectors/sinks/elasticsearch-17","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"Bulk actions do not specify document IDs. Elasticsearch generates them, so replaying a message can create another document. The connector does not provide end-to-end exactly-once delivery."},"1473":{"id":"/docs/connectors/sinks/elasticsearch-18","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#index-mapping","content":"`index_mapping` is sent verbatim as the body of the create-index request, so it must be a structured object, not a JSON string embedded in TOML. It is used only when the connector creates an index. It does not update an existing index and is ignored when `create_index_if_not_exists = false`. That setting disables the startup existence check too. Express the mapping as nested TOML tables:"},"1474":{"id":"/docs/connectors/sinks/elasticsearch-19","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#payload-handling","content":"JSON objects are indexed as documents directly. Other JSON values are forwarded without being wrapped as objects and can be rejected by Elasticsearch."},"1475":{"id":"/docs/connectors/sinks/elasticsearch-20","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#payload-handling","content":"Raw payloads are parsed as JSON when possible, and wrapped as `{ \"data\": \"<base64>\", \"data_type\": \"raw\" }` when that fails."},"1476":{"id":"/docs/connectors/sinks/elasticsearch-21","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#payload-handling","content":"Text payloads are wrapped as `{ \"text\": \"...\", \"data_type\": \"text\" }`."},"1477":{"id":"/docs/connectors/sinks/elasticsearch-22","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#payload-handling","content":"Other payload formats are skipped with a warning."},"1478":{"id":"/docs/connectors/sinks/elasticsearch-23","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#payload-handling","content":"Object documents are enriched before indexing with `_iggy_offset`, `_iggy_stream`, `_iggy_topic`, `_iggy_partition`, and `_iggy_timestamp`. These fields replace matching payload fields. `_iggy_timestamp` is the connector's processing time in Unix epoch milliseconds, not the message's stored timestamp. `_iggy_headers` is added or replaced only when message headers are present."},"1479":{"id":"/docs/connectors/sinks/elasticsearch-24","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#payload-handling","content":"Use HTTPS when credentials must be protected in transit. The connector uses the Elasticsearch client's certificate verification. This configuration does not expose a switch to disable it."},"1480":{"id":"/docs/connectors/sinks/http","page_id":"/docs/connectors/sinks/http","type":"page","content":"HTTP Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/http"},"1481":{"id":"/docs/connectors/sinks/http-0","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http","content":"Deliver messages from Iggy streams to any HTTP endpoint, from webhooks and REST APIs to serverless functions."},"1482":{"id":"/docs/connectors/sinks/http-1","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#configuration","content":"Configuration"},"1483":{"id":"/docs/connectors/sinks/http-2","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#common-options","content":"Common Options"},"1484":{"id":"/docs/connectors/sinks/http-3","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#batch-modes","content":"Batch Modes"},"1485":{"id":"/docs/connectors/sinks/http-4","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#metadata-envelope","content":"Metadata Envelope"},"1486":{"id":"/docs/connectors/sinks/http-5","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#authentication","content":"Authentication"},"1487":{"id":"/docs/connectors/sinks/http-6","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"Retry & Delivery Semantics"},"1488":{"id":"/docs/connectors/sinks/http-7","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#example-configurations","content":"Example Configurations"},"1489":{"id":"/docs/connectors/sinks/http-8","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#webhook-slack","content":"Webhook (Slack)"},"1490":{"id":"/docs/connectors/sinks/http-9","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#bulk-rest-api-ingestion","content":"Bulk REST API Ingestion"},"1491":{"id":"/docs/connectors/sinks/http-10","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#iot--sensor-relay-binary-payloads","content":"IoT / Sensor Relay (binary payloads)"},"1492":{"id":"/docs/connectors/sinks/http-11","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#deployment--performance","content":"Deployment & Performance"},"1493":{"id":"/docs/connectors/sinks/http-12","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#known-limitations","content":"Known Limitations"},"1494":{"id":"/docs/connectors/sinks/http-13","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http","content":"The HTTP Sink connector consumes messages from Iggy streams and delivers them to any HTTP endpoint: webhooks, REST APIs, serverless functions, or SaaS integrations. This is the transport-level, generic HTTP connector. It's distinct from sinks such as Elasticsearch or Quickwit, which use HTTP internally to talk to one specific system. You bring the URL, headers, and batching strategy, and the sink handles transport, retries, and metadata wrapping."},"1495":{"id":"/docs/connectors/sinks/http-14","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http","content":"This page is a curated subset of the documentation. The canonical reference, including the full configuration table, deployment patterns, and performance analysis, is the upstream http_sink README in the `apache/iggy` repository."},"1496":{"id":"/docs/connectors/sinks/http-15","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.10.0 repository root, build the plugin:"},"1497":{"id":"/docs/connectors/sinks/http-16","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#configuration","content":"For a local receiver, run this in a separate terminal:"},"1498":{"id":"/docs/connectors/sinks/http-17","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#configuration","content":"Save this configuration in the runtime's connector directory:"},"1499":{"id":"/docs/connectors/sinks/http-18","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#configuration","content":"Create the Iggy resources and send a JSON message, then start the connector runtime using the sink guide:"},"1500":{"id":"/docs/connectors/sinks/http-19","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"| Option | Type   | Default      | Description                  |\n| ------ | ------ | ------------ | ---------------------------- |\n| `url`  | string | **required** | Target URL for HTTP requests |","table":"table-0"},"1501":{"id":"/docs/connectors/sinks/http-20","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"| Option   | Type   | Default | Description                                                  |\n| -------- | ------ | ------- | ------------------------------------------------------------ |\n| `method` | string | `POST`  | HTTP method: `GET`, `HEAD`, `POST`, `PUT`, `PATCH`, `DELETE` |","table":"table-0"},"1502":{"id":"/docs/connectors/sinks/http-21","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"| Option       | Type   | Default      | Description                                    |\n| ------------ | ------ | ------------ | ---------------------------------------------- |\n| `batch_mode` | string | `individual` | `individual`, `ndjson`, `json_array`, or `raw` |","table":"table-0"},"1503":{"id":"/docs/connectors/sinks/http-22","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"| Option             | Type | Default | Description                       |\n| ------------------ | ---- | ------- | --------------------------------- |\n| `include_metadata` | bool | `true`  | Wrap payload in metadata envelope |","table":"table-0"},"1504":{"id":"/docs/connectors/sinks/http-23","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"| Option    | Type  | Default | Description                                |\n| --------- | ----- | ------- | ------------------------------------------ |\n| `headers` | table | `{}`    | Custom HTTP headers (e.g. `Authorization`) |","table":"table-0"},"1505":{"id":"/docs/connectors/sinks/http-24","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"| Option    | Type   | Default | Description                           |\n| --------- | ------ | ------- | ------------------------------------- |\n| `timeout` | string | `30s`   | Request timeout (e.g. `10s`, `500ms`) |","table":"table-0"},"1506":{"id":"/docs/connectors/sinks/http-25","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"Further options cover retries (`max_retries`, `retry_delay`, `retry_backoff_multiplier`, `max_retry_delay`), success status codes, payload size limits, TLS, connection pooling, health checks, and verbose logging. See the upstream http_sink README for the full list with defaults."},"1507":{"id":"/docs/connectors/sinks/http-26","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"The body size limit defaults to 10 MiB and applies after serialization: per message in `individual`/`raw`, or to the whole batch in `ndjson`/`json_array`. Setting `max_payload_size_bytes = 0` disables it. Oversized bodies fail without being sent. Optional startup health checks use the same URL, retry policy and success codes, with `HEAD` as the default method."},"1508":{"id":"/docs/connectors/sinks/http-27","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"`GET` and `HEAD` are accepted but unusual for delivering data: the request still carries a body, which some servers reject. The sink logs a warning at startup when `GET` or `HEAD` is combined with a batch mode other than `individual`."},"1509":{"id":"/docs/connectors/sinks/http-28","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#batch-modes","content":"The `batch_mode` option controls how messages from one poll cycle are delivered to the endpoint."},"1510":{"id":"/docs/connectors/sinks/http-29","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#batch-modes","content":"**`individual`** (default): one HTTP request per message. Best for webhooks and endpoints that accept single events. With `batch_length = 50`, a full poll can produce 50 sequential requests, before retries. Shorter polls and failures can produce fewer."},"1511":{"id":"/docs/connectors/sinks/http-30","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#batch-modes","content":"**`ndjson`**: all messages in one request, newline-delimited JSON. Best for bulk-ingestion endpoints. `Content-Type: application/x-ndjson`."},"1512":{"id":"/docs/connectors/sinks/http-31","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#batch-modes","content":"**`json_array`**: all messages as a single JSON array. Best for APIs that expect array payloads. `Content-Type: application/json`."},"1513":{"id":"/docs/connectors/sinks/http-32","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#batch-modes","content":"**`raw`**: raw bytes, one request per message. For non-JSON payloads (Protobuf, FlatBuffers, binary). The metadata envelope is not applied. `Content-Type: application/octet-stream`."},"1514":{"id":"/docs/connectors/sinks/http-33","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#batch-modes","content":"For production throughput with JSON-representable payloads, prefer `ndjson` or `json_array`, which collapse N round trips per poll cycle into one."},"1515":{"id":"/docs/connectors/sinks/http-34","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"When `include_metadata = true` (default), the JSON-mode payload is wrapped:"},"1516":{"id":"/docs/connectors/sinks/http-35","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"`iggy_id` is a 32-character lowercase hex string (no dashes)."},"1517":{"id":"/docs/connectors/sinks/http-36","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"`iggy_timestamp` is the message timestamp in Unix epoch microseconds. `include_checksum` and `include_origin_timestamp` add the corresponding metadata fields. Both default to `false`."},"1518":{"id":"/docs/connectors/sinks/http-37","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"Nonempty message headers become `iggy_headers`: non-raw values are strings, and raw values use a base64 `data` object with `iggy_header_encoding = \"base64\"`."},"1519":{"id":"/docs/connectors/sinks/http-38","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"Set `include_metadata = false` to send the payload without wrapping (useful when the downstream service expects bare JSON, e.g. Slack webhooks)."},"1520":{"id":"/docs/connectors/sinks/http-39","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"In JSON batch modes, raw, FlatBuffer, Protobuf and Avro payload variants are base64-encoded with an explicit marker:"},"1521":{"id":"/docs/connectors/sinks/http-40","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"With the envelope enabled, this object becomes the `payload` field shown above. JSON values are reserialized and text payloads become JSON strings."},"1522":{"id":"/docs/connectors/sinks/http-41","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"The runtime applies stream decoding and configured transforms before the sink formats its requests. To forward opaque message bytes, use `schema = \"raw\"` with `batch_mode = \"raw\"` and no transforms. See the SDK format limits when selecting other schemas."},"1523":{"id":"/docs/connectors/sinks/http-42","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"The connector doesn't expect the metadata envelope on input. It adds it on the way out. Producers must supply payloads accepted by the configured stream decoder and the receiving endpoint."},"1524":{"id":"/docs/connectors/sinks/http-43","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#authentication","content":"The HTTP sink supports authentication via custom headers under `[plugin_config.headers]`. Custom headers are sent with data requests and health checks, except `Content-Type`: the sink ignores a configured value and sets it from the batch mode for data requests."},"1525":{"id":"/docs/connectors/sinks/http-44","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#authentication","content":"Other valid headers work the same way: use `x-api-key = \"my-secret-api-key\"` for API-key schemes, or `Authorization = \"Basic dXNlcm5hbWU6cGFzc3dvcmQ=\"` (base64 of `username:password`) for basic auth. Multiple headers are combined per request. Configure header secrets in a protected connector TOML file. The local provider supports environment overrides for flat plugin fields, such as `URL`, but not nested headers or JSON objects. `HEADERS_AUTHORIZATION` creates an unused flat field, and a JSON object supplied through `HEADERS` is parsed as a string and fails plugin initialization."},"1526":{"id":"/docs/connectors/sinks/http-45","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"Transient failures allow up to `max_retries` additional attempts after the initial request: the default `3` means at most four attempts. Retry delays use full jitter from zero up to `min(retry_delay * retry_backoff_multiplier^n, max_retry_delay)`, where `n` starts at zero for the first retry. With the defaults, the three delay caps are 1, 2 and 4 seconds."},"1527":{"id":"/docs/connectors/sinks/http-46","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"**Transient errors** (retried): network errors, HTTP 429, 500, 502, 503, 504."},"1528":{"id":"/docs/connectors/sinks/http-47","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"**Non-transient errors** (fail immediately): HTTP 400, 401, 403, 404, 405, etc."},"1529":{"id":"/docs/connectors/sinks/http-48","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"**`success_status_codes`** (default `[200, 201, 202, 204]`) short-circuits retries: any status code in this set is treated as success and is never retried, even codes that are normally transient. Placing `429` in the set makes the sink accept rate-limited responses as delivered. The sink warns at startup about such overlaps."},"1530":{"id":"/docs/connectors/sinks/http-49","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"**HTTP 429 `Retry-After`**: on unsuccessful responses, the header is logged but not honored. Retry timing always uses the computed backoff."},"1531":{"id":"/docs/connectors/sinks/http-50","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"**Partial delivery** (`individual`/`raw` modes): after a fixed number of consecutive HTTP failures (3 at the time of writing, not configurable), the remainder of the batch is aborted to avoid hammering a dead endpoint."},"1532":{"id":"/docs/connectors/sinks/http-51","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"The connector runtime uses consumer auto-commit before `consume()` completes. A plugin error is logged and counted, the failed batch adds no processed messages, and polling continues without replaying that batch. Earlier messages or requests from the same batch may already have succeeded. A crash or exhausted retry budget can lose messages. A retry after an ambiguous response can deliver them again. There is no end-to-end at-least-once or exactly-once guarantee."},"1533":{"id":"/docs/connectors/sinks/http-52","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"HTTP success is determined by the response status. The sink does not inspect a successful response body for per-item failures."},"1534":{"id":"/docs/connectors/sinks/http-53","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#example-configurations","content":"Replace the corresponding blocks in the complete configuration above, and supply your own endpoint URLs and credentials."},"1535":{"id":"/docs/connectors/sinks/http-54","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#webhook-slack","content":"Use `schema = \"json\"` and publish JSON in the shape Slack expects, for example `{\"text\":\"hello\"}`. `include_metadata = false` skips the envelope, but JSON is still reserialized. The original bytes and whitespace are not preserved."},"1536":{"id":"/docs/connectors/sinks/http-55","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#deployment--performance","content":"One `iggy-connectors` runtime process can host many connectors: the local config provider imports every connector TOML file under its `config_dir`, and each entry gets its own plugin instance and consume tasks in the same process. Each connector entry has exactly one `[plugin_config]` block and therefore one destination URL. To send to multiple destinations, add multiple HTTP sink entries with distinct keys and URLs (in the same runtime or separate ones). For fan-out from a single topic to multiple endpoints, point multiple sink entries at the same topic with different `consumer_group` names so each maintains its own offset."},"1537":{"id":"/docs/connectors/sinks/http-56","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#deployment--performance","content":"Throughput is dominated by batch-mode choice: the runtime calls `consume()` sequentially within each topic task, so a full N-message batch uses N requests in `individual`/`raw`, or one in `ndjson`/`json_array`, before retries or skipped messages. Connection pooling and HTTP keep-alive are enabled by default. `max_connections` limits idle connections retained per host, not concurrent requests. Topic tasks can issue requests concurrently. Each topic awaits its own batch before continuing. Tune pooling and `batch_length` for the receiving service."},"1538":{"id":"/docs/connectors/sinks/http-57","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#deployment--performance","content":"For multi-instance deployment patterns (Docker, Kubernetes, fan-out topologies), connection pool tuning, and full performance analysis, see the upstream http_sink README."},"1539":{"id":"/docs/connectors/sinks/http-58","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"**No `Retry-After` honoring**: the header is logged but doesn't influence retry timing."},"1540":{"id":"/docs/connectors/sinks/http-59","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"**No dead-letter queue**: failed messages are logged at `error!` level but not persisted."},"1541":{"id":"/docs/connectors/sinks/http-60","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"**No request signing**: AWS SigV4, HMAC, and similar schemes aren't supported. Use custom headers or a signing proxy."},"1542":{"id":"/docs/connectors/sinks/http-61","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"**No per-topic URL routing**: all topics in one connector instance share the same `url`. For routing, deploy multiple instances."},"1543":{"id":"/docs/connectors/sinks/http-62","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"**No OAuth2 / OIDC token refresh**: bearer tokens are static. Use an auth proxy for services that require token rotation."},"1544":{"id":"/docs/connectors/sinks/http-63","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"**No mTLS client certificates**: terminate mTLS at a sidecar proxy for production use."},"1545":{"id":"/docs/connectors/sinks/http-64","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"**Plaintext secrets in config**: header values are stored verbatim in `config.toml`. Mount or generate a protected connector TOML file containing the required header values before starting the runtime."},"1546":{"id":"/docs/connectors/sinks/http-65","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"For the complete list and implementation context, see the upstream http_sink README."},"1547":{"id":"/docs/connectors/sinks/iceberg","page_id":"/docs/connectors/sinks/iceberg","type":"page","content":"Iceberg Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/iceberg"},"1548":{"id":"/docs/connectors/sinks/iceberg-0","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg","content":"Consume messages from Iggy topics and store them in Iceberg tables, with REST catalogs and S3-compatible storage."},"1549":{"id":"/docs/connectors/sinks/iceberg-1","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#features","content":"Features"},"1550":{"id":"/docs/connectors/sinks/iceberg-2","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#configuration-example","content":"Configuration example"},"1551":{"id":"/docs/connectors/sinks/iceberg-3","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#configuration-options","content":"Configuration Options"},"1552":{"id":"/docs/connectors/sinks/iceberg-4","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#static-routing","content":"Static Routing"},"1553":{"id":"/docs/connectors/sinks/iceberg-5","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"Dynamic Routing"},"1554":{"id":"/docs/connectors/sinks/iceberg-6","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#dynamic-routing-configuration-example","content":"Dynamic routing configuration example"},"1555":{"id":"/docs/connectors/sinks/iceberg-7","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#batches-and-table-commits","content":"Batches and table commits"},"1556":{"id":"/docs/connectors/sinks/iceberg-8","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#source-compatibility","content":"Source Compatibility"},"1557":{"id":"/docs/connectors/sinks/iceberg-9","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#commit-rate-and-maintenance","content":"Commit rate and maintenance"},"1558":{"id":"/docs/connectors/sinks/iceberg-10","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg","content":"The Iceberg Sink Connector allows you to consume messages from Iggy topics and store them in Iceberg tables."},"1559":{"id":"/docs/connectors/sinks/iceberg-11","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#features","content":"**Support for S3-compatible storage**"},"1560":{"id":"/docs/connectors/sinks/iceberg-12","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#features","content":"**Support for REST catalogs**"},"1561":{"id":"/docs/connectors/sinks/iceberg-13","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#features","content":"**Single destination table**"},"1562":{"id":"/docs/connectors/sinks/iceberg-14","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#features","content":"**Multiple-table fan-out static routing**"},"1563":{"id":"/docs/connectors/sinks/iceberg-15","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#features","content":"**Multiple-table fan-out dynamic routing**"},"1564":{"id":"/docs/connectors/sinks/iceberg-16","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-example","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.10.0 repository root, build the plugin:"},"1565":{"id":"/docs/connectors/sinks/iceberg-17","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-example","content":"The example requires a REST catalog at `http://localhost:8181` and S3-compatible storage at `http://localhost:9000`, configured with the credentials below. Create the storage bucket, namespace and target table before starting the connector. The sink does not create them."},"1566":{"id":"/docs/connectors/sinks/iceberg-18","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-example","content":"For a local catalog without authentication, create `nyc.users` with `id` (long) and `name` (string):"},"1567":{"id":"/docs/connectors/sinks/iceberg-19","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-example","content":"Save this complete connector file in the runtime's connector directory:"},"1568":{"id":"/docs/connectors/sinks/iceberg-20","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-example","content":"Create the Iggy resources and send a row:"},"1569":{"id":"/docs/connectors/sinks/iceberg-21","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"All options below are required except the credential pair and `store_path_style_access`. `tables` and `dynamic_route_field` must be present even when the selected routing mode does not use them."},"1570":{"id":"/docs/connectors/sinks/iceberg-22","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"**tables**: The names of the Iceberg tables you want to statically route Iggy messages to. The name should include the table’s namespace, separated by a dot (`.`). Ignored when `dynamic_routing = true`."},"1571":{"id":"/docs/connectors/sinks/iceberg-23","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"**catalog_type**: The type of catalog you are routing data to. **Currently, only REST catalogs are fully supported.**"},"1572":{"id":"/docs/connectors/sinks/iceberg-24","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"**warehouse**: The warehouse value sent to the REST catalog. Its meaning depends on the catalog service. Data file destinations come from each table’s metadata."},"1573":{"id":"/docs/connectors/sinks/iceberg-25","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"**uri**: The URI of the Iceberg catalog."},"1574":{"id":"/docs/connectors/sinks/iceberg-26","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"**dynamic_routing**: Enables dynamic routing. See more details later in this document."},"1575":{"id":"/docs/connectors/sinks/iceberg-27","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"**dynamic_route_field**: The top-level message field that specifies the Iceberg table to route data to. Ignored in static mode. See more details below."},"1576":{"id":"/docs/connectors/sinks/iceberg-28","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"**store_url**: The URL of the object storage for data uploads."},"1577":{"id":"/docs/connectors/sinks/iceberg-29","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"**store_access_key_id**: The optional access key ID of the object storage."},"1578":{"id":"/docs/connectors/sinks/iceberg-30","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"**store_secret_access_key**: The optional secret key used to upload data to the object storage. Supply both credential fields or omit both to use the default AWS credential provider chain."},"1579":{"id":"/docs/connectors/sinks/iceberg-31","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"**store_region**: The region of the object storage. Required. For S3-compatible stores that ignore it, supply any placeholder value."},"1580":{"id":"/docs/connectors/sinks/iceberg-32","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"**store_class**: The storage class to use. **Currently, only S3-compatible storage is supported.**"},"1581":{"id":"/docs/connectors/sinks/iceberg-33","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"**store_path_style_access**: Use path-style S3 URLs (`http://host/bucket/key`). Defaults to `true`. Set to `false` for stores that require virtual-hosted-style URLs."},"1582":{"id":"/docs/connectors/sinks/iceberg-34","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#static-routing","content":"With `dynamic_routing = false`, every batch is copied to every successfully loaded table in `tables`. Invalid names and tables that cannot be loaded are skipped at startup. Startup fails if no table can be loaded. The writer uses each table's schema and default partition spec captured at startup, so restart the connector after changing them."},"1583":{"id":"/docs/connectors/sinks/iceberg-35","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"If you don't know the names of the Iceberg tables you want to route data to in advance, you can use the dynamic routing feature. Insert a top-level field in your JSON messages with the name of the Iceberg table the message should be routed to. The Iggy connector will parse this field at runtime and route the message to the correct table."},"1584":{"id":"/docs/connectors/sinks/iceberg-36","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"The Iggy Iceberg Connector will skip messages in the following cases:"},"1585":{"id":"/docs/connectors/sinks/iceberg-37","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"The table declared in the message field cannot be loaded, including missing tables and catalog lookup failures."},"1586":{"id":"/docs/connectors/sinks/iceberg-38","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"The table name has no namespace or contains an empty name component."},"1587":{"id":"/docs/connectors/sinks/iceberg-39","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"The message does not contain the field specified in the `dynamic_route_field` configuration option, or is not a JSON object."},"1588":{"id":"/docs/connectors/sinks/iceberg-40","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"A lookup failure skips the affected message. It does not fail the batch. Each batch loads its destination tables again. The route field is included in the JSON row, but is ignored by the writer if the target schema has no matching column."},"1589":{"id":"/docs/connectors/sinks/iceberg-41","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing-configuration-example","content":"Replace `[plugin_config]` in the complete connector file above and append the transform below. `tables = []` is intentional: the route field chooses the destination in this mode."},"1590":{"id":"/docs/connectors/sinks/iceberg-42","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing-configuration-example","content":"Transforms are declared at the top level of the connector file, next to `[plugin_config]`, and every `[transforms.*]` section requires `enabled = true`. See the transforms documentation for details."},"1591":{"id":"/docs/connectors/sinks/iceberg-43","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing-configuration-example","content":"**Note:** The value in the message field **must** contain both the namespace and the table name, separated by a dot (`.`). Example:"},"1592":{"id":"/docs/connectors/sinks/iceberg-44","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing-configuration-example","content":"Namespace: `nyc`"},"1593":{"id":"/docs/connectors/sinks/iceberg-45","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing-configuration-example","content":"Table name: `users`"},"1594":{"id":"/docs/connectors/sinks/iceberg-46","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#batches-and-table-commits","content":"Rows are converted to Arrow using the target table schema, written to Parquet, then appended in an Iceberg transaction per destination table. Partitioned tables split a batch by the default partition spec. Writers can roll over into multiple files, so there is no fixed one-file-per-batch guarantee for either partitioned or unpartitioned tables."},"1595":{"id":"/docs/connectors/sinks/iceberg-47","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#batches-and-table-commits","content":"Fan-out is not atomic across tables. A write or commit error stops work on the remaining tables in that batch. An earlier table may already be committed. The Iceberg library refreshes metadata before committing and retries eligible commit errors according to the table's retry properties. The plugin does not replay a failed batch. The runtime records a plugin error and continues polling with consumer auto-commit, so messages can be lost after a failed or skipped write. Replaying an already committed batch can create duplicates."},"1596":{"id":"/docs/connectors/sinks/iceberg-48","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#source-compatibility","content":"Use `schema = \"json\"` on the stream. Each JSON object represents a table row. Nested objects and arrays are supported when they match the table schema. Unknown fields are ignored. Missing nullable fields become null. Missing required fields or incompatible values fail the table write."},"1597":{"id":"/docs/connectors/sinks/iceberg-49","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#source-compatibility","content":"Sources that wrap row data in an envelope need a transform when the table schema describes the inner row. Otherwise, the Arrow JSON reader maps envelope keys to table columns, producing nulls or schema errors."},"1598":{"id":"/docs/connectors/sinks/iceberg-50","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#source-compatibility","content":"If your source emits envelope-wrapped JSON, use the `unwrap_envelope` transform to extract the inner data field before it reaches the sink:"},"1599":{"id":"/docs/connectors/sinks/iceberg-51","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#source-compatibility","content":"Set `field` to the envelope key that holds the row data. See the transforms documentation and your source connector's documentation for details on the envelope shape."},"1600":{"id":"/docs/connectors/sinks/iceberg-52","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#commit-rate-and-maintenance","content":"Each runtime batch creates one append commit per destination table. Larger batches reduce snapshot and manifest growth. Use `batch_length=1000`, `min_count=1000` and `max_wait=\"5s\"` in the stream entry when this latency fits the workload. The reply byte budget can finish a read earlier."},"1601":{"id":"/docs/connectors/sinks/iceberg-53","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#commit-rate-and-maintenance","content":"The sink logs each skipped message with its offset. It does not expire table snapshots or rewrite manifests. Run table maintenance through the catalog or an engine that supports it, with retention appropriate for your time-travel requirements."},"1602":{"id":"/docs/connectors/sinks/influxdb","page_id":"/docs/connectors/sinks/influxdb","type":"page","content":"InfluxDB Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/influxdb"},"1603":{"id":"/docs/connectors/sinks/influxdb-0","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb","content":"Write messages from Iggy streams to InfluxDB as line-protocol points, on both InfluxDB V2 and V3."},"1604":{"id":"/docs/connectors/sinks/influxdb-1","page_id":"/docs/connectors/sinks/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/influxdb#configuration","content":"Configuration"},"1605":{"id":"/docs/connectors/sinks/influxdb-2","page_id":"/docs/connectors/sinks/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/influxdb#common-options","content":"Common Options"},"1606":{"id":"/docs/connectors/sinks/influxdb-3","page_id":"/docs/connectors/sinks/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/influxdb#payload-formats","content":"Payload Formats"},"1607":{"id":"/docs/connectors/sinks/influxdb-4","page_id":"/docs/connectors/sinks/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/influxdb#reliability","content":"Reliability"},"1608":{"id":"/docs/connectors/sinks/influxdb-5","page_id":"/docs/connectors/sinks/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/influxdb#transforms","content":"Transforms"},"1609":{"id":"/docs/connectors/sinks/influxdb-6","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb","content":"The InfluxDB sink connector consumes messages from Iggy streams and writes them to InfluxDB as line-protocol points. It supports both InfluxDB V2 (OSS 2.x / Cloud) and InfluxDB V3 (Core / Enterprise), selected with the `version` option."},"1610":{"id":"/docs/connectors/sinks/influxdb-7","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb","content":"This page is a curated subset of the documentation. The canonical reference is the upstream influxdb_sink README in the `apache/iggy` repository."},"1611":{"id":"/docs/connectors/sinks/influxdb-8","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.10.0 repository root, build the plugin:"},"1612":{"id":"/docs/connectors/sinks/influxdb-9","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#configuration","content":"Create the InfluxDB organization and bucket (V2), or database (V3), and provide a token with write access. Save the following connector file in the runtime's connector directory, replacing the URL and token for your deployment. Startup checks `GET /health` with the configured token, using `Token` authentication for V2 and `Bearer` for V3. A successful health check does not verify write permissions."},"1613":{"id":"/docs/connectors/sinks/influxdb-10","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#configuration","content":"Create the Iggy resources and send a row:"},"1614":{"id":"/docs/connectors/sinks/influxdb-11","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#configuration","content":"InfluxDB V2 organizes data as `org` + `bucket`. V3 uses a single `db` field instead. Omitting `version` defaults to `\"v2\"` for backward compatibility. The write body, batching, and retry behavior are identical between versions. The connector handles the differing endpoints, auth header styles, and precision spellings internally."},"1615":{"id":"/docs/connectors/sinks/influxdb-12","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#configuration","content":"For V3, replace the entire `[plugin_config]` section. Unknown options are rejected, so remove the V2 `org` and `bucket` fields:"},"1616":{"id":"/docs/connectors/sinks/influxdb-13","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"| Option    | Type   | Default | Description  |\n| --------- | ------ | ------- | ------------ |\n| `version` | string | `v2`    | `v2` or `v3` |","table":"table-0"},"1617":{"id":"/docs/connectors/sinks/influxdb-14","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"| Option | Type   | Default      | Description       |\n| ------ | ------ | ------------ | ----------------- |\n| `url`  | string | **required** | InfluxDB base URL |","table":"table-0"},"1618":{"id":"/docs/connectors/sinks/influxdb-15","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"| Option | Type   | Default           | Description       |\n| ------ | ------ | ----------------- | ----------------- |\n| `org`  | string | **required** (v2) | Organization name |","table":"table-0"},"1619":{"id":"/docs/connectors/sinks/influxdb-16","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"| Option   | Type   | Default           | Description   |\n| -------- | ------ | ----------------- | ------------- |\n| `bucket` | string | **required** (v2) | Target bucket |","table":"table-0"},"1620":{"id":"/docs/connectors/sinks/influxdb-17","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"| Option | Type   | Default           | Description     |\n| ------ | ------ | ----------------- | --------------- |\n| `db`   | string | **required** (v3) | Target database |","table":"table-0"},"1621":{"id":"/docs/connectors/sinks/influxdb-18","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"| Option  | Type   | Default      | Description                                              |\n| ------- | ------ | ------------ | -------------------------------------------------------- |\n| `token` | string | **required** | API token. Redacted in the plugin’s debug representation |","table":"table-0"},"1622":{"id":"/docs/connectors/sinks/influxdb-19","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"| Option        | Type   | Default         | Description                    |\n| ------------- | ------ | --------------- | ------------------------------ |\n| `measurement` | string | `iggy_messages` | Line-protocol measurement name |","table":"table-0"},"1623":{"id":"/docs/connectors/sinks/influxdb-20","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"| Option      | Type   | Default | Description                                   |\n| ----------- | ------ | ------- | --------------------------------------------- |\n| `precision` | string | `us`    | Timestamp precision: `ns`, `us`, `ms`, or `s` |","table":"table-0"},"1624":{"id":"/docs/connectors/sinks/influxdb-21","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"| Option       | Type | Default | Description                                            |\n| ------------ | ---- | ------- | ------------------------------------------------------ |\n| `batch_size` | u32  | `500`   | Maximum messages per write request. `0` behaves as `1` |","table":"table-0"},"1625":{"id":"/docs/connectors/sinks/influxdb-22","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"| Option           | Type   | Default | Description                 |\n| ---------------- | ------ | ------- | --------------------------- |\n| `payload_format` | string | `json`  | `json`, `text`, or `base64` |","table":"table-0"},"1626":{"id":"/docs/connectors/sinks/influxdb-23","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"| Option             | Type | Default | Description                                                                                             |\n| ------------------ | ---- | ------- | ------------------------------------------------------------------------------------------------------- |\n| `include_metadata` | bool | `true`  | Include stream/topic/partition metadata as tags or fields. Independent of checksum and origin timestamp |","table":"table-0"},"1627":{"id":"/docs/connectors/sinks/influxdb-24","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"The `include_checksum`, `include_origin_timestamp`, `include_stream_tag`, `include_topic_tag`, and `include_partition_tag` flags also default to `true`."},"1628":{"id":"/docs/connectors/sinks/influxdb-25","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"`message_id` is always a string field and `offset` is always a tag."},"1629":{"id":"/docs/connectors/sinks/influxdb-26","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"With `include_metadata = true`, stream, topic and partition are tags by default. Disabling an individual `include_*_tag` flag writes that value as an `iggy_stream`, `iggy_topic`, or `iggy_partition` field instead."},"1630":{"id":"/docs/connectors/sinks/influxdb-27","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"`include_metadata = false` omits those three values. It does not disable the independently controlled `iggy_checksum` and `iggy_origin_timestamp` fields."},"1631":{"id":"/docs/connectors/sinks/influxdb-28","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"Point timestamps come from the Iggy message timestamp in microseconds, converted to `precision`. A zero timestamp uses the current wall-clock time. Millisecond and second precision discard finer timestamp digits."},"1632":{"id":"/docs/connectors/sinks/influxdb-29","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"InfluxDB identifies points by measurement/table, tags and timestamp. Removing stream, topic or partition tags can merge distinct messages that share an offset and timestamp. Moving those values to fields does not preserve their identity. See the V2 and V3 duplicate-point rules."},"1633":{"id":"/docs/connectors/sinks/influxdb-30","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"Resilience options include `timeout` (`30s`), `max_retries` (`3` total write attempts), `retry_delay` (`1s`), `retry_max_delay` (`5s`), `max_open_retries` (`10` total health-check attempts), `open_retry_max_delay` (`60s`), `circuit_breaker_threshold` (`5`), and `circuit_breaker_cool_down` (`30s`). Invalid duration strings warn and fall back to `1s`. See the upstream influxdb_sink README for the full list."},"1634":{"id":"/docs/connectors/sinks/influxdb-31","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#payload-formats","content":"**`json`** (default): the message payload is validated as JSON, compact-serialized, and written as a single `payload_json` string field (individual JSON fields do not become separate field entries)."},"1635":{"id":"/docs/connectors/sinks/influxdb-32","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#payload-formats","content":"**`text`**: the payload must be valid UTF-8 and is written as a single `payload_text` string field."},"1636":{"id":"/docs/connectors/sinks/influxdb-33","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#payload-formats","content":"**`base64`**: the payload bytes are base64-encoded into a `payload_base64` string field."},"1637":{"id":"/docs/connectors/sinks/influxdb-34","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#payload-formats","content":"`payload_format` selects the stored representation after stream decoding and transforms. For arbitrary bytes, use `schema = \"raw\"` with `payload_format = \"base64\"` and no payload-changing transform. For plain text, use `schema = \"text\"` with `payload_format = \"text\"`. JSON stream decoding can change the original byte representation."},"1638":{"id":"/docs/connectors/sinks/influxdb-35","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#payload-formats","content":"Text carriage returns and newlines become the literal sequences `\\r` and `\\n` in the stored string. Use base64 if those original bytes must round-trip. Tabs in measurement names or tag values are rejected. Quoted text fields allow tabs."},"1639":{"id":"/docs/connectors/sinks/influxdb-36","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#payload-formats","content":"Format names are case-insensitive. `utf8` aliases `text` and `raw` aliases `base64`. An unrecognized `payload_format` logs a warning and falls back to `json`."},"1640":{"id":"/docs/connectors/sinks/influxdb-37","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#reliability","content":"Messages are serialized to line protocol and each polled batch is split into chunks of at most `batch_size` messages, one HTTP POST per chunk. The final partial chunk is written immediately. The connector does not accumulate messages across polls. A serialization error rejects its entire chunk. Later chunks are still attempted after a failure, and the first error is returned after the loop."},"1641":{"id":"/docs/connectors/sinks/influxdb-38","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#reliability","content":"HTTP 429, all 5xx responses, and network errors are retried. `max_retries = 3` allows the initial attempt plus two retries. `0` and `1` both allow one attempt. Backoff starts at `retry_delay`, doubles, adds ±20% jitter, and is capped by `retry_max_delay`. An integer-seconds `Retry-After` on a 429 or any 5xx can lengthen the calculated delay past `retry_max_delay`, up to one hour, but never shortens it. HTTP-date and unparsable values fall back to the calculated delay. Startup health checks use a separate attempt budget and cap, retrying any failed check."},"1642":{"id":"/docs/connectors/sinks/influxdb-39","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#reliability","content":"The circuit breaker counts at most one failure per consumed batch, based on its first error. A permanent HTTP error does not increment the counter. A fully successful batch resets it. While the breaker is open, incoming batches fail without a write. After the cool-down window, writes resume and the failure counter resets."},"1643":{"id":"/docs/connectors/sinks/influxdb-40","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#reliability","content":"The runtime records a plugin error and continues polling with consumer auto-commit. Failed chunks and batches skipped by the circuit breaker are not queued for replay, so retries and the circuit breaker do not provide an end-to-end at-least-once guarantee. Other chunks from the same batch may already have reached InfluxDB."},"1644":{"id":"/docs/connectors/sinks/influxdb-41","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#transforms","content":"Transforms can be applied before writing to InfluxDB. See the transforms documentation for the available types and their configuration."},"1645":{"id":"/docs/connectors/sinks/meilisearch","page_id":"/docs/connectors/sinks/meilisearch","type":"page","content":"Meilisearch Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/meilisearch"},"1646":{"id":"/docs/connectors/sinks/meilisearch-0","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch","content":"Index messages from Iggy streams as documents in a Meilisearch index through the official Rust SDK."},"1647":{"id":"/docs/connectors/sinks/meilisearch-1","page_id":"/docs/connectors/sinks/meilisearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/meilisearch#configuration","content":"Configuration"},"1648":{"id":"/docs/connectors/sinks/meilisearch-2","page_id":"/docs/connectors/sinks/meilisearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/meilisearch#common-options","content":"Common Options"},"1649":{"id":"/docs/connectors/sinks/meilisearch-3","page_id":"/docs/connectors/sinks/meilisearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/meilisearch#document-mapping","content":"Document Mapping"},"1650":{"id":"/docs/connectors/sinks/meilisearch-4","page_id":"/docs/connectors/sinks/meilisearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/meilisearch#delivery-semantics","content":"Delivery Semantics"},"1651":{"id":"/docs/connectors/sinks/meilisearch-5","page_id":"/docs/connectors/sinks/meilisearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/meilisearch#transforms","content":"Transforms"},"1652":{"id":"/docs/connectors/sinks/meilisearch-6","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch","content":"The Meilisearch sink connector consumes messages from Iggy streams and indexes them as documents in a Meilisearch index through the official Rust SDK. It can create the index on startup and waits for Meilisearch indexing tasks to complete by default, so task failures surface as connector errors."},"1653":{"id":"/docs/connectors/sinks/meilisearch-7","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch","content":"This page is a curated subset of the documentation. The canonical reference is the upstream meilisearch_sink README in the `apache/iggy` repository."},"1654":{"id":"/docs/connectors/sinks/meilisearch-8","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.10.0 repository root, build the plugin:"},"1655":{"id":"/docs/connectors/sinks/meilisearch-9","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#configuration","content":"Save this connector file in the runtime's connector directory. Replace the URL and API key with your Meilisearch endpoint and credentials. The key needs permission to inspect the index, submit documents and read tasks, plus create the index when needed. Startup checks health, checks the index, and waits for index creation to succeed even when `wait_for_tasks = false`. Set `primary_key` to match an existing index. A mismatch only produces a startup warning. The connector does not change the index key, and document tasks can fail."},"1656":{"id":"/docs/connectors/sinks/meilisearch-10","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#configuration","content":"Create the Iggy resources and send a document:"},"1657":{"id":"/docs/connectors/sinks/meilisearch-11","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"| Option | Type   | Default      | Description                                                                                           |\n| ------ | ------ | ------------ | ----------------------------------------------------------------------------------------------------- |\n| `url`  | string | **required** | Meilisearch base URL. Paths, query strings and fragments are ignored. Missing scheme defaults to HTTP |","table":"table-0"},"1658":{"id":"/docs/connectors/sinks/meilisearch-12","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"| Option  | Type   | Default      | Description      |\n| ------- | ------ | ------------ | ---------------- |\n| `index` | string | **required** | Target index UID |","table":"table-0"},"1659":{"id":"/docs/connectors/sinks/meilisearch-13","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"| Option    | Type   | Default | Description                                                            |\n| --------- | ------ | ------- | ---------------------------------------------------------------------- |\n| `api_key` | string | none    | API key sent as `Authorization: Bearer`. Use HTTPS for non-local hosts |","table":"table-0"},"1660":{"id":"/docs/connectors/sinks/meilisearch-14","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"| Option        | Type   | Default   | Description             |\n| ------------- | ------ | --------- | ----------------------- |\n| `primary_key` | string | `iggy_id` | Index primary key field |","table":"table-0"},"1661":{"id":"/docs/connectors/sinks/meilisearch-15","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"| Option            | Type   | Default   | Description                                            |\n| ----------------- | ------ | --------- | ------------------------------------------------------ |\n| `document_action` | string | `replace` | `replace` (add-or-replace) or `update` (add-or-update) |","table":"table-0"},"1662":{"id":"/docs/connectors/sinks/meilisearch-16","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"| Option                       | Type | Default | Description                                  |\n| ---------------------------- | ---- | ------- | -------------------------------------------- |\n| `create_index_if_not_exists` | bool | `true`  | Create the index during startup when missing |","table":"table-0"},"1663":{"id":"/docs/connectors/sinks/meilisearch-17","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"| Option             | Type | Default | Description                                              |\n| ------------------ | ---- | ------- | -------------------------------------------------------- |\n| `include_metadata` | bool | `true`  | Add reserved `iggy_*` provenance fields to each document |","table":"table-0"},"1664":{"id":"/docs/connectors/sinks/meilisearch-18","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"| Option       | Type  | Default | Description                                                   |\n| ------------ | ----- | ------- | ------------------------------------------------------------- |\n| `batch_size` | usize | `1000`  | Maximum documents per Meilisearch request. `0` behaves as `1` |","table":"table-0"},"1665":{"id":"/docs/connectors/sinks/meilisearch-19","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"| Option           | Type | Default | Description                                                     |\n| ---------------- | ---- | ------- | --------------------------------------------------------------- |\n| `wait_for_tasks` | bool | `true`  | Wait for indexing success or failure, bounded by `task_timeout` |","table":"table-0"},"1666":{"id":"/docs/connectors/sinks/meilisearch-20","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"| Option    | Type   | Default | Description                                                             |\n| --------- | ------ | ------- | ----------------------------------------------------------------------- |\n| `timeout` | string | `30s`   | Total deadline per retried SDK operation. Per attempt for health checks |","table":"table-0"},"1667":{"id":"/docs/connectors/sinks/meilisearch-21","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"Further options cover task polling (`task_timeout` `30s`, `task_poll_interval` `100ms`) and transient retries (`max_retries` `3`, `retry_delay` `500ms`, `max_retry_delay` `5s`, `max_open_retries` `5`). Both retry limits count retries after the first request, so `max_retries = 3` permits up to four attempts within the operation deadline. Backoff doubles from `retry_delay`, adds ±20% jitter and is capped at `max_retry_delay`. Reversed delay bounds are swapped. Invalid duration strings warn and fall back to `1s`. There is no single deadline for the whole startup sequence. See the upstream meilisearch_sink README for details."},"1668":{"id":"/docs/connectors/sinks/meilisearch-22","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#document-mapping","content":"JSON object payloads are indexed as documents directly. JSON arrays and scalars are wrapped in a `value` field, since Meilisearch documents must be objects. Raw payloads are parsed as JSON when possible and otherwise indexed in `data` as base64, with `data_type = \"raw\"` and `data_encoding = \"base64\"`. Text payloads land in `text` with `data_type = \"text\"`. These mappings apply after stream decoding and transforms. Use `schema = \"raw\"` or `schema = \"text\"` for those representations. Unsupported payload variants are skipped with a warning and counted in the plugin's private error counter. A successful callback after these drops can still count the whole batch as processed in runtime statistics."},"1669":{"id":"/docs/connectors/sinks/meilisearch-23","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#document-mapping","content":"When the configured primary key is absent from a document, the connector injects a stable value derived from the stream, topic, partition, offset, and message ID, avoiding Meilisearch primary-key inference failures. An existing key is preserved, including an invalid or null value that Meilisearch may reject, unless a reserved metadata field below overwrites it. Use unique values that meet Meilisearch's document ID rules. Reusing a key with `replace` replaces the whole document, removing omitted fields. `update` keeps fields omitted from the new document. Both actions can insert a new document."},"1670":{"id":"/docs/connectors/sinks/meilisearch-24","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#document-mapping","content":"With `include_metadata = true`, stream, topic, partition, offset, checksum, message ID, timestamps and available headers are written as reserved `iggy_*` fields after payload parsing, overwriting same-named payload fields. The exception is a supplied `iggy_id` when it is the configured primary key. With a different primary key, `iggy_id` holds the generated Iggy identity. Avoid other reserved metadata fields as your primary key because metadata overwrites them."},"1671":{"id":"/docs/connectors/sinks/meilisearch-25","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#document-mapping","content":"`iggy_checksum` and `iggy_message_id` are strings. Offsets and message timestamps remain numbers. Message timestamps are microseconds, while `iggy_ingested_at` uses current wall-clock milliseconds. Disabling metadata leaves payload fields intact and still injects a missing primary key."},"1672":{"id":"/docs/connectors/sinks/meilisearch-26","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#delivery-semantics","content":"Each polled batch is split into requests of at most `batch_size` documents, with no accumulation across polls. The first failed chunk stops the loop. Later chunks are not attempted. Earlier chunks may already be indexed."},"1673":{"id":"/docs/connectors/sinks/meilisearch-27","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#delivery-semantics","content":"Transient submission and task-status errors are retried within their budgets. A failed indexing task is returned as an error without resubmitting it. A task timeout does not cancel the remote task, so it may finish later. The runtime records plugin errors and continues polling with consumer auto-commit. It does not replay failed batches. This does not provide an end-to-end at-least-once guarantee, and retries or manual replay after uncertain outcomes can repeat writes."},"1674":{"id":"/docs/connectors/sinks/meilisearch-28","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#delivery-semantics","content":"Setting `wait_for_tasks = false` returns after submission, before Meilisearch confirms indexing. Later task failures are neither observed nor retried by the connector. Index-creation tasks are still awaited during startup. Closing the connector does not wait for outstanding document tasks."},"1675":{"id":"/docs/connectors/sinks/meilisearch-29","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#transforms","content":"Transforms can be applied before indexing into Meilisearch. See the transforms documentation for the available types and their configuration."},"1676":{"id":"/docs/connectors/sinks/mongodb","page_id":"/docs/connectors/sinks/mongodb","type":"page","content":"MongoDB Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/mongodb"},"1677":{"id":"/docs/connectors/sinks/mongodb-0","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb","content":"Insert messages from Iggy streams into a MongoDB collection, one document per message."},"1678":{"id":"/docs/connectors/sinks/mongodb-1","page_id":"/docs/connectors/sinks/mongodb","type":"heading","tags":[],"url":"/docs/connectors/sinks/mongodb#configuration","content":"Configuration"},"1679":{"id":"/docs/connectors/sinks/mongodb-2","page_id":"/docs/connectors/sinks/mongodb","type":"heading","tags":[],"url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"Plugin config options"},"1680":{"id":"/docs/connectors/sinks/mongodb-3","page_id":"/docs/connectors/sinks/mongodb","type":"heading","tags":[],"url":"/docs/connectors/sinks/mongodb#stored-documents","content":"Stored Documents"},"1681":{"id":"/docs/connectors/sinks/mongodb-4","page_id":"/docs/connectors/sinks/mongodb","type":"heading","tags":[],"url":"/docs/connectors/sinks/mongodb#delivery-semantics","content":"Delivery Semantics"},"1682":{"id":"/docs/connectors/sinks/mongodb-5","page_id":"/docs/connectors/sinks/mongodb","type":"heading","tags":[],"url":"/docs/connectors/sinks/mongodb#transforms","content":"Transforms"},"1683":{"id":"/docs/connectors/sinks/mongodb-6","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb","content":"The MongoDB sink connector writes messages from Iggy streams to a MongoDB database. Each message is inserted as a document into the configured collection."},"1684":{"id":"/docs/connectors/sinks/mongodb-7","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.10.0 repository root, build the plugin:"},"1685":{"id":"/docs/connectors/sinks/mongodb-8","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#configuration","content":"Save this connector file in the runtime's connector directory and replace the MongoDB URI and destination names for your deployment. Startup parses the URI and pings the target database. `max_pool_size`, when set, overrides the URI's pool setting. Other connection options come from the MongoDB driver and URI."},"1686":{"id":"/docs/connectors/sinks/mongodb-9","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#configuration","content":"Create the Iggy resources and send a message:"},"1687":{"id":"/docs/connectors/sinks/mongodb-10","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"| Option           | Type   | Default  | Description               |\n| ---------------- | ------ | -------- | ------------------------- |\n| `connection_uri` | string | required | MongoDB connection string |","table":"table-0"},"1688":{"id":"/docs/connectors/sinks/mongodb-11","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"| Option     | Type   | Default  | Description          |\n| ---------- | ------ | -------- | -------------------- |\n| `database` | string | required | Target database name |","table":"table-0"},"1689":{"id":"/docs/connectors/sinks/mongodb-12","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"| Option       | Type   | Default  | Description            |\n| ------------ | ------ | -------- | ---------------------- |\n| `collection` | string | required | Target collection name |","table":"table-0"},"1690":{"id":"/docs/connectors/sinks/mongodb-13","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"| Option          | Type | Default        | Description                                    |\n| --------------- | ---- | -------------- | ---------------------------------------------- |\n| `max_pool_size` | u32  | driver default | Maximum connections in the MongoDB client pool |","table":"table-0"},"1691":{"id":"/docs/connectors/sinks/mongodb-14","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"| Option       | Type | Default | Description                                           |\n| ------------ | ---- | ------- | ----------------------------------------------------- |\n| `batch_size` | u32  | `100`   | Maximum documents per insert call. `0` behaves as `1` |","table":"table-0"},"1692":{"id":"/docs/connectors/sinks/mongodb-15","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"| Option             | Type | Default | Description                                                     |\n| ------------------ | ---- | ------- | --------------------------------------------------------------- |\n| `include_metadata` | bool | `true`  | Include offset, timestamp, stream, topic and partition metadata |","table":"table-0"},"1693":{"id":"/docs/connectors/sinks/mongodb-16","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"| Option             | Type | Default | Description              |\n| ------------------ | ---- | ------- | ------------------------ |\n| `include_checksum` | bool | `true`  | Include message checksum |","table":"table-0"},"1694":{"id":"/docs/connectors/sinks/mongodb-17","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"| Option                     | Type | Default | Description                       |\n| -------------------------- | ---- | ------- | --------------------------------- |\n| `include_origin_timestamp` | bool | `true`  | Include client-provided timestamp |","table":"table-0"},"1695":{"id":"/docs/connectors/sinks/mongodb-18","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"| Option           | Type   | Default    | Description                                                                                                                       |\n| ---------------- | ------ | ---------- | --------------------------------------------------------------------------------------------------------------------------------- |\n| `payload_format` | string | `\"binary\"` | How to store the payload: `\"json\"`, `\"string\"` (alias `\"text\"`), or `\"binary\"`. Unknown values fall back to binary with a warning |","table":"table-0"},"1696":{"id":"/docs/connectors/sinks/mongodb-19","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"| Option                   | Type | Default | Description                                                                                           |\n| ------------------------ | ---- | ------- | ----------------------------------------------------------------------------------------------------- |\n| `auto_create_collection` | bool | `false` | Explicitly create a missing collection at startup. `false` still permits creation by the first insert |","table":"table-0"},"1697":{"id":"/docs/connectors/sinks/mongodb-20","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"| Option            | Type | Default | Description             |\n| ----------------- | ---- | ------- | ----------------------- |\n| `verbose_logging` | bool | `false` | Enable detailed logging |","table":"table-0"},"1698":{"id":"/docs/connectors/sinks/mongodb-21","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"| Option        | Type | Default | Description                                                                                                 |\n| ------------- | ---- | ------- | ----------------------------------------------------------------------------------------------------------- |\n| `max_retries` | u32  | `3`     | Total attempts per transiently failing insert call, including the first. `0` and `1` both allow one attempt |","table":"table-0"},"1699":{"id":"/docs/connectors/sinks/mongodb-22","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"| Option        | Type   | Default | Description                                                   |\n| ------------- | ------ | ------- | ------------------------------------------------------------- |\n| `retry_delay` | string | `\"1s\"`  | Base for linear backoff: delay multiplied by the retry number |","table":"table-0"},"1700":{"id":"/docs/connectors/sinks/mongodb-23","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#stored-documents","content":"Every document has a generated `_id` of `stream:topic:partition:message_id` and a `payload` field. The offset is not part of the ID. Payload fields remain nested under `payload`, so a payload's own `_id` does not replace the connector's ID. Message headers are not stored."},"1701":{"id":"/docs/connectors/sinks/mongodb-24","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#stored-documents","content":"`json` parses the payload and converts it to a BSON value under `payload`, including objects, arrays and scalars. Invalid JSON or an unsupported BSON conversion rejects the whole chunk before insertion."},"1702":{"id":"/docs/connectors/sinks/mongodb-25","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#stored-documents","content":"`string` and its `text` alias require valid UTF-8 and store a BSON string."},"1703":{"id":"/docs/connectors/sinks/mongodb-26","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#stored-documents","content":"`binary` stores BSON Binary with the generic subtype. Use `schema = \"raw\"` and no payload-changing transform to preserve original bytes."},"1704":{"id":"/docs/connectors/sinks/mongodb-27","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#stored-documents","content":"Format names are case-insensitive. Formatting happens after stream decoding and transforms, so JSON decoding can change the original bytes."},"1705":{"id":"/docs/connectors/sinks/mongodb-28","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#stored-documents","content":"With `include_metadata = true`, documents contain `iggy_offset`, `iggy_timestamp`, `iggy_stream`, `iggy_topic` and `iggy_partition_id`. Offsets above the signed 64-bit range use `iggy_offset_str` instead. Partition IDs use a BSON 32-bit integer when possible and a 64-bit integer otherwise. `iggy_checksum` is a 64-bit integer when possible and a decimal string otherwise. Message and origin timestamps become BSON datetimes, truncating microseconds to milliseconds. Checksum and origin timestamp flags are independent of `include_metadata`. `_id` and `payload` are always present."},"1706":{"id":"/docs/connectors/sinks/mongodb-29","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#delivery-semantics","content":"Each polled batch is split into chunks of at most `batch_size` messages. Chunks are inserted immediately with unordered `insert_many`. Other documents can succeed when one is rejected. Later chunks are still attempted after a failure, and the last chunk error is returned. There is no accumulation across polls and no transaction covering the batch."},"1707":{"id":"/docs/connectors/sinks/mongodb-30","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#delivery-semantics","content":"The connector retries transient insert failures up to `max_retries` total attempts, with linear waits of `retry_delay`, twice that delay, and so on. An invalid delay silently falls back to `1s`. Driver-level retryable writes may add retries independently, according to the URI and MongoDB deployment. Startup has no connector-level retry loop."},"1708":{"id":"/docs/connectors/sinks/mongodb-31","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#delivery-semantics","content":"An insert error containing only duplicate-key errors (`11000`) and no write-concern error is treated as success. This covers all unique indexes, not only `_id`, and does not compare payload contents. Reusing a message ID in one stream/topic/partition preserves the existing document. A conflict on another unique index can also discard a distinct message while runtime reports it processed. Account for this when choosing collection indexes."},"1709":{"id":"/docs/connectors/sinks/mongodb-32","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#delivery-semantics","content":"The runtime auto-commits while polling, records plugin errors and continues without replaying the failed batch. Earlier or later chunks may already be stored, and a timeout can leave the write outcome uncertain. Duplicate tolerance and retries do not provide an end-to-end at-least-once guarantee."},"1710":{"id":"/docs/connectors/sinks/mongodb-33","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#transforms","content":"You can apply transforms before writing to MongoDB. Every `[transforms.*]` section requires `enabled = true`. See the transforms documentation for details."},"1711":{"id":"/docs/connectors/sinks/postgres","page_id":"/docs/connectors/sinks/postgres","type":"page","content":"Postgres Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/postgres"},"1712":{"id":"/docs/connectors/sinks/postgres-0","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres","content":"Store messages from Iggy topics in a PostgreSQL table, with optional table creation and configurable payload storage."},"1713":{"id":"/docs/connectors/sinks/postgres-1","page_id":"/docs/connectors/sinks/postgres","type":"heading","tags":[],"url":"/docs/connectors/sinks/postgres#features","content":"Features"},"1714":{"id":"/docs/connectors/sinks/postgres-2","page_id":"/docs/connectors/sinks/postgres","type":"heading","tags":[],"url":"/docs/connectors/sinks/postgres#configuration","content":"Configuration"},"1715":{"id":"/docs/connectors/sinks/postgres-3","page_id":"/docs/connectors/sinks/postgres","type":"heading","tags":[],"url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"Plugin config options"},"1716":{"id":"/docs/connectors/sinks/postgres-4","page_id":"/docs/connectors/sinks/postgres","type":"heading","tags":[],"url":"/docs/connectors/sinks/postgres#payload-format","content":"Payload Format"},"1717":{"id":"/docs/connectors/sinks/postgres-5","page_id":"/docs/connectors/sinks/postgres","type":"heading","tags":[],"url":"/docs/connectors/sinks/postgres#table-schema","content":"Table Schema"},"1718":{"id":"/docs/connectors/sinks/postgres-6","page_id":"/docs/connectors/sinks/postgres","type":"heading","tags":[],"url":"/docs/connectors/sinks/postgres#querying-the-data","content":"Querying the Data"},"1719":{"id":"/docs/connectors/sinks/postgres-7","page_id":"/docs/connectors/sinks/postgres","type":"heading","tags":[],"url":"/docs/connectors/sinks/postgres#delivery-semantics","content":"Delivery Semantics"},"1720":{"id":"/docs/connectors/sinks/postgres-8","page_id":"/docs/connectors/sinks/postgres","type":"heading","tags":[],"url":"/docs/connectors/sinks/postgres#performance-considerations","content":"Performance Considerations"},"1721":{"id":"/docs/connectors/sinks/postgres-9","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres","content":"The PostgreSQL sink connector consumes messages from Iggy topics and stores them in a PostgreSQL table, with optional automatic table creation and configurable payload storage."},"1722":{"id":"/docs/connectors/sinks/postgres-10","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres","content":"This page is a curated subset of the documentation. The canonical reference, including SQL query recipes for each payload format, is the upstream postgres_sink README in the `apache/iggy` repository."},"1723":{"id":"/docs/connectors/sinks/postgres-11","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#features","content":"**Automatic Table Creation**: Optionally create the target table on startup"},"1724":{"id":"/docs/connectors/sinks/postgres-12","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#features","content":"**Batch Processing**: Insert messages in configurable batches for performance"},"1725":{"id":"/docs/connectors/sinks/postgres-13","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#features","content":"**Metadata Storage**: Store Iggy message metadata (offset, timestamp, topic, etc.)"},"1726":{"id":"/docs/connectors/sinks/postgres-14","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#features","content":"**Configurable Payload Storage**: Store the payload as raw bytes, native JSONB, or text"},"1727":{"id":"/docs/connectors/sinks/postgres-15","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#features","content":"**Automatic Retries**: Transient database errors are retried with a configurable delay"},"1728":{"id":"/docs/connectors/sinks/postgres-16","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#features","content":"**Connection Pooling**: Efficient database connection management"},"1729":{"id":"/docs/connectors/sinks/postgres-17","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.10.0 repository root, build the plugin:"},"1730":{"id":"/docs/connectors/sinks/postgres-18","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#configuration","content":"For a local PostgreSQL instance matching the example credentials:"},"1731":{"id":"/docs/connectors/sinks/postgres-19","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#configuration","content":"Wait for the readiness command to report accepting connections. Save this connector file in the runtime's connector directory. Replace the URI for your deployment. Startup opens the SQLx pool and runs `SELECT 1`. It creates the table only when requested."},"1732":{"id":"/docs/connectors/sinks/postgres-20","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#configuration","content":"Create the Iggy resources and send a message:"},"1733":{"id":"/docs/connectors/sinks/postgres-21","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"| Option              | Type   | Default  | Description                  |\n| ------------------- | ------ | -------- | ---------------------------- |\n| `connection_string` | string | required | PostgreSQL connection string |","table":"table-0"},"1734":{"id":"/docs/connectors/sinks/postgres-22","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"| Option         | Type   | Default  | Description                                                                                    |\n| -------------- | ------ | -------- | ---------------------------------------------------------------------------------------------- |\n| `target_table` | string | required | One table identifier, quoted as a whole. `schema.table` names a literal table containing a dot |","table":"table-0"},"1735":{"id":"/docs/connectors/sinks/postgres-23","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"| Option       | Type | Default | Description                                               |\n| ------------ | ---- | ------- | --------------------------------------------------------- |\n| `batch_size` | u32  | `100`   | Maximum messages per insert statement. `0` behaves as `1` |","table":"table-0"},"1736":{"id":"/docs/connectors/sinks/postgres-24","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"| Option            | Type | Default | Description              |\n| ----------------- | ---- | ------- | ------------------------ |\n| `max_connections` | u32  | `10`    | Max database connections |","table":"table-0"},"1737":{"id":"/docs/connectors/sinks/postgres-25","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"| Option              | Type | Default | Description                                                        |\n| ------------------- | ---- | ------- | ------------------------------------------------------------------ |\n| `auto_create_table` | bool | `false` | Run `CREATE TABLE IF NOT EXISTS`. Existing tables are not migrated |","table":"table-0"},"1738":{"id":"/docs/connectors/sinks/postgres-26","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"| Option             | Type | Default | Description                                                    |\n| ------------------ | ---- | ------- | -------------------------------------------------------------- |\n| `include_metadata` | bool | `true`  | Include offset, timestamp, stream, topic and partition columns |","table":"table-0"},"1739":{"id":"/docs/connectors/sinks/postgres-27","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"| Option             | Type | Default | Description              |\n| ------------------ | ---- | ------- | ------------------------ |\n| `include_checksum` | bool | `true`  | Include message checksum |","table":"table-0"},"1740":{"id":"/docs/connectors/sinks/postgres-28","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"| Option                     | Type | Default | Description                        |\n| -------------------------- | ---- | ------- | ---------------------------------- |\n| `include_origin_timestamp` | bool | `true`  | Include original message timestamp |","table":"table-0"},"1741":{"id":"/docs/connectors/sinks/postgres-29","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"| Option           | Type   | Default   | Description                                                     |\n| ---------------- | ------ | --------- | --------------------------------------------------------------- |\n| `payload_format` | string | `\"bytea\"` | Payload column type: `bytea`, `json` (alias `jsonb`), or `text` |","table":"table-0"},"1742":{"id":"/docs/connectors/sinks/postgres-30","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"| Option            | Type | Default | Description                        |\n| ----------------- | ---- | ------- | ---------------------------------- |\n| `verbose_logging` | bool | `false` | Log at info level instead of debug |","table":"table-0"},"1743":{"id":"/docs/connectors/sinks/postgres-31","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"| Option        | Type | Default | Description                                                                                            |\n| ------------- | ---- | ------- | ------------------------------------------------------------------------------------------------------ |\n| `max_retries` | u32  | `3`     | Total attempts per transiently failing insert, including the first. `0` and `1` both allow one attempt |","table":"table-0"},"1744":{"id":"/docs/connectors/sinks/postgres-32","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"| Option        | Type   | Default | Description                                                             |\n| ------------- | ------ | ------- | ----------------------------------------------------------------------- |\n| `retry_delay` | string | `\"1s\"`  | Base for linear retry delays. Invalid values silently fall back to `1s` |","table":"table-0"},"1745":{"id":"/docs/connectors/sinks/postgres-33","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"The `payload_format` option determines the type of the `payload` column and how the message payload is stored:"},"1746":{"id":"/docs/connectors/sinks/postgres-34","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"| Format  | Column Type | Description                                                                                                                              |\n| ------- | ----------- | ---------------------------------------------------------------------------------------------------------------------------------------- |\n| `bytea` | `BYTEA`     | Bytes after stream decoding and transforms (default). Use `schema = \"raw\"` and no payload-changing transform to preserve original bytes. |","table":"table-1"},"1747":{"id":"/docs/connectors/sinks/postgres-35","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"| Format           | Column Type | Description                                                                                                    |\n| ---------------- | ----------- | -------------------------------------------------------------------------------------------------------------- |\n| `json` / `jsonb` | `JSONB`     | Native JSON. Enables JSON operators and GIN indexing. Payload must be valid JSON accepted by PostgreSQL JSONB. |","table":"table-1"},"1748":{"id":"/docs/connectors/sinks/postgres-36","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"| Format | Column Type | Description                                                          |\n| ------ | ----------- | -------------------------------------------------------------------- |\n| `text` | `TEXT`      | UTF-8 text. Payload must be valid UTF-8 accepted by PostgreSQL TEXT. |","table":"table-1"},"1749":{"id":"/docs/connectors/sinks/postgres-37","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"Format names are case-insensitive. Unrecognized names silently use `bytea`. JSONB accepts objects, arrays and scalars, but PostgreSQL rejects `\\u0000` in JSONB and zero bytes in TEXT. JSON decoding and JSONB storage can change the original representation. Message headers are not stored. See PostgreSQL JSON types for JSONB restrictions."},"1750":{"id":"/docs/connectors/sinks/postgres-38","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"With the default `bytea` format, valid UTF-8 JSON payloads can still be queried by converting the bytes: `convert_from(payload, 'UTF8')::jsonb->>'user_id'`. With `json`, the native operators apply directly: `payload->>'user_id'`."},"1751":{"id":"/docs/connectors/sinks/postgres-39","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#table-schema","content":"With `auto_create_table = true` and all three metadata flags enabled, the connector creates the following structure if the table is absent. The `payload` column type follows `payload_format`:"},"1752":{"id":"/docs/connectors/sinks/postgres-40","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#table-schema","content":"Disabling `include_metadata` omits the five offset/timestamp/stream/topic/partition columns. Checksum and origin timestamp flags work independently. `id`, `payload` and `created_at` are always created. With `auto_create_table = false`, provision a compatible table yourself. Startup does not check its existence or schema."},"1753":{"id":"/docs/connectors/sinks/postgres-41","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#table-schema","content":"`id` stores the full unsigned 128-bit message ID as a decimal, without stream, topic, partition or offset in the key. Offset and checksum values are cast to signed 64-bit integers, and partition IDs to signed 32-bit integers. Values above those signed ranges appear negative. Message and origin timestamps are interpreted as Unix microseconds. Zero becomes the Unix epoch. A timestamp outside the date library's range falls back to the current time. `created_at` is generated by PostgreSQL when inserting."},"1754":{"id":"/docs/connectors/sinks/postgres-42","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#querying-the-data","content":"Run these queries with `docker exec -it iggy-postgres psql -U iggy -d iggy`, or your PostgreSQL client:"},"1755":{"id":"/docs/connectors/sinks/postgres-43","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#querying-the-data","content":"For a JSONB query example, a TEXT search example, and recommended indexes, see the upstream postgres_sink README."},"1756":{"id":"/docs/connectors/sinks/postgres-44","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#delivery-semantics","content":"Each poll is split into chunks of at most `batch_size` messages. One multi-row `INSERT` writes each chunk. A duplicate primary key, incompatible table, invalid payload or other terminal error rejects that chunk. Later chunks are still attempted. The plugin logs failures, increments its private insertion-error count by the failed chunk size, and returns success after attempting all chunks. Both its processed count and runtime's processed count can therefore include messages that were never stored. Runtime error counts do not expose these insert failures."},"1757":{"id":"/docs/connectors/sinks/postgres-45","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#delivery-semantics","content":"Transient insert failures are retried within the chunk. `max_retries` counts total attempts, and waits grow linearly as `retry_delay`, twice that delay, and so on. Retried SQLSTATEs are `40001`, `40P01`, `57P01`, `57P02`, `57P03`, `08000`, `08003` and `08006`. SQLx I/O and pool-acquisition timeouts are also retried. Other errors stop that chunk's retry loop. Startup has no plugin retry loop."},"1758":{"id":"/docs/connectors/sinks/postgres-46","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#delivery-semantics","content":"The sink uses plain `INSERT`, with no conflict-ignore or upsert clause. Reusing an ID already in the table rejects the entire chunk, including any new IDs alongside it. There is no transaction covering the complete poll. The runtime auto-commits while polling and does not replay failed chunks. A connection failure can leave the write outcome uncertain. These retries do not provide an end-to-end at-least-once guarantee."},"1759":{"id":"/docs/connectors/sinks/postgres-47","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#performance-considerations","content":"Use an appropriate `batch_size` for your workload (larger batches give better throughput)"},"1760":{"id":"/docs/connectors/sinks/postgres-48","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#performance-considerations","content":"Create indexes on frequently queried columns (`iggy_stream`, `iggy_topic`, `created_at`)"},"1761":{"id":"/docs/connectors/sinks/postgres-49","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#performance-considerations","content":"Set the pool limit with `max_connections`. It does not report pool usage"},"1762":{"id":"/docs/connectors/sinks/postgres-50","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#performance-considerations","content":"Keep each actual chunk within PostgreSQL's 65,535 query-parameter limit. Each row binds `2 + 5 * include_metadata + include_checksum + include_origin_timestamp` parameters, so the default flags allow at most 7,281 rows per statement. Larger chunks are rejected by SQLx. `batch_length` also limits how many rows reach a poll."},"1763":{"id":"/docs/connectors/sinks/quickwit","page_id":"/docs/connectors/sinks/quickwit","type":"page","content":"Quickwit Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/quickwit"},"1764":{"id":"/docs/connectors/sinks/quickwit-0","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit","content":"Send messages from Iggy streams to a Quickwit index over HTTP, creating the index when it does not exist."},"1765":{"id":"/docs/connectors/sinks/quickwit-1","page_id":"/docs/connectors/sinks/quickwit","type":"heading","tags":[],"url":"/docs/connectors/sinks/quickwit#configuration","content":"Configuration"},"1766":{"id":"/docs/connectors/sinks/quickwit-2","page_id":"/docs/connectors/sinks/quickwit","type":"heading","tags":[],"url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Plugin config options"},"1767":{"id":"/docs/connectors/sinks/quickwit-3","page_id":"/docs/connectors/sinks/quickwit","type":"heading","tags":[],"url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"Payload Shapes"},"1768":{"id":"/docs/connectors/sinks/quickwit-4","page_id":"/docs/connectors/sinks/quickwit","type":"heading","tags":[],"url":"/docs/connectors/sinks/quickwit#delivery-semantics","content":"Delivery Semantics"},"1769":{"id":"/docs/connectors/sinks/quickwit-5","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit","content":"The Quickwit connector allows you to send data to the Quickwit API using HTTP. At startup it checks readiness, creates a missing index, and appends messages as newline-delimited JSON (NDJSON). Each poll can become multiple requests, each limited to 8 MiB including document newlines."},"1770":{"id":"/docs/connectors/sinks/quickwit-6","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.10.0 Iggy checkout root, build the plugin:"},"1771":{"id":"/docs/connectors/sinks/quickwit-7","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"For a local Quickwit instance with support for the example's 0.9 index configuration:"},"1772":{"id":"/docs/connectors/sinks/quickwit-8","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"Wait for readiness, then save this connector file in the runtime's connector directory. `index` is a YAML string following the Quickwit index configuration format. Use a format version supported by your Quickwit server. The sink sends this YAML when creating a missing index. It does not update or compare an existing index's mapping."},"1773":{"id":"/docs/connectors/sinks/quickwit-9","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"Create the Iggy resources and send a document that matches the strict mapping:"},"1774":{"id":"/docs/connectors/sinks/quickwit-10","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"Indexing happens asynchronously. Search after the split has committed:"},"1775":{"id":"/docs/connectors/sinks/quickwit-11","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"`commit_timeout_secs = 10` requests a time-based commit. It is not a ten-second delivery deadline. Retention uses the document's `timestamp` field. The example requests seven-day retention checked daily. The timestamp mapping accepts Unix timestamps and formats search results as nanoseconds, with millisecond fast-field precision."},"1776":{"id":"/docs/connectors/sinks/quickwit-12","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"| Option | Default  | Description                                                                                                 |\n| ------ | -------- | ----------------------------------------------------------------------------------------------------------- |\n| `url`  | required | HTTP(S) base URL with a host. Path prefixes/trailing slashes work, query strings and fragments are rejected |","table":"table-0"},"1777":{"id":"/docs/connectors/sinks/quickwit-13","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"| Option  | Default  | Description                                               |\n| ------- | -------- | --------------------------------------------------------- |\n| `index` | required | YAML index configuration containing a nonempty `index_id` |","table":"table-0"},"1778":{"id":"/docs/connectors/sinks/quickwit-14","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"| Option            | Default | Description                                                     |\n| ----------------- | ------- | --------------------------------------------------------------- |\n| `verbose_logging` | `false` | Log received/submitted document counts at info instead of debug |","table":"table-0"},"1779":{"id":"/docs/connectors/sinks/quickwit-15","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"| Option        | Default | Description                                                                 |\n| ------------- | ------- | --------------------------------------------------------------------------- |\n| `max_retries` | `3`     | Total HTTP attempts including the first. `0` and `1` both allow one attempt |","table":"table-0"},"1780":{"id":"/docs/connectors/sinks/quickwit-16","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"| Option        | Default | Description                                                  |\n| ------------- | ------- | ------------------------------------------------------------ |\n| `retry_delay` | `\"1s\"`  | Base exponential delay for HTTP retries and readiness probes |","table":"table-0"},"1781":{"id":"/docs/connectors/sinks/quickwit-17","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"| Option            | Default | Description                                                                                                      |\n| ----------------- | ------- | ---------------------------------------------------------------------------------------------------------------- |\n| `retry_max_delay` | `\"5s\"`  | Cap for calculated HTTP retry delays. A valid `Retry-After` on HTTP 429 or any 5xx can exceed it, up to one hour |","table":"table-0"},"1782":{"id":"/docs/connectors/sinks/quickwit-18","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"| Option             | Default | Description                                                                                |\n| ------------------ | ------- | ------------------------------------------------------------------------------------------ |\n| `max_open_retries` | `10`    | Total attempts per readiness check including the first. `0` and `1` both allow one attempt |","table":"table-0"},"1783":{"id":"/docs/connectors/sinks/quickwit-19","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"| Option                 | Default | Description                               |\n| ---------------------- | ------- | ----------------------------------------- |\n| `open_retry_max_delay` | `\"30s\"` | Cap for calculated readiness retry delays |","table":"table-0"},"1784":{"id":"/docs/connectors/sinks/quickwit-20","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"| Option    | Default | Description                                                                         |\n| --------- | ------- | ----------------------------------------------------------------------------------- |\n| `timeout` | `\"30s\"` | Timeout per HTTP attempt. Retries and their waits can make an operation take longer |","table":"table-0"},"1785":{"id":"/docs/connectors/sinks/quickwit-21","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Durations require units and must be positive. Invalid or zero durations prevent startup. Unknown plugin keys are rejected. There is no plugin `batch_size` option: `batch_length` limits the polled batch, and the sink splits it by serialized byte size without accumulating across polls."},"1786":{"id":"/docs/connectors/sinks/quickwit-22","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Readiness uses `GET /health/readyz`, retrying any failed probe. The index check uses `GET /api/v1/indexes/<index_id>`. Only a 404 triggers creation with `POST /api/v1/indexes`. If creation receives an error status, a successful index recheck allows startup to continue. A successful existence check does not validate the supplied mapping against the existing one. Requests retain any path prefix from `url`."},"1787":{"id":"/docs/connectors/sinks/quickwit-23","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"After verifying or creating the index, the sink probes the ingest endpoint with an empty body before accepting messages. This waits for the queue on Quickwit versions that return 404 while it starts. These probes submit no documents and retry HTTP 404, 429, 5xx and network failures. Each readiness check uses `max_open_retries` and `open_retry_max_delay`."},"1788":{"id":"/docs/connectors/sinks/quickwit-24","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"The sink does not add Iggy IDs, offsets, timestamps or headers. It serializes the payload after runtime decoding and transforms:"},"1789":{"id":"/docs/connectors/sinks/quickwit-25","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"| Payload                                             | Document sent to Quickwit |\n| --------------------------------------------------- | ------------------------- |\n| JSON object, or a JSON object parsed from raw bytes | The object itself         |","table":"table-1"},"1790":{"id":"/docs/connectors/sinks/quickwit-26","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"| Payload              | Document sent to Quickwit                                               |\n| -------------------- | ----------------------------------------------------------------------- |\n| JSON array or scalar | `{\"data\":[1,2],\"data_type\":\"json\"}` or `{\"data\":42,\"data_type\":\"json\"}` |","table":"table-1"},"1791":{"id":"/docs/connectors/sinks/quickwit-27","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"| Payload         | Document sent to Quickwit                                   |\n| --------------- | ----------------------------------------------------------- |\n| Other raw UTF-8 | `{\"data\":\"hello\",\"data_type\":\"raw\",\"data_encoding\":\"utf8\"}` |","table":"table-1"},"1792":{"id":"/docs/connectors/sinks/quickwit-28","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"| Payload             | Document sent to Quickwit                                                    |\n| ------------------- | ---------------------------------------------------------------------------- |\n| Raw non-UTF-8 bytes | Base64 under `data`, with `data_type = \"raw\"` and `data_encoding = \"base64\"` |","table":"table-1"},"1793":{"id":"/docs/connectors/sinks/quickwit-29","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"| Payload | Document sent to Quickwit             |\n| ------- | ------------------------------------- |\n| Text    | `{\"text\":\"hello\",\"data_type\":\"text\"}` |","table":"table-1"},"1794":{"id":"/docs/connectors/sinks/quickwit-30","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"Raw arrays, scalars and malformed JSON retain their original bytes in the raw wrapper. Avro and FlatBuffer payload variants use that raw path. Proto uses the text wrapper. Which variant arrives depends on the runtime decoder and transforms."},"1795":{"id":"/docs/connectors/sinks/quickwit-31","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"The strict mapping above accepts only mapped fields and requires `timestamp`. To use wrapper documents, map their fields or use `mode: dynamic`, and remove `timestamp_field` and its dependent `retention` section unless every document supplies a timestamp. The `add_fields` transform enriches JSON objects. It does not add timestamps to raw/text wrappers created later by this sink."},"1796":{"id":"/docs/connectors/sinks/quickwit-32","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#delivery-semantics","content":"The sink calls `POST /api/v1/<index_id>/ingest?commit=auto`. HTTP success means submission for indexing, not search visibility or acceptance of every document. The sink checks the status and does not inspect per-document rejection counts in the response. See the Quickwit ingest API."},"1797":{"id":"/docs/connectors/sinks/quickwit-33","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#delivery-semantics","content":"HTTP 429, 5xx and network failures can retry. Calculated waits use exponential backoff with jitter and the configured cap. An integer-seconds `Retry-After` on a 429 or any 5xx can lengthen the calculated wait past `retry_max_delay`, up to one hour, but never shortens it. HTTP-date and unparsable values fall back to the calculated wait. Other HTTP statuses stop that request's retry loop. Readiness has its separate attempt budget. There is no circuit breaker or sink deduplication key, so retrying an accepted request can produce duplicates. `max_retries = 1` disables the sink's HTTP retry loop."},"1798":{"id":"/docs/connectors/sinks/quickwit-34","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#delivery-semantics","content":"An individual serialized document exceeding 8 MiB, including its newline, is logged and skipped. Other documents and later chunks are still attempted, and the last error is returned. Successful chunks are not rolled back. The runtime logs/counts plugin callback errors and continues without replaying the failed batch. It auto-commits while polling. A failed callback can therefore coexist with stored documents, and a successful callback can include documents rejected by Quickwit. Runtime processed counts do not prove successful indexing. The sink provides no end-to-end at-least-once guarantee."},"1799":{"id":"/docs/connectors/sinks/rabbitmq","page_id":"/docs/connectors/sinks/rabbitmq","type":"page","content":"RabbitMQ","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/rabbitmq"},"1800":{"id":"/docs/connectors/sinks/rabbitmq-0","page_id":"/docs/connectors/sinks/rabbitmq","tags":[],"type":"text","url":"/docs/connectors/sinks/rabbitmq","content":"Send Iggy messages to RabbitMQ with the connector runtime."},"1801":{"id":"/docs/connectors/sinks/rabbitmq-1","page_id":"/docs/connectors/sinks/rabbitmq","type":"heading","tags":[],"url":"/docs/connectors/sinks/rabbitmq#configuration","content":"Configuration"},"1802":{"id":"/docs/connectors/sinks/rabbitmq-2","page_id":"/docs/connectors/sinks/rabbitmq","type":"heading","tags":[],"url":"/docs/connectors/sinks/rabbitmq#headers-and-failure-handling","content":"Headers and failure handling"},"1803":{"id":"/docs/connectors/sinks/rabbitmq-3","page_id":"/docs/connectors/sinks/rabbitmq","tags":[],"type":"text","url":"/docs/connectors/sinks/rabbitmq","content":"The RabbitMQ sink publishes messages to an AMQP 0.9.1 exchange. It declares the configured exchange, enables publisher confirmations and uses mandatory publishing. Configure a queue and binding that match the routing key before sending messages."},"1804":{"id":"/docs/connectors/sinks/rabbitmq-4","page_id":"/docs/connectors/sinks/rabbitmq","tags":[],"type":"text","url":"/docs/connectors/sinks/rabbitmq#configuration","content":"Use the sink runtime setup and build `iggy_connector_rabbitmq_sink`. Its plugin configuration is:"},"1805":{"id":"/docs/connectors/sinks/rabbitmq-5","page_id":"/docs/connectors/sinks/rabbitmq","tags":[],"type":"text","url":"/docs/connectors/sinks/rabbitmq#configuration","content":"Use the guest credentials only with a local broker. Exchange type accepts `direct`, `topic`, `fanout` or `headers`. Exchange durability must match an existing exchange. Delivery mode accepts `persistent` or `non_persistent`. Durable delivery also depends on the broker and queue configuration."},"1806":{"id":"/docs/connectors/sinks/rabbitmq-6","page_id":"/docs/connectors/sinks/rabbitmq","tags":[],"type":"text","url":"/docs/connectors/sinks/rabbitmq#headers-and-failure-handling","content":"User headers are preserved. With metadata enabled, the sink also adds `iggy_stream`, `iggy_topic`, `iggy_partition_id` and `iggy_offset`. String headers become AMQP LongString and raw headers become ByteArray."},"1807":{"id":"/docs/connectors/sinks/rabbitmq-7","page_id":"/docs/connectors/sinks/rabbitmq","tags":[],"type":"text","url":"/docs/connectors/sinks/rabbitmq#headers-and-failure-handling","content":"The sink pipelines publishes and waits for confirmations. Transient failures retry from the first unconfirmed message. An in-flight tail can already be delivered, so retries can duplicate it. An unroutable mandatory publish fails the batch and forces a new connection before the next poll."},"1808":{"id":"/docs/connectors/sinks/rabbitmq-8","page_id":"/docs/connectors/sinks/rabbitmq","tags":[],"type":"text","url":"/docs/connectors/sinks/rabbitmq#headers-and-failure-handling","content":"The runtime commits Iggy offsets on read and does not replay a failed callback after its retry budget. Publisher confirmations do not provide an end-to-end exactly-once guarantee. See the source reference."},"1809":{"id":"/docs/connectors/sinks/redshift","page_id":"/docs/connectors/sinks/redshift","type":"page","content":"Redshift","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/redshift"},"1810":{"id":"/docs/connectors/sinks/redshift-0","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift","content":"Send Iggy messages to Redshift with the connector runtime."},"1811":{"id":"/docs/connectors/sinks/redshift-1","page_id":"/docs/connectors/sinks/redshift","type":"heading","tags":[],"url":"/docs/connectors/sinks/redshift#configuration","content":"Configuration"},"1812":{"id":"/docs/connectors/sinks/redshift-2","page_id":"/docs/connectors/sinks/redshift","type":"heading","tags":[],"url":"/docs/connectors/sinks/redshift#payloads-and-delivery","content":"Payloads and delivery"},"1813":{"id":"/docs/connectors/sinks/redshift-3","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift","content":"The Redshift sink serializes batches to Parquet, stages them in S3 and loads an existing Redshift table with COPY. Configure both the Redshift connection and S3 access before starting the runtime."},"1814":{"id":"/docs/connectors/sinks/redshift-4","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"Use the sink runtime setup and build `iggy_connector_redshift_sink`. The plugin requires `connection_string`, `target_table`, `aws_iam_role`, `s3_bucket`, `s3_prefix` and `aws_region`. Supply S3 credentials through the supported credential configuration for your deployment."},"1815":{"id":"/docs/connectors/sinks/redshift-5","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"| Setting      | Default | Purpose                                               |\n| ------------ | ------- | ----------------------------------------------------- |\n| `batch_size` | 100     | Messages buffered per Parquet file and COPY operation |","table":"table-0"},"1816":{"id":"/docs/connectors/sinks/redshift-6","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"| Setting           | Default | Purpose                       |\n| ----------------- | ------- | ----------------------------- |\n| `max_connections` | 5       | Redshift connection pool size |","table":"table-0"},"1817":{"id":"/docs/connectors/sinks/redshift-7","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"| Setting            | Default | Purpose                                                        |\n| ------------------ | ------- | -------------------------------------------------------------- |\n| `include_metadata` | `true`  | Include stream, topic, partition, offset, timestamp and schema |","table":"table-0"},"1818":{"id":"/docs/connectors/sinks/redshift-8","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"| Setting            | Default | Purpose                   |\n| ------------------ | ------- | ------------------------- |\n| `include_checksum` | `false` | Include the Iggy checksum |","table":"table-0"},"1819":{"id":"/docs/connectors/sinks/redshift-9","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"| Setting                    | Default | Purpose               |\n| -------------------------- | ------- | --------------------- |\n| `include_origin_timestamp` | `false` | Include producer time |","table":"table-0"},"1820":{"id":"/docs/connectors/sinks/redshift-10","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"| Setting          | Default   | Purpose                     |\n| ---------------- | --------- | --------------------------- |\n| `payload_format` | `varbyte` | Payload encoding in Parquet |","table":"table-0"},"1821":{"id":"/docs/connectors/sinks/redshift-11","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"| Setting       | Default | Purpose                              |\n| ------------- | ------- | ------------------------------------ |\n| `max_retries` | 3       | COPY retries after the first attempt |","table":"table-0"},"1822":{"id":"/docs/connectors/sinks/redshift-12","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"| Setting       | Default    | Purpose                |\n| ------------- | ---------- | ---------------------- |\n| `retry_delay` | One second | Pause between attempts |","table":"table-0"},"1823":{"id":"/docs/connectors/sinks/redshift-13","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"| Setting   | Default | Purpose                                                           |\n| --------- | ------- | ----------------------------------------------------------------- |\n| `archive` | `false` | Retain successfully loaded staging files under the archive prefix |","table":"table-0"},"1824":{"id":"/docs/connectors/sinks/redshift-14","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"`aws_access_key_id` and `aws_secret_access_key` supply explicit staging credentials. `s3_endpoint` supports an alternate S3 endpoint. The complete example configuration includes a local staging service setup. Replace its credentials and role before use."},"1825":{"id":"/docs/connectors/sinks/redshift-15","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#payloads-and-delivery","content":"`payload_format=\"json\"` writes a string column, not a native Redshift SUPER value. Use Redshift JSON parsing when structured queries need that representation. `varbyte` preserves the serialized payload as bytes."},"1826":{"id":"/docs/connectors/sinks/redshift-16","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#payloads-and-delivery","content":"With `archive=false`, a successfully loaded staging file is deleted. With it enabled, the file is moved under the archive prefix. A staged file alone does not prove that COPY completed."},"1827":{"id":"/docs/connectors/sinks/redshift-17","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#payloads-and-delivery","content":"The runtime commits offsets on read. A COPY failure that outlasts plugin retries is logged and is not replayed by the runtime. A retry after an uncertain load can duplicate rows. See the source reference."},"1828":{"id":"/docs/connectors/sinks/s3","page_id":"/docs/connectors/sinks/s3","type":"page","content":"S3 Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/s3"},"1829":{"id":"/docs/connectors/sinks/s3-0","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3","content":"Write messages from Iggy streams to Amazon S3 and S3-compatible object stores such as MinIO, R2, Spaces and B2."},"1830":{"id":"/docs/connectors/sinks/s3-1","page_id":"/docs/connectors/sinks/s3","type":"heading","tags":[],"url":"/docs/connectors/sinks/s3#configuration","content":"Configuration"},"1831":{"id":"/docs/connectors/sinks/s3-2","page_id":"/docs/connectors/sinks/s3","type":"heading","tags":[],"url":"/docs/connectors/sinks/s3#common-options","content":"Common Options"},"1832":{"id":"/docs/connectors/sinks/s3-3","page_id":"/docs/connectors/sinks/s3","type":"heading","tags":[],"url":"/docs/connectors/sinks/s3#credentials","content":"Credentials"},"1833":{"id":"/docs/connectors/sinks/s3-4","page_id":"/docs/connectors/sinks/s3","type":"heading","tags":[],"url":"/docs/connectors/sinks/s3#minio-example","content":"MinIO example"},"1834":{"id":"/docs/connectors/sinks/s3-5","page_id":"/docs/connectors/sinks/s3","type":"heading","tags":[],"url":"/docs/connectors/sinks/s3#output-formats","content":"Output Formats"},"1835":{"id":"/docs/connectors/sinks/s3-6","page_id":"/docs/connectors/sinks/s3","type":"heading","tags":[],"url":"/docs/connectors/sinks/s3#delivery-semantics","content":"Delivery Semantics"},"1836":{"id":"/docs/connectors/sinks/s3-7","page_id":"/docs/connectors/sinks/s3","type":"heading","tags":[],"url":"/docs/connectors/sinks/s3#transforms","content":"Transforms"},"1837":{"id":"/docs/connectors/sinks/s3-8","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3","content":"The S3 sink connector writes messages from Iggy streams to Amazon S3 and S3-compatible object stores (MinIO, Cloudflare R2, DigitalOcean Spaces, Backblaze B2). Messages are buffered in memory and uploaded as files, rotated by size or message count, under configurable path templates with offset ranges in the object names."},"1838":{"id":"/docs/connectors/sinks/s3-9","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3","content":"This page is a curated subset of the documentation. The canonical reference is the upstream s3_sink README in the `apache/iggy` repository."},"1839":{"id":"/docs/connectors/sinks/s3-10","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.10.0 Iggy checkout root, build the plugin:"},"1840":{"id":"/docs/connectors/sinks/s3-11","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#configuration","content":"Create the bucket separately, then save this connector file in the runtime's connector directory. The plugin does not create buckets. Paths below assume the runtime starts from the checkout root."},"1841":{"id":"/docs/connectors/sinks/s3-12","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"| Option   | Type   | Default      | Description    |\n| -------- | ------ | ------------ | -------------- |\n| `bucket` | string | **required** | S3 bucket name |","table":"table-0"},"1842":{"id":"/docs/connectors/sinks/s3-13","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"| Option   | Type   | Default      | Description                                  |\n| -------- | ------ | ------------ | -------------------------------------------- |\n| `region` | string | **required** | AWS region, e.g. `us-east-1` (`auto` for R2) |","table":"table-0"},"1843":{"id":"/docs/connectors/sinks/s3-14","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"| Option   | Type   | Default | Description                                                                    |\n| -------- | ------ | ------- | ------------------------------------------------------------------------------ |\n| `prefix` | string | none    | Prefix for data objects and loss markers. Leading/trailing slashes are removed |","table":"table-0"},"1844":{"id":"/docs/connectors/sinks/s3-15","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"| Option     | Type   | Default | Description                                                   |\n| ---------- | ------ | ------- | ------------------------------------------------------------- |\n| `endpoint` | string | none    | Custom S3 endpoint for MinIO, R2, and other compatible stores |","table":"table-0"},"1845":{"id":"/docs/connectors/sinks/s3-16","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"| Option          | Type   | Default                          | Description                     |\n| --------------- | ------ | -------------------------------- | ------------------------------- |\n| `path_template` | string | `{stream}/{topic}/{date}/{hour}` | Directory structure for S3 keys |","table":"table-0"},"1846":{"id":"/docs/connectors/sinks/s3-17","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"| Option          | Type   | Default | Description          |\n| --------------- | ------ | ------- | -------------------- |\n| `file_rotation` | string | `size`  | `size` or `messages` |","table":"table-0"},"1847":{"id":"/docs/connectors/sinks/s3-18","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"| Option          | Type   | Default | Description                                                                              |\n| --------------- | ------ | ------- | ---------------------------------------------------------------------------------------- |\n| `max_file_size` | string | `8MiB`  | Size rotation threshold. Must be positive and at most `5GiB`, even in message-count mode |","table":"table-0"},"1848":{"id":"/docs/connectors/sinks/s3-19","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"| Option                  | Type | Default | Description                                                          |\n| ----------------------- | ---- | ------- | -------------------------------------------------------------------- |\n| `max_messages_per_file` | u64  | none    | Positive count required in `messages` mode. Ignored by size rotation |","table":"table-0"},"1849":{"id":"/docs/connectors/sinks/s3-20","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"| Option          | Type   | Default      | Description                          |\n| --------------- | ------ | ------------ | ------------------------------------ |\n| `output_format` | string | `json_lines` | `json_lines`, `json_array`, or `raw` |","table":"table-0"},"1850":{"id":"/docs/connectors/sinks/s3-21","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"| Option             | Type | Default | Description                                                    |\n| ------------------ | ---- | ------- | -------------------------------------------------------------- |\n| `include_metadata` | bool | `true`  | Include stream/topic/partition/offset/timestamp in JSON output |","table":"table-0"},"1851":{"id":"/docs/connectors/sinks/s3-22","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"| Option            | Type | Default | Description                                                         |\n| ----------------- | ---- | ------- | ------------------------------------------------------------------- |\n| `include_headers` | bool | `false` | Include available headers in JSON output, independently of metadata |","table":"table-0"},"1852":{"id":"/docs/connectors/sinks/s3-23","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"Further options cover credentials (`access_key_id` / `secret_access_key`), retries (`max_attempts` defaults to `3`, `retry_delay` to `1s`), and `path_style` addressing (auto-enabled when `endpoint` is set, overridable with `false`). `max_retries` is an alias for `max_attempts`. `0` and `1` both make one outer upload attempt. Invalid retry durations prevent startup. `0s` is allowed. Output format names are case-insensitive, with `jsonl` and `jsonlines` aliases for `json_lines`. See the upstream s3_sink README for the full reference."},"1853":{"id":"/docs/connectors/sinks/s3-24","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"Each stream/topic/partition has its own buffer, retained across polls. Rotation is checked after appending a complete formatted record. Size mode counts record bytes but excludes JSON newlines, commas and array brackets, so an object can exceed `max_file_size`. Message-count mode does not also enforce the size threshold. Uploads use one `PutObject`, with no multipart upload. Choose thresholds and message sizes that fit the store's single-upload limit. There is no timer flush: a partial buffer waits until its threshold is reached or the connector closes."},"1854":{"id":"/docs/connectors/sinks/s3-25","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"Path templates support `{stream}`, `{topic}`, `{partition}`, `{date}`, `{hour}`, and `{timestamp}`. The time-based variables derive from the first message timestamp in each buffer: date/hour use UTC, and `{timestamp}` is epoch milliseconds. File names embed the partition (zero-padded to 5 digits, to prevent cross-partition collisions) and the offset range (zero-padded to 20 digits), e.g. `application_logs/api_requests/2026-03-16/14/00000-00000000000000000000-00000000000000000999.jsonl` before adding the configured prefix."},"1855":{"id":"/docs/connectors/sinks/s3-26","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"Stream/topic substitutions preserve ASCII letters, digits, `.`, `_` and `-`, replacing other characters with `_`. Distinct names can therefore produce the same key. Keep stream/topic separation in the template, use names that remain distinct after replacement, and avoid sharing the same output paths across independent producers. A repeated object key overwrites the current object, subject to bucket versioning. The offset range alone does not provide global deduplication. Extensions are `.jsonl`, `.json` and `.bin` for the three formats."},"1856":{"id":"/docs/connectors/sinks/s3-27","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#credentials","content":"Credentials resolve in order of precedence: explicit `access_key_id` + `secret_access_key` in the config (both together or neither), environment credentials, the shared credentials file, STS web identity, ECS container credentials, then EC2 instance metadata (IMDSv2 before v1). The chain is provided by the pinned `aws-creds` dependency, not the AWS SDK."},"1857":{"id":"/docs/connectors/sinks/s3-28","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#credentials","content":"Environment credentials use `AWS_ACCESS_KEY_ID` / `AWS_SECRET_ACCESS_KEY`, with optional `AWS_SESSION_TOKEN` / `AWS_SECURITY_TOKEN`. The file path is `AWS_SHARED_CREDENTIALS_FILE` or `~/.aws/credentials`. This plugin reads its `[default]` section and does not select `AWS_PROFILE`. Web identity uses `AWS_ROLE_ARN` and `AWS_WEB_IDENTITY_TOKEN_FILE`. The container path uses `AWS_CONTAINER_CREDENTIALS_RELATIVE_URI`. Explicit config credentials have no session-token option. Use the environment or credentials file for a temporary key pair and token."},"1858":{"id":"/docs/connectors/sinks/s3-29","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#credentials","content":"Startup writes an empty object at the bucket-root key `.iggy-sink-probe`, then attempts to delete it. The probe ignores `prefix`, needs `PutObject` on that key, and rejects non-success HTTP statuses. `ListBucket` is not required. Failed probe cleanup does not prevent startup. Reserve this key: an existing object at that name is overwritten, and deleted if the credentials permit cleanup."},"1859":{"id":"/docs/connectors/sinks/s3-30","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#minio-example","content":"Start a local MinIO server:"},"1860":{"id":"/docs/connectors/sinks/s3-31","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#minio-example","content":"After the health request succeeds, create the bucket using MinIO's client. These commands use Docker host networking on Linux:"},"1861":{"id":"/docs/connectors/sinks/s3-32","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#minio-example","content":"Replace the earlier `[plugin_config]` table with this local configuration. One message per file makes the example upload immediately:"},"1862":{"id":"/docs/connectors/sinks/s3-33","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#minio-example","content":"Create the Iggy resources, send a JSON message, and start the runtime as described in the sink guide:"},"1863":{"id":"/docs/connectors/sinks/s3-34","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#minio-example","content":"List the uploaded objects:"},"1864":{"id":"/docs/connectors/sinks/s3-35","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#output-formats","content":"JSON Lines and JSON Array contain wrapper objects with the decoded/transformed payload under `payload`. JSON payloads retain their JSON value. Text and Proto variants become strings. Raw bytes containing valid JSON are parsed, while other raw bytes, Avro and FlatBuffer variants become base64 strings. Those strings do not carry an encoding tag."},"1865":{"id":"/docs/connectors/sinks/s3-36","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#output-formats","content":"With metadata enabled, each wrapper also contains `offset`, a UTC timestamp at second precision, `stream`, `topic` and `partition_id`. Message IDs, checksums and origin timestamps are not included. Headers are a separate optional object: string values remain strings, raw values become base64, booleans become booleans and supported numeric types become JSON numbers. Other values use strings."},"1866":{"id":"/docs/connectors/sinks/s3-37","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#output-formats","content":"Raw output concatenates payload bytes without delimiters and ignores both inclusion flags. To preserve the original payload bytes, use `schema = \"raw\"` and no transform that changes them. Decoding JSON before raw output can reserialize it."},"1867":{"id":"/docs/connectors/sinks/s3-38","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#delivery-semantics","content":"The runtime auto-commits while polling. It logs/counts a failed plugin callback and continues without replaying that batch. A successful callback can mean only that messages were buffered, so runtime processed counts do not establish delivery to S3. A crash loses unflushed buffers. There is no write-ahead log or dead-letter queue."},"1868":{"id":"/docs/connectors/sinks/s3-39","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#delivery-semantics","content":"The sink retries HTTP 408, 429, 5xx and client errors. Other HTTP statuses stop the upload immediately. Its exponential backoff includes jitter and a 60-second cap, without handling `Retry-After`. The S3 library also retries transport errors once internally and uses a 60-second request timeout, so `max_attempts` counts outer `PutObject` calls rather than individual network requests or a total time budget. The startup probe does not use the sink's upload retry loop."},"1869":{"id":"/docs/connectors/sinks/s3-40","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#delivery-semantics","content":"Buffers are cleared before upload. A failed upload loses those messages and stops processing the remainder of that poll. The sink tries to write an additional `.lost` object containing the offset range, message count and error, using the same retry policy. This marker contains no payload and may also fail. Graceful close attempts to flush remaining buffers, logs failures, and still returns success. Neither runtime counters nor shutdown success prove that every message was stored, and the sink provides no end-to-end delivery or deduplication guarantee."},"1870":{"id":"/docs/connectors/sinks/s3-41","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#delivery-semantics","content":"Size your rotation thresholds accordingly: smaller files bound the loss window, larger files upload more efficiently."},"1871":{"id":"/docs/connectors/sinks/s3-42","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#transforms","content":"Transforms can be applied before writing to S3. See the transforms documentation for the available types and their configuration."},"1872":{"id":"/docs/connectors/sinks/sink","page_id":"/docs/connectors/sinks/sink","type":"page","content":"Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/sink"},"1873":{"id":"/docs/connectors/sinks/sink-0","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink","content":"What sink connectors do, and the Sink trait every one of them implements."},"1874":{"id":"/docs/connectors/sinks/sink-1","page_id":"/docs/connectors/sinks/sink","type":"heading","tags":[],"url":"/docs/connectors/sinks/sink#overview","content":"Overview"},"1875":{"id":"/docs/connectors/sinks/sink-2","page_id":"/docs/connectors/sinks/sink","type":"heading","tags":[],"url":"/docs/connectors/sinks/sink#configuration","content":"Configuration"},"1876":{"id":"/docs/connectors/sinks/sink-3","page_id":"/docs/connectors/sinks/sink","type":"heading","tags":[],"url":"/docs/connectors/sinks/sink#environment-variable-overrides","content":"Environment Variable Overrides"},"1877":{"id":"/docs/connectors/sinks/sink-4","page_id":"/docs/connectors/sinks/sink","type":"heading","tags":[],"url":"/docs/connectors/sinks/sink#sample-implementation","content":"Sample implementation"},"1878":{"id":"/docs/connectors/sinks/sink-5","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#overview","content":"Sink connectors are responsible for writing data from Iggy streams to external systems or destinations. They provide a way to integrate Apache Iggy with various data sources and destinations, enabling data flow between Iggy and external systems."},"1879":{"id":"/docs/connectors/sinks/sink-6","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#overview","content":"The sink is represented by the single `Sink` trait, which defines the basic interface for all sink connectors. It provides methods for initializing the sink, writing data to external destination, and closing the sink."},"1880":{"id":"/docs/connectors/sinks/sink-7","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"With the local configuration provider, each sink connector has a TOML file in the directory specified by the main runtime config. The runtime also supports an HTTP configuration provider."},"1881":{"id":"/docs/connectors/sinks/sink-8","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"| Field | Meaning                                                                 |\n| ----- | ----------------------------------------------------------------------- |\n| `key` | Connector key (`String`), separate from the numeric plugin instance ID. |","table":"table-0"},"1882":{"id":"/docs/connectors/sinks/sink-9","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"| Field     | Meaning                                  |\n| --------- | ---------------------------------------- |\n| `enabled` | Whether to start the connector (`bool`). |","table":"table-0"},"1883":{"id":"/docs/connectors/sinks/sink-10","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"| Field     | Meaning                        |\n| --------- | ------------------------------ |\n| `version` | Configuration version (`u64`). |","table":"table-0"},"1884":{"id":"/docs/connectors/sinks/sink-11","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"| Field  | Meaning                  |\n| ------ | ------------------------ |\n| `name` | Display name (`String`). |","table":"table-0"},"1885":{"id":"/docs/connectors/sinks/sink-12","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"| Field  | Meaning                         |\n| ------ | ------------------------------- |\n| `path` | Shared-library path (`String`). |","table":"table-0"},"1886":{"id":"/docs/connectors/sinks/sink-13","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"| Field     | Meaning                       |\n| --------- | ----------------------------- |\n| `streams` | Stream configuration entries. |","table":"table-0"},"1887":{"id":"/docs/connectors/sinks/sink-14","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"| Field        | Meaning                           |\n| ------------ | --------------------------------- |\n| `transforms` | Optional transform configuration. |","table":"table-0"},"1888":{"id":"/docs/connectors/sinks/sink-15","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"| Field           | Meaning                                                          |\n| --------------- | ---------------------------------------------------------------- |\n| `plugin_config` | Optional custom configuration object deserialized by the plugin. |","table":"table-0"},"1889":{"id":"/docs/connectors/sinks/sink-16","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"| Field                  | Meaning                                                                                          |\n| ---------------------- | ------------------------------------------------------------------------------------------------ |\n| `plugin_config_format` | Optional default format for the HTTP API's plugin-config response. The FFI always receives JSON. |","table":"table-0"},"1890":{"id":"/docs/connectors/sinks/sink-17","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"| Field                  | Meaning                          |\n| ---------------------- | -------------------------------- |\n| `verbose`, `benchmark` | Optional logging flags (`bool`). |","table":"table-0"},"1891":{"id":"/docs/connectors/sinks/sink-18","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"The two flags at the end are optional and default to `false`: `verbose` switches the connector's per-batch logging to info level, and `benchmark` emits per-batch timing events for performance measurement."},"1892":{"id":"/docs/connectors/sinks/sink-19","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"**Main runtime config (connectors.toml, in the repository root):**"},"1893":{"id":"/docs/connectors/sinks/sink-20","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"Use the matching 0.10.0 checkout and broker from the quick start. Its broker must use the credentials below. Create the `connectors` directory, then save these two configuration files there and in the repository root as labeled."},"1894":{"id":"/docs/connectors/sinks/sink-21","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"**Sink connector config (connectors/stdout.toml):**"},"1895":{"id":"/docs/connectors/sinks/sink-22","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#environment-variable-overrides","content":"Configuration properties can be overridden using environment variables. Supported scalar fields and indexed stream entries use the pattern: `IGGY_CONNECTORS_SINK_[KEY]_[PROPERTY]`"},"1896":{"id":"/docs/connectors/sinks/sink-23","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#environment-variable-overrides","content":"For example, to disable the sink with key `stdout` at the next runtime start:"},"1897":{"id":"/docs/connectors/sinks/sink-24","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#environment-variable-overrides","content":"Top-level fields of `plugin_config` can be overridden (or injected) the same way with the `IGGY_CONNECTORS_SINK_[KEY]_PLUGIN_CONFIG_[FIELD]` pattern. This lets you supply credentials without writing them into the TOML file:"},"1898":{"id":"/docs/connectors/sinks/sink-25","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"Let's implement the example sink connector, which will simply print the messages to the standard output."},"1899":{"id":"/docs/connectors/sinks/sink-26","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"This sink keeps an in-memory invocation counter. The runtime does not persist sink plugin state. Iggy consumer-group offsets are managed separately."},"1900":{"id":"/docs/connectors/sinks/sink-27","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"Also, when implementing the sink connector, make sure to use the `sink_connector!` macro to expose the FFI interface and allow the connector runtime to register the sink with the runtime."},"1901":{"id":"/docs/connectors/sinks/sink-28","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"And finally, each sink should have its own, custom configuration, which is passed along with the unique plugin ID via expected `new()` method."},"1902":{"id":"/docs/connectors/sinks/sink-29","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"Use the reference crate's Cargo.toml from the matching checkout, including `[lib] crate-type = [\"cdylib\", \"lib\"]` and its workspace dependency features. The Rust blocks through the `Sink` implementation below combine into `src/lib.rs`. The trait above is a separate API reference."},"1903":{"id":"/docs/connectors/sinks/sink-30","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"Start with the imports, then define the state, connector and configuration."},"1904":{"id":"/docs/connectors/sinks/sink-31","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"We can invoke the expected macro to expose the FFI interface and allow the connector runtime to register the sink within the runtime."},"1905":{"id":"/docs/connectors/sinks/sink-32","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"The reference manifest supplies these dependencies:"},"1906":{"id":"/docs/connectors/sinks/sink-33","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"async-trait"},"1907":{"id":"/docs/connectors/sinks/sink-34","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"dashmap"},"1908":{"id":"/docs/connectors/sinks/sink-35","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"iggy_connector_sdk"},"1909":{"id":"/docs/connectors/sinks/sink-36","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"serde"},"1910":{"id":"/docs/connectors/sinks/sink-37","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"tokio"},"1911":{"id":"/docs/connectors/sinks/sink-38","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"tracing"},"1912":{"id":"/docs/connectors/sinks/sink-39","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"Now, let's implement the `Sink` trait for our `StdoutSink` struct."},"1913":{"id":"/docs/connectors/sinks/sink-40","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"It's also important to note, that the supported format(s) might vary depending on the connector implementation. For example, you might expect `JSON` as the payload format, which can be then easily parsed and processed by upstream components such as data transforms, but at the same time, you could support the other formats and let the user decide which one to use."},"1914":{"id":"/docs/connectors/sinks/sink-41","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"For a sink that only prints JSON, replace the `if self.print_payload` block in `consume()` with `print_json_messages(messages, &messages_metadata);` and add this function. Unsupported payloads are logged and skipped by this variant:"},"1915":{"id":"/docs/connectors/sinks/sink-42","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"While the schema of messages (that will be consumed from the Iggy stream), cannot be controlled by the sink connector itself, the built-in configuration allows to decide what's the expected format of the messages (the particular `StreamDecoder` will be used)."},"1916":{"id":"/docs/connectors/sinks/sink-43","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"The runtime logs and counts decoding or transform failures, drops the affected messages and passes the remaining batch to the plugin. A plugin `consume()` error is counted as a failed batch. The runtime uses auto-commit when polling and does not automatically retry that failed batch. Any destination retry must be implemented by the plugin."},"1917":{"id":"/docs/connectors/sinks/sink-44","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"Build the matching plugin, runtime and CLI from the repository root:"},"1918":{"id":"/docs/connectors/sinks/sink-45","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"On an empty broker, create the configured stream and topic:"},"1919":{"id":"/docs/connectors/sinks/sink-46","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"After saving the configuration files above, start the runtime. This explicitly enables the sink if you tried the optional disabling override:"},"1920":{"id":"/docs/connectors/sinks/sink-47","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"Produce JSON messages to this topic, for example with the Random source, to see the sink output."},"1921":{"id":"/docs/connectors/sinks/sink-48","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"And that's all, enjoy using the sink connector!"},"1922":{"id":"/docs/connectors/sinks/sink-49","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"On a side note, if you'd like to produce the messages to the Iggy stream instead, you can implement your own **Source connector** too :)"},"1923":{"id":"/docs/connectors/sinks/stdout","page_id":"/docs/connectors/sinks/stdout","type":"page","content":"Stdout Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/stdout"},"1924":{"id":"/docs/connectors/sinks/stdout-0","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout","content":"Print messages from Iggy streams to standard output, for debugging and verifying a connector pipeline."},"1925":{"id":"/docs/connectors/sinks/stdout-1","page_id":"/docs/connectors/sinks/stdout","type":"heading","tags":[],"url":"/docs/connectors/sinks/stdout#configuration","content":"Configuration"},"1926":{"id":"/docs/connectors/sinks/stdout-2","page_id":"/docs/connectors/sinks/stdout","type":"heading","tags":[],"url":"/docs/connectors/sinks/stdout#plugin-config-options","content":"Plugin config options"},"1927":{"id":"/docs/connectors/sinks/stdout-3","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout","content":"The stdout sink connector prints messages from Iggy streams to the standard output. This is useful for debugging, development, and verifying that your connector pipeline is working correctly."},"1928":{"id":"/docs/connectors/sinks/stdout-4","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout","content":"The connector emits info-level tracing events through the runtime to stdout. The runtime selects text or JSON with `logging.format` and filters events with `RUST_LOG` (default `INFO`). It logs batch metadata on every invocation. `print_payload` additionally logs each message's offset and decoded payload. The invocation counter is in memory and resets when the plugin is recreated."},"1929":{"id":"/docs/connectors/sinks/stdout-5","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout#configuration","content":"Use the broker credentials and runtime setup from the sink guide. Save the configuration below in that runtime's connector directory. From the matching 0.10.0 repository root, build the plugin:"},"1930":{"id":"/docs/connectors/sinks/stdout-6","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout#plugin-config-options","content":"| Option          | Type | Default | Description                                    |\n| --------------- | ---- | ------- | ---------------------------------------------- |\n| `print_payload` | bool | `false` | Whether to print the message payload to stdout |","table":"table-0"},"1931":{"id":"/docs/connectors/sinks/stdout-7","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout#plugin-config-options","content":"Create `my-stream` and `my-topic` before starting the runtime, or change the sample to use existing resources. The Random source configuration produces JSON to the same destination."},"1932":{"id":"/docs/connectors/sinks/surrealdb","page_id":"/docs/connectors/sinks/surrealdb","type":"page","content":"SurrealDB Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/surrealdb"},"1933":{"id":"/docs/connectors/sinks/surrealdb-0","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb","content":"Write messages from Iggy streams into SurrealDB over the HTTP API, bulk inserts split by the configured batch size."},"1934":{"id":"/docs/connectors/sinks/surrealdb-1","page_id":"/docs/connectors/sinks/surrealdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/surrealdb#configuration","content":"Configuration"},"1935":{"id":"/docs/connectors/sinks/surrealdb-2","page_id":"/docs/connectors/sinks/surrealdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/surrealdb#common-options","content":"Common Options"},"1936":{"id":"/docs/connectors/sinks/surrealdb-3","page_id":"/docs/connectors/sinks/surrealdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/surrealdb#stored-shape","content":"Stored Shape"},"1937":{"id":"/docs/connectors/sinks/surrealdb-4","page_id":"/docs/connectors/sinks/surrealdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/surrealdb#delivery-semantics","content":"Delivery Semantics"},"1938":{"id":"/docs/connectors/sinks/surrealdb-5","page_id":"/docs/connectors/sinks/surrealdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/surrealdb#transforms","content":"Transforms"},"1939":{"id":"/docs/connectors/sinks/surrealdb-6","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb","content":"The SurrealDB sink connector writes messages from Iggy streams into SurrealDB over the HTTP API. Each poll is split into chunks of at most `batch_size` messages, with one SurrealQL bulk `INSERT IGNORE ... RETURN NONE` for each chunk containing valid records. Every record gets a deterministic record id derived from stream, topic, partition, offset, and message id, so replaying the same identities leaves existing records untouched. Messages are not buffered across polls."},"1940":{"id":"/docs/connectors/sinks/surrealdb-7","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb","content":"This page is a curated subset of the documentation. The canonical reference is the upstream surrealdb_sink README in the `apache/iggy` repository."},"1941":{"id":"/docs/connectors/sinks/surrealdb-8","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.10.0 Iggy checkout root, build the plugin:"},"1942":{"id":"/docs/connectors/sinks/surrealdb-9","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#configuration","content":"Start a local SurrealDB instance with the credentials used below. This example stores SurrealDB data in memory:"},"1943":{"id":"/docs/connectors/sinks/surrealdb-10","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#configuration","content":"After the health request succeeds, save this connector file in the runtime's connector directory. Its plugin path assumes the runtime starts from the checkout root."},"1944":{"id":"/docs/connectors/sinks/surrealdb-11","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#configuration","content":"Create the Iggy resources and send a JSON message, then start the runtime as described in the sink guide:"},"1945":{"id":"/docs/connectors/sinks/surrealdb-12","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#configuration","content":"Query the stored records:"},"1946":{"id":"/docs/connectors/sinks/surrealdb-13","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#common-options","content":"| Option     | Type   | Default      | Description                                                                                         |\n| ---------- | ------ | ------------ | --------------------------------------------------------------------------------------------------- |\n| `endpoint` | string | **required** | SurrealDB HTTP host and port, e.g. `127.0.0.1:8000`. Full `http://` / `https://` URLs also accepted |","table":"table-0"},"1947":{"id":"/docs/connectors/sinks/surrealdb-14","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#common-options","content":"| Option      | Type   | Default      | Description                   |\n| ----------- | ------ | ------------ | ----------------------------- |\n| `namespace` | string | **required** | Namespace selected at startup |","table":"table-0"},"1948":{"id":"/docs/connectors/sinks/surrealdb-15","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#common-options","content":"| Option     | Type   | Default      | Description                  |\n| ---------- | ------ | ------------ | ---------------------------- |\n| `database` | string | **required** | Database selected at startup |","table":"table-0"},"1949":{"id":"/docs/connectors/sinks/surrealdb-16","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#common-options","content":"| Option  | Type   | Default      | Description                                       |\n| ------- | ------ | ------------ | ------------------------------------------------- |\n| `table` | string | **required** | Target table. Must be a safe SurrealQL identifier |","table":"table-0"},"1950":{"id":"/docs/connectors/sinks/surrealdb-17","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#common-options","content":"| Option                  | Type   | Default | Description                                |\n| ----------------------- | ------ | ------- | ------------------------------------------ |\n| `username` / `password` | string | none    | Both required unless `auth_scope = \"none\"` |","table":"table-0"},"1951":{"id":"/docs/connectors/sinks/surrealdb-18","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#common-options","content":"| Option       | Type   | Default | Description                                |\n| ------------ | ------ | ------- | ------------------------------------------ |\n| `auth_scope` | string | `root`  | `root`, `namespace`, `database`, or `none` |","table":"table-0"},"1952":{"id":"/docs/connectors/sinks/surrealdb-19","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#common-options","content":"| Option    | Type | Default | Description                                  |\n| --------- | ---- | ------- | -------------------------------------------- |\n| `use_tls` | bool | `false` | Use `https://` when `endpoint` has no scheme |","table":"table-0"},"1953":{"id":"/docs/connectors/sinks/surrealdb-20","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#common-options","content":"| Option              | Type | Default | Description                                                                              |\n| ------------------- | ---- | ------- | ---------------------------------------------------------------------------------------- |\n| `auto_define_table` | bool | `false` | Create missing namespace/database and a schemaless table. Requires `auth_scope = \"root\"` |","table":"table-0"},"1954":{"id":"/docs/connectors/sinks/surrealdb-21","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#common-options","content":"| Option           | Type | Default | Description                                                                                                              |\n| ---------------- | ---- | ------- | ------------------------------------------------------------------------------------------------------------------------ |\n| `define_indexes` | bool | `false` | Define a non-unique stream/topic/partition/offset index. Requires metadata and only runs with automatic table definition |","table":"table-0"},"1955":{"id":"/docs/connectors/sinks/surrealdb-22","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#common-options","content":"| Option       | Type | Default | Description                                                  |\n| ------------ | ---- | ------- | ------------------------------------------------------------ |\n| `batch_size` | u32  | `1000`  | Maximum input records per insert chunk. `0` is raised to `1` |","table":"table-0"},"1956":{"id":"/docs/connectors/sinks/surrealdb-23","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#common-options","content":"| Option           | Type   | Default | Description                                                        |\n| ---------------- | ------ | ------- | ------------------------------------------------------------------ |\n| `payload_format` | string | `auto`  | `auto`, `json`, `text`, `base64`, or `binary` (alias for `base64`) |","table":"table-0"},"1957":{"id":"/docs/connectors/sinks/surrealdb-24","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#common-options","content":"| Option             | Type | Default | Description                                                 |\n| ------------------ | ---- | ------- | ----------------------------------------------------------- |\n| `include_metadata` | bool | `true`  | Store stream/topic/partition/offset/timestamp/schema fields |","table":"table-0"},"1958":{"id":"/docs/connectors/sinks/surrealdb-25","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#common-options","content":"The `include_headers`, `include_checksum`, and `include_origin_timestamp` flags also default to `true` and work independently of `include_metadata`. Retry and timeout options are `query_timeout` (`30s` per HTTP request), `max_retries` (`3` total write attempts, with `0` raised to `1`), `retry_delay` (`100ms`), and `max_retry_delay` (`5s`). Invalid duration strings log a warning and fall back to `1s`. Zero durations are accepted. The maximum delay is raised to the base delay if configured smaller. `verbose_logging` defaults to `false` and raises per-poll submission logs from debug to info. See the upstream surrealdb_sink README for the full table."},"1959":{"id":"/docs/connectors/sinks/surrealdb-26","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#common-options","content":"Namespace, database and table names must start with an ASCII letter or underscore and contain only ASCII letters, digits and underscores. Endpoint URLs cannot contain credentials, a path beyond `/`, a query or a fragment. An explicit `http://` or `https://` scheme takes precedence over `use_tls`. Payload-format and authentication-scope names are case-insensitive. Unknown values prevent startup."},"1960":{"id":"/docs/connectors/sinks/surrealdb-27","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#common-options","content":"With root, namespace or database authentication, startup calls `/signin` and SQL requests use Basic authentication with the configured scope. Namespace/database users require pre-existing resources and `auto_define_table = false`. With `auth_scope = \"none\"`, credentials are ignored. The server must permit those unauthenticated operations. Automatic DDL uses `IF NOT EXISTS` and does not migrate existing definitions. The optional `<table>_iggy_offset_idx` index is not a uniqueness constraint. `define_indexes = true` with metadata disabled rejects startup. Without automatic DDL it only logs a warning and skips index creation."},"1961":{"id":"/docs/connectors/sinks/surrealdb-28","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#stored-shape","content":"Every submitted record contains `id`, `iggy_message_id`, `payload` and `payload_encoding`. `include_metadata` adds `iggy_stream`, `iggy_topic`, `iggy_partition_id`, `iggy_offset`, `iggy_timestamp` and `iggy_schema`. The checksum and origin timestamp have separate flags. `iggy_headers` appears only when enabled and nonempty."},"1962":{"id":"/docs/connectors/sinks/surrealdb-29","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#stored-shape","content":"Iggy message IDs, partition IDs, offsets, timestamps and checksums are stored as strings. Timestamps retain Iggy's microsecond values, not SurrealDB datetime values. Record IDs encode stream/topic UTF-8 bytes as hex, then append partition, offset and the 32-digit hexadecimal message ID. Changing the payload or transforms does not change that identity. Changing any identity component creates a different key."},"1963":{"id":"/docs/connectors/sinks/surrealdb-30","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#stored-shape","content":"Payload formatting operates after the runtime decoder and transforms:"},"1964":{"id":"/docs/connectors/sinks/surrealdb-31","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#stored-shape","content":"| `payload_format` | Stored payload and encoding                                                                                                         |\n| ---------------- | ----------------------------------------------------------------------------------------------------------------------------------- |\n| `auto`           | JSON values as `json`. Text/Proto variants as `text`. Raw/Avro/FlatBuffer bytes as `base64`, even when raw bytes contain valid JSON |","table":"table-1"},"1965":{"id":"/docs/connectors/sinks/surrealdb-32","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#stored-shape","content":"| `payload_format` | Stored payload and encoding                                                    |\n| ---------------- | ------------------------------------------------------------------------------ |\n| `json`           | A JSON value, parsing other payload variants as JSON. Invalid JSON is rejected |","table":"table-1"},"1966":{"id":"/docs/connectors/sinks/surrealdb-33","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#stored-shape","content":"| `payload_format` | Stored payload and encoding                                                |\n| ---------------- | -------------------------------------------------------------------------- |\n| `text`           | A string, decoding other payload bytes as UTF-8. Invalid UTF-8 is rejected |","table":"table-1"},"1967":{"id":"/docs/connectors/sinks/surrealdb-34","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#stored-shape","content":"| `payload_format`    | Stored payload and encoding                                     |\n| ------------------- | --------------------------------------------------------------- |\n| `base64` / `binary` | Base64 of the payload bytes, with `payload_encoding = \"base64\"` |","table":"table-1"},"1968":{"id":"/docs/connectors/sinks/surrealdb-35","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#stored-shape","content":"Non-raw headers are stored as strings, including numbers and booleans. Raw headers use `{\"data\":\"AQID\",\"iggy_header_encoding\":\"base64\"}`. Payload JSON is sent as SurrealQL values, so destination schema, numeric and other value constraints still apply."},"1969":{"id":"/docs/connectors/sinks/surrealdb-36","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#delivery-semantics","content":"The runtime auto-commits while polling, logs/counts plugin callback failures, and continues without replaying the failed batch. The sink retries transaction-conflict errors, connection/timeouts, and HTTP 408, 429, 500, 502, 503 and 504. Delays use capped exponential backoff with jitter. `Retry-After` is not used. Connection errors trigger reconnection and repeat sign-in/health/optional DDL. A failed reconnect stops that chunk, and retries plus startup requests can exceed `query_timeout` in total."},"1970":{"id":"/docs/connectors/sinks/surrealdb-37","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#delivery-semantics","content":"A malformed record is skipped while valid records in its chunk are still submitted. A failed chunk does not stop later chunks, and the last error is returned. The sink checks HTTP and SQL statement statuses. Its own processed counter counts records submitted in successful statements, including records ignored by `INSERT IGNORE`. Runtime counters instead reflect whether the whole callback succeeded. Neither is a count of newly inserted rows."},"1971":{"id":"/docs/connectors/sinks/surrealdb-38","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#delivery-semantics","content":"SurrealQL `INSERT IGNORE` preserves existing records with the same ID, including their old payloads. With the SurrealDB 3.1.4 instance above, `IGNORE` also silently skips unique-index conflicts and field-assertion failures while accepting valid records from the same chunk. These skips return a successful statement and are included in processed counters. This protects repeated writes of the same identities. It does not ensure that a failed batch will be delivered. There is no end-to-end at-least-once guarantee."},"1972":{"id":"/docs/connectors/sinks/surrealdb-39","page_id":"/docs/connectors/sinks/surrealdb","tags":[],"type":"text","url":"/docs/connectors/sinks/surrealdb#transforms","content":"Transforms can be applied before writing to SurrealDB. See the transforms documentation for the available types and their configuration."},"1973":{"id":"/docs/connectors/sources/elasticsearch","page_id":"/docs/connectors/sources/elasticsearch","type":"page","content":"Elasticsearch Source","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/elasticsearch"},"1974":{"id":"/docs/connectors/sources/elasticsearch-0","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch","content":"Poll documents from an Elasticsearch index into Iggy streams, incrementally when a timestamp field is configured."},"1975":{"id":"/docs/connectors/sources/elasticsearch-1","page_id":"/docs/connectors/sources/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sources/elasticsearch#configuration","content":"Configuration"},"1976":{"id":"/docs/connectors/sources/elasticsearch-2","page_id":"/docs/connectors/sources/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Plugin config options"},"1977":{"id":"/docs/connectors/sources/elasticsearch-3","page_id":"/docs/connectors/sources/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sources/elasticsearch#how-polling-works","content":"How Polling Works"},"1978":{"id":"/docs/connectors/sources/elasticsearch-4","page_id":"/docs/connectors/sources/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sources/elasticsearch#state","content":"State"},"1979":{"id":"/docs/connectors/sources/elasticsearch-5","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch","content":"The Elasticsearch source connector polls documents from an Elasticsearch index and produces them to Iggy streams. With a timestamp field configured, it filters searches using the last acknowledged timestamp. This is a timestamp watermark, with the limitations described below."},"1980":{"id":"/docs/connectors/sources/elasticsearch-6","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#configuration","content":"Use the broker credentials and main runtime configuration from the source guide. From the matching 0.10.0 Iggy checkout root, build the plugin:"},"1981":{"id":"/docs/connectors/sources/elasticsearch-7","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#configuration","content":"For this local example, start Elasticsearch with authentication disabled:"},"1982":{"id":"/docs/connectors/sources/elasticsearch-8","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#configuration","content":"Wait until the health response reports `timed_out: false`, then create the source index and a document:"},"1983":{"id":"/docs/connectors/sources/elasticsearch-9","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#configuration","content":"Save this connector entry in the runtime's connector directory. Start the runtime from the checkout root so the plugin path resolves."},"1984":{"id":"/docs/connectors/sources/elasticsearch-10","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#configuration","content":"Create the destination before starting the runtime:"},"1985":{"id":"/docs/connectors/sources/elasticsearch-11","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#configuration","content":"Start the runtime as described in the source guide. After the configured 30-second polling delay, read the produced message:"},"1986":{"id":"/docs/connectors/sources/elasticsearch-12","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"| Option | Type   | Default  | Description               |\n| ------ | ------ | -------- | ------------------------- |\n| `url`  | string | required | Elasticsearch cluster URL |","table":"table-0"},"1987":{"id":"/docs/connectors/sources/elasticsearch-13","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"| Option  | Type   | Default  | Description                                         |\n| ------- | ------ | -------- | --------------------------------------------------- |\n| `index` | string | required | Index to poll. Must exist when the connector starts |","table":"table-0"},"1988":{"id":"/docs/connectors/sources/elasticsearch-14","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"| Option                  | Type   | Default | Description                                                |\n| ----------------------- | ------ | ------- | ---------------------------------------------------------- |\n| `username` / `password` | string | none    | Basic authentication is enabled only when both are present |","table":"table-0"},"1989":{"id":"/docs/connectors/sources/elasticsearch-15","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"| Option  | Type  | Default     | Description                                  |\n| ------- | ----- | ----------- | -------------------------------------------- |\n| `query` | table | `match_all` | Elasticsearch query DSL applied on each poll |","table":"table-0"},"1990":{"id":"/docs/connectors/sources/elasticsearch-16","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"| Option             | Type   | Default | Description                                                                            |\n| ------------------ | ------ | ------- | -------------------------------------------------------------------------------------- |\n| `polling_interval` | string | `\"10s\"` | Delay before each poll cycle. Invalid strings fall back to `10s`, and zero is accepted |","table":"table-0"},"1991":{"id":"/docs/connectors/sources/elasticsearch-17","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"| Option       | Type    | Default | Description                                                                                       |\n| ------------ | ------- | ------- | ------------------------------------------------------------------------------------------------- |\n| `batch_size` | integer | `100`   | Search size per poll. `0` returns no hits, and Elasticsearch enforces its own result-window limit |","table":"table-0"},"1992":{"id":"/docs/connectors/sources/elasticsearch-18","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"| Option            | Type   | Default | Description                                                  |\n| ----------------- | ------ | ------- | ------------------------------------------------------------ |\n| `timestamp_field` | string | none    | Top-level RFC3339 string field used to advance the watermark |","table":"table-0"},"1993":{"id":"/docs/connectors/sources/elasticsearch-19","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"A custom `query` must be a structured object. In TOML that means nested tables (an inline JSON string won't work):"},"1994":{"id":"/docs/connectors/sources/elasticsearch-20","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"The connector file remains TOML. `plugin_config_format = \"json\"` only selects the default format of the HTTP API's plugin-config response. It does not change how the local file is parsed. The upstream config example also uses TOML with a structured `[plugin_config]` table."},"1995":{"id":"/docs/connectors/sources/elasticsearch-21","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#how-polling-works","content":"Each cycle the connector waits `polling_interval`, then runs a search against `index` with the configured `query`, `size = batch_size`, sorted ascending by `timestamp_field` (`@timestamp` when unset). Every hit with `_source` becomes one JSON message. Elasticsearch `_id` is not copied into the payload or used as the Iggy message ID. Headers and timestamps are also unset by this plugin."},"1996":{"id":"/docs/connectors/sources/elasticsearch-22","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#how-polling-works","content":"When `timestamp_field` is set, the query is also filtered to values strictly greater than the last acknowledged timestamp. Only top-level strings that parse as RFC3339 update the watermark. Numeric timestamps, date-only strings and nested paths do not. Without a `timestamp_field` there is no incremental cursor and each poll returns the first `batch_size` matching documents."},"1997":{"id":"/docs/connectors/sources/elasticsearch-23","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#how-polling-works","content":"The connector does not use scroll, `search_after` or a document-ID tiebreaker. If a timestamp group spans multiple batches, advancing past that timestamp skips the remaining tied documents. Late arrivals and updates at or below the watermark are also skipped. `scroll_timeout` is accepted but unused. Without a usable timestamp, repeated polls can produce duplicates. The default `@timestamp` sort still requires a sortable field in the index mapping."},"1998":{"id":"/docs/connectors/sources/elasticsearch-24","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#how-polling-works","content":"Search and JSON-decoding failures, `timed_out: true`, and a nonzero `_shards.failed` count are returned as poll errors without advancing the watermark. The next polling cycle retries from the previous watermark. Poll errors are logged by the SDK. They do not increment the runtime's forwarding-error counter or change the runtime connector status. There is no per-query retry loop or configured HTTP request timeout. The source stages a candidate watermark and applies it only after runtime `Ack`. `Nack` keeps the previous watermark so the next search can fetch the rejected records again. Fetched-document and byte counters include these repeated attempts. This does not remove the timestamp limitations above or provide exactly-once delivery."},"1999":{"id":"/docs/connectors/sources/elasticsearch-25","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#state","content":"Along with each successful poll, including an empty one, the connector returns a MessagePack checkpoint containing its timestamp watermark and counters. After sending the batch, the runtime saves that checkpoint and acknowledges it. With the default file state backend, it uses `source_<key>.state` under the runtime `[state]` path (default `local_state`). The runtime also supports an HTTP state backend. On restart, the saved checkpoint is passed to the plugin. Invalid MessagePack state logs a warning and starts fresh."},"2000":{"id":"/docs/connectors/sources/elasticsearch-26","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#state","content":"Runtime state persistence requires no plugin configuration. To reset its position with the file backend, stop the runtime and delete the source's state file."},"2001":{"id":"/docs/connectors/sources/elasticsearch-27","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#state","content":"The optional `[plugin_config.state]` enables a separate JSON snapshot loaded during `open()` and saved during `close()`. Its loaded values can override the runtime checkpoint. It defaults to `./connector_states/elasticsearch_source_<numeric_id>.json`. `state_id` and `storage_config.base_path` customize that location. Only file storage is implemented. Selecting `elasticsearch`, `redis` or an unknown storage type warns and falls back to `./connector_states`, ignoring the supplied backend location."},"2002":{"id":"/docs/connectors/sources/elasticsearch-28","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#state","content":"`state.auto_save_interval` and `state.tracked_fields` do not affect the runtime plugin. Its JSON snapshot is a direct file write, separate from the runtime's atomic checkpoint protocol, and snapshot errors only warn. If enabled, account for this second snapshot when resetting or restoring progress. Removing only the runtime state file does not reset the plugin snapshot."},"2003":{"id":"/docs/connectors/sources/elasticsearch-29","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#state","content":"The saved counters include fetched documents, successful polls (including empty polls), empty polls, serialized payload bytes, errors and the last error text. The average successful-poll duration includes the configured polling delay. Document-ID, scroll-ID and offset fields are retained in state but do not drive polling. These plugin counters are separate from the runtime's sent/error metrics."},"2004":{"id":"/docs/connectors/sources/http","page_id":"/docs/connectors/sources/http","type":"page","content":"HTTP Source","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/http"},"2005":{"id":"/docs/connectors/sources/http-0","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http","content":"Receive webhooks through authenticated HTTP paths and forward their payloads to Iggy."},"2006":{"id":"/docs/connectors/sources/http-1","page_id":"/docs/connectors/sources/http","type":"heading","tags":[],"url":"/docs/connectors/sources/http#configuration","content":"Configuration"},"2007":{"id":"/docs/connectors/sources/http-2","page_id":"/docs/connectors/sources/http","type":"heading","tags":[],"url":"/docs/connectors/sources/http#routes-and-authentication","content":"Routes and authentication"},"2008":{"id":"/docs/connectors/sources/http-3","page_id":"/docs/connectors/sources/http","type":"heading","tags":[],"url":"/docs/connectors/sources/http#responses-and-health","content":"Responses and health"},"2009":{"id":"/docs/connectors/sources/http-4","page_id":"/docs/connectors/sources/http","type":"heading","tags":[],"url":"/docs/connectors/sources/http#delivery-and-retries","content":"Delivery and retries"},"2010":{"id":"/docs/connectors/sources/http-5","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http","content":"The HTTP source accepts webhook POST bodies and produces raw messages to one configured stream and topic. Instances that use the same listener address share the listener. A separate admin address serves management, health details and metrics."},"2011":{"id":"/docs/connectors/sources/http-6","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#configuration","content":"Build `iggy_connector_http_source` from the same release source as the runtime. Create the destination stream and topic. Add this connector file through the local provider:"},"2012":{"id":"/docs/connectors/sources/http-7","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#configuration","content":"Replace both sample tokens. Keep the admin listener off the public load balancer. Terminate TLS in front of the public listener. Instances that share a listener must use the same address. Topic paths and endpoint IDs must be unique across those instances."},"2013":{"id":"/docs/connectors/sources/http-8","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#routes-and-authentication","content":"`POST /topics/{topic_path}` uses `auth_bearer_token`. If that field is omitted, the named path has no authentication. `POST /e/{endpoint_id}` uses a secret path with optional bearer or HMAC authentication. Generate secret endpoint IDs and keep their URLs private."},"2014":{"id":"/docs/connectors/sources/http-9","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#routes-and-authentication","content":"HMAC-SHA256 validation uses the raw body, not reserialized JSON. Per-endpoint secrets belong in TOML or the management API. Local environment overrides target top-level plugin fields and do not populate nested endpoint secrets."},"2015":{"id":"/docs/connectors/sources/http-10","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#routes-and-authentication","content":"Unknown plugin keys are ignored. Inspect the effective authentication posture in startup logs after changing configuration. The runtime control API exposes raw plugin configuration, so access to it also exposes configured secrets."},"2016":{"id":"/docs/connectors/sources/http-11","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"| Status | Meaning                                           |\n| ------ | ------------------------------------------------- |\n| 200    | Body queued in memory, with `{\"status\":\"queued\"}` |","table":"table-0"},"2017":{"id":"/docs/connectors/sources/http-12","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"| Status | Meaning               |\n| ------ | --------------------- |\n| 400    | Invalid or empty body |","table":"table-0"},"2018":{"id":"/docs/connectors/sources/http-13","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"| Status | Meaning               |\n| ------ | --------------------- |\n| 401    | Authentication failed |","table":"table-0"},"2019":{"id":"/docs/connectors/sources/http-14","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"| Status | Meaning                              |\n| ------ | ------------------------------------ |\n| 404    | Unknown, revoked or expired endpoint |","table":"table-0"},"2020":{"id":"/docs/connectors/sources/http-15","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"| Status | Meaning                           |\n| ------ | --------------------------------- |\n| 413    | Body exceeds the configured limit |","table":"table-0"},"2021":{"id":"/docs/connectors/sources/http-16","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"| Status | Meaning                            |\n| ------ | ---------------------------------- |\n| 429    | Buffer full, with `Retry-After: 1` |","table":"table-0"},"2022":{"id":"/docs/connectors/sources/http-17","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"| Status | Meaning                                                                  |\n| ------ | ------------------------------------------------------------------------ |\n| 503    | Instance unavailable, closing, or named route changed during the request |","table":"table-0"},"2023":{"id":"/docs/connectors/sources/http-18","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"Public `GET /health` returns success only while every serving instance on the listener has a healthy poll path. A stalled path or a batch receiving negative acknowledgements for over 60 seconds makes it unavailable. An instance does not publish routes until its first poll starts."},"2024":{"id":"/docs/connectors/sources/http-19","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#delivery-and-retries","content":"HTTP 200 confirms an in-memory enqueue. It does not confirm an Iggy write or durable storage. Process crashes and shutdown can lose accepted events. Sender retries and replayed batches can also create duplicates."},"2025":{"id":"/docs/connectors/sources/http-20","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#delivery-and-retries","content":"The source retains a negatively acknowledged batch and retries it with bounded backoff. There is no fixed NACK stop limit by default. Set `max_consecutive_nacks` only when accepted webhooks can be replayed externally after a restart. A stopped source can leave a buffer that no task drains."},"2026":{"id":"/docs/connectors/sources/http-21","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#delivery-and-retries","content":"Forward the provider's delivery ID and use it for application deduplication. An Iggy message ID stays stable for a batch replay, but a new HTTP request receives a new ID. The source reference describes endpoint management, persistence and metrics."},"2027":{"id":"/docs/connectors/sources/influxdb","page_id":"/docs/connectors/sources/influxdb","type":"page","content":"InfluxDB Source","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/influxdb"},"2028":{"id":"/docs/connectors/sources/influxdb-0","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb","content":"Poll InfluxDB on an interval and produce the resulting rows into an Iggy stream, on both InfluxDB V2 and V3."},"2029":{"id":"/docs/connectors/sources/influxdb-1","page_id":"/docs/connectors/sources/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sources/influxdb#configuration","content":"Configuration"},"2030":{"id":"/docs/connectors/sources/influxdb-2","page_id":"/docs/connectors/sources/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sources/influxdb#common-options","content":"Common Options"},"2031":{"id":"/docs/connectors/sources/influxdb-3","page_id":"/docs/connectors/sources/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sources/influxdb#cursor-based-polling","content":"Cursor-Based Polling"},"2032":{"id":"/docs/connectors/sources/influxdb-4","page_id":"/docs/connectors/sources/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sources/influxdb#payload-formats","content":"Payload Formats"},"2033":{"id":"/docs/connectors/sources/influxdb-5","page_id":"/docs/connectors/sources/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sources/influxdb#state-and-failures","content":"State and Failures"},"2034":{"id":"/docs/connectors/sources/influxdb-6","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb","content":"The InfluxDB source connector polls InfluxDB on an interval and produces the resulting rows as messages into an Iggy stream. It supports both InfluxDB V2 (OSS 2.x / Cloud, Flux queries) and InfluxDB V3 (Core / Enterprise, SQL queries), selected with the `version` option. An acknowledged timestamp cursor and row offset are stored in connector state. Restarts resume from that checkpoint, subject to the ordering and late-arrival limits below."},"2035":{"id":"/docs/connectors/sources/influxdb-7","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb","content":"This page is a curated subset of the documentation. The canonical reference, including the full cursor semantics and stuck-timestamp handling, is the upstream influxdb_source README in the `apache/iggy` repository."},"2036":{"id":"/docs/connectors/sources/influxdb-8","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#configuration","content":"Use the broker credentials and main runtime configuration from the source guide. Build the plugin from the matching 0.10.0 checkout root:"},"2037":{"id":"/docs/connectors/sources/influxdb-9","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#configuration","content":"The V2 example requires an existing `telemetry` bucket in `iggy_org`, a token with read access, and `cpu` points with a numeric `usage` field and a `host` tag. Save this entry in the runtime's connector directory and start the runtime from the checkout root."},"2038":{"id":"/docs/connectors/sources/influxdb-10","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#configuration","content":"Create the destination before starting the runtime:"},"2039":{"id":"/docs/connectors/sources/influxdb-11","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#configuration","content":"InfluxDB V2 takes an `org` and a Flux query. For V3, replace the entire `[plugin_config]` section below, including the V2-only `org`. The `my-db` database must contain a `cpu` table. This example assumes `host` is its only tag."},"2040":{"id":"/docs/connectors/sources/influxdb-12","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#configuration","content":"Omitting the plugin `version` defaults to `\"v2\"` for backward compatibility. It is separate from the connector entry's numeric configuration version. Unknown plugin keys and unsupported versions are rejected. The query must contain `$cursor` outside comments. Keep `$limit` in the query so the connector can control its size. With stuck-batch detection enabled, V3 also requires `$offset` and an ascending `ORDER BY`. Startup checks use text matching, so they do not prove that a query implements the required ordering."},"2041":{"id":"/docs/connectors/sources/influxdb-13","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#configuration","content":"Start the runtime as described in the source guide. After a polling cycle, read the produced records:"},"2042":{"id":"/docs/connectors/sources/influxdb-14","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"| Option    | Type   | Default | Description  |\n| --------- | ------ | ------- | ------------ |\n| `version` | string | `v2`    | `v2` or `v3` |","table":"table-0"},"2043":{"id":"/docs/connectors/sources/influxdb-15","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"| Option | Type   | Default      | Description       |\n| ------ | ------ | ------------ | ----------------- |\n| `url`  | string | **required** | InfluxDB base URL |","table":"table-0"},"2044":{"id":"/docs/connectors/sources/influxdb-16","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"| Option | Type   | Default           | Description       |\n| ------ | ------ | ----------------- | ----------------- |\n| `org`  | string | **required** (v2) | Organization name |","table":"table-0"},"2045":{"id":"/docs/connectors/sources/influxdb-17","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"| Option | Type   | Default           | Description     |\n| ------ | ------ | ----------------- | --------------- |\n| `db`   | string | **required** (v3) | Target database |","table":"table-0"},"2046":{"id":"/docs/connectors/sources/influxdb-18","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"| Option  | Type   | Default      | Description                                     |\n| ------- | ------ | ------------ | ----------------------------------------------- |\n| `token` | string | **required** | API token. Its debug representation is redacted |","table":"table-0"},"2047":{"id":"/docs/connectors/sources/influxdb-19","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"| Option  | Type   | Default      | Description                          |\n| ------- | ------ | ------------ | ------------------------------------ |\n| `query` | string | **required** | Flux (v2) or SQL (v3) query template |","table":"table-0"},"2048":{"id":"/docs/connectors/sources/influxdb-20","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"| Option          | Type   | Default | Description                     |\n| --------------- | ------ | ------- | ------------------------------- |\n| `poll_interval` | string | `5s`    | Delay before each polling cycle |","table":"table-0"},"2049":{"id":"/docs/connectors/sources/influxdb-21","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"| Option       | Type | Default | Description                                                                      |\n| ------------ | ---- | ------- | -------------------------------------------------------------------------------- |\n| `batch_size` | u32  | `500`   | Base query size. `0` is clamped to `1`, and cursor handling can enlarge `$limit` |","table":"table-0"},"2050":{"id":"/docs/connectors/sources/influxdb-22","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"| Option         | Type   | Default                   | Description               |\n| -------------- | ------ | ------------------------- | ------------------------- |\n| `cursor_field` | string | `_time` (v2), `time` (v3) | Column used as the cursor |","table":"table-0"},"2051":{"id":"/docs/connectors/sources/influxdb-23","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"| Option           | Type   | Default                | Description                                       |\n| ---------------- | ------ | ---------------------- | ------------------------------------------------- |\n| `initial_offset` | string | `1970-01-01T00:00:00Z` | Starting RFC3339 cursor when no checkpoint exists |","table":"table-0"},"2052":{"id":"/docs/connectors/sources/influxdb-24","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"| Option           | Type   | Default | Description              |\n| ---------------- | ------ | ------- | ------------------------ |\n| `payload_format` | string | `json`  | `json`, `text`, or `raw` |","table":"table-0"},"2053":{"id":"/docs/connectors/sources/influxdb-25","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"| Option             | Type | Default | Description                                               |\n| ------------------ | ---- | ------- | --------------------------------------------------------- |\n| `include_metadata` | bool | `true`  | Controls columns in the whole-row JSON payload. See below |","table":"table-0"},"2054":{"id":"/docs/connectors/sources/influxdb-26","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"| Option                   | Type | Default | Description                                                                     |\n| ------------------------ | ---- | ------- | ------------------------------------------------------------------------------- |\n| `stuck_batch_cap_factor` | u32  | `10`    | V3 only: inflation cap. Accepts `2` through `100`, or `0` to disable the guards |","table":"table-0"},"2055":{"id":"/docs/connectors/sources/influxdb-27","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"`payload_column` extracts one column. Without it, every `payload_format` setting emits whole-row JSON. With it, the selected `json`, `text` or `raw` format applies, and the destination `streams.schema` should match. Selecting a column that is missing from a row causes a poll error."},"2056":{"id":"/docs/connectors/sources/influxdb-28","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"Resilience defaults are `timeout = \"10s\"`, `max_retries = 3`, `retry_delay = \"1s\"`, `retry_max_delay = \"5s\"`, `max_open_retries = 10`, `open_retry_max_delay = \"60s\"`, `circuit_breaker_threshold = 5`, and `circuit_breaker_cool_down = \"30s\"`. Attempt counts include the first attempt and are clamped to at least one. Query retries cover network errors, HTTP 429 and 5xx, with exponential backoff and jitter. An integer-seconds `Retry-After` on a 429 or any 5xx can lengthen the calculated delay past `retry_max_delay`, up to one hour, but never shortens it. HTTP-date and unparsable values fall back to the calculated delay. Other HTTP failures and malformed successful responses return poll errors. Invalid duration strings warn and fall back to `1s`. Zero durations are accepted. `verbose_logging` defaults to `false`."},"2057":{"id":"/docs/connectors/sources/influxdb-29","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#cursor-based-polling","content":"The connector substitutes its RFC3339 cursor into the query. Both versions require ascending timestamps and a stable, unique order within each timestamp group. Include all necessary tag or key columns after the timestamp in the sort. The examples use `host` because their data model has one point per host and timestamp."},"2058":{"id":"/docs/connectors/sources/influxdb-30","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#cursor-based-polling","content":"**V2** uses an inclusive cursor, such as `range(start: time(v: \"$cursor\"))`. Flux sorts and limits each table separately, so the example groups its selected numeric field into one table before sorting. A persisted count skips rows already acknowledged at the cursor timestamp. `$limit` is the base batch size plus that count, capped at eleven times the base size. Dense timestamp groups can exhaust the skip allowance and produce a stuck-cursor error without advancing the cursor. A strict `>` query can lose unseen ties and is unsuitable for this skip-count scheme."},"2059":{"id":"/docs/connectors/sources/influxdb-31","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#cursor-based-polling","content":"**V3** requires strict `WHERE time > '$cursor'`. Inclusive `>=` templates are rejected. A full batch containing one timestamp retains the previous cursor, advances `$offset`, and doubles the next query size up to the configured cap. A full batch containing several timestamps defers the final timestamp group to the next poll. Reaching the inflation cap emits no messages, resets the effective size to the base size, preserves the offset, and records a circuit-breaker failure. The breaker opens only when its failure threshold is reached. Setting the cap factor to `0` disables these guards and can skip unseen tied rows."},"2060":{"id":"/docs/connectors/sources/influxdb-32","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#cursor-based-polling","content":"A timestamp watermark is not change-data capture. Late inserts, edits and backdated points at or below an acknowledged watermark can be missed, and changing the order of tied rows invalidates offset-based progress. Neither version tracks deletions. The connector's timestamp-plus-position message IDs can also collide for distinct rows across batches. They are not unique database-row keys."},"2061":{"id":"/docs/connectors/sources/influxdb-33","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#payload-formats","content":"**Whole-row `json`**: V3 emits a flat object with native JSON types. `include_metadata = false` removes only the cursor column. V2 emits an envelope with `measurement`, `field`, `timestamp`, `value` and `row`. Its parser reads CSV cells as strings and ignores the `#datatype` and `#default` values. Payload conversion tries bool, integer and finite float, then string. An empty cell becomes null. Thus a string field containing `\"42\"` becomes the number `42` in V2 but stays a string in V3. With metadata disabled, V2's `row` retains only `_time` and `_value`. The envelope remains."},"2062":{"id":"/docs/connectors/sources/influxdb-34","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#payload-formats","content":"**Selected-column `json`**: V2 parses the cell as JSON. V3 serializes the column's existing JSON value, so a string containing JSON remains a JSON string."},"2063":{"id":"/docs/connectors/sources/influxdb-35","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#payload-formats","content":"**Selected-column `text`**: V2 emits the cell as UTF-8. V3 emits strings directly and serializes other JSON values as text."},"2064":{"id":"/docs/connectors/sources/influxdb-36","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#payload-formats","content":"**Selected-column `raw`**: the column must contain standard base64 text, which is decoded into raw bytes."},"2065":{"id":"/docs/connectors/sources/influxdb-37","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#payload-formats","content":"Missing selected columns, invalid JSON cells in V2, and invalid base64 reject the poll. V3 also rejects any row with a missing, non-string or invalid cursor. V2 can emit rows without valid cursors if another row supplies a usable watermark. Keep the cursor column in every row. V3 timestamps without a timezone suffix are treated as UTC, preserving nanoseconds. Keep database timestamps in the payload when consumers need them. The runtime does not transfer the plugin's timestamp fields into broker message metadata."},"2066":{"id":"/docs/connectors/sources/influxdb-38","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#state-and-failures","content":"Successful polls return a versioned MessagePack checkpoint, including empty polls. After forwarding messages, the runtime saves it and sends `Ack`. Only then does the plugin apply its candidate cursor and row count. `Nack` discards that candidate so the next poll can fetch the records again. A failure after forwarding but before acknowledgement can produce duplicates."},"2067":{"id":"/docs/connectors/sources/influxdb-39","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#state-and-failures","content":"The default file backend stores `source_influxdb.state` under the runtime's state path (default `local_state`). The runtime also supports an HTTP state backend. V2 restores versioned state or its legacy unversioned state. V3 requires versioned V3 state. Corrupt checkpoints, invalid saved timestamps and mismatched versions prevent startup. To reset file-backed progress, stop the runtime and remove the source's checkpoint, then restart with the desired `initial_offset`."},"2068":{"id":"/docs/connectors/sources/influxdb-40","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#state-and-failures","content":"Query and parsing failures leave the acknowledged cursor unchanged and are logged as poll errors. They do not increment the runtime's forwarding-error counter or change its running status. While its circuit breaker is open, the plugin waits and returns empty batches without checkpoints. On cooldown expiry it permits another query. A V3 response reporting that the database was not found is treated as an empty result, so create the database before starting the source."},"2069":{"id":"/docs/connectors/sources/mqtt","page_id":"/docs/connectors/sources/mqtt","type":"page","content":"MQTT","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/mqtt"},"2070":{"id":"/docs/connectors/sources/mqtt-0","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt","content":"Read MQTT subscriptions and acknowledge broker messages after Iggy accepts their batch."},"2071":{"id":"/docs/connectors/sources/mqtt-1","page_id":"/docs/connectors/sources/mqtt","type":"heading","tags":[],"url":"/docs/connectors/sources/mqtt#configuration","content":"Configuration"},"2072":{"id":"/docs/connectors/sources/mqtt-2","page_id":"/docs/connectors/sources/mqtt","type":"heading","tags":[],"url":"/docs/connectors/sources/mqtt#tls","content":"TLS"},"2073":{"id":"/docs/connectors/sources/mqtt-3","page_id":"/docs/connectors/sources/mqtt","type":"heading","tags":[],"url":"/docs/connectors/sources/mqtt#batching","content":"Batching"},"2074":{"id":"/docs/connectors/sources/mqtt-4","page_id":"/docs/connectors/sources/mqtt","type":"heading","tags":[],"url":"/docs/connectors/sources/mqtt#delivery-behavior","content":"Delivery behavior"},"2075":{"id":"/docs/connectors/sources/mqtt-5","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt","content":"The MQTT source subscribes to an MQTT broker and sends payloads to one Iggy stream and topic. It supports MQTT 3.1.1 and MQTT 5, TLS, optional client certificates and per-filter QoS. MQTT 5 is the default."},"2076":{"id":"/docs/connectors/sources/mqtt-6","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#configuration","content":"Build `iggy_connector_mqtt_source` from the same release source as the runtime. Create the destination stream and topic before starting the connector. Add this file to the local provider:"},"2077":{"id":"/docs/connectors/sources/mqtt-7","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#configuration","content":"`broker_url` and a nonempty `subscriptions` list are required. Broker URLs accept `mqtt://`, `mqtts://` or `ssl://`. Supply `username` and `password` together when the broker requires credentials. `subscription_qos` can override the default QoS for a filter already listed in `subscriptions`. Each value must be zero, one or two."},"2078":{"id":"/docs/connectors/sources/mqtt-8","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#configuration","content":"Use a stable `client_id`, `clean_start=false` and a nonzero MQTT 5 session expiry to resume broker sessions. With `include_metadata=true`, the source places MQTT 5 properties in a JSON envelope. Without it, payloads remain raw bytes."},"2079":{"id":"/docs/connectors/sources/mqtt-9","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#tls","content":"`plugin_config.tls.ca_file` selects a CA bundle. `client_cert_file` and `client_key_file` must be supplied together for mutual TLS. Certificate hostname validation uses the host in `broker_url`. A separate server-name override is not available."},"2080":{"id":"/docs/connectors/sources/mqtt-10","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#batching","content":"`batch_size` defaults to 100 and `batch_timeout` to 10 milliseconds after the first message. `poll_timeout` defaults to one second. `request_capacity` defaults to 32. The source keeps one batch in flight until the runtime reports its result."},"2081":{"id":"/docs/connectors/sources/mqtt-11","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#batching","content":"These plugin limits are separate from the runtime producer's `batch_length` and `linger_time`. Configure only one destination `[[streams]]` entry per source instance. There is no per-message destination routing."},"2082":{"id":"/docs/connectors/sources/mqtt-12","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#delivery-behavior","content":"For QoS 1 and QoS 2, the source defers broker acknowledgements until Iggy accepts the batch. An Iggy failure causes a negative batch result, and the plugin retains the batch for replay. A crash after Iggy accepts it but before the broker receives the acknowledgement can produce duplicates."},"2083":{"id":"/docs/connectors/sources/mqtt-13","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#delivery-behavior","content":"`max_retries` defaults to five retries after the first broker acknowledgement attempt. If these attempts fail, the source abandons that acknowledgement and continues. Broker redelivery can then duplicate the message. QoS 0 has no acknowledgement token and cannot use this recovery mechanism."},"2084":{"id":"/docs/connectors/sources/mqtt-14","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#delivery-behavior","content":"The source returns no durable connector checkpoint. Recovery after restart depends on the broker retaining the MQTT session. MQTT packet IDs are temporary and cannot serve as durable deduplication keys. The source does not provide an end-to-end exactly-once guarantee, including when MQTT uses QoS 2."},"2085":{"id":"/docs/connectors/sources/mqtt-15","page_id":"/docs/connectors/sources/mqtt","tags":[],"type":"text","url":"/docs/connectors/sources/mqtt#delivery-behavior","content":"Select the destination topic's durability before creation. An Iggy acknowledgement under `replicated` does not imply stable-storage persistence. The MQTT source reference includes broker setup and recovery examples."},"2086":{"id":"/docs/connectors/sources/postgres","page_id":"/docs/connectors/sources/postgres","type":"page","content":"Postgres Source","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/postgres"},"2087":{"id":"/docs/connectors/sources/postgres-0","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres","content":"Stream rows from PostgreSQL into Iggy topics by incremental table polling or change data capture over logical replication."},"2088":{"id":"/docs/connectors/sources/postgres-1","page_id":"/docs/connectors/sources/postgres","type":"heading","tags":[],"url":"/docs/connectors/sources/postgres#features","content":"Features"},"2089":{"id":"/docs/connectors/sources/postgres-2","page_id":"/docs/connectors/sources/postgres","type":"heading","tags":[],"url":"/docs/connectors/sources/postgres#configuration","content":"Configuration"},"2090":{"id":"/docs/connectors/sources/postgres-3","page_id":"/docs/connectors/sources/postgres","type":"heading","tags":[],"url":"/docs/connectors/sources/postgres#plugin-config-options","content":"Plugin config options"},"2091":{"id":"/docs/connectors/sources/postgres-4","page_id":"/docs/connectors/sources/postgres","type":"heading","tags":[],"url":"/docs/connectors/sources/postgres#polling-and-delivery","content":"Polling and Delivery"},"2092":{"id":"/docs/connectors/sources/postgres-5","page_id":"/docs/connectors/sources/postgres","type":"heading","tags":[],"url":"/docs/connectors/sources/postgres#output-format","content":"Output Format"},"2093":{"id":"/docs/connectors/sources/postgres-6","page_id":"/docs/connectors/sources/postgres","type":"heading","tags":[],"url":"/docs/connectors/sources/postgres#payload-column-extraction","content":"Payload Column Extraction"},"2094":{"id":"/docs/connectors/sources/postgres-7","page_id":"/docs/connectors/sources/postgres","type":"heading","tags":[],"url":"/docs/connectors/sources/postgres#cdc-mode","content":"CDC Mode"},"2095":{"id":"/docs/connectors/sources/postgres-8","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres","content":"The PostgreSQL source connector fetches data from PostgreSQL databases and streams it to Iggy topics. It supports incremental table polling and Change Data Capture (CDC) via logical replication."},"2096":{"id":"/docs/connectors/sources/postgres-9","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres","content":"This page is a curated subset of the documentation. The canonical reference, including payload extraction recipes, custom query parameters, and sink round-trip examples, is the upstream postgres_source README in the `apache/iggy` repository."},"2097":{"id":"/docs/connectors/sources/postgres-10","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#features","content":"**Table Polling**: Incrementally fetch rows using a tracking column"},"2098":{"id":"/docs/connectors/sources/postgres-11","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#features","content":"**Change Data Capture**: Monitor database changes using PostgreSQL logical replication (`test_decoding` plugin)"},"2099":{"id":"/docs/connectors/sources/postgres-12","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#features","content":"**Payload Column Extraction**: Emit a single column directly as the message payload (raw bytes, text, or JSONB)"},"2100":{"id":"/docs/connectors/sources/postgres-13","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#features","content":"**Custom Queries**: Use custom SQL with parameter substitution instead of simple table polling"},"2101":{"id":"/docs/connectors/sources/postgres-14","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#features","content":"**Delete / Mark Processed**: Optionally delete rows or flag them in a boolean column after acknowledgement"},"2102":{"id":"/docs/connectors/sources/postgres-15","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#features","content":"**Offset Tracking**: Per-table tracking offsets are persisted as connector state and survive restarts"},"2103":{"id":"/docs/connectors/sources/postgres-16","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#features","content":"**Automatic Retries**: Transient polling-query errors are retried with a configurable delay"},"2104":{"id":"/docs/connectors/sources/postgres-17","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#configuration","content":"Use the broker credentials and main runtime configuration from the source guide. Build the plugin from the matching 0.10.0 checkout root:"},"2105":{"id":"/docs/connectors/sources/postgres-18","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#configuration","content":"The example uses an existing PostgreSQL database named `iggy`, with an `iggy` user and password. Run this SQL in that database:"},"2106":{"id":"/docs/connectors/sources/postgres-19","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#configuration","content":"Save this entry in the runtime's connector directory and start the runtime from the checkout root:"},"2107":{"id":"/docs/connectors/sources/postgres-20","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#configuration","content":"Create the destination before starting the runtime:"},"2108":{"id":"/docs/connectors/sources/postgres-21","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#configuration","content":"After a polling cycle, read the produced records:"},"2109":{"id":"/docs/connectors/sources/postgres-22","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option              | Type   | Default  | Description                  |\n| ------------------- | ------ | -------- | ---------------------------- |\n| `connection_string` | string | required | PostgreSQL connection string |","table":"table-0"},"2110":{"id":"/docs/connectors/sources/postgres-23","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option | Type   | Default  | Description        |\n| ------ | ------ | -------- | ------------------ |\n| `mode` | string | required | `polling` or `cdc` |","table":"table-0"},"2111":{"id":"/docs/connectors/sources/postgres-24","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option   | Type  | Default  | Description                                                                         |\n| -------- | ----- | -------- | ----------------------------------------------------------------------------------- |\n| `tables` | array | required | Polling tables. An empty list polls none. In CDC, an empty list captures all tables |","table":"table-0"},"2112":{"id":"/docs/connectors/sources/postgres-25","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option          | Type   | Default | Description                                                                  |\n| --------------- | ------ | ------- | ---------------------------------------------------------------------------- |\n| `poll_interval` | string | `\"10s\"` | Delay before each cycle (e.g. `1s`, `5m`). Invalid values fall back to `10s` |","table":"table-0"},"2113":{"id":"/docs/connectors/sources/postgres-26","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option       | Type | Default | Description                                                                                                           |\n| ------------ | ---- | ------- | --------------------------------------------------------------------------------------------------------------------- |\n| `batch_size` | u32  | `1000`  | Polling: limit per table, with `0` returning no rows. CDC: a transaction-boundary limit that a transaction can exceed |","table":"table-0"},"2114":{"id":"/docs/connectors/sources/postgres-27","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option            | Type   | Default | Description                                     |\n| ----------------- | ------ | ------- | ----------------------------------------------- |\n| `tracking_column` | string | `\"id\"`  | Column used by the strict `>` polling watermark |","table":"table-0"},"2115":{"id":"/docs/connectors/sources/postgres-28","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option           | Type   | Default | Description                                               |\n| ---------------- | ------ | ------- | --------------------------------------------------------- |\n| `initial_offset` | string | none    | Exclusive starting value when a table has no saved offset |","table":"table-0"},"2116":{"id":"/docs/connectors/sources/postgres-29","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option            | Type | Default | Description              |\n| ----------------- | ---- | ------- | ------------------------ |\n| `max_connections` | u32  | `10`    | Max database connections |","table":"table-0"},"2117":{"id":"/docs/connectors/sources/postgres-30","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option               | Type | Default | Description                        |\n| -------------------- | ---- | ------- | ---------------------------------- |\n| `snake_case_columns` | bool | `false` | Convert column names to snake_case |","table":"table-0"},"2118":{"id":"/docs/connectors/sources/postgres-31","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option             | Type | Default | Description                                                                                     |\n| ------------------ | ---- | ------- | ----------------------------------------------------------------------------------------------- |\n| `include_metadata` | bool | `true`  | Polling envelope layout. `false` currently nests the row under `data.data` and retains metadata |","table":"table-0"},"2119":{"id":"/docs/connectors/sources/postgres-32","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option           | Type   | Default | Description                                       |\n| ---------------- | ------ | ------- | ------------------------------------------------- |\n| `payload_column` | string | none    | Column to extract directly as the message payload |","table":"table-0"},"2120":{"id":"/docs/connectors/sources/postgres-33","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option           | Type   | Default | Description                                                     |\n| ---------------- | ------ | ------- | --------------------------------------------------------------- |\n| `payload_format` | string | none    | Defaults to `json`. Selected-column formats are described below |","table":"table-0"},"2121":{"id":"/docs/connectors/sources/postgres-34","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option              | Type | Default | Description                                                   |\n| ------------------- | ---- | ------- | ------------------------------------------------------------- |\n| `delete_after_read` | bool | `false` | Delete selected rows after Ack. Takes precedence over marking |","table":"table-0"},"2122":{"id":"/docs/connectors/sources/postgres-35","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option             | Type   | Default | Description                                                                  |\n| ------------------ | ------ | ------- | ---------------------------------------------------------------------------- |\n| `processed_column` | string | none    | Adds a `FALSE` filter to the default query and marks selected rows after Ack |","table":"table-0"},"2123":{"id":"/docs/connectors/sources/postgres-36","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option               | Type   | Default           | Description                                 |\n| -------------------- | ------ | ----------------- | ------------------------------------------- |\n| `primary_key_column` | string | `tracking_column` | Primary key used for delete/mark operations |","table":"table-0"},"2124":{"id":"/docs/connectors/sources/postgres-37","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option         | Type   | Default | Description                            |\n| -------------- | ------ | ------- | -------------------------------------- |\n| `custom_query` | string | none    | Custom SQL with parameter substitution |","table":"table-0"},"2125":{"id":"/docs/connectors/sources/postgres-38","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option             | Type   | Default       | Description                           |\n| ------------------ | ------ | ------------- | ------------------------------------- |\n| `replication_slot` | string | `\"iggy_slot\"` | Replication slot name (CDC mode only) |","table":"table-0"},"2126":{"id":"/docs/connectors/sources/postgres-39","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option               | Type  | Default                        | Description               |\n| -------------------- | ----- | ------------------------------ | ------------------------- |\n| `capture_operations` | array | `[\"INSERT\",\"UPDATE\",\"DELETE\"]` | CDC operations to capture |","table":"table-0"},"2127":{"id":"/docs/connectors/sources/postgres-40","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option        | Type   | Default     | Description                                |\n| ------------- | ------ | ----------- | ------------------------------------------ |\n| `cdc_backend` | string | `\"builtin\"` | CDC backend. Only `builtin` is implemented |","table":"table-0"},"2128":{"id":"/docs/connectors/sources/postgres-41","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option            | Type | Default | Description                        |\n| ----------------- | ---- | ------- | ---------------------------------- |\n| `verbose_logging` | bool | `false` | Log at info level instead of debug |","table":"table-0"},"2129":{"id":"/docs/connectors/sources/postgres-42","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option        | Type | Default | Description                                                                    |\n| ------------- | ---- | ------- | ------------------------------------------------------------------------------ |\n| `max_retries` | u32  | `3`     | Total polling-query attempts, including the first. `0` still makes one attempt |","table":"table-0"},"2130":{"id":"/docs/connectors/sources/postgres-43","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"| Option        | Type   | Default | Description                                                                                   |\n| ------------- | ------ | ------- | --------------------------------------------------------------------------------------------- |\n| `retry_delay` | string | `\"1s\"`  | Linear delay: this duration times the failed attempt number. Invalid values fall back to `1s` |","table":"table-0"},"2131":{"id":"/docs/connectors/sources/postgres-44","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#polling-and-delivery","content":"The default query selects rows with `tracking_column > last_offset`, orders that column ascending, and applies `batch_size` separately to each table. Use a non-null, unique tracking value that increases in the database's sort order. A timestamp with ties can skip rows at a batch boundary, and inserts or updates at or below the watermark are not revisited. Polling does not capture deletions."},"2132":{"id":"/docs/connectors/sources/postgres-45","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#polling-and-delivery","content":"A `custom_query` replaces the entire default query, including its ordering, limit and processed-row filter. Its placeholders are `$table`, `$offset`, `$limit`, `$now` (RFC3339 UTC) and `$now_unix` (integer seconds). Substitution is textual, with no automatic quoting or escaping. `$offset` is empty if neither saved state nor `initial_offset` supplies it. Keep queries trusted and explicitly preserve ascending tracking-column order. The offset comes from the last returned row with a usable tracking value."},"2133":{"id":"/docs/connectors/sources/postgres-46","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#polling-and-delivery","content":"Polling stages its cursor and processed-row count until the runtime forwards the batch, saves its checkpoint and sends `Ack`. `Nack` discards that candidate so the next poll can read the rows again. A failure after forwarding can therefore duplicate messages. IDs are random UUIDs for each poll, so replayed rows do not retain a stable message ID."},"2134":{"id":"/docs/connectors/sources/postgres-47","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#polling-and-delivery","content":"`delete_after_read` and `processed_column` stage cleanup keys during polling and modify PostgreSQL only after `Ack`. A Nack or failed poll leaves the rows available for replay. Cleanup is separate from delivery and checkpointing: a cleanup error stops the source, and a crash after checkpointing but before cleanup can leave already-delivered rows unmodified in PostgreSQL. Cleanup across tables is not atomic."},"2135":{"id":"/docs/connectors/sources/postgres-48","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#polling-and-delivery","content":"The file state backend stores `source_postgres-source.state` under the runtime's state path (default `local_state`). Its MessagePack state contains per-table offsets, a last-poll time and a processed-row count. The HTTP state backend is also available. Missing or undecodable plugin state starts fresh. File access errors prevent startup. Stop the runtime before resetting its checkpoint. `initial_offset` is used only where saved offsets are absent."},"2136":{"id":"/docs/connectors/sources/postgres-49","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#polling-and-delivery","content":"The plugin's retries cover transient polling `SELECT` failures, including connection I/O, pool timeouts, serialization failures and deadlocks. Connection setup, CDC fetches and delete/mark statements do not use that retry loop. A poll error is logged and polling continues without incrementing the runtime's forwarding-error counter. Repeated delivery or checkpoint failures instead receive `Nack`. The SDK stops after five consecutive Nacks."},"2137":{"id":"/docs/connectors/sources/postgres-50","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#output-format","content":"By default (no `payload_column`), each row is wrapped in a JSON envelope:"},"2138":{"id":"/docs/connectors/sources/postgres-51","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#output-format","content":"The stream config should use `schema = \"json\"`. Flat-schema sinks such as Iceberg need the `unwrap_envelope` transform to extract the `data` field. See the transforms documentation."},"2139":{"id":"/docs/connectors/sources/postgres-52","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#payload-column-extraction","content":"In polling mode, an existing `payload_column` bypasses the envelope. Use `bytea` or `raw` for a BYTEA column with `schema = \"raw\"`, `text` for a text column with `schema = \"text\"`, and `json_direct`, `jsonb` or `jsonb_direct` for JSON/JSONB with `schema = \"json\"`. A null BYTEA/text payload becomes empty bytes, which the Iggy message builder rejects. The entire batch is Nacked. Use non-null, non-empty BYTEA/text payloads. A null JSON/JSONB payload becomes JSON `null` and can be delivered."},"2140":{"id":"/docs/connectors/sources/postgres-53","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#payload-column-extraction","content":"The default `payload_format = \"json\"` reads a selected column as BYTEA but reports JSON to the runtime, so those bytes must contain valid JSON. Without a selected column, the connector always emits a JSON envelope. If the selected column is absent, it falls back to the envelope while retaining the selected format's schema. Use a column present in every configured table. Type mismatches reject the poll. See the upstream README for sink round-trip recipes."},"2141":{"id":"/docs/connectors/sources/postgres-54","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#payload-column-extraction","content":"With no selected column, `include_metadata = false` currently retains the envelope and adds an extra `data` level. Whole-row BYTEA fields are base64 strings. Keep database timestamps in the payload when needed. The runtime does not copy the plugin's timestamp fields into broker message metadata."},"2142":{"id":"/docs/connectors/sources/postgres-55","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"With `mode = \"cdc\"` the connector reads changes from a logical replication slot instead of polling tables:"},"2143":{"id":"/docs/connectors/sources/postgres-56","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"The builtin backend creates (or reuses) a logical replication slot using the `test_decoding` output plugin. The default slot name is `iggy_slot`. No publication is created or required, since `test_decoding` ignores publications entirely."},"2144":{"id":"/docs/connectors/sources/postgres-57","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"PostgreSQL must run with `wal_level = logical` and have `test_decoding` installed and allowed. The login needs access to the logical-decoding SQL functions. This backend uses ordinary SQL connections, not a replication-protocol connection. Any proxy must support its SQL and slot operations."},"2145":{"id":"/docs/connectors/sources/postgres-58","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"`capture_operations` accepts uppercase `INSERT`, `UPDATE` and `DELETE`. An empty array emits none. Filtering happens after reading the slot. Qualified table names match the schema and table. Unqualified names match that table name in any schema. An empty `tables` array captures all tables."},"2146":{"id":"/docs/connectors/sources/postgres-59","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"The `pg_replicate` backend (based on Supabase's ETL framework) is **not implemented**: selecting `cdc_backend = \"pg_replicate\"` fails at startup unless the `cdc_pg_replicate` build feature is enabled, and the backend returns an error even when it is."},"2147":{"id":"/docs/connectors/sources/postgres-60","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"Each connector needs its own slot. Reusing one slot across connectors divides its changes between them. `pg_logical_slot_get_changes` consumes slot progress before delivery, including changes excluded by the filters. A later failure cannot replay those changes from the slot, and the plugin checkpoint does not contain a recovery LSN."},"2148":{"id":"/docs/connectors/sources/postgres-61","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"CDC always builds a JSON envelope with the operation and parsed columns. Do not combine it with polling payload extraction options. Deletes contain replica-identity columns. Updates may also supply `old_data` from an `old-key` tuple. Quoted `test_decoding` values, including JSONB and arrays, remain strings. Unchanged TOAST values are represented as null, which does not establish that the database value is null. Envelope timestamps are generated while polling, not PostgreSQL transaction commit times."},"2149":{"id":"/docs/connectors/sources/postgres-62","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"When decommissioning a CDC connector, stop it and drop its replication slot to stop WAL retention. With PostgreSQL's default `max_slot_wal_keep_size = -1`, an unused slot can retain unbounded WAL. See the upstream README for details."},"2150":{"id":"/docs/connectors/sources/random","page_id":"/docs/connectors/sources/random","type":"page","content":"Random Source","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/random"},"2151":{"id":"/docs/connectors/sources/random-0","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random","content":"Generate random messages into Iggy streams for testing, benchmarking and verifying a connector pipeline."},"2152":{"id":"/docs/connectors/sources/random-1","page_id":"/docs/connectors/sources/random","type":"heading","tags":[],"url":"/docs/connectors/sources/random#configuration","content":"Configuration"},"2153":{"id":"/docs/connectors/sources/random-2","page_id":"/docs/connectors/sources/random","type":"heading","tags":[],"url":"/docs/connectors/sources/random#plugin-config-options","content":"Plugin config options"},"2154":{"id":"/docs/connectors/sources/random-3","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random","content":"The random source connector generates random messages and sends them to Iggy streams. This is useful for testing, benchmarking, and verifying that your connector pipeline is working correctly without needing an external data source."},"2155":{"id":"/docs/connectors/sources/random-4","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#configuration","content":"Use the broker credentials and runtime setup from the source guide. Save the configuration below in that runtime's connector directory. From the matching 0.10.0 repository root, build the plugin:"},"2156":{"id":"/docs/connectors/sources/random-5","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"| Option     | Type   | Default | Description                                                                              |\n| ---------- | ------ | ------- | ---------------------------------------------------------------------------------------- |\n| `interval` | string | `\"1s\"`  | Delay before each message generation cycle. Invalid duration strings fall back to `\"1s\"` |","table":"table-0"},"2157":{"id":"/docs/connectors/sources/random-6","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"| Option      | Type  | Default   | Description                                                          |\n| ----------- | ----- | --------- | -------------------------------------------------------------------- |\n| `max_count` | usize | unlimited | Stop producing after this many messages in total. Omit for unlimited |","table":"table-0"},"2158":{"id":"/docs/connectors/sources/random-7","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"| Option           | Type       | Default    | Description                                                                                                                |\n| ---------------- | ---------- | ---------- | -------------------------------------------------------------------------------------------------------------------------- |\n| `messages_range` | [u32, u32] | `[10, 50]` | Min (inclusive) / max (exclusive) messages per batch, capped by the remaining `max_count`. The lower bound must be smaller |","table":"table-0"},"2159":{"id":"/docs/connectors/sources/random-8","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"| Option         | Type | Default | Description                                                     |\n| -------------- | ---- | ------- | --------------------------------------------------------------- |\n| `payload_size` | u32  | `100`   | Number of random characters in the `text` field of each message |","table":"table-0"},"2160":{"id":"/docs/connectors/sources/random-9","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Setting `max_count = 0` stops production immediately (the connector produces zero messages). To generate messages without a limit, leave the key out."},"2161":{"id":"/docs/connectors/sources/random-10","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"The connector stages its count for each batch and commits it only after the runtime acknowledges delivery and saves the checkpoint. Restoring that checkpoint enforces `max_count` across restarts. Missing or undecodable state starts the count at zero. After reaching the limit, polling continues but returns no messages or new checkpoint."},"2162":{"id":"/docs/connectors/sources/random-11","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"A non-increasing `messages_range` returns a configuration error when message generation is attempted. The SDK logs poll errors and continues polling. Each generated JSON record contains a random UUID `id`, fixed `title = \"Hello\"` and `name = \"World\"`, and random alphanumeric `text`. `payload_size` controls only that text, not the total serialized record size."},"2163":{"id":"/docs/connectors/sources/random-12","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Create `my-stream` and `my-topic` before starting the runtime, or change the sample to use an existing destination. Configure one destination per source instance."},"2164":{"id":"/docs/connectors/sources/source","page_id":"/docs/connectors/sources/source","type":"page","content":"Source","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/source"},"2165":{"id":"/docs/connectors/sources/source-0","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source","content":"What source connectors do, and the Source trait every one of them implements."},"2166":{"id":"/docs/connectors/sources/source-1","page_id":"/docs/connectors/sources/source","type":"heading","tags":[],"url":"/docs/connectors/sources/source#overview","content":"Overview"},"2167":{"id":"/docs/connectors/sources/source-2","page_id":"/docs/connectors/sources/source","type":"heading","tags":[],"url":"/docs/connectors/sources/source#configuration","content":"Configuration"},"2168":{"id":"/docs/connectors/sources/source-3","page_id":"/docs/connectors/sources/source","type":"heading","tags":[],"url":"/docs/connectors/sources/source#environment-variable-overrides","content":"Environment Variable Overrides"},"2169":{"id":"/docs/connectors/sources/source-4","page_id":"/docs/connectors/sources/source","type":"heading","tags":[],"url":"/docs/connectors/sources/source#sample-implementation","content":"Sample implementation"},"2170":{"id":"/docs/connectors/sources/source-5","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#overview","content":"Source connectors are responsible for ingesting data from external sources into Apache Iggy. They provide a way to integrate Apache Iggy with various data sources, such as databases, message queues, or file systems."},"2171":{"id":"/docs/connectors/sources/source-6","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#overview","content":"The source is represented by the single `Source` trait, which defines the basic interface for all source connectors. It provides methods for initializing the source, reading data from it, and closing the source."},"2172":{"id":"/docs/connectors/sources/source-7","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"With the local configuration provider, each source connector has a TOML file in the directory specified by the main runtime config. The runtime also supports an HTTP configuration provider."},"2173":{"id":"/docs/connectors/sources/source-8","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"| Field | Meaning                                                                 |\n| ----- | ----------------------------------------------------------------------- |\n| `key` | Connector key (`String`), separate from the numeric plugin instance ID. |","table":"table-0"},"2174":{"id":"/docs/connectors/sources/source-9","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"| Field     | Meaning                                  |\n| --------- | ---------------------------------------- |\n| `enabled` | Whether to start the connector (`bool`). |","table":"table-0"},"2175":{"id":"/docs/connectors/sources/source-10","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"| Field     | Meaning                        |\n| --------- | ------------------------------ |\n| `version` | Configuration version (`u64`). |","table":"table-0"},"2176":{"id":"/docs/connectors/sources/source-11","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"| Field  | Meaning                  |\n| ------ | ------------------------ |\n| `name` | Display name (`String`). |","table":"table-0"},"2177":{"id":"/docs/connectors/sources/source-12","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"| Field  | Meaning                         |\n| ------ | ------------------------------- |\n| `path` | Shared-library path (`String`). |","table":"table-0"},"2178":{"id":"/docs/connectors/sources/source-13","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"| Field     | Meaning                       |\n| --------- | ----------------------------- |\n| `streams` | Stream configuration entries. |","table":"table-0"},"2179":{"id":"/docs/connectors/sources/source-14","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"| Field        | Meaning                           |\n| ------------ | --------------------------------- |\n| `transforms` | Optional transform configuration. |","table":"table-0"},"2180":{"id":"/docs/connectors/sources/source-15","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"| Field           | Meaning                                                          |\n| --------------- | ---------------------------------------------------------------- |\n| `plugin_config` | Optional custom configuration object deserialized by the plugin. |","table":"table-0"},"2181":{"id":"/docs/connectors/sources/source-16","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"| Field                  | Meaning                                                                                          |\n| ---------------------- | ------------------------------------------------------------------------------------------------ |\n| `plugin_config_format` | Optional default format for the HTTP API's plugin-config response. The FFI always receives JSON. |","table":"table-0"},"2182":{"id":"/docs/connectors/sources/source-17","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"| Field                  | Meaning                          |\n| ---------------------- | -------------------------------- |\n| `verbose`, `benchmark` | Optional logging flags (`bool`). |","table":"table-0"},"2183":{"id":"/docs/connectors/sources/source-18","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"`verbose` and `benchmark` are optional and default to `false`. `verbose` switches the connector's per-batch logging to info level, and `benchmark` emits per-batch timing events for performance measurement."},"2184":{"id":"/docs/connectors/sources/source-19","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"**Main runtime config (connectors.toml, in the repository root):**"},"2185":{"id":"/docs/connectors/sources/source-20","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Use the matching 0.10.0 checkout and broker from the quick start. Its broker must use the credentials below. Create the `connectors` directory, then save these two configuration files there and in the repository root as labeled."},"2186":{"id":"/docs/connectors/sources/source-21","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"**Source connector config (connectors/random.toml):**"},"2187":{"id":"/docs/connectors/sources/source-22","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Configure one `[[streams]]` destination per source instance. The runtime currently retains only the last producer when multiple entries are supplied."},"2188":{"id":"/docs/connectors/sources/source-23","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#environment-variable-overrides","content":"Configuration properties can be overridden using environment variables. Supported scalar fields and indexed stream entries use the pattern: `IGGY_CONNECTORS_SOURCE_[KEY]_[PROPERTY]`"},"2189":{"id":"/docs/connectors/sources/source-24","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#environment-variable-overrides","content":"For example, to disable the source with key `random` at the next runtime start:"},"2190":{"id":"/docs/connectors/sources/source-25","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#environment-variable-overrides","content":"Top-level fields of `plugin_config` can be overridden (or injected) the same way with the `IGGY_CONNECTORS_SOURCE_[KEY]_PLUGIN_CONFIG_[FIELD]` pattern. This lets you supply credentials without writing them into the TOML file:"},"2191":{"id":"/docs/connectors/sources/source-26","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Let's implement the example source connector, which generates a random batch of messages at the configured interval and optionally stops after a total message limit."},"2192":{"id":"/docs/connectors/sources/source-27","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Additionally, our source connector will have its own state, which can be used e.g. to track the overall progress or store some relevant information when producing the data from the actual external sources or tooling."},"2193":{"id":"/docs/connectors/sources/source-28","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Keep in mind, that the produced messages will be sent further to the specified stream, however it's already the responsibility of the runtime to handle the delivery."},"2194":{"id":"/docs/connectors/sources/source-29","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Also, when implementing the source connector, make sure to use the `source_connector!` macro to expose the FFI interface and allow the connector runtime to register the source with the runtime."},"2195":{"id":"/docs/connectors/sources/source-30","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"And finally, each source should have its own, custom configuration, which is passed along with the unique plugin ID and optional state via expected `new()` method."},"2196":{"id":"/docs/connectors/sources/source-31","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"The reference crate is core/connectors/sources/random_source. Use its `Cargo.toml` from the matching checkout, including `[lib] crate-type = [\"cdylib\", \"lib\"]` and its workspace dependency features. The Rust blocks in this sample implementation section combine into `src/lib.rs`. The trait above is an API reference and is not part of that file."},"2197":{"id":"/docs/connectors/sources/source-32","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Start with the imports, then define the internal state and the public source connector along with its configuration."},"2198":{"id":"/docs/connectors/sources/source-33","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"At this point, we can expose the required `new()` method, which will be used by the runtime to create a new instance of the source connector. The `id` is assigned by the runtime, and represents the unique identifier of the source connector. The `state` is an optional connector state (e.g. persisted by the file or HTTP state backend), which will be provided by the runtime, given that the connector has persisted its own state before the runtime was restarted. The `ConnectorState::deserialize()` helper decodes the MessagePack bytes back into our `State` struct, falling back to a fresh state when nothing was persisted or decoding fails."},"2199":{"id":"/docs/connectors/sources/source-34","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"We can invoke the expected macro to expose the FFI interface and allow the connector runtime to register the source within the runtime."},"2200":{"id":"/docs/connectors/sources/source-35","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"The reference manifest supplies these dependencies:"},"2201":{"id":"/docs/connectors/sources/source-36","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"async-trait"},"2202":{"id":"/docs/connectors/sources/source-37","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"dashmap"},"2203":{"id":"/docs/connectors/sources/source-38","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"iggy_connector_sdk"},"2204":{"id":"/docs/connectors/sources/source-39","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"serde"},"2205":{"id":"/docs/connectors/sources/source-40","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"tokio"},"2206":{"id":"/docs/connectors/sources/source-41","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"tracing"},"2207":{"id":"/docs/connectors/sources/source-42","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"The implementation also uses `humantime`, `rand`, `simd-json`, and `uuid`. The reference crate uses `rmp-serde` directly in its tests. The production state helpers come from the SDK."},"2208":{"id":"/docs/connectors/sources/source-43","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Before we make use of the `Source` trait, let's define the internal payload of the message that will be produced (e.g. as if it was pulled from some external database or so)."},"2209":{"id":"/docs/connectors/sources/source-44","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"`serialize_state()` encodes the state to MessagePack via `ConnectorState::serialize()`. `generate_messages()` samples the half-open `messages_range` (lower bound included, upper bound excluded), capped by the remaining `max_count`. Each message carries a JSON-serialized `Record` with `payload_size` random alphanumeric characters of text. A non-increasing range returns `Error::InvalidConfigValue` from `poll()` without advancing state."},"2210":{"id":"/docs/connectors/sources/source-45","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Now implement `Source` for `RandomSource`. Each `poll()` waits for `interval`, builds a batch without exceeding `max_count`, and stages a candidate checkpoint. The runtime sends the batch, saves its optional checkpoint, and calls `on_batch_result()`. Only `Ack` commits the in-memory count. `Nack` discards the candidate. After restart, `new()` receives the last persisted checkpoint. Once the limit is reached, polls return empty messages and no new state."},"2211":{"id":"/docs/connectors/sources/source-46","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"The SDK permits only one batch in flight. Returning an error from `on_batch_result()` stops polling. Returning an error from `poll()` logs the error and continues the polling loop. A source that tracks a cursor or performs destructive upstream work must implement the callback instead of relying on its default no-op."},"2212":{"id":"/docs/connectors/sources/source-47","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"The runtime forwards the encoded payload, optional message ID and headers. Although `ProducedMessage` also accepts `checksum`, `timestamp` and `origin_timestamp`, the current forwarding path does not copy those three fields into the Iggy message."},"2213":{"id":"/docs/connectors/sources/source-48","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"It's also important to note, that the supported format(s) might vary depending on the connector implementation. For example, you might use `JSON` as the payload format, which can be then easily parsed and processed by downstream components such as data transforms, but at the same time, you could support the other formats and let the user decide which one to use."},"2214":{"id":"/docs/connectors/sources/source-49","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"The destination `schema` selects the `StreamEncoder`. A decode, transform or encoding error rejects the entire source batch, leaves its checkpoint uncommitted and produces `Nack`. The runtime logs and counts the error. An intentional filter result (`Ok(None)`) may drop selected messages without rejecting the batch."},"2215":{"id":"/docs/connectors/sources/source-50","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Build the matching plugin, runtime and CLI from the repository root:"},"2216":{"id":"/docs/connectors/sources/source-51","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"On an empty broker, create the destination using the credentials from the quick start:"},"2217":{"id":"/docs/connectors/sources/source-52","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"After saving the configuration files above, start the runtime. This explicitly enables the source if you tried the optional disabling override:"},"2218":{"id":"/docs/connectors/sources/source-53","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"And that's all, enjoy using the source connector!"},"2219":{"id":"/docs/connectors/sources/source-54","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"On a side note, if you'd like to process the messages consumed from the Iggy stream instead, you can implement your own **Sink connector** too :)"},"2220":{"id":"/docs/connectors/transforms","page_id":"/docs/connectors/transforms","type":"page","content":"Transforms","breadcrumbs":["Documentation","Connectors"],"tags":[],"url":"/docs/connectors/transforms"},"2221":{"id":"/docs/connectors/transforms-0","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms","content":"Mutate, filter and convert messages as they pass through the connector runtime, and how each transform is configured."},"2222":{"id":"/docs/connectors/transforms-1","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#configuration","content":"Configuration"},"2223":{"id":"/docs/connectors/transforms-2","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#add_fields","content":"add_fields"},"2224":{"id":"/docs/connectors/transforms-3","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#delete_fields","content":"delete_fields"},"2225":{"id":"/docs/connectors/transforms-4","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#update_fields","content":"update_fields"},"2226":{"id":"/docs/connectors/transforms-5","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#filter_fields","content":"filter_fields"},"2227":{"id":"/docs/connectors/transforms-6","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#unwrap_envelope","content":"unwrap_envelope"},"2228":{"id":"/docs/connectors/transforms-7","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#proto_convert","content":"proto_convert"},"2229":{"id":"/docs/connectors/transforms-8","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#flat_buffer_convert","content":"flat_buffer_convert"},"2230":{"id":"/docs/connectors/transforms-9","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#avro_convert","content":"avro_convert"},"2231":{"id":"/docs/connectors/transforms-10","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#adding-a-new-transform","content":"Adding a new transform"},"2232":{"id":"/docs/connectors/transforms-11","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms","content":"Transforms mutate, filter, or convert messages as they flow through the connector runtime. They run inside the runtime process, not inside the plugins. For source connectors they're applied after the plugin's messages are decoded and before producing to Iggy. For sink connectors, after consuming from Iggy and before handing the messages to the plugin."},"2233":{"id":"/docs/connectors/transforms-12","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms","content":"A transform receives each decoded message and returns either the (possibly modified) message, or nothing - in which case the message is dropped from the batch. A transform can also return an error. A source rejects the whole batch and its checkpoint on a transform error. A sink drops the affected message and continues processing the batch."},"2234":{"id":"/docs/connectors/transforms-13","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#configuration","content":"Transforms are configured per connector in the `transforms` section of the connector configuration file. Each transform type is a table keyed by its name, so a connector can have at most one instance of each type:"},"2235":{"id":"/docs/connectors/transforms-14","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#configuration","content":"Two rules apply to every transform:"},"2236":{"id":"/docs/connectors/transforms-15","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#configuration","content":"The `enabled` key is required. A transform section without it fails to load, and a transform with `enabled = false` is skipped."},"2237":{"id":"/docs/connectors/transforms-16","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#configuration","content":"The order of the sections in the file doesn't determine the execution order, so don't rely on one transform seeing the output of another."},"2238":{"id":"/docs/connectors/transforms-17","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#configuration","content":"The field-level transforms (`add_fields`, `delete_fields`, `filter_fields`, `update_fields`, `unwrap_envelope`) operate on JSON objects only. Other JSON values and other payload formats pass through them unchanged."},"2239":{"id":"/docs/connectors/transforms-18","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"Adds top-level fields to the message payload, replacing any existing value with the same key. Each field has a `key` and a `value`, which is either static or computed at runtime:"},"2240":{"id":"/docs/connectors/transforms-19","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"The available computed values are:"},"2241":{"id":"/docs/connectors/transforms-20","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"| Value       | Result                                      |\n| ----------- | ------------------------------------------- |\n| `date_time` | Current date and time as an RFC 3339 string |","table":"table-0"},"2242":{"id":"/docs/connectors/transforms-21","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"| Value             | Result                                |\n| ----------------- | ------------------------------------- |\n| `timestamp_nanos` | Current Unix timestamp in nanoseconds |","table":"table-0"},"2243":{"id":"/docs/connectors/transforms-22","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"| Value              | Result                                 |\n| ------------------ | -------------------------------------- |\n| `timestamp_micros` | Current Unix timestamp in microseconds |","table":"table-0"},"2244":{"id":"/docs/connectors/transforms-23","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"| Value              | Result                                 |\n| ------------------ | -------------------------------------- |\n| `timestamp_millis` | Current Unix timestamp in milliseconds |","table":"table-0"},"2245":{"id":"/docs/connectors/transforms-24","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"| Value               | Result                            |\n| ------------------- | --------------------------------- |\n| `timestamp_seconds` | Current Unix timestamp in seconds |","table":"table-0"},"2246":{"id":"/docs/connectors/transforms-25","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"| Value     | Result                  |\n| --------- | ----------------------- |\n| `uuid_v4` | Random UUID (version 4) |","table":"table-0"},"2247":{"id":"/docs/connectors/transforms-26","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"| Value     | Result                        |\n| --------- | ----------------------------- |\n| `uuid_v7` | Time-ordered UUID (version 7) |","table":"table-0"},"2248":{"id":"/docs/connectors/transforms-27","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#delete_fields","content":"Removes the listed top-level fields from the message payload:"},"2249":{"id":"/docs/connectors/transforms-28","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#update_fields","content":"Sets fields to static or computed values, optionally guarded by a condition:"},"2250":{"id":"/docs/connectors/transforms-29","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#update_fields","content":"The `condition` values are `always` (the default when omitted - sets the field whether or not it exists), `key_exists` (update only when the field is already present), and `key_not_exists` (add only when the field is absent)."},"2251":{"id":"/docs/connectors/transforms-30","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#filter_fields","content":"Keeps or drops fields of the payload based on key and value patterns:"},"2252":{"id":"/docs/connectors/transforms-31","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#filter_fields","content":"**`keep_fields`**: fields that are always kept, regardless of the patterns."},"2253":{"id":"/docs/connectors/transforms-32","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#filter_fields","content":"**`patterns`**: a list of patterns. A field matches when any pattern matches. Within one pattern, `key_pattern` and `value_pattern` must both match when both are set (an omitted one matches everything)."},"2254":{"id":"/docs/connectors/transforms-33","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#filter_fields","content":"**`include_matching`**: `true` (default) keeps the matching fields and drops the rest. `false` drops the matching fields and keeps the rest."},"2255":{"id":"/docs/connectors/transforms-34","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#filter_fields","content":"An empty `keep_fields` list together with an empty `patterns` list leaves the payload unchanged. Invalid regular expressions fail configuration loading. Numeric `between` comparisons include both endpoints."},"2256":{"id":"/docs/connectors/transforms-35","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#filter_fields","content":"`key_pattern` variants: `exact`, `starts_with`, `ends_with`, `contains`, `regex` - each takes a string, e.g. `key_pattern = { contains = \"name\" }`."},"2257":{"id":"/docs/connectors/transforms-36","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#filter_fields","content":"`value_pattern` variants: `equals` (any JSON value), `contains` (substring), `regex`, `greater_than`, `less_than`, `between` (e.g. `{ between = [1.0, 10.0] }`), and the parameterless checks `is_null`, `is_not_null`, `is_string`, `is_number`, `is_boolean`, `is_object`, `is_array` (written as plain strings, e.g. `value_pattern = \"is_number\"`)."},"2258":{"id":"/docs/connectors/transforms-37","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#unwrap_envelope","content":"Promotes a nested field of a JSON envelope to the top-level payload. Given `{ \"table\": \"...\", \"operation\": \"...\", \"data\": { ... } }`, setting `field = \"data\"` replaces the whole payload with the contents of `data`:"},"2259":{"id":"/docs/connectors/transforms-38","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#unwrap_envelope","content":"`field` must not be empty. Messages that aren't JSON objects, or that don't contain the field, pass through unchanged."},"2260":{"id":"/docs/connectors/transforms-39","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#proto_convert","content":"Converts messages between Protocol Buffers and other formats. This example exposes the `type_url` and base64 `value` of an Any envelope received as raw bytes. See the **SDK documentation** for a complete runtime configuration and the schema loading details:"},"2261":{"id":"/docs/connectors/transforms-40","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#proto_convert","content":"Optional keys: `schema_path`, `message_type`, `field_mappings` (rename JSON input fields, e.g. `field_mappings = { \"old\" = \"new\" }`), `descriptor_set` (pre-compiled descriptor bytes instead of a `.proto` file), and the inactive `schema_registry_url`."},"2262":{"id":"/docs/connectors/transforms-41","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#proto_convert","content":"A loaded descriptor is used for JSON-to-protobuf encoding. Without one, that direction produces JSON text in `Payload::Proto`. Protobuf-to-JSON conversion does not decode a custom message descriptor: it parses text as JSON, exposes an Any envelope, or returns metadata containing base64 raw data. Protobuf-to-Avro/FlatBuffers conversion only rewraps the bytes."},"2263":{"id":"/docs/connectors/transforms-42","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#proto_convert","content":"`preserve_unknown_fields`, `validate_messages`, `type_url_prefix`, and `strict_mode` are accepted but have no effect. `pretty_json` affects JSON text output, and `include_metadata` adds fields on the supported protobuf-to-JSON paths."},"2264":{"id":"/docs/connectors/transforms-43","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#flat_buffer_convert","content":"Converts JSON to the SDK's generic FlatBuffer representation, or exposes FlatBuffer bytes as metadata, base64 text, or raw bytes. It does not interpret an external `.fbs` schema. This example can be added to a JSON-producing source with `streams.schema = \"flat_buffer\"`:"},"2265":{"id":"/docs/connectors/transforms-44","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#flat_buffer_convert","content":"Optional keys: `schema_path`, `root_table_name`, `field_mappings`. JSON encoding uses a generic key/value representation, so its output is not a buffer for an arbitrary generated table type. FlatBuffer-to-JSON returns buffer metadata and base64 bytes, not decoded table fields."},"2266":{"id":"/docs/connectors/transforms-45","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#flat_buffer_convert","content":"`schema_path`, `include_paths`, and `preserve_unknown_fields` have no effect. `root_table_name` only labels decoding metadata. `verify_buffers` checks the minimum buffer length (four bytes), not a schema-aware verifier. `buffer_size_hint` sets the initial encoder capacity. `pretty_json`, `include_metadata`, and `strict_mode` have no effect."},"2267":{"id":"/docs/connectors/transforms-46","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#flat_buffer_convert","content":"The input payload variant must match `source_format`. The default `flat_buffer` stream decoder already returns JSON metadata, so it does not supply `Payload::FlatBuffer` to a following reverse transform."},"2268":{"id":"/docs/connectors/transforms-47","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#avro_convert","content":"Converts JSON to a raw Avro datum and Avro data to JSON. The schema can be given inline (`schema_json`) or as a file (`schema_path`). The inline schema takes precedence. This example can be added to the Random source with `streams.schema = \"avro\"`:"},"2269":{"id":"/docs/connectors/transforms-48","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#avro_convert","content":"Optional keys: `schema_path`, `schema_json`, `field_mappings`. JSON encoding and Avro-to-JSON decoding require a schema. Input values must match its field types. The wire payload is one raw Avro datum, not an Avro object container file. Decoding rejects trailing bytes."},"2270":{"id":"/docs/connectors/transforms-49","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#avro_convert","content":"`field_mappings` renames input JSON fields or fields decoded from Avro. Text input is not field-mapped. Text-to-Avro parses JSON before encoding. Raw-to-Avro rewraps existing bytes without validating them. Avro-to-Text emits base64 and Avro-to-Raw preserves the bytes. All three `conversion_options` keys are accepted but have no effect. Unsupported conversion pairs pass their input through unchanged."},"2271":{"id":"/docs/connectors/transforms-50","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#avro_convert","content":"To consume raw Avro records in a sink, configure `schema = \"avro\"` and `avro_schema_json` or `avro_schema_path` in its `[[streams]]` entry. The runtime decodes the datum into JSON before running transforms. A following `avro_convert` with `source_format = \"avro\"` would therefore receive the wrong payload variant."},"2272":{"id":"/docs/connectors/transforms-51","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#avro_convert","content":"Unlike the field-level transforms, the three format-conversion transforms define no per-key defaults: every key shown in their examples (except the ones listed as optional) must be present, or the connector configuration fails to load. The `source_format` and `target_format` keys accept any schema value: `json`, `raw`, `text`, `proto`, `flat_buffer`, `avro`. The FlatBuffers transform additionally restricts the pair: only JSON to/from FlatBuffers, FlatBuffers to Text or Raw, and identity conversions are accepted. Any other combination fails the configuration load."},"2273":{"id":"/docs/connectors/transforms-52","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#adding-a-new-transform","content":"The extension point is the SDK (`core/connectors/sdk/src/transforms/`):"},"2274":{"id":"/docs/connectors/transforms-53","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#adding-a-new-transform","content":"Add a new module implementing the `Transform` trait."},"2275":{"id":"/docs/connectors/transforms-54","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#adding-a-new-transform","content":"Add a variant to the `TransformType` enum."},"2276":{"id":"/docs/connectors/transforms-55","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#adding-a-new-transform","content":"Add a match arm to the `from_config` function deserializing your config."},"2277":{"id":"/docs/connectors/transforms-56","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#adding-a-new-transform","content":"The runtime loads transforms generically by `TransformType`, so no runtime changes are needed."},"2278":{"id":"/docs/faq/faq","page_id":"/docs/faq/faq","type":"page","content":"FAQ","breadcrumbs":["Documentation","FAQ"],"tags":[],"url":"/docs/faq/faq"},"2279":{"id":"/docs/faq/faq-0","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq","content":"Common questions about Apache Iggy, including how it compares to Kafka and other message brokers."},"2280":{"id":"/docs/faq/faq-1","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-what-is-the-difference-between-iggy-and-traditional-message-brokers-like-kafka","content":"Q: What is the difference between Iggy and traditional message brokers like Kafka?"},"2281":{"id":"/docs/faq/faq-2","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-are-there-plans-to-support-kafka-protocol-in-iggy","content":"Q: Are there plans to support Kafka protocol in Iggy?"},"2282":{"id":"/docs/faq/faq-3","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-what-transport-protocol-should-i-use","content":"Q: What transport protocol should I use?"},"2283":{"id":"/docs/faq/faq-4","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-what-are-the-system-requirements","content":"Q: What are the system requirements?"},"2284":{"id":"/docs/faq/faq-5","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-how-does-consumer-group-rebalancing-work","content":"Q: How does consumer group rebalancing work?"},"2285":{"id":"/docs/faq/faq-6","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-does-iggy-support-exactly-once-delivery","content":"Q: Does Iggy support exactly-once delivery?"},"2286":{"id":"/docs/faq/faq-7","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-how-do-i-secure-my-iggy-deployment","content":"Q: How do I secure my Iggy deployment?"},"2287":{"id":"/docs/faq/faq-8","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-can-i-use-iggy-with-my-existing-tooling","content":"Q: Can I use Iggy with my existing tooling?"},"2288":{"id":"/docs/faq/faq-9","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-what-happened-to-the-tokio-based-runtime","content":"Q: What happened to the Tokio-based runtime?"},"2289":{"id":"/docs/faq/faq-10","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-is-clusteringreplication-available","content":"Q: Is clustering/replication available?"},"2290":{"id":"/docs/faq/faq-11","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-what-examples-are-available","content":"Q: What examples are available?"},"2291":{"id":"/docs/faq/faq-12","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-what-is-the-difference-between-iggy-and-traditional-message-brokers-like-kafka","content":"Iggy is a persistent message streaming platform that stores messages in an append-only log format, similar to Kafka. However, Iggy is designed for high performance and low latency using `io_uring` and a thread-per-core architecture. Iggy uses its own binary protocol rather than the Kafka protocol. Clients can use an Iggy SDK, implement the documented binary protocol, or use the HTTP API."},"2292":{"id":"/docs/faq/faq-13","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-are-there-plans-to-support-kafka-protocol-in-iggy","content":"The Kafka gateway supports Kafka producers, consumers and selected admin APIs. Run it separately with the Iggy bridge enabled. It supports a defined protocol subset and does not support transactions."},"2293":{"id":"/docs/faq/faq-14","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-what-transport-protocol-should-i-use","content":"For maximum throughput and lowest latency, use **TCP**. If you need built-in encryption without configuring TLS separately, **QUIC** is a good choice. **WebSocket** works well for browser-based clients. **HTTP** is the most accessible but has the highest overhead due to JSON serialization. HTTP connections can be reused. Consumer groups can be created, inspected, and deleted, but there is no join/leave membership over HTTP."},"2294":{"id":"/docs/faq/faq-15","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-what-are-the-system-requirements","content":"Iggy runs as a single server process without an external coordination service. Native library requirements depend on the build. The provided Linux images include hwloc and udev libraries. The Linux shard runtime requires `io_uring` flags introduced in kernel 5.19. The server starts with around 20 MB of RAM. The default 4 GiB memory-pool setting is a budget, with buffers allocated on demand and fallback allocations outside the pool."},"2295":{"id":"/docs/faq/faq-16","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-what-are-the-system-requirements","content":"Docker must allow the required `io_uring` calls and provide enough locked-memory allowance. The supplied Compose configuration uses `SYS_NICE`, `seccomp:unconfined` and unlimited memlock. Those settings are not universal requirements for every host. See Docker and configuration."},"2296":{"id":"/docs/faq/faq-17","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-how-does-consumer-group-rebalancing-work","content":"When consumers join or leave a consumer group, the server triggers cooperative partition rebalancing. Partitions are redistributed among active members. During rebalancing, a pending revocation phase fences new polls from the previous owner. Its configurable timeout defaults to 30s, after which the server can force a transfer. This coordinates polling ownership. It does not prove that application processing has finished."},"2297":{"id":"/docs/faq/faq-18","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-does-iggy-support-exactly-once-delivery","content":"Committing an offset before application processing, including poll-time auto-commit, can provide **at-most-once** processing: a crash can lose unprocessed messages. Committing only after successful processing supports **at-least-once** processing, with duplicates possible after a crash. Recovery also depends on retention and the configured message and consumer-offset durability. Iggy does not provide an atomic transaction between a consumer offset and an external side effect. **Exactly-once** application effects require an idempotent operation or an atomic deduplication-and-effect transaction. Unique message IDs alone do not provide that guarantee."},"2298":{"id":"/docs/faq/faq-19","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-does-iggy-support-exactly-once-delivery","content":"The Rust producer and Kafka gateway support opt-in idempotent batches. This suppresses retries within bounded producer history. It does not make external side effects atomic with offset commits."},"2299":{"id":"/docs/faq/faq-20","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-how-do-i-secure-my-iggy-deployment","content":"Iggy supports TLS on all transport protocols, Argon2id password hashing, granular per-stream/per-topic permissions, Personal Access Tokens for programmatic access, and optional AES-256-GCM-SIV encryption of stored message payloads. For the HTTP API, JWT tokens are used for session management. See the Security documentation for details."},"2300":{"id":"/docs/faq/faq-21","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-can-i-use-iggy-with-my-existing-tooling","content":"Iggy provides a Model Context Protocol (MCP) server with 40+ tools for LLM integration, connectors for piping data to/from external systems (e.g. PostgreSQL, MongoDB, Elasticsearch, ClickHouse, InfluxDB, S3, Delta Lake, Apache Iceberg, Quickwit), Prometheus metrics, and OpenTelemetry traces/logs in the connectors runtime. Broker OpenTelemetry export has runtime limitations described in configuration. The HTTP API works with REST clients."},"2301":{"id":"/docs/faq/faq-22","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-what-happened-to-the-tokio-based-runtime","content":"Iggy migrated from Tokio to a thread-per-core architecture with `compio` (which uses `io_uring` on Linux) starting with version 0.6.0. The published v0.5.0 versus v0.7.0 comparison reports 92% lower P9999 latency for its 16-producer, 16-stream, 40-million-message workload, and 18% higher throughput for the corresponding fsync workload. These are historical workload results, not a guarantee for 0.10.0. You can read the full story in the thread-per-core io_uring blog post."},"2302":{"id":"/docs/faq/faq-23","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-is-clusteringreplication-available","content":"Yes. Replication based on Viewstamped Replication (VSR) is built into the server. Multi-node clustering is configured via the `[cluster]` section (single-node mode is the default, `enabled = false`). It covers consensus, view changes, node authentication, and TLS between nodes, and is maturing toward production readiness. See the Clustering documentation for the protocol and Deploy for setting up a cluster."},"2303":{"id":"/docs/faq/faq-24","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-what-examples-are-available","content":"Examples are available in the repository for multiple languages: Rust (basic, getting-started, message-envelope, message-headers, multi-tenant, new-sdk, sink-data-producer, stream-builder, tcp-tls), C#, Go, Java, Node.js, PHP, Python and Swift. Docker Compose files and Helm charts are also provided."},"2304":{"id":"/docs/gateways/kafka","page_id":"/docs/gateways/kafka","type":"page","content":"Kafka Gateway","breadcrumbs":["Documentation","Gateways"],"tags":[],"url":"/docs/gateways/kafka"},"2305":{"id":"/docs/gateways/kafka-0","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka","content":"Run Kafka producers, consumers and admin clients against Iggy through the Kafka gateway."},"2306":{"id":"/docs/gateways/kafka-1","page_id":"/docs/gateways/kafka","type":"heading","tags":[],"url":"/docs/gateways/kafka#enable-the-bridge","content":"Enable the bridge"},"2307":{"id":"/docs/gateways/kafka-2","page_id":"/docs/gateways/kafka","type":"heading","tags":[],"url":"/docs/gateways/kafka#create-produce-and-consume","content":"Create, produce and consume"},"2308":{"id":"/docs/gateways/kafka-3","page_id":"/docs/gateways/kafka","type":"heading","tags":[],"url":"/docs/gateways/kafka#supported-operations","content":"Supported operations"},"2309":{"id":"/docs/gateways/kafka-4","page_id":"/docs/gateways/kafka","type":"heading","tags":[],"url":"/docs/gateways/kafka#delivery-and-durability","content":"Delivery and durability"},"2310":{"id":"/docs/gateways/kafka-5","page_id":"/docs/gateways/kafka","type":"heading","tags":[],"url":"/docs/gateways/kafka#authentication-and-authorization","content":"Authentication and authorization"},"2311":{"id":"/docs/gateways/kafka-6","page_id":"/docs/gateways/kafka","type":"heading","tags":[],"url":"/docs/gateways/kafka#listener-and-bridge-configuration","content":"Listener and bridge configuration"},"2312":{"id":"/docs/gateways/kafka-7","page_id":"/docs/gateways/kafka","type":"heading","tags":[],"url":"/docs/gateways/kafka#run-several-gateways","content":"Run several gateways"},"2313":{"id":"/docs/gateways/kafka-8","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka","content":"The Kafka gateway 0.2.0 is a separate service named `iggy-gateway-kafka`. It accepts Kafka wire requests and uses the Rust SDK to store and read data in Iggy. Kafka clients connect to the gateway port, 9093 by default. Native Iggy clients continue to use Iggy listeners."},"2314":{"id":"/docs/gateways/kafka-9","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#enable-the-bridge","content":"The bridge is the gateway's connection to Iggy. It is disabled by default. Without it, data and topic APIs do not store data. Producer ID allocation and in-memory group coordination alone do not prove that storage is enabled."},"2315":{"id":"/docs/gateways/kafka-10","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#enable-the-bridge","content":"Start the Iggy server from the release source with development credentials. Then run the gateway from the same repository root:"},"2316":{"id":"/docs/gateways/kafka-11","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#enable-the-bridge","content":"Use these credentials only for local development. In a deployment, provision a separate bridge account with the required permissions. A transient connection failure retries at startup for up to 60 seconds. Bad credentials or missing required permissions stop startup. The gateway does not silently switch back to storage-free responses."},"2317":{"id":"/docs/gateways/kafka-12","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#enable-the-bridge","content":"The Docker Compose example starts a local Iggy server and gateway. Review its image selection and development credentials before running it. The gateway image is `apache/iggy-kafka-gateway`."},"2318":{"id":"/docs/gateways/kafka-13","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#create-produce-and-consume","content":"With Kafka command-line tools installed, use the gateway as the bootstrap server:"},"2319":{"id":"/docs/gateways/kafka-14","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#create-produce-and-consume","content":"Enter a message in the producer, then read it from another terminal:"},"2320":{"id":"/docs/gateways/kafka-15","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#create-produce-and-consume","content":"By default, Kafka topic `orders` maps to Iggy stream `kafka`, topic `orders`. `IGGY_KAFKA_IGGY_STREAM` changes the default stream. `IGGY_KAFKA_TOPIC_MAP_PATH` selects a TOML mapping file:"},"2321":{"id":"/docs/gateways/kafka-16","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#create-produce-and-consume","content":"Topic auto-creation is disabled by default. Enable `IGGY_KAFKA_AUTO_CREATE_TOPICS_ENABLED` only when Metadata requests are allowed to create missing topics. `IGGY_KAFKA_AUTO_CREATE_TOPICS_PARTITIONS` defaults to one and cannot exceed 1000."},"2322":{"id":"/docs/gateways/kafka-17","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#supported-operations","content":"The gateway supports Produce, Fetch, ListOffsets, Metadata, topic creation and deletion, partition additions, and topic retention changes. Consumer group APIs support membership, rebalances, static membership, offset commits, group inspection and offset deletion. It also supports ApiVersions, InitProducerId and DescribeCluster."},"2323":{"id":"/docs/gateways/kafka-18","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#supported-operations","content":"Topic configuration changes support `retention.ms`. The gateway is not a complete Kafka broker implementation. Unsupported API keys and most unsupported versions close the connection. ApiVersions has a discovery error response for unsupported versions. Use the protocol coverage for exact API version ranges."},"2324":{"id":"/docs/gateways/kafka-19","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#supported-operations","content":"Kafka offsets identify the next record to read. The gateway stores externally managed group offsets in Iggy. These are separate from native Iggy consumer group membership. Deleting a Kafka topic deletes its backing Iggy topic, but retains the stream."},"2325":{"id":"/docs/gateways/kafka-20","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#delivery-and-durability","content":"Without gateway idempotence, delivery is at-least-once. A retry after an uncertain write can append records again. Set `IGGY_KAFKA_IDEMPOTENT_PRODUCERS=true` after every Iggy node, gateway and reader uses a compatible release. Idempotent batches then retain their producer ID, epoch and sequence through the gateway."},"2326":{"id":"/docs/gateways/kafka-21","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#delivery-and-durability","content":"Deduplication is bounded. Each partition retains five batches per producer and at most 4096 producers. It expires producers after 24 hours without writes. A retry outside retained history can duplicate a batch. Message IDs do not provide this guarantee."},"2327":{"id":"/docs/gateways/kafka-22","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#delivery-and-durability","content":"Transactions are unsupported. Transactional producer initialization and Produce requests are refused. Do not configure `transactional.id`."},"2328":{"id":"/docs/gateways/kafka-23","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#delivery-and-durability","content":"The Iggy topic's durability policy controls storage guarantees. The development stack uses `replicated`, so an acknowledgement does not prove stable-storage synchronization. Use `persisted` when acknowledged messages must survive loss of volatile copies. A named Docker volume alone does not strengthen an acknowledgement."},"2329":{"id":"/docs/gateways/kafka-24","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#authentication-and-authorization","content":"Listeners support `PLAINTEXT`, `SSL`, `SASL_PLAINTEXT` and `SASL_SSL`. SASL uses PLAIN against Iggy credentials. SSL listeners can map verified client certificates to Iggy users. Configure TLS for both the Kafka listener and the separate gateway-to-Iggy connection when both hops need encryption."},"2330":{"id":"/docs/gateways/kafka-25","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#authentication-and-authorization","content":"Data operations run as the bridge's Iggy account. Authentication does not provide complete per-principal data authorization in this release. In particular, CreateTopics does not yet apply the principal management gate. Other topic management operations and offset deletion add principal permission checks when the listener identifies a user. Do not expose an unauthenticated listener as a tenant-isolation boundary."},"2331":{"id":"/docs/gateways/kafka-26","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#authentication-and-authorization","content":"Configure `metadata.partitions_max` on Iggy to bound topic creation. Its default is zero, which means no cap. DescribeAcls presents Iggy permissions, but CreateAcls and DeleteAcls are not supported. The authentication reference describes the exact limits."},"2332":{"id":"/docs/gateways/kafka-27","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#listener-and-bridge-configuration","content":"| Variable               | Default          | Purpose                      |\n| ---------------------- | ---------------- | ---------------------------- |\n| `IGGY_KAFKA_BIND_ADDR` | `127.0.0.1:9093` | Single-listener bind address |","table":"table-0"},"2333":{"id":"/docs/gateways/kafka-28","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#listener-and-bridge-configuration","content":"| Variable                     | Default | Purpose                                                 |\n| ---------------------------- | ------- | ------------------------------------------------------- |\n| `IGGY_KAFKA_ADVERTISED_HOST` | Bind IP | Address clients can reach, required for a wildcard bind |","table":"table-0"},"2334":{"id":"/docs/gateways/kafka-29","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#listener-and-bridge-configuration","content":"| Variable                     | Default   | Purpose            |\n| ---------------------------- | --------- | ------------------ |\n| `IGGY_KAFKA_ADVERTISED_PORT` | Bind port | Client-facing port |","table":"table-0"},"2335":{"id":"/docs/gateways/kafka-30","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#listener-and-bridge-configuration","content":"| Variable               | Default | Purpose                                        |\n| ---------------------- | ------- | ---------------------------------------------- |\n| `IGGY_KAFKA_LISTENERS` | Unset   | Comma-separated `PROTOCOL://ip:port` listeners |","table":"table-0"},"2336":{"id":"/docs/gateways/kafka-31","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#listener-and-bridge-configuration","content":"| Variable                          | Default            | Purpose                                  |\n| --------------------------------- | ------------------ | ---------------------------------------- |\n| `IGGY_KAFKA_ADVERTISED_LISTENERS` | Listener addresses | Client-facing endpoint for each protocol |","table":"table-0"},"2337":{"id":"/docs/gateways/kafka-32","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#listener-and-bridge-configuration","content":"| Variable                     | Default | Purpose            |\n| ---------------------------- | ------- | ------------------ |\n| `IGGY_KAFKA_MAX_CONNECTIONS` | 1024    | Limit per listener |","table":"table-0"},"2338":{"id":"/docs/gateways/kafka-33","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#listener-and-bridge-configuration","content":"| Variable                    | Default | Purpose                    |\n| --------------------------- | ------- | -------------------------- |\n| `IGGY_KAFKA_MAX_FRAME_SIZE` | 8388608 | Request frame cap in bytes |","table":"table-0"},"2339":{"id":"/docs/gateways/kafka-34","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#listener-and-bridge-configuration","content":"| Variable                    | Default | Purpose             |\n| --------------------------- | ------- | ------------------- |\n| `IGGY_KAFKA_BRIDGE_ENABLED` | `false` | Enable Iggy storage |","table":"table-0"},"2340":{"id":"/docs/gateways/kafka-35","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#listener-and-bridge-configuration","content":"| Variable               | Default          | Purpose               |\n| ---------------------- | ---------------- | --------------------- |\n| `IGGY_KAFKA_IGGY_ADDR` | `127.0.0.1:8090` | Initial Iggy endpoint |","table":"table-0"},"2341":{"id":"/docs/gateways/kafka-36","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#listener-and-bridge-configuration","content":"| Variable                   | Default | Purpose        |\n| -------------------------- | ------- | -------------- |\n| `IGGY_KAFKA_IGGY_USERNAME` | `iggy`  | Bridge account |","table":"table-0"},"2342":{"id":"/docs/gateways/kafka-37","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#listener-and-bridge-configuration","content":"| Variable                   | Default  | Purpose         |\n| -------------------------- | -------- | --------------- |\n| `IGGY_KAFKA_IGGY_PASSWORD` | Required | Bridge password |","table":"table-0"},"2343":{"id":"/docs/gateways/kafka-38","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#listener-and-bridge-configuration","content":"| Variable                 | Default | Purpose        |\n| ------------------------ | ------- | -------------- |\n| `IGGY_KAFKA_IGGY_STREAM` | `kafka` | Default stream |","table":"table-0"},"2344":{"id":"/docs/gateways/kafka-39","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#listener-and-bridge-configuration","content":"| Variable                 | Default | Purpose                       |\n| ------------------------ | ------- | ----------------------------- |\n| `IGGY_KAFKA_FETCH_SLOTS` | 4       | Concurrent Iggy fetch clients |","table":"table-0"},"2345":{"id":"/docs/gateways/kafka-40","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#listener-and-bridge-configuration","content":"| Variable                      | Default | Purpose                                            |\n| ----------------------------- | ------- | -------------------------------------------------- |\n| `IGGY_KAFKA_PRODUCE_SESSIONS` | 256     | Dedicated producer clients. Zero shares one client |","table":"table-0"},"2346":{"id":"/docs/gateways/kafka-41","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#listener-and-bridge-configuration","content":"| Variable                          | Default | Purpose                              |\n| --------------------------------- | ------- | ------------------------------------ |\n| `IGGY_KAFKA_IDEMPOTENT_PRODUCERS` | `false` | Pass producer batch identity to Iggy |","table":"table-0"},"2347":{"id":"/docs/gateways/kafka-42","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#listener-and-bridge-configuration","content":"Do not mix `LISTENERS` with the single-listener advertised host/port or SASL toggle. Use matching `ADVERTISED_LISTENERS`. TLS needs `IGGY_KAFKA_TLS_CERT_FILE` and `IGGY_KAFKA_TLS_KEY_FILE`. The bridge hop uses `IGGY_KAFKA_IGGY_TLS_ENABLED`, `IGGY_KAFKA_IGGY_TLS_DOMAIN` and `IGGY_KAFKA_IGGY_TLS_CA_FILE`."},"2348":{"id":"/docs/gateways/kafka-43","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#listener-and-bridge-configuration","content":"The gateway configuration reference also lists timeouts, TLS reload, client-certificate mapping, authentication capacity and producer session expiry."},"2349":{"id":"/docs/gateways/kafka-44","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#run-several-gateways","content":"Give every gateway the same `IGGY_KAFKA_BROKERS` list and a unique `IGGY_KAFKA_NODE_ID`. Put each gateway beside an Iggy node and point its bridge at that node. Clients list multiple gateways in `bootstrap.servers`. Each gateway can route requests to any Iggy partition primary."},"2350":{"id":"/docs/gateways/kafka-45","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#run-several-gateways","content":"With the bridge and broker list configured, the shared coordinator log is enabled by default. It stores group generations, offset commits and deletions in Iggy. The bridge account needs `manage_servers` for metadata changes. Explicitly enabling the log with insufficient permissions stops startup. An implicitly enabled log can fall back with a warning, so inspect startup logs."},"2351":{"id":"/docs/gateways/kafka-46","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#run-several-gateways","content":"The coordinator log uses 16 partitions. The owner of partition zero is the controller for topic management. Other gateways return `NOT_CONTROLLER`, and the Kafka admin client follows it. After a gateway fails, another gateway takes over its assigned groups once the Iggy session expires and ownership moves."},"2352":{"id":"/docs/gateways/kafka-47","page_id":"/docs/gateways/kafka","tags":[],"type":"text","url":"/docs/gateways/kafka#run-several-gateways","content":"Use consistent coordinator-log configuration across gateways. With it disabled, the gateway with the lowest node ID coordinates all groups, and groups wait while it is down. See the multi-gateway deployment reference for permissions and takeover timing."},"2353":{"id":"/docs","page_id":"/docs","type":"page","content":"Welcome","breadcrumbs":["Documentation"],"tags":[],"url":"/docs"},"2354":{"id":"/docs-0","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Apache Iggy documentation: how Iggy organizes data into streams, topics, partitions and segments, and where to start."},"2355":{"id":"/docs-1","page_id":"/docs","type":"heading","tags":[],"url":"/docs#new-in-0100","content":"New in 0.10.0"},"2356":{"id":"/docs-2","page_id":"/docs","type":"heading","tags":[],"url":"/docs#how-iggy-organizes-data","content":"How Iggy organizes data"},"2357":{"id":"/docs-3","page_id":"/docs","type":"heading","tags":[],"url":"/docs#the-append-only-log","content":"The append-only log"},"2358":{"id":"/docs-4","page_id":"/docs","type":"heading","tags":[],"url":"/docs#key-capabilities","content":"Key capabilities"},"2359":{"id":"/docs-5","page_id":"/docs","type":"heading","tags":[],"url":"/docs#ecosystem","content":"Ecosystem"},"2360":{"id":"/docs-6","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"These docs describe Apache Iggy 0.10.0. The upgrade guide covers the coordinated cutover and fresh data directory. The 0.9 docs remain available."},"2361":{"id":"/docs-7","page_id":"/docs","tags":[],"type":"text","url":"/docs#new-in-0100","content":"Partitions distribute their primaries across cluster nodes. Topics can select their replication factor. Consumers can wait for messages and fetch several partitions in one request. Streams have separate encryption keys, and resource updates use set/reset patches."},"2362":{"id":"/docs-8","page_id":"/docs","tags":[],"type":"text","url":"/docs#new-in-0100","content":"Read about multi-leader partitions, deferred polling, stream options, idempotent producers, metadata changes, external authentication and the Kafka gateway."},"2363":{"id":"/docs-9","page_id":"/docs","tags":[],"type":"text","url":"/docs#how-iggy-organizes-data","content":"Iggy uses a hierarchical model: **streams** contain **topics**, topics contain **partitions**, and partitions store messages in **segments** on disk. This gives you flexible multi-tenancy, parallel processing, and efficient storage all in one."},"2364":{"id":"/docs-10","page_id":"/docs","tags":[],"type":"text","url":"/docs#the-append-only-log","content":"Every partition is an append-only log. Messages are **immutable** once written, consumers can start from a chosen offset, and retained messages can be replayed. Retention removes old data, and offsets can contain gaps."},"2365":{"id":"/docs-11","page_id":"/docs","tags":[],"type":"text","url":"/docs#key-capabilities","content":"| Capability    | Details                                                    |\n| ------------- | ---------------------------------------------------------- |\n| **Transport** | TCP, QUIC, WebSocket (custom binary protocol), HTTP (REST) |","table":"table-0"},"2366":{"id":"/docs-12","page_id":"/docs","tags":[],"type":"text","url":"/docs#key-capabilities","content":"| Capability      | Details                                                                                                         |\n| --------------- | --------------------------------------------------------------------------------------------------------------- |\n| **Performance** | Thread-per-core + io_uring on Linux, binary message views, configurable memory pool with a default 4 GiB budget |","table":"table-0"},"2367":{"id":"/docs-13","page_id":"/docs","tags":[],"type":"text","url":"/docs#key-capabilities","content":"| Capability   | Details                                                                                                                                 |\n| ------------ | --------------------------------------------------------------------------------------------------------------------------------------- |\n| **Security** | TLS on all transports, Argon2id hashing, AES-256-GCM-SIV encryption at rest, granular permissions with per-stream/per-topic permissions |","table":"table-0"},"2368":{"id":"/docs-14","page_id":"/docs","tags":[],"type":"text","url":"/docs#key-capabilities","content":"| Capability     | Details                                                                                                                         |\n| -------------- | ------------------------------------------------------------------------------------------------------------------------------- |\n| **Connectors** | 17 sink and 6 source plugins including PostgreSQL, MongoDB, Elasticsearch, ClickHouse, Apache Iceberg, S3, with data transforms |","table":"table-0"},"2369":{"id":"/docs-15","page_id":"/docs","tags":[],"type":"text","url":"/docs#key-capabilities","content":"| Capability         | Details                                                               |\n| ------------------ | --------------------------------------------------------------------- |\n| **AI Integration** | MCP server with 40+ tools for LLM-driven message streaming management |","table":"table-0"},"2370":{"id":"/docs-16","page_id":"/docs","tags":[],"type":"text","url":"/docs#key-capabilities","content":"| Capability     | Details                                                                                                                                          |\n| -------------- | ------------------------------------------------------------------------------------------------------------------------------------------------ |\n| **Management** | Web UI dashboard (embedded or standalone), CLI with shell completions, Prometheus metrics. Connector OpenTelemetry export (broker export limits) |","table":"table-0"},"2371":{"id":"/docs-17","page_id":"/docs","tags":[],"type":"text","url":"/docs#key-capabilities","content":"| Capability     | Details                                                                                                            |\n| -------------- | ------------------------------------------------------------------------------------------------------------------ |\n| **Clustering** | Built on Viewstamped Replication (VSR) consensus. Single node by default, multi-node via `[cluster]` configuration |","table":"table-0"},"2372":{"id":"/docs-18","page_id":"/docs","tags":[],"type":"text","url":"/docs#key-capabilities","content":"| Capability     | Details                                                                       |\n| -------------- | ----------------------------------------------------------------------------- |\n| **Deployment** | Single server process, Docker & Helm, configurable CPU/NUMA affinity on Linux |","table":"table-0"},"2373":{"id":"/docs-19","page_id":"/docs","tags":[],"type":"text","url":"/docs#ecosystem","content":"Iggy is more than just a server. The project includes a full ecosystem of tools:"},"2374":{"id":"/docs-20","page_id":"/docs","tags":[],"type":"text","url":"/docs#ecosystem","content":"**Connectors Runtime** - dynamically loaded Rust plugins for data integration: 17 sinks and 6 sources. Ingest from PostgreSQL, Elasticsearch or InfluxDB into Iggy, or forward to MongoDB, Elasticsearch, ClickHouse, Apache Iceberg, Quickwit, S3 and more. Built-in data transforms and Prometheus metrics."},"2375":{"id":"/docs-21","page_id":"/docs","tags":[],"type":"text","url":"/docs#ecosystem","content":"**MCP Server** - Model Context Protocol server exposing 40+ tools for LLM integration. Works with Claude Desktop via stdio and HTTP transports."},"2376":{"id":"/docs-22","page_id":"/docs","tags":[],"type":"text","url":"/docs#ecosystem","content":"**Web UI** - SvelteKit dashboard for stream/topic management, message browsing with JSON/string/XML decoders, and user management."},"2377":{"id":"/docs-23","page_id":"/docs","tags":[],"type":"text","url":"/docs#ecosystem","content":"**CLI** - full-featured command-line interface with named connection contexts, session-based login, and shell completions."},"2378":{"id":"/docs-24","page_id":"/docs","tags":[],"type":"text","url":"/docs#ecosystem","content":"**SDKs** - client libraries for 9 languages (Rust, Python, Java, Go, Node.js, C#, C++, PHP, Swift), most with runnable examples."},"2379":{"id":"/docs-25","page_id":"/docs","tags":[],"type":"text","url":"/docs#ecosystem","content":"**Benchmarking** - built-in `iggy-bench` tool with a Yew/WebAssembly dashboard for performance testing."},"2380":{"id":"/docs/introduction/about","page_id":"/docs/introduction/about","type":"page","content":"About","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/about"},"2381":{"id":"/docs/introduction/about-0","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about","content":"What Apache Iggy is: a persistent message streaming platform written in Rust, with QUIC, TCP, WebSocket and HTTP transports."},"2382":{"id":"/docs/introduction/about-1","page_id":"/docs/introduction/about","type":"heading","tags":[],"url":"/docs/introduction/about#features","content":"Features"},"2383":{"id":"/docs/introduction/about-2","page_id":"/docs/introduction/about","type":"heading","tags":[],"url":"/docs/introduction/about#supported-languages-sdk","content":"Supported languages SDK"},"2384":{"id":"/docs/introduction/about-3","page_id":"/docs/introduction/about","type":"heading","tags":[],"url":"/docs/introduction/about#cli","content":"CLI"},"2385":{"id":"/docs/introduction/about-4","page_id":"/docs/introduction/about","type":"heading","tags":[],"url":"/docs/introduction/about#web-ui","content":"Web UI"},"2386":{"id":"/docs/introduction/about-5","page_id":"/docs/introduction/about","type":"heading","tags":[],"url":"/docs/introduction/about#connectors","content":"Connectors"},"2387":{"id":"/docs/introduction/about-6","page_id":"/docs/introduction/about","type":"heading","tags":[],"url":"/docs/introduction/about#model-context-protocol","content":"Model Context Protocol"},"2388":{"id":"/docs/introduction/about-7","page_id":"/docs/introduction/about","type":"heading","tags":[],"url":"/docs/introduction/about#docker","content":"Docker"},"2389":{"id":"/docs/introduction/about-8","page_id":"/docs/introduction/about","type":"heading","tags":[],"url":"/docs/introduction/about#helm-charts","content":"Helm Charts"},"2390":{"id":"/docs/introduction/about-9","page_id":"/docs/introduction/about","type":"heading","tags":[],"url":"/docs/introduction/about#versioning","content":"Versioning"},"2391":{"id":"/docs/introduction/about-10","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about","content":"**Iggy** is a persistent message streaming platform written in Rust, supporting QUIC, TCP, WebSocket (custom binary specification) and HTTP (regular REST API) transport protocols, **capable of processing millions of messages per second at ultra-low latency**."},"2392":{"id":"/docs/introduction/about-11","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about","content":"Iggy provides **exceptionally high throughput and performance** while utilizing minimal computing resources."},"2393":{"id":"/docs/introduction/about-12","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about","content":"This is **not yet another extension** running on top of existing infrastructure, such as Kafka or SQL database."},"2394":{"id":"/docs/introduction/about-13","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about","content":"Iggy is a persistent message streaming log **built from the ground up** using low-level I/O with **thread-per-core shared nothing architecture**, `io_uring` and `compio` for maximum speed and efficiency."},"2395":{"id":"/docs/introduction/about-14","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about","content":"The name is an abbreviation for the Italian Greyhound - small yet extremely fast dogs, the best in their class. See the lovely Fabio & Cookie ❤️"},"2396":{"id":"/docs/introduction/about-15","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about","content":"Historical startup screenshot from server 0.5.0. See configuration for the 0.10.0 settings."},"2397":{"id":"/docs/introduction/about-16","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"**Highly performant**, persistent append-only log for message streaming"},"2398":{"id":"/docs/introduction/about-17","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"**Very high throughput** for both writes and reads"},"2399":{"id":"/docs/introduction/about-18","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"**Low latency and predictable resource usage** thanks to the Rust compiled language (no GC) and `io_uring`"},"2400":{"id":"/docs/introduction/about-19","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"**Thread per core shared nothing design** together with `io_uring` guarantee the best possible performance on modern `Linux` systems"},"2401":{"id":"/docs/introduction/about-20","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"**NUMA-aware sharding** with CPU affinity and memory binding per NUMA node for optimal hardware utilization"},"2402":{"id":"/docs/introduction/about-21","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"**User authentication and authorization** with granular permissions, Personal Access Tokens (PAT) and Argon2id password hashing"},"2403":{"id":"/docs/introduction/about-22","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Support for multiple streams, topics and partitions"},"2404":{"id":"/docs/introduction/about-23","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Support for **multiple transport protocols** (QUIC, TCP, WebSocket, HTTP)"},"2405":{"id":"/docs/introduction/about-24","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Fully operational RESTful API which can be optionally enabled"},"2406":{"id":"/docs/introduction/about-25","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Available client SDK in multiple languages"},"2407":{"id":"/docs/introduction/about-26","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"**Works directly with binary data**, avoiding enforced schema and serialization/deserialization overhead"},"2408":{"id":"/docs/introduction/about-27","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Custom **zero-copy (de)serialization**, which greatly improves the performance and reduces memory usage"},"2409":{"id":"/docs/introduction/about-28","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"**Custom memory pool** with 28 buckets (buffer sizes from 4 KiB to 512 MiB) for on-demand allocation, buffer reuse and sharing without copying buffer contents"},"2410":{"id":"/docs/introduction/about-29","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Configurable server features (e.g. caching and transport protocols), plus per-topic segment size, durability and flush thresholds"},"2411":{"id":"/docs/introduction/about-30","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Server-side storage of **consumer offsets**"},"2412":{"id":"/docs/introduction/about-31","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Multiple ways of polling the messages:"},"2413":{"id":"/docs/introduction/about-32","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"By offset (using the indexes)"},"2414":{"id":"/docs/introduction/about-33","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"By timestamp (using the time indexes)"},"2415":{"id":"/docs/introduction/about-34","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"First/Last N messages"},"2416":{"id":"/docs/introduction/about-35","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Next N messages for the specific consumer"},"2417":{"id":"/docs/introduction/about-36","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Optional **poll auto-commit**, with processing and failure semantics explained in concepts"},"2418":{"id":"/docs/introduction/about-37","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"**Consumer groups** distributing partitions across connected clients for horizontal scaling. Ordering is per partition, with cooperative partition rebalancing"},"2419":{"id":"/docs/introduction/about-38","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"**Message expiry** with auto deletion based on the configurable **retention policy**"},"2420":{"id":"/docs/introduction/about-39","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"**Multi-tenant** support via abstraction of **streams** which group **topics**"},"2421":{"id":"/docs/introduction/about-40","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"**TLS** support for all transport protocols (TCP, QUIC, WebSocket, HTTPS)"},"2422":{"id":"/docs/introduction/about-41","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"**Connectors** - sinks, sources and data transformations based on the **custom Rust plugins** loaded dynamically at runtime"},"2423":{"id":"/docs/introduction/about-42","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"**Model Context Protocol** - provide context to LLM with **MCP server** exposing 40+ tools for streaming management"},"2424":{"id":"/docs/introduction/about-43","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Optional **data encryption**: server-side at rest with AES-256-GCM-SIV, and client-side with AES-256-GCM"},"2425":{"id":"/docs/introduction/about-44","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Optional metadata support in the form of **message headers**"},"2426":{"id":"/docs/introduction/about-45","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Prometheus metrics and **OpenTelemetry** logs & traces in the connector runtime. Server export has known limitations."},"2427":{"id":"/docs/introduction/about-46","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Built-in **CLI** to manage the streaming server installable via `cargo install iggy-cli --version 0.15.0 --locked`"},"2428":{"id":"/docs/introduction/about-47","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Built-in **Web UI** dashboard (Svelte) that can be embedded directly in the server binary or run as a standalone container"},"2429":{"id":"/docs/introduction/about-48","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Built-in **benchmarking app** to test the performance, with published results on the benchmarks dashboard"},"2430":{"id":"/docs/introduction/about-49","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"**Single binary deployment** without an external broker or database. Operating-system libraries are still required by dynamically linked builds"},"2431":{"id":"/docs/introduction/about-50","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"**Accept-time connection distribution** for plaintext TCP and WebSocket across shards via file descriptor transfer"},"2432":{"id":"/docs/introduction/about-51","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Built on **Viewstamped Replication (VSR)** consensus: runs as a single node by default, with multi-node clustering available via the `[cluster]` configuration"},"2433":{"id":"/docs/introduction/about-52","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"| Language | Package | Registry  |\n| -------- | ------- | --------- |\n| Rust     | iggy    | crates.io |","table":"table-0"},"2434":{"id":"/docs/introduction/about-53","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"| Language | Package     | Registry |\n| -------- | ----------- | -------- |\n| C#       | Apache.Iggy | NuGet    |","table":"table-0"},"2435":{"id":"/docs/introduction/about-54","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"| Language | Package | Registry      |\n| -------- | ------- | ------------- |\n| Java     | iggy    | Maven Central |","table":"table-0"},"2436":{"id":"/docs/introduction/about-55","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"| Language | Package     | Registry |\n| -------- | ----------- | -------- |\n| Python   | apache-iggy | PyPI     |","table":"table-0"},"2437":{"id":"/docs/introduction/about-56","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"| Language | Package     | Registry |\n| -------- | ----------- | -------- |\n| Node.js  | apache-iggy | npm      |","table":"table-0"},"2438":{"id":"/docs/introduction/about-57","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"| Language | Package | Registry   |\n| -------- | ------- | ---------- |\n| Go       | iggy-go | pkg.go.dev |","table":"table-0"},"2439":{"id":"/docs/introduction/about-58","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"| Language | Package         | Registry              |\n| -------- | --------------- | --------------------- |\n| PHP      | apache/iggy-php | GitHub (source build) |","table":"table-0"},"2440":{"id":"/docs/introduction/about-59","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"| Language | Package  | Registry       |\n| -------- | -------- | -------------- |\n| C++      | iggy-cpp | Source archive |","table":"table-0"},"2441":{"id":"/docs/introduction/about-60","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"| Swift | Iggy | Swift Package Manager |"},"2442":{"id":"/docs/introduction/about-61","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#cli","content":"The interactive CLI is implemented under `core/cli`, to provide the best developer experience. This is a great addition to the Web UI, especially for developers who prefer using the console tools."},"2443":{"id":"/docs/introduction/about-62","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#cli","content":"Iggy CLI can be installed with `cargo install iggy-cli --version 0.15.0 --locked` and then simply accessed by typing `iggy` in your terminal. It supports named connection contexts (profiles) for managing multiple server connections, shell completions for bash/zsh/fish/elvish/powershell, and session-based login through platform credential stores on Linux, macOS and Windows when the default `login-session` feature is enabled."},"2444":{"id":"/docs/introduction/about-63","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#web-ui","content":"The Web UI provides a comprehensive dashboard for the Iggy server, built with SvelteKit and TypeScript. It can run in two modes:"},"2445":{"id":"/docs/introduction/about-64","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#web-ui","content":"**Embedded** - compiled into the server binary (with the `iggy-web` feature and built static assets), served at the `/ui` endpoint when `http.web_ui = true`"},"2446":{"id":"/docs/introduction/about-65","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#web-ui","content":"**Standalone** - as a separate container via `docker pull apache/iggy-web-ui:0.5.0`"},"2447":{"id":"/docs/introduction/about-66","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#web-ui","content":"Features include stream/topic/partition management, a message browser with JSON/string/XML decoders, and user listing and creation with initial permissions. Editing or deleting existing users and changing their permissions are placeholders. The logs and terminal pages are also placeholders, and the server settings page has a disabled Save action rather than an operational configuration editor."},"2448":{"id":"/docs/introduction/about-67","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#connectors","content":"Iggy provides a highly performant and modular **runtime** for statically typed, yet dynamically loaded connectors. You can ingest data from external sources and push the data to Iggy streams, or fetch data from Iggy streams and forward it to external systems. **Create your own Rust plugins** by simply implementing either the `Source` or `Sink` trait and **build custom pipelines for the data processing**."},"2449":{"id":"/docs/introduction/about-68","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#connectors","content":"The source tree contains 17 sinks and 6 sources. Sinks include PostgreSQL, MongoDB, Elasticsearch, ClickHouse, InfluxDB, Apache Iceberg, Delta Lake, Quickwit and S3. Sources include PostgreSQL, Elasticsearch, InfluxDB, HTTP, MQTT and random data generation. See the connectors documentation for the full catalog."},"2450":{"id":"/docs/introduction/about-69","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#connectors","content":"The docker image is available, and can be fetched via `docker pull apache/iggy-connect:0.6.0`."},"2451":{"id":"/docs/introduction/about-70","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#model-context-protocol","content":"The Model Context Protocol (MCP) is an open protocol that standardizes how applications provide context to LLMs. The **Iggy MCP Server** is an implementation of the MCP protocol for message streaming infrastructure. It exposes 40+ tools covering streams, topics, partitions, messages, consumer groups, users, and more. It supports both HTTP and stdio transports, making it compatible with tools like Claude Desktop and other MCP clients."},"2452":{"id":"/docs/introduction/about-71","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#model-context-protocol","content":"The docker image is available, and can be fetched via `docker pull apache/iggy-mcp:0.6.0`."},"2453":{"id":"/docs/introduction/about-72","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"The official Apache Iggy images can be found on Docker Hub. These docs target server 0.10.0. Use `docker pull apache/iggy:0.10.0`, or `docker pull apache/iggy:edge` for a development image. SDK and tooling versions are independent of the server version."},"2454":{"id":"/docs/introduction/about-73","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"You can also find the images for all the different tooling such as Connectors, MCP Server etc. here."},"2455":{"id":"/docs/introduction/about-74","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"Please note that the images tagged as `latest` are based on the official, stable releases, while the `edge` ones are updated directly from latest version of the `master` branch."},"2456":{"id":"/docs/introduction/about-75","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"You can find the development `Dockerfile` and `docker-compose.yml` in the root of the repository. Published server images use `core/server/Dockerfile`. To build and start the server, run: `docker compose up`."},"2457":{"id":"/docs/introduction/about-76","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"For the root Compose build, run the included CLI with `docker exec -it iggy-server /iggy`. In published images, its path is `/usr/local/bin/iggy`."},"2458":{"id":"/docs/introduction/about-77","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"Keep in mind that running the container on operating systems other than Linux, where the Docker is running in the VM, might result in the performance degradation."},"2459":{"id":"/docs/introduction/about-78","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"Also, when running the container, **make sure to include the additional capabilities**, as you can find in docker-compose file:"},"2460":{"id":"/docs/introduction/about-79","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"Or when running with `docker run`:"},"2461":{"id":"/docs/introduction/about-80","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#helm-charts","content":"Helm charts for Kubernetes deployment are available in the repository. The chart includes templates for Deployment, Service, ServiceAccount, Ingress, PersistentVolumeClaim, ServiceMonitor (for Prometheus), and root user credentials Secret."},"2462":{"id":"/docs/introduction/about-81","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#versioning","content":"The official releases follow the regular semver (`0.5.0`) or have a `latest` tag applied (`apache/iggy:latest`)."},"2463":{"id":"/docs/introduction/about-82","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#versioning","content":"We also publish edge/dev/nightly releases (e.g. `0.6.0-edge.1` or `apache/iggy:edge`), for both SDKs and the Docker images. These are typically compatible with the latest changes but are not guaranteed to be stable and, as the name suggests, are not recommended for production use."},"2464":{"id":"/docs/introduction/architecture","page_id":"/docs/introduction/architecture","type":"page","content":"Architecture","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/architecture"},"2465":{"id":"/docs/introduction/architecture-0","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture","content":"Inside the Iggy server: how work is scheduled across cores, how requests are routed, and how a message reaches disk."},"2466":{"id":"/docs/introduction/architecture-1","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#how-a-message-flows-through-iggy","content":"How a message flows through Iggy"},"2467":{"id":"/docs/introduction/architecture-2","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#thread-per-core-shared-nothing--io_uring","content":"Thread per core (shared nothing) + io_uring"},"2468":{"id":"/docs/introduction/architecture-3","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#how-it-works","content":"How it works"},"2469":{"id":"/docs/introduction/architecture-4","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#shard-roles-and-connection-distribution","content":"Shard roles and connection distribution"},"2470":{"id":"/docs/introduction/architecture-5","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#request-routing","content":"Request routing"},"2471":{"id":"/docs/introduction/architecture-6","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#iggynamespace","content":"IggyNamespace"},"2472":{"id":"/docs/introduction/architecture-7","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#cpu-allocation-modes","content":"CPU allocation modes"},"2473":{"id":"/docs/introduction/architecture-8","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#io_uring-and-compio","content":"io_uring and compio"},"2474":{"id":"/docs/introduction/architecture-9","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#performance-tokio-vs-thread-per-core","content":"Performance: Tokio vs Thread-per-Core"},"2475":{"id":"/docs/introduction/architecture-10","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#left-right-metadata","content":"Left-right metadata"},"2476":{"id":"/docs/introduction/architecture-11","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#clustering","content":"Clustering"},"2477":{"id":"/docs/introduction/architecture-12","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#storage-structure","content":"Storage structure"},"2478":{"id":"/docs/introduction/architecture-13","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#memory-pool","content":"Memory pool"},"2479":{"id":"/docs/introduction/architecture-14","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#write-pipeline","content":"Write pipeline"},"2480":{"id":"/docs/introduction/architecture-15","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture","content":"This page covers the internals of the Iggy server: how work is scheduled across CPU cores, how requests are routed, and how data ends up on disk. If you're looking for the domain model (streams, topics, partitions, consumer groups, message format), see concepts first."},"2481":{"id":"/docs/introduction/architecture-16","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#how-a-message-flows-through-iggy","content":"Before diving into the architecture details, here's an overview of a message's journey from client to disk:"},"2482":{"id":"/docs/introduction/architecture-17","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#thread-per-core-shared-nothing--io_uring","content":"Iggy uses a **thread-per-core shared nothing architecture** combined with `io_uring` for maximum performance. This design has been proven by systems like ScyllaDB and Redpanda, both built on the Seastar framework."},"2483":{"id":"/docs/introduction/architecture-18","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#how-it-works","content":"Each configured **shard** (an instance of `IggyShard`) has its own single-threaded `compio` async runtime. With `pin_cores = true`, Linux shard threads are pinned to their selected CPUs via `sched_setaffinity`. NUMA allocation modes also bind memory via `hwlocality`. Setting `pin_cores = false` disables both bindings. Shared metadata and inter-shard communication still require synchronization."},"2484":{"id":"/docs/introduction/architecture-19","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#shard-roles-and-connection-distribution","content":"Shard 0 has a special role: it binds **every listener** - the replica plane and all client transports (TCP, QUIC, WebSocket, HTTP). Connections are then spread across shards at accept time:"},"2485":{"id":"/docs/introduction/architecture-20","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#shard-roles-and-connection-distribution","content":"**TCP and WebSocket** connections, plaintext or TLS, are handed off round-robin across the shards. Shard 0's coordinator duplicates the socket's file descriptor, ships a connection-setup frame to the target shard, and drops its own handle, so the owning shard serves the connection from then on - before a single byte is read. For TLS-wrapped TCP and secure WebSocket (WSS), the target shard runs the TLS handshake. Shard 0 is part of the rotation by default. `skip_shard_zero_for_clients = true` under `[cluster.coordinator]` takes it out."},"2486":{"id":"/docs/introduction/architecture-21","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#shard-roles-and-connection-distribution","content":"**QUIC** connections stay on shard 0, installed through its UDP endpoint. HTTP is also served on shard 0."},"2487":{"id":"/docs/introduction/architecture-22","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#shard-roles-and-connection-distribution","content":"All shards, **including shard 0**, own partitions and serve partition requests."},"2488":{"id":"/docs/introduction/architecture-23","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#request-routing","content":"Requests are routed between shards using **message passing** (via `crossfire` bounded mpsc channels), so partition state remains on its owning shard. The routing logic splits operations into two planes:"},"2489":{"id":"/docs/introduction/architecture-24","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#request-routing","content":"**Metadata operations** (create/delete stream/topic/user etc.) always execute on **shard 0** - it is the only shard that commits metadata"},"2490":{"id":"/docs/introduction/architecture-25","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#request-routing","content":"**Partition operations** (send_messages, poll_messages, store_consumer_offset) are routed to the shard owning that partition via a lock-free concurrent map lookup. The request is sent into the owning shard's channel, whichever shard received it"},"2491":{"id":"/docs/introduction/architecture-26","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#request-routing","content":"Partition-to-shard assignment is **deterministic**: the packed `IggyNamespace` is hashed with `Murmur3`, and the upper 16 bits of the hash are taken modulo the shard count (the upper bits are used because Murmur3 has weak lower bits for small integer inputs)."},"2492":{"id":"/docs/introduction/architecture-27","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#request-routing","content":"Across nodes, the SDK uses a partition route before this shard-local dispatch. Partition primaries are distributed across eligible nodes and rebalanced by the metadata primary. Each topic selects its own replication factor at creation. See Multi-leader partitions."},"2493":{"id":"/docs/introduction/architecture-28","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#iggynamespace","content":"The `IggyNamespace` packs stream_id (20 bits), topic_id (12 bits), and partition_id (20 bits) into a single `u64` for efficient hashing and routing. This gives maximums of 1,048,576 streams, 4096 topics per stream, and 1,000,000 partitions per topic."},"2494":{"id":"/docs/introduction/architecture-29","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#cpu-allocation-modes","content":"The sharding system supports multiple allocation modes via the `cpu_allocation` config:"},"2495":{"id":"/docs/introduction/architecture-30","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#cpu-allocation-modes","content":"`\"all\"` - one shard per available CPU core"},"2496":{"id":"/docs/introduction/architecture-31","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#cpu-allocation-modes","content":"A numeric value (e.g. `4`) - exactly N shards, pinned to the first N CPUs in the process's allowed CPU set when pinning is enabled"},"2497":{"id":"/docs/introduction/architecture-32","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#cpu-allocation-modes","content":"A range (e.g. `\"5..8\"`) - shards on CPUs 5, 6 and 7 when pinning is enabled. Those CPUs must be allowed for the process"},"2498":{"id":"/docs/introduction/architecture-33","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#cpu-allocation-modes","content":"`\"numa:auto\"` - automatically detect NUMA topology and select physical cores, avoiding sibling hyperthreads"},"2499":{"id":"/docs/introduction/architecture-34","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#cpu-allocation-modes","content":"`\"numa:nodes=0,1;cores=4;no_ht=true\"` - explicit NUMA nodes, with the same number of cores taken from each listed node and hyperthread avoidance"},"2500":{"id":"/docs/introduction/architecture-35","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"Traditional async runtimes like tokio use `epoll` which is **readiness-based** - you ask the kernel \"is this file descriptor ready?\" and then perform the I/O yourself. Regular files cannot be registered with epoll. Tokio runs file I/O on a blocking thread pool that grows on demand (up to 512 threads by default, configurable). This does not scale well."},"2501":{"id":"/docs/introduction/architecture-36","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"`io_uring` is **completion-based** - you submit I/O requests to a submission queue (SQ), and the kernel completes them and places results in a completion queue (CQ). Both queues are shared ring buffers between user space and kernel. Submissions and completions can be batched to reduce syscalls. This is fundamentally better for disk I/O."},"2502":{"id":"/docs/introduction/architecture-37","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"Iggy uses **compio** as its async runtime, which provides a driver-disaggregated architecture on top of io_uring (Linux) and IOCP (Windows). Each shard gets its own compio executor configured with:"},"2503":{"id":"/docs/introduction/architecture-38","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"Capacity: an io_uring submission queue of 4096 entries (by default)"},"2504":{"id":"/docs/introduction/architecture-39","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"Event interval: poll the I/O driver after 128 scheduler ticks (roughly task polls) by default"},"2505":{"id":"/docs/introduction/architecture-40","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"Cooperative task running enabled"},"2506":{"id":"/docs/introduction/architecture-41","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"`IGGY_SHARD_RUNTIME_CAPACITY` and `IGGY_SHARD_EVENT_INTERVAL` override the two numeric defaults. On macOS, compio uses its polling driver and a blocking pool for file I/O."},"2507":{"id":"/docs/introduction/architecture-42","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#performance-tokio-vs-thread-per-core","content":"The historical migration benchmarks compared v0.5.0 with v0.7.0 at approximately 1,000 MB/s per node. The chart shows selected latency reductions for 8, 16 and 32 producers, each using its own stream. The 8-producer case also reported higher P95 and P99 latency. These are not measurements of 0.10.0:"},"2508":{"id":"/docs/introduction/architecture-43","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#left-right-metadata","content":"Shared metadata (streams, topics, consumer groups) uses a **left-right** concurrent data structure. Shard 0 holds the single write handle and is the only shard that commits metadata mutations, while every shard holds a read handle. This provides:"},"2509":{"id":"/docs/introduction/architecture-44","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#left-right-metadata","content":"Lock-free reads on all shards (no contention on the hot path)"},"2510":{"id":"/docs/introduction/architecture-45","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#left-right-metadata","content":"Strongly consistent writes serialized through shard 0"},"2511":{"id":"/docs/introduction/architecture-46","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#clustering","content":"The server is built on the **Viewstamped Replication (VSR)** consensus protocol. Metadata operations are committed through the VSR write-ahead log **even on a single node**, which is the default deployment. Multi-node clustering is enabled via the `[cluster]` configuration (a node roster plus `--replica-id` to pick the local entry). See clustering for the details and maturity caveats."},"2512":{"id":"/docs/introduction/architecture-47","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#storage-structure","content":"Having in mind that stream consists of topics, which might have one or more partitions assigned, and each partition consists of segments, we can visualize the structure of the Iggy data directory as follows:"},"2513":{"id":"/docs/introduction/architecture-48","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#storage-structure","content":"This example shows a fresh partition with the default paths. The stream, topic and partition directories are named after their numeric IDs, **assigned from 0**. The `metadata/journal.wal` file is the VSR write-ahead log for metadata operations (stream/topic/user creation, etc.). Its index has 1024 slots by default (`journal_slots` under `[metadata]`). Before they run out, the server checkpoints the metadata into `metadata/snapshot.bin`, records the checkpoint in a superblock under `metadata/`, and drops the checkpointed operations from the log. Root initialization is recorded through metadata replication, and startup checks that journal or checkpoint state proves initialization. The `runtime/current_config.toml` file is rewritten at every boot with the configuration the server booted with and the addresses it actually bound. Secrets (the JWT secrets, the encryption key and the cluster shared secret) are left out. The `state/log` file is empty. The server creates it at boot and does not otherwise use it. Segment files are named by their 20-digit start offset. Recovery can create an empty active segment at a reserved offset beyond the last stored message. Partition superblocks record the recovery frontiers. A superblock is written to two files in turn, `superblock.a` and `superblock.b`. A fresh partition has only `superblock.a`. `superblock.b` appears at the next superblock write, for example after a later persistence operation. The `.index` file is created automatically and speeds up searches by keeping track of the offsets and timestamps of the records. The `offsets/` directory holds the server-side consumer and consumer group offsets."},"2514":{"id":"/docs/introduction/architecture-49","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#memory-pool","content":"Iggy uses a custom memory pool with 28 buckets holding buffer sizes from 4 KiB to 512 MiB. The default pool size is 4 GiB with up to 8192 buffers per bucket. Buffers are allocated on demand and reused. Requests that exceed the pool budget can allocate outside it. Frozen buffers can be shared between components without copying their contents. The pool is page-aligned (4096-byte multiples) and requires a **minimum of 512 MiB**."},"2515":{"id":"/docs/introduction/architecture-50","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"Messages flow through a multi-stage write pipeline:"},"2516":{"id":"/docs/introduction/architecture-51","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"Messages arrive on the owning shard and are buffered in the partition journal."},"2517":{"id":"/docs/introduction/architecture-52","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"Partition VSR replicates prepares. With `durability=persisted`, a multi-replica group requires recoverable prepare-WAL copies at the replication quorum before commit."},"2518":{"id":"/docs/introduction/architecture-53","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"Awaited writes apply committed operations before success is returned. A singleton with `durability=persisted` synchronizes local segment state before replying."},"2519":{"id":"/docs/introduction/architecture-54","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"Ordinary segment writes use per-topic count and byte thresholds (defaults: 1024 messages, 1 MiB). Required persistence, capacity pressure, and lifecycle work can flush earlier. The `MessagesWriter` uses **vectored I/O** in chunks of up to 1024 buffers. Partial writes can require more than one I/O submission."},"2520":{"id":"/docs/introduction/architecture-55","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"When a segment reaches or passes the topic's segment size (default 1 GiB), it is **sealed** and a new segment is created. The batch that crosses the size is written whole, so a sealed segment can exceed it by up to one batch."},"2521":{"id":"/docs/introduction/architecture-56","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"Message `durability` and `consumer_offset_durability` default independently to `replicated`. Both policies write data to disk. `persisted` adds a stable-storage requirement at completion. See Durability."},"2522":{"id":"/docs/introduction/coming-from-kafka","page_id":"/docs/introduction/coming-from-kafka","type":"page","content":"Coming from Apache Kafka","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/coming-from-kafka"},"2523":{"id":"/docs/introduction/coming-from-kafka-0","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka","content":"How Apache Kafka's topics, partitions, consumer groups and offsets map to Apache Iggy, and what works differently."},"2524":{"id":"/docs/introduction/coming-from-kafka-1","page_id":"/docs/introduction/coming-from-kafka","type":"heading","tags":[],"url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"How the terms map"},"2525":{"id":"/docs/introduction/coming-from-kafka-2","page_id":"/docs/introduction/coming-from-kafka","type":"heading","tags":[],"url":"/docs/introduction/coming-from-kafka#what-works-differently","content":"What works differently"},"2526":{"id":"/docs/introduction/coming-from-kafka-3","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka","content":"If you already know Apache Kafka, most of Apache Iggy will feel familiar. This page maps the Kafka terms you know to Iggy's and lists what works differently. For when to choose one or the other, see Apache Iggy or Apache Kafka."},"2527":{"id":"/docs/introduction/coming-from-kafka-4","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"| Kafka         | Iggy   | What to know                                                                                                                  |\n| ------------- | ------ | ----------------------------------------------------------------------------------------------------------------------------- |\n| No equivalent | Stream | A container for related topics. For example, a `dev` stream and a `production` stream can each have their own `orders` topic. |","table":"table-0"},"2528":{"id":"/docs/introduction/coming-from-kafka-5","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"| Kafka | Iggy  | What to know           |\n| ----- | ----- | ---------------------- |\n| Topic | Topic | Belongs to one stream. |","table":"table-0"},"2529":{"id":"/docs/introduction/coming-from-kafka-6","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"| Kafka     | Iggy      | What to know                            |\n| --------- | --------- | --------------------------------------- |\n| Partition | Partition | Where messages are stored, as in Kafka. |","table":"table-0"},"2530":{"id":"/docs/introduction/coming-from-kafka-7","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"| Kafka          | Iggy           | What to know                                                                                          |\n| -------------- | -------------- | ----------------------------------------------------------------------------------------------------- |\n| Consumer group | Consumer group | Each partition goes to one member of the group, and the server rebalances when members join or leave. |","table":"table-0"},"2531":{"id":"/docs/introduction/coming-from-kafka-8","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"| Kafka  | Iggy   | What to know                                                          |\n| ------ | ------ | --------------------------------------------------------------------- |\n| Offset | Offset | Starts at 0 in each partition, but can skip numbers after a recovery. |","table":"table-0"},"2532":{"id":"/docs/introduction/coming-from-kafka-9","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"| Kafka     | Iggy             | What to know                                                                    |\n| --------- | ---------------- | ------------------------------------------------------------------------------- |\n| Retention | Retention policy | Set per topic. Whole segments are deleted once all their messages have expired. |","table":"table-0"},"2533":{"id":"/docs/introduction/coming-from-kafka-10","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Concepts explains each of these in more detail."},"2534":{"id":"/docs/introduction/coming-from-kafka-11","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#what-works-differently","content":"Iggy has its own protocol, and the Kafka gateway serves Kafka producers, consumers and supported admin APIs. Run it as a separate service with the Iggy bridge enabled. The gateway has a defined API subset and does not support transactions. Native applications can use an Iggy SDK or the HTTP API."},"2535":{"id":"/docs/introduction/coming-from-kafka-12","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#what-works-differently","content":"**There is an extra level above topics.** Every topic lives in a stream, so you create a stream before you create its topics."},"2536":{"id":"/docs/introduction/concepts","page_id":"/docs/introduction/concepts","type":"page","content":"Concepts","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/concepts"},"2537":{"id":"/docs/introduction/concepts-0","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts","content":"The domain model behind Iggy, and how an append-only streaming log differs from a message broker."},"2538":{"id":"/docs/introduction/concepts-1","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#message-streaming","content":"Message streaming"},"2539":{"id":"/docs/introduction/concepts-2","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#append-only-log","content":"Append-only log"},"2540":{"id":"/docs/introduction/concepts-3","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#stream","content":"Stream"},"2541":{"id":"/docs/introduction/concepts-4","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#topic","content":"Topic"},"2542":{"id":"/docs/introduction/concepts-5","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#partition","content":"Partition"},"2543":{"id":"/docs/introduction/concepts-6","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#segment","content":"Segment"},"2544":{"id":"/docs/introduction/concepts-7","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#polling-messages","content":"Polling messages"},"2545":{"id":"/docs/introduction/concepts-8","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#consumer-groups","content":"Consumer groups"},"2546":{"id":"/docs/introduction/concepts-9","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#message-format","content":"Message format"},"2547":{"id":"/docs/introduction/concepts-10","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#primaries-copies-and-checkpoints","content":"Primaries, copies and checkpoints"},"2548":{"id":"/docs/introduction/concepts-11","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts","content":"Iggy is a persistent message streaming platform: messages are stored in a form of an **append-only log**. You can create multiple streams, consisting of topics, which might have one or more partitions assigned, e.g. to divide consumption among independent consumers. Multi-node replication provides redundancy. You can think of Iggy as an alternative to Kafka or RabbitMQ streams."},"2549":{"id":"/docs/introduction/concepts-12","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-streaming","content":"You've probably used RabbitMQ or Kafka already. They look similar at the first glance, and you can achieve the similar results with both (e.g. publishing and consuming the events by the different applications built on top of microservices architecture), but they work differently underneath."},"2550":{"id":"/docs/introduction/concepts-13","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-streaming","content":"RabbitMQ is a **message broker** with both queues and streams. Traditional queues deliver messages to consumers and remove them after acknowledgement, or on delivery when automatic acknowledgement is used, so acknowledged messages cannot be replayed from the queue. Multiple consumers can share a queue and divide its messages. Independent subscribers that each need a copy use separate queues bound to an exchange. Queues normally use FIFO (First In, First Out) order, but priorities, redelivery and competing consumers can affect the observed order. See RabbitMQ's queue semantics. The typical message broker follows the so-called smart pipes and dumb endpoints pattern."},"2551":{"id":"/docs/introduction/concepts-14","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-streaming","content":"On the other hand, Kafka is a **message streaming platform** that stores messages in an append-only log and serves consumer fetch requests. The consumers are responsible for reading the messages from the log and processing them. Multiple consumer groups can read the same retained log without a separate stored copy for each group, although their fetch requests still consume CPU and network resources. The consumers can read the messages from the beginning, or from the specific offset, thus you can replay the messages. The typical message streaming platform follows the so-called dumb pipes and smart endpoints pattern."},"2552":{"id":"/docs/introduction/concepts-15","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-streaming","content":"Both approaches have advantages and disadvantages. The message broker is a more mature concept, but the message streaming platform is gaining more and more popularity, especially in the cloud-native world. And you can achieve much higher performance and throughput with the message streaming platform, since it acts as a simple database, being optimized for the append-only operations and can be queried in a very efficient way."},"2553":{"id":"/docs/introduction/concepts-16","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-streaming","content":"Iggy is the latter, a message streaming platform."},"2554":{"id":"/docs/introduction/concepts-17","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#append-only-log","content":"The append-only log is the core concept of Iggy. It's a simple data structure, which is optimized for the append-only operations. It's a sequence of records, that are being appended to the end of the log. The records are **immutable**, so that they can't be changed once they are written to the log. Records within a partition follow the order admitted by that partition's primary. There is no global ordering across partitions."},"2555":{"id":"/docs/introduction/concepts-18","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#append-only-log","content":"You address the log by **offset**, the position of the record in the log. Offsets start from 0 and increase within a partition. They are not guaranteed to be contiguous: after recovery, the server can skip reserved offsets to avoid reusing them. When the client reads the records, it specifies the offset to start from and the maximum number of records it wants. Starting from the beginning, or from any earlier offset, is how you replay the messages."},"2556":{"id":"/docs/introduction/concepts-19","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#stream","content":"While we could put an equal sign between the log and the stream, they are not the same, at least in a case of Iggy streaming server. The stream is a logical concept, and you might think of it as a **namespace**. For example, you could have a single stream for the whole system, or multiple streams e.g. representing the different environments, such as `dev`, `staging` and `production`. The stream is identified by its unique ID. The stream can have zero or more topics assigned, which results in the records being published to the specific topics that belong to the particular stream."},"2557":{"id":"/docs/introduction/concepts-20","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#topic","content":"The topic is also the logical concept, which is a part of the stream. The topic is identified by its ID, which is unique within its stream. You could think of topic as an entity being responsible for storing the specific type of the records. For example, you could have a topic for the user events, and another topic for the order events, etc."},"2558":{"id":"/docs/introduction/concepts-21","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#topic","content":"The messages are not being stored in the topic directly, but rather in the **partitions**, which are assigned to the topic. The topic can have one or more partitions assigned, that could help achieve higher parallelism and throughput. The topic can also have a **retention policy**. Expiry removes whole sealed segments after their newest message has expired, subject to the stored consumer-offset barrier. It does not delete each message immediately at its expiry time. See topic options for expiry and size-limit behavior. Topics also support maximum size limits and per-topic storage options (`segment_size`, `durability`, `consumer_offset_durability`, and flush thresholds) set at creation, plus a `compression_algorithm` option (a placeholder today: no compression is applied yet). Both durability policies independently default to `replicated`."},"2559":{"id":"/docs/introduction/concepts-22","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#partition","content":"The partition has its own unique ID and belongs to the topic. The partition is responsible for storing the records. The records are being distributed between the partitions, therefore the partition acts as a simple database, which is optimized for the append-only operations. The partition is identified by its unique ID, which is an integer. Stream, topic and partition IDs are assigned **starting from 0**. Deleted stream and topic IDs can be reused. New partitions use IDs above the highest remaining partition ID, so deleting the highest partitions can also allow their IDs to be reused. The partition ID is unique per topic, thus the same partition ID can be used in multiple topics."},"2560":{"id":"/docs/introduction/concepts-23","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#partition","content":"Thanks to having multiple partitions, we can achieve the horizontal scalability between many independent consumers, since each consumer can read the messages from the different partitions. This can be achieved by using more advanced concepts such as consumer groups."},"2561":{"id":"/docs/introduction/concepts-24","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#partition","content":"Each partition in the thread-per-core architecture is owned by **exactly one shard per replica** and includes:"},"2562":{"id":"/docs/introduction/concepts-25","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#partition","content":"A `SegmentedLog` with sealed segments and one active segment"},"2563":{"id":"/docs/introduction/concepts-26","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#partition","content":"Consumer offsets and consumer group offsets"},"2564":{"id":"/docs/introduction/concepts-27","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#segment","content":"The segment, being a part of the partition, is the actual **physical layer** which stores the records in the binary format in a form of the files. Each segment has a soft size limit (1 GiB unless the topic sets its own `segment_size`). A segment can exceed it by one whole batch before it is sealed and a new segment is created. The segment name is based on the start offset of the first record in the segment and is unique per partition."},"2565":{"id":"/docs/introduction/concepts-28","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#segment","content":"Each segment consists of:"},"2566":{"id":"/docs/introduction/concepts-29","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#segment","content":"`.log` file - the actual message data"},"2567":{"id":"/docs/introduction/concepts-30","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#segment","content":"`.index` file - positional and time indexes for fast lookups"},"2568":{"id":"/docs/introduction/concepts-31","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#polling-messages","content":"Consumers can poll the messages in multiple ways:"},"2569":{"id":"/docs/introduction/concepts-32","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#polling-messages","content":"**By offset** - start reading from the specified offset. The client tracks its own position."},"2570":{"id":"/docs/introduction/concepts-33","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#polling-messages","content":"**By timestamp** - start reading from the first message at or after the given timestamp."},"2571":{"id":"/docs/introduction/concepts-34","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#polling-messages","content":"**First / Last** - start from the beginning or the end of the partition."},"2572":{"id":"/docs/introduction/concepts-35","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#polling-messages","content":"**Next** - continue after the consumer offset stored on the server. `CommitPolicy::OnRead` submits progress with the poll and can advance it before application processing. Use manual checkpoint commits after successful processing when that ordering is required. See Deferred polling."},"2573":{"id":"/docs/introduction/concepts-36","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#consumer-groups","content":"Consumer groups provide horizontal scaling for message consumption. When multiple consumers join the same consumer group, the server automatically distributes partitions among group members so that each partition has **at most one member permitted to poll it** within that group. When members join or leave, the server triggers a **cooperative partition rebalancing** with a pending revocation phase (configurable timeout, default 30s) to let the previous owner finish processing and commit before handoff. Application processing and offset-commit ordering still determine whether failures cause skips or duplicates."},"2574":{"id":"/docs/introduction/concepts-37","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"The Rust SDK's `IggyMessageHeader::to_bytes()` representation is 64 bytes, with little-endian fields. The diagram and table describe that SDK representation, not Rust struct memory layout. On the wire and on disk, messages travel inside batch records with a compact 48-byte per-message frame header. See the Binary Protocol section for the exact encodings."},"2575":{"id":"/docs/introduction/concepts-38","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"| Field    | Bytes | Type | Description                |\n| -------- | ----- | ---- | -------------------------- |\n| checksum | 0-8   | u64  | xxHash3 integrity checksum |","table":"table-0"},"2576":{"id":"/docs/introduction/concepts-39","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"| Field | Bytes | Type | Description                                                                  |\n| ----- | ----- | ---- | ---------------------------------------------------------------------------- |\n| id    | 8-24  | u128 | Client-supplied 128-bit ID. Generated as UUIDv4 when omitted by the Rust SDK |","table":"table-0"},"2577":{"id":"/docs/introduction/concepts-40","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"| Field  | Bytes | Type | Description                            |\n| ------ | ----- | ---- | -------------------------------------- |\n| offset | 24-32 | u64  | Increasing offset within the partition |","table":"table-0"},"2578":{"id":"/docs/introduction/concepts-41","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"| Field     | Bytes | Type | Description               |\n| --------- | ----- | ---- | ------------------------- |\n| timestamp | 32-40 | u64  | Server-assigned timestamp |","table":"table-0"},"2579":{"id":"/docs/introduction/concepts-42","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"| Field            | Bytes | Type | Description               |\n| ---------------- | ----- | ---- | ------------------------- |\n| origin_timestamp | 40-48 | u64  | Client-provided timestamp |","table":"table-0"},"2580":{"id":"/docs/introduction/concepts-43","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"| Field               | Bytes | Type | Description                |\n| ------------------- | ----- | ---- | -------------------------- |\n| user_headers_length | 48-52 | u32  | Length of optional headers |","table":"table-0"},"2581":{"id":"/docs/introduction/concepts-44","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"| Field          | Bytes | Type | Description       |\n| -------------- | ----- | ---- | ----------------- |\n| payload_length | 52-56 | u32  | Length of payload |","table":"table-0"},"2582":{"id":"/docs/introduction/concepts-45","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"| Field    | Bytes | Type | Description          |\n| -------- | ----- | ---- | -------------------- |\n| reserved | 56-64 | u64  | Reserved (must be 0) |","table":"table-0"},"2583":{"id":"/docs/introduction/concepts-46","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"In the SDK message representation, the header is followed by payload bytes and then optional user-header bytes."},"2584":{"id":"/docs/introduction/concepts-47","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"To see how the server schedules these concepts across CPU cores and stores them on disk, head over to architecture."},"2585":{"id":"/docs/introduction/concepts-48","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#primaries-copies-and-checkpoints","content":"A partition primary orders writes for that partition. Different partitions can have different primaries. `replication_factor` determines how many nodes store each partition. Metadata has its own primary and spans the full cluster."},"2586":{"id":"/docs/introduction/concepts-49","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#primaries-copies-and-checkpoints","content":"A checkpoint records a processed position with its partition history and ownership generation. A continuation carries the next read position with the same context. These prevent an old read or commit from silently applying to a recreated partition. See Multi-leader partitions and Deferred polling."},"2587":{"id":"/docs/introduction/getting-started-python","page_id":"/docs/introduction/getting-started-python","type":"page","content":"Getting started (Python)","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/getting-started-python"},"2588":{"id":"/docs/introduction/getting-started-python-0","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python","content":"A first program with the Python SDK: create a stream and topic, send messages, then read them back on their own and as a consumer group."},"2589":{"id":"/docs/introduction/getting-started-python-1","page_id":"/docs/introduction/getting-started-python","type":"heading","tags":[],"url":"/docs/introduction/getting-started-python#before-we-start","content":"Before we start"},"2590":{"id":"/docs/introduction/getting-started-python-2","page_id":"/docs/introduction/getting-started-python","type":"heading","tags":[],"url":"/docs/introduction/getting-started-python#starting-the-server","content":"Starting the server"},"2591":{"id":"/docs/introduction/getting-started-python-3","page_id":"/docs/introduction/getting-started-python","type":"heading","tags":[],"url":"/docs/introduction/getting-started-python#producer","content":"Producer"},"2592":{"id":"/docs/introduction/getting-started-python-4","page_id":"/docs/introduction/getting-started-python","type":"heading","tags":[],"url":"/docs/introduction/getting-started-python#consumer","content":"Consumer"},"2593":{"id":"/docs/introduction/getting-started-python-5","page_id":"/docs/introduction/getting-started-python","type":"heading","tags":[],"url":"/docs/introduction/getting-started-python#consumer-group","content":"Consumer group"},"2594":{"id":"/docs/introduction/getting-started-python-6","page_id":"/docs/introduction/getting-started-python","type":"heading","tags":[],"url":"/docs/introduction/getting-started-python#running-it-again","content":"Running it again"},"2595":{"id":"/docs/introduction/getting-started-python-7","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#before-we-start","content":"This tutorial uses the Python SDK's low-level API (`IggyClient`) directly, so you can see each step. It needs Python 3.11 or newer. On Linux the server needs kernel 5.19 or newer. MacOS has no kernel requirement. See System requirements."},"2596":{"id":"/docs/introduction/getting-started-python-8","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#before-we-start","content":"The producer and consumer below match the getting-started examples in the repository."},"2597":{"id":"/docs/introduction/getting-started-python-9","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#starting-the-server","content":"`IGGY_TCP_ADDRESS` and `IGGY_NODE_ADVERTISED_ADDRESS` are needed because the server binds `127.0.0.1` inside the container by default, which the published port can't reach. The Rust tutorial's Starting the Iggy server section explains each flag."},"2598":{"id":"/docs/introduction/getting-started-python-10","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#starting-the-server","content":"Apache Iggy 0.10.0 skips memory binding on a single-NUMA-node topology. The older Docker Desktop workaround is no longer required for that case. Use `IGGY_SHARDING_CPU_ALLOCATION=all` when you explicitly want CPU pinning without NUMA memory binding."},"2599":{"id":"/docs/introduction/getting-started-python-11","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#starting-the-server","content":"Install the SDK in a virtual environment:"},"2600":{"id":"/docs/introduction/getting-started-python-12","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#producer","content":"Save this as `producer.py`:"},"2601":{"id":"/docs/introduction/getting-started-python-13","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#producer","content":"Run it with `python producer.py`:"},"2602":{"id":"/docs/introduction/getting-started-python-14","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#producer","content":"`from_connection_string` takes the transport, host and credentials in one string, `iggy+tcp://user:pass@host:port`. See Connection strings for the other options. Creating a stream or topic that already exists is an error, so the producer checks first and only creates what's missing. That's also what makes it safe to run again."},"2603":{"id":"/docs/introduction/getting-started-python-15","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#consumer","content":"Save this as `consumer.py`:"},"2604":{"id":"/docs/introduction/getting-started-python-16","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#consumer","content":"Run it with `python consumer.py`, after the producer:"},"2605":{"id":"/docs/introduction/getting-started-python-17","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#consumer","content":"`Consumer.Single(name)` is a consumer that polls on its own, and the server stores its offset under that name. With `auto_commit=True` the offset is stored after the poll returns, without waiting for the store to finish, so a crash straight afterwards can deliver the last batch again."},"2606":{"id":"/docs/introduction/getting-started-python-18","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#consumer-group","content":"A consumer group lets several copies of a consumer share a topic's partitions, with each message going to only one of them. Groups need a binary transport (TCP, QUIC or WebSocket). HTTP doesn't support them."},"2607":{"id":"/docs/introduction/getting-started-python-19","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#consumer-group","content":"Save this as `consumer_group.py`:"},"2608":{"id":"/docs/introduction/getting-started-python-20","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#consumer-group","content":"Run it with `python consumer_group.py`. With the producer run twice, so 20 messages on the topic, it prints every offset from 0 to 19 and then stops:"},"2609":{"id":"/docs/introduction/getting-started-python-21","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#consumer-group","content":"`iter_messages()` is the simplest way to read from a group. For a long-running service with its own shutdown signal, use `consume_messages(callback, shutdown_event)` instead."},"2610":{"id":"/docs/introduction/getting-started-python-22","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#running-it-again","content":"Run the producer again and it finds the stream and topic already there, and adds another 10 messages at offsets 10 to 19."},"2611":{"id":"/docs/introduction/getting-started-python-23","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#running-it-again","content":"Run `consumer.py` again and it carries on from its stored offset, printing only the new messages rather than the first ten again."},"2612":{"id":"/docs/introduction/getting-started-python-24","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#running-it-again","content":"Run `consumer_group.py` again and it prints every message from offset 0, because it asks for `PollingStrategy.First()`. That keeps the example repeatable. A long-running group consumer would leave the polling strategy at its default and keep `auto_commit` on, so it carries on from the group's stored offset instead."},"2613":{"id":"/docs/introduction/getting-started-python-25","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#running-it-again","content":"To start again with an empty server, stop the container, which `--rm` removes, and run `docker run` again."},"2614":{"id":"/docs/introduction/getting-started","page_id":"/docs/introduction/getting-started","type":"page","content":"Getting started (Rust)","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/getting-started"},"2615":{"id":"/docs/introduction/getting-started-0","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started","content":"A first program with the low-level Rust SDK: create a stream and topic, send messages, then poll them back."},"2616":{"id":"/docs/introduction/getting-started-1","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#before-we-start","content":"Before we start"},"2617":{"id":"/docs/introduction/getting-started-2","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#what-we-will-build","content":"What we will build"},"2618":{"id":"/docs/introduction/getting-started-3","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"Starting the Iggy server"},"2619":{"id":"/docs/introduction/getting-started-4","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#setting-up-the-project","content":"Setting up the project"},"2620":{"id":"/docs/introduction/getting-started-5","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#building-the-producer","content":"Building the producer"},"2621":{"id":"/docs/introduction/getting-started-6","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#building-the-consumer","content":"Building the consumer"},"2622":{"id":"/docs/introduction/getting-started-7","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#run-the-applications","content":"Run the applications"},"2623":{"id":"/docs/introduction/getting-started-8","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#next-steps","content":"Next steps"},"2624":{"id":"/docs/introduction/getting-started-9","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#before-we-start","content":"Apache Iggy 0.10.0 skips memory binding on a single-NUMA-node topology. The older Docker Desktop workaround is no longer required for that case. Use `IGGY_SHARDING_CPU_ALLOCATION=all` when you explicitly want CPU pinning without NUMA memory binding."},"2625":{"id":"/docs/introduction/getting-started-10","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#before-we-start","content":"This tutorial uses the **low-level Rust SDK** to show how things work under the hood - creating streams, topics, sending and polling messages step by step. This is great for understanding the fundamentals."},"2626":{"id":"/docs/introduction/getting-started-11","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#before-we-start","content":"For real-world applications, you might typically prefer the **high-level SDK**, which provides `IggyProducer` and `IggyConsumer` builders with auto-batching, consumer groups, offset management, reconnection, and retry logic out of the box. Check the Stream Builder docs for the most ergonomic API."},"2627":{"id":"/docs/introduction/getting-started-12","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#before-we-start","content":"For examples in other programming languages, see the SDK section."},"2628":{"id":"/docs/introduction/getting-started-13","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#what-we-will-build","content":"We will build a **producer** (publishing messages to a stream) and a **consumer** (reading those messages back). In a real system, a service can be both at the same time - publishing its own events while consuming events from other services."},"2629":{"id":"/docs/introduction/getting-started-14","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#what-we-will-build","content":"The completed sample can be found in the repository. We will go through the implementation step by step so you get a clear understanding of how it all fits together."},"2630":{"id":"/docs/introduction/getting-started-15","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"For our purpose, we will focus on the basic scenario in order to keep things simple. Before we begin implementing the consumer and producer apps, we need to start the Iggy streaming server."},"2631":{"id":"/docs/introduction/getting-started-16","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"This guide targets server **0.10.0**. Use its official Docker image:"},"2632":{"id":"/docs/introduction/getting-started-17","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"The container needs a host kernel of 5.19 or newer, because the server uses `io_uring`. See System requirements if it fails to start. The capabilities, seccomp setting, and memlock limit form a permissive development setup. Production deployments can use narrower syscall permissions and a finite memory budget. See Docker & Helm for the details. `IGGY_TCP_ADDRESS` is needed because the server binds to `127.0.0.1` inside the container by default, which a published port cannot reach. `IGGY_NODE_ADVERTISED_ADDRESS` is needed because that wildcard leaves the server with no address to give clients, and it refuses to start rather than publish one nobody can dial. Here the port is published to the host, so `localhost` is that address. Setting the root credentials explicitly means the username and password used later in this guide will work."},"2633":{"id":"/docs/introduction/getting-started-18","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"Alternatively, build from source by cloning the repository and running:"},"2634":{"id":"/docs/introduction/getting-started-19","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"A bare `iggy-server` boot does **not** create the root user with the well-known `iggy`/`iggy` pair. A fresh standalone server refuses to start without credentials. A cluster replica without credentials waits for root to be replicated. The `--with-default-root-credentials` flag switches to the development credentials (username: `iggy`, password: `iggy`), and `--fresh` wipes the data directory first, so the root user is created anew with them. You can also set `IGGY_ROOT_USERNAME` and `IGGY_ROOT_PASSWORD` yourself. The environment **takes precedence** over the flag. The credentials initialize the stored root account **only on first creation**. Changing them on a later boot does not reset its password. Supplied environment credentials are still validated on restarts."},"2635":{"id":"/docs/introduction/getting-started-20","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"All the data used by the server will be persisted under the `local_data` directory, unless specified differently in the configuration."},"2636":{"id":"/docs/introduction/getting-started-21","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"As long as the Iggy server is running, we're good to go. If you'd like to play with the configuration (e.g. change the addresses, ports, caching or so) you will find `config.toml` under `core/server` in the repository."},"2637":{"id":"/docs/introduction/getting-started-22","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#setting-up-the-project","content":"Create a Rust application with two binaries:"},"2638":{"id":"/docs/introduction/getting-started-23","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#setting-up-the-project","content":"Save the producer in `src/bin/producer.rs` and the consumer in `src/bin/consumer.rs`. The programs use resource names, so they do not depend on the IDs assigned to other streams."},"2639":{"id":"/docs/introduction/getting-started-24","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"The producer connects, creates missing resources and sends ten messages to partition zero. Resource creation returns errors for existing names, which this example handles separately from other failures."},"2640":{"id":"/docs/introduction/getting-started-25","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"`StreamCreateOptions` configures stream creation. `TopicCreateOptions` selects partitions, retention and storage policies. Omitted optional fields use server defaults. The default message durability is `replicated`. Select `Durability::Persisted` when successful sends must wait for stable storage. See Topic options."},"2641":{"id":"/docs/introduction/getting-started-26","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"A topic's first partition is zero. `Partitioning::partition_id(0)` selects it explicitly. `balanced()` distributes batches across partitions, and `messages_key()` selects a partition from a key. Ordering applies within a partition."},"2642":{"id":"/docs/introduction/getting-started-27","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"The consumer starts after its stored offset. It waits up to five seconds for messages and processes the returned batch before storing its checkpoint. An empty reply ends this example."},"2643":{"id":"/docs/introduction/getting-started-28","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"A continuation carries the next position and the partition history that produced it. Do not advance an offset by the number of returned messages because offsets can contain gaps. A checkpoint stores progress under that history. If the partition is recreated, the server refuses a stale checkpoint."},"2644":{"id":"/docs/introduction/getting-started-29","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"A standalone consumer does not join a group. Two applications using its same identity can change the same stored offset. Use a consumer group to assign partitions among service instances. The high-level consumer manages those assignments and grouped fetches."},"2645":{"id":"/docs/introduction/getting-started-30","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#run-the-applications","content":"Run the producer first:"},"2646":{"id":"/docs/introduction/getting-started-31","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#run-the-applications","content":"Then run the consumer:"},"2647":{"id":"/docs/introduction/getting-started-32","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#run-the-applications","content":"The consumer prints the messages and stores its progress. Running it again waits and exits if no new messages exist. Running the producer again appends ten more messages. A processing failure before checkpoint storage can cause replay on the next run, so application side effects must tolerate retries."},"2648":{"id":"/docs/introduction/getting-started-33","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#next-steps","content":"Use deferred polling to tune wait and batch limits. Use the high-level SDK for producers and group consumers. The examples cover headers, serialization, TLS and stream builders."},"2649":{"id":"/docs/introduction/glossary","page_id":"/docs/introduction/glossary","type":"page","content":"Glossary","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/glossary"},"2650":{"id":"/docs/introduction/glossary-0","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Short definitions of the terms used across the Apache Iggy docs, with links to where each one is explained."},"2651":{"id":"/docs/introduction/glossary-1","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"A one-line definition of each term, with a link to the page that explains it."},"2652":{"id":"/docs/introduction/glossary-2","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Append-only log.** An ordered list of messages that only grows at the end. Messages can't be changed once written, and you can read from any earlier point to replay them. See Concepts."},"2653":{"id":"/docs/introduction/glossary-3","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Auto-commit.** An option on a poll. The server saves the consumer's position as it returns the messages, before the consumer has processed them. See Polling messages."},"2654":{"id":"/docs/introduction/glossary-4","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Connection string.** A single value such as `iggy://user:password@localhost:8090` that tells a client how to connect. All SDKs accept connection strings, with language-specific schemes and options. See Connection strings."},"2655":{"id":"/docs/introduction/glossary-5","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Consumer.** A client that reads messages on its own rather than as part of a consumer group. Its position is kept separately from every other consumer's."},"2656":{"id":"/docs/introduction/glossary-6","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Consumer group.** A set of consumers that share a topic's partitions, with each partition read by one member at a time. See Consumer groups."},"2657":{"id":"/docs/introduction/glossary-7","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Durability.** A topic setting, `replicated` or `persisted`, that decides what must be done before a write is reported as successful. See Durability."},"2658":{"id":"/docs/introduction/glossary-8","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Offset.** The position of a message within a partition, starting at 0. See Concepts."},"2659":{"id":"/docs/introduction/glossary-9","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Partition.** Where a topic's messages are actually stored. A topic's messages are spread across its partitions. See Partition."},"2660":{"id":"/docs/introduction/glossary-10","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Partitioning.** How a producer picks the partition for a message: a fixed partition, round robin, or a hash of a message key. See Getting started."},"2661":{"id":"/docs/introduction/glossary-11","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Payload.** The body of a message. The server stores it as bytes without interpreting it, so the format is up to you. See Serialising messages."},"2662":{"id":"/docs/introduction/glossary-12","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Personal access token.** A token you create on the server and use in place of a username and password, for example in a scraper or a script. See Connection strings."},"2663":{"id":"/docs/introduction/glossary-13","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Primary and replica.** In a cluster, the primary orders writes and the replicas copy them. If the primary fails, the replicas elect a new one. See Viewstamped Replication."},"2664":{"id":"/docs/introduction/glossary-14","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Retention policy.** Topic settings that delete old messages by age or by size. See Topic options."},"2665":{"id":"/docs/introduction/glossary-15","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Segment.** Part of a partition, stored on disk as a data file and an index file. Retention deletes old segments whole. See Segment."},"2666":{"id":"/docs/introduction/glossary-16","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Shard.** One thread in the server that owns a set of partitions. See Architecture."},"2667":{"id":"/docs/introduction/glossary-17","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Stream.** A container for related topics. For example, a `dev` stream and a `production` stream can each have their own `orders` topic. See Stream."},"2668":{"id":"/docs/introduction/glossary-18","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Topic.** A named set of partitions for one kind of message, such as orders or user events. See Topic."},"2669":{"id":"/docs/introduction/glossary-19","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**User headers.** Optional key and value pairs sent with a message, kept separate from the payload. See Serialising messages."},"2670":{"id":"/docs/introduction/glossary-20","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**VSR.** Viewstamped Replication, the protocol Apache Iggy uses to keep replicas in step. See Viewstamped Replication."},"2671":{"id":"/docs/introduction/glossary-21","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Deferred polling.** A read that waits on the server for messages or a deadline. A grouped fetch reads several partitions of one primary."},"2672":{"id":"/docs/introduction/glossary-22","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Checkpoint.** A position that can be committed after processing. It retains the partition incarnation and consumer ownership generation."},"2673":{"id":"/docs/introduction/glossary-23","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Partition incarnation.** The identity of one partition history. Deleting and recreating a partition changes it."},"2674":{"id":"/docs/introduction/glossary-24","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"**Replication factor.** The number of nodes that store each partition of a topic. Set it at topic creation."},"2675":{"id":"/docs/introduction/quickstart","page_id":"/docs/introduction/quickstart","type":"page","content":"Quickstart","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/quickstart"},"2676":{"id":"/docs/introduction/quickstart-0","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart","content":"Run the Iggy server and send and receive your first message with the Rust SDK, in one file."},"2677":{"id":"/docs/introduction/quickstart-1","page_id":"/docs/introduction/quickstart","type":"heading","tags":[],"url":"/docs/introduction/quickstart#start-the-server","content":"Start the server"},"2678":{"id":"/docs/introduction/quickstart-2","page_id":"/docs/introduction/quickstart","type":"heading","tags":[],"url":"/docs/introduction/quickstart#send-and-receive-a-message","content":"Send and receive a message"},"2679":{"id":"/docs/introduction/quickstart-3","page_id":"/docs/introduction/quickstart","type":"heading","tags":[],"url":"/docs/introduction/quickstart#next-steps","content":"Next steps"},"2680":{"id":"/docs/introduction/quickstart-4","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart","content":"This page gets a server running and a message sent and received, in one file. To build separate producer and consumer applications step by step, see Getting started. For other languages, see the SDK section."},"2681":{"id":"/docs/introduction/quickstart-5","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart","content":"Apache Iggy 0.10.0 skips memory binding on a single-NUMA-node topology. The older Docker Desktop workaround is no longer required for that case. Use `IGGY_SHARDING_CPU_ALLOCATION=all` when you explicitly want CPU pinning without NUMA memory binding."},"2682":{"id":"/docs/introduction/quickstart-6","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart#start-the-server","content":"See Docker & Helm for what each option does."},"2683":{"id":"/docs/introduction/quickstart-7","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart#send-and-receive-a-message","content":"Create a project and add the SDK and the async runtime:"},"2684":{"id":"/docs/introduction/quickstart-8","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart#send-and-receive-a-message","content":"Replace `src/main.rs` with:"},"2685":{"id":"/docs/introduction/quickstart-9","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart#send-and-receive-a-message","content":"Run it with `cargo run`. Partition IDs are **0-based**, so the first partition of a topic is partition `0`."},"2686":{"id":"/docs/introduction/quickstart-10","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart#next-steps","content":"Build a producer and a consumer as two applications: Getting started."},"2687":{"id":"/docs/introduction/quickstart-11","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart#next-steps","content":"Use the producer and consumer builders with batching and offset management: High-level SDK."},"2688":{"id":"/docs/introduction/quickstart-12","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart#next-steps","content":"Use another language: SDK section."},"2689":{"id":"/docs/introduction/serialising-messages","page_id":"/docs/introduction/serialising-messages","type":"page","content":"Serialising messages","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/serialising-messages"},"2690":{"id":"/docs/introduction/serialising-messages-0","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages","content":"Choose a format for your message payloads, and send more than one kind of message to the same topic."},"2691":{"id":"/docs/introduction/serialising-messages-1","page_id":"/docs/introduction/serialising-messages","type":"heading","tags":[],"url":"/docs/introduction/serialising-messages#one-kind-of-message","content":"One kind of message"},"2692":{"id":"/docs/introduction/serialising-messages-2","page_id":"/docs/introduction/serialising-messages","type":"heading","tags":[],"url":"/docs/introduction/serialising-messages#a-type-field-in-the-payload","content":"A type field in the payload"},"2693":{"id":"/docs/introduction/serialising-messages-3","page_id":"/docs/introduction/serialising-messages","type":"heading","tags":[],"url":"/docs/introduction/serialising-messages#a-type-field-in-a-header","content":"A type field in a header"},"2694":{"id":"/docs/introduction/serialising-messages-4","page_id":"/docs/introduction/serialising-messages","type":"heading","tags":[],"url":"/docs/introduction/serialising-messages#size-limits","content":"Size limits"},"2695":{"id":"/docs/introduction/serialising-messages-5","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages","content":"The server stores each message payload as bytes without interpreting it, so you choose the format: plain text, JSON, Protobuf or anything else. This page shows how to send more than one kind of message to the same topic, so the consumer knows how to decode each one."},"2696":{"id":"/docs/introduction/serialising-messages-6","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages","content":"The examples are in Rust and come from the examples in the Apache Iggy repository."},"2697":{"id":"/docs/introduction/serialising-messages-7","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages#one-kind-of-message","content":"If every message on a topic has the same shape, send the encoded value as the payload and decode it the same way on the other side. Getting started does this with plain strings."},"2698":{"id":"/docs/introduction/serialising-messages-8","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages#a-type-field-in-the-payload","content":"Wrap each message in an envelope that names its type, and send the envelope as JSON:"},"2699":{"id":"/docs/introduction/serialising-messages-9","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages#a-type-field-in-the-payload","content":"The consumer decodes the envelope, reads `message_type`, then decodes the inner payload as that type. This works with any client, but every message is decoded twice, and the inner payload is a JSON string inside the envelope. See the message-envelope example."},"2700":{"id":"/docs/introduction/serialising-messages-10","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages#a-type-field-in-a-header","content":"Messages can carry user headers, which are key and value pairs kept separate from the payload. Put the type in a header and send the payload as it is:"},"2701":{"id":"/docs/introduction/serialising-messages-11","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages#a-type-field-in-a-header","content":"The consumer reads the header and decodes the payload once:"},"2702":{"id":"/docs/introduction/serialising-messages-12","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages#a-type-field-in-a-header","content":"This is the better choice for Protobuf or any other binary format, because the payload doesn't have to fit inside JSON. See the message-type example."},"2703":{"id":"/docs/introduction/serialising-messages-13","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages#a-type-field-in-a-header","content":"Header values don't have to be strings. They can also be numbers, booleans or raw bytes, so you can add things like a trace ID next to the type, as the typed-headers example shows. The message-compression example uses a header in the same way to record how the payload was compressed."},"2704":{"id":"/docs/introduction/serialising-messages-14","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages#size-limits","content":"A payload can be up to 64 MB, and a message's user headers up to 100 KB in total. The whole send request also has to fit the server's request limit, which by default is 64 MiB over TCP and 2 MB over HTTP."},"2705":{"id":"/docs/sdk/connection-strings","page_id":"/docs/sdk/connection-strings","type":"page","content":"Connection Strings","breadcrumbs":["Documentation","SDK"],"tags":[],"url":"/docs/sdk/connection-strings"},"2706":{"id":"/docs/sdk/connection-strings-0","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings","content":"The canonical reference for Iggy connection strings, covering every scheme, credential form and option."},"2707":{"id":"/docs/sdk/connection-strings-1","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#format","content":"Format"},"2708":{"id":"/docs/sdk/connection-strings-2","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#transport-selection","content":"Transport selection"},"2709":{"id":"/docs/sdk/connection-strings-3","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#credentials","content":"Credentials"},"2710":{"id":"/docs/sdk/connection-strings-4","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#duration-values","content":"Duration values"},"2711":{"id":"/docs/sdk/connection-strings-5","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#tcp-options","content":"TCP options"},"2712":{"id":"/docs/sdk/connection-strings-6","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#quic-options","content":"QUIC options"},"2713":{"id":"/docs/sdk/connection-strings-7","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#websocket-options","content":"WebSocket options"},"2714":{"id":"/docs/sdk/connection-strings-8","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#http-options","content":"HTTP options"},"2715":{"id":"/docs/sdk/connection-strings-9","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#usage","content":"Usage"},"2716":{"id":"/docs/sdk/connection-strings-10","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#pending-operation-limits","content":"Pending-operation limits"},"2717":{"id":"/docs/sdk/connection-strings-11","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#native-sdk-differences","content":"Native SDK differences"},"2718":{"id":"/docs/sdk/connection-strings-12","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings","content":"A connection string configures an Iggy client in a single line: transport, credentials, server address, and options. This page is the canonical reference for every scheme, credential form, and option key."},"2719":{"id":"/docs/sdk/connection-strings-13","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings","content":"The tables below describe the Rust SDK and its Python, C++ and PHP bindings. Native Go, Node.js, C# and Swift clients also accept TCP connection strings. Java supports a smaller subset, described below."},"2720":{"id":"/docs/sdk/connection-strings-14","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#format","content":"The host and port are **always required**. Use a hostname, IPv4 address or bracketed IPv6 address such as `[::1]:8090`. Options are appended as `key=value` pairs separated by `&`. Scheme names and option keys are case-sensitive."},"2721":{"id":"/docs/sdk/connection-strings-15","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#format","content":"The parser does not percent-decode credentials or option values. Reserved separators such as `:` and `@` cannot be escaped inside a username or password. Use a PAT for credentials that contain them. Duplicate option keys use the last value. Boolean options enable only for the literal `true`. Use `false` to disable them."},"2722":{"id":"/docs/sdk/connection-strings-16","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#format","content":"**Unknown option keys are hard errors.** The parser rejects the whole string with `InvalidConnectionString` instead of ignoring the key, so a typo fails fast rather than silently falling back to a default."},"2723":{"id":"/docs/sdk/connection-strings-17","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"The scheme picks the transport. Each transport has its own default server port:"},"2724":{"id":"/docs/sdk/connection-strings-18","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"| Scheme    | Transport     | Default server port |\n| --------- | ------------- | ------------------- |\n| `iggy://` | TCP (default) | 8090                |","table":"table-0"},"2725":{"id":"/docs/sdk/connection-strings-19","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"| Scheme        | Transport | Default server port |\n| ------------- | --------- | ------------------- |\n| `iggy+tcp://` | TCP       | 8090                |","table":"table-0"},"2726":{"id":"/docs/sdk/connection-strings-20","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"| Scheme         | Transport | Default server port |\n| -------------- | --------- | ------------------- |\n| `iggy+quic://` | QUIC      | 8080                |","table":"table-0"},"2727":{"id":"/docs/sdk/connection-strings-21","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"| Scheme         | Transport | Default server port |\n| -------------- | --------- | ------------------- |\n| `iggy+http://` | HTTP      | 3000                |","table":"table-0"},"2728":{"id":"/docs/sdk/connection-strings-22","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"| Scheme       | Transport | Default server port |\n| ------------ | --------- | ------------------- |\n| `iggy+ws://` | WebSocket | 8092                |","table":"table-0"},"2729":{"id":"/docs/sdk/connection-strings-23","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#credentials","content":"Two forms are accepted:"},"2730":{"id":"/docs/sdk/connection-strings-24","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#credentials","content":"**Username and password**, separated by a colon. Both parts must be non-empty:"},"2731":{"id":"/docs/sdk/connection-strings-25","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#credentials","content":"**Personal Access Token**: any credential without a colon is treated as a PAT. Server-minted tokens are plain base64 strings with no prefix, so paste the token exactly as the server returned it:"},"2732":{"id":"/docs/sdk/connection-strings-26","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#credentials","content":"**Do not prepend anything** to the token. Strings like `iggypat-...` appear only in Iggy's own test code. A real token with a prefix added will fail to log in."},"2733":{"id":"/docs/sdk/connection-strings-27","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#credentials","content":"The examples use `iggy`/`iggy`. For a new local development instance, with no `IGGY_ROOT_USERNAME` or `IGGY_ROOT_PASSWORD` overrides, use:"},"2734":{"id":"/docs/sdk/connection-strings-28","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#credentials","content":"The environment takes precedence over the flag. Stored or recovered root credentials are not replaced by bootstrap settings. `--fresh` deletes this replica's local data. In a cluster it can recover committed state, including credentials, from another replica. Use this reset only for disposable development data. A fresh standalone server requires credentials. Provision root credentials on every replica for a new cluster."},"2735":{"id":"/docs/sdk/connection-strings-29","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#credentials","content":"TCP, QUIC, and WebSocket apply connection-string credentials during `connect()`. HTTP requires an explicit login, as described below."},"2736":{"id":"/docs/sdk/connection-strings-30","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#duration-values","content":"Options typed as durations take human-readable values such as `5s`, `500ms`, or `1m`, unless a table below says the value is a plain number. Heartbeat and reconnection intervals must be greater than zero. The reconnection cooldown can be zero."},"2737":{"id":"/docs/sdk/connection-strings-31","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#tcp-options","content":"| Key   | Description                 | Default |\n| ----- | --------------------------- | ------- |\n| `tls` | Enable TLS (`true`/`false`) | `false` |","table":"table-1"},"2738":{"id":"/docs/sdk/connection-strings-32","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#tcp-options","content":"| Key          | Description                                                        | Default |\n| ------------ | ------------------------------------------------------------------ | ------- |\n| `tls_domain` | Name for TLS validation. When empty, use the dialed hostname or IP | empty   |","table":"table-1"},"2739":{"id":"/docs/sdk/connection-strings-33","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#tcp-options","content":"| Key           | Description                                                       | Default |\n| ------------- | ----------------------------------------------------------------- | ------- |\n| `tls_ca_file` | PEM file of trusted CA certificates, replacing the built-in roots | none    |","table":"table-1"},"2740":{"id":"/docs/sdk/connection-strings-34","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#tcp-options","content":"| Key                    | Description                                                              | Default     |\n| ---------------------- | ------------------------------------------------------------------------ | ----------- |\n| `reconnection_retries` | Retry passes over known endpoints after the initial pass, or `unlimited` | `unlimited` |","table":"table-1"},"2741":{"id":"/docs/sdk/connection-strings-35","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#tcp-options","content":"| Key                     | Description                                                         | Default |\n| ----------------------- | ------------------------------------------------------------------- | ------- |\n| `reconnection_interval` | Base of exponential backoff with full jitter, capped at ten seconds | `1s`    |","table":"table-1"},"2742":{"id":"/docs/sdk/connection-strings-36","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#tcp-options","content":"| Key                 | Description                                          | Default |\n| ------------------- | ---------------------------------------------------- | ------- |\n| `reestablish_after` | Stable connection duration that resets retry backoff | `5s`    |","table":"table-1"},"2743":{"id":"/docs/sdk/connection-strings-37","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#tcp-options","content":"| Key                  | Description                 | Default |\n| -------------------- | --------------------------- | ------- |\n| `heartbeat_interval` | Duration between heartbeats | `5s`    |","table":"table-1"},"2744":{"id":"/docs/sdk/connection-strings-38","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#tcp-options","content":"| Key       | Description                           | Default |\n| --------- | ------------------------------------- | ------- |\n| `nodelay` | Enable `TCP_NODELAY` (`true`/`false`) | `false` |","table":"table-1"},"2745":{"id":"/docs/sdk/connection-strings-39","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#tcp-options","content":"With `tls=true`, TCP always validates the server certificate. Without `tls_ca_file`, it uses the built-in Mozilla roots. An explicit CA file can trust a private CA. The example above runs from the repository root against a TLS-enabled listener using the test certificate and key in `core/certs/iggy_cert.pem` and `core/certs/iggy_key.pem`. Those certificates are for local testing. See Security for TLS configuration."},"2746":{"id":"/docs/sdk/connection-strings-40","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#quic-options","content":"The QUIC reconnection keys **differ from TCP**: `reconnection_max_retries` (not `reconnection_retries`) and `reconnection_reestablish_after` (not `reestablish_after`). Using the TCP names in a QUIC string is a hard error."},"2747":{"id":"/docs/sdk/connection-strings-41","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#quic-options","content":"| Key                    | Description                         | Default                            |\n| ---------------------- | ----------------------------------- | ---------------------------------- |\n| `response_buffer_size` | Maximum bytes read for one response | Protocol maximum record reply size |","table":"table-2"},"2748":{"id":"/docs/sdk/connection-strings-42","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#quic-options","content":"| Key                           | Description                                             | Default |\n| ----------------------------- | ------------------------------------------------------- | ------- |\n| `max_concurrent_bidi_streams` | Maximum concurrent peer-initiated bidirectional streams | `10000` |","table":"table-2"},"2749":{"id":"/docs/sdk/connection-strings-43","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#quic-options","content":"| Key                         | Description                        | Default  |\n| --------------------------- | ---------------------------------- | -------- |\n| `datagram_send_buffer_size` | Datagram send buffer size in bytes | `100000` |","table":"table-2"},"2750":{"id":"/docs/sdk/connection-strings-44","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#quic-options","content":"| Key           | Description                                                   | Default |\n| ------------- | ------------------------------------------------------------- | ------- |\n| `initial_mtu` | Initial UDP payload size in bytes, clamped to at least `1200` | `1200`  |","table":"table-2"},"2751":{"id":"/docs/sdk/connection-strings-45","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#quic-options","content":"| Key           | Description               | Default  |\n| ------------- | ------------------------- | -------- |\n| `send_window` | Send window size in bytes | `100000` |","table":"table-2"},"2752":{"id":"/docs/sdk/connection-strings-46","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#quic-options","content":"| Key              | Description                             | Default  |\n| ---------------- | --------------------------------------- | -------- |\n| `receive_window` | Connection receive window size in bytes | `100000` |","table":"table-2"},"2753":{"id":"/docs/sdk/connection-strings-47","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#quic-options","content":"| Key                   | Description                                          | Default |\n| --------------------- | ---------------------------------------------------- | ------- |\n| `keep_alive_interval` | Keep-alive interval in milliseconds. `0` disables it | `5000`  |","table":"table-2"},"2754":{"id":"/docs/sdk/connection-strings-48","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#quic-options","content":"| Key                | Description                                                         | Default |\n| ------------------ | ------------------------------------------------------------------- | ------- |\n| `max_idle_timeout` | Idle timeout in milliseconds. `0` leaves Quinn's `30000` ms default | `10000` |","table":"table-2"},"2755":{"id":"/docs/sdk/connection-strings-49","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#quic-options","content":"| Key                    | Description                                      | Default |\n| ---------------------- | ------------------------------------------------ | ------- |\n| `validate_certificate` | Validate the server certificate (`true`/`false`) | `false` |","table":"table-2"},"2756":{"id":"/docs/sdk/connection-strings-50","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#quic-options","content":"| Key                  | Description                 | Default |\n| -------------------- | --------------------------- | ------- |\n| `heartbeat_interval` | Duration between heartbeats | `5s`    |","table":"table-2"},"2757":{"id":"/docs/sdk/connection-strings-51","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#quic-options","content":"| Key                        | Description                                     | Default     |\n| -------------------------- | ----------------------------------------------- | ----------- |\n| `reconnection_max_retries` | Number of reconnection attempts, or `unlimited` | `unlimited` |","table":"table-2"},"2758":{"id":"/docs/sdk/connection-strings-52","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#quic-options","content":"| Key                     | Description                            | Default |\n| ----------------------- | -------------------------------------- | ------- |\n| `reconnection_interval` | Duration between reconnection attempts | `1s`    |","table":"table-2"},"2759":{"id":"/docs/sdk/connection-strings-53","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#quic-options","content":"| Key                              | Description                                          | Default |\n| -------------------------------- | ---------------------------------------------------- | ------- |\n| `reconnection_reestablish_after` | Stable connection duration that resets retry backoff | `5s`    |","table":"table-2"},"2760":{"id":"/docs/sdk/connection-strings-54","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#quic-options","content":"QUIC certificate validation is disabled by default. When enabled, it uses the platform verifier and the connection-string configuration's server name, `localhost`. For a different certificate name, use the Rust QUIC configuration builder's `with_server_name()` method. Values above QUIC's 62-bit limit for `max_concurrent_bidi_streams`, `receive_window`, or `max_idle_timeout` are rejected with `InvalidConfiguration`."},"2761":{"id":"/docs/sdk/connection-strings-55","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"| Key                  | Description                 | Default |\n| -------------------- | --------------------------- | ------- |\n| `heartbeat_interval` | Duration between heartbeats | `5s`    |","table":"table-3"},"2762":{"id":"/docs/sdk/connection-strings-56","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"| Key                    | Description                                     | Default     |\n| ---------------------- | ----------------------------------------------- | ----------- |\n| `reconnection_retries` | Number of reconnection attempts, or `unlimited` | `unlimited` |","table":"table-3"},"2763":{"id":"/docs/sdk/connection-strings-57","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"| Key                     | Description                            | Default |\n| ----------------------- | -------------------------------------- | ------- |\n| `reconnection_interval` | Duration between reconnection attempts | `1s`    |","table":"table-3"},"2764":{"id":"/docs/sdk/connection-strings-58","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"| Key                 | Description                                          | Default |\n| ------------------- | ---------------------------------------------------- | ------- |\n| `reestablish_after` | Stable connection duration that resets retry backoff | `5s`    |","table":"table-3"},"2765":{"id":"/docs/sdk/connection-strings-59","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"| Key                | Description               | Default  |\n| ------------------ | ------------------------- | -------- |\n| `read_buffer_size` | Read buffer size in bytes | `131072` |","table":"table-3"},"2766":{"id":"/docs/sdk/connection-strings-60","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"| Key                 | Description                       | Default  |\n| ------------------- | --------------------------------- | -------- |\n| `write_buffer_size` | Target write buffer size in bytes | `131072` |","table":"table-3"},"2767":{"id":"/docs/sdk/connection-strings-61","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"| Key                     | Description                                                         | Default      |\n| ----------------------- | ------------------------------------------------------------------- | ------------ |\n| `max_write_buffer_size` | Maximum write buffer size in bytes. Must exceed `write_buffer_size` | `usize::MAX` |","table":"table-3"},"2768":{"id":"/docs/sdk/connection-strings-62","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"| Key                | Description                                      | Default    |\n| ------------------ | ------------------------------------------------ | ---------- |\n| `max_message_size` | Maximum incoming WebSocket message size in bytes | `67108864` |","table":"table-3"},"2769":{"id":"/docs/sdk/connection-strings-63","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"| Key              | Description                                  | Default    |\n| ---------------- | -------------------------------------------- | ---------- |\n| `max_frame_size` | Maximum incoming frame payload size in bytes | `16777216` |","table":"table-3"},"2770":{"id":"/docs/sdk/connection-strings-64","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"| Key                      | Description                         | Default |\n| ------------------------ | ----------------------------------- | ------- |\n| `accept_unmasked_frames` | Has no effect on client connections | `false` |","table":"table-3"},"2771":{"id":"/docs/sdk/connection-strings-65","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"| Key   | Description                 | Default |\n| ----- | --------------------------- | ------- |\n| `tls` | Enable TLS (`true`/`false`) | `false` |","table":"table-3"},"2772":{"id":"/docs/sdk/connection-strings-66","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"| Key          | Description                                               | Default |\n| ------------ | --------------------------------------------------------- | ------- |\n| `tls_domain` | Name for TLS validation. When empty, use the connected IP | empty   |","table":"table-3"},"2773":{"id":"/docs/sdk/connection-strings-67","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"| Key           | Description                                                    | Default |\n| ------------- | -------------------------------------------------------------- | ------- |\n| `tls_ca_file` | PEM file of trusted CA certificates when validation is enabled | none    |","table":"table-3"},"2774":{"id":"/docs/sdk/connection-strings-68","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"| Key                        | Description                                      | Default |\n| -------------------------- | ------------------------------------------------ | ------- |\n| `tls_validate_certificate` | Validate the server certificate (`true`/`false`) | `false` |","table":"table-3"},"2775":{"id":"/docs/sdk/connection-strings-69","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#websocket-options","content":"WebSocket TLS does not validate the server certificate unless `tls_validate_certificate=true`. With validation enabled, `tls_ca_file` replaces the built-in Mozilla roots. Size limits cannot be removed through connection strings. Use the WebSocket configuration object for an unlimited message or frame size."},"2776":{"id":"/docs/sdk/connection-strings-70","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#http-options","content":"| Key                  | Description                 | Default |\n| -------------------- | --------------------------- | ------- |\n| `heartbeat_interval` | Duration between heartbeats | `5s`    |","table":"table-4"},"2777":{"id":"/docs/sdk/connection-strings-71","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#http-options","content":"| Key       | Description                                    | Default |\n| --------- | ---------------------------------------------- | ------- |\n| `retries` | Maximum retries for transient request failures | `3`     |","table":"table-4"},"2778":{"id":"/docs/sdk/connection-strings-72","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#http-options","content":"The HTTP scheme constructs a plain `http://` API URL. Use the Rust HTTP builder's `with_api_url()` for HTTPS. HTTP parses the credential field but does not log in with it. In Rust, call `login_user()` or `login_with_personal_access_token()` explicitly before protected requests."},"2779":{"id":"/docs/sdk/connection-strings-73","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#usage","content":"In Rust, construct clients inside a Tokio runtime, which QUIC needs even before `connect()`. The following snippet assumes an async function returning `Result<_, IggyError>` and the matching Rust SDK setup."},"2780":{"id":"/docs/sdk/connection-strings-74","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#usage","content":"When you need settings a connection string cannot express (client-side encryption, a custom `Partitioner`, and similar), start from `IggyClientBuilder::from_connection_string()` and extend the builder on top."},"2781":{"id":"/docs/sdk/connection-strings-75","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#pending-operation-limits","content":"Rust binary transport strings accept `max_pending_operations` and `max_pending_operation_bytes`. Defaults are 256 operations and 67108864 bytes. Both must be positive. The byte budget includes frozen headers and bodies, so it must fit the largest mutation you need to send."},"2782":{"id":"/docs/sdk/connection-strings-76","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#pending-operation-limits","content":"Committing fetches use a separate pool with the same configured limits. That pool stores target metadata, not reply bodies, and retains unknown progress across sessions. Exhausting a limit rejects or delays further work according to the operation path. See Client failover."},"2783":{"id":"/docs/sdk/connection-strings-77","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#native-sdk-differences","content":"Java accepts only TCP schemes, username/password credentials, `tls` and `tls_ca_file`. It rejects PAT connection strings and other options. Go's `client.ParseConnectionString` returns options for `client.WithTcp`. Node.js constructors accept a string except `SimpleClient`, which wraps an existing raw client. C# exposes its connection-string factory described in the C# guide."},"2784":{"id":"/docs/sdk/connection-strings-78","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#native-sdk-differences","content":"Swift accepts the TCP option names, but checks and then ignores pending mutation limits because it has no retained mutation pool. Its reconnect interval is a full pause between endpoint rounds. Node.js accepts `reestablish_after` for format compatibility without applying a Node equivalent. Do not assume one SDK's parser and timing behavior across all languages."},"2785":{"id":"/docs/sdk/cpp/intro","page_id":"/docs/sdk/cpp/intro","type":"page","content":"C++ SDK","breadcrumbs":["Documentation","SDK","C++"],"tags":[],"url":"/docs/sdk/cpp/intro"},"2786":{"id":"/docs/sdk/cpp/intro-0","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro","content":"The C++ SDK, a CXX bridge over the Rust SDK, and how to build it from source with Bazel."},"2787":{"id":"/docs/sdk/cpp/intro-1","page_id":"/docs/sdk/cpp/intro","type":"heading","tags":[],"url":"/docs/sdk/cpp/intro#building-from-source","content":"Building from source"},"2788":{"id":"/docs/sdk/cpp/intro-2","page_id":"/docs/sdk/cpp/intro","type":"heading","tags":[],"url":"/docs/sdk/cpp/intro#quick-start","content":"Quick start"},"2789":{"id":"/docs/sdk/cpp/intro-3","page_id":"/docs/sdk/cpp/intro","type":"heading","tags":[],"url":"/docs/sdk/cpp/intro#connection-strings","content":"Connection strings"},"2790":{"id":"/docs/sdk/cpp/intro-4","page_id":"/docs/sdk/cpp/intro","type":"heading","tags":[],"url":"/docs/sdk/cpp/intro#helper-types","content":"Helper types"},"2791":{"id":"/docs/sdk/cpp/intro-5","page_id":"/docs/sdk/cpp/intro","type":"heading","tags":[],"url":"/docs/sdk/cpp/intro#current-status","content":"Current status"},"2792":{"id":"/docs/sdk/cpp/intro-6","page_id":"/docs/sdk/cpp/intro","type":"heading","tags":[],"url":"/docs/sdk/cpp/intro#readers-and-recovery","content":"Readers and recovery"},"2793":{"id":"/docs/sdk/cpp/intro-7","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro","content":"The Iggy C++ SDK wraps the Rust SDK through a CXX FFI bridge, so it can use all transport protocols (TCP, QUIC, HTTP, WebSocket) via connection strings. The source code is available at github.com/apache/iggy/tree/master/foreign/cpp."},"2794":{"id":"/docs/sdk/cpp/intro-8","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro","content":"This SDK isn't published to any package registry. Consume it from the monorepo and build it from source with Bazel."},"2795":{"id":"/docs/sdk/cpp/intro-9","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro#building-from-source","content":"The project builds with the Bazel version pinned in `.bazelversion` (`BUILD.bazel` / `MODULE.bazel`). Its Rust bridge uses the Cargo and Rust toolchain provisioned by `rules_rust`, with a separate target directory in the Bazel output tree. Use a compatible Java runtime for Bazel. The pinned Bazel 9.2.0 requires Java 21 or newer."},"2796":{"id":"/docs/sdk/cpp/intro-10","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro#quick-start","content":"The snippet below mirrors the SDK's own end-to-end tests in `foreign/cpp/tests/e2e`. Start a local server on `127.0.0.1:8090` with the `iggy`/`iggy` credentials first. The stream name must not already exist."},"2797":{"id":"/docs/sdk/cpp/intro-11","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro#quick-start","content":"Polling strategies are selected by kind string: `offset`, `timestamp`, `first`, `last`, or `next`. Partitioning kinds for sending are `balanced`, `partition_id`, and `messages_key`."},"2798":{"id":"/docs/sdk/cpp/intro-12","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro#connection-strings","content":"The C++ SDK supports the same connection string format as the Rust SDK:"},"2799":{"id":"/docs/sdk/cpp/intro-13","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro#connection-strings","content":"`iggy::ffi::from_connection_string()` accepts these strings. `new_connection()` instead takes an `IggyClientConfig`: `{}` selects TCP at `127.0.0.1:8090` without automatic login, and its `server_address` field overrides that address. Binary clients authenticate from their connection string during `connect()`. HTTP requires an explicit `login_user()` call. See connection strings for the supported options and credential syntax."},"2800":{"id":"/docs/sdk/cpp/intro-14","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro#helper-types","content":"Beyond the generated `lib.rs.h` FFI surface, `foreign/cpp/include/iggy.hpp` ships typed C++ helpers: `CompressionAlgorithm`, `MaxTopicSize`, `Expiry`, `PollingStrategy`, `IdKind`, `TopicOption`, `SnapshotCompression`, and `SystemSnapshotType`, plus the `IggyException` error type. They construct and validate the kind strings and values the raw FFI calls expect."},"2801":{"id":"/docs/sdk/cpp/intro-15","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro#current-status","content":"The FFI bridge exposes command-level operations for streams, topics, partitions, and segments. Message sending and polling with user headers. Consumer groups and consumer offsets. Stats, client info, and cluster metadata. Snapshots. User create/get/update/delete, permission updates and password changes. Topic option discovery (`describe_options`). And raw binary requests (`send_binary_request`)."},"2802":{"id":"/docs/sdk/cpp/intro-16","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro#current-status","content":"The typed `IggyBlockingClient` also provides resource management, readers, consumers, offsets, user administration and client inspection. Personal access token creation is exposed by the bridge. Use `iggy.hpp` for typed `StreamCreateOptions`, `TopicCreateOptions`, update patches and `PollOptions`."},"2803":{"id":"/docs/sdk/cpp/intro-17","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro#readers-and-recovery","content":"`Reader` reads batches from explicit partitions or a group assignment. `StandaloneConsumer` and `GroupConsumer` yield individual messages. Call `Close` before destruction. Manual commits are the default, and reader waits default to five seconds."},"2804":{"id":"/docs/sdk/cpp/intro-18","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro#readers-and-recovery","content":"`IggyException::OperationId()` identifies retained uncertain operations. `ResolveOperation` retries a mutation with its retained identity, without returning the original payload. `AbandonOperation` frees local state without undoing the result. A lost committing poll reports `fetch_progress_uncertain` and blocks partition progress until abandonment."},"2805":{"id":"/docs/sdk/cpp/intro-19","page_id":"/docs/sdk/cpp/intro","tags":[],"type":"text","url":"/docs/sdk/cpp/intro#readers-and-recovery","content":"The generated bridge passes `ErrorInfo` by reference to mutations, login, polls and recovery calls. Use a separate value for each concurrent call. `GetMetadataChanges` follows the metadata log, and `send_binary_request_to_replica` targets a node for supported non-replicated commands."},"2806":{"id":"/docs/sdk/csharp/examples","page_id":"/docs/sdk/csharp/examples","type":"page","content":"Examples","breadcrumbs":["Documentation","SDK","C#"],"tags":[],"url":"/docs/sdk/csharp/examples"},"2807":{"id":"/docs/sdk/csharp/examples-0","page_id":"/docs/sdk/csharp/examples","tags":[],"type":"text","url":"/docs/sdk/csharp/examples","content":"Producer and consumer samples for the C# SDK, built on the high-level publisher and consumer."},"2808":{"id":"/docs/sdk/csharp/examples-1","page_id":"/docs/sdk/csharp/examples","type":"heading","tags":[],"url":"/docs/sdk/csharp/examples#producer","content":"Producer"},"2809":{"id":"/docs/sdk/csharp/examples-2","page_id":"/docs/sdk/csharp/examples","type":"heading","tags":[],"url":"/docs/sdk/csharp/examples#consumer-group","content":"Consumer group"},"2810":{"id":"/docs/sdk/csharp/examples-3","page_id":"/docs/sdk/csharp/examples","type":"heading","tags":[],"url":"/docs/sdk/csharp/examples#typed-messages","content":"Typed messages"},"2811":{"id":"/docs/sdk/csharp/examples-4","page_id":"/docs/sdk/csharp/examples","type":"heading","tags":[],"url":"/docs/sdk/csharp/examples#more-examples","content":"More examples"},"2812":{"id":"/docs/sdk/csharp/examples-5","page_id":"/docs/sdk/csharp/examples","tags":[],"type":"text","url":"/docs/sdk/csharp/examples","content":"These samples use the High-level SDK - the recommended way to build producers and consumers. For the low-level, per-call equivalents, see the Guide."},"2813":{"id":"/docs/sdk/csharp/examples-6","page_id":"/docs/sdk/csharp/examples","tags":[],"type":"text","url":"/docs/sdk/csharp/examples","content":"Use the installation and server setup first. The snippets share their named resources: run a producer before its corresponding consumer."},"2814":{"id":"/docs/sdk/csharp/examples-7","page_id":"/docs/sdk/csharp/examples","tags":[],"type":"text","url":"/docs/sdk/csharp/examples#producer","content":"A publisher that creates the stream and topic if missing, batches sends in the background, and retries failures:"},"2815":{"id":"/docs/sdk/csharp/examples-8","page_id":"/docs/sdk/csharp/examples","tags":[],"type":"text","url":"/docs/sdk/csharp/examples#consumer-group","content":"A consumer that creates and joins a consumer group, stores each offset after handling the yielded message and requesting the next one, and surfaces polling errors:"},"2816":{"id":"/docs/sdk/csharp/examples-9","page_id":"/docs/sdk/csharp/examples","tags":[],"type":"text","url":"/docs/sdk/csharp/examples#consumer-group","content":"Run several instances of the consumer to see the group load-balance partitions between members."},"2817":{"id":"/docs/sdk/csharp/examples-10","page_id":"/docs/sdk/csharp/examples","tags":[],"type":"text","url":"/docs/sdk/csharp/examples#typed-messages","content":"A typed publisher/consumer pair that (de)serializes a record as JSON. The typed builders are configured via statements rather than one fluent chain - the `With*` methods return the untyped base builder, so `Build()` **must be called on the typed builder variable** (see Typed consumer):"},"2818":{"id":"/docs/sdk/csharp/examples-11","page_id":"/docs/sdk/csharp/examples","tags":[],"type":"text","url":"/docs/sdk/csharp/examples#more-examples","content":"The examples/csharp directory in the Iggy repository contains complete, runnable projects:"},"2819":{"id":"/docs/sdk/csharp/examples-12","page_id":"/docs/sdk/csharp/examples","tags":[],"type":"text","url":"/docs/sdk/csharp/examples#more-examples","content":"**Basic** / **GettingStarted** - low-level producer and consumer"},"2820":{"id":"/docs/sdk/csharp/examples-13","page_id":"/docs/sdk/csharp/examples","tags":[],"type":"text","url":"/docs/sdk/csharp/examples#more-examples","content":"**NewSdk** - high-level `IggyPublisher` / `IggyConsumer` (like the samples above)"},"2821":{"id":"/docs/sdk/csharp/examples-14","page_id":"/docs/sdk/csharp/examples","tags":[],"type":"text","url":"/docs/sdk/csharp/examples#more-examples","content":"**MessageEnvelope** - envelope pattern (message type + JSON payload) over the low-level client"},"2822":{"id":"/docs/sdk/csharp/examples-15","page_id":"/docs/sdk/csharp/examples","tags":[],"type":"text","url":"/docs/sdk/csharp/examples#more-examples","content":"**MessageHeaders** - user-defined message headers"},"2823":{"id":"/docs/sdk/csharp/examples-16","page_id":"/docs/sdk/csharp/examples","tags":[],"type":"text","url":"/docs/sdk/csharp/examples#more-examples","content":"**TcpTls** - TLS-encrypted TCP connection"},"2824":{"id":"/docs/sdk/csharp/examples-17","page_id":"/docs/sdk/csharp/examples","tags":[],"type":"text","url":"/docs/sdk/csharp/examples#more-examples","content":"Repository examples require .NET 10 and reference the local SDK. Build and run from the same checkout as the server:"},"2825":{"id":"/docs/sdk/csharp/examples-18","page_id":"/docs/sdk/csharp/examples","tags":[],"type":"text","url":"/docs/sdk/csharp/examples#more-examples","content":"The getting-started producer sends 50 messages to partition 0. Its consumer reads five nonempty batches and then exits. Envelope and header examples also use five batches. NewSdk uses four partitions and its group consumer runs until stopped."},"2826":{"id":"/docs/sdk/csharp/examples-19","page_id":"/docs/sdk/csharp/examples","tags":[],"type":"text","url":"/docs/sdk/csharp/examples#more-examples","content":"For TcpTls, run from the repository root so `core/certs/iggy_ca_cert.pem` resolves. Start a separate matching server with the example TLS certificate and root credentials:"},"2827":{"id":"/docs/sdk/csharp/guide","page_id":"/docs/sdk/csharp/guide","type":"page","content":"Guide","breadcrumbs":["Documentation","SDK","C#"],"tags":[],"url":"/docs/sdk/csharp/guide"},"2828":{"id":"/docs/sdk/csharp/guide-0","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide","content":"Client configuration and the full low-level IIggyClient API surface for the C# SDK."},"2829":{"id":"/docs/sdk/csharp/guide-1","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#client-configuration","content":"Client configuration"},"2830":{"id":"/docs/sdk/csharp/guide-2","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#iggyclientconfigurator","content":"`IggyClientConfigurator`"},"2831":{"id":"/docs/sdk/csharp/guide-3","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#heartbeat","content":"Heartbeat"},"2832":{"id":"/docs/sdk/csharp/guide-4","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#tlssettings","content":"`TlsSettings`"},"2833":{"id":"/docs/sdk/csharp/guide-5","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"`ReconnectionSettings`"},"2834":{"id":"/docs/sdk/csharp/guide-6","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#autologinsettings","content":"`AutoLoginSettings`"},"2835":{"id":"/docs/sdk/csharp/guide-7","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#message-encryption","content":"Message encryption"},"2836":{"id":"/docs/sdk/csharp/guide-8","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#connection-events","content":"Connection events"},"2837":{"id":"/docs/sdk/csharp/guide-9","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#identifiers","content":"Identifiers"},"2838":{"id":"/docs/sdk/csharp/guide-10","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#authentication","content":"Authentication"},"2839":{"id":"/docs/sdk/csharp/guide-11","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#user-login","content":"User login"},"2840":{"id":"/docs/sdk/csharp/guide-12","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#creating-users","content":"Creating users"},"2841":{"id":"/docs/sdk/csharp/guide-13","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#managing-users","content":"Managing users"},"2842":{"id":"/docs/sdk/csharp/guide-14","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#personal-access-tokens","content":"Personal access tokens"},"2843":{"id":"/docs/sdk/csharp/guide-15","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#streams","content":"Streams"},"2844":{"id":"/docs/sdk/csharp/guide-16","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#topics","content":"Topics"},"2845":{"id":"/docs/sdk/csharp/guide-17","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#topic-options","content":"Topic options"},"2846":{"id":"/docs/sdk/csharp/guide-18","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#partitions","content":"Partitions"},"2847":{"id":"/do