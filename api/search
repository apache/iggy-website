rs/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"json_each_row"},"4236":{"id":"/docs/connectors/sinks/clickhouse-39","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"json_each_row, row_binary, or string"},"4237":{"id":"/docs/connectors/sinks/clickhouse-40","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"string_format"},"4238":{"id":"/docs/connectors/sinks/clickhouse-41","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"string"},"4239":{"id":"/docs/connectors/sinks/clickhouse-42","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"json_each_row"},"4240":{"id":"/docs/connectors/sinks/clickhouse-43","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"ClickHouse format for string mode: json_each_row, csv, or tsv"},"4241":{"id":"/docs/connectors/sinks/clickhouse-44","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"timeout_seconds"},"4242":{"id":"/docs/connectors/sinks/clickhouse-45","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"u64"},"4243":{"id":"/docs/connectors/sinks/clickhouse-46","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"30"},"4244":{"id":"/docs/connectors/sinks/clickhouse-47","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"HTTP request timeout in seconds"},"4245":{"id":"/docs/connectors/sinks/clickhouse-48","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"max_retries"},"4246":{"id":"/docs/connectors/sinks/clickhouse-49","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"u32"},"4247":{"id":"/docs/connectors/sinks/clickhouse-50","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"3"},"4248":{"id":"/docs/connectors/sinks/clickhouse-51","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"Total attempts for startup requests and transient insert errors; at least one even when 0"},"4249":{"id":"/docs/connectors/sinks/clickhouse-52","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"retry_delay"},"4250":{"id":"/docs/connectors/sinks/clickhouse-53","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"u64"},"4251":{"id":"/docs/connectors/sinks/clickhouse-54","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"1"},"4252":{"id":"/docs/connectors/sinks/clickhouse-55","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"Base for exponential retry delay, in seconds"},"4253":{"id":"/docs/connectors/sinks/clickhouse-56","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"verbose_logging"},"4254":{"id":"/docs/connectors/sinks/clickhouse-57","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"bool"},"4255":{"id":"/docs/connectors/sinks/clickhouse-58","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"false"},"4256":{"id":"/docs/connectors/sinks/clickhouse-59","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"Log inserts at info level instead of debug"},"4257":{"id":"/docs/connectors/sinks/clickhouse-60","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"json_each_row (default): accepts JSON payloads. Each payload is serialized on its own line using ClickHouse's JSONEachRow format. Send JSON objects whose fields and values are compatible with the existing table and its ClickHouse input settings. The connector does not validate JSON rows against the table schema before sending them."},"4258":{"id":"/docs/connectors/sinks/clickhouse-61","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"row_binary: accepts JSON payloads and serializes them to ClickHouse's RowBinaryWithDefaults binary format, which is more efficient than JSON at high volume. The table must already exist. Its schema is fetched from system.columns and validated at startup. Requires ClickHouse 23.7 or newer, which introduced this format. Columns with a DEFAULT expression may be omitted from messages. An explicit JSON null requires a nullable column and is stored as NULL, even when that column has a default. Missing columns without defaults must be nullable. MATERIALIZED, ALIAS, and EPHEMERAL columns are dropped from the schema. Unsupported column types (128/256-bit integers, Variant, native JSON, geo types) cause startup to fail."},"4259":{"id":"/docs/connectors/sinks/clickhouse-62","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"string: accepts text payloads and appends a newline to each payload that does not already end with one. Set the stream schema = \"text\". Use string_format to tell ClickHouse which format the payload is in (csv, tsv, or json_each_row)."},"4260":{"id":"/docs/connectors/sinks/clickhouse-63","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"In row_binary mode the schema is captured once at startup and the insert stream is positional. An ALTER TABLE on the target while the connector runs can silently corrupt inserted rows, so restart the connector after any schema change. The self-describing json_each_row format (including string mode with string_format = \"json_each_row\") maps values by field name, but changed column names, types, or constraints can still make inserts fail. string passthrough with csv or tsv sends plain positional ClickHouse formats mapped by the current table column order."},"4261":{"id":"/docs/connectors/sinks/clickhouse-64","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#error-handling--delivery-semantics","content":"Insert requests retry HTTP 408, 429, and 5xx responses, plus network and timeout errors. Other unsuccessful HTTP statuses fail immediately. max_retries is the total attempt limit, with at least one attempt even when set to 0. Before retry number n (starting at 1), the delay is sampled from zero through min(retry_delay * 2^n, 60) seconds. With the defaults, there are at most three attempts and the first retry waits between zero and two seconds. The startup ping and, in row_binary mode, schema fetch use the same limit and backoff but retry every error."},"4262":{"id":"/docs/connectors/sinks/clickhouse-65","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#error-handling--delivery-semantics","content":"A message whose payload type does not match the chosen format is skipped with an error log; the rest of the batch is still sent. A batch with no serializable payloads returns success without an insert. In row_binary mode, a JSON row whose values cannot be converted to the column types fails the whole batch before any insert request, so it does not enter the plugin's insert retry loop."},"4263":{"id":"/docs/connectors/sinks/clickhouse-66","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#error-handling--delivery-semantics","content":"The runtime uses consumer auto-commit and does not replay a failed sink batch; see sink guide. End-to-end at-least-once delivery is therefore not guaranteed. Plugin retries resend the same batch without an insert_deduplication_token, so a lost acknowledgement can also produce duplicate rows."},"4264":{"id":"/docs/connectors/sinks/clickhouse-67","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#error-handling--delivery-semantics","content":"ClickHouse deduplication depends on the table engine, query settings, identical retry data, and the retained deduplication window. ReplicatedMergeTree enables a deduplication log by default. Non-replicated MergeTree can also deduplicate when non_replicated_deduplication_window is positive; its default is zero. See ClickHouse insert deduplication for the settings and limits."},"4265":{"id":"/docs/connectors/sinks/clickhouse-68","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#transforms","content":"Transforms can be applied before inserting into ClickHouse. See the transforms documentation for the available types and their configuration."},"4266":{"id":"/docs/connectors/sinks/delta","page_id":"/docs/connectors/sinks/delta","type":"page","content":"Delta Lake Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/delta"},"4267":{"id":"/docs/connectors/sinks/delta-0","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta","content":"Write messages from Iggy streams into Delta Lake tables on local disk, S3, Azure Blob Storage or Google Cloud Storage."},"4268":{"id":"/docs/connectors/sinks/delta-1","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#configuration","content":"Configuration"},"4269":{"id":"/docs/connectors/sinks/delta-2","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#options","content":"Options"},"4270":{"id":"/docs/connectors/sinks/delta-3","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#s3-example","content":"S3 example"},"4271":{"id":"/docs/connectors/sinks/delta-4","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#type-coercion","content":"Type Coercion"},"4272":{"id":"/docs/connectors/sinks/delta-5","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#batching--transactions","content":"Batching & Transactions"},"4273":{"id":"/docs/connectors/sinks/delta-6","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#transforms","content":"Transforms"},"4274":{"id":"/docs/connectors/sinks/delta-7","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta","content":"The Delta Lake sink connector consumes messages from Iggy streams and writes them to Delta Lake tables on the local filesystem, AWS S3, Azure Blob Storage, or Google Cloud Storage. Each successful nonempty batch is flushed and appended in one Delta transaction."},"4275":{"id":"/docs/connectors/sinks/delta-8","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta","content":"This page is a curated subset of the documentation. The canonical reference is the upstream delta_sink README in the apache/iggy repository."},"4276":{"id":"/docs/connectors/sinks/delta-9","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#configuration","content":"Use the broker credentials and runtime setup from the sink guide. Save the configuration below in the runtime's connector directory. From the matching 0.9.0/edge repository root, build the plugin:"},"4277":{"id":"/docs/connectors/sinks/delta-10","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#configuration","content":"Create the target table with your Delta Lake tools before starting the connector. The table must already exist at table_uri: the connector opens it at startup and fails if it's missing. It doesn't create tables. Only JSON payloads are supported (schema = \"json\" on the stream). A batch containing another payload type fails."},"4278":{"id":"/docs/connectors/sinks/delta-11","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#configuration","content":"For a table with columns id (long) and name (string), create the Iggy resources and send a row:"},"4279":{"id":"/docs/connectors/sinks/delta-12","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#configuration","content":"Use a file:///... URI for an absolute local path; bare filesystem paths are not accepted."},"4280":{"id":"/docs/connectors/sinks/delta-13","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Option"},"4281":{"id":"/docs/connectors/sinks/delta-14","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Type"},"4282":{"id":"/docs/connectors/sinks/delta-15","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Default"},"4283":{"id":"/docs/connectors/sinks/delta-16","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Description"},"4284":{"id":"/docs/connectors/sinks/delta-17","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"table_uri"},"4285":{"id":"/docs/connectors/sinks/delta-18","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"string"},"4286":{"id":"/docs/connectors/sinks/delta-19","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"required"},"4287":{"id":"/docs/connectors/sinks/delta-20","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Absolute URI of the Delta table: file://, s3://, az://, or gs://"},"4288":{"id":"/docs/connectors/sinks/delta-21","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"storage_backend_type"},"4289":{"id":"/docs/connectors/sinks/delta-22","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"string"},"4290":{"id":"/docs/connectors/sinks/delta-23","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"none"},"4291":{"id":"/docs/connectors/sinks/delta-24","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"s3, azure, or gcs. Omit for local filesystem tables"},"4292":{"id":"/docs/connectors/sinks/delta-25","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"When storage_backend_type selects a backend, the connector validates these credential options:"},"4293":{"id":"/docs/connectors/sinks/delta-26","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"S3: aws_s3_access_key, aws_s3_secret_key, and aws_s3_region are required. aws_s3_endpoint_url is optional, for S3-compatible stores like MinIO. aws_s3_allow_http is optional and defaults to false."},"4294":{"id":"/docs/connectors/sinks/delta-27","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Azure: azure_storage_account_name, azure_container_name, and either azure_storage_account_key or azure_storage_sas_token (not both)."},"4295":{"id":"/docs/connectors/sinks/delta-28","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"GCS: gcs_service_account_key (the service account JSON as a string, with the bucket taken from the gs:// URI)."},"4296":{"id":"/docs/connectors/sinks/delta-29","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"JSON values are coerced to the Delta table schema before writing:"},"4297":{"id":"/docs/connectors/sinks/delta-30","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"Timestamp columns: ISO 8601 / RFC 3339 strings (e.g. \"2021-11-11T22:11:58Z\") are converted to microsecond timestamps. Integer timestamps pass through as epoch microseconds. Space-separated timestamps such as \"2021-11-11 22:11:58\" are interpreted as UTC. Invalid timestamp strings fail the batch."},"4298":{"id":"/docs/connectors/sinks/delta-31","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"String columns: non-null, non-string values are converted to their JSON string representation. Nulls remain null."},"4299":{"id":"/docs/connectors/sinks/delta-32","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"Coercions cover nested structs, arrays of strings or timestamps, and arrays of structs. Nested arrays, maps, and variant columns pass through without these coercions."},"4300":{"id":"/docs/connectors/sinks/delta-33","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"The table schema is captured once at startup and not refreshed, so restart the connector after changing it."},"4301":{"id":"/docs/connectors/sinks/delta-34","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#batching--transactions","content":"Each nonempty batch passed to the plugin is written to Parquet buffers and appended in a single Delta log transaction. Empty batches create no transaction in consume(). The stream's batch_length is a polling limit, so it influences Delta commit granularity: small batches produce many small files and table versions, so prefer larger batches for production tables (and compact periodically). The plugin has no retry loop for failed batches, though the Delta library retries eligible commit conflicts and storage requests. A write or commit failure clears the writer buffers and returns a connector error. The runtime uses consumer auto-commit and does not replay that failed batch, so the Delta transaction does not provide an end-to-end at-least-once guarantee."},"4302":{"id":"/docs/connectors/sinks/delta-35","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#transforms","content":"Transforms can be applied before writing to Delta Lake. See the transforms documentation for the available types and their configuration."},"4303":{"id":"/docs/connectors/sinks/doris","page_id":"/docs/connectors/sinks/doris","type":"page","content":"Apache Doris Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/doris"},"4304":{"id":"/docs/connectors/sinks/doris-0","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris","content":"Load JSON messages from Iggy streams into a pre-created Apache Doris table through the Stream Load HTTP API."},"4305":{"id":"/docs/connectors/sinks/doris-1","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#configuration","content":"Configuration"},"4306":{"id":"/docs/connectors/sinks/doris-2","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#common-options","content":"Common Options"},"4307":{"id":"/docs/connectors/sinks/doris-3","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#output-formats","content":"Output Formats"},"4308":{"id":"/docs/connectors/sinks/doris-4","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#delivery-semantics","content":"Delivery Semantics"},"4309":{"id":"/docs/connectors/sinks/doris-5","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#security-notes","content":"Security Notes"},"4310":{"id":"/docs/connectors/sinks/doris-6","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#transforms","content":"Transforms"},"4311":{"id":"/docs/connectors/sinks/doris-7","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris","content":"The Apache Doris sink connector consumes JSON messages from Iggy streams and writes them to a pre-created Doris table via Doris's Stream Load HTTP API. Batches are loaded under deterministic labels so that retries deduplicate while Doris retains those labels."},"4312":{"id":"/docs/connectors/sinks/doris-8","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris","content":"This page is a curated subset of the documentation. The canonical reference, including the label scheme, redirect security model, and operational guidance, is the upstream doris_sink README in the apache/iggy repository."},"4313":{"id":"/docs/connectors/sinks/doris-9","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#configuration","content":"Use the broker credentials and runtime setup from the sink guide. Save the configuration below in the runtime's connector directory and replace the Doris password with your own. From the matching 0.9.0/edge repository root, build the plugin:"},"4314":{"id":"/docs/connectors/sinks/doris-10","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#configuration","content":"The target database and table must be pre-created. The connector never issues DDL. database and table must match [A-Za-z0-9_]+ or startup fails. Streams must use schema = \"json\". Startup validates the configuration but does not check the table or connection; these are first used when a batch arrives."},"4315":{"id":"/docs/connectors/sinks/doris-11","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#configuration","content":"For a table with columns id (BIGINT) and name (STRING), create the Iggy resources and send a row:"},"4316":{"id":"/docs/connectors/sinks/doris-12","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Option"},"4317":{"id":"/docs/connectors/sinks/doris-13","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Type"},"4318":{"id":"/docs/connectors/sinks/doris-14","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Default"},"4319":{"id":"/docs/connectors/sinks/doris-15","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Description"},"4320":{"id":"/docs/connectors/sinks/doris-16","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"fe_url"},"4321":{"id":"/docs/connectors/sinks/doris-17","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"4322":{"id":"/docs/connectors/sinks/doris-18","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"required"},"4323":{"id":"/docs/connectors/sinks/doris-19","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Doris frontend HTTP base URL, e.g. http://localhost:8030"},"4324":{"id":"/docs/connectors/sinks/doris-20","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"database"},"4325":{"id":"/docs/connectors/sinks/doris-21","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"4326":{"id":"/docs/connectors/sinks/doris-22","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"required"},"4327":{"id":"/docs/connectors/sinks/doris-23","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Target database, [A-Za-z0-9_]+"},"4328":{"id":"/docs/connectors/sinks/doris-24","page_id":"/docs/connect