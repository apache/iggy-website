d":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"13"},"1003":{"id":"/docs/binary-protocol/encodings-72","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"Uint128"},"1004":{"id":"/docs/binary-protocol/encodings-73","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"6"},"1005":{"id":"/docs/binary-protocol/encodings-74","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"Int32"},"1006":{"id":"/docs/binary-protocol/encodings-75","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"14"},"1007":{"id":"/docs/binary-protocol/encodings-76","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"Float32"},"1008":{"id":"/docs/binary-protocol/encodings-77","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"7"},"1009":{"id":"/docs/binary-protocol/encodings-78","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"Int64"},"1010":{"id":"/docs/binary-protocol/encodings-79","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"15"},"1011":{"id":"/docs/binary-protocol/encodings-80","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"Float64"},"1012":{"id":"/docs/binary-protocol/encodings-81","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"8"},"1013":{"id":"/docs/binary-protocol/encodings-82","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"Int128"},"1014":{"id":"/docs/binary-protocol/encodings-83","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#header-kinds","content":"Integers are little-endian. Bool is one byte."},"1015":{"id":"/docs/binary-protocol/encodings-84","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#user-headers-block","content":"A user headers block (inside a message frame) is a flat run of TLV fields:"},"1016":{"id":"/docs/binary-protocol/encodings-85","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#user-headers-block","content":"Fields pair up: first the key, then the value. Keys and values can both use the header kinds above. Every length must be 1..=255, kind 0 is rejected, and the block must consume its byte range exactly. The wire validator preserves unknown non-zero kind codes. A typed SDK accessor may still reject a kind it does not recognize."},"1017":{"id":"/docs/binary-protocol/encodings-86","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"CreateStream, CreateTopic, CreateUser and UpdateResource end with a key-value options block that reuses the user-headers TLV encoding. The block runs from its start to the end of the payload (no length prefix, and the validator requires exact consumption) and may be empty."},"1018":{"id":"/docs/binary-protocol/encodings-87","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"On top of the TLV walk, options enforce: string keys only (kind 2, valid UTF-8), no duplicate keys, at most 1024 entries, and at most 100000 bytes total."},"1019":{"id":"/docs/binary-protocol/encodings-88","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"Semantics:"},"1020":{"id":"/docs/binary-protocol/encodings-89","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"Create requests resolve absent keys to server defaults and persist the effective values. Updates use explicit reset keys to restore defaults. Zero retention sentinels do not reset a value. See update semantics."},"1021":{"id":"/docs/binary-protocol/encodings-90","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"Update requests are patches: keys absent from the block are left alone, never reset. A client built before a key existed cannot erase it."},"1022":{"id":"/docs/binary-protocol/encodings-91","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"Unknown keys are rejected at the wire edge, never silently skipped."},"1023":{"id":"/docs/binary-protocol/encodings-92","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#options-block","content":"The catalog is discoverable with DescribeOptions, code 13, using scope 1 for topics, 2 for streams and 3 for users. All three catalogs have entries. Stream keys are create-only and secret. Stream and topic names and user identity/status can be updated. Topic retention fields can be reset, while compression and storage policies are fixed at creation. See Topic options and Stream options."},"1024":{"id":"/docs/binary-protocol/encodings-93","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"The compression_algorithm value used by topic options:"},"1025":{"id":"/docs/binary-protocol/encodings-94","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"Code / name"},"1026":{"id":"/docs/binary-protocol/encodings-95","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"Algorithm"},"1027":{"id":"/docs/binary-protocol/encodings-96","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"1, none"},"1028":{"id":"/docs/binary-protocol/encodings-97","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"No compression (default)"},"1029":{"id":"/docs/binary-protocol/encodings-98","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"2, gzip"},"1030":{"id":"/docs/binary-protocol/encodings-99","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"Gzip"},"1031":{"id":"/docs/binary-protocol/encodings-100","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#compression","content":"Any other value is rejected. The option is a placeholder today: the value is validated, persisted, and echoed back, but it does not enable automatic payload compression or decompression. To compress today, do it client-side and tag messages via user headers - see the message headers examples in the Iggy repo."},"1032":{"id":"/docs/binary-protocol/encodings-101","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#partition-context","content":"A served partition context is 24 bytes:"},"1033":{"id":"/docs/binary-protocol/encodings-102","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#partition-context","content":"The incarnation identifies the partition history. The owner generation identifies group ownership and is zero for ordinary consumers. The metadata operation establishes the minimum metadata needed to interpret the context. Poll replies, continuations and checkpoints preserve these fields."},"1034":{"id":"/docs/binary-protocol/encodings-103","page_id":"/docs/binary-protocol/encodings","tags":[],"type":"text","url":"/docs/binary-protocol/encodings#option-catalog-flags","content":"DescribeOptions entries report mutability and visibility. Bit 0 means updatable, bit 1 resettable, bit 2 secret, bit 3 read-only and bit 4 critical. A critical key must be understood before a node serves the resource. Unknown client option keys are rejected."},"1035":{"id":"/docs/binary-protocol/framing","page_id":"/docs/binary-protocol/framing","type":"page","content":"Framing","breadcrumbs":["Documentation","Binary Protocol"],"tags":[],"url":"/docs/binary-protocol/framing"},"1036":{"id":"/docs/binary-protocol/framing-0","page_id":"/docs/binary-protocol/framing","tags":[],"type":"text","url":"/docs/binary-protocol/framing","content":"The fixed 256-byte header every binary-transport message rides in, and the request, reply and eviction shapes it carries."},"1037":{"id":"/docs/binary-protocol/framing-1","page_id":"/docs/binary-protocol/framing","type":"heading","tags":[],"url":"/docs/binary-protocol/framing#requestheader","content":"RequestHeader"},"1038":{"id":"/docs/binary-protocol/framing-2","page_id":"/docs/binary-protocol/framing","type":"heading","tags":[],"url":"/docs/binary-protocol/framing#operation-discriminants","content":"Operation discriminants"},"1039":{"id":"/docs/binary-protocol/framing-3","page_id":"/docs/binary-protocol/framing","type":"heading","tags":[],"url":"/docs/binary-protocol/framing#request-numbering","content":"Request numbering"},"1040":{"id":"/docs/binary-protocol/framing-4","page_id":"