                 | Description                |\n| -------------------- | -------------------------- |\n| `get_consumer_group` | Get consumer group details |","table":"table-6"},"64":{"id":"/docs/ai/mcp-56","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#consumer-groups","content":"| Tool                    | Description             |\n| ----------------------- | ----------------------- |\n| `create_consumer_group` | Create a consumer group |","table":"table-6"},"65":{"id":"/docs/ai/mcp-57","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#consumer-groups","content":"| Tool                    | Description             |\n| ----------------------- | ----------------------- |\n| `delete_consumer_group` | Delete a consumer group |","table":"table-6"},"66":{"id":"/docs/ai/mcp-58","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#consumer-offsets","content":"| Tool                  | Description                |\n| --------------------- | -------------------------- |\n| `get_consumer_offset` | Get stored consumer offset |","table":"table-7"},"67":{"id":"/docs/ai/mcp-59","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#consumer-offsets","content":"| Tool                    | Description           |\n| ----------------------- | --------------------- |\n| `store_consumer_offset` | Store consumer offset |","table":"table-7"},"68":{"id":"/docs/ai/mcp-60","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#consumer-offsets","content":"| Tool                     | Description            |\n| ------------------------ | ---------------------- |\n| `delete_consumer_offset` | Delete consumer offset |","table":"table-7"},"69":{"id":"/docs/ai/mcp-61","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#users--access-tokens","content":"| Tool        | Description |\n| ----------- | ----------- |\n| `get_users` | List users  |","table":"table-8"},"70":{"id":"/docs/ai/mcp-62","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#users--access-tokens","content":"| Tool       | Description      |\n| ---------- | ---------------- |\n| `get_user` | Get user details |","table":"table-8"},"71":{"id":"/docs/ai/mcp-63","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#users--access-tokens","content":"| Tool          | Description   |\n| ------------- | ------------- |\n| `create_user` | Create a user |","table":"table-8"},"72":{"id":"/docs/ai/mcp-64","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#users--access-tokens","content":"| Tool          | Description         |\n| ------------- | ------------------- |\n| `update_user` | Update user details |","table":"table-8"},"73":{"id":"/docs/ai/mcp-65","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#users--access-tokens","content":"| Tool          | Description   |\n| ------------- | ------------- |\n| `delete_user` | Delete a user |","table":"table-8"},"74":{"id":"/docs/ai/mcp-66","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#users--access-tokens","content":"| Tool                 | Description             |\n| -------------------- | ----------------------- |\n| `update_permissions` | Update user permissions |","table":"table-8"},"75":{"id":"/docs/ai/mcp-67","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#users--access-tokens","content":"| Tool              | Description          |\n| ----------------- | -------------------- |\n| `change_password` | Change user password |","table":"table-8"},"76":{"id":"/docs/ai/mcp-68","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#users--access-tokens","content":"| Tool                         | Description |\n| ---------------------------- | ----------- |\n| `get_personal_access_tokens` | List PATs   |","table":"table-8"},"77":{"id":"/docs/ai/mcp-69","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#users--access-tokens","content":"| Tool                           | Description  |\n| ------------------------------ | ------------ |\n| `create_personal_access_token` | Create a PAT |","table":"table-8"},"78":{"id":"/docs/ai/mcp-70","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#users--access-tokens","content":"| Tool                           | Description  |\n| ------------------------------ | ------------ |\n| `delete_personal_access_token` | Delete a PAT |","table":"table-8"},"79":{"id":"/docs/ai/mcp-71","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#resource-options","content":"Create and update tools use the current resource option contract. Updates change only supplied fields and reset keys. Stream keys are create-only and never returned. Topic compression and storage policies cannot change after creation. Tool schemas describe the accepted fields."},"80":{"id":"/docs/ai/mcp-72","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#permissions","content":"The `[permissions]` section provides a first layer of access control, checked before any request is forwarded to the Iggy server. This lets you restrict the MCP server to read-only operations, for example:"},"81":{"id":"/docs/ai/mcp-73","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#permissions","content":"`poll_messages` requires `update` as well as `read` when `auto_commit` is true or the `next` strategy is used. The `next` strategy enables auto-commit automatically. Storing an offset requires `update`. Deleting an offset requires `delete`. PAT creation and deletion require `create` and `delete`, respectively."},"82":{"id":"/docs/ai/mcp-74","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#permissions","content":"On top of this, the Iggy user account used by the MCP server has its own granular permissions. For production use, create a dedicated user with the minimum required permissions."},"83":{"id":"/docs/ai/mcp-75","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#claude-desktop-integration","content":"Set `command` to the absolute path of the built `iggy-mcp` executable. This Claude Desktop example uses the broker and development credentials from the getting started guide:"},"84":{"id":"/docs/ai/mcp-76","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#docker","content":"Create a shared network and start a development broker that advertises its container name:"},"85":{"id":"/docs/ai/mcp-77","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#docker","content":"After the broker is ready, run the MCP server on the same network:"},"86":{"id":"/docs/ai/mcp-78","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#docker","content":"The HTTP endpoint uses the configured Iggy account for every MCP client. This example publishes it only on the host loopback interface."},"87":{"id":"/docs/ai/mcp-79","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#docker","content":"The default HTTP address is `127.0.0.1:8082`, which inside a container is unreachable from the outside, so `IGGY_MCP_HTTP_ADDRESS=0.0.0.0:8082` is required for the published port to work."},"88":{"id":"/docs/ai/mcp-80","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#systemd-integration","content":"Build with the `systemd` cargo feature to enable systemd readiness and watchdog notifications:"},"89":{"id":"/docs/ai/mcp-81","page_id":"/docs/ai/mcp","tags":[],"type":"text","url":"/docs/ai/mcp#systemd-integration","content":"Readiness is sent after the HTTP listener starts or the stdio MCP session initializes. When systemd enables the watchdog, the server sends keep-alive notifications at half the configured watchdog interval. SIGINT, SIGTERM, or stdio client disconnect stops the server and sends a stopping notification."},"90":{"id":"/docs/binary-protocol/cluster","page_id":"/docs/binary-protocol/cluster","type":"page","content":"Server-to-server","breadcrumbs":["Documentation","Binary Protocol"],"tags":[],"url":"/docs/binary-protocol/cluster"},"91":{"id":"/docs/binary-protocol/cluster-0","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster","content":"Replica links, consensus commands, history fences and the header layouts used by Apache Iggy 0.10.0."},"92":{"id":"/docs/binary-protocol/cluster-1","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#transport","content":"Transport"},"93":{"id":"/docs/binary-protocol/cluster-2","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#handshake","content":"Handshake"},"94":{"id":"/docs/binary-protocol/cluster-3","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#command-discriminants","content":"Command discriminants"},"95":{"id":"/docs/binary-protocol/cluster-4","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#consensus-and-history","content":"Consensus and history"},"96":{"id":"/docs/binary-protocol/cluster-5","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#frame-integrity","content":"Frame integrity"},"97":{"id":"/docs/binary-protocol/cluster-6","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#header-layouts","content":"Header layouts"},"98":{"id":"/docs/binary-protocol/cluster-7","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#prepareheader","content":"PrepareHeader"},"99":{"id":"/docs/binary-protocol/cluster-8","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#prepareokheader","content":"PrepareOkHeader"},"100":{"id":"/docs/binary-protocol/cluster-9","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#commitheader","content":"CommitHeader"},"101":{"id":"/docs/binary-protocol/cluster-10","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#commitreplyheader","content":"CommitReplyHeader"},"102":{"id":"/docs/binary-protocol/cluster-11","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#prepareprogressheader","content":"PrepareProgressHeader"},"103":{"id":"/docs/binary-protocol/cluster-12","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#startviewchangeheader","content":"StartViewChangeHeader"},"104":{"id":"/docs/binary-protocol/cluster-13","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#doviewchangeheader","content":"DoViewChangeHeader"},"105":{"id":"/docs/binary-protocol/cluster-14","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#startviewheader","content":"StartViewHeader"},"106":{"id":"/docs/binary-protocol/cluster-15","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#requeststartviewheader","content":"RequestStartViewHeader"},"107":{"id":"/docs/binary-protocol/cluster-16","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#requestpreparesheader","content":"RequestPreparesHeader"},"108":{"id":"/docs/binary-protocol/cluster-17","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#repairrangereplyheader","content":"RepairRangeReplyHeader"},"109":{"id":"/docs/binary-protocol/cluster-18","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#requeststatetransferheader","content":"RequestStateTransferHeader"},"110":{"id":"/docs/binary-protocol/cluster-19","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#statetransfertargetheader","content":"StateTransferTargetHeader"},"111":{"id":"/docs/binary-protocol/cluster-20","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#requeststatechunkheader","content":"RequestStateChunkHeader"},"112":{"id":"/docs/binary-protocol/cluster-21","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#statechunkheader","content":"StateChunkHeader"},"113":{"id":"/docs/binary-protocol/cluster-22","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#forwardregisterheader","content":"ForwardRegisterHeader"},"114":{"id":"/docs/binary-protocol/cluster-23","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#forwardregisterresultheader","content":"ForwardRegisterResultHeader"},"115":{"id":"/docs/binary-protocol/cluster-24","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#forwardlogoutheader","content":"ForwardLogoutHeader"},"116":{"id":"/docs/binary-protocol/cluster-25","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#forwardlogoutresultheader","content":"ForwardLogoutResultHeader"},"117":{"id":"/docs/binary-protocol/cluster-26","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#forwardcompletionheader","content":"ForwardCompletionHeader"},"118":{"id":"/docs/binary-protocol/cluster-27","page_id":"/docs/binary-protocol/cluster","type":"heading","tags":[],"url":"/docs/binary-protocol/cluster#repair-and-state-transfer","content":"Repair and state transfer"},"119":{"id":"/docs/binary-protocol/cluster-28","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster","content":"Replicas use dedicated TCP listeners and 256-byte headers. Client listeners reject replica control commands. The replica protocol has no mixed-version upgrade path. Run the same server version and `replica_connections_per_peer` on every node."},"120":{"id":"/docs/binary-protocol/cluster-29","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#transport","content":"The roster supplies each node's `tcp_replica` port and literal IP address. Lower replica IDs dial higher IDs. Each pair can use several links, which distribute traffic across shards. The default frame limit is 64 MiB through `message_bus.max_message_size`."},"121":{"id":"/docs/binary-protocol/cluster-30","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#transport","content":"Each connection starts with an eight-byte placement preamble before TLS and the replica handshake:"},"122":{"id":"/docs/binary-protocol/cluster-31","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#transport","content":"The preamble selects a shard and is not authentication. ReplicaHello repeats the peer and link identity and supplies the link count. The acceptor rejects a mismatch. With authentication enabled, placement fields participate in the handshake MAC. Shard counts can differ between nodes."},"123":{"id":"/docs/binary-protocol/cluster-32","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#handshake","content":"ReplicaHello, ReplicaChallenge and ReplicaFinish establish the connection. `[cluster.auth]` enables the shared-key BLAKE3 MAC. `[cluster.tls]` encrypts traffic with TLS 1.3 and ALPN `iggy-replica`. TLS requires replica authentication. See Cluster security for configuration and key rotation."},"124":{"id":"/docs/binary-protocol/cluster-33","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#command-discriminants","content":"The `command` byte is at offset 60. This is the complete registry, including client commands:"},"125":{"id":"/docs/binary-protocol/cluster-34","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#command-discriminants","content":"| Value | Command    |\n| ----- | ---------- |\n| 0     | `Reserved` |","table":"table-0"},"126":{"id":"/docs/binary-protocol/cluster-35","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#command-discriminants","content":"| Value | Command |\n| ----- | ------- |\n| 1     | `Ping`  |","table":"table-0"},"127":{"id":"/docs/binary-protocol/cluster-36","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#command-discriminants","content":"| Value | Command |\n| ----- | ------- |\n| 2     | `Pong`  |","table":"table-0"},"128":{"id":"/docs/binary-protocol/cluster-37","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#command-discriminants","content":"| Value | Command      |\n| ----- | ------------ |\n| 3     | `PingClient` |","table":"table-0"},"129":{"id":"/docs/binary-protocol/cluster-38","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#command-discriminants","content":"| Value | Command      |\n| ----- | ------------ |\n| 4     | `PongClient` |","table":"table-0"},"130":{"id":"/docs/binary-protocol/cluster-39","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#command-discriminants","content":"| Value | Command   |\n| ----- | --------- |\n| 5     | `Request` |","table":"table-0"},"131":{"id":"/docs/binary-protocol/cluster-40","page_id":"/docs/