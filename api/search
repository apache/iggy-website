page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"In cluster mode, followers forward control-plane requests (streams, topics, users, and so on) to the current primary when a cluster-wide JWT key exists (see [http.jwt] below). Forwarding does not cover the partition plane: message produce and consumer-offset writes must reach the partition's primary node directly, while message polls read locally on any node."},"2673":{"id":"/docs/server/configuration-103","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"Key"},"2674":{"id":"/docs/server/configuration-104","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"Default"},"2675":{"id":"/docs/server/configuration-105","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"Description"},"2676":{"id":"/docs/server/configuration-106","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"enabled"},"2677":{"id":"/docs/server/configuration-107","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"true"},"2678":{"id":"/docs/server/configuration-108","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"Handle cross-origin requests with the rules below."},"2679":{"id":"/docs/server/configuration-109","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"allowed_methods"},"2680":{"id":"/docs/server/configuration-110","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"[\"GET\", \"POST\", \"PUT\", \"DELETE\"]"},"2681":{"id":"/docs/server/configuration-111","pag