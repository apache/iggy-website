ors/sinks/postgres#plugin-config-options","content":"Base for linear retry delays; invalid values silently fall back to 1s"},"4861":{"id":"/docs/connectors/sinks/postgres-73","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"The payload_format option determines the type of the payload column and how the message payload is stored:"},"4862":{"id":"/docs/connectors/sinks/postgres-74","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"Format"},"4863":{"id":"/docs/connectors/sinks/postgres-75","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"Column Type"},"4864":{"id":"/docs/connectors/sinks/postgres-76","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"Description"},"4865":{"id":"/docs/connectors/sinks/postgres-77","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"bytea"},"4866":{"id":"/docs/connectors/sinks/postgres-78","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"BYTEA"},"4867":{"id":"/docs/connectors/sinks/postgres-79","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"Bytes after stream decoding and transforms (default). Use schema = \"raw\" and no payload-changing transform to preserve original bytes."},"4868":{"id":"/docs/connectors/sinks/postgres-80","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"json / jsonb"},"4869":{"id":"/docs/connectors/sinks/postgres-81","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"JSONB"},"4870":{"id":"/docs/connectors/sinks/postgres-82","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"Native JSON. Enables JSON operators and GIN indexing. Payload must be valid JSON accepted by PostgreSQL JSONB."},"4871":{"id":"/docs/connectors/sinks/postgres-83","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"text"},"4872":{"id":"/docs/connectors/sinks/postgres-84","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"TEXT"},"4873":{"id":"/docs/connectors/sinks/postgres-85","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"UTF-8 text. Payload must be valid UTF-8 accepted by PostgreSQL TEXT."},"4874":{"id":"/docs/connectors/sinks/postgres-86","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"Format names are case-insensitive; unrecognized names silently use bytea. JSONB accepts objects, arrays and scalars, but PostgreSQL rejects \\u0000 in JSONB and zero bytes in TEXT. JSON decoding and JSONB storage can change the original representation. Message headers are not stored. See PostgreSQL JSON types for JSONB restrictions."},"4875":{"id":"/docs/connectors/sinks/postgres-87","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"With the default bytea format, valid UTF-8 JSON payloads can still be queried by converting the bytes: convert_from(payload, 'UTF8')::jsonb->>'user_id'. With json, the native operators apply directly: payload->>'user_id'."},"4876":{"id":"/docs/connectors/sinks/postgres-88","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#table-schema","content":"With auto_create_table = true and all three metadata flags enabled, the connector creates the following structure if the table is absent. The payload column type follows payload_format:"},"4877":{"id":"/docs/connectors/sinks/postgres-89","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#table-schema","content":"Disabling include_metadata omits the five offset/timestamp/stream/topic/partition columns. Checksum and origin timestamp flags work independently. id, payload and created_at are always created. With auto_create_table = false, provision a compatible table yourself; startup does not check its existence or schema."},"4878":{"id":"/docs/connectors/sinks/postgres-90","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#table-schema","content":"id stores the full unsigned 128-bit message ID as a decimal, without stream, topic, partition or offset in the key. Offset and checksum values are cast to signed 64-bit integers, and partition IDs to signed 32-bit integers; values above those signed ranges appear negative. Message and origin timestamps are interpreted as Unix microseconds. Zero becomes the Unix epoch; a timestamp outside the date library's range falls back to the current time. created_at is generated by PostgreSQL when inserting."},"4879":{"id":"/docs/connectors/sinks/postgres-91","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#querying-the-data","content":"Run these queries with docker exec -it iggy-postgres psql -U iggy -d iggy, or your PostgreSQL client:"},"4880":{"id":"/docs/connectors/sinks/postgres-92","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#querying-the-data","content":"For a JSONB query example, a TEXT search example, and recommended indexes, see the upstream postgres_sink README."},"4881":{"id":"/docs/connectors/sinks/postgres-93","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#delivery-semantics","content":"Each poll is split into chunks of at most batch_size messages. One multi-row INSERT writes each chunk; a duplicate primary key, incompatible table, invalid payload or other terminal error rejects that chunk. Later chunks are still attempted. The plugin logs failures, increments its private insertion-error count by the failed chunk size, and returns success after attempting all chunks. Both its processed count and runtime's processed count can therefore include messages that were never stored. Runtime error counts do not expose these insert failures."},"4882":{"id":"/docs/connectors/sinks/postgres-94","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#delivery-semantics","content":"Transient insert failures are retried within the chunk. max_retries counts total attempts, and waits grow linearly as retry_delay, twice that delay, and so on. Retried SQLSTATEs are 40001, 40P01, 57P01, 57P02, 57P03, 08000, 08003 and 08006; SQLx I/O and pool-acquisition timeouts are also retried. Other errors stop that chunk's retry loop. Startup has no plugin retry loop."},"4883":{"id":"/docs/connectors/sinks/postgres-95","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#delivery-semantics","content":"The sink uses plain INSERT, with no conflict-ignore or upsert clause. Reusing an ID already in the table rejects the entire chunk, including any new IDs alongside it. There is no transaction covering the complete poll. The runtime auto-commits while polling and does not replay failed chunks; a connection failure can leave the write outcome uncertain. These retries do not provide an end-to-end at-least-once guarantee."},"4884":{"id":"/docs/connectors/sinks/postgres-96","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#performance-considerations","content":"Use an appropriate batch_size for your workload (larger batches give better throughput)"},"4885":{"id":"/docs/connectors/sinks/postgres-97","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#performance-considerations","content":"Create indexes on frequently queried columns (iggy_stream, iggy_topic, created_at)"},"4886":{"id":"/docs/connectors/sinks/postgres-98","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#performance-considerations","content":"Set the pool limit with max_connections; it does not report pool usage"},"4887":{"id":"/docs/connectors/sinks/postgres-99","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#performance-considerations","content":"Keep each actual chunk within PostgreSQL's 65,535 query-parameter limit. Each row binds 2 + 5 * include_metadata + include_checksum + include_origin_timestamp parameters, so the default flags allow at most 7,281 rows per statement. Larger chunks are rejected by SQLx; batch_length also limits how many rows reach a poll."},"4888":{"id":"/docs/connectors/sinks/quickwit","page_id":"/docs/connectors/sinks/quickwit","type":"page","content":"Quickwit Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/quickwit"},"4889":{"id":"/docs/connectors/sinks/quickwit-0","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit","content":"Send messages from Iggy streams to a Quickwit index over HTTP, creating the index when it does not exist."},"4890":{"id":"/docs/connectors/sinks/quickwit-1","page_id":"/docs/connectors/sinks/quickwit","type":"heading","tags":[],"url":"/docs/connectors/sinks/quickwit#configuration","content":"Configuration"},"4891":{"id":"/docs/connectors/sinks/quickwit-2","page_id":"/docs/connectors/sinks/quickwit","type":"heading","tags":[],"url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Plugin config options"},"4892":{"id":"/docs/connectors/sinks/quickwit-3","page_id":"/docs/connectors/sinks/quickwit","type":"heading","tags":[],"url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"Payload Shapes"},"4893":{"id":"/docs/connectors/sinks/quickwit-4","page_id":"/docs/connectors/sinks/quickwit","type":"heading","tags":[],"url":"/docs/connectors/sinks/quickwit#delivery-semantics","content":"Delivery Semantics"},"4894":{"id":"/docs/connectors/sinks/quickwit-5","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit","content":"The Quickwit connector allows you to send data to the Quickwit API using HTTP. At startup it checks readiness, creates a missing index, and appends messages as newline-delimited JSON (NDJSON). Each poll can become multiple requests, each limited to 8 MiB including document newlines."},"4895":{"id":"/docs/connectors/sinks/quickwit-6","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.9.0/edge Iggy checkout root, build the plugin:"},"4896":{"id":"/docs/connectors/sinks/quickwit-7","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"For a local Quickwit instance with support for the example's 0.9 index configuration:"},"4897":{"id":"/docs/connectors/sinks/quickwit-8","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"Wait for readiness, then save this connector file in the runtime's connector directory. index is a YAML string following the Quickwit index configuration format. Use a format version supported by your Quickwit server. The sink sends this YAML when creating a missing index; it does not update or compare an existing index's mapping."},"4898":{"id":"/docs/connectors/sinks/quickwit-9","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"Create the Iggy resources and send a document that matches the strict mapping:"},"4899":{"id":"/docs/connectors/sinks/quickwit-10","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"Indexing happens asynchronously. Search after the split has committed:"},"4900":{"id":"/docs/connectors/sinks/quickwit-11","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"commit_timeout_secs = 10 requests a time-based commit; it is not a ten-second delivery deadline. Retention uses the document's timestamp field. The example requests seven-day retention checked daily. The timestamp mapping accepts Unix timestamps and formats search results as nanoseconds, with millisecond fast-field precision."},"4901":{"id":"/docs/connectors/sinks/quickwit-12","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Option"},"4902":{"id":"/docs/connectors/sinks/quickwit-13","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Default"},"4903":{"id":"/docs/connectors/sinks/quickwit-14","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Description"},"4904":{"id":"/docs/connectors/sinks/quickwit-15","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"url"},"4905":{"id":"/docs/connectors/sinks/quickwit-16","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"required"},"4906":{"id":"/docs/connectors/sinks/quickwit-17","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"HTTP(S) base URL with a host; path prefixes/trailing slashes work, query strings and fragments are rejected"},"4907":{"id":"/docs/connectors/sinks/quickwit-18","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"index"},"4908":{"id":"/docs/connectors/sinks/quickwit-19","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"required"},"4909":{"id":"/docs/connectors/sinks/quickwit-20","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"YAML index configuration containing a nonempty index_id"},"4910":{"id":"/docs/connectors/sinks/quickwit-21","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"verbose_logging"},"4911":{"id":"/docs/connectors/sinks/quickwit-22","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"false"},"4912":{"id":"/docs/connectors/sinks/quickwit-23","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Log received/submitted document counts at info instead of debug"},"4913":{"id":"/docs/connectors/sinks/quickwit-24","pag