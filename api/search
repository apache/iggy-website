nnectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"usize"},"4690":{"id":"/docs/connectors/sinks/meilisearch-45","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"1000"},"4691":{"id":"/docs/connectors/sinks/meilisearch-46","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"Maximum documents per Meilisearch request; 0 behaves as 1"},"4692":{"id":"/docs/connectors/sinks/meilisearch-47","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"wait_for_tasks"},"4693":{"id":"/docs/connectors/sinks/meilisearch-48","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"bool"},"4694":{"id":"/docs/connectors/sinks/meilisearch-49","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"true"},"4695":{"id":"/docs/connectors/sinks/meilisearch-50","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"Wait for indexing success or failure, bounded by task_timeout"},"4696":{"id":"/docs/connectors/sinks/meilisearch-51","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"timeout"},"4697":{"id":"/docs/connectors/sinks/meilisearch-52","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"string"},"4698":{"id":"/docs/connectors/sinks/meilisearch-53","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"30s"},"4699":{"id":"/docs/connectors/sinks/meilisearch-54","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"Total deadline per retried SDK operation; per attempt for health checks"},"4700":{"id":"/docs/connectors/sinks/meilisearch-55","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#common-options","content":"Further options cover task polling (task_timeout 30s, task_poll_interval 100ms) and transient retries (max_retries 3, retry_delay 500ms, max_retry_delay 5s, max_open_retries 5). Both retry limits count retries after the first request, so max_retries = 3 permits up to four attempts within the operation deadline. Backoff doubles from retry_delay, adds ±20% jitter and is capped at max_retry_delay; reversed delay bounds are swapped. Invalid duration strings warn and fall back to 1s. There is no single deadline for the whole startup sequence. See the upstream meilisearch_sink README for details."},"4701":{"id":"/docs/connectors/sinks/meilisearch-56","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#document-mapping","content":"JSON object payloads are indexed as documents directly. JSON arrays and scalars are wrapped in a value field, since Meilisearch documents must be objects. Raw payloads are parsed as JSON when possible and otherwise indexed in data as base64, with data_type = \"raw\" and data_encoding = \"base64\". Text payloads land in text with data_type = \"text\". These mappings apply after stream decoding and transforms; use schema = \"raw\" or schema = \"text\" for those representations. Unsupported payload variants are skipped with a warning and counted in the plugin's private error counter. A successful callback after these drops can still count the whole batch as processed in runtime statistics."},"4702":{"id":"/docs/connectors/sinks/meilisearch-57","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#document-mapping","content":"When the configured primary key is absent from a document, the connector injects a stable value derived from the stream, topic, partition, offset, and message ID, avoiding Meilisearch primary-key inference failures. An existing key is preserved, including an invalid or null value that Meilisearch may reject, unless a reserved metadata field below overwrites it. Use unique values that meet Meilisearch's document ID rules. Reusing a key with replace replaces the whole document, removing omitted fields; update keeps fields omitted from the new document. Both actions can insert a new document."},"4703":{"id":"/docs/connectors/sinks/meilisearch-58","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#document-mapping","content":"With include_metadata = true, stream, topic, partition, offset, checksum, message ID, timestamps and available headers are written as reserved iggy_* fields after payload parsing, overwriting same-named payload fields. The exception is a supplied iggy_id when it is the configured primary key. With a different primary key, iggy_id holds the generated Iggy identity. Avoid other reserved metadata fields as your primary key because metadata overwrites them."},"4704":{"id":"/docs/connectors/sinks/meilisearch-59","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#document-mapping","content":"iggy_checksum and iggy_message_id are strings; offsets and message timestamps remain numbers. Message timestamps are microseconds, while iggy_ingested_at uses current wall-clock milliseconds. Disabling metadata leaves payload fields intact and still injects a missing primary key."},"4705":{"id":"/docs/connectors/sinks/meilisearch-60","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#delivery-semantics","content":"Each polled batch is split into requests of at most batch_size documents, with no accumulation across polls. The first failed chunk stops the loop; later chunks are not attempted. Earlier chunks may already be indexed."},"4706":{"id":"/docs/connectors/sinks/meilisearch-61","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#delivery-semantics","content":"Transient submission and task-status errors are retried within their budgets. A failed indexing task is returned as an error without resubmitting it. A task timeout does not cancel the remote task, so it may finish later. The runtime records plugin errors and continues polling with consumer auto-commit; it does not replay failed batches. This does not provide an end-to-end at-least-once guarantee, and retries or manual replay after uncertain outcomes can repeat writes."},"4707":{"id":"/docs/connectors/sinks/meilisearch-62","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#delivery-semantics","content":"Setting wait_for_tasks = false returns after submission, before Meilisearch confirms indexing. Later task failures are neither observed nor retried by the connector. Index-creation tasks are still awaited during startup. Closing the connector does not wait for outstanding document tasks."},"4708":{"id":"/docs/connectors/sinks/meilisearch-63","page_id":"/docs/connectors/sinks/meilisearch","tags":[],"type":"text","url":"/docs/connectors/sinks/meilisearch#transforms","content":"Transforms can be applied before indexing into Meilisearch. See the transforms documentation for the available types and their configuration."},"4709":{"id":"/docs/connectors/sinks/mongodb","page_id":"/docs/connectors/sinks/mongodb","type":"page","content":"MongoDB Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/mongodb"},"4710":{"id":"/docs/connectors/sinks/mongodb-0","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb","content":"Insert messages from Iggy streams into a MongoDB collection, one document per message."},"4711":{"id":"/docs/connectors/sinks/mongodb-1","page_id":"/docs/connectors/sinks/mongodb","type":"heading","tags":[],"url":"/docs/connectors/sinks/mongodb#configuration","content":"Configuration"},"4712":{"id":"/docs/connectors/sinks/mongodb-2","page_id":"/docs/connectors/sinks/mongodb","type":"heading","tags":[],"url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"Plugin config options"},"4713":{"id":"/docs/connectors/sinks/mongodb-3","page_id":"/docs/connectors/sinks/mongodb","type":"heading","tags":[],"url":"/docs/connectors/sinks/mongodb#stored-documents","content":"Stored Documents"},"4714":{"id":"/docs/connectors/sinks/mongodb-4","page_id":"/docs/connectors/sinks/mongodb","type":"heading","tags":[],"url":"/docs/connectors/sinks/mongodb#delivery-semantics","content":"Delivery Semantics"},"4715":{"id":"/docs/connectors/sinks/mongodb-5","page_id":"/docs/connectors/sinks/mongodb","type":"heading","tags":[],"url":"/docs/connectors/sinks/mongodb#transforms","content":"Transforms"},"4716":{"id":"/docs/connectors/sinks/mongodb-6","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb","content":"The MongoDB sink connector writes messages from Iggy streams to a MongoDB database. Each message is inserted as a document into the configured collection."},"4717":{"id":"/docs/connectors/sinks/mongodb-7","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.9.0/edge repository root, build the plugin:"},"4718":{"id":"/docs/connectors/sinks/mongodb-8","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#configuration","content":"Save this connector file in the runtime's connector directory and replace the MongoDB URI and destination names for your deployment. Startup parses the URI and pings the target database. max_pool_size, when set, overrides the URI's pool setting; other connection options come from the MongoDB driver and URI."},"4719":{"id":"/docs/connectors/sinks/mongodb-9","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#configuration","content":"Create the Iggy resources and send a message:"},"4720":{"id":"/docs/connectors/sinks/mongodb-10","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"Option"},"4721":{"id":"/docs/connectors/sinks/mongodb-11","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"Type"},"4722":{"id":"/docs/connectors/sinks/mongodb-12","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"Default"},"4723":{"id":"/docs/connectors/sinks/mongodb-13","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"Description"},"4724":{"id":"/docs/connectors/sinks/mongodb-14","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"connection_uri"},"4725":{"id":"/docs/connectors/sinks/mongodb-15","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"text","url":"/docs/connectors/sinks/mongodb#plugin-config-options","content":"string"},"4726":{"id":"/docs/connectors/sinks/mongodb-16","page_id":"/docs/connectors/sinks/mongodb","tags":[],"type":"