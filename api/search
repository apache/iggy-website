ary iggy."},"1331":{"id":"/docs/cli/start-12","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start","content":"This page covers installing the CLI, connecting to a server, authenticating, and managing connection contexts. The full command tree is documented in the command reference."},"1332":{"id":"/docs/cli/start-13","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#cargo","content":"Install from crates.io with the Cargo package manager:"},"1333":{"id":"/docs/cli/start-14","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#cargo","content":"This builds and installs the iggy binary. If you have cargo-binstall, you can skip compilation and fetch a prebuilt release binary:"},"1334":{"id":"/docs/cli/start-15","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#docker","content":"The official apache/iggy image ships the CLI alongside the server, installed as /usr/local/bin/iggy. The image entrypoint is the server, so override it to run the CLI:"},"1335":{"id":"/docs/cli/start-16","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#docker","content":"--network host works on Linux. On macOS and Windows, point the CLI at the host instead: --tcp-server-address host.docker.internal:8090."},"1336":{"id":"/docs/cli/start-17","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#docker","content":"Once installed, run iggy without arguments to print an overview of the available commands, or see the command reference."},"1337":{"id":"/docs/cli/start-18","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"The CLI talks to the server over one of four transports, selected with --transport. Accepted values are tcp, quic, http and ws (not websocket). The default is tcp."},"1338":{"id":"/docs/cli/start-19","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"Transport"},"1339":{"id":"/docs/cli/start-20","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"Address flag"},"1340":{"id":"/docs/cli/start-21","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"Default"},"1341":{"id":"/docs/cli/start-22","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"tcp"},"1342":{"id":"/docs/cli/start-23","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"--tcp-server-address"},"1343":{"id":"/docs/cli/start-24","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"127.0.0.1:8090"},"1344":{"id":"/docs/cli/start-25","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"quic"},"1345":{"id":"/docs/cli/start-26","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"--quic-server-address"},"1346":{"id":"/docs/cli/start-27","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"127.0.0.1:8080"},"1347":{"id":"/docs/cli/start-28","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"http"},"1348":{"id":"/docs/cli/start-29","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"--http-api-url"},"1349":{"id":"/docs/cli/start-30","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"http://localhost:3000"},"1350":{"id":"/docs/cli/start-31","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"ws"},"1351":{"id":"/docs/cli/start-32","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"--websocket-server-address"},"1352":{"id":"/docs/cli/start-33","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connecting-to-a-server","content":"127.0.0.1:8092"},"1353":{"id":"/docs/cli/start-34","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#tls-and-encryption","content":"Flag"},"1354":{"id":"/docs/cli/start-35","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#tls-and-encryption","content":"Description"},"1355":{"id":"/docs/cli/start-36","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#tls-and-encryption","content":"--tcp-tls-enabled"},"1356":{"id":"/docs/cli/start-37","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#tls-and-encryption","content":"Enable TLS for the TCP transport"},"1357":{"id":"/docs/cli/start-38","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#tls-and-encryption","content":"--tcp-tls-domain"},"1358":{"id":"/docs/cli/start-39","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#tls-and-encryption","content":"TLS domain for the TCP transport (default: localhost)"},"1359":{"id":"/docs/cli/start-40","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#tls-and-encryption","content":"--quic-validate-certificate"},"1360":{"id":"/docs/cli/start-41","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#tls-and-encryption","content":"Enable certificate validation for QUIC"},"1361":{"id":"/docs/cli/start-42","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#tls-and-encryption","content":"--encryption-key"},"1362":{"id":"/docs/cli/start-43","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#tls-and-encryption","content":"Base64-encoded AES-256-GCM key for client-side message payload encryption"},"1363":{"id":"/docs/cli/start-44","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#tls-and-encryption","content":"Each transport also exposes reconnection and tuning flags (retry counts, intervals, QUIC window sizes and MTU). Run iggy --help for the complete list with defaults."},"1364":{"id":"/docs/cli/start-45","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#authentication","content":"Commands that talk to the server require credentials. The CLI resolves them in this order, first match wins:"},"1365":{"id":"/docs/cli/start-46","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#authentication","content":"A cached login session token (created by iggy login)."},"1366":{"id":"/docs/cli/start-47","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#authentication","content":"-n, --token-name <name>: a personal access token stored in the platform keyring under that name."},"1367":{"id":"/docs/cli/start-48","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#authentication","content":"-t, --token <token>: a personal access token passed directly."},"1368":{"id":"/docs/cli/start-49","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#authentication","content":"-u, --username <user> with -p, --password <password>. When -p is omitted, the CLI prompts for the password interactively (or reads one line from stdin when piped)."},"1369":{"id":"/docs/cli/start-50","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#authentication","content":"The IGGY_USERNAME and IGGY_PASSWORD environment variables (both must be set)."},"1370":{"id":"/docs/cli/start-51","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#authentication","content":"-u, -t and -n are mutually exclusive. Avoid passing the password inline with -p: it lands in your shell history. Prefer iggy login, the interactive prompt, or the environment variables."},"1371":{"id":"/docs/cli/start-52","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#login-sessions","content":"iggy login authenticates once and stores a session token in the platform's secure credential store: Secret Service on Linux and the BSDs, Keychain on macOS, Credential Manager on Windows. Subsequent commands use the cached token automatically."},"1372":{"id":"/docs/cli/start-53","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#login-sessions","content":"iggy session status only checks whether a token exists in the local keyring. An expired token still reports as active. Run iggy me to verify the session against the server."},"1373":{"id":"/docs/cli/start-54","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#personal-access-tokens","content":"Create a token once, then authenticate with it instead of a username and password:"},"1374":{"id":"/docs/cli/start-55","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#personal-access-tokens","content":"--store-token is mutually exclusive with an expiry: stored tokens never expire. They're also namespaced per server address, so a token stored for one server isn't visible when connecting to another. Alternatively, create a token with an expiry and pass its value with -t:"},"1375":{"id":"/docs/cli/start-56","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connection-contexts","content":"Contexts are named connection profiles (transport, addresses, TLS settings, credentials) for working with multiple environments. Subcommands: list, use, create, delete, show."},"1376":{"id":"/docs/cli/start-57","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connection-contexts","content":"Creating and activating a context are two separate steps:"},"1377":{"id":"/docs/cli/start-58","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connection-contexts","content":"There's no --context flag: the active context is persistent state, switched with iggy context use <name>. Flags passed on the command line override the corresponding values from the active context."},"1378":{"id":"/docs/cli/start-59","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#connection-contexts","content":"Contexts are stored in contexts.toml, and the active context name in .active_context, both under the Iggy home directory: ~/.iggy by default, overridable with the IGGY_HOME environment variable. The default context always exists and cannot be deleted or redefined. Deleting the currently active context switches back to default. Context names may contain letters, digits, hyphens and underscores."},"1379":{"id":"/docs/cli/start-60","page_id":"/docs/cli/start","tags":[],"type":"text","url":"/docs/cli/start#shell-completions","content":"Generate completions for bash, zsh, fish, elvish or powershell with --generate:"},"1380":{"id":"/docs/clustering/client-failover","page_id":"/docs/clustering/client-failover","type":"page","content":"Client Failover","breadcrumbs":["Documentation","Clustering"],"tags":[],"url":"/docs/clustering/client-failover"},"1381":{"id":"/docs/clustering/client-failover-0","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover","content":"Local reads, leader redirection, and retryable errors from the client side"},"1382":{"id":"/docs/clustering/client-failover-1","page_id":"/docs/clustering/client-failover","type":"heading","tags":[],"url":"/docs/clustering/client-failover#where-requests-are-served","content":"Where requests are served"},"1383":{"id":"/docs/clustering/client-failover-2","page_id":"/docs/clustering/client-failover","type":"heading","tags":[],"url":"/docs/clustering/client-failover#leader-redirection","content":"Leader redirection"},"1384":{"id":"/docs/clustering/client-failover-3","page_id":"/docs/clustering/client-failover","type":"heading","tags":[],"url":"/docs/clustering/client-failover#retryable-errors","content":"Retryable errors"},"1385":{"id":"/docs/clustering/client-failover-4","page_id":"/docs/clustering/client-failover","type":"heading","tags":[],"url":"/docs/clustering/client-failover#sdk-support","content":"SDK support"},"1386":{"id":"/docs/clustering/client-failover-5","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover","content":"A clustered deployment changes what a client can expect from any single node: reads are served locally where possible, writes must reach the right primary, and the SDKs follow the primary as it moves."},"1387":{"id":"/docs/clustering/client-failover-6","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#where-requests-are-served","content":"Reads are served from the local replicated state on whichever node owns the namespace locally, followers included. A client connected to a follower can poll messages and read metadata without touching the primary."},"1388":{"id":"/docs/clustering/client-failover-7","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#where-requests-are-served","content":"Writes go through consensus and are admitted on the plane's primary only: metadata operations on the metadata primary, message and offset writes on the primary of that partition's consensus group. A write returns after the required VSR commit, or returns a retryable error when the replica is changing view or catching up."},"1389":{"id":"/docs/clustering/client-failover-8","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#where-requests-are-served","content":"One caveat on follower reads: server-managed offset auto-commit replicates the polled offset through the partition consensus, which only the partition primary may do. A poll served by a follower does not advance the durable consumer offset. Auto-commit is best-effort at-least-once delivery either way, so this widens the redelivery window after failover rather than losing data."},"1390":{"id":"/docs/clustering/client-failover-9","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#leader-redirection","content":"Leader-aware SDKs find the primary instead of requiring you to point them at it:"},"1391":{"id":"/docs/clustering/client-failover-10","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#leader-redirection","content":"The client connects to any node from its connection string and fetches cluster metadata, which lists every node with its name, client endpoints, role, and status."},"1392":{"id":"/docs/clustering/client-failover-11","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#leader-redirection","content":"When the connected node isn't the leader, the client reconnects to the leader's advertised endpoint for the transport in use."},"1393":{"id":"/docs/clustering/client-failover-12","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#leader-redirection","content":"When the cluster is transiently leaderless (for roughly one heartbeat timeout after a primary fails, while the election completes), the client polls the metadata until a leader appears instead of failing."},"1394":{"id":"/docs/clustering/client-failover-13","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#leader-redirection","content":"Redirects are capped (three in the Rust SDK) so a flapping roster can't bounce the client forever."},"1395":{"id":"/docs/clustering/client-failover-14","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#leader-redirection","content":"The address a client is redirected to is the node's advertised_address (or the matching advertised_addresses selector), falling back to the roster ip. Getting those right matters: the client redials exactly what the metadata advertises. See Configuration for the selector rules."},"1396":{"id":"/docs/clustering/client-failover-15","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#leader-redirection","content":"The Rust implementation lives in core/sdk/src/leader_aware.rs."},"1397":{"id":"/docs/clustering/client-failover-16","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#retryable-errors","content":"During a view change or while a replica catches up, writes fail with transient errors rather than definitive ones. The SDKs replay those transparently, so a primary failover surfaces as added latency rather than an error, as long as it completes within the client's retry budget. Definitive errors (validation failures, permission denials) are never replayed."},"1398":{"id":"/docs/clustering/client-failover-17","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"Every SDK speaks the VSR wire protocol and can connect to any node of a cluster. Client-side leader redirection is exercised by the shared leader_redirection BDD suite, which runs against a real two-node cluster:"},"1399":{"id":"/docs/clustering/client-failover-18","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"SDK"},"1400":{"id":"/docs/clustering/client-failover-19","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"VSR wire protocol"},"1401":{"id":"/docs/clustering/client-failover-20","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"Leader redirection suite"},"1402":{"id":"/docs/clustering/client-failover-21","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"Rust"},"1403":{"id":"/docs/clustering/client-failover-22","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"yes"},"1404":{"id":"/docs/clustering/client-failover-23","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"yes"},"1405":{"id":"/docs/clustering/client-failover-24","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"Go"},"1406":{"id":"/docs/clustering/client-failover-25","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"yes"},"1407":{"id":"/docs/clustering/client-failover-26","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"yes"},"1408":{"id":"/docs/clustering/client-failover-27","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"C#"},"1409":{"id":"/docs/clustering/client-failover-28","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"yes"},"1410":{"id":"/docs/clustering/client-failover-29","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"yes"},"1411":{"id":"/docs/clustering/client-failover-30","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"Java"},"1412":{"id":"/docs/clustering/client-failover-31","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"yes"},"1413":{"id":"/docs/clustering/client-failover-32","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"yes"},"1414":{"id":"/docs/clustering/client-failover-33","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"Python"},"1415":{"id":"/docs/clustering/client-failover-34","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"yes"},"1416":{"id":"/docs/clustering/client-failover-35","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"not yet"},"1417":{"id":"/docs/clustering/client-failover-36","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"Node.js"},"1418":{"id":"/docs/clustering/client-failover-37","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"yes"},"1419":{"id":"/docs/clustering/client-failover-38","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"not yet"},"1420":{"id":"/docs/clustering/client-failover-39","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"C++"},"1421":{"id":"/docs/clustering/client-failover-40","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"yes"},"1422":{"id":"/docs/clustering/client-failover-41","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"not yet"},"1423":{"id":"/docs/clustering/client-failover-42","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"Run the suite for one SDK with:"},"1424":{"id":"/docs/clustering/client-failover-43","page_id":"/docs/clustering/client-failover","tags":[],"type":"text","url":"/docs/clustering/client-failover#sdk-support","content":"For SDKs without redirection coverage, connect clients to the current primary for write-heavy workloads, or front the cluster's HTTP transport with a load balancer and rely on follower HTTP forwarding for control-plane operations."},"1425":{"id":"/docs/clustering/configuration","page_id":"/docs/clustering/configuration","type":"page","content":"Cluster Configuration","breadcrumbs":["Documentation","Clustering"],"tags":[],"url":"/docs/clustering/configuration"},"1426":{"id":"/docs/clustering/configuration-0","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration","content":"Reference for the [cluster] settings, consensus timing, and node roster"},"1427":{"id":"/docs/clustering/configuration-1","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#top-level-settings","content":"Top-level settings"},"1428":{"id":"/docs/clustering/configuration-2","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#consensus-timing","content":"Consensus timing"},"1429":{"id":"/docs/clustering/configuration-3","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#validation-rules","content":"Validation rules"},"1430":{"id":"/docs/clustering/configuration-4","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#node-roster","content":"Node roster"},"1431":{"id":"/docs/clustering/configuration-5","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#name","content":"name"},"1432":{"id":"/docs/clustering/configuration-6","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#ip","content":"ip"},"1433":{"id":"/docs/clustering/configuration-7","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#replica_id","content":"replica_id"},"1434":{"id":"/docs/clustering/configuration-8","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#ports","content":"ports"},"1435":{"id":"/docs/clustering/configuration-9","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#advertised_address","content":"advertised_address"},"1436":{"id":"/docs/clustering/configuration-10","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#advertised_addresses","content":"advertised_addresses"},"1437":{"id":"/docs/clustering/configuration-11","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#authentication-and-tls","content":"Authentication and TLS"},"1438":{"id":"/docs/clustering/configuration-12","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration","content":"All clustering settings live in the [cluster] section of the server configuration. The authoritative defaults with detailed comments are in core/server/config.toml. Every value can also be set through an IGGY_-prefixed environment variable, for example IGGY_CLUSTER_ENABLED=true or IGGY_CLUSTER_NODES_0_IP=10.0.1.5."},"1439":{"id":"/docs/clustering/configuration-13","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration","content":"The server validates the whole section at boot and refuses to start on an invalid value, printing the exact rule that failed."},"1440":{"id":"/docs/clustering/configuration-14","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"Setting"},"1441":{"id":"/docs/clustering/configuration-15","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"Default"},"1442":{"id":"/docs/clustering/configuration-16","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"Purpose"},"1443":{"id":"/docs/clustering/configuration-17","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"enabled"},"1444":{"id":"/docs/clustering/configuration-18","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"false"},"1445":{"id":"/docs/clustering/configuration-19","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"Enables cluster mode. When disabled, the node runs single-node and the rest of the section is mostly inert."},"1446":{"id":"/docs/clustering/configuration-20","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"name"},"1447":{"id":"/docs/clustering/configuration-21","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"\"iggy-cluster\""},"1448":{"id":"/docs/clustering/configuration-22","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"Unique cluster name shared by every node. Prevents accidental cross-cluster communication."},"1449":{"id":"/docs/clustering/configuration-23","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"cluster.name is a permanent on-disk identity, not a label. It's hashed into the cluster id stamped into every metadata and partition superblock on first boot, and the consensus layer derives its cluster id from the name unconditionally. Nodes with different names cannot connect to each other, and changing the name later makes the server refuse to start against existing data."},"1450":{"id":"/docs/clustering/configuration-24","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Consensus runs on a fixed 10ms tick. Every duration below is converted to whole ticks: values are rounded down to a multiple of 10ms, and anything under 10ms is raised to a single tick rather than firing sooner."},"1451":{"id":"/docs/clustering/configuration-25","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Setting"},"1452":{"id":"/docs/clustering/configuration-26","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Default"},"1453":{"id":"/docs/clustering/configuration-27","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Purpose"},"1454":{"id":"/docs/clustering/configuration-28","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"heartbeat_timeout"},"1455":{"id":"/docs/clustering/configuration-29","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"5s"},"1456":{"id":"/docs/clustering/configuration-30","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Backup liveness window: a replica that sees no primary traffic for this long starts a view change"},"1457":{"id":"/docs/clustering/configuration-31","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"commit_broadcast_interval"},"1458":{"id":"/docs/clustering/configuration-32","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"500ms"},"1459":{"id":"/docs/clustering/configuration-33","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"How often the primary broadcasts its commit point; this broadcast is the cluster's liveness signal"},"1460":{"id":"/docs/clustering/configuration-34","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"prepare_retransmit_interval"},"1461":{"id":"/docs/clustering/configuration-35","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"250ms"},"1462":{"id":"/docs/clustering/configuration-36","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Retry prepares that backups have not acknowledged"},"1463":{"id":"/docs/clustering/configuration-37","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"view_change_retransmit_interval"},"1464":{"id":"/docs/clustering/configuration-38","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"500ms"},"1465":{"id":"/docs/clustering/configuration-39","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Retry StartViewChange / DoViewChange while a view change is in progress"},"1466":{"id":"/docs/clustering/configuration-40","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"view_change_status_timeout"},"1467":{"id":"/docs/clustering/configuration-41","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"5s"},"1468":{"id":"/docs/clustering/configuration-42","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Escalate a view change that does not conclude within this window to a fresh election"},"1469":{"id":"/docs/clustering/configuration-43","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"request_start_view_retransmit_interval"},"1470":{"id":"/docs/clustering/configuration-44","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"1s"},"1471":{"id":"/docs/clustering/configuration-45","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"How often a recovering replica re-requests the current view's StartView"},"1472":{"id":"/docs/clustering/configuration-46","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"view_probe_attempts_max"},"1473":{"id":"/docs/clustering/configuration-47","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"5"},"1474":{"id":"/docs/clustering/configuration-48","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Unanswered RequestStartView probes a recovering replica tolerates before falling back to an election"},"1475":{"id":"/docs/clustering/configuration-49","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"repair_retry_interval"},"1476":{"id":"/docs/clustering/configuration-50","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"1s"},"1477":{"id":"/docs/clustering/configuration-51","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"How long a stalled journal-repair stream waits before re-requesting its remaining window"},"1478":{"id":"/docs/clustering/configuration-52","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"repair_chunk_max"},"1479":{"id":"/docs/clustering/configuration-53","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"128"},"1480":{"id":"/docs/clustering/configuration-54","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Prepares a peer serves per repair round"},"1481":{"id":"/docs/clustering/configuration-55","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Raise heartbeat_timeout on oversubscribed hosts where scheduling stalls fake primary death. Otherwise keep the defaults unless tests show a specific scheduling or network problem."},"1482":{"id":"/docs/clustering/configuration-56","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#validation-rules","content":"Boot-time validation enforces these constraints:"},"1483":{"id":"/docs/clustering/configuration-57","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#validation-rules","content":"Every duration must be nonzero. The 0, disabled, and unlimited sentinels all parse to a zero duration and are rejected. There's no way to switch the liveness window off."},"1484":{"id":"/docs/clustering/configuration-58","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#validation-rules","content":"heartbeat_timeout must be at least 2s and at least 4x commit_broadcast_interval, so one delayed broadcast never trips an election on a healthy primary."},"1485":{"id":"/docs/clustering/configuration-59","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#validation-rules","content":"view_change_status_timeout must be at least 4x view_change_retransmit_interval, so a few dropped view-change messages retransmit instead of escalating into a fresh cluster-wide election."},"1486":{"id":"/docs/clustering/configuration-60","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#validation-rules","content":"view_probe_attempts_max must be between 1 and 100."},"1487":{"id":"/docs/clustering/configuration-61","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#validation-rules","content":"repair_chunk_max must be between 1 and 1024, and strictly below message_bus.peer_queue_capacity: each repair frame rides the per-peer message-bus queue, and a full round above that capacity would overrun the queue and drop frames."},"1488":{"id":"/docs/clustering/configuration-62","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#node-roster","content":"cluster.nodes is the full roster of cluster members and is intended to be byte-identical on every node. The running node finds its own entry through the --replica-id CLI flag."},"1489":{"id":"/docs/clustering/configuration-63","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#name","content":"Node name, unique within the roster and non-empty."},"1490":{"id":"/docs/clustering/configuration-64","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#ip","content":"The node's roster address. Replica-to-replica consensus traffic and follower-to-primary HTTP forwarding dial it, so it must be a literal IPv4 or IPv6 address. Hostnames are rejected when the server resolves the roster at startup."},"1491":{"id":"/docs/clustering/configuration-65","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#ip","content":"ip is not the bind interface for the client transports. tcp, quic, http, and websocket bind whatever their own address settings say. The roster supplies only their ports. The defaults bind loopback, so a cluster spread across hosts needs each transport's address set to 0.0.0.0 or the routable interface. The server warns at startup when a bind cannot serve the advertised ip."},"1492":{"id":"/docs/clustering/configuration-66","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#replica_id","content":"Numeric replica id for VSR consensus, 0-based. Ids must be unique and strictly less than the roster size, which makes them contiguous from 0. Rosters with more than 255 replicas are unsupported."},"1493":{"id":"/docs/clustering/configuration-67","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#ports","content":"Per-node listener ports: tcp, quic, http, websocket, and tcp_replica. In cluster mode ports is the single source of listener ports: every enabled transport needs an explicit per-node port, otherwise the server refuses to start. tcp_replica carries consensus traffic and is always required. Port 0 is rejected, and no two roster entries may claim the same ip:port."},"1494":{"id":"/docs/clustering/configuration-68","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_address","content":"Optional client-facing address handed out in cluster metadata and leader redirects. Set it when ip is a private replica-network address unreachable by clients (Docker, Kubernetes, NAT). Accepts a literal IP or an RFC 1123 DNS hostname: ASCII letters, digits, - and ., no port, no trailing dot. When unset, clients receive ip."},"1495":{"id":"/docs/clustering/configuration-69","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Per-client-network overrides for split networks, where one catch-all advertised_address would route in-VPC clients out through the public side:"},"1496":{"id":"/docs/clustering/configuration-70","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Clients whose transport-level peer IP falls inside client_cidr are handed address instead of the catch-all. The longest matching prefix wins. Clients matching no selector fall back to advertised_address, then ip. address takes the same forms as advertised_address (literal IP or hostname, never a port)."},"1497":{"id":"/docs/clustering/configuration-71","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Rules and caveats:"},"1498":{"id":"/docs/clustering/configuration-72","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"At most 16 selectors per node. Boot rejects duplicate client_cidr entries on one node (compared truncated, so 10.0.1.0/16 duplicates 10.0.0.0/16) and any two nodes advertising one host:port to overlapping client sets."},"1499":{"id":"/docs/clustering/configuration-73","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Matching is per address family: 0.0.0.0/0 matches no IPv6 client and ::/0 matches no IPv4 client, so covering both families takes one selector per family. IPv4-mapped IPv6 CIDRs (::ffff:10.0.0.0/104) match like their IPv4 form only at prefix length 96 or longer."},"1500":{"id":"/docs/clustering/configuration-74","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Matching sees the transport-level peer address, so clients behind a proxy or load balancer match the proxy's network, not their own."},"1501":{"id":"/docs/clustering/configuration-75","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Every address must be routable from inside its own client_cidr: leader-aware clients redial whatever address metadata advertises, and a selector pointing at an unreachable host strands them mid-redirect."},"1502":{"id":"/docs/clustering/configuration-76","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Prefer literal IPs over hostnames. SDKs differ in how they compare an advertised hostname against the address they dialed, and a mismatch costs a reconnect on every fresh connect."},"1503":{"id":"/docs/clustering/configuration-77","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Rolling upgrades: older server binaries reject a TOML config containing advertised_addresses but silently ignore the equivalent IGGY_CLUSTER_NODES_*_ADVERTISED_ADDRESSES_* env vars. Upgrade every binary first, then add selectors."},"1504":{"id":"/docs/clustering/configuration-78","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#authentication-and-tls","content":"[cluster.auth] configures the pre-shared-key replica handshake and [cluster.tls] wraps replica connections in TLS. Both are covered in Security."},"1505":{"id":"/docs/clustering/deploy","page_id":"/docs/clustering/deploy","type":"page","content":"Deploy a Cluster","breadcrumbs":["Documentation","Clustering"],"tags":[],"url":"/docs/clustering/deploy"},"1506":{"id":"/docs/clustering/deploy-0","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy","content":"Build the binaries and run a three-node Apache Iggy cluster"},"1507":{"id":"/docs/clustering/deploy-1","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#build-from-source","content":"Build from source"},"1508":{"id":"/docs/clustering/deploy-2","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#run-one-development-node","content":"Run one development node"},"1509":{"id":"/docs/clustering/deploy-3","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"Run a three-node cluster"},"1510":{"id":"/docs/clustering/deploy-4","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#spanning-multiple-hosts","content":"Spanning multiple hosts"},"1511":{"id":"/docs/clustering/deploy-5","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#containers","content":"Containers"},"1512":{"id":"/docs/clustering/deploy-6","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#check-cluster-metadata","content":"Check cluster metadata"},"1513":{"id":"/docs/clustering/deploy-7","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#reset-a-replica","content":"Reset a replica"},"1514":{"id":"/docs/clustering/deploy-8","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#run-the-cluster-test-suites","content":"Run the cluster test suites"},"1515":{"id":"/docs/clustering/deploy-9","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy","content":"Build iggy-server and the iggy CLI, run a single development node, then bring up a three-node cluster on one machine. See Configuration for the full [cluster] reference."},"1516":{"id":"/docs/clustering/deploy-10","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#build-from-source","content":"Build the server and CLI from the repository root:"},"1517":{"id":"/docs/clustering/deploy-11","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#build-from-source","content":"The binaries are:"},"1518":{"id":"/docs/clustering/deploy-12","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#build-from-source","content":"The server uses Linux io_uring. Use a recent Linux kernel and a sufficient locked-memory limit."},"1519":{"id":"/docs/clustering/deploy-13","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-one-development-node","content":"The default core/server/config.toml has clustering disabled, so a plain run starts a single node:"},"1520":{"id":"/docs/clustering/deploy-14","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-one-development-node","content":"--with-default-root-credentials sets the root user to iggy/iggy unless IGGY_ROOT_USERNAME and IGGY_ROOT_PASSWORD are already exported. Only the first boot on an empty data directory reads these values."},"1521":{"id":"/docs/clustering/deploy-15","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-one-development-node","content":"When clustering is disabled, --replica-id 0 is still accepted. Any other id is rejected because it would have to match a cluster.nodes entry."},"1522":{"id":"/docs/clustering/deploy-16","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"Every node loads the same configuration. Nodes are told apart only by --replica-id, which selects that node's own entry in the cluster.nodes roster."},"1523":{"id":"/docs/clustering/deploy-17","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"Save this as /tmp/iggy-vsr.toml:"},"1524":{"id":"/docs/clustering/deploy-18","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"cluster.name is a permanent on-disk identity. It is hashed into the cluster id stamped into every metadata and partition superblock on first boot. Changing the name later makes the server refuse to start against the existing data, so renaming a cluster means starting from an empty data directory."},"1525":{"id":"/docs/clustering/deploy-19","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"Export the settings shared by all three processes:"},"1526":{"id":"/docs/clustering/deploy-20","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"Root credentials are mandatory once the cluster is enabled. The shared secret must be at least 32 bytes. See Security for how it's used and rotated."},"1527":{"id":"/docs/clustering/deploy-21","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"Start each replica in a separate terminal. Use a different data path for every process:"},"1528":{"id":"/docs/clustering/deploy-22","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"The exported settings must be present in all three terminals."},"1529":{"id":"/docs/clustering/deploy-23","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"In cluster mode:"},"1530":{"id":"/docs/clustering/deploy-24","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"--replica-id is required and must match exactly one cluster.nodes entry"},"1531":{"id":"/docs/clustering/deploy-25","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"replica_id values must be unique and contiguous from 0"},"1532":{"id":"/docs/clustering/deploy-26","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"ports is the single source of listener ports: every enabled transport needs an explicit per-node port, otherwise the server refuses to start"},"1533":{"id":"/docs/clustering/deploy-27","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"tcp_replica carries replica-to-replica consensus traffic and is always required"},"1534":{"id":"/docs/clustering/deploy-28","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"ip must be a literal IP address. Use advertised_address when clients can't reach it (see Configuration)"},"1535":{"id":"/docs/clustering/deploy-29","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"use a different system.path for each process on the same host"},"1536":{"id":"/docs/clustering/deploy-30","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#spanning-multiple-hosts","content":"The roster ip is the address other replicas dial. It's not the bind interface for the client transports: tcp, quic, http, and websocket bind whatever their own address settings say, and the roster supplies only the port. The defaults listen on loopback, so a cluster spread across hosts needs each transport's address set to 0.0.0.0 or the routable interface. The server warns at startup when a bind cannot serve the advertised ip."},"1537":{"id":"/docs/clustering/deploy-31","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#containers","content":"Every roster field can be provided through typed environment variables instead of TOML, which suits container deployments:"},"1538":{"id":"/docs/clustering/deploy-32","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#containers","content":"Give each container a static IP and put that IP in the roster: cluster.nodes[*].ip does not accept hostnames or Docker service names. The repository ships a working reference in bdd/docker-compose.cluster.yml, a real two-node cluster used by the BDD suites."},"1539":{"id":"/docs/clustering/deploy-33","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#check-cluster-metadata","content":"Ask any node for the cluster state with the CLI:"},"1540":{"id":"/docs/clustering/deploy-34","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#check-cluster-metadata","content":"The response lists the cluster name, nodes, client endpoints, and current roles. cluster m is a shorthand for cluster metadata."},"1541":{"id":"/docs/clustering/deploy-35","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#reset-a-replica","content":"iggy-server --fresh deletes the configured data directory before boot. In cluster mode this wipes that replica only: it rejoins the cluster and refills its state by transfer from the other replicas. Wiping a quorum of replicas at the same time destroys committed data, and a service unit that always passes --fresh re-transfers the whole dataset on every restart."},"1542":{"id":"/docs/clustering/deploy-36","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-the-cluster-test-suites","content":"The cross-SDK BDD suites run against a real cluster started from bdd/docker-compose.cluster.yml:"},"1543":{"id":"/docs/clustering/deploy-37","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-the-cluster-test-suites","content":"The first argument selects the SDK (rust, python, php, go, go-race, node, csharp, java, cpp, or all) and the optional second argument selects one feature (basic_messaging, leader_redirection, raw_command, or all). leader_redirection is the clustered feature. The Rust, Go, C#, and Java suites support it."},"1544":{"id":"/docs/clustering/security","page_id":"/docs/clustering/security","type":"page","content":"Cluster Security","breadcrumbs":["Documentation","Clustering"],"tags":[],"url":"/docs/clustering/security"},"1545":{"id":"/docs/clustering/security-0","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security","content":"Replica authentication, shared-secret rotation, and TLS for replica traffic"},"1546":{"id":"/docs/clustering/security-1","page_id":"/docs/clustering/security","type":"heading","tags":[],"url":"/docs/clustering/security#replica-authentication","content":"Replica authentication"},"1547":{"id":"/docs/clustering/security-2","page_id":"/docs/clustering/security","type":"heading","tags":[],"url":"/docs/clustering/security#rotating-the-shared-secret","content":"Rotating the shared secret"},"1548":{"id":"/docs/clustering/security-3","page_id":"/docs/clustering/security","type":"heading","tags":[],"url":"/docs/clustering/security#replica-tls","content":"Replica TLS"},"1549":{"id":"/docs/clustering/security-4","page_id":"/docs/clustering/security","type":"heading","tags":[],"url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"HTTP tokens across the cluster"},"1550":{"id":"/docs/clustering/security-5","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security","content":"Replica-to-replica security has two layers, both in the [cluster] configuration: a pre-shared-key handshake that authenticates peers ([cluster.auth]) and optional TLS that encrypts the replica connection ([cluster.tls])."},"1551":{"id":"/docs/clustering/security-6","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-authentication","content":"Replica authentication uses a cluster-wide pre-shared key (PSK) and a BLAKE3 keyed-MAC handshake. With cluster.auth.enabled = true, every replica peer must complete the authenticated handshake or be rejected:"},"1552":{"id":"/docs/clustering/security-7","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-authentication","content":"The secret must be at least 32 bytes of CSPRNG output and byte-identical on every node."},"1553":{"id":"/docs/clustering/security-8","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-authentication","content":"Prefer the IGGY_CLUSTER_AUTH_SHARED_SECRET environment variable over storing the secret in TOML. The value is masked in logs and never written into the runtime configuration snapshot."},"1554":{"id":"/docs/clustering/security-9","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-authentication","content":"Authentication is off by default, which leaves replica traffic unauthenticated. Enabling it is a coordinated-restart change: flip every node in one restart."},"1555":{"id":"/docs/clustering/security-10","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-authentication","content":"The 32-byte minimum is enforced whenever the cluster is enabled, even with auth.enabled = false: a configured non-empty secret shorter than 32 bytes fails boot."},"1556":{"id":"/docs/clustering/security-11","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#rotating-the-shared-secret","content":"previous_shared_secret enables a rolling key rotation without an authentication outage. The retiring key is accepted for verification only. Every MAC a node produces uses shared_secret. Rotate in three rolls, restarting every node after each step:"},"1557":{"id":"/docs/clustering/security-12","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#rotating-the-shared-secret","content":"shared_secret = old, previous_shared_secret = new on every node"},"1558":{"id":"/docs/clustering/security-13","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#rotating-the-shared-secret","content":"shared_secret = new, previous_shared_secret = old on every node"},"1559":{"id":"/docs/clustering/security-14","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#rotating-the-shared-secret","content":"shared_secret = new alone, closing the window"},"1560":{"id":"/docs/clustering/security-15","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#rotating-the-shared-secret","content":"Leave previous_shared_secret empty outside a rotation. It has the same 32-byte floor and the same environment-variable preference as the primary key (IGGY_CLUSTER_AUTH_PREVIOUS_SHARED_SECRET), and it must differ from shared_secret. An identical value is refused at boot because the rotation would be a no-op."},"1561":{"id":"/docs/clustering/security-16","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-tls","content":"[cluster.tls] wraps every replica connection on the tcp_replica port in TLS 1.3 (ALPN iggy-replica) before the replica handshake runs:"},"1562":{"id":"/docs/clustering/security-17","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-tls","content":"TLS requires cluster.auth.enabled = true, and the server refuses to start otherwise. The reason: replica TLS carries no client certificates, so it authenticates the acceptor only. The PSK handshake authenticates the peer. TLS supplies confidentiality. Without the PSK requirement, any TLS-capable host could register as a replica."},"1563":{"id":"/docs/clustering/security-18","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-tls","content":"Enabling TLS is also a coordinated-restart change: a TLS dialer can't talk to a plaintext acceptor or vice versa."},"1564":{"id":"/docs/clustering/security-19","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-tls","content":"Two certificate modes exist:"},"1565":{"id":"/docs/clustering/security-20","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-tls","content":"CA mode (self_signed = false, the default): cert_file, key_file, and ca_file are all required. Each node presents cert_file on its acceptor side, and dialers verify peer certificates against the ca_file trust anchors. The dialer verifies each peer against the ip string from that peer's cluster.nodes entry, so certificates need matching IP SANs."},"1566":{"id":"/docs/clustering/security-21","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-tls","content":"Self-signed mode (self_signed = true): the node auto-generates a certificate at boot and the dialer accepts ANY peer certificate. This gives you encrypted replica traffic without certificate management, but no acceptor authentication at all: peer authenticity rests entirely on the PSK handshake. Use CA mode when the replica network is not trusted."},"1567":{"id":"/docs/clustering/security-22","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"Follower nodes forward control-plane HTTP requests (stream, topic, user, and similar metadata operations) to the current metadata primary, so any node can answer any control-plane request. This requires JWT key material that every node can verify, from either of two sources:"},"1568":{"id":"/docs/clustering/security-23","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"explicitly configured http.jwt signing secrets, identical on every node, or"},"1569":{"id":"/docs/clustering/security-24","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"the cluster PSK: when HTTP is enabled, cluster auth is enabled, and no http.jwt secrets are configured, the signing key is derived from shared_secret."},"1570":{"id":"/docs/clustering/security-25","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"Either way, a bearer token minted on any node verifies on every node, which is the invariant the forwarding depends on. Forwarded requests dial the primary at its roster ip and ports.http. The follower verifies the caller's bearer locally before forwarding, and the primary re-authenticates the request through its normal stack."},"1571":{"id":"/docs/clustering/security-26","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"The forwarding covers the control plane only. Partition-plane writes over HTTP (producing messages, storing consumer offsets) are not forwarded: each partition is its own consensus group whose primary can diverge from the metadata primary, so those requests must land on the right node. See Client failover for how clients find it."},"1572":{"id":"/docs/clustering/vsr","page_id":"/docs/clustering/vsr","type":"page","content":"Viewstamped Replication","breadcrumbs":["Documentation","Clustering"],"tags":[],"url":"/docs/clustering/vsr"},"1573":{"id":"/docs/clustering/vsr-0","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr","content":"How Apache Iggy replicates data across a cluster with VSR"},"1574":{"id":"/docs/clustering/vsr-1","page_id":"/docs/clustering/vsr","type":"heading","tags":[],"url":"/docs/clustering/vsr#current-implementation","content":"Current implementation"},"1575":{"id":"/docs/clustering/vsr-2","page_id":"/docs/clustering/vsr","type":"heading","tags":[],"url":"/docs/clustering/vsr#replication-model","content":"Replication model"},"1576":{"id":"/docs/clustering/vsr-3","page_id":"/docs/clustering/vsr","type":"heading","tags":[],"url":"/docs/clustering/vsr#failure-handling","content":"Failure handling"},"1577":{"id":"/docs/clustering/vsr-4","page_id":"/docs/clustering/vsr","type":"heading","tags":[],"url":"/docs/clustering/vsr#wire-protocol-and-sdks","content":"Wire protocol and SDKs"},"1578":{"id":"/docs/clustering/vsr-5","page_id":"/docs/clustering/vsr","type":"heading","tags":[],"url":"/docs/clustering/vsr#status","content":"Status"},"1579":{"id":"/docs/clustering/vsr-6","page_id":"/docs/clustering/vsr","type":"heading","tags":[],"url":"/docs/clustering/vsr#next-steps","content":"Next steps"},"1580":{"id":"/docs/clustering/vsr-7","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr","content":"Apache Iggy replicates clusters with Viewstamped Replication Revisited (VSR). VSR keeps an ordered state machine consistent across replicas and elects a new primary when the current primary fails."},"1581":{"id":"/docs/clustering/vsr-8","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr","content":"Clustering is built into the standard iggy-server binary. There's no separate build, binary, or Cargo feature: the same server runs single-node or clustered, and cluster.enabled in the configuration decides which one you get. Clustering is disabled by default."},"1582":{"id":"/docs/clustering/vsr-9","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr","content":"Read the VSR paper used by the project for the protocol specification."},"1583":{"id":"/docs/clustering/vsr-10","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr","content":"Iggy hasn't reached a 1.0 production release yet. The cluster protocol and configuration described here can still change between pre-release versions."},"1584":{"id":"/docs/clustering/vsr-11","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"The implementation includes:"},"1585":{"id":"/docs/clustering/vsr-12","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"normal operation with quorum commits"},"1586":{"id":"/docs/clustering/vsr-13","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"view changes and deterministic primary selection"},"1587":{"id":"/docs/clustering/vsr-14","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"metadata and partition replication"},"1588":{"id":"/docs/clustering/vsr-15","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"persistent WAL recovery and snapshots"},"1589":{"id":"/docs/clustering/vsr-16","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"replica rejoin with journal repair"},"1590":{"id":"/docs/clustering/vsr-17","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"client sessions, request fencing, and duplicate detection"},"1591":{"id":"/docs/clustering/vsr-18","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"replica authentication and optional TLS"},"1592":{"id":"/docs/clustering/vsr-19","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"leader redirection in the client SDKs"},"1593":{"id":"/docs/clustering/vsr-20","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"deterministic simulation and cross-SDK BDD coverage"},"1594":{"id":"/docs/clustering/vsr-21","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"The main components are:"},"1595":{"id":"/docs/clustering/vsr-22","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"Component"},"1596":{"id":"/docs/clustering/vsr-23","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"Source"},"1597":{"id":"/docs/clustering/vsr-24","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/d