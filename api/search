"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"string"},"4995":{"id":"/docs/connectors/sinks/s3-42","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"8MiB"},"4996":{"id":"/docs/connectors/sinks/s3-43","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"Size rotation threshold; must be positive and at most 5GiB, even in message-count mode"},"4997":{"id":"/docs/connectors/sinks/s3-44","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"max_messages_per_file"},"4998":{"id":"/docs/connectors/sinks/s3-45","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"u64"},"4999":{"id":"/docs/connectors/sinks/s3-46","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"none"},"5000":{"id":"/docs/connectors/sinks/s3-47","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"Positive count required in messages mode; ignored by size rotation"},"5001":{"id":"/docs/connectors/sinks/s3-48","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"output_format"},"5002":{"id":"/docs/connectors/sinks/s3-49","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"string"},"5003":{"id":"/docs/connectors/sinks/s3-50","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"json_lines"},"5004":{"id":"/docs/connectors/sinks/s3-51","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"json_lines, json_array, or raw"},"5005":{"id":"/docs/connectors/sinks/s3-52","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"include_metadata"},"5006":{"id":"/docs/connectors/sinks/s3-53","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"bool"},"5007":{"id":"/docs/connectors/sinks/s3-54","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"true"},"5008":{"id":"/docs/connectors/sinks/s3-55","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"Include stream/topic/partition/offset/timestamp in JSON output"},"5009":{"id":"/docs/connectors/sinks/s3-56","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"include_headers"},"5010":{"id":"/docs/connectors/sinks/s3-57","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"bool"},"5011":{"id":"/docs/connectors/sinks/s3-58","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"false"},"5012":{"id":"/docs/connectors/sinks/s3-59","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"Include available headers in JSON output, independently of metadata"},"5013":{"id":"/docs/connectors/sinks/s3-60","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"Further options cover credentials (access_key_id / secret_access_key), retries (max_attempts defaults to 3, retry_delay to 1s), and path_style addressing (auto-enabled when endpoint is set, overridable with false). max_retries is an alias for max_attempts; 0 and 1 both make one outer upload attempt. Invalid retry durations prevent startup; 0s is allowed. Output format names are case-insensitive, with jsonl and jsonlines aliases for json_lines. See the upstream s3_sink README for the full reference."},"5014":{"id":"/docs/connectors/sinks/s3-61","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"Each stream/topic/partition has its own buffer, retained across polls. Rotation is checked after appending a complete formatted record. Size mode counts record bytes but excludes JSON newlines, commas and array brackets, so an object can exceed max_file_size. Message-count mode does not also enforce the size threshold. Uploads use one PutObject, with no multipart upload; choose thresholds and message sizes that fit the store's single-upload limit. There is no timer flush: a partial buffer waits until its threshold is reached or the connector closes."},"5015":{"id":"/docs/connectors/sinks/s3-62","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"Path templates support {stream}, {topic}, {partition}, {date}, {hour}, and {timestamp}. The time-based variables derive from the first message timestamp in each buffer: date/hour use UTC, and {timestamp} is epoch milliseconds. File names embed the partition (zero-padded to 5 digits, to prevent cross-partition collisions) and the offset range (zero-padded to 20 digits), e.g. application_logs/api_requests/2026-03-16/14/00000-00000000000000000000-00000000000000000999.jsonl before adding the configured prefix."},"5016":{"id":"/docs/connectors/sinks/s3-63","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"Stream/topic substitutions preserve ASCII letters, digits, ., _ and -, replacing other characters with _. Distinct names can therefore produce the same key. Keep stream/topic separation in the template, use names that remain distinct after replacement, and avoid sharing the same output paths across independent producers. A repeated object key overwrites the current object, subject to bucket versioning; the offset range alone does not provide global deduplication. Extensions are .jsonl, .json and .bin for the three formats."},"5017":{"id":"/docs/connectors/sinks/s3-64","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#credentials","content":"Credentials resolve in order of precedence: explicit access_key_id + secret_access_key in the config (both together or neither), environment credentials, the shared credentials file, STS web identity, ECS container credentials, then EC2 instance metadata (IMDSv2 before v1). The chain is provided by the pinned aws-creds dependency, not the AWS SDK."},"5018":{"id":"/docs/connectors/sinks/s3-65","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#credentials","content":"Environment credentials use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, with optional AWS_SESSION_TOKEN / AWS_SECURITY_TOKEN. The file path is AWS_SHARED_CREDENTIALS_FILE or ~/.aws/credentials; this plugin reads its [default] section and does not select AWS_PROFILE. Web identity uses AWS_ROLE_ARN and AWS_WEB_IDENTITY_TOKEN_FILE. The container path uses AWS_CONTAINER_CREDENTIALS_RELATIVE_URI. Explicit config credentials have no session-token option; use the environment or credentials file for a temporary key pair and token."},"5019":{"id":"/docs/connectors/sinks/s3-66","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#credentials","content":"Startup writes an empty object at the bucket-root key .iggy-sink-probe, then attempts to delete it. The probe ignores prefix, needs PutObject on that key, and rejects non-success HTTP statuses. ListBucket is not required; failed probe cleanup does not prevent startup. Reserve this key: an existing object at that name is overwritten, and deleted if the credentials permit cleanup."},"5020":{"id":"/docs/connectors/sinks/s3-67","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#minio-example","content":"Start a local MinIO server:"},"5021":{"id":"/docs/connectors/sinks/s3-68","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#minio-example","content":"After the health request succeeds, create the bucket using MinIO's client. These commands use Docker host networking on Linux:"},"5022":{"id":"/docs/connectors/sinks/s3-69","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#minio-example","content":"Replace the earlier [plugin_config] table with this local configuration. One message per file makes the example upload immediately:"},"5023":{"id":"/docs/connectors/sinks/s3-70","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#minio-example","content":"Create the Iggy resources, send a JSON message, and start the runtime as described in the sink guide:"},"5024":{"id":"/docs/connectors/sinks/s3-71","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#minio-example","content":"List the uploaded objects:"},"5025":{"id":"/docs/connectors/sinks/s3-72","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#output-formats","content":"JSON Lines and JSON Array contain wrapper objects with the decoded/transformed payload under payload. JSON payloads retain their JSON value; text and Proto variants become strings. Raw bytes containing valid JSON are parsed, while other raw bytes, Avro and FlatBuffer variants become base64 strings. Those strings do not carry an encoding tag."},"5026":{"id":"/docs/connectors/sinks/s3-73","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#output-formats","content":"With metadata enabled, each wrapper also contains offset, a UTC timestamp at second precision, stream, topic and partition_id. Message IDs, checksums and origin timestamps are not included. Headers are a separate optional object: string values remain strings, raw values become base64, booleans become booleans and supported numeric types become JSON numbers; other values use strings."},"5027":{"id":"/docs/connectors/sinks/s3-74","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#output-formats","content":"Raw output concatenates payload bytes without delimiters and ignores both inclusion flags. To preserve the original payload bytes, use schema = \"raw\" and no transform that changes them; decoding JSON before raw output can reserialize it."},"5028":{"id":"/docs/connectors/sinks/s3-75","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#delivery-semantics","content":"The runtime auto-commits while polling. It logs/counts a failed plugin callback and continues without replaying that batch. A successful callback can mean only that messages were buffered, so runtime processed counts do not establish delivery to S3. A crash loses unflushed buffers; there is no write-ahead log or dead-letter queue."},"5029":{"id":"/docs/connectors/sinks/s3-76","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#delivery-semantics","content":"The sink retries HTTP 408, 429, 5xx and client errors. Other HTTP statuses stop the upload immediately. Its exponential backoff includes jitter and a 60-second cap, without handling Retry-After. The S3 library also retries transport errors once internally and uses a 60-second request timeout, so max_attempts counts outer PutObject calls rather than individual network requests or a total time budget. The startup probe does not use the sink's upload retry loop."},"5030":{"id":"/docs/connectors/sinks/s3-77","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#delivery-semantics","content":"Buffers are cleared before upload. A failed upload loses those messages and stops processing the remainder of that poll. The sink tries to write an additional .lost object containing the offset range, message count and error, using the same retry policy. This marker contains no payload and may also fail. Graceful close attempts to flush remaining buffers, logs failures, and still returns success. Neither runtime counters nor shutdown success prove that every message was stored, and the sink provides no end-to-end delivery or deduplication guarantee."},"5031":{"id":"/docs/connectors/sinks/s3-78","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#delivery-semantics","content":"Size your rotation thresholds accordingly: smaller files bound the loss window, larger files upload more efficiently."},"5032":{"id":"/docs/connectors/sinks/s3-79","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#transforms","content":"Transforms can be applied before writing to S3. See the transforms documentation for the available types and their configuration."},"5033":{"id":"/docs/connectors/sinks/sink","page_id":"/docs/connectors/sinks/sink","type":"page","content":"Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/sink"},"5034":{"id":"/docs/connectors/sinks/sink-0","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink","content":"What sink connectors do, and the Sink trait every one of them implements."},"5035":{"id":"/docs/connectors/sinks/sink-1","page_id":"/docs/connectors/sinks/sink","type":"heading","tags":[],"url":"/docs/connectors/sinks/sink#overview","content":"Overview"},"5036":{"id":"/docs/connectors/sinks/sink-2","page_id":"/docs/connectors/sinks/sink","type":"heading","tags":[],"url":"/docs/connectors/sinks/sink#configuration","content":"Configuration"},"5037":{"id":"/docs/connectors/sinks/sink-3","page_id":"/docs/connectors/sinks/sink","type":"heading","tags":[],"url":"/docs/connectors/sinks/sink#environment-variable-overrides","content":"Environment Variable Overrides"},"5038":{"id":"/docs/connectors/sinks/sink-4","page_id":"/docs/connectors/sinks/sink","type":"heading","tags":[],"url":"/docs/connectors/sinks/sink#sample-implementation","content":"Sample implementation"},"5039":{"id":"/docs/connectors/sinks/sink-5","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#overview","content":"Sink connectors are responsible for writing data from Iggy streams to external systems or destinations. They provide a way to integrate Apache Iggy with various data sources and destinations, enabling data flow between Iggy and external systems."},"5040":{"id":"/docs/connectors/sinks/sink-6","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#overview","content":"The sink is represented by the single Sink trait, which defines the basic interface for all sink connectors. It provides methods for initializing the sink, writing data to external destination, and closing the sink."},"5041":{"id":"/docs/connectors/sinks/sink-7","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"With the local configuration provider, each sink connector has a TOML file in the directory specified by the main runtime config. The runtime also supports an HTTP configuration provider."},"5042":{"id":"/docs/connectors/sinks/sink-8","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"Field"},"5043":{"id":"/docs/connectors/sinks/sink-9","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"Meaning"},"5044":{"id":"/docs/connectors/sinks/sink-10","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"key"},"5045":{"id":"/docs/connectors/sinks/sink-11","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"Connector key (String), separate from the numeric plugin instance ID."},"5046":{"id":"/docs/connectors/sinks/sink-12","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"enabled"},"5047":{"id":"/docs/connectors/sinks/sink-13","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"Whether to start the connector (bool)."},"5048":{"id":"/docs/connectors/sinks/sink-14","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"version"},"5049":{"id":"/docs/connectors/sinks/sink-15","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"Configuration version (u64)."},"5050":{"id":"/docs/connectors/sinks/sink-16","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"name"},"5051":{"id":"/docs/connectors/sinks/sink-17","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"Display name (String)."},"5052":{"id":"/docs/connectors/sinks/sink-18","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"path"},"5053":{"id":"/docs/connectors/sinks/sink-19","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#configuration","content":"Shared-library path (String)."},"505