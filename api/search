ents_table_max"},"4140":{"id":"/docs/server/configuration-522","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"8192"},"4141":{"id":"/docs/server/configuration-523","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"Slots in the VSR client table: how many distinct clients (TCP/QUIC/WebSocket virtual clients and HTTP sessions together) hold live session state. When full, the client with the oldest last commit is evicted and re-registers on its next request. The HTTP session cap tracks this at half. Must be between 2 and 65536."},"4142":{"id":"/docs/server/configuration-524","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"partitions_max"},"4143":{"id":"/docs/server/configuration-525","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"0"},"4144":{"id":"/docs/server/configuration-526","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"Total partition admission limit. Zero leaves this limit disabled."},"4145":{"id":"/docs/server/configuration-527","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"change_log_resource_capacity"},"4146":{"id":"/docs/server/configuration-528","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"65536"},"4147":{"id":"/docs/server/configuration-529","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"Retained resource metadata changes."},"4148":{"id":"/docs/server/configuration-530","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"change_log_activity_capacity"},"4149":{"id":"/docs/server/configuration-531","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"16384"},"4150":{"id":"/docs/server/configuration-532","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"Retained activity metadata changes."},"4151":{"id":"/docs/server/configuration-533","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Partition storage and consensus tunables share this table. Unlike [metadata] (one plane on shard 0), a pipeline exists per partition, so raising per-partition budgets multiplies resource use by the partition count."},"4152":{"id":"/docs/server/configuration-534","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"durability, consumer_offset_durability, segment size, preallocation, and the message/byte flush thresholds are topic creation options. wal_bytes_max sizes the persistence machinery without selecting the topic's completion policy."},"4153":{"id":"/docs/server/configuration-535","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Key"},"4154":{"id":"/docs/server/configuration-536","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Default"},"4155":{"id":"/docs/server/configuration-537","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Description"},"4156":{"id":"/docs/server/configuration-538","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"prepare_queue_depth"},"4157":{"id":"/docs/server/configuration-539","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"32"},"4158":{"id":"/docs/server/configuration-540","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Uncommitted produce and consumer-offset ops in flight per partition. Submits past it spill into a request queue of twice this depth. Once both are full the server rejects the request with TransientNotAccepted. A lost rejection reply can still make the client wait for its timeout. Must be between 1 and 127."},"4159":{"id":"/docs/server/configuration-541","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"validate_checksum"},"4160":{"id":"/docs/server/configuration-542","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"true"},"4161":{"id":"/docs/server/configuration-543","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Re-hash batches read from segment storage and report a mismatch instead of serving them."},"4162":{"id":"/docs/server/configuration-544","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"wal_bytes_max"},"4163":{"id":"/docs/server/configuration-545","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"\"256 MiB\""},"4164":{"id":"/docs/server/configuration-546","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Active WAL plus queued/in-flight prepare budget per multi-replica partition when either topic policy is persisted. A 4 KiB multiple, from 128 MiB + 8 KiB through 4 GiB. Checkpointing reclaims history only after materialized state is synchronized. Temporary rewrites require extra disk space. Environment override: IGGY_PARTITION_WAL_BYTES_MAX."},"4165":{"id":"/docs/server/configuration-547","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"repair_memory_bytes_max"},"4166":{"id":"/docs/server/configuration-548","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"\"1 GiB\""},"4167":{"id":"/docs/server/configuration-549","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Node-wide budget shared by unproven repair walks and snapshot repair tails."},"4168":{"id":"/docs/server/configuration-550","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"wal_group_commit_delay_micros"},"4169":{"id":"/docs/server/configuration-551","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"0"},"4170":{"id":"/docs/server/configuration-552","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Delay before a persisted partition WAL barrier, at most 10000 microseconds. Zero disables the delay."},"4171":{"id":"/docs/server/configuration-553","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"dedup_clients_max"},"4172":{"id":"/docs/server/configuration-554","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"4096"},"4173":{"id":"/docs/server/configuration-555","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Initial slots for session-qualified retry protection per partition. A full table rejects new writers with TransientNotAccepted. Ordered session retirement releases slots. The first committed operation fixes this capacity, from 1 through 65536."},"4174":{"id":"/docs/server/configuration-556","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"consumer_offsets_max"},"4175":{"id":"/docs/server/configuration-557","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"4096"},"4176":{"id":"/docs/server/configuration-558","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Durable offset keys admitted per partition, counted separately for standalone consumers and groups. Existing keys remain writable at the limit. New keys are rejected with TooManyConsumerOffsets. Between 1 and 262144."},"4177":{"id":"/docs/server/configuration-559","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"offset_reservation_lease"},"4178":{"id":"/docs/server/configuration-560","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"65536"},"4179":{"id":"/docs/server/configuration-561","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Offsets reserved ahead in the superblock for single-replica partitions. Crash recovery skips the unused reservation to avoid reusing acknowledged offsets. Multi-replica groups ignore it. Between 1 and 16777216."},"4180":{"id":"/docs/server/configuration-562","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"evicted_ring_capacity"},"4181":{"id":"/docs/server/configuration-563","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"65536"},"4182":{"id":"/docs/server/configuration-564","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Maximum repair entries per replicated partition. At most 65536 entries. Single-replica partitions retain none."},"4183":{"id":"/docs/server/configuration-565","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"evicted_ring_bytes_max"},"4184":{"id":"/docs/server/configuration-566","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"\"64 MiB\""},"4185":{"id":"/docs/server/configuration-567","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Byte ceiling for the repair ring. Older batches can leave memory and be read from disk. At most 256 MiB."},"4186":{"id":"/docs/server/configuration-568","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"transfer_served_cache_bytes_max"},"4187":{"id":"/docs/server/configuration-569","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"\"2176 MiB\""},"4188":{"id":"/docs/server/configuration-570","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Byte budget, per shard, for segment payloads kept resident to serve state-transfer chunk requests. The default fits two sealed segments at the 1 GiB ceiling, each with one max-message overshoot. Serving concurrency is floor(this / max(transfer_artifact_bytes_max, 1 GiB + 64 MiB)), minimum one. Boot warns when it drops below two. At most \"64 GiB\"."},"4189":{"id":"/docs/server/configuration-571","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"transfer_artifact_bytes_max"},"4190":{"id":"/docs/server/configuration-572","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/do