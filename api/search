lugin consume() error is counted as a failed batch. The runtime uses auto-commit when polling and does not automatically retry that failed batch; any destination retry must be implemented by the plugin."},"5090":{"id":"/docs/connectors/sinks/sink-56","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"Build the matching plugin, runtime and CLI from the repository root:"},"5091":{"id":"/docs/connectors/sinks/sink-57","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"On an empty broker, create the configured stream and topic:"},"5092":{"id":"/docs/connectors/sinks/sink-58","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"After saving the configuration files above, start the runtime. This explicitly enables the sink if you tried the optional disabling override:"},"5093":{"id":"/docs/connectors/sinks/sink-59","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"Produce JSON messages to this topic, for example with the Random source, to see the sink output."},"5094":{"id":"/docs/connectors/sinks/sink-60","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"And that's all, enjoy using the sink connector!"},"5095":{"id":"/docs/connectors/sinks/sink-61","page_id":"/docs/connectors/sinks/sink","tags":[],"type":"text","url":"/docs/connectors/sinks/sink#sample-implementation","content":"On a side note, if you'd like to produce the messages to the Iggy stream instead, you can implement your own Source connector too :)"},"5096":{"id":"/docs/connectors/sinks/stdout","page_id":"/docs/connectors/sinks/stdout","type":"page","content":"Stdout Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/stdout"},"5097":{"id":"/docs/connectors/sinks/stdout-0","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout","content":"Print messages from Iggy streams to standard output, for debugging and verifying a connector pipeline."},"5098":{"id":"/docs/connectors/sinks/stdout-1","page_id":"/docs/connectors/sinks/stdout","type":"heading","tags":[],"url":"/docs/connectors/sinks/stdout#configuration","content":"Configuration"},"5099":{"id":"/docs/connectors/sinks/stdout-2","page_id":"/docs/connectors/sinks/stdout","type":"heading","tags":[],"url":"/docs/connectors/sinks/stdout#plugin-config-options","content":"Plugin config options"},"5100":{"id":"/docs/connectors/sinks/stdout-3","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout","content":"The stdout sink connector prints messages from Iggy streams to the standard output. This is useful for debugging, development, and verifying that your connector pipeline is working correctly."},"5101":{"id":"/docs/connectors/sinks/stdout-4","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout","content":"The connector emits info-level tracing events through the runtime to stdout. The runtime selects text or JSON with logging.format and filters events with RUST_LOG (default INFO). It logs batch metadata on every invocation; print_payload additionally logs each message's offset and decoded payload. The invocation counter is in memory and resets when the plugin is recreated."},"5102":{"id":"/docs/connectors/sinks/stdout-5","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout#configuration","content":"Use the broker credentials and runtime setup from the sink guide. Save the configuration below in that runtime's connector directory. From the matching 0.9.0/edge repository root, build the plugin:"},"5103":{"id":"/docs/connectors/sinks/stdout-6","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout#plugin-config-options","content":"Option"},"5104":{"id":"/docs/connectors/sinks/stdout-7","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout#plugin-config-options","content":"Type"},"5105":{"id":"/docs/connectors/sinks/stdout-8","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout#plugin-config-options","content":"Default"},"5106":{"id":"/docs/connectors/sinks/stdout-9","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout#plugin-config-options","content":"Description"},"5107":{"id":"/docs/connectors/sinks/stdout-10","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout#plugin-config-options","content":"print_payload"},"5108":{"id":"/docs/connectors/sinks/stdout-11","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout#plugin-config-options","content":"bool"},"5109":{"id":"/docs/connectors/sinks/stdout-12","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout#plugin-config-options","content":"false"},"5110":{"id":"/docs/connectors/sinks/stdout-13","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout#plugin-config-options","content":"Whether to print the message payload to stdout"},"5111":{"id":"/docs/connectors/sinks/stdout-14","page_id":"/docs/connectors/sinks/stdout","tags":[],"type":"text","url":"/docs/connectors/sinks/stdout#plugin-config-options","content":"Create my-stream and my-topic before starting the runtime, or change the sample to use existing resources. The Random source configuration produces JSON to the same destination."},"5112":{"id":"/docs/connecto