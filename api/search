url":"/docs/server/configuration#systemlogging","content":"[system.logging]"},"2593":{"id":"/docs/server/configuration-23","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#systemencryption","content":"[system.encryption]"},"2594":{"id":"/docs/server/configuration-24","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#systempartition","content":"[system.partition]"},"2595":{"id":"/docs/server/configuration-25","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#systemsegment-and-systemrecovery","content":"[system.segment] and [system.recovery]"},"2596":{"id":"/docs/server/configuration-26","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#systemmemory_pool","content":"[system.memory_pool]"},"2597":{"id":"/docs/server/configuration-27","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#data_maintenancemessages","content":"[data_maintenance.messages]"},"2598":{"id":"/docs/server/configuration-28","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#heartbeat","content":"[heartbeat]"},"2599":{"id":"/docs/server/configuration-29","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#telemetry","content":"[telemetry]"},"2600":{"id":"/docs/server/configuration-30","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#systemsharding","content":"[system.sharding]"},"2601":{"id":"/docs/server/configuration-31","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#metadata","content":"[metadata]"},"2602":{"id":"/docs/server/configuration-32","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#partition","content":"[partition]"},"2603":{"id":"/docs/server/configuration-33","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#message_bus","content":"[message_bus]"},"2604":{"id":"/docs/server/configuration-34","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#personal_access_token","content":"[personal_access_token]"},"2605":{"id":"/docs/server/configuration-35","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#consumer_group","content":"[consumer_group]"},"2606":{"id":"/docs/server/configuration-36","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#node","content":"[node]"},"2607":{"id":"/docs/server/configuration-37","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#cluster","content":"[cluster]"},"2608":{"id":"/docs/server/configuration-38","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration","content":"The server reads a single TOML file. A copy of core/server/config.toml is embedded into the binary and serves as the default configuration, so the server boots with working defaults even without any file on disk. The embedded file is commented throughout and is the authoritative reference for the exact version you're running."},"2609":{"id":"/docs/server/configuration-39","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration","content":"A config file doesn't have to be complete. It is merged over the embedded defaults, so a minimal file overrides only what it names:"},"2610":{"id":"/docs/server/configuration-40","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration","content":"Both listeners here bind a wildcard, which tells the server nothing about where clients reach it, so [node] has to name that address explicitly - without it this file is refused at boot."},"2611":{"id":"/docs/server/configuration-41","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#how-configuration-loads","content":"Configuration is resolved in three layers. Later layers win:"},"2612":{"id":"/docs/server/configuration-42","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#how-configuration-loads","content":"Embedded defaults: the config.toml compiled into the binary."},"2613":{"id":"/docs/server/configuration-43","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#how-configuration-loads","content":"Config file: the path in IGGY_CONFIG_PATH, or core/server/config.toml resolved against the current working directory. A missing file is only a warning. The server continues on embedded defaults."},"2614":{"id":"/docs/server/configuration-44","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#how-configuration-loads","content":"Environment variables: any IGGY_-prefixed override."},"2615":{"id":"/docs/server/configuration-45","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#how-configuration-loads","content":"Before the environment is read, the server loads a .env file from the working directory, or from the path named by IGGY_ENV_PATH."},"2616":{"id":"/docs/server/configuration-46","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#how-configuration-loads","content":"After boot the server writes the effective configuration, including the addresses it actually bound, to {system.path}/runtime/current_config.toml."},"2617":{"id":"/docs/server/configuration-47","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#environment-variables","content":"Every configuration key can be overridden with an IGGY_ variable. The name is the TOML path, uppercased, with dots turned into underscores:"},"2618":{"id":"/docs/server/configuration-48","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#environment-variables","content":"Two variables live outside the config schema: IGGY_ROOT_USERNAME and IGGY_ROOT_PASSWORD set the root credentials, always as a pair. Only the first creation of the root user reads them. On an existing data directory the stored root user is recovered unchanged."},"2619":{"id":"/docs/server/configuration-49","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#secrets","content":"Five values are secret-flagged: http.jwt.encoding_secret, http.jwt.decoding_secret, system.encryption.key, cluster.auth.shared_secret, and cluster.auth.previous_shared_secret. Prefer setting them through their environment variables (IGGY_HTTP_JWT_ENCODING_SECRET, IGGY_SYSTEM_ENCRYPTION_KEY, IGGY_CLUSTER_AUTH_SHARED_SECRET, and so on) instead of storing them in a file. Secret values are masked in logs and never serialized into runtime/current_config.toml."},"2620":{"id":"/docs/server/configuration-50","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#validation-at-boot","content":"Unknown keys are silently ignored. A typo in a key name leaves the default in force, so check spelling when a setting doesn't seem to take effect. The relocated keys below are the exception: they refuse boot."},"2621":{"id":"/docs/server/configuration-51","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#validation-at-boot","content":"system.segment.archive_expired = true and system.recovery.recreate_missing_state = true are unsupported placeholders. Setting either aborts boot."},"2622":{"id":"/docs/server/configuration-52","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#validation-at-boot","content":"Several sections validate relationships between keys (QUIC windows, sharding shutdown budgets, metadata journal sizing, partition transfer floors). A violation aborts boot with an error naming the keys. The constraints are listed with their sections below."},"2623":{"id":"/docs/server/configuration-53","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#validation-at-boot","content":"The RUST_LOG environment variable always takes precedence over system.logging.level."},"2624":{"id":"/docs/server/configuration-54","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#command-line-flags","content":"iggy-server accepts exactly three flags:"},"2625":{"id":"/docs/server/configuration-55","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#command-line-flags","content":"Flag"},"2626":{"id":"/docs/server/configuration-56","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#command-line-flags","content":"Description"},"2627":{"id":"/docs/server/configuration-57","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#command-line-flags","content":"--fresh, -f"},"2628":{"id":"/docs/server/configuration-58","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#command-line-flags","content":"Delete the configured data directory (local_data by default, see IGGY_SYSTEM_PATH) before boot and start on empty state. In cluster mode this wipes this replica only; it rejoins and refills by state transfer from the others. Wiping a quorum at the same time destroys committed data. Do not put --fresh in a service unit: it would re-transfer the whole dataset on every restart."},"2629":{"id":"/docs/server/configuration-59","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#command-line-flags","content":"--with-default-root-credentials"},"2630":{"id":"/docs/server/configuration-60","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#command-line-flags","content":"Set IGGY_ROOT_USERNAME and IGGY_ROOT_PASSWORD to iggy unless they are already present in the environment. Only the first creation of the root user reads these values. Development only."},"2631":{"id":"/docs/server/configuration-61","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#command-line-flags","content":"--replica-id <N>"},"2632":{"id":"/docs/server/configuration-62","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#command-line-flags","content":"Identify this node within cluster.nodes. Required when cluster.enabled = true; the value must match exactly one replica_id in the roster."},"2633":{"id":"/docs/server/configuration-63","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"Retention, durability, and segment layout are no longer server-wide settings. They became per-topic options set at topic creation. See Topic options. The server refuses to boot while any of the old keys is still present, in the config file or in the environment, and the error names the replacement. This is deliberate: the storage knobs are create-only options now, so a topic created while an old key was silently ignored could never be given the setting afterwards."},"2634":{"id":"/docs/server/configuration-64","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"Old server key"},"2635":{"id":"/docs/server/configuration-65","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"Replacement"},"2636":{"id":"/docs/server/configuration-66","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.topic.max_size"},"2637":{"id":"/docs/server/configuration-67","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"max_topic_size topic option"},"2638":{"id":"/docs/server/configuration-68","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.topic.message_expiry"},"2639":{"id":"/docs/server/configuration-69","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"message_expiry topic option"},"2640":{"id":"/docs/server/configuration-70","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.partition.enforce_fsync"},"2641":{"id":"/docs/server/configuration-71","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"enforce_fsync topic option"},"2642":{"id":"/docs/server/configuration-72","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.partition.messages_required_to_save"},"2643":{"id":"/docs/server/configuration-73","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"messages_required_to_save topic option"},"2644":{"id":"/docs/server/configuration-74","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.partition.size_of_messages_required_to_save"},"2645":{"id":"/docs/server/configuration-75","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"size_of_messages_required_to_save topic option"},"2646":{"id":"/docs/server/configuration-76","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.segment.size"},"2647":{"id":"/docs/server/configuration-77","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"segment_size topic option"},"2648":{"id":"/docs/server/configuration-78","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.segment.preallocate"},"2649":{"id":"/docs/server/configuration-79","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"preallocate_segments topic option"},"2650":{"id":"/docs/server/configuration-80","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.message_deduplication (whole section)"},"2651":{"id":"/docs/server/configuration-81","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"Removed with the feature. No replacement."},"2652":{"id":"/docs/server/configuration-82","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"extra (whole section)"},"2653":{"id":"/docs/server/configuration-83","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"Removed. Admission caps are compile-time constants. No replacement."},"2654":{"id":"/docs/server/configuration-84","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"Other sections from older configs ([message_saver], [system.state], [system.backup], [system.compression], [tcp.socket], segment cache_indexes, and similar) were removed without a boot check. Like any unknown key they're silently ignored. Remove them from your file."},"2655":{"id":"/docs/server/configuration-85","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#reference","content":"The tables below list every section with its shipped defaults. In cluster mode, every enabled transport takes its port from this node's cluster.nodes ports entry. The transport's own address picks only the bind interface."},"2656":{"id":"/docs/server/configuration-86","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"Key"},"2657":{"id":"/docs/server/configuration-87","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"Default"},"2658":{"id":"/docs/server/configuration-88","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"Description"},"2659":{"id":"/docs/server/configuration-89","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"enabled"},"2660":{"id":"/docs/server/configuration-90","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"true"},"2661":{"id":"/docs/server/configuration-91","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"Serve the HTTP REST API."},"2662":{"id":"/docs/server/configuration-92","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"