ge_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"json_each_row, row_binary, or string"},"5476":{"id":"/docs/connectors/sinks/clickhouse-40","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"string_format"},"5477":{"id":"/docs/connectors/sinks/clickhouse-41","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"string"},"5478":{"id":"/docs/connectors/sinks/clickhouse-42","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"json_each_row"},"5479":{"id":"/docs/connectors/sinks/clickhouse-43","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"ClickHouse format for string mode: json_each_row, csv, or tsv"},"5480":{"id":"/docs/connectors/sinks/clickhouse-44","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"timeout_seconds"},"5481":{"id":"/docs/connectors/sinks/clickhouse-45","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"u64"},"5482":{"id":"/docs/connectors/sinks/clickhouse-46","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"30"},"5483":{"id":"/docs/connectors/sinks/clickhouse-47","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"HTTP request timeout in seconds"},"5484":{"id":"/docs/connectors/sinks/clickhouse-48","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"max_retries"},"5485":{"id":"/docs/connectors/sinks/clickhouse-49","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"u32"},"5486":{"id":"/docs/connectors/sinks/clickhouse-50","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"3"},"5487":{"id":"/docs/connectors/sinks/clickhouse-51","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"Total attempts for startup requests and transient insert errors. At least one even when 0"},"5488":{"id":"/docs/connectors/sinks/clickhouse-52","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"retry_delay"},"5489":{"id":"/docs/connectors/sinks/clickhouse-53","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"u64"},"5490":{"id":"/docs/connectors/sinks/clickhouse-54","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"1"},"5491":{"id":"/docs/connectors/sinks/clickhouse-55","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"Base for exponential retry delay, in seconds"},"5492":{"id":"/docs/connectors/sinks/clickhouse-56","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"verbose_logging"},"5493":{"id":"/docs/connectors/sinks/clickhouse-57","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"bool"},"5494":{"id":"/docs/connectors/sinks/clickhouse-58","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"false"},"5495":{"id":"/docs/connectors/sinks/clickhouse-59","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"Log inserts at info level instead of debug"},"5496":{"id":"/docs/connectors/sinks/clickhouse-60","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"json_each_row (default): accepts JSON payloads. Each payload is serialized on its own line using ClickHouse's JSONEachRow format. Send JSON objects whose fields and values are compatible with the existing table and its ClickHouse input settings. The connector does not validate JSON rows against the table schema before sending them."},"5497":{"id":"/docs/connectors/sinks/clickhouse-61","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"row_binary: accepts JSON payloads and serializes them to ClickHouse's RowBinaryWithDefaults binary format, which is more efficient than JSON at high volume. The table must already exist. Its schema is fetched from system.columns and validated at startup. Requires ClickHouse 23.7 or newer, which introduced this format. Columns with a DEFAULT expression may be omitted from messages. An explicit JSON null requires a nullable column and is stored as NULL, even when that column has a default. Missing columns without defaults must be nullable. MATERIALIZED, ALIAS, and EPHEMERAL columns are dropped from the schema. Unsupported column types (128/256-bit integers, Variant, native JSON, geo types) cause startup to fail."},"5498":{"id":"/docs/connectors/sinks/clickhouse-62","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"string: accepts text payloads and appends a newline to each payload that does not already end with one. Set the stream schema = \"text\". Use string_format to tell ClickHouse which format the payload is in (csv, tsv, or json_each_row)."},"5499":{"id":"/docs/connectors/sinks/clickhouse-63","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"In row_binary mode the schema is captured once at startup and the insert stream is positional. An ALTER TABLE on the target while the connector runs can silently corrupt inserted rows, so restart the connector after any schema change. The self-describing json_each_row format (including string mode with string_format = \"json_each_row\") maps values by field name, but changed column names, types, or constraints can still make inserts fail. string passthrough with csv or tsv sends plain positional ClickHouse formats mapped by the current table column order."},"5500":{"id":"/docs/connectors/sinks/clickhouse-64","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#error-handling--delivery-semantics","content":"Insert requests retry HTTP 408, 429, and 5xx responses, plus network and timeout errors. Other unsuccessful HTTP statuses fail immediately. max_retries is the total attempt limit, with at least one attempt even when set to 0. Before retry number n (starting at 1), the delay is sampled from zero through min(retry_delay * 2^n, 60) seconds. With the defaults, there are at most three attempts and the first retry waits between zero and two seconds. The startup ping and, in row_binary mode, schema fetch use the same limit and backoff but retry every error."},"5501":{"id":"/docs/connectors/sinks/clickhouse-65","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#error-handling--delivery-semantics","content":"A message whose payload type does not match the chosen format is skipped with an error log. The rest of the batch is still sent. A batch with no serializable payloads returns success without an insert. In row_binary mode, a JSON row whose values cannot be converted to the column types fails the whole batch before any insert request, so it does not enter the plugin's insert retry loop."},"5502":{"id":"/docs/connectors/sinks/clickhouse-66","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#error-handling--delivery-semantics","content":"The runtime uses consumer auto-commit and does not replay a failed sink batch. See sink guide. End-to-end at-least-once delivery is therefore not guaranteed. Plugin retries resend the same batch without an insert_deduplication_token, so a lost acknowledgement can also produce duplicate rows."},"5503":{"id":"/docs/connectors/sinks/clickhouse-67","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#error-handling--delivery-semantics","content":"ClickHouse deduplication depends on the table engine, query settings, identical retry data, and the retained deduplication window. ReplicatedMergeTree enables a deduplication log by default. Non-replicated MergeTree can also deduplicate when non_replicated_deduplication_window is positive. Its default is zero. See ClickHouse insert deduplication for the settings and limits."},"5504":{"id":"/docs/connectors/sinks/clickhouse-68","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#transforms","content":"Transforms can be applied before inserting into ClickHouse. See the transforms documentation for the available types and their configuration."},"5505":{"id":"/docs/connectors/sinks/delta","page_id":"/docs/connectors/sinks/delta","type":"page","content":"Delta Lake Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/delta"},"5506":{"id":"/docs/connectors/sinks/delta-0","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta","content":"Write messages from Iggy streams into Delta Lake tables on local disk, S3, Azure Blob Storage or Google Cloud Storage."},"5507":{"id":"/docs/connectors/sinks/delta-1","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#configuration","content":"Configuration"},"5508":{"id":"/docs/connectors/sinks/delta-2","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#options","content":"Options"},"5509":{"id":"/docs/connectors/sinks/delta-3","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#s3-example","content":"S3 example"},"5510":{"id":"/docs/connectors/sinks/delta-4","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#type-coercion","content":"Type Coercion"},"5511":{"id":"/docs/connectors/sinks/delta-5","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#batching--transactions","content":"Batching & Transactions"},"5512":{"id":"/docs/connectors/sinks/delta-6","page_id":"/docs/connectors/sinks/delta","type":"heading","tags":[],"url":"/docs/connectors/sinks/delta#transforms","content":"Transforms"},"5513":{"id":"/docs/connectors/sinks/delta-7","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta","content":"The Delta Lake sink connector consumes messages from Iggy streams and writes them to Delta Lake tables on the local filesystem, AWS S3, Azure Blob Storage, or Google Cloud Storage. Each successful nonempty batch is flushed and appended in one Delta transaction."},"5514":{"id":"/docs/connectors/sinks/delta-8","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta","content":"This page is a curated subset of the documentation. The canonical reference is the upstream delta_sink README in the apache/iggy repository."},"5515":{"id":"/docs/connectors/sinks/delta-9","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#configuration","content":"Use the broker credentials and runtime setup from the sink guide. Save the configuration below in the runtime's connector directory. From the matching 0.10.0 repository root, build the plugin:"},"5516":{"id":"/docs/connectors/sinks/delta-10","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#configuration","content":"Create the target table with your Delta Lake tools before starting the connector. The table must already exist at table_uri: the connector opens it at startup and fails if it's missing. It doesn't create tables. Only JSON payloads are supported (schema = \"json\" on the stream). A batch containing another payload type fails."},"5517":{"id":"/docs/connectors/sinks/delta-11","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#configuration","content":"For a table with columns id (long) and name (string), create the Iggy resources and send a row:"},"5518":{"id":"/docs/connectors/sinks/delta-12","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#configuration","content":"Use a file:///... URI for an absolute local path. Bare filesystem paths are not accepted."},"5519":{"id":"/docs/connectors/sinks/delta-13","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Option"},"5520":{"id":"/docs/connectors/sinks/delta-14","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Type"},"5521":{"id":"/docs/connectors/sinks/delta-15","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Default"},"5522":{"id":"/docs/connectors/sinks/delta-16","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Description"},"5523":{"id":"/docs/connectors/sinks/delta-17","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"table_uri"},"5524":{"id":"/docs/connectors/sinks/delta-18","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"string"},"5525":{"id":"/docs/connectors/sinks/delta-19","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"required"},"5526":{"id":"/docs/connectors/sinks/delta-20","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Absolute URI of the Delta table: file://, s3://, az://, or gs://"},"5527":{"id":"/docs/connectors/sinks/delta-21","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"storage_backend_type"},"5528":{"id":"/docs/connectors/sinks/delta-22","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"string"},"5529":{"id":"/docs/connectors/sinks/delta-23","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"none"},"5530":{"id":"/docs/connectors/sinks/delta-24","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"s3, azure, or gcs. Omit for local filesystem tables"},"5531":{"id":"/docs/connectors/sinks/delta-25","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"When storage_backend_type selects a backend, the connector validates these credential options:"},"5532":{"id":"/docs/connectors/sinks/delta-26","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"S3: aws_s3_region is required. Explicit aws_s3_access_key and aws_s3_secret_key are optional and must be supplied together. Without them, credentials come from the supported provider chain. aws_s3_endpoint_url is optional, for S3-compatible stores like MinIO. aws_s3_allow_http is optional and defaults to false."},"5533":{"id":"/docs/connectors/sinks/delta-27","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"Azure: azure_storage_account_name, azure_container_name, and either azure_storage_account_key or azure_storage_sas_token (not both)."},"5534":{"id":"/docs/connectors/sinks/delta-28","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#options","content":"GCS: gcs_service_account_key (the service account JSON as a string, with the bucket taken from the gs:// URI)."},"5535":{"id":"/docs/connectors/sinks/delta-29","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#s3-example","content":"A custom S3 endpoint restricts the default credential chain. Set AWS_FORCE_CREDENTIAL_LOAD=true in the runtime environment when shared profile or SSO credentials are required. Static keys, web identity, container credentials and instance metadata remain available without that override."},"5536":{"id":"/docs/connectors/sinks/delta-30","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"JSON values are coerced to the Delta table schema before writing:"},"5537":{"id":"/docs/connectors/sinks/delta-31","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"Timestamp columns: ISO 8601 / RFC 3339 strings (e.g. \"2021-11-11T22:11:58Z\") are converted to microsecond timestamps. Integer timestamps pass through as epoch microseconds. Space-separated timestamps such as \"2021-11-11 22:11:58\" are interpreted as UTC. Invalid timestamp strings fail the batch."},"5538":{"id":"/docs/connectors/sinks/delta-32","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"String columns: non-null, non-string values are converted to their JSON string representation. Nulls remain null."},"5539":{"id":"/docs/connectors/sinks/delta-33","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"Coercions cover nested structs, arrays of strings or timestamps, and arrays of structs. Nested arrays, maps, and variant columns pass through without these coercions."},"5540":{"id":"/docs/connectors/sinks/delta-34","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#type-coercion","content":"The table schema is captured once at startup and not refreshed, so restart the connector after changing it."},"5541":{"id":"/docs/connectors/sinks/delta-35","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#batching--transactions","content":"Each nonempty batch passed to the plugin is written to Parquet buffers and appended in a single Delta log transaction. Empty batches create no transaction in consume(). The stream's batch_length is a polling limit, so it influences Delta commit granularity: small batches produce many small files and table versions, so prefer larger batches for production tables (and compact periodically). The plugin has no retry loop for failed batches, though the Delta library retries eligible commit conflicts and storage requests. A write or commit failure clears the writer buffers and returns a connector error. The runtime uses consumer auto-commit and does not replay that failed batch, so the Delta transaction does not provide an end-to-end at-least-once guarantee."},"5542":{"id":"/docs/connectors/sinks/delta-36","page_id":"/docs/connectors/sinks/delta","tags":[],"type":"text","url":"/docs/connectors/sinks/delta#transforms","content":"Transforms can be applied before writing to Delta Lake. See the transforms documentation for the available types and their configuration."},"5543":{"id":"/docs/connectors/sinks/doris","page_id":"/docs/connectors/sinks/doris","type":"page","content":"Apache Doris Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/doris"},"5544":{"id":"/docs/connectors/sinks/doris-0","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris","content":"Load JSON messages from Iggy streams into a pre-created Apache Doris table through the Stream Load HTTP API."},"5545":{"id":"/docs/connectors/sinks/doris-1","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#configuration","content":"Configuration"},"5546":{"id":"/docs/connectors/sinks/doris-2","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#common-options","content":"Common Options"},"5547":{"id":"/docs/connectors/sinks/doris-3","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#output-formats","content":"Output Formats"},"5548":{"id":"/docs/connectors/sinks/doris-4","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#delivery-semantics","content":"Delivery Semantics"},"5549":{"id":"/docs/connectors/sinks/doris-5","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#security-notes","content":"Security Notes"},"5550":{"id":"/docs/connectors/sinks/doris-6","page_id":"/docs/connectors/sinks/doris","type":"heading","tags":[],"url":"/docs/connectors/sinks/doris#transforms","content":"Transforms"},"5551":{"id":"/docs/connectors/sinks/doris-7","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris","content":"The Apache Doris sink connector consumes JSON messages from Iggy streams and writes them to a pre-created Doris table via Doris's Stream Load HTTP API. Batches are loaded under deterministic labels so that retries deduplicate while Doris retains those labels."},"5552":{"id":"/docs/connectors/sinks/doris-8","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris","content":"This page is a curated subset of the documentation. The canonical reference, including the label scheme, redirect security model, and operational guidance, is the upstream doris_sink README in the apache/iggy repository."},"5553":{"id":"/docs/connectors/sinks/doris-9","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#configuration","content":"Use the broker credentials and runtime setup from the sink guide. Save the configuration below in the runtime's connector directory and replace the Doris password with your own. From the matching 0.10.0 repository root, build the plugin:"},"5554":{"id":"/docs/connectors/sinks/doris-10","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#configuration","content":"The target database and table must be pre-created. The connector never issues DDL. database and table must match [A-Za-z0-9_]+ or startup fails. Streams must use schema = \"json\". Startup validates the configuration but does not check the table or connection. These are first used when a batch arrives."},"5555":{"id":"/docs/connectors/sinks/doris-11","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#configuration","content":"For a table with columns id (BIGINT) and name (STRING), create the Iggy resources and send a row:"},"5556":{"id":"/docs/connectors/sinks/doris-12","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Option"},"5557":{"id":"/docs/connectors/sinks/doris-13","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Type"},"5558":{"id":"/docs/connectors/sinks/doris-14","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Default"},"5559":{"id":"/docs/connectors/sinks/doris-15","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Description"},"5560":{"id":"/docs/connectors/sinks/doris-16","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"fe_url"},"5561":{"id":"/docs/connectors/sinks/doris-17","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"5562":{"id":"/docs/connectors/sinks/doris-18","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"required"},"5563":{"id":"/docs/connectors/sinks/doris-19","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Doris frontend HTTP base URL, e.g. http://localhost:8030"},"5564":{"id":"/docs/connectors/sinks/doris-20","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"database"},"5565":{"id":"/docs/connectors/sinks/doris-21","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"5566":{"id":"/docs/connectors/sinks/doris-22","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"required"},"5567":{"id":"/docs/connectors/sinks/doris-23","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Target database, [A-Za-z0-9_]+"},"5568":{"id":"/docs/connectors/sinks/doris-24","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"table"},"5569":{"id":"/docs/connectors/sinks/doris-25","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"5570":{"id":"/docs/connectors/sinks/doris-26","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"required"},"5571":{"id":"/docs/connectors/sinks/doris-27","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Target table, [A-Za-z0-9_]+"},"5572":{"id":"/docs/connectors/sinks/doris-28","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"username"},"5573":{"id":"/docs/connectors/sinks/doris-29","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"5574":{"id":"/docs/connectors/sinks/doris-30","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"required"},"5575":{"id":"/docs/connectors/sinks/doris-31","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Doris user authorized for Stream Load. Check the grants required by your Doris version"},"5576":{"id":"/docs/connectors/sinks/doris-32","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"password"},"5577":{"id":"/docs/connectors/sinks/doris-33","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"5578":{"id":"/docs/connectors/sinks/doris-34","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"required"},"5579":{"id":"/docs/connectors/sinks/doris-35","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Doris user password, never logged"},"5580":{"id":"/docs/connectors/sinks/doris-36","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"batch_size"},"5581":{"id":"/docs/connectors/sinks/doris-37","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"u32"},"5582":{"id":"/docs/connectors/sinks/doris-38","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"1000"},"5583":{"id":"/docs/connectors/sinks/doris-39","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Maximum messages per Stream Load request. 0 is treated as 1"},"5584":{"id":"/docs/connectors/sinks/doris-40","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"output_format"},"5585":{"id":"/docs/connectors/sinks/doris-41","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"5586":{"id":"/docs/connectors/sinks/doris-42","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"json"},"5587":{"id":"/docs/connectors/sinks/doris-43","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"json or csv. CSV is opt-in for throughput and requires columns"},"5588":{"id":"/docs/connectors/sinks/doris-44","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"columns"},"5589":{"id":"/docs/connectors/sinks/doris-45","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"5590":{"id":"/docs/connectors/sinks/doris-46","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"unset"},"5591":{"id":"/docs/connectors/sinks/doris-47","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Forwarded as the columns Stream Load header. Pins column order for CSV"},"5592":{"id":"/docs/connectors/sinks/doris-48","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"timeout"},"5593":{"id":"/docs/connectors/sinks/doris-49","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"5594":{"id":"/docs/connectors/sinks/doris-50","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"30s"},"5595":{"id":"/docs/connectors/sinks/doris-51","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Per-request HTTP timeout, including each redirect request"},"5596":{"id":"/docs/connectors/sinks/doris-52","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"max_retries"},"5597":{"id":"/docs/connectors/sinks/doris-53","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"u32"},"5598":{"id":"/docs/connectors/sinks/doris-54","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"3"},"5599":{"id":"/docs/connectors/sinks/doris-55","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Total Stream Load attempts per chunk on transient failures. 0 or 1 means one attempt"},"5600":{"id":"/docs/connectors/sinks/doris-56","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Further options cover the label prefix, connect timeout, retry backoff (retry_delay, max_retry_delay), max_filter_ratio, a where filter, and redirect security (allow_insecure_redirect, allowed_redirect_hosts). See the upstream doris_sink README for the full table with defaults."},"5601":{"id":"/docs/connectors/sinks/doris-57","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#output-formats","content":"json (default): payloads are sent as a JSON array with strip_outer_array: true. Values map to columns by name, so the JSON shape must match the table (use columns if the JSON field names differ from the table columns or you need derived expressions)."},"5602":{"id":"/docs/connectors/sinks/doris-58","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#output-formats","content":"csv: opt-in for throughput. Doris CSV is positional, so output_format = \"csv\" requires columns to pin the column order. Startup fails without it. List bare JSON field names in order before any derived expressions in columns. CSV reads only the leading names before the first = expression. Rows are framed with control-character separators and quoted with enclose/escape, so embedded commas and newlines are safe. JSON null and missing keys become SQL NULL, empty strings remain empty, and nested objects or arrays are stringified as JSON. The target Doris column types must accept the resulting values."},"5603":{"id":"/docs/connectors/sinks/doris-59","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#delivery-semantics","content":"Each poll is split into chunks of at most batch_size messages. Each chunk gets a deterministic label based on label_prefix, the target table, stream, topic, partition, and first/last offsets. Transient failures (HTTP 5xx/408/429, transport errors, empty or unreadable successful responses) are retried under the same label. Backoff starts at retry_delay, doubles for each retry, applies ±20% jitter, and never exceeds max_retry_delay. Other HTTP 4xx responses, Fail status, and nonempty malformed responses are permanent errors and are not retried."},"5604":{"id":"/docs/connectors/sinks/doris-60","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#delivery-semantics","content":"Label Already Exists is accepted only when the existing job is FINISHED. RUNNING and CANCELLED are retried. Publish Timeout is accepted as committed, although rows may not yet be visible. Deduplication lasts only while Doris retains the label. Check the retention settings for your Doris version. Doris 4.0.3 uses streaming_label_keep_max_second (default 12 hours) for Stream Load. See Doris FE configuration."},"5605":{"id":"/docs/connectors/sinks/doris-61","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#delivery-semantics","content":"The runtime uses consumer auto-commit before the sink finishes. After a chunk fails, the plugin still attempts later chunks and returns the first error. The runtime logs and counts that error, adds no processed messages for the failed batch, and continues polling without replaying it. A crash or exhausted retry budget can therefore lose data. A non-JSON payload aborts the remaining chunks immediately."},"5606":{"id":"/docs/connectors/sinks/doris-62","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#delivery-semantics","content":"For a manual redrive, preserve the label inputs and chunk boundaries, including both batch_length and batch_size. Poll sizes can also vary, so unchanged settings alone do not guarantee the same labels. Changed boundaries or expired labels can produce duplicates. This is not an end-to-end exactly-once guarantee."},"5607":{"id":"/docs/connectors/sinks/doris-63","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#delivery-semantics","content":"If max_filter_ratio permits malformed rows, Doris can accept a load while dropping those rows. The plugin logs a warning when Doris reports them. The where option deliberately excludes rows before loading."},"5608":{"id":"/docs/connectors/sinks/doris-64","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#security-notes","content":"Use https:// for fe_url in production: credentials travel as HTTP Basic auth."},"5609":{"id":"/docs/connectors/sinks/doris-65","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#security-notes","content":"The connector preserves the Authorization header across Doris FE-to-BE 307/308 redirects, validating each target first. When fe_url uses HTTPS, an HTTP redirect target is refused unless allow_insecure_redirect = true. Location must be absolute, and at most five redirects are followed per attempt. A nonempty allowed_redirect_hosts list restricts destinations to the listed hosts or host:port endpoints. An unset or empty list does not restrict hosts."},"5610":{"id":"/docs/connectors/sinks/doris-66","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#security-notes","content":"columns and where are forwarded verbatim to Doris and evaluated as SQL expressions. Keep this config trusted."},"5611":{"id":"/docs/connectors/sinks/doris-67","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#transforms","content":"Transforms can be applied before loading into Doris. See the transforms documentation for the available types and their configuration."},"5612":{"id":"/docs/connectors/sinks/elasticsearch","page_id":"/docs/connectors/sinks/elasticsearch","type":"page","content":"Elasticsearch Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/elasticsearch"},"5613":{"id":"/docs/connectors/sinks/elasticsearch-0","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch","content":"Index messages from Iggy streams into an Elasticsearch index using the bulk API."},"5614":{"id":"/docs/connectors/sinks/elasticsearch-1","page_id":"/docs/connectors/sinks/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/elasticsearch#configuration","content":"Configuration"},"5615":{"id":"/docs/connectors/sinks/elasticsearch-2","page_id":"/docs/connectors/sinks/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"Plugin config options"},"5616":{"id":"/docs/connectors/sinks/elasticsearch-3","page_id":"/docs/connectors/sinks/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/elasticsearch#index-mapping","content":"Index mapping"},"5617":{"id":"/docs/connectors/sinks/elasticsearch-4","page_id":"/docs/connectors/sinks/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/elasticsearch#payload-handling","content":"Payload handling"},"5618":{"id":"/docs/connectors/sinks/elasticsearch-5","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch","content":"The Elasticsearch sink connector consumes messages from Iggy streams and indexes them into an Elasticsearch index using the bulk API."},"5619":{"id":"/docs/connectors/sinks/elasticsearch-6","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#configuration","content":"Use the broker credentials and runtime setup from the sink guide. Save the configuration below in the runtime's connector directory and replace the Elasticsearch credentials with your own. From the matching 0.10.0 repository root, build the plugin:"},"5620":{"id":"/docs/connectors/sinks/elasticsearch-7","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#configuration","content":"Create the Iggy resources and send a JSON document:"},"5621":{"id":"/docs/connectors/sinks/elasticsearch-8","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"Option"},"5622":{"id":"/docs/connectors/sinks/elasticsearch-9","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"Type"},"5623":{"id":"/docs/connectors/sinks/elasticsearch-10","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"Default"},"5624":{"id":"/docs/connectors/sinks/elasticsearch-11","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"Description"},"5625":{"id":"/docs/connectors/sinks/elasticsearch-12","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"url"},"5626":{"id":"/docs/connectors/sinks/elasticsearch-13","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"string"},"5627":{"id":"/docs/connectors/sinks/elasticsearch-14","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"required"},"5628":{"id":"/docs/connectors/sinks/elasticsearch-15","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"Elasticsearch cluster URL"},"5629":{"id":"/docs/connectors/sinks/elasticsearch-16","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"index"},"5630":{"id":"/docs/connectors/sinks/elasticsearch-17","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"string"},"5631":{"id":"/docs/connectors/sinks/elasticsearch-18","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"required"},"5632":{"id":"/docs/connectors/sinks/elasticsearch-19","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"Target index name"},"5633":{"id":"/docs/connectors/sinks/elasticsearch-20","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"username / password"},"5634":{"id":"/docs/connectors/sinks/elasticsearch-21","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"string"},"5635":{"id":"/docs/connectors/sinks/elasticsearch-22","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"none"},"5636":{"id":"/docs/connectors/sinks/elasticsearch-23","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"Optional basic authentication. Both values must be supplied to enable it"},"5637":{"id":"/docs/connectors/sinks/elasticsearch-24","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"create_index_if_not_exists"},"5638":{"id":"/docs/connectors/sinks/elasticsearch-25","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"bool"},"5639":{"id":"/docs/connectors/sinks/elasticsearch-26","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"true"},"5640":{"id":"/docs/connectors/sinks/elasticsearch-27","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"Create the index on startup when it is missing"},"5641":{"id":"/docs/connectors/sinks/elasticsearch-28","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"index_mapping"},"5642":{"id":"/docs/connectors/sinks/elasticsearch-29","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"table"},"5643":{"id":"/docs/connectors/sinks/elasticsearch-30","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"none"},"5644":{"id":"/docs/connectors/sinks/elasticsearch-31","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"Body of the create-index request (mappings, settings)"},"5645":{"id":"/docs/connectors/sinks/elasticsearch-32","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"batch_size"},"5646":{"id":"/docs/connectors/sinks/elasticsearch-33","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"integer"},"5647":{"id":"/docs/connectors/sinks/elasticsearch-34","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"unused"},"5648":{"id":"/docs/connectors/sinks/elasticsearch-35","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"Accepted but currently not read by the connector"},"5649":{"id":"/docs/connectors/sinks/elasticsearch-36","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"timeout_seconds"},"5650":{"id":"/docs/connectors/sinks/elasticsearch-37","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"integer"},"5651":{"id":"/docs/connectors/sinks/elasticsearch-38","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"30"},"5652":{"id":"/docs/connectors/sinks/elasticsearch-39","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"HTTP request timeout in seconds, from connection through response body. 0 is treated as 1"},"5653":{"id":"/docs/connectors/sinks/elasticsearch-40","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"The stream-level batch_length governs batching: each consume cycle submits its supported messages in one bulk request. The connector performs no retries of its own. Request, HTTP-status, and response-decoding failures return an error. The runtime logs and counts it, adds no processed messages for that batch, and continues polling. Consumer auto-commit occurs before indexing completes, and the failed poll is not replayed."},"5654":{"id":"/docs/connectors/sinks/elasticsearch-41","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"Individual document errors inside a successful bulk response are logged and counted in the plugin's closing statistics, but the plugin still returns success. The runtime's processed-message count can therefore include documents rejected by Elasticsearch. Monitor the document-error logs as well as runtime errors."},"5655":{"id":"/docs/connectors/sinks/elasticsearch-42","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"Bulk actions do not specify document IDs. Elasticsearch generates them, so replaying a message can create another document. The connector does not provide end-to-end exactly-once delivery."},"5656":{"id":"/docs/connectors/sinks/elasticsearch-43","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#index-mapping","content":"index_mapping is sent verbatim as the body of the create-index request, so it must be a structured object, not a JSON string embedded in TOML. It is used only when the connector creates an index. It does not update an existing index and is ignored when create_index_if_not_exists = false. That setting disables the startup existence check too. Express the mapping as nested TOML tables:"},"5657":{"id":"/docs/connectors/sinks/elasticsearch-44","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#payload-handling","content":"JSON objects are indexed as documents directly. Other JSON values are forwarded without being wrapped as objects and can be rejected by Elasticsearch."},"5658":{"id":"/docs/connectors/sinks/elasticsearch-45","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#payload-handling","content":"Raw payloads are parsed as JSON when possible, and wrapped as { \"data\": \"<base64>\", \"data_type\": \"raw\" } when that fails."},"5659":{"id":"/docs/connectors/sinks/elasticsearch-46","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#payload-handling","content":"Text payloads are wrapped as { \"text\": \"...\", \"data_type\": \"text\" }."},"5660":{"id":"/docs/connectors/sinks/elasticsearch-47","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#payload-handling","content":"Other payload formats are skipped with a warning."},"5661":{"id":"/docs/connectors/sinks/elasticsearch-48","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#payload-handling","content":"Object documents are enriched before indexing with _iggy_offset, _iggy_stream, _iggy_topic, _iggy_partition, and _iggy_timestamp. These fields replace matching payload fields. _iggy_timestamp is the connector's processing time in Unix epoch milliseconds, not the message's stored timestamp. _iggy_headers is added or replaced only when message headers are present."},"5662":{"id":"/docs/connectors/sinks/elasticsearch-49","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch#payload-handling","content":"Use HTTPS when credentials must be protected in transit. The connector uses the Elasticsearch client's certificate verification. This configuration does not expose a switch to disable it."},"5663":{"id":"/docs/connectors/sinks/http","page_id":"/docs/connectors/sinks/http","type":"page","content":"HTTP Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/http"},"5664":{"id":"/docs/connectors/sinks/http-0","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http","content":"Deliver messages from Iggy streams to any HTTP endpoint, from webhooks and REST APIs to serverless functions."},"5665":{"id":"/docs/connectors/sinks/http-1","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#configuration","content":"Configuration"},"5666":{"id":"/docs/connectors/sinks/http-2","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#common-options","content":"Common Options"},"5667":{"id":"/docs/connectors/sinks/http-3","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#batch-modes","content":"Batch Modes"},"5668":{"id":"/docs/connectors/sinks/http-4","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#metadata-envelope","content":"Metadata Envelope"},"5669":{"id":"/docs/connectors/sinks/http-5","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#authentication","content":"Authentication"},"5670":{"id":"/docs/connectors/sinks/http-6","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"Retry & Delivery Semantics"},"5671":{"id":"/docs/connectors/sinks/http-7","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#example-configurations","content":"Example Configurations"},"5672":{"id":"/docs/connectors/sinks/http-8","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#webhook-slack","content":"Webhook (Slack)"},"5673":{"id":"/docs/connectors/sinks/http-9","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#bulk-rest-api-ingestion","content":"Bulk REST API Ingestion"},"5674":{"id":"/docs/connectors/sinks/http-10","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#iot--sensor-relay-binary-payloads","content":"IoT / Sensor Relay (binary payloads)"},"5675":{"id":"/docs/connectors/sinks/http-11","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#deployment--performance","content":"Deployment & Performance"},"5676":{"id":"/docs/connectors/sinks/http-12","page_id":"/docs/connectors/sinks/http","type":"heading","tags":[],"url":"/docs/connectors/sinks/http#known-limitations","content":"Known Limitations"},"5677":{"id":"/docs/connectors/sinks/http-13","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http","content":"The HTTP Sink connector consumes messages from Iggy streams and delivers them to any HTTP endpoint: webhooks, REST APIs, serverless functions, or SaaS integrations. This is the transport-level, generic HTTP connector. It's distinct from sinks such as Elasticsearch or Quickwit, which use HTTP internally to talk to one specific system. You bring the URL, headers, and batching strategy, and the sink handles transport, retries, and metadata wrapping."},"5678":{"id":"/docs/connectors/sinks/http-14","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http","content":"This page is a curated subset of the documentation. The canonical reference, including the full configuration table, deployment patterns, and performance analysis, is the upstream http_sink README in the apache/iggy repository."},"5679":{"id":"/docs/connectors/sinks/http-15","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.10.0 repository root, build the plugin:"},"5680":{"id":"/docs/connectors/sinks/http-16","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#configuration","content":"For a local receiver, run this in a separate terminal:"},"5681":{"id":"/docs/connectors/sinks/http-17","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#configuration","content":"Save this configuration in the runtime's connector directory:"},"5682":{"id":"/docs/connectors/sinks/http-18","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#configuration","content":"Create the Iggy resources and send a JSON message, then start the connector runtime using the sink guide:"},"5683":{"id":"/docs/connectors/sinks/http-19","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"Option"},"5684":{"id":"/docs/connectors/sinks/http-20","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"Type"},"5685":{"id":"/docs/connectors/sinks/http-21","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"Default"},"5686":{"id":"/docs/connectors/sinks/http-22","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"Description"},"5687":{"id":"/docs/connectors/sinks/http-23","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"url"},"5688":{"id":"/docs/connectors/sinks/http-24","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"string"},"5689":{"id":"/docs/connectors/sinks/http-25","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"required"},"5690":{"id":"/docs/connectors/sinks/http-26","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"Target URL for HTTP requests"},"5691":{"id":"/docs/connectors/sinks/http-27","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"method"},"5692":{"id":"/docs/connectors/sinks/http-28","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"string"},"5693":{"id":"/docs/connectors/sinks/http-29","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"POST"},"5694":{"id":"/docs/connectors/sinks/http-30","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"HTTP method: GET, HEAD, POST, PUT, PATCH, DELETE"},"5695":{"id":"/docs/connectors/sinks/http-31","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"batch_mode"},"5696":{"id":"/docs/connectors/sinks/http-32","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"string"},"5697":{"id":"/docs/connectors/sinks/http-33","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"individual"},"5698":{"id":"/docs/connectors/sinks/http-34","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"individual, ndjson, json_array, or raw"},"5699":{"id":"/docs/connectors/sinks/http-35","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"include_metadata"},"5700":{"id":"/docs/connectors/sinks/http-36","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"bool"},"5701":{"id":"/docs/connectors/sinks/http-37","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"true"},"5702":{"id":"/docs/connectors/sinks/http-38","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"Wrap payload in metadata envelope"},"5703":{"id":"/docs/connectors/sinks/http-39","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"headers"},"5704":{"id":"/docs/connectors/sinks/http-40","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"table"},"5705":{"id":"/docs/connectors/sinks/http-41","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"{}"},"5706":{"id":"/docs/connectors/sinks/http-42","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"Custom HTTP headers (e.g. Authorization)"},"5707":{"id":"/docs/connectors/sinks/http-43","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"timeout"},"5708":{"id":"/docs/connectors/sinks/http-44","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"string"},"5709":{"id":"/docs/connectors/sinks/http-45","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"30s"},"5710":{"id":"/docs/connectors/sinks/http-46","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"Request timeout (e.g. 10s, 500ms)"},"5711":{"id":"/docs/connectors/sinks/http-47","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"Further options cover retries (max_retries, retry_delay, retry_backoff_multiplier, max_retry_delay), success status codes, payload size limits, TLS, connection pooling, health checks, and verbose logging. See the upstream http_sink README for the full list with defaults."},"5712":{"id":"/docs/connectors/sinks/http-48","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"The body size limit defaults to 10 MiB and applies after serialization: per message in individual/raw, or to the whole batch in ndjson/json_array. Setting max_payload_size_bytes = 0 disables it. Oversized bodies fail without being sent. Optional startup health checks use the same URL, retry policy and success codes, with HEAD as the default method."},"5713":{"id":"/docs/connectors/sinks/http-49","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"GET and HEAD are accepted but unusual for delivering data: the request still carries a body, which some servers reject. The sink logs a warning at startup when GET or HEAD is combined with a batch mode other than individual."},"5714":{"id":"/docs/connectors/sinks/http-50","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#batch-modes","content":"The batch_mode option controls how messages from one poll cycle are delivered to the endpoint."},"5715":{"id":"/docs/connectors/sinks/http-51","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#batch-modes","content":"individual (default): one HTTP request per message. Best for webhooks and endpoints that accept single events. With batch_length = 50, a full poll can produce 50 sequential requests, before retries. Shorter polls and failures can produce fewer."},"5716":{"id":"/docs/connectors/sinks/http-52","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#batch-modes","content":"ndjson: all messages in one request, newline-delimited JSON. Best for bulk-ingestion endpoints. Content-Type: application/x-ndjson."},"5717":{"id":"/docs/connectors/sinks/http-53","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#batch-modes","content":"json_array: all messages as a single JSON array. Best for APIs that expect array payloads. Content-Type: application/json."},"5718":{"id":"/docs/connectors/sinks/http-54","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#batch-modes","content":"raw: raw bytes, one request per message. For non-JSON payloads (Protobuf, FlatBuffers, binary). The metadata envelope is not applied. Content-Type: application/octet-stream."},"5719":{"id":"/docs/connectors/sinks/http-55","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#batch-modes","content":"For production throughput with JSON-representable payloads, prefer ndjson or json_array, which collapse N round trips per poll cycle into one."},"5720":{"id":"/docs/connectors/sinks/http-56","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"When include_metadata = true (default), the JSON-mode payload is wrapped:"},"5721":{"id":"/docs/connectors/sinks/http-57","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"iggy_id is a 32-character lowercase hex string (no dashes)."},"5722":{"id":"/docs/connectors/sinks/http-58","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"iggy_timestamp is the message timestamp in Unix epoch microseconds. include_checksum and include_origin_timestamp add the corresponding metadata fields. Both default to false."},"5723":{"id":"/docs/connectors/sinks/http-59","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"Nonempty message headers become iggy_headers: non-raw values are strings, and raw values use a base64 data object with iggy_header_encoding = \"base64\"."},"5724":{"id":"/docs/connectors/sinks/http-60","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"Set include_metadata = false to send the payload without wrapping (useful when the downstream service expects bare JSON, e.g. Slack webhooks)."},"5725":{"id":"/docs/connectors/sinks/http-61","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"In JSON batch modes, raw, FlatBuffer, Protobuf and Avro payload variants are base64-encoded with an explicit marker:"},"5726":{"id":"/docs/connectors/sinks/http-62","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"With the envelope enabled, this object becomes the payload field shown above. JSON values are reserialized and text payloads become JSON strings."},"5727":{"id":"/docs/connectors/sinks/http-63","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"The runtime applies stream decoding and configured transforms before the sink formats its requests. To forward opaque message bytes, use schema = \"raw\" with batch_mode = \"raw\" and no transforms. See the SDK format limits when selecting other schemas."},"5728":{"id":"/docs/connectors/sinks/http-64","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"The connector doesn't expect the metadata envelope on input. It adds it on the way out. Producers must supply payloads accepted by the configured stream decoder and the receiving endpoint."},"5729":{"id":"/docs/connectors/sinks/http-65","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#authentication","content":"The HTTP sink supports authentication via custom headers under [plugin_config.headers]. Custom headers are sent with data requests and health checks, except Content-Type: the sink ignores a configured value and sets it from the batch mode for data requests."},"5730":{"id":"/docs/connectors/sinks/http-66","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#authentication","content":"Other valid headers work the same way: use x-api-key = \"my-secret-api-key\" for API-key schemes, or Authorization = \"Basic dXNlcm5hbWU6cGFzc3dvcmQ=\" (base64 of username:password) for basic auth. Multiple headers are combined per request. Configure header secrets in a protected connector TOML file. The local provider supports environment overrides for flat plugin fields, such as URL, but not nested headers or JSON objects. HEADERS_AUTHORIZATION creates an unused flat field, and a JSON object supplied through HEADERS is parsed as a string and fails plugin initialization."},"5731":{"id":"/docs/connectors/sinks/http-67","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"Transient failures allow up to max_retries additional attempts after the initial request: the default 3 means at most four attempts. Retry delays use full jitter from zero up to min(retry_delay * retry_backoff_multiplier^n, max_retry_delay), where n starts at zero for the first retry. With the defaults, the three delay caps are 1, 2 and 4 seconds."},"5732":{"id":"/docs/connectors/sinks/http-68","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"Transient errors (retried): network errors, HTTP 429, 500, 502, 503, 504."},"5733":{"id":"/docs/connectors/sinks/http-69","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"Non-transient errors (fail immediately): HTTP 400, 401, 403, 404, 405, etc."},"5734":{"id":"/docs/connectors/sinks/http-70","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"success_status_codes (default [200, 201, 202, 204]) short-circuits retries: any status code in this set is treated as success and is never retried, even codes that are normally transient. Placing 429 in the set makes the sink accept rate-limited responses as delivered. The sink warns at startup about such overlaps."},"5735":{"id":"/docs/connectors/sinks/http-71","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"HTTP 429 Retry-After: on unsuccessful responses, the header is logged but not honored. Retry timing always uses the computed backoff."},"5736":{"id":"/docs/connectors/sinks/http-72","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"Partial delivery (individual/raw modes): after a fixed number of consecutive HTTP failures (3 at the time of writing, not configurable), the remainder of the batch is aborted to avoid hammering a dead endpoint."},"5737":{"id":"/docs/connectors/sinks/http-73","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"The connector runtime uses consumer auto-commit before consume() completes. A plugin error is logged and counted, the failed batch adds no processed messages, and polling continues without replaying that batch. Earlier messages or requests from the same batch may already have succeeded. A crash or exhausted retry budget can lose messages. A retry after an ambiguous response can deliver them again. There is no end-to-end at-least-once or exactly-once guarantee."},"5738":{"id":"/docs/connectors/sinks/http-74","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"HTTP success is determined by the response status. The sink does not inspect a successful response body for per-item failures."},"5739":{"id":"/docs/connectors/sinks/http-75","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#example-configurations","content":"Replace the corresponding blocks in the complete configuration above, and supply your own endpoint URLs and credentials."},"5740":{"id":"/docs/connectors/sinks/http-76","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#webhook-slack","content":"Use schema = \"json\" and publish JSON in the shape Slack expects, for example {\"text\":\"hello\"}. include_metadata = false skips the envelope, but JSON is still reserialized. The original bytes and whitespace are not preserved."},"5741":{"id":"/docs/connectors/sinks/http-77","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#deployment--performance","content":"One iggy-connectors runtime process can host many connectors: the local config provider imports every connector TOML file under its config_dir, and each entry gets its own plugin instance and consume tasks in the same process. Each connector entry has exactly one [plugin_config] block and therefore one destination URL. To send to multiple destinations, add multiple HTTP sink entries with distinct keys and URLs (in the same runtime or separate ones). For fan-out from a single topic to multiple endpoints, point multiple sink entries at the same topic with different consumer_group names so each maintains its own offset."},"5742":{"id":"/docs/connectors/sinks/http-78","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#deployment--performance","content":"Throughput is dominated by batch-mode choice: the runtime calls consume() sequentially within each topic task, so a full N-message batch uses N requests in individual/raw, or one in ndjson/json_array, before retries or skipped messages. Connection pooling and HTTP keep-alive are enabled by default. max_connections limits idle connections retained per host, not concurrent requests. Topic tasks can issue requests concurrently. Each topic awaits its own batch before continuing. Tune pooling and batch_length for the receiving service."},"5743":{"id":"/docs/connectors/sinks/http-79","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#deployment--performance","content":"For multi-instance deployment patterns (Docker, Kubernetes, fan-out topologies), connection pool tuning, and full performance analysis, see the upstream http_sink README."},"5744":{"id":"/docs/connectors/sinks/http-80","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"No Retry-After honoring: the header is logged but doesn't influence retry timing."},"5745":{"id":"/docs/connectors/sinks/http-81","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"No dead-letter queue: failed messages are logged at error! level but not persisted."},"5746":{"id":"/docs/connectors/sinks/http-82","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"No request signing: AWS SigV4, HMAC, and similar schemes aren't supported. Use custom headers or a signing proxy."},"5747":{"id":"/docs/connectors/sinks/http-83","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"No per-topic URL routing: all topics in one connector instance share the same url. For routing, deploy multiple instances."},"5748":{"id":"/docs/connectors/sinks/http-84","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"No OAuth2 / OIDC token refresh: bearer tokens are static. Use an auth proxy for services that require token rotation."},"5749":{"id":"/docs/connectors/sinks/http-85","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"No mTLS client certificates: terminate mTLS at a sidecar proxy for production use."},"5750":{"id":"/docs/connectors/sinks/http-86","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"Plaintext secrets in config: header values are stored verbatim in config.toml. Mount or generate a protected connector TOML file containing the required header values before starting the runtime."},"5751":{"id":"/docs/connectors/sinks/http-87","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"For the complete list and implementation context, see the upstream http_sink README."},"5752":{"id":"/docs/connectors/sinks/iceberg","page_id":"/docs/connectors/sinks/iceberg","type":"page","content":"Iceberg Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/iceberg"},"5753":{"id":"/docs/connectors/sinks/iceberg-0","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg","content":"Consume messages from Iggy topics and store them in Iceberg tables, with REST catalogs and S3-compatible storage."},"5754":{"id":"/docs/connectors/sinks/iceberg-1","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#features","content":"Features"},"5755":{"id":"/docs/connectors/sinks/iceberg-2","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#configuration-example","content":"Configuration example"},"5756":{"id":"/docs/connectors/sinks/iceberg-3","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#configuration-options","content":"Configuration Options"},"5757":{"id":"/docs/connectors/sinks/iceberg-4","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#static-routing","content":"Static Routing"},"5758":{"id":"/docs/connectors/sinks/iceberg-5","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"Dynamic Routing"},"5759":{"id":"/docs/connectors/sinks/iceberg-6","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#dynamic-routing-configuration-example","content":"Dynamic routing configuration example"},"5760":{"id":"/docs/connectors/sinks/iceberg-7","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#batches-and-table-commits","content":"Batches and table commits"},"5761":{"id":"/docs/connectors/sinks/iceberg-8","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#source-compatibility","content":"Source Compatibility"},"5762":{"id":"/docs/connectors/sinks/iceberg-9","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#commit-rate-and-maintenance","content":"Commit rate and maintenance"},"5763":{"id":"/docs/connectors/sinks/iceberg-10","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg","content":"The Iceberg Sink Connector allows you to consume messages from Iggy topics and store them in Iceberg tables."},"5764":{"id":"/docs/connectors/sinks/iceberg-11","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#features","content":"Support for S3-compatible storage"},"5765":{"id":"/docs/connectors/sinks/iceberg-12","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#features","content":"Support for REST catalogs"},"5766":{"id":"/docs/connectors/sinks/iceberg-13","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#features","content":"Single destination table"},"5767":{"id":"/docs/connectors/sinks/iceberg-14","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#features","content":"Multiple-table fan-out static routing"},"5768":{"id":"/docs/connectors/sinks/iceberg-15","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#features","content":"Multiple-table fan-out dynamic routing"},"5769":{"id":"/docs/connectors/sinks/iceberg-16","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-example","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.10.0 repository root, build the plugin:"},"5770":{"id":"/docs/connectors/sinks/iceberg-17","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-example","content":"The example requires a REST catalog at http://localhost:8181 and S3-compatible storage at http://localhost:9000, configured with the credentials below. Create the storage bucket, namespace and target table before starting the connector. The sink does not create them."},"5771":{"id":"/docs/connectors/sinks/iceberg-18","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-example","content":"For a local catalog without authentication, create nyc.users with id (long) and name (string):"},"5772":{"id":"/docs/connectors/sinks/iceberg-19","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-example","content":"Save this complete connector file in the runtime's connector directory:"},"5773":{"id":"/docs/connectors/sinks/iceberg-20","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-example","content":"Create the Iggy resources and send a row:"},"5774":{"id":"/docs/connectors/sinks/iceberg-21","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"All options below are required except the credential pair and store_path_style_access. tables and dynamic_route_field must be present even when the selected routing mode does not use them."},"5775":{"id":"/docs/connectors/sinks/iceberg-22","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"tables: The names of the Iceberg tables you want to statically route Iggy messages to. The name should include the table’s namespace, separated by a dot (.). Ignored when dynamic_routing = true."},"5776":{"id":"/docs/connectors/sinks/iceberg-23","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"catalog_type: The type of catalog you are routing data to. Currently, only REST catalogs are fully supported."},"5777":{"id":"/docs/connectors/sinks/iceberg-24","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"warehouse: The warehouse value sent to the REST catalog. Its meaning depends on the catalog service. Data file destinations come from each table’s metadata."},"5778":{"id":"/docs/connectors/sinks/iceberg-25","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"uri: The URI of the Iceberg catalog."},"5779":{"id":"/docs/connectors/sinks/iceberg-26","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"dynamic_routing: Enables dynamic routing. See more details later in this document."},"5780":{"id":"/docs/connectors/sinks/iceberg-27","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"dynamic_route_field: The top-level message field that specifies the Iceberg table to route data to. Ignored in static mode. See more details below."},"5781":{"id":"/docs/connectors/sinks/iceberg-28","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"store_url: The URL of the object storage for data uploads."},"5782":{"id":"/docs/connectors/sinks/iceberg-29","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"store_access_key_id: The optional access key ID of the object storage."},"5783":{"id":"/docs/connectors/sinks/iceberg-30","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"store_secret_access_key: The optional secret key used to upload data to the object storage. Supply both credential fields or omit both to use the default AWS credential provider chain."},"5784":{"id":"/docs/connectors/sinks/iceberg-31","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"store_region: The region of the object storage. Required. For S3-compatible stores that ignore it, supply any placeholder value."},"5785":{"id":"/docs/connectors/sinks/iceberg-32","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"store_class: The storage class to use. Currently, only S3-compatible storage is supported."},"5786":{"id":"/docs/connectors/sinks/iceberg-33","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"store_path_style_access: Use path-style S3 URLs (http://host/bucket/key). Defaults to true. Set to false for stores that require virtual-hosted-style URLs."},"5787":{"id":"/docs/connectors/sinks/iceberg-34","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#static-routing","content":"With dynamic_routing = false, every batch is copied to every successfully loaded table in tables. Invalid names and tables that cannot be loaded are skipped at startup. Startup fails if no table can be loaded. The writer uses each table's schema and default partition spec captured at startup, so restart the connector after changing them."},"5788":{"id":"/docs/connectors/sinks/iceberg-35","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"If you don't know the names of the Iceberg tables you want to route data to in advance, you can use the dynamic routing feature. Insert a top-level field in your JSON messages with the name of the Iceberg table the message should be routed to. The Iggy connector will parse this field at runtime and route the message to the correct table."},"5789":{"id":"/docs/connectors/sinks/iceberg-36","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"The Iggy Iceberg Connector will skip messages in the following cases:"},"5790":{"id":"/docs/connectors/sinks/iceberg-37","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"The table declared in the message field cannot be loaded, including missing tables and catalog lookup failures."},"5791":{"id":"/docs/connectors/sinks/iceberg-38","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"The table name has no namespace or contains an empty name component."},"5792":{"id":"/docs/connectors/sinks/iceberg-39","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"The message does not contain the field specified in the dynamic_route_field configuration option, or is not a JSON object."},"5793":{"id":"/docs/connectors/sinks/iceberg-40","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"A lookup failure skips the affected message. It does not fail the batch. Each batch loads its destination tables again. The route field is included in the JSON row, but is ignored by the writer if the target schema has no matching column."},"5794":{"id":"/docs/connectors/sinks/iceberg-41","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing-configuration-example","content":"Replace [plugin_config] in the complete connector file above and append the transform below. tables = [] is intentional: the route field chooses the destination in this mode."},"5795":{"id":"/docs/connectors/sinks/iceberg-42","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing-configuration-example","content":"Transforms are declared at the top level of the connector file, next to [plugin_config], and every [transforms.*] section requires enabled = true. See the transforms documentation for details."},"5796":{"id":"/docs/connectors/sinks/iceberg-43","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing-configuration-example","content":"Note: The value in the message field must contain both the namespace and the table name, separated by a dot (.). Example:"},"5797":{"id":"/docs/connectors/sinks/iceberg-44","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing-configuration-example","content":"Namespace: nyc"},"5798":{"id":"/docs/connectors/sinks/iceberg-45","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing-configuration-example","content":"Table name: users"},"5799":{"id":"/docs/connectors/sinks/iceberg-46","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#batches-and-table-commits","content":"Rows are converted to Arrow using the target table schema, written to Parquet, then appended in an Iceberg transaction per destination table. Partitioned tables split a batch by the default partition spec. Writers can roll over into multiple files, so there is no fixed one-file-per-batch guarantee for either partitioned or unpartitioned tables."},"5800":{"id":"/docs/connectors/sinks/iceberg-47","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#batches-and-table-commits","content":"Fan-out is not atomic across tables. A write or commit error stops work on the remaining tables in that batch. An earlier table may already be committed. The Iceberg library refreshes metadata before committing and retries eligible commit errors according to the table's retry properties. The plugin does not replay a failed batch. The runtime records a plugin error and continues polling with consumer auto-commit, so messages can be lost after a failed or skipped write. Replaying an already committed batch can create duplicates."},"5801":{"id":"/docs/connectors/sinks/iceberg-48","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#source-compatibility","content":"Use schema = \"json\" on the stream. Each JSON object represents a table row. Nested objects and arrays are supported when they match the table schema. Unknown fields are ignored. Missing nullable fields become null. Missing required fields or incompatible values fail the table write."},"5802":{"id":"/docs/connectors/sinks/iceberg-49","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#source-compatibility","content":"Sources that wrap row data in an envelope need a transform when the table schema describes the inner row. Otherwise, the Arrow JSON reader maps envelope keys to table columns, producing nulls or schema errors."},"5803":{"id":"/docs/connectors/sinks/iceberg-50","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#source-compatibility","content":"If your source emits envelope-wrapped JSON, use the unwrap_envelope transform to extract the inner data field before it reaches the sink:"},"5804":{"id":"/docs/connectors/sinks/iceberg-51","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#source-compatibility","content":"Set field to the envelope key that holds the row data. See the transforms documentation and your source connector's documentation for details on the envelope shape."},"5805":{"id":"/docs/connectors/sinks/iceberg-52","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#commit-rate-and-maintenance","content":"Each runtime batch creates one append commit per destination table. Larger batches reduce snapshot and manifest growth. Use batch_length=1000, min_count=1000 and max_wait=\"5s\" in the stream entry when this latency fits the workload. The reply byte budget can finish a read earlier."},"5806":{"id":"/docs/connectors/sinks/iceberg-53","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#commit-rate-and-maintenance","content":"The sink logs each skipped message with its offset. It does not expire table snapshots or rewrite manifests. Run table maintenance through the catalog or an engine that supports it, with retention appropriate for your time-travel requirements."},"5807":{"id":"/docs/connectors/sinks/influxdb","page_id":"/docs/connectors/sinks/influxdb","type":"page","content":"InfluxDB Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/influxdb"},"5808":{"id":"/docs/connectors/sinks/influxdb-0","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb","content":"Write messages from Iggy streams to InfluxDB as line-protocol points, on both InfluxDB V2 and V3."},"5809":{"id":"/docs/connectors/sinks/influxdb-1","page_id":"/docs/connectors/sinks/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/influxdb#configuration","content":"Configuration"},"5810":{"id":"/docs/connectors/sinks/influxdb-2","page_id":"/docs/connectors/sinks/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/influxdb#common-options","content":"Common Options"},"5811":{"id":"/docs/connectors/sinks/influxdb-3","page_id":"/docs/connectors/sinks/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/influxdb#payload-formats","content":"Payload Formats"},"5812":{"id":"/docs/connectors/sinks/influxdb-4","page_id":"/docs/connectors/sinks/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/influxdb#reliability","content":"Reliability"},"5813":{"id":"/docs/connectors/sinks/influxdb-5","page_id":"/docs/connectors/sinks/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/influxdb#transforms","content":"Transforms"},"5814":{"id":"/docs/connectors/sinks/influxdb-6","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb","content":"The InfluxDB sink connector consumes messages from Iggy streams and writes them to InfluxDB as line-protocol points. It supports both InfluxDB V2 (OSS 2.x / Cloud) and InfluxDB V3 (Core / Enterprise), selected with the version option."},"5815":{"id":"/docs/connectors/sinks/influxdb-7","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb","content":"This page is a curated subset of the documentation. The canonical reference is the upstream influxdb_sink README in the apache/iggy repository."},"5816":{"id":"/docs/connectors/sinks/influxdb-8","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.10.0 repository root, build the plugin:"},"5817":{"id":"/docs/connectors/sinks/influxdb-9","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#configuration","content":"Create the InfluxDB organization and bucket (V2), or database (V3), and provide a token with write access. Save the following connector file in the runtime's connector directory, replacing the URL and token for your deployment. Startup checks GET /health with the configured token, using Token authentication for V2 and Bearer for V3. A successful health check does not verify write permissions."},"5818":{"id":"/docs/connectors/sinks/influxdb-10","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#configuration","content":"Create the Iggy resources and send a row:"},"5819":{"id":"/docs/connectors/sinks/influxdb-11","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#configuration","content":"InfluxDB V2 organizes data as org + bucket. V3 uses a single db field instead. Omitting version defaults to \"v2\" for backward compatibility. The write body, batching, and retry behavior are identical between versions. The connector handles the differing endpoints, auth header styles, and precision spellings internally."},"5820":{"id":"/docs/connectors/sinks/influxdb-12","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#configuration","content":"For V3, replace the entire [plugin_config] section. Unknown options are rejected, so remove the V2 org and bucket fields:"},"5821":{"id":"/docs/connectors/sinks/influxdb-13","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"Option"},"5822":{"id":"/docs/connectors/sinks/influxdb-14","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"Type"},"5823":{"id":"/docs/connectors/sinks/influxdb-15","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"Default"},"5824":{"id":"/docs/connectors/sinks/influxdb-16","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"Description"},"5825":{"id":"/docs/connectors/sinks/influxdb-17","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"version"},"5826":{"id":"/docs/connectors/sinks/influxdb-18","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"string"},"5827":{"id":"/docs/connectors/sinks/influxdb-19","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"v2"},"5828":{"id":"/docs/connectors/sinks/influxdb-20","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"v2 or v3"},"5829":{"id":"/docs/connectors/sinks/influxdb-21","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"url"},"5830":{"id":"/docs/connectors/sinks/influxdb-22","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"string"},"5831":{"id":"/docs/connectors/sinks/influxdb-23","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"required"},"5832":{"id":"/docs/connectors/sinks/influxdb-24","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"InfluxDB base URL"},"5833":{"id":"/docs/connectors/sinks/influxdb-25","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"org"},"5834":{"id":"/docs/connectors/sinks/influxdb-26","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"string"},"5835":{"id":"/docs/connectors/sinks/influxdb-27","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"required (v2)"},"5836":{"id":"/docs/connectors/sinks/influxdb-28","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"Organization name"},"5837":{"id":"/docs/connectors/sinks/influxdb-29","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"bucket"},"5838":{"id":"/docs/connectors/sinks/influxdb-30","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"string"},"5839":{"id":"/docs/connectors/sinks/influxdb-31","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"required (v2)"},"5840":{"id":"/docs/connectors/sinks/influxdb-32","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"Target bucket"},"5841":{"id":"/docs/connectors/sinks/influxdb-33","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"db"},"5842":{"id":"/docs/connectors/sinks/influxdb-34","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"string"},"5843":{"id"