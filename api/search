],[2644,"system.partition.size_of_messages_required_to_save"],[2940,"system.recovery.recreate_missing_state"],[2937,"system.segment.archive_expired"],[2621,"system.segment.archive_expired = true and system.recovery.recreate_missing_state = true are unsupported placeholders. Setting either aborts boot."],[2648,"system.segment.preallocate"],[2646,"system.segment.size"],[2636,"system.topic.max_size"],[2638,"system.topic.message_expiry"],[2507,"SystemClient - ping, stats, snapshot"],[54,"Systemd integration"],[3578,"table"],[3876,"table"],[3980,"table"],[4049,"table"],[4104,"table"],[4600,"table"],[4178,"Table name: users"],[3682,"Table Polling: Incrementally fetch rows using a tracking column"],[4375,"Table Schema"],[4397,"Table to insert messages into"],[3938,"table_uri"],[3701,"tables"],[3704,"Tables to monitor"],[4160,"tables: The names of the Iceberg tables you want to statically route Iggy messages to. The name should include the table’s namespace, separated by a dot (.)."],[4211,"Target bucket"],[2843,"Target buffer size for batched writes before flush."],[4327,"Target collection name"],[3628,"Target database"],[4215,"Target database"],[4323,"Target database name"],[3979,"Target database, [A-Za-z0-9_]+"],[4039,"Target index name"],[4267,"Target index UID"],[2840,"Target minimum size of the frame read buffer."],[3879,"Target table name"],[3983,"Target table, [A-Za-z0-9_]+"],[4603,"Target table; must be a safe SurrealQL identifier"],[4090,"Target URL for HTTP requests"],[4394,"target_table"],[1341,"tcp"],[2289,"TCP"],[2462,"TCP"],[2467,"TCP"],[2496,"TCP"],[3227,"TCP"],[3239,"TCP"],[3279,"TCP"],[3363,"TCP"],[5090,"TCP - binary protocol for optimal performance and lower latency (recommended). Over TCP the SDK speaks the VSR consensus framing, the only wire protocol the server accepts. See Connection semantics"],[2286,"TCP (default)"],[2494,"TCP (default)"],[2770,"TCP is the highest-throughput transport. These two keys, plus the TLS block below, are the entire section