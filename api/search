ing-with-rented-buffers","content":"Polling with rented buffers"},"5684":{"id":"/docs/sdk/csharp/guide-26","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#polling-strategies","content":"Polling strategies"},"5685":{"id":"/docs/sdk/csharp/guide-27","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#offset-management","content":"Offset management"},"5686":{"id":"/docs/sdk/csharp/guide-28","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#consumer-groups","content":"Consumer groups"},"5687":{"id":"/docs/sdk/csharp/guide-29","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#joining-and-leaving","content":"Joining and leaving"},"5688":{"id":"/docs/sdk/csharp/guide-30","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#system-operations","content":"System operations"},"5689":{"id":"/docs/sdk/csharp/guide-31","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#option-catalog","content":"Option catalog"},"5690":{"id":"/docs/sdk/csharp/guide-32","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#raw-binary-requests","content":"Raw binary requests"},"5691":{"id":"/docs/sdk/csharp/guide-33","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#snapshots","content":"Snapshots"},"5692":{"id":"/docs/sdk/csharp/guide-34","page_id":"/docs/sdk/csharp/guide","type":"heading","tags":[],"url":"/docs/sdk/csharp/guide#segment-management","content":"Segment management"},"5693":{"id":"/docs/sdk/csharp/guide-35","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide","content":"This guide covers client configuration and the full IIggyClient API surface - the low-level, per-call operations. For the ergonomic producer/consumer abstractions built on top of these, see the High-level SDK."},"5694":{"id":"/docs/sdk/csharp/guide-36","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide","content":"The API fragments below reuse a connected, authenticated client (see Creating a client) and the imports in the configuration example. Use existing streams and topics for read, update, delete, publish, and poll operations; the create examples show how to prepare them."},"5695":{"id":"/docs/sdk/csharp/guide-37","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#client-configuration","content":"IggyClientConfigurator exposes the full set of connection options - buffer sizes, TLS, heartbeat, automatic reconnection with exponential backoff, and auto-login:"},"5696":{"id":"/docs/sdk/csharp/guide-38","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#client-configuration","content":"With TCP auto-login configured, the client logs in once connected. Successful manual username/password or PAT login is also remembered for reconnects. HTTP ConnectAsync does no network work and does not auto-login; call LoginUserAsync or LoginWithPersonalAccessTokenAsync explicitly."},"5697":{"id":"/docs/sdk/csharp/guide-39","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#iggyclientconfigurator","content":"Property"},"5698":{"id":"/docs/sdk/csharp/guide-40","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#iggyclientconfigurator","content":"Type"},"5699":{"id":"/docs/sdk/csharp/guide-41","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#iggyclientconfigurator","content":"Default"},"5700":{"id":"/docs/sdk/csharp/guide-42","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#iggyclientconfigurator","content":"Description"},"5701":{"id":"/docs/sdk/csharp/guide-43","page_id":"/doc