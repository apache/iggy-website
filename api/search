configurator","content":"bool"},"6625":{"id":"/docs/sdk/csharp/guide-90","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#iggyclientconfigurator","content":"false"},"6626":{"id":"/docs/sdk/csharp/guide-91","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#iggyclientconfigurator","content":"Allow auto-commit while an encryptor is configured"},"6627":{"id":"/docs/sdk/csharp/guide-92","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#heartbeat","content":"The TCP client pings the server on its own every HeartbeatInterval while connected, so an idle session survives the server's heartbeat verification and consumer-group memberships and assignments stay fresh. The ping goes through the regular request path: a lost session is repaired by the same reconnect and auto-login any other request would trigger. Heartbeat failures are logged and the loop keeps going until the client is disposed."},"6628":{"id":"/docs/sdk/csharp/guide-93","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#tlssettings","content":"Property"},"6629":{"id":"/docs/sdk/csharp/guide-94","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#tlssettings","content":"Type"},"6630":{"id":"/docs/sdk/csharp/guide-95","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#tlssettings","content":"Default"},"6631":{"id":"/docs/sdk/csharp/guide-96","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#tlssettings","content":"Description"},"6632":{"id":"/docs/sdk/csharp/guide-97","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#tlssettings","content":"Enabled"},"6633":{"id":"/docs/sdk/csharp/guide-98","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#tlssettings","content":"bool"},"66