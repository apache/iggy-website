content":"-u, --user-status <active|inactive>"},"1294":{"id":"/docs/cli/commands-87","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"Initial status (create only, default: active)"},"1295":{"id":"/docs/cli/commands-88","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"Global permission tokens (long / short): manage_servers/m_srv, read_servers/r_srv, manage_users/m_usr, read_users/r_usr, manage_streams/m_str, read_streams/r_str, manage_topics/m_top, read_topics/r_top, poll_messages/p_msg, send_messages/s_msg."},"1296":{"id":"/docs/cli/commands-89","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#permissions","content":"The stream permission format is STREAM_ID[:STREAM_PERMISSIONS][#TOPIC_ID[:TOPIC_PERMISSIONS]]:"},"1297":{"id":"/docs/cli/commands-90","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#pat","content":"Manage personal access tokens for the authenticated user. Subcommands: create, delete, list."},"1298":{"id":"/docs/cli/commands-91","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#pat","content":"--store-token and an expiry are mutually exclusive: stored tokens never expire."},"1299":{"id":"/docs/cli/commands-92","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#client","content":"Inspect the clients currently connected to the server. Clients are connections, not users."},"1300":{"id":"/docs/cli/commands-93","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#cluster","content":"Cluster operations. The only subcommand is metadata (alias m)."},"1301":{"id":"/docs/cli/commands-94","page_id":"/docs/cli/commands","tags":[],"type":"text","url":"/docs/cli/commands#consumer-group","content":"Manage consumer groups of a topic. Subcommands: create, delete, get, list."},"1302":{"id":"/docs/cli/commands-9