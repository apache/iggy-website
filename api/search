, and metrics are on by default. Grafana is on port 3001 because the server already uses 3000."},"2910":{"id":"/docs/tutorials/grafana-dashboard-14","page_id":"/docs/tutorials/grafana-dashboard","tags":[],"type":"text","url":"/docs/tutorials/grafana-dashboard#the-stack","content":"prometheus/prometheus.yml:"},"2911":{"id":"/docs/tutorials/grafana-dashboard-15","page_id":"/docs/tutorials/grafana-dashboard","tags":[],"type":"text","url":"/docs/tutorials/grafana-dashboard#the-stack","content":"Create an empty token file:"},"2912":{"id":"/docs/tutorials/grafana-dashboard-16","page_id":"/docs/tutorials/grafana-dashboard","tags":[],"type":"text","url":"/docs/tutorials/grafana-dashboard#the-stack","content":"grafana/provisioning/datasources/prometheus.yaml:"},"2913":{"id":"/docs/tutorials/grafana-dashboard-17","page_id":"/docs/tutorials/grafana-dashboard","tags":[],"type":"text","url":"/docs/tutorials/grafana-dashboard#the-stack","content":"grafana/provisioning/dashboards/iggy.yaml:"},"2914":{"id":"/docs/tutorials/grafana-dashboard-18","page_id":"/docs/tutorials/grafana-dashboard","tags":[],"type":"text","url":"/docs/tutorials/grafana-dashboard#the-stack","content":"grafana/dashboards/iggy.json:"},"2915":{"id":"/docs/tutorials/grafana-dashboard-19","page_id":"/docs/tutorials/grafana-dashboard","tags":[],"type":"text","url":"/docs/tutorials/grafana-dashboard#start-it","content":"Prometheus starts scraping straight away, but the server turns it away because it has no token. You get the same answer from curl:"},"2916":{"id":"/docs/tutorials/grafana-dashboard-20","page_id":"/docs/tutorials/grafana-dashboard","tags":[],"type":"text","url":"/docs/tutorials/grafana-dashboard#start-it","content":"The Prometheus targets page also shows the iggy job as down."},"2917":{"id":"/docs/tutorials/grafana-dashboard-21","page_id":"/docs/tutorials/grafana-dashboard","tags":[],"type":"text","url":"/docs/tutorials/grafana-dashboard#create-a-token-for-prometheus","content":"Create a personal access token with the CLI and write it to the file Prometheus reads:"},"2918":{"id":"/docs/tutorials/grafana-dashboard-22","page_id":"/docs/tutorials/grafana-dashboard","tags":[],"type":"text","url":"/docs/tutorials/grafana-dashboard#create-a-token-for-prometheus","content":"Check that the token works:"},"2919":{"id":"/docs/tutorials/grafana-dashboard-23","page_id":"/docs/tutorials/grafana-dashboard","tags":[],"type":"text","url":"/docs/tutorials/grafana-dashboard#create-a-token-for-prometheus","content":"Within a few seconds the Prometheus targets page shows the iggy job as up."},"2920":{"id":"/docs/tutorials/grafana-dashboard-24","page_id":"/docs/tutorials/grafana-dashboard","tags":[],"type":"text","url":"/docs/tutorials/grafana-dashboard#send-some-messages","content":"Use the CLI to create a stream and topic, then send 60 messages to it:"},"2921":{"id":"/docs/tutorials/grafana-dashboard-25","page_id":"/docs/tutorials/grafana-dashboard","tags":[],"type":"text","url":"/docs/tutorials/grafana-dashboard#send-some-messages","content":"Check the message count in Prometheus:"},"2922":{"id":"/docs/tutorials/grafana-dashboard-26","page_id":"/docs/tutorials/grafana-dashboard","tags":[],"type":"text","url":"/docs/tutorials/grafana-dashboard#open-grafana","content":"Open http://localhost:3001, sign in as admin with password admin, and find the \"Apache Iggy broker\" dashboard in the Iggy folder. Messages stored reads 60 and the rate panels show the burst, so send another and watch them move."},"2923":{"id":"/docs/tutorials/grafana-dashboard-27","page_id":"/docs/tutorials/grafana-dashboard","tags":[],"type":"text","url":"/docs/tutorials/grafana-dashboard#what-the-server-exports","content":"The server exports about forty metrics, including http_requests_total, streams, topics, partitions, segments, messages, users and clients. To list them all:"},"2924":{"id":"/docs/tutorials/grafana-dashboard-28","page_id":"/docs/tutorials/grafana-dashboard","tags":[],"type":"text","url":"/docs/tutorials/grafana-dashboard#running-it-again","content":"To stop everything:"},"2925":{"id":"/docs/tutorials/grafana-dashboard-29","page_id":"/docs/tutorials/grafana-dashboard","tags":[],"type":"text","url":"/docs/tutorials/grafana-dashboard#running-it-again","content":"Your files stay in the directory, so docker compose up -d starts it all again. The server starts empty each time, so create a new token and send some messages before you open the dashboard."},"2926":{"id":"/docs/tutorials/grafana-dashboard-30","page_id":"/docs/tutorials/grafana-dashboard","tags":[],"type":"text","url":"/docs/tutorials/grafana-dashboard#running-it-again","content":"To add a panel, edit grafana/dashboards/iggy.json and Grafana picks up the change within a few seconds. Watch the denied requests panel: if it starts to climb, the server is too busy to take more requests. The server's metrics settings are under [http.metrics] in the configuration reference."},"2927":{"id":"/docs/server/benchmarking","page_id":"/docs/server/benchmarking","type":"page","content":"Benchmarking","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/benchmarking"},"2928":{"id":"/docs/server/benchmarking-0","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking","content":"How Iggy is benchmarked, the tooling that ships with it, and the public platform for comparing results."},"2929":{"id":"/docs/server/benchmarking-1","page_id":"/docs/server/benchmarking","type":"heading","tags":[],"url":"/docs/server/benchmarking#running-benchmarks","content":"Running benchmarks"},"2930":{"id":"/docs/server/benchmarking-2","page_id":"/docs/server/benchmarking","type":"heading","tags":[],"url":"/docs/server/benchmarking#benchmark-kinds","content":"Benchmark kinds"},"2931":{"id":"/docs/server/benchmarking-3","page_id":"/docs/server/benchmarking","type":"heading","tags":[],"url":"/docs/server/benchmarking#transports","content":"Transports"},"2932":{"id":"/docs/server/benchmarking-4","page_id":"/docs/server/benchmarking","type":"heading","tags":[],"url":"/docs/server/benchmarking#storing-and-comparing-results","content":"Storing and comparing results"},"2933":{"id":"/docs/server/benchmarking-5","page_id":"/docs/server/benchmarking","type":"heading","tags":[],"url":"/docs/server/benchmarking#performance","content":"Performance"},"2934":{"id":"/docs/server/benchmarking-6","page_id":"/docs/server/benchmarking","type":"heading","tags":[],"url":"/docs/server/benchmarking#prepare-the-host-and-topic-policies","content":"Prepare the host and topic policies"},"2935":{"id":"/docs/server/benchmarking-7","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking","content":"Benchmarks should be the first-class citizens. We believe that performance is crucial for any system, and we strive to provide the best possible performance for our users. Please check, why we believe that the transparent benchmarking is so important."},"2936":{"id":"/docs/server/benchmarking-8","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking","content":"We've also built the benchmarking platform where you can browse published benchmarks and compare results. This is the another open-source project available here."},"2937":{"id":"/docs/server/benchmarking-9","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking","content":"Historical dashboard screenshot showing a 0.5.0 run, not 0.9.0 measurements."},"2938":{"id":"/docs/server/benchmarking-10","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking","content":"Iggy comes with a built-in benchmarking tool, iggy-bench. It's written in Rust and uses the tokio runtime for asynchronous I/O, mimicking the example client applications, so you can use it to estimate the performance of the server in your environment. It is part of the core repository and lives in the core/bench directory."},"2939":{"id":"/docs/server/benchmarking-11","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking","content":"Historical CLI screenshot. Server-start and cleanup flags shown there have been removed; use the commands below and the current iggy-bench --help."},"2940":{"id":"/docs/server/benchmarking-12","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#running-benchmarks","content":"First build the project in release mode:"},"2941":{"id":"/docs/server/benchmarking-13","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#running-benchmarks","content":"iggy-bench doesn't start a server. It only connects, and fails with a connection error when nothing is listening. For a disposable development server with an empty data directory, use the credentials expected by the benchmark defaults:"},"2942":{"id":"/docs/server/benchmarking-14","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#running-benchmarks","content":"This flag affects only the first creation of the root user; existing credentials remain unchanged, and environment variables take precedence. For another server, pass its credentials with iggy-bench -u USER -p PASSWORD before the benchmark kind."},"2943":{"id":"/docs/server/benchmarking-15","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#running-benchmarks","content":"The repo's driver script builds, starts the server, runs a send and a poll benchmark, and shuts the server down. Use it only in a disposable checkout on an isolated host: it deletes local_data and signals matching iggy-server and iggy-bench processes by name."},"2944":{"id":"/docs/server/benchmarking-16","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#running-benchmarks","content":"With a server running, invoke the benchmark kind and transport of your choice. Workloads that produce create their benchmark streams and topics, deleting pre-existing bench-stream-{n} streams unless --reuse-streams is set. Consumer-only workloads (pc and bcg) require those streams and enough messages to exist already. Run the corresponding producer workload first, with matching stream, partition, and message counts."},"2945":{"id":"/docs/server/benchmarking-17","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#benchmark-kinds","content":"Eight kinds are available, each with a short alias:"},"2946":{"id":"/docs/server/benchmarking-18","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#benchmark-kinds","content":"Producer and consumer counts default to six. Pinned workloads also default to six streams. Set explicit counts to match the workload and available CPUs."},"2947":{"id":"/docs/server/benchmarking-19","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#benchmark-kinds","content":"Pinned producer (pp): N producers, each sending to its own stream-topic with a single partition:"},"2948":{"id":"/docs/server/benchmarking-20","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#benchmark-kinds","content":"Pinned consumer (pc): N consumers, each polling its own stream-topic with a single partition:"},"2949":{"id":"/docs/server/benchmarking-21","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#benchmark-kinds","content":"Pinned producer and consumer (ppc), in parallel:"},"2950":{"id":"/docs/server/benchmarking-22","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#benchmark-kinds","content":"Balanced producer (bp): N producers sending to M partitions in K streams with balanced partitioning:"},"2951":{"id":"/docs/server/benchmarking-23","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#benchmark-kinds","content":"Balanced consumer group (bcg): N consumers assigned to M consumer groups polling from K partitions:"},"2952":{"id":"/docs/server/benchmarking-24","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#benchmark-kinds","content":"Balanced producer and consumer group (bpcg), in parallel:"},"2953":{"id":"/docs/server/benchmarking-25","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#benchmark-kinds","content":"End-to-end producing consumer (e2e): each task alternates producing and consuming, measuring latency from the messages' producer timestamps:"},"2954":{"id":"/docs/server/benchmarking-26","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#benchmark-kinds","content":"End-to-end producing consumer group (e2ecg): N producing consumers assigned to M consumer groups:"},"2955":{"id":"/docs/server/benchmarking-27","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#transports","content":"The transport subcommands are tcp, quic, http, and websocket (alias ws). Consumer-group workloads (bcg, bpcg, and e2ecg) require a binary transport: HTTP consumer-group joining returns FeatureUnavailable, even though the benchmark CLI accepts that combination. Each transport subcommand takes --server-address for a non-default server, for example:"},"2956":{"id":"/docs/server/benchmarking-28","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#transports","content":"Message count, batch size, message size, and both durability flags precede the kind subcommand. Producer, consumer, stream, and partition counts belong to the selected kind. iggy-bench --help and iggy-bench examples show the full surface."},"2957":{"id":"/docs/server/benchmarking-29","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#storing-and-comparing-results","content":"Each transport subcommand accepts a trailing output subcommand that persists the run (raw JSON data and charts):"},"2958":{"id":"/docs/server/benchmarking-30","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#storing-and-comparing-results","content":"When the server address uses localhost or 127.0.0.1, the saved command includes non-secret environment settings from the server configuration catalog. Credentials and unknown IGGY_ variables are omitted."},"2959":{"id":"/docs/server/benchmarking-31","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#storing-and-comparing-results","content":"-o/--output-dir defaults to performance_results. Optional flags (--remark, --gitref, extra info) annotate the run. Generated charts use the in-repo report library (core/bench/report). The runner (core/bench/runner) executes benchmarks across Git revisions. You can browse or compare results in the dashboard (core/bench/dashboard), which also powers the public benchmarking platform. A prebuilt dashboard image is available: docker pull apache/iggy-bench-dashboard:edge."},"2960":{"id":"/docs/server/benchmarking-32","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#performance","content":"The server is thread-per-core and shared-nothing, built on io_uring on Linux (via compio), with shard and CPU pinning configurable under [sharding]. Throughput and latency depend heavily on hardware, transport, and payload shape (messages-per-batch * message-size). Run the benchmarks on your own hardware, or browse current, dated results on the benchmarking platform."},"2961":{"id":"/docs/server/benchmarking-33","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#prepare-the-host-and-topic-policies","content":"Use the Linux tuning guide to check process limits, swap, huge pages, CPU/NUMA placement, writeback, and network capacity before measuring. Record the exact host settings and change one variable at a time. Use a separate load generator, or disjoint CPU sets when it shares a host with the server."},"2962":{"id":"/docs/server/benchmarking-34","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#prepare-the-host-and-topic-policies","content":"--durability and --consumer-offset-durability independently default to replicated. Place them before the benchmark kind. For example, this keeps consumer offsets replicated while measuring persisted message acknowledgments:"},"2963":{"id":"/docs/server/benchmarking-35","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#prepare-the-host-and-topic-policies","content":"Add --consumer-offset-durability persisted to request that policy too. These are create-time options and have no effect on existing topics with --reuse-streams. Poll auto-commit remains asynchronous, so poll latency is not an acknowledged offset-store measurement. iggy-bench examples shows all benchmark kinds, transports, policy combinations, and available topic-option examples."},"2964":{"id":"/docs/server/benchmarking-36","page_id":"/docs/server/benchmarking","tags":[],"type":"text","url":"/docs/server/benchmarking#prepare-the-host-and-topic-policies","content":"Keep both policies, replication-group size, batch and message sizes, CPU allocation, and storage consistent between runs. Run long enough to include flushes and checkpoints, and report tail latency, errors, memory pressure, and client utilization alongside throughput."},"2965":{"id":"/docs/server/configuration","page_id":"/docs/server/configuration","type":"page","content":"Configuration","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/configuration"},"2966":{"id":"/docs/server/configuration-0","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration","content":"The server's TOML configuration, how a file is merged over the embedded defaults, and what each section controls."},"2967":{"id":"/docs/server/configuration-1","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#how-configuration-loads","content":"How configuration loads"},"2968":{"id":"/docs/server/configuration-2","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#environment-variables","content":"Environment variables"},"2969":{"id":"/docs/server/configuration-3","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#secrets","content":"Secrets"},"2970":{"id":"/docs/server/configuration-4","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#validation-at-boot","content":"Validation at boot"},"2971":{"id":"/docs/server/configuration-5","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#command-line-flags","content":"Command-line flags"},"2972":{"id":"/docs/server/configuration-6","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#relocated-configuration-keys","content":"Relocated configuration keys"},"2973":{"id":"/docs/server/configuration-7","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#reference","content":"Reference"},"2974":{"id":"/docs/server/configuration-8","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#http","content":"[http]"},"2975":{"id":"/docs/server/configuration-9","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#httpcors","content":"[http.cors]"},"2976":{"id":"/docs/server/configuration-10","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#httpjwt","content":"[http.jwt]"},"2977":{"id":"/docs/server/configuration-11","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#httpjwttrusted_issuers","content":"[[http.jwt.trusted_issuers]]"},"2978":{"id":"/docs/server/configuration-12","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#httpmetrics","content":"[http.metrics]"},"2979":{"id":"/docs/server/configuration-13","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#httptls","content":"[http.tls]"},"2980":{"id":"/docs/server/configuration-14","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#tcp","content":"[tcp]"},"2981":{"id":"/docs/server/configuration-15","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#tcptls","content":"[tcp.tls]"},"2982":{"id":"/docs/server/configuration-16","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#quic","content":"[quic]"},"2983":{"id":"/docs/server/configuration-17","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#quiccertificate","content":"[quic.certificate]"},"2984":{"id":"/docs/server/configuration-18","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#websocket","content":"[websocket]"},"2985":{"id":"/docs/server/configuration-19","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#websockettls","content":"[websocket.tls]"},"2986":{"id":"/docs/server/configuration-20","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#tls-across-transports","content":"TLS across transports"},"2987":{"id":"/docs/server/configuration-21","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#root-data-path-and-runtime","content":"Root data path and runtime"},"2988":{"id":"/docs/server/configuration-22","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#logging","content":"[logging]"},"2989":{"id":"/docs/server/configuration-23","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#encryption","content":"[encryption]"},"2990":{"id":"/docs/server/configuration-24","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#memory_pool","content":"[memory_pool]"},"2991":{"id":"/docs/server/configuration-25","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#data_maintenancemessages","content":"[data_maintenance.messages]"},"2992":{"id":"/docs/server/configuration-26","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#heartbeat","content":"[heartbeat]"},"2993":{"id":"/docs/server/configuration-27","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#telemetry","content":"[telemetry]"},"2994":{"id":"/docs/server/configuration-28","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#sharding","content":"[sharding]"},"2995":{"id":"/docs/server/configuration-29","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#metadata","content":"[metadata]"},"2996":{"id":"/docs/server/configuration-30","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#partition","content":"[partition]"},"2997":{"id":"/docs/server/configuration-31","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#message_bus","content":"[message_bus]"},"2998":{"id":"/docs/server/configuration-32","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#personal_access_token","content":"[personal_access_token]"},"2999":{"id":"/docs/server/configuration-33","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#consumer_group","content":"[consumer_group]"},"3000":{"id":"/docs/server/configuration-34","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#node","content":"[node]"},"3001":{"id":"/docs/server/configuration-35","page_id":"/docs/server/configuration","type":"heading","tags":[],"url":"/docs/server/configuration#cluster","content":"[cluster]"},"3002":{"id":"/docs/server/configuration-36","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration","content":"The server reads a single TOML file. A copy of core/server/config.toml is embedded into the binary and serves as the default configuration, so the server boots with working defaults even without any file on disk. The embedded file is commented throughout and is the authoritative reference for the exact version you're running."},"3003":{"id":"/docs/server/configuration-37","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration","content":"A config file doesn't have to be complete. It is merged over the embedded defaults, so a minimal file overrides only what it names:"},"3004":{"id":"/docs/server/configuration-38","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration","content":"Both listeners here bind a wildcard, which tells the server nothing about where clients reach it, so [node] has to name that address explicitly - without it this file is refused at boot."},"3005":{"id":"/docs/server/configuration-39","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration","content":"Host and kernel settings are configured separately from the server TOML. See Linux tuning for service limits, memory policies, huge pages, CPU placement, and validation before deployment."},"3006":{"id":"/docs/server/configuration-40","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#how-configuration-loads","content":"Configuration is resolved in three layers. Later layers win:"},"3007":{"id":"/docs/server/configuration-41","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#how-configuration-loads","content":"Embedded defaults: the config.toml compiled into the binary."},"3008":{"id":"/docs/server/configuration-42","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#how-configuration-loads","content":"Config file: the path in IGGY_CONFIG_PATH, or core/server/config.toml resolved against the current working directory. A missing file is only a warning. The server continues on embedded defaults."},"3009":{"id":"/docs/server/configuration-43","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#how-configuration-loads","content":"Environment variables: any IGGY_-prefixed override."},"3010":{"id":"/docs/server/configuration-44","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#how-configuration-loads","content":"Before the environment is read, the server loads a .env file from the working directory or its parents, or from the path named by IGGY_ENV_PATH. Existing environment values take precedence over the .env file."},"3011":{"id":"/docs/server/configuration-45","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#how-configuration-loads","content":"After boot the server writes the effective configuration, including the addresses it actually bound, to {path}/runtime/current_config.toml with the default runtime subdirectory."},"3012":{"id":"/docs/server/configuration-46","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#environment-variables","content":"Every configuration key can be overridden with an IGGY_ variable. The name is the TOML path, uppercased, with dots turned into underscores:"},"3013":{"id":"/docs/server/configuration-47","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#environment-variables","content":"Two variables live outside the config schema: IGGY_ROOT_USERNAME and IGGY_ROOT_PASSWORD set the root credentials, always as a pair. They initialize the root user only at first creation. On an existing data directory the stored root user is recovered unchanged, but supplied environment credentials must still pass validation."},"3014":{"id":"/docs/server/configuration-48","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#secrets","content":"Five values are secret-flagged: http.jwt.encoding_secret, http.jwt.decoding_secret, encryption.key, cluster.auth.shared_secret, and cluster.auth.previous_shared_secret. Prefer setting them through their environment variables (IGGY_HTTP_JWT_ENCODING_SECRET, IGGY_ENCRYPTION_KEY, IGGY_CLUSTER_AUTH_SHARED_SECRET, and so on) instead of storing them in a file. Secret values are masked in logs and never serialized into runtime/current_config.toml."},"3015":{"id":"/docs/server/configuration-49","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#validation-at-boot","content":"Array-valued environment settings replace the corresponding TOML array. For an indexed array such as cluster.nodes, supply every entry and its required fields through environment variables; a single field override does not merge into the existing TOML roster."},"3016":{"id":"/docs/server/configuration-50","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#validation-at-boot","content":"Unknown top-level TOML fields and unknown server IGGY_ environment names reject startup. Some nested tables can still ignore unknown fields, so compare the effective configuration with the intended settings."},"3017":{"id":"/docs/server/configuration-51","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#validation-at-boot","content":"The old [system] table and its environment mappings are rejected. Removed placeholders such as archive_expired and recreate_missing_state must be removed, not set to false."},"3018":{"id":"/docs/server/configuration-52","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#validation-at-boot","content":"Several sections validate relationships between keys (QUIC windows, sharding shutdown budgets, metadata journal sizing, partition transfer floors). A violation aborts boot with an error naming the keys. The constraints are listed with their sections below."},"3019":{"id":"/docs/server/configuration-53","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#validation-at-boot","content":"The RUST_LOG environment variable always takes precedence over logging.level."},"3020":{"id":"/docs/server/configuration-54","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#command-line-flags","content":"iggy-server accepts these three startup options, plus --help (-h) and --version (-V):"},"3021":{"id":"/docs/server/configuration-55","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#command-line-flags","content":"Flag"},"3022":{"id":"/docs/server/configuration-56","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#command-line-flags","content":"Description"},"3023":{"id":"/docs/server/configuration-57","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#command-line-flags","content":"--fresh, -f"},"3024":{"id":"/docs/server/configuration-58","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#command-line-flags","content":"Delete the configured data directory (local_data by default, see IGGY_PATH) before boot and start on empty state. In cluster mode this wipes this replica only; it rejoins and refills by state transfer from the others. Wiping a quorum at the same time can destroy committed data. Do not put --fresh in a service unit: it would re-transfer the whole dataset on every restart."},"3025":{"id":"/docs/server/configuration-59","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#command-line-flags","content":"--with-default-root-credentials"},"3026":{"id":"/docs/server/configuration-60","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#command-line-flags","content":"Set IGGY_ROOT_USERNAME and IGGY_ROOT_PASSWORD to iggy unless they are already present in the environment. These values initialize the root user only at first creation. Development only."},"3027":{"id":"/docs/server/configuration-61","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#command-line-flags","content":"--replica-id <N>"},"3028":{"id":"/docs/server/configuration-62","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#command-line-flags","content":"Identify this node within cluster.nodes. Required when cluster.enabled = true; the value must match exactly one replica_id in the roster."},"3029":{"id":"/docs/server/configuration-63","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"The server configuration no longer has a [system] wrapper. Its runtime tables live at the root, and the data directory is the root path key. Old IGGY_SYSTEM_* overrides are rejected. Retention, durability, and segment layout are topic creation options, not server-wide defaults."},"3030":{"id":"/docs/server/configuration-64","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"Old server key"},"3031":{"id":"/docs/server/configuration-65","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"Replacement"},"3032":{"id":"/docs/server/configuration-66","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.path / IGGY_SYSTEM_PATH"},"3033":{"id":"/docs/server/configuration-67","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"Root path / IGGY_PATH"},"3034":{"id":"/docs/server/configuration-68","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.runtime, system.logging, system.encryption, system.memory_pool, system.sharding"},"3035":{"id":"/docs/server/configuration-69","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"Root tables runtime, logging, encryption, memory_pool, sharding; remove SYSTEM_ from their environment names"},"3036":{"id":"/docs/server/configuration-70","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.partition.validate_checksum"},"3037":{"id":"/docs/server/configuration-71","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"partition.validate_checksum"},"3038":{"id":"/docs/server/configuration-72","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.partition.path, partition.path / IGGY_PARTITION_PATH"},"3039":{"id":"/docs/server/configuration-73","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"Removed. The partitions path component is fixed."},"3040":{"id":"/docs/server/configuration-74","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.topic.max_size"},"3041":{"id":"/docs/server/configuration-75","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"max_topic_size topic option"},"3042":{"id":"/docs/server/configuration-76","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.topic.message_expiry"},"3043":{"id":"/docs/server/configuration-77","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"message_expiry topic option"},"3044":{"id":"/docs/server/configuration-78","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.partition.enforce_fsync"},"3045":{"id":"/docs/server/configuration-79","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"durability topic option: replicated or persisted"},"3046":{"id":"/docs/server/configuration-80","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"partition.consumer_offset_enforce_fsync"},"3047":{"id":"/docs/server/configuration-81","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"consumer_offset_durability topic option: replicated or persisted"},"3048":{"id":"/docs/server/configuration-82","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.partition.messages_required_to_save"},"3049":{"id":"/docs/server/configuration-83","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"messages_required_to_save topic option"},"3050":{"id":"/docs/server/configuration-84","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.partition.size_of_messages_required_to_save"},"3051":{"id":"/docs/server/configuration-85","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"size_of_messages_required_to_save topic option"},"3052":{"id":"/docs/server/configuration-86","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.segment.size"},"3053":{"id":"/docs/server/configuration-87","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"segment_size topic option"},"3054":{"id":"/docs/server/configuration-88","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.segment.preallocate"},"3055":{"id":"/docs/server/configuration-89","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"preallocate_segments topic option"},"3056":{"id":"/docs/server/configuration-90","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.stream.path, system.topic.path"},"3057":{"id":"/docs/server/configuration-91","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"Removed. The streams and topics path components are fixed; root [stream] and [topic] tables are rejected."},"3058":{"id":"/docs/server/configuration-92","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.segment.archive_expired, system.recovery.recreate_missing_state"},"3059":{"id":"/docs/server/configuration-93","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"Removed. Delete the keys and their old tables."},"3060":{"id":"/docs/server/configuration-94","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"system.message_deduplication (whole section)"},"3061":{"id":"/docs/server/configuration-95","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"Removed. No equivalent configuration."},"3062":{"id":"/docs/server/configuration-96","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"extra (whole section)"},"3063":{"id":"/docs/server/configuration-97","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"Removed. Admission caps are compile-time constants. No replacement."},"3064":{"id":"/docs/server/configuration-98","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"Remove the old tables and environment variables after migrating their values. Topic policies cannot be configured through TOML or IGGY_ overrides, and the former enforce_fsync topic option is also rejected. Both new durability policies independently default to replicated; explicitly select persisted at topic creation where required. Neither can be changed with UpdateTopic."},"3065":{"id":"/docs/server/configuration-99","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#relocated-configuration-keys","content":"Other removed sections, such as [message_saver], [system.state], [system.backup], [system.compression], and [tcp.socket], must also be removed. Consult the embedded configuration for the deployed binary rather than relying on ignored legacy fields."},"3066":{"id":"/docs/server/configuration-100","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#reference","content":"The tables below list every section with its shipped defaults. In cluster mode, every enabled transport takes its port from this node's cluster.nodes ports entry. The transport's own address picks only the bind interface."},"3067":{"id":"/docs/server/configuration-101","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"Key"},"3068":{"id":"/docs/server/configuration-102","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"Default"},"3069":{"id":"/docs/server/configuration-103","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"Description"},"3070":{"id":"/docs/server/configuration-104","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"enabled"},"3071":{"id":"/docs/server/configuration-105","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"true"},"3072":{"id":"/docs/server/configuration-106","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"Serve the HTTP REST API."},"3073":{"id":"/docs/server/configuration-107","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"address"},"3074":{"id":"/docs/server/configuration-108","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"\"127.0.0.1:3000\""},"3075":{"id":"/docs/server/configuration-109","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"Bind address and port."},"3076":{"id":"/docs/server/configuration-110","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"max_request_size"},"3077":{"id":"/docs/server/configuration-111","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"\"2 MB\""},"3078":{"id":"/docs/server/configuration-112","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"Maximum request body size, at most \"256 MiB\". Keep it at or below message_bus.max_message_size for multi-replica topics so an admitted batch fits replica frames."},"3079":{"id":"/docs/server/configuration-113","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"web_ui"},"3080":{"id":"/docs/server/configuration-114","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"false"},"3081":{"id":"/docs/server/configuration-115","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"Serve the embedded Web UI at /ui. Requires the iggy-web feature and static assets built with npm --prefix web ci and npm --prefix web run build:static before compiling the server. Without the feature, true logs a warning; missing assets return 404."},"3082":{"id":"/docs/server/configuration-116","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"HTTP sessions hold live server-side session state (they count against metadata.clients_table_max). Consumer group management (create, get, delete) is available over HTTP. Group membership (join, leave) is not and needs a stateful transport."},"3083":{"id":"/docs/server/configuration-117","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#http","content":"In cluster mode, followers forward control-plane requests (streams, topics, users, and so on) to the current primary when a cluster-wide JWT key exists (see [http.jwt] below). Message produce and consumer-offset writes use a separate fallback: after a TransientNotAccepted response, the server tries each other roster node at most once. Message polls read locally on the receiving node."},"3084":{"id":"/docs/server/configuration-118","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"Key"},"3085":{"id":"/docs/server/configuration-119","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"Default"},"3086":{"id":"/docs/server/configuration-120","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"Description"},"3087":{"id":"/docs/server/configuration-121","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"enabled"},"3088":{"id":"/docs/server/configuration-122","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"true"},"3089":{"id":"/docs/server/configuration-123","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"Handle cross-origin requests with the rules below."},"3090":{"id":"/docs/server/configuration-124","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"allowed_methods"},"3091":{"id":"/docs/server/configuration-125","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"[\"GET\", \"POST\", \"PUT\", \"DELETE\"]"},"3092":{"id":"/docs/server/configuration-126","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"Allowed HTTP methods."},"3093":{"id":"/docs/server/configuration-127","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"allowed_origins"},"3094":{"id":"/docs/server/configuration-128","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"[\"*\"]"},"3095":{"id":"/docs/server/configuration-129","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"Permitted origins. \"*\" is only valid as the first entry (anything after it is ignored); \"*\" in any other position fails the config."},"3096":{"id":"/docs/server/configuration-130","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"allowed_headers"},"3097":{"id":"/docs/server/configuration-131","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#httpcors","content":"[\"content-type\", \"a