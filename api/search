ver/security-2","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#personal-access-tokens-pat","content":"Personal Access Tokens (PAT)"},"1415":{"id":"/docs/server/security-3","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#authorization","content":"Authorization"},"1416":{"id":"/docs/server/security-4","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#permission-hierarchy","content":"Permission hierarchy"},"1417":{"id":"/docs/server/security-5","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#global-permissions","content":"Global permissions"},"1418":{"id":"/docs/server/security-6","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#stream-permissions","content":"Stream permissions"},"1419":{"id":"/docs/server/security-7","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#topic-permissions","content":"Topic permissions"},"1420":{"id":"/docs/server/security-8","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#how-permissions-cascade","content":"How permissions cascade"},"1421":{"id":"/docs/server/security-9","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#example-read-only-user-for-a-specific-stream","content":"Example: read-only user for a specific stream"},"1422":{"id":"/docs/server/security-10","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#transport-encryption-tls","content":"Transport encryption (TLS)"},"1423":{"id":"/docs/server/security-11","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#data-encryption-at-rest","content":"Data encryption at rest"},"1424":{"id":"/docs/server/security-12","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#jwt-http-api","content":"JWT (HTTP API)"},"1425":{"id":"/docs/server/security-13","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security","content":"Iggy provides multiple layers of security covering authentication, authorization, transport encryption, and data encryption at rest."},"1426":{"id":"/docs/server/security-14","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authentication","content":"Iggy supports two authentication mechanisms:"},"1427":{"id":"/docs/server/security-15","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#username-and-password","content":"Users authenticate with a username and password via login_user(). Passwords are hashed using Argon2id (a memory-hard hashing algorithm). On first startup, the server generates a random password for the root user and logs it to the console. You can override this by setting environment variables:"},"1428":{"id":"/docs/server/security-16","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#username-and-password","content":"Or use the --with-default-root-credentials flag for development (sets root credentials to iggy/iggy)."},"1429":{"id":"/docs/server/security-17","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#username-and-password","content":"Important: once the data directory exists, environment variable credentials are ignored. To reset credentials, you must use the --fresh flag (which deletes all data)."},"1430":{"id":"/docs/server/security-18","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#personal-access-tokens-pat","content":"PATs provide programmatic access with optional expiry. Each user can have up to max_tokens_per_user (default 100) active tokens. Tokens are hashed before storage and can be revoked at any time."},"1431":{"id":"/docs/server/security-19","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#personal-access-tokens-pat","content":"An automatic cleaner removes expired tokens at a configurable interval."},"1432":{"id":"/docs/server/security-20","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"Iggy provides granular permissions at three levels:"},"1433":{"id":"/docs/server/security-21","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"Global permissions - system-wide operations (manage servers, manage users, read servers)"},"1434":{"id":"/docs/server/security-22","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"Stream permissions - per-stream operations (manage stream, read stream, manage topics, read topics, poll messages, send messages)"},"1435":{"id":"/docs/server/security-23","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"Topic permissions - per-topic operations within a stream (manage topic, read topic, poll messages, send messages)"},"1436":{"id":"/docs/server/security-24","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"The root user has full access to everything and bypasses all permission checks. Other users can be assigned specific permissions using the CLI, SDK, or Web UI."},"1437":{"id":"/docs/server/security-25","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-hierarchy","content":"Permissions are organized in a tree structure. At the top level, the Permissions struct holds both global and per-stream settings:"},"1438":{"id":"/docs/server/security-26","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-hierarchy","content":"The global field controls system-wide operations, while streams is an optional map keyed by stream ID that lets you grant fine-grained access to individual streams."},"1439":{"id":"/docs/server/security-27","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#global-permissions","content":"GlobalPermissions contains boolean fields that govern server-wide operations:"},"1440":{"id":"/docs/server/security-28","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#global-permissions","content":"Note that \"manage\" permissions are always supersets of their \"read\" counterparts. For example, if manage_streams is true, the user can also read streams, even if read_streams is false. Similarly, read_topics is a superset of poll_messages, so granting read_topics implicitly allows polling messages too."},"1441":{"id":"/docs/server/security-29","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#stream-permissions","content":"When you need to restrict a user to specific streams rather than granting global access, use StreamPermissions:"},"1442":{"id":"/docs/server/security-30","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#stream-permissions","content":"The topics field works just like the streams field one level up. It is an optional map keyed by topic ID that lets you drill down even further."},"1443":{"id":"/docs/server/security-31","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#topic-permissions","content":"At the most granular level, TopicPermissions controls access to a single topic within a stream:"},"1444":{"id":"/docs/server/security-32","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"Permissions are checked from top to bottom: global, then stream, then topic. If a permission is granted at a higher level, it covers everything below it. For instance:"},"1445":{"id":"/docs/server/security-33","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"Setting global.poll_messages = true lets the user poll messages from all streams and topics."},"1446":{"id":"/docs/server/security-34","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"Setting stream[1].poll_messages = true lets the user poll messages from all topics in stream 1, but not from other streams."},"1447":{"id":"/docs/server/security-35","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"Setting stream[1].topics[5].poll_messages = true lets the user poll messages only from topic 5 in stream 1."},"1448":{"id":"/docs/server/security-36","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"If the streams map is None (or a specific stream ID is absent from it), the user has no stream-level overrides and only global permissions apply. The same logic holds for the topics map within a stream."},"1449":{"id":"/docs/server/security-37","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#example-read-only-user-for-a-specific-stream","content":"Suppose you want to create a user that can only poll messages from stream 42, with no other access. You would set up their permissions like this:"},"1450":{"id":"/docs/server/security-38","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#example-read-only-user-for-a-specific-stream","content":"This user can read stream 42, list its topics, and poll messages from any topic within it, but cannot send messages, create topics, or access any other stream."},"1451":{"id":"/docs/server/security-39","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"All transport protocols support TLS encryption:"},"1452":{"id":"/docs/server/security-40","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"TCP: Optional TLS via rustls. Enable with tcp.tls.enabled = true."},"1453":{"id":"/docs/server/security-41","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"QUIC: TLS is mandatory (built into the QUIC protocol). Uses self-signed certificates by default."},"1454":{"id":"/docs/server/security-42","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"HTTP: Optional HTTPS. Enable with http.tls.enabled = true."},"1455":{"id":"/docs/server/security-43","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"WebSocket: Optional TLS. Enable with websocket.tls.enabled = true."},"1456":{"id":"/docs/server/security-44","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"All protocols support automatic self-signed certificate generation when self_signed = true and the certificate files don't exist. For production deployments, provide proper certificates via cert_file and key_file."},"1457":{"id":"/docs/server/security-45","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#data-encryption-at-rest","content":"Iggy supports optional AES-256-GCM encryption for message payloads and state commands. When enabled, all data is encrypted before being written to disk and decrypted when read. The encryption key must be a 32-byte base64-encoded string."},"1458":{"id":"/docs/server/security-46","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#jwt-http-api","content":"The HTTP API uses JWT (JSON Web Tokens) for session management. Tokens are signed with HS256 by default and have configurable expiry, clock skew tolerance, and audience/issuer validation."},"1459":{"id":"/docs/server/security-47","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#jwt-http-api","content":"Important: change the default encoding_secret and decoding_secret values in production."},"1460":{"id":"/docs/server/storage-engine","page_id":"/docs/server/storage-engine","type":"page","content":"Storage Engine","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/storage-engine"},"1461":{"id":"/docs/server/storage-engine-0","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#directory-layout","content":"Directory layout"},"1462":{"id":"/docs/server/storage-engine-1","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#segmented-log","content":"Segmented log"},"1463":{"id":"/docs/server/storage-engine-2","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#message-binary-format","content":"Message binary format"},"1464":{"id":"/docs/server/storage-engine-3","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#indexes","content":"Indexes"},"1465":{"id":"/docs/server/storage-engine-4","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#write-pipeline","content":"Write pipeline"},"1466":{"id":"/docs/server/storage-engine-5","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#memory-pool","content":"Memory pool"},"1467":{"id":"/docs/server/storage-engine-6","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#zero-copy-deserialization","content":"Zero-copy deserialization"},"1468":{"id":"/docs/server/storage-engine-7","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#retention-and-cleanup","content":"Retention and cleanup"},"1469":{"id":"/docs/server/storage-engine-8","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#message-deduplication","content":"Message deduplication"},"1470":{"id":"/docs/server/storage-engine-9","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#encryption","content":"Encryption"},"1471":{"id":"/docs/server/storage-engine-10","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#compression","content":"Compression"},"1472":{"id":"/docs/server/storage-engine-11","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#backup-and-archiving","content":"Backup and archiving"},"1473":{"id":"/docs/server/storage-engine-12","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#state-persistence-write-ahead-log","content":"State persistence (Write-ahead log)"},"1474":{"id":"/docs/server/storage-engine-13","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine","content":"Iggy's storage engine is built around the concept of a segmented append-only log. Every piece of data flows through a well-defined hierarchy: System -> Streams -> Topics -> Partitions -> Segments. This page covers how data is stored, indexed, flushed, and managed on disk."},"1475":{"id":"/docs/server/storage-engine-14","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#directory-layout","content":"All data is stored under the system.path directory (default local_data):"},"1476":{"id":"/docs/server/storage-engine-15","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#directory-layout","content":"Each partition directory contains pairs of .log and .index files. The filename is the start offset of the first message in that segment, zero-padded to 20 digits."},"1477":{"id":"/docs/server/storage-engine-16","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#segmented-log","content":"The SegmentedLog is the core storage abstraction per partition. It contains an ordered list of sealed (read-only) segments plus one active (writable) segment. When the active segment reaches its configured size limit (default 1 GiB), it is sealed and a new active segment is created."},"1478":{"id":"/docs/server/storage-engine-17","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#segmented-log","content":"Key segment tracking fields:"},"1479":{"id":"/docs/server/storage-engine-18","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#segmented-log","content":"start_offset / end_offset - first and last message position"},"1480":{"id":"/docs/server/storage-engine-19","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#segmented-log","content":"current_position - write pointer in bytes"},"1481":{"id":"/docs/server/storage-engine-20","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#segmented-log","content":"size - configured maximum (must be a multiple of 512 bytes)"},"1482":{"id":"/docs/server/storage-engine-21","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#segmented-log","content":"sealed - whether the segment accepts new writes"},"1483":{"id":"/docs/server/storage-engine-22","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"Each message on disk consists of a 64-byte header followed by optional user headers and the payload:"},"1484":{"id":"/docs/server/storage-engine-23","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"Field"},"1485":{"id":"/docs/server/storage-engine-24","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"Bytes"},"1486":{"id":"/docs/server/storage-engine-25","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"Type"},"1487":{"id":"/docs/server/storage-engine-26","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"Description"},"1488":{"id":"/docs/server/storage-engine-27","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"checksum"},"1489":{"id":"/docs/server/storage-engine-28","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"0..8"},"1490":{"id":"/docs/server/storage-engine-29","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"u64"},"1491":{"id":"/docs/server/storage-engine-30","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"xxHash3 integrity checksum"},"1492":{"id":"/docs/server/storage-engine-31","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"id"},"1493":{"id":"/docs/server/storage-engine-32","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"8..24"},"1494":{"id":"/docs/server/storage-engine-33","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"u128"},"1495":{"id":"/docs/server/storage-engine-34","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"Unique message ID (UUIDv4)"},"1496":{"id":"/docs/server/storage-engine-35","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"offset"},"1497":{"id":"/docs/server/storage-engine-36","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"24..32"},"1498":{"id":"/docs/server/storage-engine-37","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"u64"},"1499":{"id":"/docs/server/storage-engine-38","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"Sequential offset in partition"},"1500":{"id":"/docs/server/storage-engine-39","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"timestamp"},"1501":{"id":"/docs/server/storage-engine-40","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"32..40"},"1502":{"id":"/docs/server/storage-engine-41","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"u64"},"1503":{"id":"/docs/server/storage-engine-42","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"Server-assigned timestamp (microseconds)"},"1504":{"id":"/docs/server/storage-engine-43","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"origin_timestamp"},"1505":{"id":"/docs/server/storage-engine-44","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"40..48"},"1506":{"id":"/docs/server/storage-engine-45","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"u64"},"1507":{"id":"/docs/server/storage-engine-46","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"Client-provided timestamp"},"1508":{"id":"/docs/server/storage-engine-47","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"user_headers_length"},"1509":{"id":"/docs/server/storage-engine-48","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"48..52"},"1510":{"id":"/docs/server/storage-engine-49","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"u32"},"1511":{"id":"/docs/server/storage-engine-50","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"Length of user headers"},"1512":{"id":"/docs/server/storage-engine-51","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"payload_length"},"1513":{"id":"/docs/server/storage-engine-52","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"52..56"},"1514":{"id":"/docs/server/storage-engine-53","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"u32"},"1515":{"id":"/docs/server/storage-engine-54","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"Length of payload"},"1516":{"id":"/docs/server/storage-engine-55","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"reserved"},"1517":{"id":"/docs/server/storage-engine-56","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"56..64"},"1518":{"id":"/docs/server/storage-engine-57","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"u64"},"1519":{"id":"/docs/server/storage-engine-58","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"Reserved, must be 0"},"1520":{"id":"/docs/server/storage-engine-59","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"After the 64-byte header: user_headers (variable, length from user_headers_length) followed by payload (variable, length from payload_length)."},"1521":{"id":"/docs/server/storage-engine-60","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-binary-format","content":"All fields are stored in little-endian byte order. The header is exactly 64 bytes, which allows for efficient aligned reads. Messages are stored contiguously in the .log file with no padding between them."},"1522":{"id":"/docs/server/storage-engine-61","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Each segment has an accompanying .index file that stores positional and time indexes. These allow the server to quickly locate messages by offset or timestamp without scanning the entire log file."},"1523":{"id":"/docs/server/storage-engine-62","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Index caching can be configured via the cache_indexes setting:"},"1524":{"id":"/docs/server/storage-engine-63","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Strategy"},"1525":{"id":"/docs/server/storage-engine-64","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Behavior"},"1526":{"id":"/docs/server/storage-engine-65","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"\"all\""},"1527":{"id":"/docs/server/storage-engine-66","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"All segment indexes loaded at startup, kept in memory"},"1528":{"id":"/docs/server/storage-engine-67","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"\"open_segment\""},"1529":{"id":"/docs/server/storage-engine-68","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Only the active segment's indexes are cached (default)"},"1530":{"id":"/docs/server/storage-engine-69","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"\"none\""},"1531":{"id":"/docs/server/storage-engine-70","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Indexes are loaded on-demand from disk"},"1532":{"id":"/docs/server/storage-engine-71","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"If an index file becomes corrupted or goes missing, the IndexRebuilder can reconstruct it by scanning the corresponding .log file and parsing message headers."},"1533":{"id":"/docs/server/storage-engine-72","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"Messages flow through a multi-stage pipeline before reaching disk:"},"1534":{"id":"/docs/server/storage-engine-73","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"The MessagesWriter uses vectored I/O (writev) with MAX_IOV_COUNT=1024 to batch multiple message buffers into a single syscall, which significantly reduces the overhead of writing many small messages."},"1535":{"id":"/docs/server/storage-engine-74","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"The flush thresholds are configurable:"},"1536":{"id":"/docs/server/storage-engine-75","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"messages_required_to_save (default 1024, minimum 1) - count threshold"},"1537":{"id":"/docs/server/storage-engine-76","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"size_of_messages_required_to_save (default \"1 MiB\") - size threshold"},"1538":{"id":"/docs/server/storage-engine-77","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"These are soft limits - the actual count/size may be higher depending on the last batch size."},"1539":{"id":"/docs/server/storage-engine-78","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#memory-pool","content":"Iggy includes a custom memory pool to eliminate allocation overhead on the hot path. The pool has 32 buckets with buffer sizes ranging from 256 B up to 512 MiB (with non-uniform spacing optimized for common message sizes). When a component needs a buffer, it requests one from the appropriate bucket. When done, the buffer is returned to the pool."},"1540":{"id":"/docs/server/storage-engine-79","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#memory-pool","content":"This avoids frequent heap allocations during message processing and enables zero-copy message passing between internal components."},"1541":{"id":"/docs/server/storage-engine-80","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#zero-copy-deserialization","content":"Iggy uses a custom zero-copy deserialization approach for reading messages. Instead of fully deserializing each message from disk, the system maintains a separate index vector of u32 values pointing to positions within the raw message data buffer. When a consumer polls messages, the server yields views into the underlying buffer rather than copying data, and performs just-in-time deserialization only for the fields the consumer actually needs."},"1542":{"id":"/docs/server/storage-engine-81","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#zero-copy-deserialization","content":"This approach delivered significant performance improvements:"},"1543":{"id":"/docs/server/storage-engine-82","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#zero-copy-deserialization","content":"Producer throughput: +40% (1.7 to 2.4 GB/s)"},"1544":{"id":"/docs/server/storage-engine-83","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#zero-copy-deserialization","content":"Consumer throughput: +90% (2.1 to 4.0 GB/s)"},"1545":{"id":"/docs/server/storage-engine-84","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#zero-copy-deserialization","content":"Producer P99 latency: +63% improvement (4.23 to 2.59ms)"},"1546":{"id":"/docs/server/storage-engine-85","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#zero-copy-deserialization","content":"Consumer P99 latency: +50% improvement (2.93 to 1.46ms)"},"1547":{"id":"/docs/server/storage-engine-86","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#retention-and-cleanup","content":"Iggy supports two independent retention policies for automatic message cleanup, both configurable per topic:"},"1548":{"id":"/docs/server/storage-engine-87","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#retention-and-cleanup","content":"Size-based retention: when a topic exceeds max_size, the oldest sealed segments are removed to make room. Deletion kicks in at 90% of the limit. The active segment is always protected."},"1549":{"id":"/docs/server/storage-engine-88","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#retention-and-cleanup","content":"Time-based retention: segments with all messages older than message_expiry are deleted. The cleaner runs at a configurable interval (default 1 minute) when cleaner_enabled is true."},"1550":{"id":"/docs/server/storage-engine-89","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#retention-and-cleanup","content":"Both policies can be active simultaneously and only affect sealed segments. The active segment is never deleted, even if its messages have expired."},"1551":{"id":"/docs/server/storage-engine-90","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#message-deduplication","content":"Optional server-side deduplication can be enabled per partition. When active, a hash-based MessageDeduplicator keeps track of recently seen message IDs and silently drops duplicates. This is useful for achieving exactly-once semantics at the application level."},"1552":{"id":"/docs/server/storage-engine-91","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#encryption","content":"Iggy supports optional AES-256-GCM encryption for message payloads and state commands. When enabled, messages are encrypted before being written to disk and decrypted when read. The encryption key is a 32-byte base64-encoded string."},"1553":{"id":"/docs/server/storage-engine-92","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#compression","content":"Topic-level compression is supported with the following algorithms: none, gzip, lz4, zstd. The allow_override setting controls whether individual topics can override the default algorithm."},"1554":{"id":"/docs/server/storage-engine-93","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#backup-and-archiving","content":"Sealed segments can be archived to local/NAS storage or S3-compatible cloud storage (AWS S3, MinIO). Since sealed segments are immutable, they are safe to copy in parallel without any coordination. The archive path is configurable under system.backup.path."},"1555":{"id":"/docs/server/storage-engine-94","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#state-persistence-write-ahead-log","content":"All metadata operations (create stream, delete topic, create user, etc.) are persisted to a write-ahead log (state.messages). Each entry contains:"},"1556":{"id":"/docs/server/storage-engine-95","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#state-persistence-write-ahead-log","content":"Field"},"1557":{"id":"/docs/server/storage-engine-96","page_id":"/docs/server/storage-engine","tags":[],"type":