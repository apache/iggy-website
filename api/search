cs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"user_headers_length"},"2390":{"id":"/docs/introduction/concepts-62","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"48-52"},"2391":{"id":"/docs/introduction/concepts-63","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"u32"},"2392":{"id":"/docs/introduction/concepts-64","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Length of optional headers"},"2393":{"id":"/docs/introduction/concepts-65","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"payload_length"},"2394":{"id":"/docs/introduction/concepts-66","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"52-56"},"2395":{"id":"/docs/introduction/concepts-67","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"u32"},"2396":{"id":"/docs/introduction/concepts-68","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Length of payload"},"2397":{"id":"/docs/introduction/concepts-69","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"reserved"},"2398":{"id":"/docs/introduction/concepts-70","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"56-64"},"2399":{"id":"/docs/introduction/concepts-71","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"u64"},"2400":{"id":"/docs/introduction/concepts-72","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Reserved (must be 0)"},"2401":{"id":"/docs/introduction/concepts-73","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"In the SDK message representation, the header is followed by payload bytes and then optional user-header bytes."},"2402":{"id":"/docs/introduction/concepts-74","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"To see how the server schedules these concepts across CPU cores and stores them on disk, head over to architecture."},"2403":{"id":"/docs/introduction/getting-started-python","page_id":"/docs/introduction/getting-started-python","type":"page","content":"Getting started (Python)","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/getting-started-python"},"2404":{"id":"/docs/introduction/getting-started-python-0","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python","content":"A first program with the Python SDK: create a stream and topic, send messages, then read them back on their own and as a consumer group."},"2405":{"id":"/docs/introduction/getting-started-python-1","page_id":"/docs/introduction/getting-started-python","type":"heading","tags":[],"url":"/docs/introduction/getting-started-python#before-we-start","content":"Before we start"},"2406":{"id":"/docs/introduction/getting-started-python-2","page_id":"/docs/introduction/getting-started-python","type":"heading","tags":[],"url":"/docs/introduction/getting-started-python#starting-the-server","content":"Starting the server"},"2407":{"id":"/docs/introduction/getting-started-python-3","page_id":"/docs/introduction/getting-started-python","type":"heading","tags":[],"url":"/docs/introduction/getting-started-python#producer","content":"Producer"},"2408":{"id":"/docs/introduction/getting-started-python-4","page_id":"/docs/introduction/getting-started-python","type":"heading","tags":[],"url":"/docs/introduction/getting-started-python#consumer","content":"Consumer"},"2409":{"id":"/docs/introduction/getting-started-python-5","page_id":"/docs/introduction/getting-started-python","type":"heading","tags":[],"url":"/docs/introduction/getting-started-python#consumer-group","content":"Consumer group"},"2410":{"id":"/docs/introduction/getting-started-python-6","page_id":"/docs/introduction/getting-started-python","type":"heading","tags":[],"url":"/docs/introduction/getting-started-python#running-it-again","content":"Running it again"},"2411":{"id":"/docs/introduction/getting-started-python-7","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#before-we-start","content":"This tutorial uses the Python SDK's low-level API (IggyClient) directly, so you can see each step. It needs Python 3.10 or newer. On Linux the server needs kernel 5.19 or newer; macOS has no kernel requirement. See System requirements."},"2412":{"id":"/docs/introduction/getting-started-python-8","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#before-we-start","content":"The producer and consumer below match the getting-started examples in the repository."},"2413":{"id":"/docs/introduction/getting-started-python-9","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#starting-the-server","content":"IGGY_TCP_ADDRESS and IGGY_NODE_ADVERTISED_ADDRESS are needed because the server binds 127.0.0.1 inside the container by default, which the published port can't reach. The Rust tutorial's Starting the Iggy server section explains each flag."},"2414":{"id":"/docs/introduction/getting-started-python-10","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#starting-the-server","content":"On Docker Desktop, 0.9.0 can fail to start with failed to bind shard 0 memory to its NUMA node. If you hit this, add -e IGGY_SHARDING_CPU_ALLOCATION=all to the command above."},"2415":{"id":"/docs/introduction/getting-started-python-11","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#starting-the-server","content":"Install the SDK in a virtual environment:"},"2416":{"id":"/docs/introduction/getting-started-python-12","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#producer","content":"Save this as producer.py:"},"2417":{"id":"/docs/introduction/getting-started-python-13","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#producer","content":"Run it with python producer.py:"},"2418":{"id":"/docs/introduction/getting-started-python-14","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#producer","content":"from_connection_string takes the transport, host and credentials in one string, iggy+tcp://user:pass@host:port. See Connection strings for the other options. Creating a stream or topic that already exists is an error, so the producer checks first and only creates what's missing. That's also what makes it safe to run again."},"2419":{"id":"/docs/introduction/getting-started-python-15","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#consumer","content":"Save this as consumer.py:"},"2420":{"id":"/docs/introduction/getting-started-python-16","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#consumer","content":"Run it with python consumer.py, after the producer:"},"2421":{"id":"/docs/introduction/getting-started-python-17","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#consumer","content":"Consumer.Single(name) is a consumer that polls on its own, and the server stores its offset under that name. With auto_commit=True the offset is stored after the poll returns, without waiting for the store to finish, so a crash straight afterwards can deliver the last batch again."},"2422":{"id":"/docs/introduction/getting-started-python-18","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#consumer-group","content":"A consumer group lets several copies of a consumer share a topic's partitions, with each message going to only one of them. Groups need a binary transport (TCP, QUIC or WebSocket); HTTP doesn't support them."},"2423":{"id":"/docs/introduction/getting-started-python-19","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#consumer-group","content":"Save this as consumer_group.py:"},"2424":{"id":"/docs/introduction/getting-started-python-20","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#consumer-group","content":"Run it with python consumer_group.py. With the producer run twice, so 20 messages on the topic, it prints every offset from 0 to 19 and then stops:"},"2425":{"id":"/docs/introduction/getting-started-python-21","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#consumer-group","content":"iter_messages() is the simplest way to read from a group. For a long-running service with its own shutdown signal, use consume_messages(callback, shutdown_event) instead."},"2426":{"id":"/docs/introduction/getting-started-python-22","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#running-it-again","content":"Run the producer again and it finds the stream and topic already there, and adds another 10 messages at offsets 10 to 19."},"2427":{"id":"/docs/introduction/getting-started-python-23","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#running-it-again","content":"Run consumer.py again and it carries on from its stored offset, printing only the new messages rather than the first ten again."},"2428":{"id":"/docs/introduction/getting-started-python-24","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#running-it-again","content":"Run consumer_group.py again and it prints every message from offset 0, because it asks for PollingStrategy.First(). That keeps the example repeatable. A long-running group consumer would leave the polling strategy at its default and keep auto_commit on, so it carries on from the group's stored offset instead."},"2429":{"id":"/docs/introduction/getting-started-python-25","page_id":"/docs/introduction/getting-started-python","tags":[],"type":"text","url":"/docs/introduction/getting-started-python#running-it-again","content":"To start again with an empty server, stop the container, which --rm removes, and run docker run again."},"2430":{"id":"/docs/introduction/getting-started","page_id":"/docs/introduction/getting-started","type":"page","content":"Getting started (Rust)","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/getting-started"},"2431":{"id":"/docs/introduction/getting-started-0","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started","content":"A first program with the low-level Rust SDK: create a stream and topic, send messages, then poll them back."},"2432":{"id":"/docs/introduction/getting-started-1","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#before-we-start","content":"Before we start"},"2433":{"id":"/docs/introduction/getting-started-2","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#what-we-will-build","content":"What we will build"},"2434":{"id":"/docs/introduction/getting-started-3","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"Starting the Iggy server"},"2435":{"id":"/docs/introduction/getting-started-4","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#setting-up-the-project","content":"Setting up the project"},"2436":{"id":"/docs/introduction/getting-started-5","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#building-the-producer","content":"Building the producer"},"2437":{"id":"/docs/introduction/getting-started-6","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#building-the-consumer","content":"Building the consumer"},"2438":{"id":"/docs/introduction/getting-started-7","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#running-it-again-and-cleaning-up","content":"Running it again, and cleaning up"},"2439":{"id":"/docs/introduction/getting-started-8","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#summary","content":"Summary"},"2440":{"id":"/docs/introduction/getting-started-9","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#before-we-start","content":"On Linux the server needs kernel 5.19 or newer. macOS has no kernel requirement, but Docker Desktop on 0.9.0 needs one extra setting. Under WSL2, run wsl --update first. See System requirements for the details."},"2441":{"id":"/docs/introduction/getting-started-10","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#before-we-start","content":"This tutorial uses the low-level Rust SDK to show how things work under the hood - creating streams, topics, sending and polling messages step by step. This is great for understanding the fundamentals."},"2442":{"id":"/docs/introduction/getting-started-11","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#before-we-start","content":"For real-world applications, you might typically prefer the high-level SDK, which provides IggyProducer and IggyConsumer builders with auto-batching, consumer groups, offset management, reconnection, and retry logic out of the box. Check the Stream Builder docs for the most ergonomic API."},"2443":{"id":"/docs/introduction/getting-started-12","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#before-we-start","content":"For examples in other programming languages, see the SDK section."},"2444":{"id":"/docs/introduction/getting-started-13","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#what-we-will-build","content":"We will build a producer (publishing messages to a stream) and a consumer (reading those messages back). In a real system, a service can be both at the same time - publishing its own events while consuming events from other services."},"2445":{"id":"/docs/introduction/getting-started-14","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#what-we-will-build","content":"The completed sample can be found in the repository. We will go through the implementation step by step so you get a clear understanding of how it all fits together."},"2446":{"id":"/docs/introduction/getting-started-15","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"For our purpose, we will focus on the basic scenario in order to keep things simple. Before we begin implementing the consumer and producer apps, we need to start the Iggy streaming server."},"2447":{"id":"/docs/introduction/getting-started-16","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"This guide targets server 0.9.0. Use its official Docker image:"},"2448":{"id":"/docs/introduction/getting-started-17","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"The container needs a host kernel of 5.19 or newer, because the server uses io_uring; see System requirements if it fails to start. The capabilities, seccomp setting, and memlock limit form a permissive development setup. Production deployments can use narrower syscall permissions and a finite memory budget; see Docker & Helm for the details. IGGY_TCP_ADDRESS is needed because the server binds to 127.0.0.1 inside the container by default, which a published port cannot reach. IGGY_NODE_ADVERTISED_ADDRESS is needed because that wildcard leaves the server with no address to give clients, and it refuses to start rather than publish one nobody can dial. Here the port is published to the host, so localhost is that address. Setting the root credentials explicitly means the username and password used later in this guide will work."},"2449":{"id":"/docs/introduction/getting-started-18","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"Alternatively, build from source by cloning the repository and running:"},"2450":{"id":"/docs/introduction/getting-started-19","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"A bare iggy-server boot does not create the root user with the well-known iggy/iggy pair. It generates a random password and prints it exactly once to the logs. The --with-default-root-credentials flag switches to the development credentials (username: iggy, password: iggy), and --fresh wipes the data directory first, so the root user is created anew with them. You can also set IGGY_ROOT_USERNAME and IGGY_ROOT_PASSWORD yourself. The environment takes precedence over the flag. The credentials initialize the stored root account only on first creation; changing them on a later boot does not reset its password. Supplied environment credentials are still validated on restarts."},"2451":{"id":"/docs/introduction/getting-started-20","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"All the data used by the server will be persisted under the local_data directory, unless specified differently in the configuration."},"2452":{"id":"/docs/introduction/getting-started-21","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"As long as the Iggy server is running, we're good to go. If you'd like to play with the configuration (e.g. change the addresses, ports, caching or so) you will find config.toml under core/server in the repository."},"2453":{"id":"/docs/introduction/getting-started-22","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#setting-up-the-project","content":"Let's start by creating a new project - simply type cargo new iggy-sample and open your newly created project with the favorite code editor."},"2454":{"id":"/docs/introduction/getting-started-23","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#setting-up-the-project","content":"At the very beginning, we will organize the files a little bit differently - create a new consumer directory under src and move the main.rs file here. You should have the following project structure:"},"2455":{"id":"/docs/introduction/getting-started-24","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#setting-up-the-project","content":"Then, open Cargo.toml and add the following code before the [dependencies]"},"2456":{"id":"/docs/introduction/getting-started-25","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#setting-up-the-project","content":"Just to make sure that everything is set correctly, try to run the app with cargo r --bin consumer."},"2457":{"id":"/docs/introduction/getting-started-26","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#setting-up-the-project","content":"Now, let's do the same for the producer part. Create a new producer directory, copy & paste the existing main.rs, and update the Cargo.toml with the following code:"},"2458":{"id":"/docs/introduction/getting-started-27","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#setting-up-the-project","content":"You should have the project structure as shown below:"},"2459":{"id":"/docs/introduction/getting-started-28","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#setting-up-the-project","content":"From that point on, we will focus on implementing the message streaming between our applications, starting with the producer."},"2460":{"id":"/docs/introduction/getting-started-29","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"We will begin with installing the Iggy client crate - execute cargo add iggy in your terminal. Next, install tokio.rs dependency with cargo add tokio --features macros,rt-multi-thread,time as we will use the asynchronous runtime. Eventually, modify your main.rs, so it looks like this:"},"2461":{"id":"/docs/introduction/getting-started-30","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Let's instantiate a new connection to the server. As the description states, Iggy does support different transport protocols such as TCP, QUIC, WebSocket and HTTP, which is entirely true. Yet remember, we want to keep things as simple as possible here, thus, we will make use of the default implementation of IggyClient struct, which wraps the underlying raw client for one of the selected transports (in our scenario, this will be TcpClient)."},"2462":{"id":"/docs/introduction/getting-started-31","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Both the default TCP client and the server use 127.0.0.1:8090. If you change the server address in core/server/config.toml, configure the client to connect to that address too."},"2463":{"id":"/docs/introduction/getting-started-32","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"We could make use of more advanced components such as ClientProvider, pass the custom configuration built via console args to choose between the different protocols as all the available clients implement the same Client trait and so on."},"2464":{"id":"/docs/introduction/getting-started-33","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"If you're eager to find out how to build more advanced (and configurable) applications, check the Rust examples. Nevertheless, let's focus on implementing our producer side :)"},"2465":{"id":"/docs/introduction/getting-started-34","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Next, we need to authenticate the user, as all the available actions (except the ping and login) require the user to be authenticated and have the appropriate permissions e.g. you might be able to send or poll the messages, but you won't be able to create the stream or topic. For the sake of simplicity, we will use the development credentials for the root user (username: iggy, password: iggy), that can do anything and cannot be deleted. These credentials exist only because we started the server with them (the Docker env vars or the --with-default-root-credentials flag above). A server booted without them generates a random root password and prints it once to the logs. You can easily create more users and assign the specific permissions to them, however, this is out of scope for this tutorial."},"2466":{"id":"/docs/introduction/getting-started-35","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"When you start the application now, by running cargo r --bin producer it will execute immediately, however, you should be able to see the logs on Iggy server - connection should be accepted, user logged in, and then connection should be closed right away, meaning that we've just established our very first communication with the streaming server."},"2467":{"id":"/docs/introduction/getting-started-36","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Before we will move on with the code, let's include some logging in our apps as well (Iggy client already has some logging in place on different levels). Let's make use of the tracing.rs crates: cargo add tracing and cargo add tracing-subscriber --features env-filter."},"2468":{"id":"/docs/introduction/getting-started-37","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Initialize the tracing subscriber at the beginning of main(), using RUST_LOG when set and info otherwise:"},"2469":{"id":"/docs/introduction/getting-started-38","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"From that point on, when starting the application, you should be able to see at least the basic logs, for example regarding the connection status. Keep in mind, that you can change the default log level by setting RUST_LOG environment variable, e.g. export RUST_LOG=trace (or other command depending on OS)."},"2470":{"id":"/docs/introduction/getting-started-39","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"So far, so good, however, before we will be able to publish any messages to our streaming server, at first, we need to create the stream, topic and partition(s) - if you're unfamiliar with these concepts, please refer to concepts where all of them are described in-depth."},"2471":{"id":"/docs/introduction/getting-started-40","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Since our IggyClient implements the common Client trait, you can find lots of the different methods to interact with the server, also from the administrative point of view, e.g. creating the streams, topics etc."},"2472":{"id":"/docs/introduction/getting-started-41","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"These methods are not idempotent - for example, if you were to try creating the stream with the same name which already exists on the server, you would receive the specific error. In such a case, handle the specific already-exists error and propagate other failures. When creating a stream, we only provide its name - the server assigns the numeric ID automatically. Stream, topic and partition IDs are all assigned starting from 0. Let's do this then :)"},"2473":{"id":"/docs/introduction/getting-started-42","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Optional fields of TopicCreateOptions left as None resolve to the server defaults. The durability and consumer_offset_durability fields use Durability::Replicated or Durability::Persisted and default independently to Replicated. They select the completion guarantee for messages and explicit offset changes. Segment size and the flush thresholds (messages_required_to_save, size_of_messages_required_to_save) are separate creation options. See Durability."},"2474":{"id":"/docs/introduction/getting-started-43","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Finally, let's send some messages into our stream. We will implement the basic loop with an interval between each iteration to simulate publishing the batch of messages. Since the streaming server works directly with the binary data, and couldn't care less about the (de)serialization format for the message payload, it's really up to you, how to efficiently stream the messages for your use case."},"2475":{"id":"/docs/introduction/getting-started-44","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"In our example, we will simply use the string payload, and pass it via from_str trait to construct the IggyMessage."},"2476":{"id":"/docs/introduction/getting-started-45","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Next, we need to call the appropriate method to send the messages to the server:"},"2477":{"id":"/docs/introduction/getting-started-46","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"As you might've already noticed, there are quite a few fields to be assigned. While some of them should be rather self-descriptive, let's discuss the identifier (created implicitly by using TryFrom on top of STREAM_NAME and TOPIC_NAME) and the partitioning which might be a little bit confusing at first, starting with the former."},"2478":{"id":"/docs/introduction/getting-started-47","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Whenever we interact with the streaming server in terms of e.g. sending or polling the messages, managing the streams, topics etc. we need to provide the unique identifier of the stream and the topic that we want to use. Since each stream and topic have a unique numeric ID, as well as a unique name, we can use either of them. Use Identifier::named() to force a name, or Identifier::numeric() for a numeric ID. TryFrom<&str> interprets a string that parses as a u32 as a numeric ID; other strings, including the names in this sample, become named identifiers. It's up to your preference if you'd rather work with the identifier being a number or string when building your applications."},"2479":{"id":"/docs/introduction/getting-started-48","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Next, let's move onto the partitioning field:"},"2480":{"id":"/docs/introduction/getting-started-49","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"In our scenario, we simply make use of PartitioningKind::PartitionId (by invoking the helper method partition_id()) meaning that we want to send the messages to the specified partition ID - in that case, the length will be 4 bytes (as the partition ID is of type u32), and the value will be the actual partition ID encoded as the bytes array."},"2481":{"id":"/docs/introduction/getting-started-50","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"However, once your system grows, you might want to parallelize the messages across the independent consumers, in order to achieve the horizontal scaling, higher resiliency etc. In that case, you might consider using either PartitioningKind::Balanced (the SDK picks the next partition using a client-local round-robin e.g. 0->1->2->0->1->2 etc.) or PartitioningKind::MessagesKey instead (e.g. by invoking one of the helper methods messages_key()), where the value wouldn't be a partition ID anymore (the SDK hashes the provided value with xxHash32 modulo the partition count), but, as the name states, some kind of identifier, which is unique for all the messages that should have guaranteed ordering. The HTTP API instead sends the chosen strategy to the server, which resolves it at admission."},"2482":{"id":"/docs/introduction/getting-started-51","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"For example, given that you process the set of messages related to the specific order ID (e.g. created, confirmed, paid, delivered etc.), you could use that as a key value to ensure that all the messages which are part of the specific workflow, will be put onto the same partition while the partition count and partitioning strategy stay unchanged. The value of the key can be anything (e.g. string, number) with the maximum length of 255 bytes."},"2483":{"id":"/docs/introduction/getting-started-52","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Anyway, let's get back to our scenario, and consider the following code responsible for publishing the messages:"},"2484":{"id":"/docs/introduction/getting-started-53","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"The mutable slice lets IggyClient encrypt message payloads and user headers in place when client-side encryption is enabled."},"2485":{"id":"/docs/introduction/getting-started-54","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Finally, let's complete the implementation of the producer - once you start the application after the latest changes, you shall see the messages being sent to the newly created stream."},"2486":{"id":"/docs/introduction/getting-started-55","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"The consumer part will be rather easy to implement. Just like on the producer side, we want to make use of the asynchronous runtime, logging and last but not least, the same Client trait. Let's find out, how we can make use of the poll_messages method, to fetch the messages from the stream. Consider the following code:"},"2487":{"id":"/docs/introduction/getting-started-56","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"At the first glance, it might look a bit more complicated than send_messages function, so let's discuss the fields one by one:"},"2488":{"id":"/docs/introduction/getting-started-57","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"stream_id - the ID of the stream (numeric or string) from which we want to poll the messages."},"2489":{"id":"/docs/introduction/getting-started-58","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"topic_id - the ID of the topic (numeric or string) from which we want to poll the messages."},"2490":{"id":"/docs/introduction/getting-started-59","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"partition_id - the ID of the partition from which we want to poll the messages. Specify the partition for a regular Consumer. For a joined ConsumerGroup, pass None to let the SDK select a partition from the assignments it synchronizes with the server. An explicit partition is also accepted, but the server checks that the member owns it."},"2491":{"id":"/docs/introduction/getting-started-60","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"consumer - the type of the consumer (kind + ID), either the default Consumer means the standalone client which does the message polling on its own, independently of the other consumers (unless they would use the same ID), or the ConsumerGroup which might be used to create the group of consumers sharing the common identifier - this is especially useful in the case of the horizontal scaling, where we want to ensure, that the same (and only one) consumer, will poll the messages from the specific partition, and there will be no overlap with the other consumers from the same group. For example, when scaling out (by adding more instances) the group of payment processing microservices, we probably don't want the multiple instances to process the same payment. Group assignment coordinates polling, but application side effects still need idempotency across retries and rebalances."},"2492":{"id":"/docs/introduction/getting-started-61","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"strategy - the way in which we want to poll the messages. The default one being Offset (underlying PollingKind enum) means that we will start polling the messages from the particular offset provided in the value field - it's on the client, to keep track of the most recent offset. On the other hand, we could also use the different kind, for example Next, which means, that the next messages will be returned to the client, depending on the so-called consumer offset value stored on the server side. The client may not need to track the offset on its own anymore, but instead, call store_consumer_offset() to save it on the server (e.g. after each processed message or the whole batch), or use auto_commit: true for server-managed offset advancement. Auto-commit is best-effort: a poll does not wait for the offset to commit, and a follower-served poll does not replicate it. Messages can be replayed after failure. The offset can also advance before the application processes the response, so use an explicit offset store after processing when that distinction matters."},"2493":{"id":"/docs/introduction/getting-started-62","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"count - amount of the messages that the consumer would like to receive in the single response from the server."},"2494":{"id":"/docs/introduction/getting-started-63","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"auto_commit - whether to request server-managed offset advancement when messages are fetched, with the best-effort behavior described above."},"2495":{"id":"/docs/introduction/getting-started-64","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"Next, let's take a look at the following method responsible for polling the messages based on the specified interval."},"2496":{"id":"/docs/introduction/getting-started-65","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"And here's the final code for our consumer application:"},"2497":{"id":"/docs/introduction/getting-started-66","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"Start the Iggy server, and then producer and consumer applications respectively - you should observe your messages being streamed flawlessly :)"},"2498":{"id":"/docs/introduction/getting-started-67","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#running-it-again-and-cleaning-up","content":"Both applications are safe to run a second time, but the result may surprise you."},"2499":{"id":"/docs/introduction/getting-started-68","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#running-it-again-and-cleaning-up","content":"The producer finds the stream and topic already there, says so, and appends another set of messages rather than failing. The consumer starts from offset 0 every time, so a second run replays the messages from the first one as well as the new ones."},"2500":{"id":"/docs/introduction/getting-started-69","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#running-it-again-and-cleaning-up","content":"To start over with an empty server, stop it and clear its data:"},"2501":{"id":"/docs/introduction/getting-started-70","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#running-it-again-and-cleaning-up","content":"Docker: the --rm in the command above removes the container when you stop it with Ctrl-C, so the next docker run starts empty."},"2502":{"id":"/docs/introduction/getting-started-71","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#running-it-again-and-cleaning-up","content":"From source: stop the server with Ctrl-C, then start it again with --fresh, which wipes the data directory first. To remove that data without starting the server, delete the local_data directory in the working directory you ran it from."},"2503":{"id":"/docs/introduction/getting-started-72","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#summary","content":"What we've just achieved is merely the tip of an iceberg, however, it should give you a good understanding of what Iggy is all about, and hopefully, it wasn't too difficult to follow and get things up and running for the first time. Feel free to take a look at the more advanced examples, how to make use of IggyClient wrapper on top of the existing implementations of the Client trait, what happens when you start multiple producers and consumers and so on. Happy tweaking! :)"},"2504":{"id":"/docs/introduction/glossary","page_id":"/docs/introduction/glossary","type":"page","content":"Glossary","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/glossary"},"2505":{"id":"/docs/introduction/glossary-0","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Short definitions of the terms used across the Apache Iggy docs, with links to where each one is explained."},"2506":{"id":"/docs/introduction/glossary-1","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"A one-line definition of each term, with a link to the page that explains it."},"2507":{"id":"/docs/introduction/glossary-2","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Append-only log. An ordered list of messages that only grows at the end. Messages can't be changed once written, and you can read from any earlier point to replay them. See Concepts."},"2508":{"id":"/docs/introduction/glossary-3","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Auto-commit. An option on a poll. The server saves the consumer's position as it returns the messages, before the consumer has processed them. See Polling messages."},"2509":{"id":"/docs/introduction/glossary-4","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Connection string. A single value such as iggy://user:password@localhost:8090 that tells a client how to connect. The Rust SDK and the SDKs that wrap it (Python, C++ and PHP) accept one. See Connection strings."},"2510":{"id":"/docs/introduction/glossary-5","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Consumer. A client that reads messages on its own rather than as part of a consumer group. Its position is kept separately from every other consumer's."},"2511":{"id":"/docs/introduction/glossary-6","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Consumer group. A set of consumers that share a topic's partitions, with each partition read by one member at a time. See Consumer groups."},"2512":{"id":"/docs/introduction/glossary-7","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Durability. A topic setting, replicated or persisted, that decides what must be done before a write is reported as successful. See Durability."},"2513":{"id":"/docs/introduction/glossary-8","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Offset. The position of a message within a partition, starting at 0. See Concepts."},"2514":{"id":"/docs/introduction/glossary-9","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Partition. Where a topic's messages are actually stored. A topic's messages are spread across its partitions. See Partition."},"2515":{"id":"/docs/introduction/glossary-10","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Partitioning. How a producer picks the partition for a message: a fixed partition, round robin, or a hash of a message key. See Getting started."},"2516":{"id":"/docs/introduction/glossary-11","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Payload. The body of a message. The server stores it as bytes without interpreting it, so the format is up to you. See Serialising messages."},"2517":{"id":"/docs/introduction/glossary-12","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Personal access token. A token you create on the server and use in place of a username and password, for example in a scraper or a script. See Connection strings."},"2518":{"id":"/docs/introduction/glossary-13","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Primary and replica. In a cluster, the primary orders writes and the replicas copy them. If the primary fails, the replicas elect a new one. See Viewstamped Replication."},"2519":{"id":"/docs/introduction/glossary-14","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Retention policy. Topic settings that delete old messages by age or by size. See Topic options."},"2520":{"id":"/docs/introduction/glossary-15","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Segment. Part of a partition, stored on disk as a data file and an index file. Retention deletes old segments whole. See Segment."},"2521":{"id":"/docs/introduction/glossary-16","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Shard. One thread in the server that owns a set of partitions. See Architecture."},"2522":{"id":"/docs/introduction/glossary-17","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Stream. A container for related topics. For example, a dev stream and a production stream can each have their own orders topic. See Stream."},"2523":{"id":"/docs/introduction/glossary-18","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"Topic. A named set of partitions for one kind of message, such as orders or user events. See Topic."},"2524":{"id":"/docs/introduction/glossary-19","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"User headers. Optional key and value pairs sent with a message, kept separate from the payload. See Serialising messages."},"2525":{"id":"/docs/introduction/glossary-20","page_id":"/docs/introduction/glossary","tags":[],"type":"text","url":"/docs/introduction/glossary","content":"VSR. Viewstamped Replication, the protocol Apache Iggy uses to keep replicas in step. See Viewstamped Replication."},"2526":{"id":"/docs/introduction/quickstart","page_id":"/docs/introduction/quickstart","type":"page","content":"Quickstart","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/quickstart"},"2527":{"id":"/docs/introduction/quickstart-0","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart","content":"Run the Iggy server and send and receive your first message with the Rust SDK, in one file."},"2528":{"id":"/docs/introduction/quickstart-1","page_id":"/docs/introduction/quickstart","type":"heading","tags":[],"url":"/docs/introduction/quickstart#start-the-server","content":"Start the server"},"2529":{"id":"/docs/introduction/quickstart-2","page_id":"/docs/introduction/quickstart","type":"heading","tags":[],"url":"/docs/introduction/quickstart#send-and-receive-a-message","content":"Send and receive a message"},"2530":{"id":"/docs/introduction/quickstart-3","page_id":"/docs/introduction/quickstart","type":"heading","tags":[],"url":"/docs/introduction/quickstart#next-steps","content":"Next steps"},"2531":{"id":"/docs/introduction/quickstart-4","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart","content":"This page gets a server running and a message sent and received, in one file. To build separate producer and consumer applications step by step, see Getting started. For other languages, see the SDK section."},"2532":{"id":"/docs/introduction/quickstart-5","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart","content":"On Linux the server needs kernel 5.19 or newer. macOS has no kernel requirement, but Docker Desktop on 0.9.0 needs one extra setting. See System requirements."},"2533":{"id":"/docs/introduction/quickstart-6","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart#start-the-server","content":"See Docker & Helm for what each option does."},"2534":{"id":"/docs/introduction/quickstart-7","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart#send-and-receive-a-message","content":"Create a project and add the SDK and the async runtime:"},"2535":{"id":"/docs/introduction/quickstart-8","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart#send-and-receive-a-message","content":"Replace src/main.rs with:"},"2536":{"id":"/docs/introduction/quickstart-9","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart#send-and-receive-a-message","content":"Run it with cargo run. Partition IDs are 0-based, so the first partition of a topic is partition 0."},"2537":{"id":"/docs/introduction/quickstart-10","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart#next-steps","content":"Build a producer and a consumer as two applications: Getting started."},"2538":{"id":"/docs/introduction/quickstart-11","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart#next-steps","content":"Use the producer and consumer builders with batching and offset management: High-level SDK."},"2539":{"id":"/docs/introduction/quickstart-12","page_id":"/docs/introduction/quickstart","tags":[],"type":"text","url":"/docs/introduction/quickstart#next-steps","content":"Use another language: SDK section."},"2540":{"id":"/docs/introduction/serialising-messages","page_id":"/docs/introduction/serialising-messages","type":"page","content":"Serialising messages","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/serialising-messages"},"2541":{"id":"/docs/introduction/serialising-messages-0","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages","content":"Choose a format for your message payloads, and send more than one kind of message to the same topic."},"2542":{"id":"/docs/introduction/serialising-messages-1","page_id":"/docs/introduction/serialising-messages","type":"heading","tags":[],"url":"/docs/introduction/serialising-messages#one-kind-of-message","content":"One kind of message"},"2543":{"id":"/docs/introduction/serialising-messages-2","page_id":"/docs/introduction/serialising-messages","type":"heading","tags":[],"url":"/docs/introduction/serialising-messages#a-type-field-in-the-payload","content":"A type field in the payload"},"2544":{"id":"/docs/introduction/serialising-messages-3","page_id":"/docs/introduction/serialising-messages","type":"heading","tags":[],"url":"/docs/introduction/serialising-messages#a-type-field-in-a-header","content":"A type field in a header"},"2545":{"id":"/docs/introduction/serialising-messages-4","page_id":"/docs/introduction/serialising-messages","type":"heading","tags":[],"url":"/docs/introduction/serialising-messages#size-limits","content":"Size limits"},"2546":{"id":"/docs/introduction/serialising-messages-5","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages","content":"The server stores each message payload as bytes without interpreting it, so you choose the format: plain text, JSON, Protobuf or anything else. This page shows how to send more than one kind of message to the same topic, so the consumer knows how to decode each one."},"2547":{"id":"/docs/introduction/serialising-messages-6","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages","content":"The examples are in Rust and come from the examples in the Apache Iggy repository."},"2548":{"id":"/docs/introduction/serialising-messages-7","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages#one-kind-of-message","content":"If every message on a topic has the same shape, send the encoded value as the payload and decode it the same way on the other side. Getting started does this with plain strings."},"2549":{"id":"/docs/introduction/serialising-messages-8","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages#a-type-field-in-the-payload","content":"Wrap each message in an envelope that names its type, and send the envelope as JSON:"},"2550":{"id":"/docs/introduction/serialising-messages-9","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages#a-type-field-in-the-payload","content":"The consumer decodes the envelope, reads message_type, then decodes the inner payload as that type. This works with any client, but every message is decoded twice, and the inner payload is a JSON string inside the envelope. See the message-envelope example."},"2551":{"id":"/docs/introduction/serialising-messages-10","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages#a-type-field-in-a-header","content":"Messages can carry user headers, which are key and value pairs kept separate from the payload. Put the type in a header and send the payload as it is:"},"2552":{"id":"/docs/introduction/serialising-messages-11","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages#a-type-field-in-a-header","content":"The consumer reads the header and decodes the payload once:"},"2553":{"id":"/docs/introduction/serialising-messages-12","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages#a-type-field-in-a-header","content":"This is the better choice for Protobuf or any other binary format, because the payload doesn't have to fit inside JSON. See the message-type example."},"2554":{"id":"/docs/introduction/serialising-messages-13","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages#a-type-field-in-a-header","content":"Header values don't have to be strings. They can also be numbers, booleans or raw bytes, so you can add things like a trace ID next to the type, as the typed-headers example shows. The message-compression example uses a header in the same way to record how the payload was compressed."},"2555":{"id":"/docs/introduction/serialising-messages-14","page_id":"/docs/introduction/serialising-messages","tags":[],"type":"text","url":"/docs/introduction/serialising-messages#size-limits","content":"A payload can be up to 64 MB, and a message's user headers up to 100 KB in total. The whole send request also has to fit the server's request limit, which by default is 64 MiB over TCP and 2 MB over HTTP."},"2556":{"id":"/docs/sdk/connection-strings","page_id":"/docs/sdk/connection-strings","type":"page","content":"Connection Strings","breadcrumbs":["Documentation","SDK"],"tags":[],"url":"/docs/sdk/connection-strings"},"2557":{"id":"/docs/sdk/connection-strings-0","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings","content":"The canonical reference for Iggy connection strings, covering every scheme, credential form and option."},"2558":{"id":"/docs/sdk/connection-strings-1","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#format","content":"Format"},"2559":{"id":"/docs/sdk/connection-strings-2","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#transport-selection","content":"Transport selection"},"2560":{"id":"/docs/sdk/connection-strings-3","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#credentials","content":"Credentials"},"2561":{"id":"/docs/sdk/connection-strings-4","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#duration-values","content":"Duration values"},"2562":{"id":"/docs/sdk/connection-strings-5","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#tcp-options","content":"TCP options"},"2563":{"id":"/docs/sdk/connection-strings-6","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#quic-options","content":"QUIC options"},"2564":{"id":"/docs/sdk/connection-strings-7","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#websocket-options","content":"WebSocket options"},"2565":{"id":"/docs/sdk/connection-strings-8","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#http-options","content":"HTTP options"},"2566":{"id":"/docs/sdk/connection-strings-9","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#usage","content":"Usage"},"2567":{"id":"/docs/sdk/connection-strings-10","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings","content":"A connection string configures an Iggy client in a single line: transport, credentials, server address, and options. This page is the canonical reference for every scheme, credential form, and option key."},"2568":{"id":"/docs/sdk/connection-strings-11","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings","content":"Connection strings are supported by the Rust SDK and the SDKs that wrap it (Python, C++, PHP)."},"2569":{"id":"/docs/sdk/connection-strings-12","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#format","content":"The host and port are always required. Use a hostname or IPv4 address. The parser rejects IPv6 forms such as [::1]:8090. Options are appended as key=value pairs separated by &. Scheme names and option keys are case-sensitive."},"2570":{"id":"/docs/sdk/connection-strings-13","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#format","content":"The parser does not percent-decode credentials or option values. Reserved separators such as : and @ cannot be escaped inside a username or password; use a PAT for credentials that contain them. Duplicate option keys use the last value. Boolean options enable only for the literal true; use false to disable them."},"2571":{"id":"/docs/sdk/connection-strings-14","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#format","content":"Unknown option keys are hard errors. The parser rejects the whole string with InvalidConnectionString instead of ignoring the key, so a typo fails fast rather than silently falling back to a default."},"2572":{"id":"/docs/sdk/connection-strings-15","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"The scheme picks the transport. Each transport has its own default server port:"},"2573":{"id":"/docs/sdk/connection-strings-16","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"Scheme"},"2574":{"id":"/docs/sdk/connection-strings-17","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"Transport"},"2575":{"id":"/docs/sdk/connection-strings-18","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"Default server port"},"2576":{"id":"/docs/sdk/connection-strings-19","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"iggy://"},"2577":{"id":"/docs/sdk/connection-strings-20","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"TCP (default)"},"2578":{"id":"/docs/sdk/connection-strings-21","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"8090"},"2579":{"id":"/docs/sdk/connection-strings-22","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"iggy+tcp://"},"2580":{"id":"/docs/sdk/connection-strings-23","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"TCP"},"2581":{"id":"/docs/sdk/connection-strings-24","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"8090"},"2582":{"id":"/docs/sdk/connection-strings-25","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"iggy+quic://"},"2583":{"id":"/docs/sdk/connection-strings-26","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"QUIC"},"2584":{"id":"/docs/sdk/connection-strings-27","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"8080"},"2585":{"id":"/docs/sdk/connection-strings-28","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"iggy+http://"},"2586":{"id":"/docs/sdk/connection-strings-29","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"HTTP"},"2587":{"id":"/docs/sdk/connection-strings-30","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"3000"},"2588":{"id":"/docs/sdk/connection-strings-31","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"iggy+ws://"},"2589":{"id":"/docs/sdk/connection-strings-32","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"WebSocket"},"2590":{"id":"/docs/sdk/connection-strings-33","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#transport-selection","content":"8092"},"2591":{"id":"/docs/sdk/connection-strings-34","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#credentials","content":"Two forms are accepted:"},"2592":{"id":"/docs/sdk/connection-strings-35","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#credentials","content":"Username and password, separated by a colon. Both parts must be non-empty:"},"2593":{"id":"/docs/sdk/connection-strings-36","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#credentials","content":"Personal Access Token: any credential without a colon is treated as a PAT. Server-minted tokens are plain base64 strings with no prefix, so paste the token exactly as the server returned it:"},"2594":{"id":"/docs/sdk/connection-strings-37","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#credentials","content":"Do not prepend anything to the token. Strings like iggypat-... appear only in Iggy's own test code. A real token with a prefix added will fail to log in."},"2595":{"id":"/docs/sdk/connection-strings-38","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#credentials","content":"The examples use iggy/iggy. For a new local development instance, with no IGGY_ROOT_USERNAME or IGGY_ROOT_PASSWORD overrides, use:"},"2596":{"id":"/docs/sdk/connection-strings-39","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#credentials","content":"The environment takes precedence over the flag. Stored or recovered root credentials are not replaced by bootstrap settings. --fresh deletes this replica's local data; in a cluster it can recover committed state, including credentials, from another replica. Use this reset only for disposable development data. A new standalone server without explicit credentials generates a root password; a new cluster requires explicit root credentials."},"2597":{"id":"/docs/sdk/connection-strings-40","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#credentials","content":"TCP, QUIC, and WebSocket apply connection-string credentials during connect(). HTTP requires an explicit login, as described below."},"2598":{"id":"/docs/sdk/connection-strings-41","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#duration-values","content":"Options typed as durations take human-readable values such as 5s, 500ms, or 1m, unless a table below says the value is a plain number. Heartbeat and reconnection intervals must be greater than zero; the reconnection cooldown can be zero."},"2599":{"id":"/docs/sdk/connection-strings-42","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings#tcp-options","content":"Key"},"2600":{"id":"/docs/sdk/connection-strings-43","page_id":