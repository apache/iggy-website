d":"/docs/connectors/sinks/quickwit","page_id":"/docs/connectors/sinks/quickwit","type":"page","content":"Quickwit Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/quickwit"},"4458":{"id":"/docs/connectors/sinks/quickwit-0","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit","content":"Send messages from Iggy streams to a Quickwit index over HTTP, creating the index when it does not exist."},"4459":{"id":"/docs/connectors/sinks/quickwit-1","page_id":"/docs/connectors/sinks/quickwit","type":"heading","tags":[],"url":"/docs/connectors/sinks/quickwit#configuration","content":"Configuration"},"4460":{"id":"/docs/connectors/sinks/quickwit-2","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit","content":"The Quickwit connector allows you to send data to the Quickwit API using HTTP. This sink will ensure that the index exists (create it if it doesn't) and will append the data to the index using the same batch size as specified in the Iggy configuration."},"4461":{"id":"/docs/connectors/sinks/quickwit-3","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"url: The URL of the Quickwit server."},"4462":{"id":"/docs/connectors/sinks/quickwit-4","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"index: The index configuration using YAML, as described in the Quickwit index configuration docs"},"4463":{"id":"/docs/connectors/sinks/s3","page_id":"/docs/connectors/sinks/s3","type":"page","content":"S3 Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/s3"},"4464":{"id":"/docs/connectors/sinks/s3-0","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3","content":"Write messag