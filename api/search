iguration-639","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#node","content":"advertised_address"},"4258":{"id":"/docs/server/configuration-640","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#node","content":"unset"},"4259":{"id":"/docs/server/configuration-641","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#node","content":"The address clients dial, published in cluster metadata. A literal IP or a DNS hostname. Left unset, the server derives it from the bind address of the first enabled listener. That fails when the listener binds a wildcard, and the server refuses to start rather than publish an address no client can use. Declaring the unspecified address (0.0.0.0, ::) is refused for the same reason."},"4260":{"id":"/docs/server/configuration-642","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Cluster mode is configured here but documented in Clustering. The section contains:"},"4261":{"id":"/docs/server/configuration-643","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Key"},"4262":{"id":"/docs/server/configuration-644","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Default"},"4263":{"id":"/docs/server/configuration-645","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"One-liner"},"4264":{"id":"/docs/server/configuration-646","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"enabled"},"4265":{"id":"/docs/server/configuration-647","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"false"},"4266":{"id":"/docs/server/configuration-648","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Participate in a cluster. Requires --replica-id at launch."},"4267":{"id":"/docs/server/configuration-649","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"name"},"4268":{"id":"/docs/server/configuration-650","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"iggy-cluster\""},"4269":{"id":"/docs/server/configuration-651","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Permanent cluster identity, hashed into every superblock on first boot. Renaming against existing data refuses start."},"4270":{"id":"/docs/server/configuration-652","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"heartbeat_timeout"},"4271":{"id":"/docs/server/configuration-653","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"5s\""},"4272":{"id":"/docs/server/configuration-654","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Primary liveness window. A silent primary triggers a view change. At least \"2s\" and at least 4 x commit_broadcast_interval."},"4273":{"id":"/docs/server/configuration-655","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"commit_broadcast_interval"},"4274":{"id":"/docs/server/configuration-656","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"500ms\""},"4275":{"id":"/docs/server/configuration-657","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"How often the primary broadcasts its commit point. This is the liveness signal."},"4276":{"id":"/docs/server/configuration-658","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"prepare_retransmit_interval"},"4277":{"id":"/docs/server/configuration-659","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"250ms\""},"4278":{"id":"/docs/server/configuration-660","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Retransmit cadence for unacknowledged prepares."},"4279":{"id":"/docs/server/configuration-661","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"view_change_retransmit_interval"},"4280":{"id":"/docs/server/configuration-662","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"500ms\""},"4281":{"id":"/docs/server/configuration-663","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Retransmit cadence during a view change."},"4282":{"id":"/docs/server/configuration-664","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"view_change_status_timeout"},"4283":{"id":"/docs/server/configuration-665","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"5s\""},"4284":{"id":"/docs/server/configuration-666","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Backstop for a stalled view change. Escalates to a fresh election. At least 4 x view_change_retransmit_interval."},"4285":{"id":"/docs/server/configuration-667","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"request_start_view_retransmit_interval"},"4286":{"id":"/docs/server/configuration-668","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"1s\""},"4287":{"id":"/docs/server/configuration-669","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Re-request cadence for the current view's StartView."},"4288":{"id":"/docs/server/configuration-670","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"view_probe_attempts_max"},"4289":{"id":"/docs/server/configuration-671","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"5"},"4290":{"id":"/docs/server/configuration-672","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Unanswered probes a recovering replica tolerates before electing on its recovered log. Between 1 and 100."},"4291":{"id":"/docs/server/configuration-673","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"repair_retry_interval"},"4292":{"id":"/docs/server/configuration-674","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"1s\""},"4293":{"id":"/docs/server/configuration-675","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Re-request cadence for a stalled journal-repair stream."},"4294":{"id":"/docs/server/configuration-676","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"repair_gap_debounce_interval"},"4295":{"id":"/docs/server/configuration-677","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"1s\""},"4296":{"id":"/docs/server/configuration-678","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"How long a committed journal gap waits before repair starts, floored at 500 ms. Nonzero. Separate from retries of an already-open repair stream."},"4297":{"id":"/docs/server/configuration-679","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"repair_chunk_max"},"4298":{"id":"/docs/server/configuration-680","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"128"},"4299":{"id":"/docs/server/configuration-681","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Prepares served per repair round. Must stay strictly below message_bus.peer_queue_capacity. Between 1 and 1024."},"4300":{"id":"/docs/server/configuration-682","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"superblock_wedged_fatal_timeout"},"4301":{"id":"/docs/server/configuration-683","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"2m\""},"4302":{"id":"/docs/server/configuration-684","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Exit if a metadata or partition superblock remains unwritable past this window. \"0\" leaves it fenced indefinitely. Nonzero values must be at least \"30s\"."},"4303":{"id":"/docs/server/configuration-685","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"default_replication_factor"},"4304":{"id":"/docs/server/configuration-686","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"all\""},"4305":{"id":"/docs/server/configuration-687","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Copies per partition for new topics that omit replication_factor. Accepts all or 1 through 32, within cluster membership."},"4306":{"id":"/docs/server/configuration-688","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Durations are rounded down to the consensus 10 ms tick. Values under 10 ms become one tick."},"4307":{"id":"/docs/server/configuration-689","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Sub-sections:"},"4308":{"id":"/docs/server/configuration-690","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"[cluster.auth]: replica-to-replica authentication (PSK plus BLAKE3 keyed-MAC handshake). shared_secret must be at least 32 bytes of CSPRNG output, identical on every node. Prefer IGGY_CLUSTER_AUTH_SHARED_SECRET. previous_shared_secret enables rolling key rotation."},"4309":{"id":"/docs/server/configuration-691","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"[cluster.coordinator]: skip_shard_zero_for_replicas = true and skip_shard_zero_for_clients = false control connection placement when more than one shard runs. replica_connections_per_peer = 1 controls links per peer and must match on every node."},"4310":{"id":"/docs/server/configuration-692","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"[cluster.tls]: TLS 1.3 on the replica port. Requires cluster.auth.enabled. The PSK authenticates the peer, TLS supplies confidentiality."},"4311":{"id":"/docs/server/configuration-693","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"[[cluster.nodes]]: the full roster, byte-identical on every node. Each entry has name, ip, replica_id, and ports (tcp, quic, http, websocket, tcp_replica). In cluster mode ports is the single source of listener ports: tcp and tcp_replica ports are always required, and every other enabled transport also needs an explicit per-node port or the server refuses to start. advertised_address and per-CIDR advertised_addresses selectors control what clients are told to dial."},"4312":{"id":"/docs/server/docker","page_id":"/docs/server/docker","type":"page","content":"Docker & Helm","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/docker"},"4313":{"id":"/docs/server/docker-0","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker","content":"Run the Iggy server from the official Docker images, and deploy it with the Helm chart."},"4314":{"id":"/docs/server/docker-1","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#docker","content":"Docker"},"4315":{"id":"/docs/server/docker-2","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#why-these-capabilities","content":"Why these capabilities?"},"4316":{"id":"/docs/server/docker-3","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#available-images","content":"Available images"},"4317":{"id":"/docs/server/docker-4","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#building-from-source","content":"Building from source"},"4318":{"id":"/docs/server/docker-5","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#running-the-cli-inside-the-container","content":"Running the CLI inside the container"},"4319":{"id":"/docs/server/docker-6","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#helm-charts","content":"Helm charts"},"4320":{"id":"/docs/server/docker-7","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#quick-start","content":"Quick start"},"4321":{"id":"/docs/server/docker-8","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#chart-components","content":"Chart components"},"4322":{"id":"/docs/server/docker-9","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#key-values","content":"Key values"},"4323":{"id":"/docs/server/docker-10","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#local-source-image","content":"Local source image"},"4324":{"id":"/docs/server/docker-11","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"You can easily run the Iggy server with Docker - the official images can be found here, use docker pull apache/iggy:0.10.0, or apache/iggy:latest for the newest stable release."},"4325":{"id":"/docs/server/docker-12","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"These properties of the published image matter for deployment:"},"4326":{"id":"/docs/server/docker-13","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"The working directory is /app and the iggy-server and iggy binaries are on PATH (/usr/local/bin). The default data directory local_data therefore resolves to /app/local_data - mount your volume there, or set IGGY_PATH and mount that path instead."},"4327":{"id":"/docs/server/docker-14","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"The image bakes in no address overrides, so the server binds the loopback defaults (127.0.0.1) and is unreachable from outside the container even with published ports. Set IGGY_TCP_ADDRESS=0.0.0.0:8090 (and the equivalent for every other transport you expose) alongside the -p flags."},"4328":{"id":"/docs/server/docker-15","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"The wildcard says nothing about where clients reach the container, so the server refuses to start until IGGY_NODE_ADVERTISED_ADDRESS supplies that address. Use localhost when the ports are published to the host, the compose service name when the clients are containers on the same network, and the external hostname or load balancer name when they are further away. The value reaches clients through cluster metadata, where it is the endpoint they reconnect through."},"4329":{"id":"/docs/server/docker-16","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"Below is an example docker-compose.yml which overrides the default configuration (see Configuration) with environment variables. If you prefer using the configuration file, you can mount it as a volume and provide the path to it with the IGGY_CONFIG_PATH environment variable."},"4330":{"id":"/docs/server/docker-17","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"The examples use a permissive syscall profile and unlimited locked memory for development. Production deployments can use a custom seccomp profile and a finite locked-memory budget that permit the server's required operations. See Linux tuning."},"4331":{"id":"/docs/server/docker-18","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"Or when running with docker run:"},"4332":{"id":"/docs/server/docker-19","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#why-these-capabilities","content":"SYS_NICE broadens scheduling and NUMA permissions. Pinning a thread owned by the process with sched_setaffinity does not by itself require this capability. Container policies can impose additional restrictions. See Linux affinity permissions."},"4333":{"id":"/docs/server/docker-20","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#why-these-capabilities","content":"seccomp:unconfined permits io_uring calls blocked by Docker's default seccomp profile. A custom profile allowing the required syscalls is an alternative to disabling filtering. See Docker seccomp profiles."},"4334":{"id":"/docs/server/docker-21","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#why-these-capabilities","content":"memlock: -1 removes the process's locked-memory limit. A finite limit is valid if it covers the runtime's requirements. Neither setting overrides the container's memory limit."},"4335":{"id":"/docs/server/docker-22","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#why-these-capabilities","content":"Host kernel 5.19 or newer is required. Containers use the host's kernel, so these settings alone are not enough. See System requirements."},"4336":{"id":"/docs/server/docker-23","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Image"},"4337":{"id":"/docs/server/docker-24","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Description"},"4338":{"id":"/docs/server/docker-25","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"apache/iggy"},"4339":{"id":"/docs/server/docker-26","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Server + CLI"},"4340":{"id":"/docs/server/docker-27","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"apache/iggy-web-ui"},"4341":{"id":"/docs/server/docker-28","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Standalone Web UI"},"4342":{"id":"/docs/server/docker-29","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"apache/iggy-connect"},"4343":{"id":"/docs/server/docker-30","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Connectors runtime"},"4344":{"id":"/docs/server/docker-31","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"apache/iggy-mcp"},"4345":{"id":"/docs/server/docker-32","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"MCP server"},"4346":{"id":"/docs/server/docker-33","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"apache/iggy-bench-dashboard"},"4347":{"id":"/docs/server/docker-34","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Benchmark dashboard (server + WASM frontend)"},"4348":{"id":"/docs/server/docker-35","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Images tagged latest are based on stable releases. Images tagged edge are built from the latest master branch."},"4349":{"id":"/docs/server/docker-36","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#building-from-source","content":"The repository root carries its own Dockerfile and docker-compose.yml for building from source (a multi-stage build: Rust compilation including the Web UI, then a minimal runtime image):"},"4350":{"id":"/docs/server/docker-37","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#building-from-source","content":"Or use docker compose up directly from the repository root. That image differs from the published one: it sets the 0.0.0.0 address of all four listeners via ENV and keeps its data at /local_data. Those wildcards are baked into the image, so a plain docker run of it refuses to start until you pass IGGY_NODE_ADVERTISED_ADDRESS yourself. The repository's compose file publishes the ports to the host, so it declares IGGY_NODE_ADVERTISED_ADDRESS=localhost."},"4351":{"id":"/docs/server/docker-38","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#running-the-cli-inside-the-container","content":"The iggy CLI is on PATH in the official image. With the compose example above (container iggy, password Secret123):"},"4352":{"id":"/docs/server/docker-39","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#helm-charts","content":"Helm charts for Kubernetes deployment are available in the repository. Almost everything server-related nests under the server: key in values.yaml. The chart also bundles a Web UI deployment under ui:."},"4353":{"id":"/docs/server/docker-40","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"Server Deployment - runs apache/iggy with the pod security context the server needs: seccomp profile Unconfined (for io_uring) plus the IPC_LOCK capability (for memory locking). Listener addresses are set to 0.0.0.0 via server.env, and the data volume mounts at /app/local_data. The chart supplies IGGY_NODE_ADVERTISED_ADDRESS as the in-cluster Service DNS name. Override it with server.advertisedAddress when clients arrive through a LoadBalancer or an Ingress. The server image tag defaults to the chart's appVersion (0.9.0-edge.6 in this source revision). The quick start selects 0.10.0 explicitly."},"4354":{"id":"/docs/server/docker-41","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"Server Service - exposes the http (3000), quic (8080/UDP), tcp (8090), and websocket (8092) ports."},"4355":{"id":"/docs/server/docker-42","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"Web UI Deployment + Service - a separate apache/iggy-web-ui deployment on port 3050, enabled by default (ui.enabled)."},"4356":{"id":"/docs/server/docker-43","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"Secret - root user credentials from server.users.root (default iggy/changeit). Point server.users.root.existingSecret.name at your own Secret in production. usernameKey and passwordKey select its keys."},"4357":{"id":"/docs/server/docker-44","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"PersistentVolumeClaim - storage for /app/local_data, disabled by default (server.persistence.enabled), 8Gi when enabled."},"4358":{"id":"/docs/server/docker-45","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"ServiceAccount and Ingress - a shared ServiceAccount and separate optional server/UI ingresses. The chart has no HPA template. Server replicaCount must not exceed 1. Cluster mode uses one release per node, each with its own replica ID and storage."},"4359":{"id":"/docs/server/docker-46","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"ServiceMonitor - Prometheus scrape config (optional). The /metrics endpoint requires a bearer credential like every other read, so wire a token (e.g. a personal access token stored in a Secret) into server.serviceMonitor.authorization - an unauthenticated scrape gets 401."},"4360":{"id":"/docs/server/docker-47","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#key-values","content":"Save the excerpt as my-values.yaml, customize it for your environment, and deploy with:"},"4361":{"id":"/docs/server/docker-48","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#local-source-image","content":"The repository-root Dockerfile builds a local image with wildcard transport binds and IGGY_NODE_ADVERTISED_ADDRESS=localhost. The release image uses core/server/Dockerfile and its /app data path. Keep the advertised address explicit in your deployment so reconnects work from the client network. Do not infer the release image's defaults from the local development Dockerfile."},"4362":{"id":"/docs/server/durability","page_id":"/docs/server/durability","type":"page","content":"Durability","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/durability"},"4363":{"id":"/docs/server/durability-0","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability","content":"What a completed write guarantees, how to select topic durability, and what survives a single-node crash."},"4364":{"id":"/docs/server/durability-1","page_id":"/docs/server/durability","type":"heading","tags":[],"url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"Select the policy when creating the topic"},"4365":{"id":"/docs/server/durability-2","page_id":"/docs/server/durability","type":"heading","tags":[],"url":"/docs/server/durability#the-single-node-write-path","content":"The single-node write path"},"4366":{"id":"/docs/server/durability-3","page_id":"/docs/server/durability","type":"heading","tags":[],"url":"/docs/server/durability#flush-scheduling-is-separate","content":"Flush scheduling is separate"},"4367":{"id":"/docs/server/durability-4","page_id":"/docs/server/durability","type":"heading","tags":[],"url":"/docs/server/durability#what-survives-a-failure","content":"What survives a failure"},"4368":{"id":"/docs/server/durability-5","page_id":"/docs/server/durability","type":"heading","tags":[],"url":"/docs/server/durability#which-responses-prove-completion","content":"Which responses prove completion"},"4369":{"id":"/docs/server/durability-6","page_id":"/docs/server/durability","type":"heading","tags":[],"url":"/docs/server/durability#recovery-and-cost","content":"Recovery and cost"},"4370":{"id":"/docs/server/durability-7","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability","content":"A successful write has the guarantee selected by the topic's durability option. The default, replicated, waits for consensus commit and local application without an additional stable-storage barrier. persisted also requires a recoverable copy on stable storage at the replication quorum."},"4371":{"id":"/docs/server/durability-8","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability","content":"Both policies write data to disk. The difference is what must have completed before the server reports success. On a single node the quorum is one, so replicated provides no second copy and can acknowledge messages that exist only in the server process's memory. For multiple replicas, see Cluster Durability."},"4372":{"id":"/docs/server/durability-9","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"Topic option"},"4373":{"id":"/docs/server/durability-10","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"Default"},"4374":{"id":"/docs/server/durability-11","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"Controls"},"4375":{"id":"/docs/server/durability-12","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"durability"},"4376":{"id":"/docs/server/durability-13","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"replicated"},"4377":{"id":"/docs/server/durability-14","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"Message production"},"4378":{"id":"/docs/server/durability-15","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"consumer_offset_durability"},"4379":{"id":"/docs/server/durability-16","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"replicated"},"4380":{"id":"/docs/server/durability-17","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"Explicit consumer-offset stores and deletes"},"4381":{"id":"/docs/server/durability-18","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"Both accept replicated or persisted. They default independently: setting durability=persisted leaves consumer offsets at replicated unless that option is also supplied. Neither inherits the other."},"4382":{"id":"/docs/server/durability-19","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"For persisted messages and consumer offsets, create a topic in an existing stream:"},"4383":{"id":"/docs/server/durability-20","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"These are topic creation options, not config.toml settings or server environment overrides. GetTopic reports the effective values. Both policies are create-only. Resource updates cannot change them on an existing topic."},"4384":{"id":"/docs/server/durability-21","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#select-the-policy-when-creating-the-topic","content":"The former enforce_fsync topic option is rejected. Use durability for messages and consumer_offset_durability for offsets. The old server-wide consumer_offset_enforce_fsync setting has also been removed."},"4385":{"id":"/docs/server/durability-22","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#the-single-node-write-path","content":"With replicated, the server commits and applies the operation locally. Message batches can remain in the in-memory partition journal after success. Ordinary segment writes still happen when a flush trigger fires, and a write that triggers a flush can wait for that I/O, but success does not require stable-storage synchronization."},"4386":{"id":"/docs/server/durability-23","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#the-single-node-write-path","content":"With persisted, successful message completion follows this path:"},"4387":{"id":"/docs/server/durability-24","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#the-single-node-write-path","content":"The committed batches are flushed even below the ordinary flush thresholds. Setting durability=persisted is sufficient. Setting messages_required_to_save=1 is not required. A single-replica partition does not use the cluster's prepare WAL."},"4388":{"id":"/docs/server/durability-25","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#the-single-node-write-path","content":"For explicit offset changes, consumer_offset_durability=persisted similarly waits for the required local file and directory synchronization before success. On a singleton, persisting an offset does not force earlier replicated messages to be flushed. Select both policies as persisted when both messages and their stored offsets need that protection."},"4389":{"id":"/docs/server/durability-26","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"Topic option"},"4390":{"id":"/docs/server/durability-27","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"Default"},"4391":{"id":"/docs/server/durability-28","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"Effect"},"4392":{"id":"/docs/server/durability-29","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"messages_required_to_save"},"4393":{"id":"/docs/server/durability-30","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"1024"},"4394":{"id":"/docs/server/durability-31","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"Message-count trigger for ordinary segment writes"},"4395":{"id":"/docs/server/durability-32","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"size_of_messages_required_to_save"},"4396":{"id":"/docs/server/durability-33","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"1 MiB"},"4397":{"id":"/docs/server/durability-34","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"Byte-count trigger for ordinary segment writes"},"4398":{"id":"/docs/server/durability-35","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"segment_size"},"4399":{"id":"/docs/server/durability-36","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"1 GiB"},"4400":{"id":"/docs/server/durability-37","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"Soft segment limit. A whole batch can cross it"},"4401":{"id":"/docs/server/durability-38","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"A count or byte trigger, or a full active segment, can flush the committed journal prefix. Required persistence, capacity pressure, and lifecycle work can flush earlier. These thresholds are not a maximum data-loss guarantee and do not specify a periodic flush interval. A quiet replicated topic can retain messages in process memory while waiting for a trigger."},"4402":{"id":"/docs/server/durability-39","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#flush-scheduling-is-separate","content":"Reducing the thresholds changes batching and I/O frequency. It does not give replicated the stable-storage guarantee of persisted."},"4403":{"id":"/docs/server/durability-40","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"This table describes acknowledged messages on one node, with no later retention or deletion:"},"4404":{"id":"/docs/server/durability-41","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"Failure"},"4405":{"id":"/docs/server/durability-42","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"replicated"},"4406":{"id":"/docs/server/durability-43","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"persisted"},"4407":{"id":"/docs/server/durability-44","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"Process crash, SIGKILL, panic, or OOM kill"},"4408":{"id":"/docs/server/durability-45","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"Unflushed messages can be lost"},"4409":{"id":"/docs/server/durability-46","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"Acknowledged messages are recoverable from local storage"},"4410":{"id":"/docs/server/durability-47","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"Machine crash, kernel panic, or power loss"},"4411":{"id":"/docs/server/durability-48","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"Unflushed messages and unsynchronized file writes can be lost"},"4412":{"id":"/docs/server/durability-49","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"Acknowledged messages are recoverable if the storage honors synchronization"},"4413":{"id":"/docs/server/durability-50","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"Storage device lost or irreparably damaged"},"4414":{"id":"/docs/server/durability-51","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"No surviving local copy is guaranteed"},"4415":{"id":"/docs/server/durability-52","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"No surviving local copy is guaranteed"},"4416":{"id":"/docs/server/durability-53","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"Completed buffered file writes normally remain in Linux's page cache after the server process dies. Messages still in the process's journal do not. Page cache alone does not protect against machine or power failure."},"4417":{"id":"/docs/server/durability-54","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#what-survives-a-failure","content":"A graceful shutdown drains work and forces a final flush of committed messages, regardless of the thresholds. This depends on the shutdown finishing and its I/O succeeding. A container or service termination that expires its grace period and sends SIGKILL is a process crash, not a completed graceful shutdown."},"4418":{"id":"/docs/server/durability-55","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"The policy applies to the completed server operation, not merely to enqueueing a request in a producer or receiving an early dispatch response."},"4419":{"id":"/docs/server/durability-56","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"For HTTP production:"},"4420":{"id":"/docs/server/durability-57","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"Request"},"4421":{"id":"/docs/server/durability-58","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"Response"},"4422":{"id":"/docs/server/durability-59","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"Meaning"},"4423":{"id":"/docs/server/durability-60","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"Default, or ?ack=replicated"},"4424":{"id":"/docs/server/durability-61","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"201 Created, Iggy-Durability: replicated or persisted"},"4425":{"id":"/docs/server/durability-62","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"The write completed under the topic's message policy"},"4426":{"id":"/docs/server/durability-63","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"?ack=none"},"4427":{"id":"/docs/server/durability-64","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"202 Accepted, Iggy-Durability: none"},"4428":{"id":"/docs/server/durability-65","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"Dispatch was accepted. Commit and persistence were not awaited"},"4429":{"id":"/docs/server/durability-66","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"The query value ack=replicated selects the awaited path even when the topic uses persisted. It does not override the topic policy."},"4430":{"id":"/docs/server/durability-67","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#which-responses-prove-completion","content":"Poll auto-commit is asynchronous. A successful poll does not confirm that its offset write committed or became durable, even with consumer_offset_durability=persisted. When processing needs an explicit offset completion guarantee, store the offset explicitly and await success."},"4431":{"id":"/docs/server/durability-68","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#recovery-and-cost","content":"Recovery validates segment batches and partition identity. It can truncate an incomplete tail and rebuild a missing or torn sparse index. Interior damage, gaps, or intact records beyond damaged data can require refusal or peer repair instead of truncation. A single node cannot fetch a missing copy from another replica. See Storage Engine."},"4432":{"id":"/docs/server/durability-69","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#recovery-and-cost","content":"persisted adds synchronization to the completion path. Its latency and throughput depend on storage, filesystem, batching, and concurrency. Measure both policies on the intended hardware rather than applying results from the removed enforce_fsync configuration. The benchmarking guide explains how to reproduce a workload."},"4433":{"id":"/docs/server/durability-70","page_id":"/docs/server/durability","tags":[],"type":"text","url":"/docs/server/durability#recovery-and-cost","content":"The implementation references are the topic policy definitions, partition completion paths, and HTTP response handling."},"4434":{"id":"/docs/server/external-authentication","page_id":"/docs/server/external-authentication","type":"page","content":"External Authentication","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/external-authentication"},"4435":{"id":"/docs/server/external-authentication-0","page_id":"/docs/server/external-authentication","tags":[],"type":"text","url":"/docs/server/external-authentication","content":"Delegate unknown-user logins to an HTTP service that maps callers to existing Iggy accounts."},"4436":{"id":"/docs/server/external-authentication-1","page_id":"/docs/server/external-authentication","type":"heading","tags":[],"url":"/docs/server/external-authentication#configure-the-service","content":"Configure the service"},"4437":{"id":"/docs/server/external-authentication-2","page_id":"/docs/server/external-authentication","type":"heading","tags":[],"url":"/docs/server/external-authentication#request-and-response","content":"Request and response"},"4438":{"id":"/docs/server/external-authentication-3","page_id":"/docs/server/external-authentication","type":"heading","tags":[],"url":"/docs/server/external-authentication#failure-and-replay","content":"Failure and replay"},"4439":{"id":"/docs/server/external-authentication-4","page_id":"/docs/server/external-authentication","tags":[],"type":"text","url":"/docs/server/external-authentication","content":"An external authentication callout delegates a login decision to an HTTP service. Iggy calls it only when the submitted username does not exist locally. A wrong password for a local user never falls back to the service. Personal access tokens and HTTP bearer validation use their existing authentication paths."},"4440":{"id":"/docs/server/external-authentication-5","page_id":"/docs/server/external-authentication","tags":[],"type":"text","url":"/docs/server/external-authentication#configure-the-service","content":"Provision the target Iggy account first. It must be active and cannot be root. Give it the permissions that mapped callers need. The service maps identities to this account. It does not create accounts or supply permissions."},"4441":{"id":"/docs/server/external-authentication-6","page_id":"/docs/server/external-authentication","tags":[],"type":"text","url":"/docs/server/external-authentication#configure-the-service","content":"url names the HTTPS endpoint. IGGY_EXTERNAL_AUTH_URL sets it from the environment and keeps it out of the file. The server sends the submitted password to this endpoint. Protect both the client connection and the callout with TLS."},"4442":{"id":"/docs/server/external-authentication-7","page_id":"/docs/server/external-authentication","tags":[],"type":"text","url":"/docs/server/external-authentication#configure-the-service","content":"The concurrency cap applies per shard, so total in-flight callouts can reach the shard count multiplied by this value. There is no per-client rate limit in the callout. Apply one at the service or network boundary if required."},"4443":{"id":"/docs/server/external-authentication-8","page_id":"/docs/server/external-authentication","tags":[],"type":"text","url":"/docs/server/external-authentication#request-and-response","content":"Iggy sends a JSON POST:"},"4444":{"id":"/docs/server/external-authentication-9","page_id":"/docs/server/external-authentication","tags":[],"type":"text","url":"/docs/server/external-authentication#request-and-response","content":"transport is tcp, tcp_tls, ws, wss, quic or http. Binary connections keep their connection identity across reconnect retries. HTTP creates a new UUID for each login request."},"4445":{"id":"/docs/server/external-authentication-10","page_id":"/docs/server/external-authentication","tags":[],"type":"text","url":"/docs/server/external-authentication#request-and-response","content":"The service must return a successful HTTP status and a JSON decision:"},"4446":{"id":"/docs/server/external-authentication-11","page_id":"/docs/server/external-authentication","tags":[],"type":"text","url":"/docs/server/external-authentication#request-and-response","content":"To reject the login:"},"4447":{"id":"/docs/server/external-authentication-12","page_id":"/docs/server/external-authentication","tags":[],"type":"text","url":"/docs/server/external-authentication#request-and-response","content":"The reason is optional. An allowed username must resolve to the provisioned account at admission. The server rejects malformed decisions and refuses redirects from the callout endpoint."},"4448":{"id":"/docs/server/external-authentication-13","page_id":"/docs/server/external-authentication","tags":[],"type":"text","url":"/docs/server/external-authentication#failure-and-replay","content":"The normal-status metadata primary performs callouts. Other nodes and view changes can produce retryable errors. Timeouts, network failures, overload, HTTP 429 and HTTP 5xx map to retryable failures. Other unsuccessful HTTP responses and invalid decisions terminate the login."},"4449":{"id":"/docs/server/external-authentication-14","page_id":"/docs/server/external-authentication","tags":[],"type":"text","url":"/docs/server/external-authentication#failure-and-replay","content":"The SDK can replay a login. The service must accept repeated verification of the same credentials safely. One-time passwords that become invalid after the first verification do not survive this replay model. A failed external service never grants access by default."},"4450":{"id":"/docs/server/introduction","page_id":"/docs/server/introduction","type":"page","content":"Introduction","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/introduction"},"4451":{"id":"/docs/server/introduction-0","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"What the Iggy server does, and where its releases and Docker images are published."},"4452":{"id":"/docs/server/introduction-1","page_id":"/docs/server/introduction","type":"heading","tags":[],"url":"/docs/server/introduction#system-requirements","content":"System requirements"},"4453":{"id":"/docs/server/introduction-2","page_id":"/docs/server/introduction","type":"heading","tags":[],"url":"/docs/server/introduction#running-the-server","content":"Running the server"},"4454":{"id":"/docs/server/introduction-3","page_id":"/docs/server/introduction","type":"heading","tags":[],"url":"/docs/server/introduction#authentication","content":"Authentication"},"4455":{"id":"/docs/server/introduction-4","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"Iggy server is the most important part of the system as it's responsible for handling all the incoming connections, managing the data and providing the API for the clients. The server is written in Rust. It uses io_uring on Linux and a polling backend on macOS."},"4456":{"id":"/docs/server/introduction-5","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"The releases are published to GitHub and can be found here. The official Docker images can be found here, use docker pull apache/iggy:0.10.0, or apache/iggy:latest for the newest stable release."},"4457":{"id":"/docs/server/introduction-6","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"If you compile the source code in release mode, linking takes longer because LTO is enabled in the [profile.release] section of the workspace Cargo.toml."},"4458":{"id":"/docs/server/introduction-7","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#system-requirements","content":"The server uses io_uring on Linux, which sets a minimum kernel version."},"4459":{"id":"/docs/server/introduction-8","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#system-requirements","content":"Linux kernel 5.19 or newer is required. The shard executors create their rings with IORING_SETUP_COOP_TASKRUN and IORING_SETUP_TASKRUN_FLAG, which older kernels reject, and the server refuses to start rather than run without them. Check yours with uname -r."},"4460":{"id":"/docs/server/introduction-9","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#system-requirements","content":"Kernel 6.1 or newer is worth having. It is the first version with the kernel.io_uring_disabled sysctl, so the startup diagnostics can tell you io_uring was disabled by policy instead of failing obscurely. See Linux tuning."},"4461":{"id":"/docs/server/introduction-10","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#system-requirements","content":"Ubuntu 22.04 LTS ships 5.15 and will not run the server. Its hardware enablement kernel is new enough, and so are Ubuntu 24.04 LTS and Debian 12 as they ship."},"4462":{"id":"/docs/server/introduction-11","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#system-requirements","content":"WSL2 often ships incomplete io_uring, missing setup flags or operations even on a kernel that reports 5.19 or newer. Run wsl --update first."},"4463":{"id":"/docs/server/introduction-12","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#system-requirements","content":"macOS uses a polling backend rather than io_uring when the server runs natively, so this requirement does not apply there. Apache Iggy 0.10.0 skips memory binding on a single-NUMA-node topology. The older Docker Desktop workaround is no longer required for that case. Use IGGY_SHARDING_CPU_ALLOCATION=all when you explicitly want CPU pinning without NUMA memory binding."},"4464":{"id":"/docs/server/introduction-13","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#system-requirements","content":"Containers use the host's kernel, so it is the host that has to meet this requirement. See Docker & Helm."},"4465":{"id":"/docs/server/introduction-14","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"One iggy-server binary serves both the single-node and the clustered deployment. The loaded configuration decides which one you get. The server accepts these startup flags, plus --help and --version:"},"4466":{"id":"/docs/server/introduction-15","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"Flag"},"4467":{"id":"/docs/server/introduction-16","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"Purpose"},"4468":{"id":"/docs/server/introduction-17","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"--fresh"},"4469":{"id":"/docs/server/introduction-18","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"Delete the data directory before starting. This wipes all data on that node."},"4470":{"id":"/docs/server/introduction-19","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"--with-default-root-credentials"},"4471":{"id":"/docs/server/introduction-20","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"Set the root credentials to iggy/iggy on first start, unless IGGY_ROOT_USERNAME/IGGY_ROOT_PASSWORD are already set. Development only."},"4472":{"id":"/docs/server/introduction-21","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"--replica-id <N>"},"4473":{"id":"/docs/server/introduction-22","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"Select this node's entry in cluster.nodes. Required when cluster.enabled = true. See Clustering."},"4474":{"id":"/docs/server/introduction-23","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"Configuration comes from the TOML file named by IGGY_CONFIG_PATH, or core/server/config.toml relative to the working directory. If that file is missing, the server uses the defaults embedded in the binary. Any key can be overridden with an IGGY_-prefixed environment variable, and a .env file in the working directory or its parents (or the file named by IGGY_ENV_PATH) is loaded at startup. See Configuration for the full reference."},"4475":{"id":"/docs/server/introduction-24","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"A fresh standalone server requires IGGY_ROOT_USERNAME and IGGY_ROOT_PASSWORD, or the development flag. It never generates a password. A cluster replica without credentials waits for the root account to be replicated. Provision credentials on every replica for first cluster boot."},"4476":{"id":"/docs/server/introduction-25","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"The HTTP API endpoints can be found in server.http file, which can be used with REST Client extension for VS Code."},"4477":{"id":"/docs/server/introduction-26","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"In order to see the detailed logs from the server, run it with RUST_LOG=trace environment variable."},"4478":{"id":"/docs/server/introduction-27","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"To seed the example data, start a development server with known credentials from the root of the repository:"},"4479":{"id":"/docs/server/introduction-28","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"In another terminal at the repository root:"},"4480":{"id":"/docs/server/introduction-29","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"The seeder logs in as iggy/iggy by default. Pass --username and --password to use other credentials."},"4481":{"id":"/docs/server/introduction-30","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#authentication","content":"For broker API commands, only the ping liveness probe and the login handshake itself (username/password, personal access token, or HTTP token refresh, all of which prove a credential) are served without an authenticated session. Every other request requires one and is subject to permissions: fetching server stats, for example, needs the read_servers permission (the root user has it), and even the Prometheus /metrics scrape must present a bearer credential. A stateful connection authenticates by logging in with the user's credentials or personal access token. A retained session survives transport loss. Logout, session expiry and account deactivation end it. Over the HTTP API, authentication is done by providing the Authorization header with a Bearer JWT or personal access token. HTTP CORS preflight responses and embedded /ui static assets are public. The UI's broker API calls still require authentication."},"4482":{"id":"/docs/server/linux-tuning","page_id":"/docs/server/linux-tuning","type":"page","content":"Linux tuning","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/linux-tuning"},"4483":{"id":"/docs/server/linux-tuning-0","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning","content":"Prepare Linux hosts for Iggy and measure the effects of memory, CPU, storage, and network tuning."},"4484":{"id":"/docs/server/linux-tuning-1","page_id":"/docs/server/linux-tuning","type":"heading","tags":[],"url":"/docs/server/linux-tuning#inspect-the-host-first","content":"Inspect the host first"},"4485":{"id":"/docs/server/linux-tuning-2","page_id":"/docs/server/linux-tuning","type":"heading","tags":[],"url":"/docs/server/linux-tuning#runtime-access-and-process-limits","content":"Runtime access and process limits"},"4486":{"id":"/docs/server/linux-tuning-3","page_id":"/docs/server/linux-tuning","type":"heading","tags":[],"url":"/docs/server/linux-tuning#swapping-and-writeback","content":"Swapping and writeback"},"4487":{"id":"/docs/server/linux-tuning-4","page_id":"/docs/server/linux-tuning","type":"heading","tags":[],"url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"Huge pages and mimalloc"},"4488":{"id":"/docs/server/linux-tuning-5","page_id":"/docs/server/linux-tuning","type":"heading","tags":[],"url":"/docs/server/linux-tuning#explicit-large-pages","content":"Explicit large pages"},"4489":{"id":"/docs/server/linux-tuning-6","page_id":"/docs/server/linux-tuning","type":"heading","tags":[],"url":"/docs/server/linux-tuning#transparent-huge-pages","content":"Transparent huge pages"},"4490":{"id":"/docs/server/linux-tuning-7","page_id":"/docs/server/linux-tuning","type":"heading","tags":[],"url":"/docs/server/linux-tuning#cpu-placement-and-numa","content":"CPU placement and NUMA"},"4491":{"id":"/docs/server/linux-tuning-8","page_id":"/docs/server/linux-tuning","type":"heading","tags":[],"url":"/docs/server/linux-tuning#network-and-storage","content":"Network and storage"},"4492":{"id":"/docs/server/linux-tuning-9","page_id":"/docs/server/linux-tuning","type":"heading","tags":[],"url":"/docs/server/linux-tuning#apply-verify-and-reproduce","content":"Apply, verify, and reproduce"},"4493":{"id":"/docs/server/linux-tuning-10","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning","content":"Host settings affect both production latency and benchmark results. Start with the distribution defaults, satisfy Iggy's runtime requirements, then change one setting at a time. The examples below are experiments for dedicated Linux hosts, not a configuration to apply unchanged to every VM."},"4494":{"id":"/docs/server/linux-tuning-11","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning","content":"Use the benchmarking guide to compare throughput, p50, p99 and p99.9 latency, memory use, and errors under the same workload. Keep the server version, transport, topic durability, CPU allocation, and storage identical between runs."},"4495":{"id":"/docs/server/linux-tuning-12","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#inspect-the-host-first","content":"Run these read-only checks before changing the VM image or starting a benchmark:"},"4496":{"id":"/docs/server/linux-tuning-13","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#inspect-the-host-first","content":"The shell's limits are not necessarily the service's limits. For a running process, inspect /proc/PID/limits, /proc/PID/status, and its cgroup limits. Replace PID with that process's ID. Record the VM type, vCPU topology, memory limit, disk type and provisioned throughput, filesystem, and network bandwidth with the result."},"4497":{"id":"/docs/server/linux-tuning-14","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#runtime-access-and-process-limits","content":"Iggy uses io_uring. The kernel must implement the operations required by the server build, and the service or container must be allowed to use them. The server's startup diagnostics identify failed ring creation and unsupported operations. Where the kernel exposes them, inspect:"},"4498":{"id":"/docs/server/linux-tuning-15","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#runtime-access-and-process-limits","content":"io_uring_disabled=0 permits ring creation. With 1, an unprivileged service needs membership in the configured io_uring_group. With 2, creation is disabled. Container syscall filters can independently deny access. Configure access for the service rather than assuming that a root shell proves the container can start. See the kernel's io_uring controls and Docker deployment guidance."},"4499":{"id":"/docs/server/linux-tuning-16","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#runtime-access-and-process-limits","content":"Size file-descriptor limits for connections, partitions, open segment files, and runtime overhead. LimitNOFILE=65536 is an example starting budget, not an Iggy requirement. Increase it if measurements justify more. A systemd service can use the following drop-in:"},"4500":{"id":"/docs/server/linux-tuning-17","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#runtime-access-and-process-limits","content":"Unlimited locked memory is an option for a dedicated service with a planned memory budget. A finite limit is also valid if it covers the runtime's locked-memory requirements. Neither setting creates RAM or overrides a container's memory ceiling."},"4501":{"id":"/docs/server/linux-tuning-18","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#runtime-access-and-process-limits","content":"Recheck the actual process limits after restarting the service. PAM settings in /etc/security/limits.conf do not configure a system service. See systemd resource limits."},"4502":{"id":"/docs/server/linux-tuning-19","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#swapping-and-writeback","content":"On a host with disk-backed swap and enough RAM for the workload, try vm.swappiness=10 and compare it with the existing value. It reduces the preference for swapping relative to reclaiming file cache. It does not disable swapping, and even 0 permits swapping under sufficient pressure. zram and zswap can warrant different values. See Linux swappiness."},"4503":{"id":"/docs/server/linux-tuning-20","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#swapping-and-writeback","content":"Leave memory for the kernel, page cache, other processes, and Iggy's buffers. Watch swap-in/out with vmstat 1 and memory pressure in /proc/pressure/memory. Disabling swap does not fix an undersized memory budget."},"4504":{"id":"/docs/server/linux-tuning-21","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#swapping-and-writeback","content":"Dirty-page limits govern buffered writeback. Large percentage limits, such as dirty_background_ratio=10 and dirty_ratio=30, can permit large bursts on high-memory VMs. If writeback coincides with latency spikes, compare explicit byte limits sized from disk throughput and the acceptable backlog."},"4505":{"id":"/docs/server/linux-tuning-22","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#swapping-and-writeback","content":"Byte and ratio forms are alternatives. Writing one disables its corresponding other form. These settings do not replace Iggy's persistence barriers. See Linux writeback controls."},"4506":{"id":"/docs/server/linux-tuning-23","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"Huge pages can reduce translation overhead, but they consume memory differently from ordinary pages. Measure both throughput and tail latency. Iggy's default server build uses mimalloc. Check the startup allocator message, since builds that disable mimalloc do not use its environment options."},"4507":{"id":"/docs/server/linux-tuning-24","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"There are three distinct controls:"},"4508":{"id":"/docs/server/linux-tuning-25","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"Control"},"4509":{"id":"/docs/server/linux-tuning-26","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"Meaning"},"4510":{"id":"/docs/server/linux-tuning-27","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"Transparent huge pages (THP)"},"4511":{"id":"/docs/server/linux-tuning-28","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"Kernel promotion of eligible mappings. Inspect the top-level and per-size THP policies."},"4512":{"id":"/docs/server/linux-tuning-29","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"Linux HugeTLB pools"},"4513":{"id":"/docs/server/linux-tuning-30","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"Explicitly reserved pages. vm.nr_hugepages counts pages of the default size reported by Hugepagesize."},"4514":{"id":"/docs/server/linux-tuning-31","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"mimalloc environment options"},"4515":{"id":"/docs/server/linux-tuning-32","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#huge-pages-and-mimalloc","content":"Tell the allocator which page mechanisms to request. They are not kernel pool sizes."},"4516":{"id":"/docs/server/linux-tuning-33","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#explicit-large-pages","content":"First verify the default page size and leave sufficient ordinary memory. If Hugepagesize is 2048 kB, 512 reserved pages consume 1 GiB:"},"4517":{"id":"/docs/server/linux-tuning-34","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#explicit-large-pages","content":"The requested count may not be allocated on a fragmented host. Boot-time reservation is more reliable. Reserved HugeTLB memory is unavailable for ordinary allocations or page cache, even while unused. Check NUMA placement and the actual pool, not just the requested count. See HugeTLB administration."},"4518":{"id":"/docs/server/linux-tuning-35","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#explicit-large-pages","content":"Try the allocator option on a mimalloc-enabled server, with access to the pool configured for its service account:"},"4519":{"id":"/docs/server/linux-tuning-36","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#explicit-large-pages","content":"Set allocator variables in the launching environment or the service's Environment= entries before process startup. The server can allocate before loading its .env file. Verbose allocator output is useful for checking the experiment, then turn it off for timed runs."},"4520":{"id":"/docs/server/linux-tuning-37","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#explicit-large-pages","content":"Do not copy a Linux page count into MIMALLOC_RESERVE_HUGE_OS_PAGES. That mimalloc option counts 1 GiB pages. A value of 2048 requests 2 TiB, whereas vm.nr_hugepages=2048 represents 4 GiB only when the default HugeTLB page size is 2 MiB. A 2 MiB pool does not provide a matching 1 GiB reservation."},"4521":{"id":"/docs/server/linux-tuning-38","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#explicit-large-pages","content":"A separate 1 GiB-page experiment requires platform support, a suitable pool, and a budget for each process. mimalloc advises normally choosing this reservation mode separately from MIMALLOC_ALLOW_LARGE_OS_PAGES. See mimalloc environment options. HugeTLB allocation can require CAP_IPC_LOCK or membership in vm.hugetlb_shm_group, as described in mmap permissions."},"4522":{"id":"/docs/server/linux-tuning-39","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#transparent-huge-pages","content":"Inspect the current policy instead of universally enabling or disabling THP:"},"4523":{"id":"/docs/server/linux-tuning-40","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#transparent-huge-pages","content":"Compare the existing policy with madvise if allocator page promotion or compaction is relevant. Direct reclaim and compaction can stall allocations. On recent kernels, per-size policies and explicit MADV_COLLAPSE requests also matter, so the top-level switch alone does not describe all behavior. See transparent huge-page controls."},"4524":{"id":"/docs/server/linux-tuning-41","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#transparent-huge-pages","content":"Verify actual usage in /proc/PID/smaps: AnonHugePages reports PMD-sized anonymous THP, while Private_Hugetlb and Shared_Hugetlb identify explicit huge-page mappings. A successful pool reservation alone does not prove Iggy used it."},"4525":{"id":"/docs/server/linux-tuning-42","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#cpu-placement-and-numa","content":"Allocate dedicated CPUs where possible. On the current server, [sharding] cpu_allocation and pin_cores control shard placement, and the process's allowed CPU set constrains allocation. Check the embedded configuration for the exact version being deployed. Separate server CPUs from a colocated load generator and leave capacity for kernel and network work."},"4526":{"id":"/docs/server/linux-tuning-43","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#cpu-placement-and-numa","content":"Inspect NUMA topology with lscpu or numactl --hardware. Compare physical-core-only placement with SMT when relevant. Match memory placement and any per-node huge-page reservation to the CPUs running the shards. Avoid assuming that allocating a pool on one NUMA node helps shards running on another."},"4527":{"id":"/docs/server/linux-tuning-44","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#cpu-placement-and-numa","content":"For a reproducible dedicated-host experiment, compare the performance CPU governor with the current governor if the guest exposes CPU frequency control. Power and thermal limits can still constrain frequency. Many cloud guests cannot control the host's governor. Record the setting rather than assuming a command changed it. See CPU performance scaling."},"4528":{"id":"/docs/server/linux-tuning-45","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#cpu-placement-and-numa","content":"Inspect CPU steal time, cgroup throttling, and per-core utilization before increasing shard counts. If one core handles most interrupts or receive processing, inspect RSS queue distribution and IRQ affinity. Do not disable irqbalance or assign every IRQ to a fixed core without measuring. See Linux network scaling."},"4529":{"id":"/docs/server/linux-tuning-46","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#network-and-storage","content":"Socket-buffer requirements depend on bandwidth and round-trip time. For example, 10 Gbit/s across 10 ms has a bandwidth-delay product of about 12.5 MB. If the connection is window-limited, inspect net.core.rmem_max, net.core.wmem_max, net.ipv4.tcp_rmem, and net.ipv4.tcp_wmem. Larger ceilings permit larger buffers, but do not force the application to use them or guarantee higher throughput."},"4530":{"id":"/docs/server/linux-tuning-47","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#network-and-storage","content":"Raise somaxconn, tcp_max_syn_backlog, or netdev_max_backlog only when backlog pressure or drops show the need. QUIC uses UDP, so TCP tuning does not configure its flow-control windows or UDP receive buffers."},"4531":{"id":"/docs/server/linux-tuning-48","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#network-and-storage","content":"Keep changes such as tcp_tw_reuse, shorter TCP timeouts, and wider ephemeral-port ranges tied to a demonstrated connection-churn problem. See TCP controls and core networking controls."},"4532":{"id":"/docs/server/linux-tuning-49","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#network-and-storage","content":"Use storage with measured sustained bandwidth and latency, and record cloud volume and instance limits. Keep free space for segments, WAL, and recovery. Compare warm-cache and cold-cache runs explicitly. Do not periodically drop caches or disable storage flushes to improve a benchmark number. Storage, retention, and the selected durability policy must match the workload being evaluated."},"4533":{"id":"/docs/server/linux-tuning-50","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#apply-verify-and-reproduce","content":"Trial a change with a runtime setting first. Keep the previous value for rollback. Persist accepted sysctl values in a dedicated /etc/sysctl.d/ file and accepted service limits or allocator variables in that service's systemd drop-in. THP sysfs writes require a boot-time mechanism of their own. Recheck effective values after reboot and process restart."},"4534":{"id":"/docs/server/linux-tuning-51","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#apply-verify-and-reproduce","content":"Collect vmstat 1, iostat -xz 1, mpstat -P ALL 1, pressure counters, and network drop/retransmission counters alongside benchmark results. The iostat and mpstat tools are provided by the sysstat package. Run long enough to include segment flushes, WAL checkpoints, and sustained device limits, rather than measuring only buffered admission."},"4535":{"id":"/docs/server/linux-tuning-52","page_id":"/docs/server/linux-tuning","tags":[],"type":"text","url":"/docs/server/linux-tuning#apply-verify-and-reproduce","content":"Iggy's topic durability and consumer_offset_durability independently default to replicated. persisted changes completion guarantees, and huge pages or sysctl settings do not replace it. Poll auto-commit remains asynchronous. Record both policies, replication-group size, payload and batch sizes, warmup, CPU allocation, and the exact host changes with each benchmark result."},"4536":{"id":"/docs/server/monitoring","page_id":"/docs/server/monitoring","type":"page","content":"Monitoring","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/monitoring"},"4537":{"id":"/docs/server/monitoring-0","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring","content":"Scrape the server's Prometheus metrics: the token the endpoint needs, what it exports, and which metrics are worth alerting on."},"4538":{"id":"/docs/server/monitoring-1","page_id":"/docs/server/monitoring","type":"heading","tags":[],"url":"/docs/server/monitoring#get-a-token-for-the-scraper","content":"Get a token for the scraper"},"4539":{"id":"/docs/server/monitoring-2","page_id":"/docs/server/monitoring","type":"heading","tags":[],"url":"/docs/server/monitoring#whats-exported","content":"What's exported"},"4540":{"id":"/docs/server/monitoring-3","page_id":"/docs/server/monitoring","type":"heading","tags":[],"url":"/docs/server/monitoring#what-to-alert-on","content":"What to alert on"},"4541":{"id":"/docs/server/monitoring-4","page_id":"/docs/server/monitoring","type":"heading","tags":[],"url":"/docs/server/monitoring#grafana-and-opentelemetry","content":"Grafana and OpenTelemetry"},"4542":{"id":"/docs/server/monitoring-5","page_id":"/docs/server/monitoring","type":"heading","tags":[],"url":"/docs/server/monitoring#topic-usage-and-replica-progress","content":"Topic usage and replica progress"},"4543":{"id":"/docs/server/monitoring-6","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring","content":"The server exports Prometheus metrics on its HTTP API at /metrics. Both the HTTP API and the metrics endpoint are on by default. See [http.metrics] to change the path or turn it off."},"4544":{"id":"/docs/server/monitoring-7","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring","content":"This page covers the server's own metrics. The connectors runtime has a separate endpoint with its own metric names. See Connectors observability."},"4545":{"id":"/docs/server/monitoring-8","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#get-a-token-for-the-scraper","content":"/metrics needs a bearer token, like every other read on the HTTP API. Any logged-in user can scrape it and gets the aggregate gauges. The per-topic series need the read_servers or manage_servers permission. There's no separate monitoring permission. Prometheus can't log in, so create a personal access token and put it in the scrape config:"},"4546":{"id":"/docs/server/monitoring-9","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#get-a-token-for-the-scraper","content":"The token is printed once. The Prometheus scrape config is in [http.metrics]."},"4547":{"id":"/docs/server/monitoring-10","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#get-a-token-for-the-scraper","content":"The token can read every metric the server exports, so store it like any other secret: in a Kubernetes Secret or your secrets manager, not in a file you commit. With the Helm chart, set it through server.serviceMonitor.authorization. See Docker & Helm."},"4548":{"id":"/docs/server/monitoring-11","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"The core metrics are below. The gauges are read fresh on every scrape."},"4549":{"id":"/docs/server/monitoring-12","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"Metric"},"4550":{"id":"/docs/server/monitoring-13","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"Type"},"4551":{"id":"/docs/server/monitoring-14","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"What it counts"},"4552":{"id":"/docs/server/monitoring-15","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"http_requests_total"},"4553":{"id":"/docs/server/monitoring-16","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"counter"},"4554":{"id":"/docs/server/monitoring-17","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"HTTP API requests"},"4555":{"id":"/docs/server/monitoring-18","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"streams, topics, partitions, segments"},"4556":{"id":"/docs/server/monitoring-19","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"gauge"},"4557":{"id":"/docs/server/monitoring-20","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"Current number of each"},"4558":{"id":"/docs/server/monitoring-21","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"messages"},"4559":{"id":"/docs/server/monitoring-22","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"gauge"},"4560":{"id":"/docs/server/monitoring-23","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"Messages stored"},"4561":{"id":"/docs/server/monitoring-24","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"users"},"4562":{"id":"/docs/server/monitoring-25","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"gauge"},"4563":{"id":"/docs/server/monitoring-26","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"Users"},"4564":{"id":"/docs/server/monitoring-27","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"clients"},"4565":{"id":"/docs/server/monitoring-28","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"gauge"},"4566":{"id":"/docs/server/monitoring-29","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"Connected clients"},"4567":{"id":"/docs/server/monitoring-30","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"The names have no iggy_ prefix, so watch for clashes if Prometheus scrapes other exporters with similar names."},"4568":{"id":"/docs/server/monitoring-31","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#whats-exported","content":"Each shard also exports its own lower-level metrics, labelled shard=\"<id>\". These cover the write-ahead log (the partition_wal_* series), partition housekeeping (partitions_*), and requests or frames the server refused or dropped. To see the full list with descriptions, scrape a running server:"},"4569":{"id":"/docs/server/monitoring-32","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#what-to-alert-on","content":"frame_drops_total{variant=\"forward_client_send\"}. Any increase means a client never got a reply to a request. Most other frame_drops_total variants are retried or repaired automatically. This series only appears after the first drop, so on a healthy server it won't be in the scrape at all. Write the alert so that a missing series counts as no drops."},"4570":{"id":"/docs/server/monitoring-33","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#what-to-alert-on","content":"stats_rollup_underflows_total. It goes up when a stream, topic or partition total would have dropped below zero and was held at zero instead. A few during deletes or restores are expected. A steady rise at other times is worth a look."},"4571":{"id":"/docs/server/monitoring-34","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#grafana-and-opentelemetry","content":"Add Prometheus as a data source in Grafana, then build panels from the metric names above."},"4572":{"id":"/docs/server/monitoring-35","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#grafana-and-opentelemetry","content":"The server doesn't export metrics over OTLP. To bring them into an OpenTelemetry pipeline, scrape /metrics with the collector's Prometheus receiver, using the same bearer token. Server export of logs and traces over OTLP isn't available yet. See [telemetry]."},"4573":{"id":"/docs/server/monitoring-36","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#topic-usage-and-replica-progress","content":"topic_size_bytes, topic_messages and topic_max_size_bytes use stream and topic labels. The size-cap series is absent for unlimited topics. Renamed or deleted topics disappear from the next scrape. Retention can keep more bytes than the configured cap, so a usage ratio is not a hard storage boundary."},"4574":{"id":"/docs/server/monitoring-37","page_id":"/docs/server/monitoring","tags":[],"type":"text","url":"/docs/server/monitoring#topic-usage-and-replica-progress","content":"Replica counters can lag a successful send until a prepare or commit broadcast updates them. Compare node-local observations with routing and view-change events before treating a transient difference as data loss. Repair-ring metrics report retained batch bytes and released-entry accounting, not total process memory."},"4575":{"id":"/docs/server/networking","page_id":"/docs/server/networking","type":"page","content":"Networking","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/networking"},"4576":{"id":"/docs/server/networking-0","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking","content":"The four transports Iggy serves simultaneously, TCP, QUIC, WebSocket and HTTP, and what each is best suited to."},"4577":{"id":"/docs/server/networking-1","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#transport-protocols","content":"Transport protocols"},"4578":{"id":"/docs/server/networking-2","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#binary-protocol","content":"Binary protocol"},"4579":{"id":"/docs/server/networking-3","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#connection-handling-across-shards","content":"Connection handling across shards"},"4580":{"id":"/docs/server/networking-4","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#tcp","content":"TCP"},"4581":{"id":"/docs/server/networking-5","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#quic","content":"QUIC"},"4582":{"id":"/docs/server/networking-6","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#http","content":"HTTP"},"4583":{"id":"/docs/server/networking-7","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#websocket","content":"WebSocket"},"4584":{"id":"/docs/server/networking-8","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#tls","content":"TLS"},"4585":{"id":"/docs/server/networking-9","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#heartbeat","content":"Heartbeat"},"4586":{"id":"/docs/server/networking-10","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#cluster-networking","content":"Cluster networking"},"4587":{"id":"/docs/server/networking-11","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking","content":"Iggy supports four transport protocols simultaneously, each optimized for different use cases. All stateful protocols (TCP, QUIC, WebSocket) use the same custom binary wire protocol, while HTTP provides a standard REST API."},"4588":{"id":"/docs/server/networking-12","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Protocol"},"4589":{"id":"/docs/server/networking-13","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Default Address"},"4590":{"id":"/docs/server/networking-14","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Implementation"},"4591":{"id":"/docs/server/networking-15","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Best for"},"4592":{"id":"/docs/server/networking-16","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"TCP"},"4593":{"id":"/docs/server/networking-17","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"127.0.0.1:8090"},"4594":{"id":"/docs/server/networking-18","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"compio + custom binary protocol"},"4595":{"id":"/docs/server/networking-19","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Highest throughput, lowest latency"},"4596":{"id":"/docs/server/networking-20","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"QUIC"},"4597":{"id":"/docs/server/networking-21","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"127.0.0.1:8080"},"4598":{"id":"/docs/server/networking-22","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"compio-quic (quinn)"},"4599":{"id":"/docs/server/networking-23","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Secure connections out of the box"},"4600":{"id":"/docs/server/networking-24","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"HTTP"},"4601":{"id":"/docs/server/networking-25","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"127.0.0.1:3000"},"4602":{"id":"/docs/server/networking-26","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"axum"},"4603":{"id":"/docs/server/networking-27","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"REST API, web integrations"},"4604":{"id":"/docs/server/networking-28","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"WebSocket"},"4605":{"id":"/docs/server/networking-29","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"127.0.0.1:8092"},"4606":{"id":"/docs/server/networking-30","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"compio-ws"},"4607":{"id":"/docs/server/networking-31","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Browser clients, bidirectional streaming"},"4608":{"id":"/docs/server/networking-32","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Performance ranking (lowest to highest overhead): TCP > QUIC > WebSocket > HTTP"},"4609":{"id":"/docs/server/networking-33","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#binary-protocol","content":"Every request and reply on the stateful transports starts with a fixed 256-byte header (the same Viewstamped Replication header layout the cluster uses internally), followed by the command payload. The iggy_binary_protocol crate provides zero-copy serialization for these headers, and foreign SDKs implement the same contract natively. See the Binary Protocol section for the full specification."},"4610":{"id":"/docs/server/networking-34","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#connection-handling-across-shards","content":"The server runs one thread and runtime per selected shard (thread-per-core, shared-nothing), with CPU selection and optional pinning controlled by [sharding]. All listeners (every client transport) bind on shard 0 only. Shard 0's coordinator hands accepted plaintext TCP and WebSocket connections to peer shards round-robin by transferring the file descriptor at accept time. From then on the connection lives entirely on its shard. QUIC, TCP with TLS, WebSocket with TLS, and HTTP terminate on shard 0, because their per-connection state cannot move between threads. Sockets never migrate after accept: an operation that touches a partition owned by another shard rides the internal message bus instead."},"4611":{"id":"/docs/server/networking-35","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tcp","content":"TCP provides the highest performance as it works directly with binary data without the overhead of HTTP or TLS handshakes (unless TLS is enabled). The full set of keys:"},"4612":{"id":"/docs/server/networking-36","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"QUIC runs the same binary protocol over UDP, on top of the quinn library, with TLS built in. It isn't quite as fast as TCP, but security comes out of the box (TLS is mandatory). Defaults:"},"4613":{"id":"/docs/server/networking-37","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"A few of these are deliberate rather than arbitrary:"},"4614":{"id":"/docs/server/networking-38","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"max_concurrent_bidi_streams = 256 bounds concurrent bidirectional streams on a connection. Deferred requests can wait while other requests use separate streams."},"4615":{"id":"/docs/server/networking-39","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"initial_mtu = \"1200 B\" is the QUIC minimum. MTU discovery probes upward automatically, and boot rejects values below 1200."},"4616":{"id":"/docs/server/networking-40","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"stream_receive_window is the per-stream limit within the shared connection receive window. Both default to 64 MiB."},"4617":{"id":"/docs/server/networking-41","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"keep_alive_interval is one third of max_idle_timeout, so two consecutive lost keep-alives fit before the idle timer closes the connection."},"4618":{"id":"/docs/server/networking-42","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"The HTTP API is built on axum and provides a standard REST interface. It includes JWT authentication, CORS configuration, and optional TLS."},"4619":{"id":"/docs/server/networking-43","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"HTTP is the most accessible protocol but has the highest overhead due to JSON serialization and the stateless nature of HTTP (no persistent connections for consumer groups). You can find request examples in the server.http file."},"4620":{"id":"/docs/server/networking-44","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"The HTTP server also hosts:"},"4621":{"id":"/docs/server/networking-45","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"Prometheus metrics at /metrics (endpoint configurable via [http.metrics]). The route authenticates like every other read: scrapers must present a bearer credential (JWT or personal access token). The /ping API route, CORS preflight responses, and enabled /ui static assets are public. Login and refresh routes prove credentials in the request body."},"4622":{"id":"/docs/server/networking-46","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"Embedded Web UI at /ui, which requires web_ui = true in [http] (off by default) on a server built with the iggy-web feature (part of the default build) and the Web UI static assets. Build the assets before compiling the server. See Configuration."},"4623":{"id":"/docs/server/networking-47","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"WebSocket provides bidirectional streaming over HTTP upgrade. Iggy uses the compio-ws crate to connect tungstenite framing to compio's completion-based I/O. The default WebSocket read buffer is 128 KiB and the default maximum message size is 64 MiB. These are separate settings."},"4624":{"id":"/docs/server/networking-48","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"The [websocket] section exposes the frame-tuning knobs (read_buffer_size, write_buffer_size, max_write_buffer_size, max_message_size, max_frame_size, accept_unmasked_frames). See Configuration. TLS for WebSocket has its own [websocket.tls] section."},"4625":{"id":"/docs/server/networking-49","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"Historical benchmark comparison from the WebSocket implementation article (AWS i3en.3xlarge, 4 producers or consumers, 40M messages, 1,000 messages per batch, fsync enabled). These measurements predate 0.10.0:"},"4626":{"id":"/docs/server/networking-50","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"Producer avg latency: TCP 2.61ms vs WebSocket 3.43ms (+31%)"},"4627":{"id":"/docs/server/networking-51","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"Consumer avg latency: TCP 0.70ms vs WebSocket 1.44ms (+106%)"},"4628":{"id":"/docs/server/networking-52","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Each transport configures TLS in its own section, and the self_signed semantics differ per transport:"},"4629":{"id":"/docs/server/networking-53","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Transport"},"4630":{"id":"/docs/server/networking-54","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Section"},"4631":{"id":"/docs/server/networking-55","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Behavior"},"4632":{"id":"/docs/server/networking-56","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"TCP"},"4633":{"id":"/docs/server/networking-57","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"[tcp.tls]"},"4634":{"id":"/docs/server/networking-58","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"self_signed = true generates an ephemeral certificate only while cert_file does not exist. An existing PEM pair is loaded instead."},"4635":{"id":"/docs/server/networking-59","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"WebSocket"},"4636":{"id":"/docs/server/networking-60","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"[websocket.tls]"},"4637":{"id":"/docs/server/networking-61","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Same load-or-generate rule as TCP."},"4638":{"id":"/docs/server/networking-62","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"QUIC"},"4639":{"id":"/docs/server/networking-63","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"[quic.certificate]"},"4640":{"id":"/docs/server/networking-64","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"TLS is mandatory (part of the QUIC spec). self_signed = true always generates an ephemeral certificate and ignores cert_file/key_file, logging a warning if the files exist."},"4641":{"id":"/docs/server/networking-65","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"HTTP"},"4642":{"id":"/docs/server/networking-66","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"[http.tls]"},"4643":{"id":"/docs/server/networking-67","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"No self_signed option: HTTPS requires certificate and key files in cert_file/key_file."},"4644":{"id":"/docs/server/networking-68","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"With self_signed = false, cert_file and key_file must both exist. For production, provide proper certificate files everywhere. Ephemeral certificates change on every start, so a trust configuration pinned to one generated certificate does not survive a restart."},"4645":{"id":"/docs/server/networking-69","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#heartbeat","content":"The per-shard verifier evicts stale group-member connections. A link eviction does not itself end the logical session. The metadata liveness process expires its lease and rebalances membership. The session timeout is 1.2 times heartbeat.interval, 36 seconds by default, with periodic checks around that threshold."},"4646":{"id":"/docs/server/networking-70","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#heartbeat","content":"SDKs maintain heartbeats after connection. The Java blocking client delegates to the async TCP client and uses its heartbeat. Reconnect binds a retained session before creating a new one. See Client failover."},"4647":{"id":"/docs/server/networking-71","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#cluster-networking","content":"In cluster mode, listener ports come exclusively from each node's cluster.nodes ports entry, including the tcp_replica port for the consensus plane, and nodes can advertise different client-facing addresses per client network. Replica-to-replica traffic can be authenticated with a pre-shared key and wrapped in TLS 1.3. See Clustering configuration and Clustering security."},"4648":{"id":"/docs/server/security","page_id":"/docs/server/security","type":"page","content":"Security","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/security"},"4649":{"id":"/docs/server/security-0","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security","content":"Authentication, authorization, transport encryption and encryption at rest in the Iggy server."},"4650":{"id":"/docs/server/security-1","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#authentication","content":"Authentication"},"4651":{"id":"/docs/server/security-2","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#username-and-password","content":"Username and password"},"4652":{"id":"/docs/server/security-3","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#personal-access-tokens-pat","content":"Personal Access Tokens (PAT)"},"4653":{"id":"/docs/server/security-4","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#authorization","content":"Authorization"},"4654":{"id":"/docs/server/security-5","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#permission-matrix","content":"Permission matrix"},"4655":{"id":"/docs/server/security-6","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#scoped-permissions","content":"Scoped permissions"},"4656":{"id":"/docs/server/security-7","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#how-permissions-cascade","content":"How permissions cascade"},"4657":{"id":"/docs/server/security-8","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#transport-encryption-tls","content":"Transport encryption (TLS)"},"4658":{"id":"/docs/server/security-9","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#data-encryption-at-rest","content":"Data encryption at rest"},"4659":{"id":"/docs/server/security-10","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#jwt-http-api","content":"JWT (HTTP API)"},"4660":{"id":"/docs/server/security-11","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#cluster-security","content":"Cluster security"},"4661":{"id":"/docs/server/security-12","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security","content":"Iggy provides multiple layers of security covering authentication, authorization, transport encryption, and data encryption at rest."},"4662":{"id":"/docs/server/security-13","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authentication","content":"Iggy supports local credentials and personal access tokens. HTTP also accepts configured JWT issuers. An optional external authentication service handles unknown local usernames."},"4663":{"id":"/docs/server/security-14","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#username-and-password","content":"Users authenticate with a username and password, for example via the Rust SDK's login_user(). Passwords are hashed using Argon2id (a memory-hard hashing algorithm). A fresh server requires explicit root credentials. It does not generate or log a root password. Set both environment variables:"},"4664":{"id":"/docs/server/security-15","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#username-and-password","content":"Or use the --with-default-root-credentials flag for development (sets root credentials to iggy/iggy)."},"4665":{"id":"/docs/server/security-16","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#username-and-password","content":"These variables initialize the root account only when it is first created. Supplied values are still validated on later starts, but they do not replace the stored credentials. Use the password-change API or iggy user password with the current password to change an existing account. The --fresh flag deletes all data. It is not needed for a password change."},"4666":{"id":"/docs/server/security-17","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#username-and-password","content":"The root user cannot be deleted, and its permissions are fixed: it always holds every permission."},"4667":{"id":"/docs/server/security-18","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#personal-access-tokens-pat","content":"PATs provide programmatic access with optional expiry. Each user can have up to max_tokens_per_user (default 100) stored tokens, including expired tokens until the cleaner removes them. Tokens are hashed before storage and can be revoked at any time."},"4668":{"id":"/docs/server/security-19","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#personal-access-tokens-pat","content":"An automatic cleaner removes expired tokens at a configurable interval."},"4669":{"id":"/docs/server/security-20","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#personal-access-tokens-pat","content":"Broker API commands require an authenticated session or bearer credential, except for ping and the login/refresh flows that establish or prove a credential. The Prometheus /metrics scrape requires a JWT or personal access token. HTTP CORS preflight responses and embedded /ui static assets are public. The UI's broker API calls still require authentication."},"4670":{"id":"/docs/server/security-21","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"Iggy provides granular permissions at three levels:"},"4671":{"id":"/docs/server/security-22","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"Global permissions - apply to the whole server and all streams"},"4672":{"id":"/docs/server/security-23","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"Stream permissions - scoped to one stream and all its topics"},"4673":{"id":"/docs/server/security-24","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"Topic permissions - scoped to one topic within a stream"},"4674":{"id":"/docs/server/security-25","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"The root user has full access to everything and bypasses all permission checks. Other users can be assigned specific permissions using the CLI, HTTP API, SDK, or Web UI."},"4675":{"id":"/docs/server/security-26","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"The global permissions and the operations they unlock:"},"4676":{"id":"/docs/server/security-27","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Operation"},"4677":{"id":"/docs/server/security-28","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Required global permission"},"4678":{"id":"/docs/server/security-29","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Get server stats"},"4679":{"id":"/docs/server/security-30","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"read_servers"},"4680":{"id":"/docs/server/security-31","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Diagnostic snapshot and metadata changes"},"4681":{"id":"/docs/server/security-32","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"manage_servers"},"4682":{"id":"/docs/server/security-33","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"List clients, get client"},"4683":{"id":"/docs/server/security-34","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"read_servers"},"4684":{"id":"/docs/server/security-35","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Create, update, delete users. Update permissions. Change passwords"},"4685":{"id":"/docs/server/security-36","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"manage_users"},"4686":{"id":"/docs/server/security-37","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Get user, list users"},"4687":{"id":"/docs/server/security-38","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"read_users"},"4688":{"id":"/docs/server/security-39","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Create, update, delete streams"},"4689":{"id":"/docs/server/security-40","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"manage_streams"},"4690":{"id":"/docs/server/security-41","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Get stream, list streams"},"4691":{"id":"/docs/server/security-42","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"read_streams"},"4692":{"id":"/docs/server/security-43","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Create, update, delete topics"},"4693":{"id":"/docs/server/security-44","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"manage_topics"},"4694":{"id":"/docs/server/security-45","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Get topic, list topics"},"4695":{"id":"/docs/server/security-46","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"read_topics"},"4696":{"id":"/docs/server/security-47","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Consumer groups: create, delete, join, leave, get"},"4697":{"id":"/docs/server/security-48","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"read_topics"},"4698":{"id":"/docs/server/security-49","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Poll messages"},"4699":{"id":"/docs/server/security-50","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"poll_messages"},"4700":{"id":"/docs/server/security-51","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Send messages"},"4701":{"id":"/docs/server/security-52","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"send_messages"},"4702":{"id":"/docs/server/security-53","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Two kinds of implication apply on top of the table:"},"4703":{"id":"/docs/server/security-54","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Supersets: every manage_* permission includes its read_* counterpart. In addition manage_streams includes manage_topics, read_streams includes read_topics, and read_topics includes poll_messages. manage_topics also includes send_messages, so manage_streams permits sending too."},"4704":{"id":"/docs/server/security-55","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Self-service: an authenticated user can always read their own account, change their own password, and manage their own personal access tokens, without any of the user permissions above."},"4705":{"id":"/docs/server/security-56","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#scoped-permissions","content":"Instead of (or in addition to) global grants, permissions can be scoped per stream and per topic:"},"4706":{"id":"/docs/server/security-57","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#scoped-permissions","content":"Stream scope: manage_stream, read_stream, manage_topics, read_topics, poll_messages, send_messages, plus an optional per-topic map. read_stream includes read_topics and poll_messages within that stream."},"4707":{"id":"/docs/server/security-58","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#scoped-permissions","content":"Topic scope: manage_topic, read_topic, poll_messages, send_messages. read_topic includes poll_messages on that topic."},"4708":{"id":"/docs/server/security-59","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"Permissions are checked from top to bottom: global, then stream, then topic. A permission granted at a higher level covers everything below it:"},"4709":{"id":"/docs/server/security-60","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"Global poll_messages lets the user poll messages from all streams and topics."},"4710":{"id":"/docs/server/security-61","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"Stream-scoped poll_messages on stream 1 lets the user poll from all topics in stream 1, but not from other streams."},"4711":{"id":"/docs/server/security-62","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"Topic-scoped poll_messages on topic 5 of stream 1 lets the user poll only from that topic."},"4712":{"id":"/docs/server/security-63","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"If a stream has no entry in the user's stream permissions, only global permissions apply to it. The same holds for topics within a stream."},"4713":{"id":"/docs/server/security-64","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"For example, a user that may only consume from stream 42 needs no global permissions at all: grant stream-scoped read_stream and poll_messages on stream 42, and the user can read that stream, list its topics, and poll messages from any topic in it. The read grant also permits consumer-group operations in that stream. For polling without those read and group permissions, grant only poll_messages."},"4714":{"id":"/docs/server/security-65","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"Each transport configures TLS in its own section, and the self_signed semantics differ per transport:"},"4715":{"id":"/docs/server/security-66","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"Transport"},"4716":{"id":"/docs/server/security-67","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"Section"},"4717":{"id":"/docs/server/security-68","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"Behavior"},"4718":{"id":"/docs/server/security-69","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"TCP"},"4719":{"id":"/docs/server/security-70","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"[tcp.tls]"},"4720":{"id":"/docs/server/security-71","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"self_signed = true generates an ephemeral certificate only while cert_file does not exist. An existing PEM pair is loaded instead."},"4721":{"id":"/docs/server/security-72","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"WebSocket"},"4722":{"id":"/docs/server/security-73","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"[websocket.tls]"},"4723":{"id":"/docs/server/security-74","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"Same load-or-generate rule as TCP."},"4724":{"id":"/docs/server/security-75","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"QUIC"},"4725":{"id":"/docs/server/security-76","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"[quic.certificate]"},"4726":{"id":"/docs/server/security-77","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"TLS is mandatory (part of the QUIC spec). self_signed = true always generates an ephemeral certificate and ignores cert_file/key_file, logging a warning if the files exist."},"4727":{"id":"/docs/server/security-78","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"HTTP"},"4728":{"id":"/docs/server/security-79","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"[http.tls]"},"4729":{"id":"/docs/server/security-80","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"No self_signed option: HTTPS requires certificate and key files in cert_file/key_file."},"4730":{"id":"/docs/server/security-81","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"For production deployments, provide proper certificates via cert_file and key_file. Ephemeral certificates change on every start, so a trust configuration pinned to one generated certificate does not survive a restart. See Networking for the surrounding transport configuration."},"4731":{"id":"/docs/server/security-82","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#data-encryption-at-rest","content":"Each encrypted stream has its own AES-256-GCM-SIV data key. The server encrypts message payloads and user headers before storage and decrypts them for polling. Metadata journals, metadata snapshots and structural headers are not encrypted as a whole."},"4732":{"id":"/docs/server/security-83","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#data-encryption-at-rest","content":"When encryption.enabled is true, the server generates a key for each new stream. A client can also supply a stream key at creation. The server wraps that key with a key derived from encryption.key. Reads expose fingerprints, never keys."},"4733":{"id":"/docs/server/security-84","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#data-encryption-at-rest","content":"Set IGGY_ENCRYPTION_KEY to the standard base64 encoding of 32 random bytes before starting this configuration. Enabling encryption does not change existing unencrypted streams. Follow Stream options to create keyed streams and rotate the server key without re-encrypting messages."},"4734":{"id":"/docs/server/security-85","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#jwt-http-api","content":"The HTTP API uses JWT (JSON Web Tokens) for session management. Tokens are signed with HS256 by default and have configurable expiry, clock skew tolerance, and audience/issuer validation:"},"4735":{"id":"/docs/server/security-86","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#jwt-http-api","content":"Further keys (valid_issuers, valid_audiences, not_before, use_base64_secret, the signing secrets) are covered in Configuration."},"4736":{"id":"/docs/server/security-87","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#jwt-http-api","content":"Signing secrets: encoding_secret and decoding_secret default to empty. Without cluster.auth, the server generates a secure random secret on every start. That's a safe single-node default with two consequences: issued tokens die on restart, and in a cluster each node signs with its own key, so bearers are node-local and follower-to-primary request forwarding stays disabled. For clusters, configure an identical secret on every node (prefer the IGGY_HTTP_JWT_ENCODING_SECRET/IGGY_HTTP_JWT_DECODING_SECRET environment variables over on-disk config), or enable cluster.auth so the JWT key derives from the cluster's shared PSK."},"4737":{"id":"/docs/server/security-88","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#jwt-http-api","content":"Refresh tokens: POST /users/refresh-token re-issues an access token from a still-valid one presented in the request body, answering the same identity shape as login, so HTTP clients can extend a session without re-sending credentials."},"4738":{"id":"/docs/server/security-89","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#jwt-http-api","content":"Federated issuers: the opt-in [[http.jwt.trusted_issuers]] list accepts tokens minted by external identity providers for application-to-application flows. Each entry names an issuer, audience, and jwks_url. Signatures are verified against the issuer's JWKS (fetches are rate-limited), and every token from that issuer is remapped onto the configured non-root username. With no entries configured, the listener accepts only self-issued tokens. See Configuration for the key reference."},"4739":{"id":"/docs/server/security-90","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#cluster-security","content":"In cluster mode, replica-to-replica traffic can require an authenticated handshake based on a pre-shared key (with a documented rolling rotation procedure) and can be wrapped in TLS 1.3. With cluster.auth enabled and no JWT secrets configured, the PSK also becomes the cluster-wide JWT key source. See Clustering security."},"4740":{"id":"/docs/server/storage-engine","page_id":"/docs/server/storage-engine","type":"page","content":"Storage Engine","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/storage-engine"},"4741":{"id":"/docs/server/storage-engine-0","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine","content":"The segmented append-only log, and how streams, topics, partitions and segments map onto files on disk."},"4742":{"id":"/docs/server/storage-engine-1","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#directory-layout","content":"Directory layout"},"4743":{"id":"/docs/server/storage-engine-2","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#segmented-log","content":"Segmented log"},"4744":{"id":"/docs/server/storage-engine-3","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#on-disk-batch-format","content":"On-disk batch format"},"4745":{"id":"/docs/server/storage-engine-4","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#indexes","content":"Indexes"},"4746":{"id":"/docs/server/storage-engine-5","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#write-pipeline","content":"Write pipeline"},"4747":{"id":"/docs/server/storage-engine-6","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#boot-time-segment-recovery","content":"Boot-time segment recovery"},"4748":{"id":"/docs/server/storage-engine-7","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#read-integrity","content":"Read integrity"},"4749":{"id":"/docs/server/storage-engine-8","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#memory-pool","content":"Memory pool"},"4750":{"id":"/docs/server/storage-engine-9","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#retention-and-cleanup","content":"Retention and cleanup"},"4751":{"id":"/docs/server/storage-engine-10","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#metadata-plane","content":"Metadata plane"},"4752":{"id":"/docs/server/storage-engine-11","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#encryption","content":"Encryption"},"4753":{"id":"/docs/server/storage-engine-12","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#compression","content":"Compression"},"4754":{"id":"/docs/server/storage-engine-13","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"Removed and relocated settings"},"4755":{"id":"/docs/server/storage-engine-14","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#bounded-partition-file-work","content":"Bounded partition file work"},"4756":{"id":"/docs/server/storage-engine-15","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine","content":"Iggy's storage engine is built around the concept of a segmented append-only log. Message data follows a hierarchy: System -> Streams -> Topics -> Partitions -> Segments. This page covers how data is stored, indexed, flushed, recovered, and cleaned up on disk."},"4757":{"id":"/docs/server/storage-engine-16","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#directory-layout","content":"All data lives under the root path directory (default local_data, overridden with IGGY_PATH):"},"4758":{"id":"/docs/server/storage-engine-17","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#directory-layout","content":"Stream, topic, and partition ids are numeric and 0-based. Each partition directory holds pairs of .log and .index files. The filename is the segment's start offset, zero-padded to 20 digits. Recovery can create an empty active segment at a reserved offset beyond the last stored message. Next to the segments, every partition keeps its own superblock pair (replica identity and consensus state for that partition) and an offsets/ tree for consumer offset storage. Multi-replica partitions also keep a prepare WAL when either topic durability policy is persisted."},"4759":{"id":"/docs/server/storage-engine-18","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#segmented-log","content":"Each partition is a segmented log: an ordered list of sealed (read-only) segments plus one active (writable) segment. When the active segment reaches the topic's segment_size (default 1 GiB), it is sealed and a new active segment starts at the next offset."},"4760":{"id":"/docs/server/storage-engine-19","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#segmented-log","content":"segment_size is a per-topic creation option, bounded to a 512-byte multiple between 1 MiB and 1 GiB. It's a soft limit: rotation fires after the append that crosses it, so the crossing batch lands whole and a sealed segment may run one batch past the configured size. preallocate_segments (also per topic) reserves each segment's bytes up front on filesystems that support it. See Topic options."},"4761":{"id":"/docs/server/storage-engine-20","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#on-disk-batch-format","content":"Segments store batch records, not individual messages. The record is byte-identical to the wire encoding: the one layout a SendMessages body, the replicated prepare, the persisted segment record, and the poll reply all share. There is no other message encoding."},"4762":{"id":"/docs/server/storage-engine-21","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#on-disk-batch-format","content":"The 256-byte batch header carries partition_id, base_offset, base_timestamp, origin_timestamp, batch_length, batch_checksum (XxHash3-64), and message_count. An optional producer section carries a producer ID, epoch and sequence. Remaining reserved bytes must be zero. Each 48-byte frame header carries checksum (XxHash3-64), id (u128), offset_delta (u32), timestamp_delta (u32), and the two lengths. A message's absolute offset is base_offset + offset_delta. Its server timestamp is the flat base_timestamp, while timestamp_delta resolves producer time against origin_timestamp. All fields are little-endian, and records are stored contiguously with no padding."},"4763":{"id":"/docs/server/storage-engine-22","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#on-disk-batch-format","content":"The full byte-level tables live on the Message batches page. Absent at-rest encryption, what lands on disk is exactly what the producer sent, with the server stamping partition_id at admission and base_offset / base_timestamp (plus a batch_checksum recompute) at journal append."},"4764":{"id":"/docs/server/storage-engine-23","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Each segment has an accompanying .index file holding a sparse index: one 24-byte entry per flushed write, not per message."},"4765":{"id":"/docs/server/storage-engine-24","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Field"},"4766":{"id":"/docs/server/storage-engine-25","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Bytes"},"4767":{"id":"/docs/server/storage-engine-26","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Type"},"4768":{"id":"/docs/server/storage-engine-27","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Description"},"4769":{"id":"/docs/server/storage-engine-28","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"offset"},"4770":{"id":"/docs/server/storage-engine-29","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"0..8"},"4771":{"id":"/docs/server/storage-engine-30","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"u64"},"4772":{"id":"/docs/server/storage-engine-31","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Absolute offset of the flushed batch"},"4773":{"id":"/docs/server/storage-engine-32","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"timestamp"},"4774":{"id":"/docs/server/storage-engine-33","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"8..16"},"4775":{"id":"/docs/server/storage-engine-34","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"u64"},"4776":{"id":"/docs/server/storage-engine-35","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Timestamp of the flushed batch"},"4777":{"id":"/docs/server/storage-engine-36","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"position"},"4778":{"id":"/docs/server/storage-engine-37","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"16..24"},"4779":{"id":"/docs/server/storage-engine-38","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"u64"},"4780":{"id":"/docs/server/storage-engine-39","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Byte position of the batch start in the .log file"},"4781":{"id":"/docs/server/storage-engine-40","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Little-endian, no header, no padding. To serve a poll, the server binary-searches the index for the closest entry at or below the target offset (or timestamp), seeks to its position, and walks batch records from there. Because the index is a sparse hint, a lookup below the indexed range falls back to the segment start rather than failing."},"4782":{"id":"/docs/server/storage-engine-41","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"There is no index caching configuration: the in-memory index cache is an internal per-segment structure the server manages itself."},"4783":{"id":"/docs/server/storage-engine-42","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"Messages are admitted, stamped, and buffered in the partition journal. Their completion path depends on the topic's durability policy:"},"4784":{"id":"/docs/server/storage-engine-43","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"The flush thresholds and completion policies are per-topic creation options:"},"4785":{"id":"/docs/server/storage-engine-44","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"messages_required_to_save (default 1024): count threshold."},"4786":{"id":"/docs/server/storage-engine-45","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"size_of_messages_required_to_save (default 1 MiB): byte threshold."},"4787":{"id":"/docs/server/storage-engine-46","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"durability (default replicated): message completion policy. persisted requires recoverable stable storage at the replication quorum."},"4788":{"id":"/docs/server/storage-engine-47","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"consumer_offset_durability (default replicated): the independent policy for explicit offset stores and deletes."},"4789":{"id":"/docs/server/storage-engine-48","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"A full active segment also triggers an ordinary flush. These are soft limits: a flush writes whole committed batches, so the actual count or size can overshoot. Required persistence, capacity pressure, and lifecycle operations can flush below the thresholds. The settings do not define a periodic flush interval. The MessagesWriter uses vectored I/O with up to 1024 buffers per syscall, so many buffered batches can land in one write."},"4790":{"id":"/docs/server/storage-engine-49","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"With replicated, completion does not wait for an additional stable-storage barrier. With persisted, a single-replica partition flushes and synchronizes committed segment state before success. A multi-replica partition instead gates the required prepare acknowledgements on recoverable WAL history, so persisted success can precede an ordinary segment flush. messages_required_to_save=1 is not required."},"4791":{"id":"/docs/server/storage-engine-50","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"For multi-replica partitions, the disk prepare WAL is enabled when either policy is persisted and includes message payloads even if only the offset policy is persisted. Checkpoints synchronize materialized files before reclaiming WAL history. See Durability and Cluster Durability for completion guarantees and failure behavior."},"4792":{"id":"/docs/server/storage-engine-51","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#boot-time-segment-recovery","content":"At startup, recovery validates batch checksums, partition identity, and the segment chain before serving data. With message durability replicated, it walks the log from byte zero because buffered writeback can preserve later pages before earlier ones. With persisted, completed durable segment flushes allow an index-anchored recovery path."},"4793":{"id":"/docs/server/storage-engine-52","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#boot-time-segment-recovery","content":"A missing or torn sparse index can be rebuilt from valid log data. An incomplete tail can be truncated, but an interior gap, intact records after damage, or a contradiction with durable history can require recovery refusal. Recovery does not blindly truncate at the first invalid batch."},"4794":{"id":"/docs/server/storage-engine-53","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#boot-time-segment-recovery","content":"When a prepare WAL exists, recovery reconciles it with materialized segment and offset state. Unrecoverable partition data is fenced and repaired from peers when available. It must not be replaced by an empty healthy partition. A singleton has no peer copy to fetch."},"4795":{"id":"/docs/server/storage-engine-54","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#read-integrity","content":"Disk reads are verified before they reach a consumer:"},"4796":{"id":"/docs/server/storage-engine-55","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#read-integrity","content":"With validate_checksum = true (the default), every batch a disk poll reads is re-hashed and compared against its stored checksum. A mismatch stops the disk walk and logs an error on the server. The consumer receives any valid prefix already read, or an ordinary empty poll if none was read. The protocol does not report the checksum failure to the consumer. Repeated polls can therefore wait indefinitely at damaged data. Setting it to false skips the re-hash and serves whatever decodes, which can hand a consumer bytes provably not the ones written. Only disable it with a corruption guard elsewhere in the stack."},"4797":{"id":"/docs/server/storage-engine-56","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#read-integrity","content":"Binary polls reuse the stored batch layout. A reply may slice a larger stored batch and rewrite its header, and at-rest encryption requires decryption before the reply. HTTP additionally serializes the result as JSON."},"4798":{"id":"/docs/server/storage-engine-57","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#memory-pool","content":"Iggy includes a custom memory pool to reuse buffers on the hot path. The pool has 28 buckets with buffer sizes from 4 KiB up to 512 MiB (non-uniform spacing, denser around common message sizes, with sizes above 2 MiB rounded to hugepage-friendly steps). Components request a buffer from the appropriate bucket and return it when done."},"4799":{"id":"/docs/server/storage-engine-58","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#memory-pool","content":"Buffers are allocated lazily. A pool miss can allocate outside the pool, so message processing is not allocation-free. Internal components can pass ownership of existing buffers without copying their contents."},"4800":{"id":"/docs/server/storage-engine-59","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#retention-and-cleanup","content":"Two independent retention policies exist, both per-topic options configurable at creation or update (see Topic options). The segment cleaner enforces them:"},"4801":{"id":"/docs/server/storage-engine-60","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#retention-and-cleanup","content":"Size-based retention (max_topic_size): the cluster has no single owner of a topic-wide total, so each partition enforces an equal share: max_topic_size / partition_count, counted over sealed bytes. The share is floored at one sealed-segment ceiling (segment_size plus the maximum message-bus frame, since a sealed segment can overshoot by one batch). A cap that divides below that floor is raised to it, so the policy always means at least \"keep the newest sealed segment\". Once sealed bytes exceed the budget, the oldest sealed segments are trimmed. There is no percentage-based early trigger."},"4802":{"id":"/docs/server/storage-engine-61","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#retention-and-cleanup","content":"Time-based retention (message_expiry): sealed segments whose newest message is older than the expiry are deleted."},"4803":{"id":"/docs/server/storage-engine-62","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#retention-and-cleanup","content":"Both policies can be active at once. They only ever touch sealed segments. Deletion also stops at the minimum committed consumer or consumer-group offset, and pending persistence checkpoints can defer it. The active segment is never deleted by retention, even if its messages have expired."},"4804":{"id":"/docs/server/storage-engine-63","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#metadata-plane","content":"Metadata operations (create stream, delete topic, create user, and so on) do not use the partition storage above. They replicate through the metadata consensus group and persist in local_data/metadata/:"},"4805":{"id":"/docs/server/storage-engine-64","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#metadata-plane","content":"journal.wal: the prepare journal. Each entry is a 256-byte PrepareHeader (the consensus header carrying checksums, view, op and commit numbers, operation discriminant, and acting user) followed by the operation's wire-format body, exactly as replicated. This is the write-ahead log: an operation is journaled before it is applied."},"4806":{"id":"/docs/server/storage-engine-65","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#metadata-plane","content":"snapshot.bin: a MessagePack (rmp-serde) snapshot of the whole metadata state machine, written at checkpoints so the journal can be truncated. Recovery loads the snapshot, then replays journal entries newer than it, rebuilding the client session table alongside."},"4807":{"id":"/docs/server/storage-engine-66","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#metadata-plane","content":"superblock.a / superblock.b: a ping-pong pair of checkpoint records, where the newest valid slot wins by sequence number. The superblock records which checkpoint is current and the snapshot's checksum. Boot cross-checks the pairing: a superblock pointing at a checkpoint newer than the on-disk snapshot, or a snapshot whose checksum doesn't match the record, refuses to boot rather than silently rewinding committed state."},"4808":{"id":"/docs/server/storage-engine-67","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#metadata-plane","content":"Partition directories carry the same superblock mechanism for their own consensus state (replica identity, view), which is how a restarted replica proves it is itself rather than a blank impostor."},"4809":{"id":"/docs/server/storage-engine-68","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#encryption","content":"Iggy encrypts message payloads and user headers with a separate AES-256-GCM-SIV key per encrypted stream. They are encrypted before storage and decrypted for polling. Metadata journals, metadata snapshots, and structural record headers remain unencrypted. The key must decode from base64 to 32 bytes. See Security."},"4810":{"id":"/docs/server/storage-engine-69","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#compression","content":"The compression_algorithm topic option accepts none (default) and gzip, but it is a placeholder today: the value is persisted and reported back, but no message compression is applied. Payload encryption still applies when enabled. To compress today, do it client-side and tag messages via user headers - see the message headers examples in the Iggy repo."},"4811":{"id":"/docs/server/storage-engine-70","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"Earlier releases documented several storage features and [system.*] keys that no longer exist:"},"4812":{"id":"/docs/server/storage-engine-71","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"cache_indexes: removed. Index caching is internal now (see Indexes)."},"4813":{"id":"/docs/server/storage-engine-72","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"[system.message_deduplication]: removed configuration. It does not configure the partition request deduplication table."},"4814":{"id":"/docs/server/storage-engine-73","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"Segment archiving / S3 backup placeholders: removed. Delete archive_expired and the old [system.segment] table rather than retaining a false value."},"4815":{"id":"/docs/server/storage-engine-74","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"enforce_fsync: replaced by the topic durability policy. Consumer-offset completion has its own consumer_offset_durability policy. Both default independently to replicated."},"4816":{"id":"/docs/server/storage-engine-75","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"[system.*] tables: removed or moved to root tables. Retention, segment size, preallocation, and flush thresholds are per-topic options."},"4817":{"id":"/docs/server/storage-engine-76","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"The config loader rejects the old [system] table and IGGY_SYSTEM_* environment mappings. The full mapping is in Relocated configuration keys."},"4818":{"id":"/docs/server/storage-engine-77","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#bounded-partition-file-work","content":"Partition file operations run as bounded jobs. sharding.partition_io_capacity limits active jobs and results waiting for their owner. partition_io_bytes_max limits retained allocations. Exhausted capacity queues work instead of letting one slow disk operation block every partition on its shard."},"4819":{"id":"/docs/server/storage-engine-78","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#bounded-partition-file-work","content":"The current storage format is incompatible with 0.9 data directories. Boot checks it before metadata replay. Preserve old files for rollback and use a fresh directory for 0.10. See Upgrading."},"4820":{"id":"/docs/server/stream-options","page_id":"/docs/server/stream-options","type":"page","content":"Stream Options","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/stream-options"},"4821":{"id":"/docs/server/stream-options-0","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options","content":"Stream names, per-stream encryption keys and server key rotation."},"4822":{"id":"/docs/server/stream-options-1","page_id":"/docs/server/stream-options","type":"heading","tags":[],"url":"/docs/server/stream-options#select-encryption-at-creation","content":"Select encryption at creation"},"4823":{"id":"/docs/server/stream-options-2","page_id":"/docs/server/stream-options","type":"heading","tags":[],"url":"/docs/server/stream-options#create-a-stream-with-the-cli","content":"Create a stream with the CLI"},"4824":{"id":"/docs/server/stream-options-3","page_id":"/docs/server/stream-options","type":"heading","tags":[],"url":"/docs/server/stream-options#read-the-catalog","content":"Read the catalog"},"4825":{"id":"/docs/server/stream-options-4","page_id":"/docs/server/stream-options","type":"heading","tags":[],"url":"/docs/server/stream-options#rotate-the-server-encryption-key","content":"Rotate the server encryption key"},"4826":{"id":"/docs/server/stream-options-5","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options","content":"A stream accepts options when it is created and when it is updated. Use name to rename a stream. Use encryption_key at creation to supply a data key for that stream. The server rejects changes or resets to an existing stream key."},"4827":{"id":"/docs/server/stream-options-6","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#select-encryption-at-creation","content":"Each encrypted stream uses a separate AES-256-GCM-SIV data key. The server encrypts message payloads and user headers before storage and decrypts them for reads. Metadata journals, snapshots and structural headers are not encrypted as a whole."},"4828":{"id":"/docs/server/stream-options-7","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#select-encryption-at-creation","content":"Creation request"},"4829":{"id":"/docs/server/stream-options-8","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#select-encryption-at-creation","content":"Server configuration"},"4830":{"id":"/docs/server/stream-options-9","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#select-encryption-at-creation","content":"Result"},"4831":{"id":"/docs/server/stream-options-10","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#select-encryption-at-creation","content":"No stream key"},"4832":{"id":"/docs/server/stream-options-11","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#select-encryption-at-creation","content":"encryption.enabled = false"},"4833":{"id":"/docs/server/stream-options-12","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#select-encryption-at-creation","content":"Unencrypted stream"},"4834":{"id":"/docs/server/stream-options-13","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#select-encryption-at-creation","content":"No stream key"},"4835":{"id":"/docs/server/stream-options-14","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#select-encryption-at-creation","content":"encryption.enabled = true with a configured key"},"4836":{"id":"/docs/server/stream-options-15","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#select-encryption-at-creation","content":"Server generates a stream key"},"4837":{"id":"/docs/server/stream-options-16","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#select-encryption-at-creation","content":"Explicit stream key"},"4838":{"id":"/docs/server/stream-options-17","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#select-encryption-at-creation","content":"Server encryption key configured"},"4839":{"id":"/docs/server/stream-options-18","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#select-encryption-at-creation","content":"Stream uses the supplied key"},"4840":{"id":"/docs/server/stream-options-19","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#select-encryption-at-creation","content":"An explicit key must contain 32 random bytes. The API accepts raw bytes or standard padded base64. Configure a server encryption key even when the client supplies the stream key. The server wraps the data key, which means it encrypts the key before storing it. The wrapping key derives from encryption.key."},"4841":{"id":"/docs/server/stream-options-20","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#select-encryption-at-creation","content":"The stream key travels in the create request. Use a transport with TLS. The server never returns the data key or its wrapped bytes. Reads report encryption_key_source as stream, server or none, and fingerprints for encrypted streams."},"4842":{"id":"/docs/server/stream-options-21","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#select-encryption-at-creation","content":"Enabling or disabling server encryption affects creation defaults. It does not change the encryption of existing streams. Renaming a stream preserves its key and stored messages."},"4843":{"id":"/docs/server/stream-options-22","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#create-a-stream-with-the-cli","content":"With a server encryption key configured, create a private key file and pass it to the CLI:"},"4844":{"id":"/docs/server/stream-options-23","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#create-a-stream-with-the-cli","content":"--stream-key-file configures server-side encryption for this stream. The CLI's separate --encryption-key option encrypts payloads on the client."},"4845":{"id":"/docs/server/stream-options-24","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"Option"},"4846":{"id":"/docs/server/stream-options-25","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"Access"},"4847":{"id":"/docs/server/stream-options-26","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"Meaning"},"4848":{"id":"/docs/server/stream-options-27","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"name"},"4849":{"id":"/docs/server/stream-options-28","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"Update"},"4850":{"id":"/docs/server/stream-options-29","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"Resource name, from 1 through 255 bytes"},"4851":{"id":"/docs/server/stream-options-30","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"encryption_key"},"4852":{"id":"/docs/server/stream-options-31","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"Create only, write only"},"4853":{"id":"/docs/server/stream-options-32","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"Stream data key"},"4854":{"id":"/docs/server/stream-options-33","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"encryption_key_source"},"4855":{"id":"/docs/server/stream-options-34","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"Read only"},"4856":{"id":"/docs/server/stream-options-35","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"Origin of the key, or none"},"4857":{"id":"/docs/server/stream-options-36","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"encryption_key_fingerprint"},"4858":{"id":"/docs/server/stream-options-37","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"Read only"},"4859":{"id":"/docs/server/stream-options-38","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"Fingerprint of the data key"},"4860":{"id":"/docs/server/stream-options-39","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"encryption_kek_fingerprint"},"4861":{"id":"/docs/server/stream-options-40","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"Read only"},"4862":{"id":"/docs/server/stream-options-41","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"Comma-separated fingerprints of the keys that wrap the data key"},"4863":{"id":"/docs/server/stream-options-42","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#read-the-catalog","content":"A fingerprint identifies a key without exposing it. It consists of 16 lowercase hexadecimal characters. It cannot replace a key during recovery."},"4864":{"id":"/docs/server/stream-options-43","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#rotate-the-server-encryption-key","content":"A key-encryption key (KEK) wraps stream data keys. Rotation changes the wraps and does not re-encrypt messages. The metadata primary replicates these changes. Each stream can hold up to three wraps."},"4865":{"id":"/docs/server/stream-options-44","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#rotate-the-server-encryption-key","content":"Set encryption.key to the new key and add the old key to encryption.previous_keys on every node. Restart nodes with the updated configuration. Retain the old key during this phase."},"4866":{"id":"/docs/server/stream-options-45","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#rotate-the-server-encryption-key","content":"Make sure that every node uses this configuration and every encrypted stream reports the new KEK fingerprint. The primary adds new wraps while preserving old ones."},"4867":{"id":"/docs/server/stream-options-46","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#rotate-the-server-encryption-key","content":"Empty previous_keys and add the old fingerprint to retired_kek_fingerprints on every node. The primary removes those wraps."},"4868":{"id":"/docs/server/stream-options-47","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#rotate-the-server-encryption-key","content":"Make sure that every stream no longer reports the retired fingerprint. Clear retired_kek_fingerprints on every node."},"4869":{"id":"/docs/server/stream-options-48","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#rotate-the-server-encryption-key","content":"previous_keys accepts at most two keys. Retire an old fingerprint before adding a fourth wrap. Do not discard keys needed by retained backups. Losing the only usable wrapping key makes the affected streams unreadable."},"4870":{"id":"/docs/server/stream-options-49","page_id":"/docs/server/stream-options","tags":[],"type":"text","url":"/docs/server/stream-options#rotate-the-server-encryption-key","content":"See Configuration for environment variables and Security for transport protection."},"4871":{"id":"/docs/server/testing","page_id":"/docs/server/testing","type":"page","content":"Testing with Iggy","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/testing"},"4872":{"id":"/docs/server/testing-0","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing","content":"Run the Iggy Docker image from your own test suite, with examples for Rust, Python and Node.js."},"4873":{"id":"/docs/server/testing-1","page_id":"/docs/server/testing","type":"heading","tags":[],"url":"/docs/server/testing#what-the-container-needs","content":"What the container needs"},"4874":{"id":"/docs/server/testing-2","page_id":"/docs/server/testing","type":"heading","tags":[],"url":"/docs/server/testing#rust","content":"Rust"},"4875":{"id":"/docs/server/testing-3","page_id":"/docs/server/testing","type":"heading","tags":[],"url":"/docs/server/testing#python","content":"Python"},"4876":{"id":"/docs/server/testing-4","page_id":"/docs/server/testing","type":"heading","tags":[],"url":"/docs/server/testing#nodejs","content":"Node.js"},"4877":{"id":"/docs/server/testing-5","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing","content":"Iggy has no embedded, in-process test server. The server ships as a binary, not a library, so a test suite can't start it in-process. To test against a real server, start the published Docker image when your tests start and stop it when they finish. The examples below use each language's testcontainers library to do that."},"4878":{"id":"/docs/server/testing-6","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#what-the-container-needs","content":"These settings apply whichever language your tests are in:"},"4879":{"id":"/docs/server/testing-7","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#what-the-container-needs","content":"seccomp=unconfined as a security option. Docker's default seccomp profile blocks the io_uring calls the server needs."},"4880":{"id":"/docs/server/testing-8","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#what-the-container-needs","content":"IGGY_ROOT_USERNAME and IGGY_ROOT_PASSWORD. A fresh standalone server requires them or the explicit development flag."},"4881":{"id":"/docs/server/testing-9","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#what-the-container-needs","content":"IGGY_TCP_ADDRESS=0.0.0.0:8090 and IGGY_NODE_ADVERTISED_ADDRESS=localhost. By default the server listens on 127.0.0.1 inside the container, which a mapped port can't reach. Listening on all addresses also needs an advertised address, or the server won't start. Apache Iggy 0.10.0 skips memory binding on a single-NUMA-node topology. The older Docker Desktop workaround is no longer required for that case. Use IGGY_SHARDING_CPU_ALLOCATION=all when you explicitly want CPU pinning without NUMA memory binding."},"4882":{"id":"/docs/server/testing-10","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#what-the-container-needs","content":"Wait for the server client listeners started log line before connecting. The server logs server running; waiting on shard threads earlier, before the port is open, and connecting on that line fails some of the time."},"4883":{"id":"/docs/server/testing-11","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#what-the-container-needs","content":"If the server exits with io_uring was denied locked memory, the container's locked-memory limit is too low for it. Raise it, as the --ulimit memlock=-1:-1 flag does in Docker & Helm."},"4884":{"id":"/docs/server/testing-12","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#rust","content":"This example uses testcontainers 0.27 and the iggy crate 0.12, which goes with server 0.10.0."},"4885":{"id":"/docs/server/testing-13","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#rust","content":"Run it with cargo test."},"4886":{"id":"/docs/server/testing-14","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#python","content":"This example uses testcontainers, pytest and pytest-asyncio with apache-iggy 0.10.0:"},"4887":{"id":"/docs/server/testing-15","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#python","content":"Run it with pytest -v."},"4888":{"id":"/docs/server/testing-16","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#nodejs","content":"This example uses testcontainers with apache-iggy 0.11.0, the Node.js SDK that goes with server 0.10.0, and the built-in node:test runner. testcontainers needs Node.js 22.19 or newer."},"4889":{"id":"/docs/server/testing-17","page_id":"/docs/server/testing","tags":[],"type":"text","url":"/docs/server/testing#nodejs","content":"Save it as iggy.test.mjs and run it with node --test."},"4890":{"id":"/docs/server/topic-options","page_id":"/docs/server/topic-options","type":"page","content":"Topic Options","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/topic-options"},"4891":{"id":"/docs/server/topic-options-0","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options","content":"Per-topic retention, durability and segment layout options, set when the topic is created."},"4892":{"id":"/docs/server/topic-options-1","page_id":"/docs/server/topic-options","type":"heading","tags":[],"url":"/docs/server/topic-options#the-catalog","content":"The catalog"},"4893":{"id":"/docs/server/topic-options-2","page_id":"/docs/server/topic-options","type":"heading","tags":[],"url":"/docs/server/topic-options#setting-options","content":"Setting options"},"4894":{"id":"/docs/server/topic-options-3","page_id":"/docs/server/topic-options","type":"heading","tags":[],"url":"/docs/server/topic-options#create-only-vs-updatable","content":"Create-only vs updatable"},"4895":{"id":"/docs/server/topic-options-4","page_id":"/docs/server/topic-options","type":"heading","tags":[],"url":"/docs/server/topic-options#replication-factor","content":"Replication factor"},"4896":{"id":"/docs/server/topic-options-5","page_id":"/docs/server/topic-options","type":"heading","tags":[],"url":"/docs/server/topic-options#discovering-the-catalog","content":"Discovering the catalog"},"4897":{"id":"/docs/server/topic-options-6","page_id":"/docs/server/topic-options","type":"heading","tags":[],"url":"/docs/server/topic-options#durability","content":"Durability"},"4898":{"id":"/docs/server/topic-options-7","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options","content":"Retention, durability, and segment layout are per-topic decisions, made when the topic is created. They used to be server-wide [system.*] keys, which gave every knob two homes. The server now refuses to boot on the old keys, and each topic carries its own values instead."},"4899":{"id":"/docs/server/topic-options-8","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options","content":"Options are key-value pairs sent with CreateTopic. Unknown keys are rejected at the edge, never skipped: a silently ignored knob would leave the client on server defaults with no way to find out. Streams and users have their own catalogs. See Stream options for stream keys and names. User updates accept username and status."},"4900":{"id":"/docs/server/topic-options-9","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Option"},"4901":{"id":"/docs/server/topic-options-10","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Default"},"4902":{"id":"/docs/server/topic-options-11","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Constraints"},"4903":{"id":"/docs/server/topic-options-12","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Description"},"4904":{"id":"/docs/server/topic-options-13","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"max_topic_size"},"4905":{"id":"/docs/server/topic-options-14","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"unlimited"},"4906":{"id":"/docs/server/topic-options-15","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"finite values at least segment_size"},"4907":{"id":"/docs/server/topic-options-16","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Topic-wide limit on sealed segment bytes, divided across partitions. The cleaner deletes eligible oldest sealed segments when a partition exceeds its share."},"4908":{"id":"/docs/server/topic-options-17","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"message_expiry"},"4909":{"id":"/docs/server/topic-options-18","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"none"},"4910":{"id":"/docs/server/topic-options-19","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Delete the oldest sealed segments whose newest message timestamp is older than this duration."},"4911":{"id":"/docs/server/topic-options-20","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"partition_resize_policy"},"4912":{"id":"/docs/server/topic-options-21","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"mutable"},"4913":{"id":"/docs/server/topic-options-22","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"mutable or fixed, create only"},"4914":{"id":"/docs/server/topic-options-23","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"fixed rejects partition additions and deletions. mutable permits layout changes without a bounded cutover or per-key ordering across layouts."},"4915":{"id":"/docs/server/topic-options-24","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"replication_factor"},"4916":{"id":"/docs/server/topic-options-25","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Server default, initially all"},"4917":{"id":"/docs/server/topic-options-26","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"1 through 32 and no greater than cluster membership, create only"},"4918":{"id":"/docs/server/topic-options-27","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Number of nodes that store each partition."},"4919":{"id":"/docs/server/topic-options-28","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"compression_algorithm"},"4920":{"id":"/docs/server/topic-options-29","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"none"},"4921":{"id":"/docs/server/topic-options-30","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"none or gzip"},"4922":{"id":"/docs/server/topic-options-31","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Placeholder: stored and reported, no compression applied yet."},"4923":{"id":"/docs/server/topic-options-32","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"segment_size"},"4924":{"id":"/docs/server/topic-options-33","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"1 GiB"},"4925":{"id":"/docs/server/topic-options-34","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"0 selects the default. Otherwise a 512-byte multiple from 1 MiB through 1 GiB"},"4926":{"id":"/docs/server/topic-options-35","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Soft size limit per segment: a segment may close one whole batch past it."},"4927":{"id":"/docs/server/topic-options-36","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"durability"},"4928":{"id":"/docs/server/topic-options-37","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"replicated"},"4929":{"id":"/docs/server/topic-options-38","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"replicated or persisted"},"4930":{"id":"/docs/server/topic-options-39","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Message completion policy. persisted requires recoverable stable-storage copies at the replication quorum before success."},"4931":{"id":"/docs/server/topic-options-40","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"consumer_offset_durability"},"4932":{"id":"/docs/server/topic-options-41","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"replicated"},"4933":{"id":"/docs/server/topic-options-42","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"replicated or persisted"},"4934":{"id":"/docs/server/topic-options-43","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Completion policy for explicit consumer-offset stores and deletes, independent of message durability."},"4935":{"id":"/docs/server/topic-options-44","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"messages_required_to_save"},"4936":{"id":"/docs/server/topic-options-45","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"1024"},"4937":{"id":"/docs/server/topic-options-46","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"non-zero, at most 16777216"},"4938":{"id":"/docs/server/topic-options-47","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Flush the journal once it holds this many messages."},"4939":{"id":"/docs/server/topic-options-48","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"size_of_messages_required_to_save"},"4940":{"id":"/docs/server/topic-options-49","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"1 MiB"},"4941":{"id":"/docs/server/topic-options-50","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"0 selects the default. At most 1 GiB"},"4942":{"id":"/docs/server/topic-options-51","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Flush the journal once it holds this many bytes. Paired with the message count. Whichever threshold trips first flushes."},"4943":{"id":"/docs/server/topic-options-52","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"preallocate_segments"},"4944":{"id":"/docs/server/topic-options-53","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"false"},"4945":{"id":"/docs/server/topic-options-54","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"segment_size x partitions at most 64 GiB per create"},"4946":{"id":"/docs/server/topic-options-55","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Reserve each segment's bytes up front where the filesystem supports it."},"4947":{"id":"/docs/server/topic-options-56","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Both retention policies can be active at once. The active segment is never touched, and its bytes are excluded from the size limit. A segment whose end offset exceeds the lowest stored consumer or consumer-group offset is retained. With no stored offsets, this barrier is absent. Deletion is done by the server's segment cleaner ([data_maintenance.messages], enabled by default)."},"4948":{"id":"/docs/server/topic-options-57","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Both durability policies write data to disk and default independently to replicated. Neither inherits the other. Flush thresholds schedule ordinary segment writes. Required persistence, capacity pressure, or lifecycle operations can flush earlier. They do not weaken the persisted completion guarantee."},"4949":{"id":"/docs/server/topic-options-58","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Value forms are forgiving: byte sizes accept a raw number of bytes or a string like \"128 MiB\", expiry accepts microseconds or a humantime string like \"7 days\", booleans accept true/false. Create admission re-parses and re-encodes what you send, so a string segment_size=128MiB is stored as the number it names."},"4950":{"id":"/docs/server/topic-options-59","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"preallocate_segments requests a segment_size reservation for each partition's segment file when it is opened, including during topic creation and rotation. On Linux this reserves disk space without changing the file's logical length. Unsupported or failed reservations log a warning and fall back to ordinary allocation. With the default 1 GiB segment size, the request is 1 GiB per partition up front, which is why it's opt-in and why one create is capped at 64 GiB of requested reservation."},"4951":{"id":"/docs/server/topic-options-60","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#setting-options","content":"At creation, every interface takes the same keys:"},"4952":{"id":"/docs/server/topic-options-61","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#setting-options","content":"In the CLI, both durability policies have named flags. --set is repeatable and covers other storage options, such as segment_size. compression_algorithm, message_expiry, and max_topic_size also have first-class parameters. Run iggy options topic to discover what the server accepts."},"4953":{"id":"/docs/server/topic-options-62","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#setting-options","content":"SDKs expose typed durability values in their topic creation options. In Rust, set TopicCreateOptions::durability and TopicCreateOptions::consumer_offset_durability to Durability::Replicated or Durability::Persisted. The HTTP API takes \"durability\" and \"consumer_offset_durability\" as string values in the create body's options map."},"4954":{"id":"/docs/server/topic-options-63","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#setting-options","content":"Keys absent from the wire request are resolved by the admitting server and stored as derived entries. Typed SDKs can send their default durability values explicitly. Binary GetTopic responses carry explicit and derived blocks. HTTP reports an explicit flag per option. Both report option values and the provenance of the request. Updates preserve the values and provenance of keys outside the patch."},"4955":{"id":"/docs/server/topic-options-64","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#create-only-vs-updatable","content":"Updates use UpdateResource with a set/reset patch. SDKs retain resource-specific update methods, but these methods send the shared command. Only name, message_expiry and max_topic_size can change on a topic."},"4956":{"id":"/docs/server/topic-options-65","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#create-only-vs-updatable","content":"An absent key keeps its value. In HTTP, null also leaves a value unchanged. A name in reset returns that option to the server default and marks it as derived. Do not send the same key in both sets. Unknown keys, read-only keys and create-only changes are rejected. An empty patch, including a patch with only null values or zero sentinels, is rejected."},"4957":{"id":"/docs/server/topic-options-66","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#create-only-vs-updatable","content":"HTTP updates use a flat JSON object, not a nested options object:"},"4958":{"id":"/docs/server/topic-options-67","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#create-only-vs-updatable","content":"compression_algorithm, segment_size, both durability policies, flush thresholds, preallocate_segments, partition_resize_policy and replication_factor are create-only. Select them before creating the topic. A finite size limit must still be at least the segment size."},"4959":{"id":"/docs/server/topic-options-68","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#replication-factor","content":"When replication_factor is absent, the server resolves cluster.default_replication_factor and stores the result with the topic. The default all uses every cluster node. A later server configuration change does not change existing topics."},"4960":{"id":"/docs/server/topic-options-69","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#replication-factor","content":"A factor of one stores one copy. Replicated durability can acknowledge it before stable storage. A factor of two requires both replicas to make progress. Three copies tolerate one unavailable replica. See Cluster durability for larger quorum rules."},"4961":{"id":"/docs/server/topic-options-70","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#replication-factor","content":"The example needs a cluster with at least three nodes. The metadata group still spans the full cluster, independent of each topic's factor."},"4962":{"id":"/docs/server/topic-options-71","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#discovering-the-catalog","content":"Ask the server which keys it accepts, with their types, defaults, and descriptions:"},"4963":{"id":"/docs/server/topic-options-72","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#discovering-the-catalog","content":"For HTTP, set IGGY_TOKEN to a valid JWT or personal access token:"},"4964":{"id":"/docs/server/topic-options-73","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#discovering-the-catalog","content":"The Rust SDK exposes the same call as describe_options. The scope is topic, stream, or user."},"4965":{"id":"/docs/server/topic-options-74","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#discovering-the-catalog","content":"Discovery matters most on the binary transports: TCP, QUIC, and WebSocket carry only an error code for a rejected key, not its name, so the catalog is how a client finds out what this server supports. Over HTTP the error message names the offending key directly."},"4966":{"id":"/docs/server/topic-options-75","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#durability","content":"replicated waits for quorum commit and application without an additional stable-storage barrier. persisted also requires recoverable stable-storage copies at the required quorum. On a single node that means recoverable local persistence before success. In a cluster it uses durable prepare history. Setting messages_required_to_save=1 is not required for persisted."},"4967":{"id":"/docs/server/topic-options-76","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#durability","content":"The former enforce_fsync option is rejected. Use durability for messages and consumer_offset_durability for explicit offset changes. Poll auto-commit remains asynchronous, and HTTP ack=none confirms dispatch only, regardless of these policies."},"4968":{"id":"/docs/server/topic-options-77","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#durability","content":"See Durability for single-node failure behavior and Cluster Durability for the quorum and WAL guarantees."},"4969":{"id":"/docs/server/upgrading","page_id":"/docs/server/upgrading","type":"page","content":"Upgrading from 0.9 to 0.10","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/upgrading"},"4970":{"id":"/docs/server/upgrading-0","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading","content":"Prepare a fresh data directory, matching clients and updated configuration for Apache Iggy 0.10.0."},"4971":{"id":"/docs/server/upgrading-1","page_id":"/docs/server/upgrading","type":"heading","tags":[],"url":"/docs/server/upgrading#preserve-data-before-the-upgrade","content":"Preserve data before the upgrade"},"4972":{"id":"/docs/server/upgrading-2","page_id":"/docs/server/upgrading","type":"heading","tags":[],"url":"/docs/server/upgrading#upgrade-clients-and-tools","content":"Upgrade clients and tools"},"4973":{"id":"/docs/server/upgrading-3","page_id":"/docs/server/upgrading","type":"heading","tags":[],"url":"/docs/server/upgrading#review-server-configuration","content":"Review server configuration"},"4974":{"id":"/docs/server/upgrading-4","page_id":"/docs/server/upgrading","type":"heading","tags":[],"url":"/docs/server/upgrading#review-consumer-checkpoints","content":"Review consumer checkpoints"},"4975":{"id":"/docs/server/upgrading-5","page_id":"/docs/server/upgrading","type":"heading","tags":[],"url":"/docs/server/upgrading#review-encryption","content":"Review encryption"},"4976":{"id":"/docs/server/upgrading-6","page_id":"/docs/server/upgrading","type":"heading","tags":[],"url":"/docs/server/upgrading#check-the-cutover","content":"Check the cutover"},"4977":{"id":"/docs/server/upgrading-7","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading","content":"Apache Iggy 0.10.0 changes the wire protocol, data directory format and public SDK APIs. Upgrade the server and clients together. These docs describe the upcoming 0.10.0 release. The release vote tracks its publication."},"4978":{"id":"/docs/server/upgrading-8","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#preserve-data-before-the-upgrade","content":"There is no migration from a 0.9.x data directory. Keep a backup and export messages that you need with the old server and compatible clients. Start 0.10.0 with a separate, empty data directory. Import the retained data through a compatible client. Do not point the new server at the old directory."},"4979":{"id":"/docs/server/upgrading-9","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#preserve-data-before-the-upgrade","content":"Do not use a rolling upgrade between server versions. Every cluster node must run the same server version. Keep the old deployment and its data available until you finish the cutover checks."},"4980":{"id":"/docs/server/upgrading-10","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#upgrade-clients-and-tools","content":"Server 0.10.0 uses protocol 0.12.0. The server rejects incompatible binary clients at login. Use the versions in Server compatibility. The 0.9 documentation remains available for the old deployment."},"4981":{"id":"/docs/server/upgrading-11","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#upgrade-clients-and-tools","content":"Review API changes before recompiling applications. Resource creation uses typed options. Updates change only the fields supplied through set/reset patches. Stream and topic purge, flush unsaved buffer, and the old UpdateStream, UpdateTopic and UpdateUser wire commands are removed. The SDK update methods use UpdateResource internally."},"4982":{"id":"/docs/server/upgrading-12","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#upgrade-clients-and-tools","content":"Rust stream builders take stream and topic names, without caller-assigned IDs. Python requires Python 3.11 or later. The SDK guides describe the release APIs and examples."},"4983":{"id":"/docs/server/upgrading-13","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#review-server-configuration","content":"Compare your configuration with the 0.10 reference. Do not copy obsolete keys into the new deployment."},"4984":{"id":"/docs/server/upgrading-14","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#review-server-configuration","content":"Set IGGY_ROOT_USERNAME and IGGY_ROOT_PASSWORD before first boot. The server no longer generates a root password. Use --with-default-root-credentials only for development."},"4985":{"id":"/docs/server/upgrading-15","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#review-server-configuration","content":"Remove consumer_group.session_timeout. Session expiry derives from heartbeat.interval with a factor of 1.2. consumer_group.heartbeat_interval controls membership heartbeat pacing."},"4986":{"id":"/docs/server/upgrading-16","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#review-server-configuration","content":"Replace user_id with username in http.jwt.trusted_issuers. The mapped account must exist and cannot be root. HTTP clients and the Web UI must log in again because old self-issued access and refresh tokens are rejected."},"4987":{"id":"/docs/server/upgrading-17","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#review-server-configuration","content":"Supply a valid logging.level. An invalid filter stops startup. Log files rotate by size, with retention and total-size cleanup."},"4988":{"id":"/docs/server/upgrading-18","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#review-server-configuration","content":"Keep cluster.coordinator.replica_connections_per_peer identical on all nodes. Cluster membership is limited to 32 nodes."},"4989":{"id":"/docs/server/upgrading-19","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#review-server-configuration","content":"Keep node clocks synchronized. Authenticated HTTP forwarding uses short-lived proofs."},"4990":{"id":"/docs/server/upgrading-20","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#review-server-configuration","content":"New topics inherit cluster.default_replication_factor, which defaults to all. Select a different factor at topic creation with replication_factor. Existing topics retain their stored value. See Multi-leader partitions."},"4991":{"id":"/docs/server/upgrading-21","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#review-consumer-checkpoints","content":"A checkpoint records how far a consumer processed a partition. The current poll API defaults to manual commits. Rust high-level consumers also default to manual commits, and the stream builder starts with PollingStrategy::next()."},"4992":{"id":"/docs/server/upgrading-22","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#review-consumer-checkpoints","content":"Store offsets after processing, or select an explicit automatic commit policy. Without stored offsets, a restarted consumer can read retained messages again. Committing on read can advance the offset before application processing. See Deferred polling."},"4993":{"id":"/docs/server/upgrading-23","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#review-consumer-checkpoints","content":"Connector sinks use deferred polling. Replace poll_interval with max_wait and min_count. The runtime rejects a sink configuration that still sets poll_interval."},"4994":{"id":"/docs/server/upgrading-24","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#review-encryption","content":"Encryption is selected when a stream is created. Each encrypted stream has its own data key. Enabling server encryption does not encrypt an existing unencrypted stream. Keep all keys required to read retained streams and backups. See Stream options for key creation and rotation."},"4995":{"id":"/docs/server/upgrading-25","page_id":"/docs/server/upgrading","tags":[],"type":"text","url":"/docs/server/upgrading#check-the-cutover","content":"Run producers and consumers against the new deployment before moving application traffic. Test resource creation, permissions, message payloads and headers, checkpoints, and reconnects. For a cluster, also test requests to different partition primaries and node failure. An accepted write and a processed message are different events. Select the required durability policies and commit behavior explicitly."},"4996":{"id":"/docs/connectors/sources/elasticsearch","page_id":"/docs/connectors/sources/elasticsearch","type":"page","content":"Elasticsearch Source","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/elasticsearch"},"4997":{"id":"/docs/connectors/sources/elasticsearch-0","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch","content":"Poll documents from an Elasticsearch index into Iggy streams, incrementally when a timestamp field is configured."},"4998":{"id":"/docs/connectors/sources/elasticsearch-1","page_id":"/docs/connectors/sources/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sources/elasticsearch#configuration","content":"Configuration"},"4999":{"id":"/docs/connectors/sources/elasticsearch-2","page_id":"/docs/connectors/sources/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Plugin config options"},"5000":{"id":"/docs/connectors/sources/elasticsearch-3","page_id":"/docs/connectors/sources/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sources/elasticsearch#how-polling-works","content":"How Polling Works"},"5001":{"id":"/docs/connectors/sources/elasticsearch-4","page_id":"/docs/connectors/sources/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sources/elasticsearch#state","content":"State"},"5002":{"id":"/docs/connectors/sources/elasticsearch-5","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch","content":"The Elasticsearch source connector polls documents from an Elasticsearch index and produces them to Iggy streams. With a timestamp field configured, it filters searches using the last acknowledged timestamp. This is a timestamp watermark, with the limitations described below."},"5003":{"id":"/docs/connectors/sources/elasticsearch-6","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#configuration","content":"Use the broker credentials and main runtime configuration from the source guide. From the matching 0.10.0 Iggy checkout root, build the plugin:"},"5004":{"id":"/docs/connectors/sources/elasticsearch-7","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#configuration","content":"For this local example, start Elasticsearch with authentication disabled:"},"5005":{"id":"/docs/connectors/sources/elasticsearch-8","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#configuration","content":"Wait until the health response reports timed_out: false, then create the source index and a document:"},"5006":{"id":"/docs/connectors/sources/elasticsearch-9","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#configuration","content":"Save this connector entry in the runtime's connector directory. Start the runtime from the checkout root so the plugin path resolves."},"5007":{"id":"/docs/connectors/sources/elasticsearch-10","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#configuration","content":"Create the destination before starting the runtime:"},"5008":{"id":"/docs/connectors/sources/elasticsearch-11","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#configuration","content":"Start the runtime as described in the source guide. After the configured 30-second polling delay, read the produced message:"},"5009":{"id":"/docs/connectors/sources/elasticsearch-12","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Option"},"5010":{"id":"/docs/connectors/sources/elasticsearch-13","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Type"},"5011":{"id":"/docs/connectors/sources/elasticsearch-14","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Default"},"5012":{"id":"/docs/connectors/sources/elasticsearch-15","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Description"},"5013":{"id":"/docs/connectors/sources/elasticsearch-16","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"url"},"5014":{"id":"/docs/connectors/sources/elasticsearch-17","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"string"},"5015":{"id":"/docs/connectors/sources/elasticsearch-18","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"required"},"5016":{"id":"/docs/connectors/sources/elasticsearch-19","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Elasticsearch cluster URL"},"5017":{"id":"/docs/connectors/sources/elasticsearch-20","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"index"},"5018":{"id":"/docs/connectors/sources/elasticsearch-21","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"string"},"5019":{"id":"/docs/connectors/sources/elasticsearch-22","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"required"},"5020":{"id":"/docs/connectors/sources/elasticsearch-23","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Index to poll. Must exist when the connector starts"},"5021":{"id":"/docs/connectors/sources/elasticsearch-24","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"username / password"},"5022":{"id":"/docs/connectors/sources/elasticsearch-25","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"string"},"5023":{"id":"/docs/connectors/sources/elasticsearch-26","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"none"},"5024":{"id":"/docs/connectors/sources/elasticsearch-27","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Basic authentication is enabled only when both are present"},"5025":{"id":"/docs/connectors/sources/elasticsearch-28","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"query"},"5026":{"id":"/docs/connectors/sources/elasticsearch-29","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"table"},"5027":{"id":"/docs/connectors/sources/elasticsearch-30","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"match_all"},"5028":{"id":"/docs/connectors/sources/elasticsearch-31","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Elasticsearch query DSL applied on each poll"},"5029":{"id":"/docs/connectors/sources/elasticsearch-32","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"polling_interval"},"5030":{"id":"/docs/connectors/sources/elasticsearch-33","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"string"},"5031":{"id":"/docs/connectors/sources/elasticsearch-34","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"\"10s\""},"5032":{"id":"/docs/connectors/sources/elasticsearch-35","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Delay before each poll cycle. Invalid strings fall back to 10s, and zero is accepted"},"5033":{"id":"/docs/connectors/sources/elasticsearch-36","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"batch_size"},"5034":{"id":"/docs/connectors/sources/elasticsearch-37","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"integer"},"5035":{"id":"/docs/connectors/sources/elasticsearch-38","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"100"},"5036":{"id":"/docs/connectors/sources/elasticsearch-39","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Search size per poll. 0 returns no hits, and Elasticsearch enforces its own result-window limit"},"5037":{"id":"/docs/connectors/sources/elasticsearch-40","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"timestamp_field"},"5038":{"id":"/docs/connectors/sources/elasticsearch-41","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"string"},"5039":{"id":"/docs/connectors/sources/elasticsearch-42","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"none"},"5040":{"id":"/docs/connectors/sources/elasticsearch-43","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Top-level RFC3339 string field used to advance the watermark"},"5041":{"id":"/docs/connectors/sources/elasticsearch-44","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"A custom query must be a structured object. In TOML that means nested tables (an inline JSON string won't work):"},"5042":{"id":"/docs/connectors/sources/elasticsearch-45","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"The connector file remains TOML. plugin_config_format = \"json\" only selects the default format of the HTTP API's plugin-config response. It does not change how the local file is parsed. The upstream config example also uses TOML with a structured [plugin_config] table."},"5043":{"id":"/docs/connectors/sources/elasticsearch-46","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#how-polling-works","content":"Each cycle the connector waits polling_interval, then runs a search against index with the configured query, size = batch_size, sorted ascending by timestamp_field (@timestamp when unset). Every hit with _source becomes one JSON message. Elasticsearch _id is not copied into the payload or used as the Iggy message ID. Headers and timestamps are also unset by this plugin."},"5044":{"id":"/docs/connectors/sources/elasticsearch-47","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#how-polling-works","content":"When timestamp_field is set, the query is also filtered to values strictly greater than the last acknowledged timestamp. Only top-level strings that parse as RFC3339 update the watermark. Numeric timestamps, date-only strings and nested paths do not. Without a timestamp_field there is no incremental cursor and each poll returns the first batch_size matching documents."},"5045":{"id":"/docs/connectors/sources/elasticsearch-48","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#how-polling-works","content":"The connector does not use scroll, search_after or a document-ID tiebreaker. If a timestamp group spans multiple batches, advancing past that timestamp skips the remaining tied documents. Late arrivals and updates at or below the watermark are also skipped. scroll_timeout is accepted but unused. Without a usable timestamp, repeated polls can produce duplicates. The default @timestamp sort still requires a sortable field in the index mapping."},"5046":{"id":"/docs/connectors/sources/elasticsearch-49","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#how-polling-works","content":"Search and JSON-decoding failures, timed_out: true, and a nonzero _shards.failed count are returned as poll errors without advancing the watermark. The next polling cycle retries from the previous watermark. Poll errors are logged by the SDK. They do not increment the runtime's forwarding-error counter or change the runtime connector status. There is no per-query retry loop or configured HTTP request timeout. The source stages a candidate watermark and applies it only after runtime Ack. Nack keeps the previous watermark so the next search can fetch the rejected records again. Fetched-document and byte counters include these repeated attempts. This does not remove the timestamp limitations above or provide exactly-once delivery."},"5047":{"id":"/docs/connectors/sources/elasticsearch-50","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#state","content":"Along with each successful poll, including an empty one, the connector returns a MessagePack checkpoint containing its timestamp watermark and counters. After sending the batch, the runtime saves that checkpoint and acknowledges it. With the default file state backend, it uses source_<key>.state under the runtime [state] path (default local_state). The runtime also supports an HTTP state backend. On restart, the saved checkpoint is passed to the plugin. Invalid MessagePack state logs a warning and starts fresh."},"5048":{"id":"/docs/connectors/sources/elasticsearch-51","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#state","content":"Runtime state persistence requires no plugin configuration. To reset its position with the file backend, stop the runtime and delete the source's state file."},"5049":{"id":"/docs/connectors/sources/elasticsearch-52","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#state","content":"The optional [plugin_config.state] enables a separate JSON snapshot loaded during open() and saved during close(). Its loaded values can override the runtime checkpoint. It defaults to ./connector_states/elasticsearch_source_<numeric_id>.json. state_id and storage_config.base_path customize that location. Only file storage is implemented. Selecting elasticsearch, redis or an unknown storage type warns and falls back to ./connector_states, ignoring the supplied backend location."},"5050":{"id":"/docs/connectors/sources/elasticsearch-53","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#state","content":"state.auto_save_interval and state.tracked_fields do not affect the runtime plugin. Its JSON snapshot is a direct file write, separate from the runtime's atomic checkpoint protocol, and snapshot errors only warn. If enabled, account for this second snapshot when resetting or restoring progress. Removing only the runtime state file does not reset the plugin snapshot."},"5051":{"id":"/docs/connectors/sources/elasticsearch-54","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#state","content":"The saved counters include fetched documents, successful polls (including empty polls), empty polls, serialized payload bytes, errors and the last error text. The average successful-poll duration includes the configured polling delay. Document-ID, scroll-ID and offset fields are retained in state but do not drive polling. These plugin counters are separate from the runtime's sent/error metrics."},"5052":{"id":"/docs/connectors/sources/http","page_id":"/docs/connectors/sources/http","type":"page","content":"HTTP Source","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/http"},"5053":{"id":"/docs/connectors/sources/http-0","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http","content":"Receive webhooks through authenticated HTTP paths and forward their payloads to Iggy."},"5054":{"id":"/docs/connectors/sources/http-1","page_id":"/docs/connectors/sources/http","type":"heading","tags":[],"url":"/docs/connectors/sources/http#configuration","content":"Configuration"},"5055":{"id":"/docs/connectors/sources/http-2","page_id":"/docs/connectors/sources/http","type":"heading","tags":[],"url":"/docs/connectors/sources/http#routes-and-authentication","content":"Routes and authentication"},"5056":{"id":"/docs/connectors/sources/http-3","page_id":"/docs/connectors/sources/http","type":"heading","tags":[],"url":"/docs/connectors/sources/http#responses-and-health","content":"Responses and health"},"5057":{"id":"/docs/connectors/sources/http-4","page_id":"/docs/connectors/sources/http","type":"heading","tags":[],"url":"/docs/connectors/sources/http#delivery-and-retries","content":"Delivery and retries"},"5058":{"id":"/docs/connectors/sources/http-5","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http","content":"The HTTP source accepts webhook POST bodies and produces raw messages to one configured stream and topic. Instances that use the same listener address share the listener. A separate admin address serves management, health details and metrics."},"5059":{"id":"/docs/connectors/sources/http-6","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#configuration","content":"Build iggy_connector_http_source from the same release source as the runtime. Create the destination stream and topic. Add this connector file through the local provider:"},"5060":{"id":"/docs/connectors/sources/http-7","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#configuration","content":"Replace both sample tokens. Keep the admin listener off the public load balancer. Terminate TLS in front of the public listener. Instances that share a listener must use the same address. Topic paths and endpoint IDs must be unique across those instances."},"5061":{"id":"/docs/connectors/sources/http-8","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#routes-and-authentication","content":"POST /topics/{topic_path} uses auth_bearer_token. If that field is omitted, the named path has no authentication. POST /e/{endpoint_id} uses a secret path with optional bearer or HMAC authentication. Generate secret endpoint IDs and keep their URLs private."},"5062":{"id":"/docs/connectors/sources/http-9","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#routes-and-authentication","content":"HMAC-SHA256 validation uses the raw body, not reserialized JSON. Per-endpoint secrets belong in TOML or the management API. Local environment overrides target top-level plugin fields and do not populate nested endpoint secrets."},"5063":{"id":"/docs/connectors/sources/http-10","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#routes-and-authentication","content":"Unknown plugin keys are ignored. Inspect the effective authentication posture in startup logs after changing configuration. The runtime control API exposes raw plugin configuration, so access to it also exposes configured secrets."},"5064":{"id":"/docs/connectors/sources/http-11","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"Status"},"5065":{"id":"/docs/connectors/sources/http-12","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"Meaning"},"5066":{"id":"/docs/connectors/sources/http-13","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"200"},"5067":{"id":"/docs/connectors/sources/http-14","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"Body queued in memory, with {\"status\":\"queued\"}"},"5068":{"id":"/docs/connectors/sources/http-15","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"400"},"5069":{"id":"/docs/connectors/sources/http-16","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"Invalid or empty body"},"5070":{"id":"/docs/connectors/sources/http-17","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"401"},"5071":{"id":"/docs/connectors/sources/http-18","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"Authentication failed"},"5072":{"id":"/docs/connectors/sources/http-19","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"404"},"5073":{"id":"/docs/connectors/sources/http-20","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"Unknown, revoked or expired endpoint"},"5074":{"id":"/docs/connectors/sources/http-21","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"413"},"5075":{"id":"/docs/connectors/sources/http-22","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"Body exceeds the configured limit"},"5076":{"id":"/docs/connectors/sources/http-23","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"429"},"5077":{"id":"/docs/connectors/sources/http-24","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"Buffer full, with Retry-After: 1"},"5078":{"id":"/docs/connectors/sources/http-25","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"503"},"5079":{"id":"/docs/connectors/sources/http-26","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"Instance unavailable, closing, or named route changed during the request"},"5080":{"id":"/docs/connectors/sources/http-27","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#responses-and-health","content":"Public GET /health returns success only while every serving instance on the listener has a healthy poll path. A stalled path or a batch receiving negative acknowledgements for over 60 seconds makes it unavailable. An instance does not publish routes until its first poll starts."},"5081":{"id":"/docs/connectors/sources/http-28","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#delivery-and-retries","content":"HTTP 200 confirms an in-memory enqueue. It does not confirm an Iggy write or durable storage. Process crashes and shutdown can lose accepted events. Sender retries and replayed batches can also create duplicates."},"5082":{"id":"/docs/connectors/sources/http-29","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#delivery-and-retries","content":"The source retains a negatively acknowledged batch and retries it with bounded backoff. There is no fixed NACK stop limit by default. Set max_consecutive_nacks only when accepted webhooks can be replayed externally after a restart. A stopped source can leave a buffer that no task drains."},"5083":{"id":"/docs/connectors/sources/http-30","page_id":"/docs/connectors/sources/http","tags":[],"type":"text","url":"/docs/connectors/sources/http#delivery-and-retries","content":"Forward the provider's delivery ID and use it for application deduplication. An Iggy message ID stays stable for a batch replay, but a new HTTP request receives a new ID. The source reference describes endpoint management, persistence and metrics."},"5084":{"id":"/docs/connectors/sources/influxdb","page_id":"/docs/connectors/sources/influxdb","type":"page","content":"InfluxDB Source","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/influxdb"},"5085":{"id":"/docs/connectors/sources/influxdb-0","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb","content":"Poll InfluxDB on an interval and produce the resulting rows into an Iggy stream, on both InfluxDB V2 and V3."},"5086":{"id":"/docs/connectors/sources/influxdb-1","page_id":"/docs/connectors/sources/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sources/influxdb#configuration","content":"Configuration"},"5087":{"id":"/docs/connectors/sources/influxdb-2","page_id":"/docs/connectors/sources/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sources/influxdb#common-options","content":"Common Options"},"5088":{"id":"/docs/connectors/sources/influxdb-3","page_id":"/docs/connectors/sources/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sources/influxdb#cursor-based-polling","content":"Cursor-Based Polling"},"5089":{"id":"/docs/connectors/sources/influxdb-4","page_id":"/docs/connectors/sources/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sources/influxdb#payload-formats","content":"Payload Formats"},"5090":{"id":"/docs/connectors/sources/influxdb-5","page_id":"/docs/connectors/sources/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sources/influxdb#state-and-failures","content":"State and Failures"},"5091":{"id":"/docs/connectors/sources/influxdb-6","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb","content":"The InfluxDB source connector polls InfluxDB on an interval and produces the resulting rows as messages into an Iggy stream. It supports both InfluxDB V2 (OSS 2.x / Cloud, Flux queries) and InfluxDB V3 (Core / Enterprise, SQL queries), selected with the version option. An acknowledged timestamp cursor and row offset are stored in connector state. Restarts resume from that checkpoint, subject to the ordering and late-arrival limits below."},"5092":{"id":"/docs/connectors/sources/influxdb-7","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb","content":"This page is a curated subset of the documentation. The canonical reference, including the full cursor semantics and stuck-timestamp handling, is the upstream influxdb_source README in the apache/iggy repository."},"5093":{"id":"/docs/connectors/sources/influxdb-8","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#configuration","content":"Use the broker credentials and main runtime configuration from the source guide. Build the plugin from the matching 0.10.0 checkout root:"},"5094":{"id":"/docs/connectors/sources/influxdb-9","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#configuration","content":"The V2 example requires an existing telemetry bucket in iggy_org, a token with read access, and cpu points with a numeric usage field and a host tag. Save this entry in the runtime's connector directory and start the runtime from the checkout root."},"5095":{"id":"/docs/connectors/sources/influxdb-10","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#configuration","content":"Create the destination before starting the runtime:"},"5096":{"id":"/docs/connectors/sources/influxdb-11","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#configuration","content":"InfluxDB V2 takes an org and a Flux query. For V3, replace the entire [plugin_config] section below, including the V2-only org. The my-db database must contain a cpu table. This example assumes host is its only tag."},"5097":{"id":"/docs/connectors/sources/influxdb-12","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#configuration","content":"Omitting the plugin version defaults to \"v2\" for backward compatibility. It is separate from the connector entry's numeric configuration version. Unknown plugin keys and unsupported versions are rejected. The query must contain $cursor outside comments. Keep $limit in the query so the connector can control its size. With stuck-batch detection enabled, V3 also requires $offset and an ascending ORDER BY. Startup checks use text matching, so they do not prove that a query implements the required ordering."},"5098":{"id":"/docs/connectors/sources/influxdb-13","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#configuration","content":"Start the runtime as described in the source guide. After a polling cycle, read the produced records:"},"5099":{"id":"/docs/connectors/sources/influxdb-14","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"Option"},"5100":{"id":"/docs/connectors/sources/influxdb-15","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"Type"},"5101":{"id":"/docs/connectors/sources/influxdb-16","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"Default"},"5102":{"id":"/docs/connectors/sources/influxdb-17","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"Description"},"5103":{"id":"/docs/connectors/sources/influxdb-18","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"version"},"5104":{"id":"/docs/connectors/sources/influxdb-19","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"string"},"5105":{"id":"/docs/connectors/sources/influxdb-20","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"v2"},"5106":{"id":"/docs/connectors/sources/influxdb-21","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"v2 or v3"},"5107":{"id":"/docs/connectors/sources/influxdb-22","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"url"},"5108":{"id":"/docs/connectors/sources/influxdb-23","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"string"},"5109":{"id":"/docs/connectors/sources/influxdb-24","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"required"},"5110":{"id":"/docs/connectors/sources/influxdb-25","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"InfluxDB base URL"},"5111":{"id":"/docs/connectors/sources/influxdb-26","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"org"},"5112":{"id":"/docs/connectors/sources/influxdb-27","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"string"},"5113":{"id":"/docs/connectors/sources/influxdb-28","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"required (v2)"},"5114":{"id":"/docs/connectors/sources/influxdb-29","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"Organization name"},"5115":{"id":"/docs/connectors/sources/influxdb-30","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"db"},"5116":{"id":"/docs/connectors/sources/influxdb-31","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"string"},"5117":{"id":"/docs/connectors/sources/influxdb-32","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"required (v3)"},"5118":{"id":"/docs/connectors/sources/influxdb-33","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"Target database"},"5119":{"id":"/docs/connectors/sources/influxdb-34","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"token"},"5120":{"id":"/docs/connectors/sources/influxdb-35","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"string"},"5121":{"id":"/docs/connectors/sources/influxdb-36","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"required"},"5122":{"id":"/docs/connectors/sources/influxdb-37","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"API token. Its debug representation is redacted"},"5123":{"id":"/docs/connectors/sources/influxdb-38","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"query"},"5124":{"id":"/docs/connectors/sources/influxdb-39","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"string"},"5125":{"id":"/docs/connectors/sources/influxdb-40","page_id":"/docs/