onnectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"CDC backend. Only builtin is implemented"},"5289":{"id":"/docs/connectors/sources/postgres-102","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"verbose_logging"},"5290":{"id":"/docs/connectors/sources/postgres-103","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"bool"},"5291":{"id":"/docs/connectors/sources/postgres-104","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"false"},"5292":{"id":"/docs/connectors/sources/postgres-105","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"Log at info level instead of debug"},"5293":{"id":"/docs/connectors/sources/postgres-106","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"max_retries"},"5294":{"id":"/docs/connectors/sources/postgres-107","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"u32"},"5295":{"id":"/docs/connectors/sources/postgres-108","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"3"},"5296":{"id":"/docs/connectors/sources/postgres-109","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"Total polling-query attempts, including the first. 0 still makes one attempt"},"5297":{"id":"/docs/connectors/sources/postgres-110","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"retry_delay"},"5298":{"id":"/docs/connectors/sources/postgres-111","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"string"},"5299":{"id":"/docs/connectors/sources/postgres-112","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"\"1s\""},"5300":{"id":"/docs/connectors/sources/postgres-113","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"Linear delay: this duration times the failed attempt number. Invalid values fall back to 1s"},"5301":{"id":"/docs/connectors/sources/postgres-114","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#polling-and-delivery","content":"The default query selects rows with tracking_column > last_offset, orders that column ascending, and applies batch_size separately to each table. Use a non-null, unique tracking value that increases in the database's sort order. A timestamp with ties can skip rows at a batch boundary, and inserts or updates at or below the watermark are not revisited. Polling does not capture deletions."},"5302":{"id":"/docs/connectors/sources/postgres-115","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#polling-and-delivery","content":"A custom_query replaces the entire default query, including its ordering, limit and processed-row filter. Its placeholders are $table, $offset, $limit, $now (RFC3339 UTC) and $now_unix (integer seconds). Substitution is textual, with no automatic quoting or escaping. $offset is empty if neither saved state nor initial_offset supplies it. Keep queries trusted and explicitly preserve ascending tracking-column order. The offset comes from the last returned row with a usable tracking value."},"5303":{"id":"/docs/connectors/sources/postgres-116","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#polling-and-delivery","content":"Polling stages its cursor and processed-row count until the runtime forwards the batch, saves its checkpoint and sends Ack. Nack discards that candidate so the next poll can read the rows again. A failure after forwarding can therefore duplicate messages. IDs are random UUIDs for each poll, so replayed rows do not retain a stable message ID."},"5304":{"id":"/docs/connectors/sources/postgres-117","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#polling-and-delivery","content":"delete_after_read and processed_column stage cleanup keys during polling and modify PostgreSQL only after Ack. A Nack or failed poll leaves the rows available for replay. Cleanup is separate from delivery and checkpointing: a cleanup error stops the source, and a crash after checkpointing but before cleanup can leave already-delivered rows unmodified in PostgreSQL. Cleanup across tables is not atomic."},"5305":{"id":"/docs/connectors/sources/postgres-118","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#polling-and-delivery","content":"The file state backend stores source_postgres-source.state under the runtime's state path (default local_state). Its MessagePack state contains per-table offsets, a last-poll time and a processed-row count. The HTTP state backend is also available. Missing or undecodable plugin state starts fresh. File access errors prevent startup. Stop the runtime before resetting its checkpoint. initial_offset is used only where saved offsets are absent."},"5306":{"id":"/docs/connectors/sources/postgres-119","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#polling-and-delivery","content":"The plugin's retries cover transient polling SELECT failures, including connection I/O, pool timeouts, serialization failures and deadlocks. Connection setup, CDC fetches and delete/mark statements do not use that retry loop. A poll error is logged and polling continues without incrementing the runtime's forwarding-error counter. Repeated delivery or checkpoint failures instead receive Nack. The SDK stops after five consecutive Nacks."},"5307":{"id":"/docs/connectors/sources/postgres-120","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#output-format","content":"By default (no payload_column), each row is wrapped in a JSON envelope:"},"5308":{"id":"/docs/connectors/sources/postgres-121","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#output-format","content":"The stream config should use schema = \"json\". Flat-schema sinks such as Iceberg need the unwrap_envelope transform to extract the data field. See the transforms documentation."},"5309":{"id":"/docs/connectors/sources/postgres-122","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#payload-column-extraction","content":"In polling mode, an existing payload_column bypasses the envelope. Use bytea or raw for a BYTEA column with schema = \"raw\", text for a text column with schema = \"text\", and json_direct, jsonb or jsonb_direct for JSON/JSONB with schema = \"json\". A null BYTEA/text payload becomes empty bytes, which the Iggy message builder rejects. The entire batch is Nacked. Use non-null, non-empty BYTEA/text payloads. A null JSON/JSONB payload becomes JSON null and can be delivered."},"5310":{"id":"/docs/connectors/sources/postgres-123","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#payload-column-extraction","content":"The default payload_format = \"json\" reads a selected column as BYTEA but reports JSON to the runtime, so those bytes must contain valid JSON. Without a selected column, the connector always emits a JSON envelope. If the selected column is absent, it falls back to the envelope while retaining the selected format's schema. Use a column present in every configured table. Type mismatches reject the poll. See the upstream README for sink round-trip recipes."},"5311":{"id":"/docs/connectors/sources/postgres-124","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#payload-column-extraction","content":"With no selected column, include_metadata = false currently retains the envelope and adds an extra data level. Whole-row BYTEA fields are base64 strings. Keep database timestamps in the payload when needed. The runtime does not copy the plugin's timestamp fields into broker message metadata."},"5312":{"id":"/docs/connectors/sources/postgres-125","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"With mode = \"cdc\" the connector reads changes from a logical replication slot instead of polling tables:"},"5313":{"id":"/docs/connectors/sources/postgres-126","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"The builtin backend creates (or reuses) a logical replication slot using the test_decoding output plugin. The default slot name is iggy_slot. No publication is created or required, since test_decoding ignores publications entirely."},"5314":{"id":"/docs/connectors/sources/postgres-127","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"PostgreSQL must run with wal_level = logical and have test_decoding installed and allowed. The login needs access to the logical-decoding SQL functions. This backend uses ordinary SQL connections, not a replication-protocol connection. Any proxy must support its SQL and slot operations."},"5315":{"id":"/docs/connectors/sources/postgres-128","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"capture_operations accepts uppercase INSERT, UPDATE and DELETE. An empty array emits none. Filtering happens after reading the slot. Qualified table names match the schema and table. Unqualified names match that table name in any schema. An empty tables array captures all tables."},"5316":{"id":"/docs/connectors/sources/postgres-129","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"The pg_replicate backend (based on Supabase's ETL framework) is not implemented: selecting cdc_backend = \"pg_replicate\" fails at startup unless the cdc_pg_replicate build feature is enabled, and the backend returns an error even when it is."},"5317":{"id":"/docs/connectors/sources/postgres-130","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"Each connector needs its own slot. Reusing one slot across connectors divides its changes between them. pg_logical_slot_get_changes consumes slot progress before delivery, including changes excluded by the filters. A later failure cannot replay those changes from the slot, and the plugin checkpoint does not contain a recovery LSN."},"5318":{"id":"/docs/connectors/sources/postgres-131","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"CDC always builds a JSON envelope with the operation and parsed columns. Do not combine it with polling payload extraction options. Deletes contain replica-identity columns. Updates may also supply old_data from an old-key tuple. Quoted test_decoding values, including JSONB and arrays, remain strings. Unchanged TOAST values are represented as null, which does not establish that the database value is null. Envelope timestamps are generated while polling, not PostgreSQL transaction commit times."},"5319":{"id":"/docs/connectors/sources/postgres-132","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"When decommissioning a CDC connector, stop it and drop its replication slot to stop WAL retention. With PostgreSQL's default max_slot_wal_keep_size = -1, an unused slot can retain unbounded WAL. See the upstream README for details."},"5320":{"id":"/docs/connectors/sources/random","page_id":"/docs/connectors/sources/random","type":"page","content":"Random Source","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/random"},"5321":{"id":"/docs/connectors/sources/random-0","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random","content":"Generate random messages into Iggy streams for testing, benchmarking and verifying a connector pipeline."},"5322":{"id":"/docs/connectors/sources/random-1","page_id":"/docs/connectors/sources/random","type":"heading","tags":[],"url":"/docs/connectors/sources/random#configuration","content":"Configuration"},"5323":{"id":"/docs/connectors/sources/random-2","page_id":"/docs/connectors/sources/random","type":"heading","tags":[],"url":"/docs/connectors/sources/random#plugin-config-options","content":"Plugin config options"},"5324":{"id":"/docs/connectors/sources/random-3","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random","content":"The random source connector generates random messages and sends them to Iggy streams. This is useful for testing, benchmarking, and verifying that your connector pipeline is working correctly without needing an external data source."},"5325":{"id":"/docs/connectors/sources/random-4","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#configuration","content":"Use the broker credentials and runtime setup from the source guide. Save the configuration below in that runtime's connector directory. From the matching 0.10.0 repository root, build the plugin:"},"5326":{"id":"/docs/connectors/sources/random-5","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Option"},"5327":{"id":"/docs/connectors/sources/random-6","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Type"},"5328":{"id":"/docs/connectors/sources/random-7","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Default"},"5329":{"id":"/docs/connectors/sources/random-8","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Description"},"5330":{"id":"/docs/connectors/sources/random-9","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"interval"},"5331":{"id":"/docs/connectors/sources/random-10","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"string"},"5332":{"id":"/docs/connectors/sources/random-11","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"\"1s\""},"5333":{"id":"/docs/connectors/sources/random-12","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Delay before each message generation cycle. Invalid duration strings fall back to \"1s\""},"5334":{"id":"/docs/connectors/sources/random-13","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"max_count"},"5335":{"id":"/docs/connectors/sources/random-14","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"usize"},"5336":{"id":"/docs/connectors/sources/random-15","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"unlimited"},"5337":{"id":"/docs/connectors/sources/random-16","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Stop producing after this many messages in total. Omit for unlimited"},"5338":{"id":"/docs/connectors/sources/random-17","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"messages_range"},"5339":{"id":"/docs/connectors/sources/random-18","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"[u32, u32]"},"5340":{"id":"/docs/connectors/sources/random-19","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"[10, 50]"},"5341":{"id":"/docs/connectors/sources/random-20","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Min (inclusive) / max (exclusive) messages per batch, capped by the remaining max_count. The lower bound must be smaller"},"5342":{"id":"/docs/connectors/sources/random-21","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"payload_size"},"5343":{"id":"/docs/connectors/sources/random-22","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"u32"},"5344":{"id":"/docs/connectors/sources/random-23","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"100"},"5345":{"id":"/docs/connectors/sources/random-24","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Number of random characters in the text field of each message"},"5346":{"id":"/docs/connectors/sources/random-25","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Setting max_count = 0 stops production immediately (the connector produces zero messages). To generate messages without a limit, leave the key out."},"5347":{"id":"/docs/connectors/sources/random-26","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"The connector stages its count for each batch and commits it only after the runtime acknowledges delivery and saves the checkpoint. Restoring that checkpoint enforces max_count across restarts. Missing or undecodable state starts the count at zero. After reaching the limit, polling continues but returns no messages or new checkpoint."},"5348":{"id":"/docs/connectors/sources/random-27","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"A non-increasing messages_range returns a configuration error when message generation is attempted. The SDK logs poll errors and continues polling. Each generated JSON record contains a random UUID id, fixed title = \"Hello\" and name = \"World\", and random alphanumeric text. payload_size controls only that text, not the total serialized record size."},"5349":{"id":"/docs/connectors/sources/random-28","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Create my-stream and my-topic before starting the runtime, or change the sample to use an existing destination. Configure one destination per source instance."},"5350":{"id":"/docs/connectors/sources/source","page_id":"/docs/connectors/sources/source","type":"page","content":"Source","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/source"},"5351":{"id":"/docs/connectors/sources/source-0","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source","content":"What source connectors do, and the Source trait every one of them implements."},"5352":{"id":"/docs/connectors/sources/source-1","page_id":"/docs/connectors/sources/source","type":"heading","tags":[],"url":"/docs/connectors/sources/source#overview","content":"Overview"},"5353":{"id":"/docs/connectors/sources/source-2","page_id":"/docs/connectors/sources/source","type":"heading","tags":[],"url":"/docs/connectors/sources/source#configuration","content":"Configuration"},"5354":{"id":"/docs/connectors/sources/source-3","page_id":"/docs/connectors/sources/source","type":"heading","tags":[],"url":"/docs/connectors/sources/source#environment-variable-overrides","content":"Environment Variable Overrides"},"5355":{"id":"/docs/connectors/sources/source-4","page_id":"/docs/connectors/sources/source","type":"heading","tags":[],"url":"/docs/connectors/sources/source#sample-implementation","content":"Sample implementation"},"5356":{"id":"/docs/connectors/sources/source-5","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#overview","content":"Source connectors are responsible for ingesting data from external sources into Apache Iggy. They provide a way to integrate Apache Iggy with various data sources, such as databases, message queues, or file systems."},"5357":{"id":"/docs/connectors/sources/source-6","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#overview","content":"The source is represented by the single Source trait, which defines the basic interface for all source connectors. It provides methods for initializing the source, reading data from it, and closing the source."},"5358":{"id":"/docs/connectors/sources/source-7","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"With the local configuration provider, each source connector has a TOML file in the directory specified by the main runtime config. The runtime also supports an HTTP configuration provider."},"5359":{"id":"/docs/connectors/sources/source-8","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Field"},"5360":{"id":"/docs/connectors/sources/source-9","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Meaning"},"5361":{"id":"/docs/connectors/sources/source-10","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"key"},"5362":{"id":"/docs/connectors/sources/source-11","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Connector key (String), separate from the numeric plugin instance ID."},"5363":{"id":"/docs/connectors/sources/source-12","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"enabled"},"5364":{"id":"/docs/connectors/sources/source-13","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Whether to start the connector (bool)."},"5365":{"id":"/docs/connectors/sources/source-14","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"version"},"5366":{"id":"/docs/connectors/sources/source-15","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Configuration version (u64)."},"5367":{"id":"/docs/connectors/sources/source-16","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"name"},"5368":{"id":"/docs/connectors/sources/source-17","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Display name (String)."},"5369":{"id":"/docs/connectors/sources/source-18","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"path"},"5370":{"id":"/docs/connectors/sources/source-19","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Shared-library path (String)."},"5371":{"id":"/docs/connectors/sources/source-20","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"streams"},"5372":{"id":"/docs/connectors/sources/source-21","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Stream configuration entries."},"5373":{"id":"/docs/connectors/sources/source-22","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"transforms"},"5374":{"id":"/docs/connectors/sources/source-23","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Optional transform configuration."},"5375":{"id":"/docs/connectors/sources/source-24","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"plugin_config"},"5376":{"id":"/docs/connectors/sources/source-25","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Optional custom configuration object deserialized by the plugin."},"5377":{"id":"/docs/connectors/sources/source-26","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"plugin_config_format"},"5378":{"id":"/docs/connectors/sources/source-27","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Optional default format for the HTTP API's plugin-config response. The FFI always receives JSON."},"5379":{"id":"/docs/connectors/sources/source-28","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"verbose, benchmark"},"5380":{"id":"/docs/connectors/sources/source-29","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Optional logging flags (bool)."},"5381":{"id":"/docs/connectors/sources/source-30","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"verbose and benchmark are optional and default to false. verbose switches the connector's per-batch logging to info level, and benchmark emits per-batch timing events for performance measurement."},"5382":{"id":"/docs/connectors/sources/source-31","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Main runtime config (connectors.toml, in the repository root):"},"5383":{"id":"/docs/connectors/sources/source-32","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Use the matching 0.10.0 checkout and broker from the quick start. Its broker must use the credentials below. Create the connectors directory, then save these two configuration files there and in the repository root as labeled."},"5384":{"id":"/docs/connectors/sources/source-33","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Source connector config (connectors/random.toml):"},"5385":{"id":"/docs/connectors/sources/source-34","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Configure one [[streams]] destination per source instance. The runtime currently retains only the last producer when multiple entries are supplied."},"5386":{"id":"/docs/connectors/sources/source-35","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#environment-variable-overrides","content":"Configuration properties can be overridden using environment variables. Supported scalar fields and indexed stream entries use the pattern: IGGY_CONNECTORS_SOURCE_[KEY]_[PROPERTY]"},"5387":{"id":"/docs/connectors/sources/source-36","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#environment-variable-overrides","content":"For example, to disable the source with key random at the next runtime start:"},"5388":{"id":"/docs/connectors/sources/source-37","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#environment-variable-overrides","content":"Top-level fields of plugin_config can be overridden (or injected) the same way with the IGGY_CONNECTORS_SOURCE_[KEY]_PLUGIN_CONFIG_[FIELD] pattern. This lets you supply credentials without writing them into the TOML file:"},"5389":{"id":"/docs/connectors/sources/source-38","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Let's implement the example source connector, which generates a random batch of messages at the configured interval and optionally stops after a total message limit."},"5390":{"id":"/docs/connectors/sources/source-39","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Additionally, our source connector will have its own state, which can be used e.g. to track the overall progress or store some relevant information when producing the data from the actual external sources or tooling."},"5391":{"id":"/docs/connectors/sources/source-40","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Keep in mind, that the produced messages will be sent further to the specified stream, however it's already the responsibility of the runtime to handle the delivery."},"5392":{"id":"/docs/connectors/sources/source-41","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Also, when implementing the source connector, make sure to use the source_connector! macro to expose the FFI interface and allow the connector runtime to register the source with the runtime."},"5393":{"id":"/docs/connectors/sources/source-42","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"And finally, each source should have its own, custom configuration, which is passed along with the unique plugin ID and optional state via expected new() method."},"5394":{"id":"/docs/connectors/sources/source-43","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"The reference crate is core/connectors/sources/random_source. Use its Cargo.toml from the matching checkout, including [lib] crate-type = [\"cdylib\", \"lib\"] and its workspace dependency features. The Rust blocks in this sample implementation section combine into src/lib.rs. The trait above is an API reference and is not part of that file."},"5395":{"id":"/docs/connectors/sources/source-44","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Start with the imports, then define the internal state and the public source connector along with its configuration."},"5396":{"id":"/docs/connectors/sources/source-45","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"At this point, we can expose the required new() method, which will be used by the runtime to create a new instance of the source connector. The id is assigned by the runtime, and represents the unique identifier of the source connector. The state is an optional connector state (e.g. persisted by the file or HTTP state backend), which will be provided by the runtime, given that the connector has persisted its own state before the runtime was restarted. The ConnectorState::deserialize() helper decodes the MessagePack bytes back into our State struct, falling back to a fresh state when nothing was persisted or decoding fails."},"5397":{"id":"/docs/connectors/sources/source-46","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"We can invoke the expected macro to expose the FFI interface and allow the connector runtime to register the source within the runtime."},"5398":{"id":"/docs/connectors/sources/source-47","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"The reference manifest supplies these dependencies:"},"5399":{"id":"/docs/connectors/sources/source-48","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"async-trait"},"5400":{"id":"/docs/connectors/sources/source-49","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"dashmap"},"5401":{"id":"/docs/connectors/sources/source-50","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"iggy_connector_sdk"},"5402":{"id":"/docs/connectors/sources/source-51","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"serde"},"5403":{"id":"/docs/connectors/sources/source-52","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"tokio"},"5404":{"id":"/docs/connectors/sources/source-53","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"tracing"},"5405":{"id":"/docs/connectors/sources/source-54","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"The implementation also uses humantime, rand, simd-json, and uuid. The reference crate uses rmp-serde directly in its tests. The production state helpers come from the SDK."},"5406":{"id":"/docs/connectors/sources/source-55","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Before we make use of the Source trait, let's define the internal payload of the message that will be produced (e.g. as if it was pulled from some external database or so)."},"5407":{"id":"/docs/connectors/sources/source-56","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"serialize_state() encodes the state to MessagePack via ConnectorState::serialize(). generate_messages() samples the half-open messages_range (lower bound included, upper bound excluded), capped by the remaining max_count. Each message carries a JSON-serialized Record with payload_size random alphanumeric characters of text. A non-increasing range returns Error::InvalidConfigValue from poll() without advancing state."},"5408":{"id":"/docs/connectors/sources/source-57","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Now implement Source for RandomSource. Each poll() waits for interval, builds a batch without exceeding max_count, and stages a candidate checkpoint. The runtime sends the batch, saves its optional checkpoint, and calls on_batch_result(). Only Ack commits the in-memory count. Nack discards the candidate. After restart, new() receives the last persisted checkpoint. Once the limit is reached, polls return empty messages and no new state."},"5409":{"id":"/docs/connectors/sources/source-58","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"The SDK permits only one batch in flight. Returning an error from on_batch_result() stops polling. Returning an error from poll() logs the error and continues the polling loop. A source that tracks a cursor or performs destructive upstream work must implement the callback instead of relying on its default no-op."},"5410":{"id":"/docs/connectors/sources/source-59","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"The runtime forwards the encoded payload, optional message ID and headers. Although ProducedMessage also accepts checksum, timestamp and origin_timestamp, the current forwarding path does not copy those three fields into the Iggy message."},"5411":{"id":"/docs/connectors/sources/source-60","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"It's also important to note, that the supported format(s) might vary depending on the connector implementation. For example, you might use JSON as the payload format, which can be then easily parsed and processed by downstream components such as data transforms, but at the same time, you could support the other formats and let the user decide which one to use."},"5412":{"id":"/docs/connectors/sources/source-61","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"The destination schema selects the StreamEncoder. A decode, transform or encoding error rejects the entire source batch, leaves its checkpoint uncommitted and produces Nack. The runtime logs and counts the error. An intentional filter result (Ok(None)) may drop selected messages without rejecting the batch."},"5413":{"id":"/docs/connectors/sources/source-62","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Build the matching plugin, runtime and CLI from the repository root:"},"5414":{"id":"/docs/connectors/sources/source-63","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"On an empty broker, create the destination using the credentials from the quick start:"},"5415":{"id":"/docs/connectors/sources/source-64","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"After saving the configuration files above, start the runtime. This explicitly enables the source if you tried the optional disabling override:"},"5416":{"id":"/docs/connectors/sources/source-65","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"And that's all, enjoy using the source connector!"},"5417":{"id":"/docs/connectors/sources/source-66","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"On a side note, if you'd like to process the messages consumed from the Iggy stream instead, you can implement your own Sink connector too :)"},"5418":{"id":"/docs/connectors/sinks/bigquery","page_id":"/docs/connectors/sinks/bigquery","type":"page","content":"BigQuery","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/bigquery"},"5419":{"id":"/docs/connectors/sinks/bigquery-0","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery","content":"Write Iggy messages to an existing BigQuery table through the Storage Write API."},"5420":{"id":"/docs/connectors/sinks/bigquery-1","page_id":"/docs/connectors/sinks/bigquery","type":"heading","tags":[],"url":"/docs/connectors/sinks/bigquery#configuration","content":"Configuration"},"5421":{"id":"/docs/connectors/sinks/bigquery-2","page_id":"/docs/connectors/sinks/bigquery","type":"heading","tags":[],"url":"/docs/connectors/sinks/bigquery#credentials","content":"Credentials"},"5422":{"id":"/docs/connectors/sinks/bigquery-3","page_id":"/docs/connectors/sinks/bigquery","type":"heading","tags":[],"url":"/docs/connectors/sinks/bigquery#row-mapping","content":"Row mapping"},"5423":{"id":"/docs/connectors/sinks/bigquery-4","page_id":"/docs/connectors/sinks/bigquery","type":"heading","tags":[],"url":"/docs/connectors/sinks/bigquery#batching-and-failures","content":"Batching and failures"},"5424":{"id":"/docs/connectors/sinks/bigquery-5","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery","content":"The BigQuery sink writes Arrow record batches through the Storage Write API _default stream. The target table must already exist. Startup reads its schema and rejects unsupported column types before consuming messages."},"5425":{"id":"/docs/connectors/sinks/bigquery-6","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#configuration","content":"Build iggy_connector_bigquery_sink with the same release source as the runtime. Add this connector file to the local provider, then set your project, dataset and table:"},"5426":{"id":"/docs/connectors/sinks/bigquery-7","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#configuration","content":"With metadata enabled, the table needs iggy_stream and iggy_topic as STRING, iggy_partition_id and iggy_offset as INT64, iggy_timestamp as TIMESTAMP and iggy_id as STRING. include_headers=true also needs iggy_headers as JSON or STRING."},"5427":{"id":"/docs/connectors/sinks/bigquery-8","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#credentials","content":"Set either credentials_path or credentials_json, never both. Without either, the connector uses Application Default Credentials. The identity needs table schema read and row append permissions, bigquery.tables.get and bigquery.tables.updateData."},"5428":{"id":"/docs/connectors/sinks/bigquery-9","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#credentials","content":"The optional emulator_endpoint and emulator_grpc_endpoint must be supplied together. They disable credentials and use plaintext connections. Use them only for local test services."},"5429":{"id":"/docs/connectors/sinks/bigquery-10","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#row-mapping","content":"In mapped mode, each payload must be a JSON object. Top-level fields map to table columns by name. Unknown fields are ignored. Required columns without defaults must have non-null values. Missing or null repeated columns become empty arrays."},"5430":{"id":"/docs/connectors/sinks/bigquery-11","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#row-mapping","content":"In raw mode, payload_column defaults to payload. A JSON column requires valid JSON. A STRING column requires text or UTF-8 bytes. A BYTES column accepts raw bytes from any payload type. Other required columns must have defaults."},"5431":{"id":"/docs/connectors/sinks/bigquery-12","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#row-mapping","content":"NUMERIC and BIGNUMERIC values must fit the declared precision and scale without rounding. Strings preserve decimal precision when JSON floating-point values cannot. INTERVAL and RANGE columns are unsupported."},"5432":{"id":"/docs/connectors/sinks/bigquery-13","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#batching-and-failures","content":"max_request_bytes defaults to 8 MiB and is clamped from 64 KiB through 9 MiB. The sink splits batches to stay below the API request limit. max_retries defaults to three total attempts, including the first. Retry delay starts at one second and is capped at 30 seconds. Each request and startup operation has a 30-second default timeout."},"5433":{"id":"/docs/connectors/sinks/bigquery-14","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#batching-and-failures","content":"A row that cannot be encoded or accepted is logged and dropped while other rows can proceed. Transient request failures retry with jittered exponential backoff. The _default stream does not provide exactly-once append semantics. A lost response can lead to duplicate rows."},"5434":{"id":"/docs/connectors/sinks/bigquery-15","page_id":"/docs/connectors/sinks/bigquery","tags":[],"type":"text","url":"/docs/connectors/sinks/bigquery#batching-and-failures","content":"The runtime commits offsets on read and does not replay a failed sink callback. A successful processed count does not prove that every row reached BigQuery. Preserve Iggy metadata when downstream deduplication or reconciliation is required. See the source reference for type mappings and row-error handling."},"5435":{"id":"/docs/connectors/sinks/clickhouse","page_id":"/docs/connectors/sinks/clickhouse","type":"page","content":"ClickHouse Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/clickhouse"},"5436":{"id":"/docs/connectors/sinks/clickhouse-0","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse","content":"Insert messages from Iggy streams into ClickHouse tables over the HTTP interface."},"5437":{"id":"/docs/connectors/sinks/clickhouse-1","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#configuration","content":"Configuration"},"5438":{"id":"/docs/connectors/sinks/clickhouse-2","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#options","content":"Options"},"5439":{"id":"/docs/connectors/sinks/clickhouse-3","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"Insert Formats"},"5440":{"id":"/docs/connectors/sinks/clickhouse-4","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#error-handling--delivery-semantics","content":"Error Handling & Delivery Semantics"},"5441":{"id":"/docs/connectors/sinks/clickhouse-5","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#transforms","content":"Transforms"},"5442":{"id":"/docs/connectors/sinks/clickhouse-6","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse","content":"The ClickHouse sink connector consumes messages from Iggy streams and inserts them into ClickHouse tables over the HTTP interface. It supports three insert formats: json_each_row (default), row_binary, and string passthrough for pre-formatted CSV/TSV/JSON payloads."},"5443":{"id":"/docs/connectors/sinks/clickhouse-7","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse","content":"This page is a curated subset of the documentation. The canonical reference is the upstream clickhouse_sink README in the apache/iggy repository."},"5444":{"id":"/docs/connectors/sinks/clickhouse-8","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.10.0 repository root, build the plugin:"},"5445":{"id":"/docs/connectors/sinks/clickhouse-9","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#configuration","content":"The sample expects a local ClickHouse HTTP endpoint with user default and an empty password. Create a test table with matching columns:"},"5446":{"id":"/docs/connectors/sinks/clickhouse-10","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#configuration","content":"Save the configuration below in the runtime's connector directory. Set the endpoint, credentials, database, and table for your deployment."},"5447":{"id":"/docs/connectors/sinks/clickhouse-11","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#configuration","content":"Create the Iggy stream and topic, then send a JSON row before starting the runtime:"},"5448":{"id":"/docs/connectors/sinks/clickhouse-12","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"Option"},"5449":{"id":"/docs/connectors/sinks/clickhouse-13","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"Type"},"5450":{"id":"/docs/connectors/sinks/clickhouse-14","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"Default"},"5451":{"id":"/docs/connectors/sinks/clickhouse-15","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"Description"},"5452":{"id":"/docs/connectors/sinks/clickhouse-16","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"url"},"5453":{"id":"/docs/connectors/sinks/clickhouse-17","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","content":"string"},"5454":{"id":"/docs/connectors/sinks/clickhouse-18","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse#options","conte