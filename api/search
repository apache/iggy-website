guration","content":"Reference for the [cluster] settings, consensus timing, and node roster"},"1488":{"id":"/docs/clustering/configuration-1","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#top-level-settings","content":"Top-level settings"},"1489":{"id":"/docs/clustering/configuration-2","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#consensus-timing","content":"Consensus timing"},"1490":{"id":"/docs/clustering/configuration-3","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#validation-rules","content":"Validation rules"},"1491":{"id":"/docs/clustering/configuration-4","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#superblock-failure-handling","content":"Superblock failure handling"},"1492":{"id":"/docs/clustering/configuration-5","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#coordinator-placement","content":"Coordinator placement"},"1493":{"id":"/docs/clustering/configuration-6","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#node-roster","content":"Node roster"},"1494":{"id":"/docs/clustering/configuration-7","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#name","content":"name"},"1495":{"id":"/docs/clustering/configuration-8","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#ip","content":"ip"},"1496":{"id":"/docs/clustering/configuration-9","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#replica_id","content":"replica_id"},"1497":{"id":"/docs/clustering/configuration-10","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#ports","content":"ports"},"1498":{"id":"/docs/clustering/configuration-11","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#advertised_address","content":"advertised_address"},"1499":{"id":"/docs/clustering/configuration-12","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#advertised_addresses","content":"advertised_addresses"},"1500":{"id":"/docs/clustering/configuration-13","page_id":"/docs/clustering/configuration","type":"heading","tags":[],"url":"/docs/clustering/configuration#authentication-and-tls","content":"Authentication and TLS"},"1501":{"id":"/docs/clustering/configuration-14","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration","content":"All clustering settings live in the [cluster] section of the server configuration. The authoritative defaults with detailed comments are in core/server/config.toml. Every value can also be set through an IGGY_-prefixed environment variable, for example IGGY_CLUSTER_ENABLED=true or IGGY_CLUSTER_NODES_0_IP=10.0.1.5."},"1502":{"id":"/docs/clustering/configuration-15","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration","content":"With clustering enabled, the server validates the section at boot and refuses to start on an invalid value, printing the rule that failed. The repair chunk limit and superblock failure timeout are validated even when clustering is disabled."},"1503":{"id":"/docs/clustering/configuration-16","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"Setting"},"1504":{"id":"/docs/clustering/configuration-17","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"Default"},"1505":{"id":"/docs/clustering/configuration-18","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"Purpose"},"1506":{"id":"/docs/clustering/configuration-19","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"enabled"},"1507":{"id":"/docs/clustering/configuration-20","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"false"},"1508":{"id":"/docs/clustering/configuration-21","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"Enables cluster mode. When disabled, the node runs single-node and the rest of the section is mostly inert."},"1509":{"id":"/docs/clustering/configuration-22","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"name"},"1510":{"id":"/docs/clustering/configuration-23","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"\"iggy-cluster\""},"1511":{"id":"/docs/clustering/configuration-24","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"Unique cluster name shared by every node. Prevents accidental cross-cluster communication."},"1512":{"id":"/docs/clustering/configuration-25","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#top-level-settings","content":"cluster.name is a permanent on-disk identity, not a label. It's hashed into the cluster id stamped into every metadata and partition superblock on first boot, and the consensus layer derives its cluster id from the name unconditionally. Nodes with different names cannot connect to each other, and changing the name later makes the server refuse to start against existing data."},"1513":{"id":"/docs/clustering/configuration-26","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Consensus runs on a fixed 10ms tick. Every duration below is converted to whole ticks: values are rounded down to a multiple of 10ms, and anything under 10ms is raised to a single tick rather than firing sooner. repair_gap_debounce_interval has an additional 500ms floor."},"1514":{"id":"/docs/clustering/configuration-27","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Setting"},"1515":{"id":"/docs/clustering/configuration-28","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Default"},"1516":{"id":"/docs/clustering/configuration-29","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Purpose"},"1517":{"id":"/docs/clustering/configuration-30","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"heartbeat_timeout"},"1518":{"id":"/docs/clustering/configuration-31","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"5s"},"1519":{"id":"/docs/clustering/configuration-32","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Backup liveness window: a replica that sees no primary traffic for this long starts a view change"},"1520":{"id":"/docs/clustering/configuration-33","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"commit_broadcast_interval"},"1521":{"id":"/docs/clustering/configuration-34","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"500ms"},"1522":{"id":"/docs/clustering/configuration-35","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"How often the primary broadcasts its commit point; this broadcast is the cluster's liveness signal"},"1523":{"id":"/docs/clustering/configuration-36","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"prepare_retransmit_interval"},"1524":{"id":"/docs/clustering/configuration-37","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"250ms"},"1525":{"id":"/docs/clustering/configuration-38","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Retry prepares that backups have not acknowledged"},"1526":{"id":"/docs/clustering/configuration-39","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"view_change_retransmit_interval"},"1527":{"id":"/docs/clustering/configuration-40","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"500ms"},"1528":{"id":"/docs/clustering/configuration-41","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Retry StartViewChange / DoViewChange while a view change is in progress"},"1529":{"id":"/docs/clustering/configuration-42","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"view_change_status_timeout"},"1530":{"id":"/docs/clustering/configuration-43","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"5s"},"1531":{"id":"/docs/clustering/configuration-44","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Escalate a view change that does not conclude within this window to a fresh election"},"1532":{"id":"/docs/clustering/configuration-45","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"request_start_view_retransmit_interval"},"1533":{"id":"/docs/clustering/configuration-46","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"1s"},"1534":{"id":"/docs/clustering/configuration-47","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"How often a recovering replica re-requests the current view's StartView"},"1535":{"id":"/docs/clustering/configuration-48","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"view_probe_attempts_max"},"1536":{"id":"/docs/clustering/configuration-49","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"5"},"1537":{"id":"/docs/clustering/configuration-50","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Unanswered RequestStartView probes a recovering replica tolerates before falling back to an election"},"1538":{"id":"/docs/clustering/configuration-51","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"repair_retry_interval"},"1539":{"id":"/docs/clustering/configuration-52","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"1s"},"1540":{"id":"/docs/clustering/configuration-53","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"How long a stalled journal-repair stream waits before re-requesting its remaining window"},"1541":{"id":"/docs/clustering/configuration-54","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"repair_gap_debounce_interval"},"1542":{"id":"/docs/clustering/configuration-55","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"1s"},"1543":{"id":"/docs/clustering/configuration-56","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"How long a committed-history gap waits before opening a repair session; floored at 500ms"},"1544":{"id":"/docs/clustering/configuration-57","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"repair_chunk_max"},"1545":{"id":"/docs/clustering/configuration-58","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"128"},"1546":{"id":"/docs/clustering/configuration-59","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Prepares a peer serves per repair round"},"1547":{"id":"/docs/clustering/configuration-60","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#consensus-timing","content":"Raise heartbeat_timeout on oversubscribed hosts where scheduling stalls fake primary death. Otherwise keep the defaults unless tests show a specific scheduling or network problem."},"1548":{"id":"/docs/clustering/configuration-61","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#validation-rules","content":"Boot-time validation enforces these constraints:"},"1549":{"id":"/docs/clustering/configuration-62","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#validation-rules","content":"Every duration must be nonzero. The 0, disabled, and unlimited sentinels all parse to a zero duration and are rejected. There's no way to switch the liveness window off."},"1550":{"id":"/docs/clustering/configuration-63","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#validation-rules","content":"heartbeat_timeout must be at least 2s and at least 4x commit_broadcast_interval, so one delayed broadcast never trips an election on a healthy primary."},"1551":{"id":"/docs/clustering/configuration-64","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#validation-rules","content":"view_change_status_timeout must be at least 4x view_change_retransmit_interval, so a few dropped view-change messages retransmit instead of escalating into a fresh cluster-wide election."},"1552":{"id":"/docs/clustering/configuration-65","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#validation-rules","content":"view_probe_attempts_max must be between 1 and 100."},"1553":{"id":"/docs/clustering/configuration-66","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#validation-rules","content":"repair_chunk_max must be between 1 and 1024, and strictly below message_bus.peer_queue_capacity: each repair frame rides the per-peer message-bus queue, and a full round above that capacity would overrun the queue and drop frames."},"1554":{"id":"/docs/clustering/configuration-67","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#superblock-failure-handling","content":"superblock_wedged_fatal_timeout defaults to 2m. It controls how long repeated superblock persistence failures can continue before the process exits. The affected consensus group stays fenced while persistence is failing. 0, disabled, or unlimited disables the process exit, leaving the group fenced; a nonzero value must be at least 30s."},"1555":{"id":"/docs/clustering/configuration-68","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#coordinator-placement","content":"These settings live under [cluster.coordinator] and apply when the server has more than one shard:"},"1556":{"id":"/docs/clustering/configuration-69","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#coordinator-placement","content":"Setting"},"1557":{"id":"/docs/clustering/configuration-70","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#coordinator-placement","content":"Default"},"1558":{"id":"/docs/clustering/configuration-71","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#coordinator-placement","content":"Purpose"},"1559":{"id":"/docs/clustering/configuration-72","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#coordinator-placement","content":"skip_shard_zero_for_replicas"},"1560":{"id":"/docs/clustering/configuration-73","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#coordinator-placement","content":"true"},"1561":{"id":"/docs/clustering/configuration-74","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#coordinator-placement","content":"Places replica connections on peer shards instead of shard 0"},"1562":{"id":"/docs/clustering/configuration-75","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#coordinator-placement","content":"skip_shard_zero_for_clients"},"1563":{"id":"/docs/clustering/configuration-76","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#coordinator-placement","content":"false"},"1564":{"id":"/docs/clustering/configuration-77","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#coordinator-placement","content":"When enabled, excludes shard 0 from client connection placement"},"1565":{"id":"/docs/clustering/configuration-78","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#node-roster","content":"cluster.nodes is the full roster of cluster members and is intended to be byte-identical on every node. The running node finds its own entry through the --replica-id CLI flag. Environment variables replace the entire cluster.nodes array rather than merging individual fields into TOML entries. If you configure any roster entry through environment variables, provide the complete roster that way."},"1566":{"id":"/docs/clustering/configuration-79","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#name","content":"Node name, unique within the roster and non-empty."},"1567":{"id":"/docs/clustering/configuration-80","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#ip","content":"The node's roster address. Replica-to-replica consensus traffic and follower-to-primary HTTP forwarding dial it, so it must be a literal IPv4 or IPv6 address. Hostnames and unspecified addresses (0.0.0.0 or ::) are rejected when the server resolves the roster at startup."},"1568":{"id":"/docs/clustering/configuration-81","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#ip","content":"ip is not the bind interface for the client transports. tcp, quic, http, and websocket bind whatever their own address settings say. The roster supplies only their ports. The defaults bind loopback, so a cluster spread across hosts needs each transport's address set to 0.0.0.0 or the routable interface. The server warns at startup when a bind cannot serve the advertised ip."},"1569":{"id":"/docs/clustering/configuration-82","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#replica_id","content":"Numeric replica id for VSR consensus, 0-based. Ids must be unique and strictly less than the roster size, which makes them contiguous from 0. Rosters with more than 255 replicas are unsupported."},"1570":{"id":"/docs/clustering/configuration-83","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#ports","content":"Per-node listener ports: tcp, quic, http, websocket, and tcp_replica. In cluster mode ports is the single source of listener ports: every enabled transport needs an explicit per-node port, otherwise the server refuses to start. tcp and tcp_replica are always required, even when client TCP is disabled. tcp_replica carries consensus traffic. Port 0 is rejected, and no two roster entries may claim the same ip:port."},"1571":{"id":"/docs/clustering/configuration-84","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_address","content":"Optional client-facing address handed out in cluster metadata and leader redirects. Set it when ip is a private replica-network address unreachable by clients (Docker, Kubernetes, NAT). Accepts a literal IP or an RFC 1123 DNS hostname: ASCII letters, digits, - and ., no port, no trailing dot. When unset, clients receive ip."},"1572":{"id":"/docs/clustering/configuration-85","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Per-client-network overrides for split networks, where one catch-all advertised_address would route in-VPC clients out through the public side:"},"1573":{"id":"/docs/clustering/configuration-86","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Clients whose transport-level peer IP falls inside client_cidr are handed address instead of the catch-all. The longest matching prefix wins. Clients matching no selector fall back to advertised_address, then ip. address takes the same forms as advertised_address (literal IP or hostname, never a port)."},"1574":{"id":"/docs/clustering/configuration-87","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Rules and caveats:"},"1575":{"id":"/docs/clustering/configuration-88","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"At most 16 selectors per node. Boot rejects duplicate client_cidr entries on one node (compared truncated, so 10.0.1.0/16 duplicates 10.0.0.0/16) and any two nodes advertising one host:port to overlapping client sets."},"1576":{"id":"/docs/clustering/configuration-89","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Matching is per address family: 0.0.0.0/0 matches no IPv6 client and ::/0 matches no IPv4 client, so covering both families takes one selector per family. IPv4-mapped IPv6 CIDRs (::ffff:10.0.0.0/104) match like their IPv4 form only at prefix length 96 or longer."},"1577":{"id":"/docs/clustering/configuration-90","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Matching sees the transport-level peer address, so clients behind a proxy or load balancer match the proxy's network, not their own."},"1578":{"id":"/docs/clustering/configuration-91","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Every address must be routable from inside its own client_cidr: leader-aware clients redial whatever address metadata advertises, and a selector pointing at an unreachable host strands them mid-redirect."},"1579":{"id":"/docs/clustering/configuration-92","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Prefer literal IPs over hostnames. SDKs differ in how they compare an advertised hostname against the address they dialed, and a mismatch costs a reconnect on every fresh connect."},"1580":{"id":"/docs/clustering/configuration-93","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#advertised_addresses","content":"Rolling upgrades: VSR builds predating selector support reject a TOML config containing advertised_addresses. Their release builds warn and ignore the equivalent IGGY_CLUSTER_NODES_*_ADVERTISED_ADDRESSES_* env vars; debug builds can panic on them. Upgrade every binary first, then add selectors."},"1581":{"id":"/docs/clustering/configuration-94","page_id":"/docs/clustering/configuration","tags":[],"type":"text","url":"/docs/clustering/configuration#authentication-and-tls","content":"[cluster.auth] configures the pre-shared-key replica handshake and [cluster.tls] wraps replica connections in TLS. Both are covered in Security."},"1582":{"id":"/docs/clustering/deploy","page_id":"/docs/clustering/deploy","type":"page","content":"Deploy a Cluster","breadcrumbs":["Documentation","Clustering"],"tags":[],"url":"/docs/clustering/deploy"},"1583":{"id":"/docs/clustering/deploy-0","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy","content":"Build the binaries and run a three-node Apache Iggy cluster"},"1584":{"id":"/docs/clustering/deploy-1","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#build-from-source","content":"Build from source"},"1585":{"id":"/docs/clustering/deploy-2","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#run-one-development-node","content":"Run one development node"},"1586":{"id":"/docs/clustering/deploy-3","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"Run a three-node cluster"},"1587":{"id":"/docs/clustering/deploy-4","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#spanning-multiple-hosts","content":"Spanning multiple hosts"},"1588":{"id":"/docs/clustering/deploy-5","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#containers","content":"Containers"},"1589":{"id":"/docs/clustering/deploy-6","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#check-cluster-metadata","content":"Check cluster metadata"},"1590":{"id":"/docs/clustering/deploy-7","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#reset-a-replica","content":"Reset a replica"},"1591":{"id":"/docs/clustering/deploy-8","page_id":"/docs/clustering/deploy","type":"heading","tags":[],"url":"/docs/clustering/deploy#run-the-cluster-test-suites","content":"Run the cluster test suites"},"1592":{"id":"/docs/clustering/deploy-9","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy","content":"Build iggy-server and the iggy CLI, run a single development node, then bring up a three-node cluster on one machine. See Configuration for the full [cluster] reference."},"1593":{"id":"/docs/clustering/deploy-10","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#build-from-source","content":"Build the server and CLI from the repository root:"},"1594":{"id":"/docs/clustering/deploy-11","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#build-from-source","content":"The binaries are:"},"1595":{"id":"/docs/clustering/deploy-12","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#build-from-source","content":"The server uses Linux io_uring. Use a recent Linux kernel and a sufficient locked-memory limit."},"1596":{"id":"/docs/clustering/deploy-13","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-one-development-node","content":"The default core/server/config.toml has clustering disabled, so a plain run starts a single node:"},"1597":{"id":"/docs/clustering/deploy-14","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-one-development-node","content":"--with-default-root-credentials sets the root user to iggy/iggy unless IGGY_ROOT_USERNAME and IGGY_ROOT_PASSWORD are already exported. These values initialize the root user only on its first creation. Later starts recover the stored user; supplied environment values are still validated at boot."},"1598":{"id":"/docs/clustering/deploy-15","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-one-development-node","content":"When clustering is disabled, --replica-id 0 is still accepted. Any other id is rejected because it would have to match a cluster.nodes entry."},"1599":{"id":"/docs/clustering/deploy-16","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"Every node loads the same configuration. Nodes are told apart only by --replica-id, which selects that node's own entry in the cluster.nodes roster."},"1600":{"id":"/docs/clustering/deploy-17","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"Save this as /tmp/iggy-vsr.toml:"},"1601":{"id":"/docs/clustering/deploy-18","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"cluster.name is a permanent on-disk identity. It is hashed into the cluster id stamped into every metadata and partition superblock on first boot. Changing the name later makes the server refuse to start against the existing data, so renaming a cluster means starting from an empty data directory."},"1602":{"id":"/docs/clustering/deploy-19","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"Export the settings shared by all three processes:"},"1603":{"id":"/docs/clustering/deploy-20","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"Root credentials are mandatory on the first boot of each replica when clustering is enabled. Restarts recover the stored root user. The shared secret must be at least 32 bytes. See Security for how it's used and rotated."},"1604":{"id":"/docs/clustering/deploy-21","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"Start each replica in a separate terminal. Use a different data path for every process:"},"1605":{"id":"/docs/clustering/deploy-22","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"The exported settings must be present in all three terminals."},"1606":{"id":"/docs/clustering/deploy-23","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"In cluster mode:"},"1607":{"id":"/docs/clustering/deploy-24","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"--replica-id is required and must match exactly one cluster.nodes entry"},"1608":{"id":"/docs/clustering/deploy-25","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"replica_id values must be unique and contiguous from 0"},"1609":{"id":"/docs/clustering/deploy-26","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"ports is the single source of listener ports: every enabled transport needs an explicit per-node port, otherwise the server refuses to start"},"1610":{"id":"/docs/clustering/deploy-27","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"tcp and tcp_replica ports are always required, even when client TCP is disabled; tcp_replica carries replica-to-replica consensus traffic"},"1611":{"id":"/docs/clustering/deploy-28","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"ip must be a literal IP address. Use advertised_address when clients can't reach it (see Configuration)"},"1612":{"id":"/docs/clustering/deploy-29","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-a-three-node-cluster","content":"use a different root path for each process on the same host"},"1613":{"id":"/docs/clustering/deploy-30","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#spanning-multiple-hosts","content":"The roster ip is the address other replicas dial. It's not the bind interface for the client transports: tcp, quic, http, and websocket bind whatever their own address settings say, and the roster supplies only the port. The defaults listen on loopback, so a cluster spread across hosts needs each transport's address set to 0.0.0.0 or the routable interface. The server warns at startup when a bind cannot serve the advertised ip."},"1614":{"id":"/docs/clustering/deploy-31","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#containers","content":"Every roster field can be provided through typed environment variables instead of TOML, which suits container deployments:"},"1615":{"id":"/docs/clustering/deploy-32","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#containers","content":"Give each container a static IP and put that IP in the roster: cluster.nodes[*].ip does not accept hostnames or Docker service names. The repository ships a working reference in bdd/docker-compose.cluster.yml, a real two-node cluster used by the BDD suites."},"1616":{"id":"/docs/clustering/deploy-33","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#check-cluster-metadata","content":"Ask any node for the cluster state with the CLI:"},"1617":{"id":"/docs/clustering/deploy-34","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#check-cluster-metadata","content":"The response lists the cluster name, nodes, client endpoints, and current roles. cluster m is a shorthand for cluster metadata."},"1618":{"id":"/docs/clustering/deploy-35","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#reset-a-replica","content":"iggy-server --fresh deletes the configured data directory before boot. In cluster mode this wipes that replica only: it rejoins the cluster and refills its state by transfer from the other replicas. Wiping a quorum of replicas at the same time destroys committed data, and a service unit that always passes --fresh re-transfers the whole dataset on every restart."},"1619":{"id":"/docs/clustering/deploy-36","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-the-cluster-test-suites","content":"The cross-SDK BDD suites use a standalone server for basic features and add the two-node cluster from bdd/docker-compose.cluster.yml for leader_redirection or all:"},"1620":{"id":"/docs/clustering/deploy-37","page_id":"/docs/clustering/deploy","tags":[],"type":"text","url":"/docs/clustering/deploy#run-the-cluster-test-suites","content":"The first argument selects the SDK (rust, python, php, go, go-race, node, csharp, java, cpp, or all) and the optional second argument selects one feature (basic_messaging, leader_redirection, raw_command, stream_crud, or all). leader_redirection is the clustered feature. The Rust, Go, C#, and Java suites support it."},"1621":{"id":"/docs/clustering/durability","page_id":"/docs/clustering/durability","type":"page","content":"Cluster Durability","breadcrumbs":["Documentation","Clustering"],"tags":[],"url":"/docs/clustering/durability"},"1622":{"id":"/docs/clustering/durability-0","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability","content":"Quorum completion, persisted prepare history, and the failures each topic policy covers."},"1623":{"id":"/docs/clustering/durability-1","page_id":"/docs/clustering/durability","type":"heading","tags":[],"url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"What an acknowledgement means"},"1624":{"id":"/docs/clustering/durability-2","page_id":"/docs/clustering/durability","type":"heading","tags":[],"url":"/docs/clustering/durability#replicated-completion","content":"Replicated completion"},"1625":{"id":"/docs/clustering/durability-3","page_id":"/docs/clustering/durability","type":"heading","tags":[],"url":"/docs/clustering/durability#persisted-completion","content":"Persisted completion"},"1626":{"id":"/docs/clustering/durability-4","page_id":"/docs/clustering/durability","type":"heading","tags":[],"url":"/docs/clustering/durability#recovery-and-failure-limits","content":"Recovery and failure limits"},"1627":{"id":"/docs/clustering/durability-5","page_id":"/docs/clustering/durability","type":"heading","tags":[],"url":"/docs/clustering/durability#choosing-the-policies","content":"Choosing the policies"},"1628":{"id":"/docs/clustering/durability-6","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability","content":"Iggy uses Viewstamped Replication to commit partition\noperations. The topic's durability and consumer_offset_durability\noptions select the storage guarantee required for message production and\nexplicit offset changes, respectively. Both default independently to\nreplicated. Both continue to write data to disk."},"1629":{"id":"/docs/clustering/durability-7","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability","content":"For the creation options and single-node behavior, see\nDurability."},"1630":{"id":"/docs/clustering/durability-8","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"For an operation that waits for completion:"},"1631":{"id":"/docs/clustering/durability-9","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"Policy"},"1632":{"id":"/docs/clustering/durability-10","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"Required before success"},"1633":{"id":"/docs/clustering/durability-11","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"replicated"},"1634":{"id":"/docs/clustering/durability-12","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"VSR quorum commit and local application, without an additional stable-storage barrier"},"1635":{"id":"/docs/clustering/durability-13","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"persisted"},"1636":{"id":"/docs/clustering/durability-14","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"VSR quorum commit backed by recoverable stable-storage copies at the required quorum, followed by local application"},"1637":{"id":"/docs/clustering/durability-15","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"The policy changes what a replica must retain before its acknowledgement can\ncount toward commit. It does not replace quorum commit with a primary-only\ndisk write."},"1638":{"id":"/docs/clustering/durability-16","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"Iggy's replication quorum is not a strict majority for every group size:"},"1639":{"id":"/docs/clustering/durability-17","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"Replicas"},"1640":{"id":"/docs/clustering/durability-18","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"Replication quorum"},"1641":{"id":"/docs/clustering/durability-19","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"View-change quorum"},"1642":{"id":"/docs/clustering/durability-20","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"1"},"1643":{"id":"/docs/clustering/durability-21","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"1"},"1644":{"id":"/docs/clustering/durability-22","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"1"},"1645":{"id":"/docs/clustering/durability-23","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"2"},"1646":{"id":"/docs/clustering/durability-24","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"2"},"1647":{"id":"/docs/clustering/durability-25","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"2"},"1648":{"id":"/docs/clustering/durability-26","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"3"},"1649":{"id":"/docs/clustering/durability-27","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"2"},"1650":{"id":"/docs/clustering/durability-28","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"2"},"1651":{"id":"/docs/clustering/durability-29","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"4"},"1652":{"id":"/docs/clustering/durability-30","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"2"},"1653":{"id":"/docs/clustering/durability-31","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"3"},"1654":{"id":"/docs/clustering/durability-32","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"5"},"1655":{"id":"/docs/clustering/durability-33","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"3"},"1656":{"id":"/docs/clustering/durability-34","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"3"},"1657":{"id":"/docs/clustering/durability-35","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"6"},"1658":{"id":"/docs/clustering/durability-36","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"3"},"1659":{"id":"/docs/clustering/durability-37","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"4"},"1660":{"id":"/docs/clustering/durability-38","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#what-an-acknowledgement-means","content":"Except for two replicas, the replication quorum is min(ceil(n / 2), 3)\nand the view-change quorum is n - replication_quorum + 1. Two replicas\nrequire both for either quorum. The quorums therefore intersect. These are\nthe implemented quorum rules,\nnot a configurable acknowledgement count."},"1661":{"id":"/docs/clustering/durability-39","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#replicated-completion","content":"With both policies set to replicated, partition prepares stay off the\ndisk prepare-WAL path. Replicas retain the prepares in memory, and committed\nmessages reach segment files through ordinary flush scheduling."},"1662":{"id":"/docs/clustering/durability-40","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#replicated-completion","content":"Success therefore does not prove that the operation reached stable storage\non any replica. Replication protects against failures while sufficient peers\nretain the history and can form the quorums needed for recovery and progress.\nFor example, a healthy three-replica group can continue after one replica\nfails."},"1663":{"id":"/docs/clustering/durability-41","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#replicated-completion","content":"Failure independence matters. A shared power loss, an OOM cascade, or a\ncrash triggered on every replica can destroy multiple volatile copies at\nonce. A process-only failure can lose messages still in the processes'\njournals, even while the kernels and their page caches remain alive.\nReplication count alone does not establish a bound on that loss."},"1664":{"id":"/docs/clustering/durability-42","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#persisted-completion","content":"When either policy is persisted, each multi-replica partition uses a\nbounded on-disk prepare WAL. Message prepares contain headers and segment\nreferences; their payloads live in segment files retained by hard links until\nthe WAL history can be reclaimed. Other operations are stored inline. A prepare\nrequiring persistence cannot release its PrepareOk until its message bodies,\nWAL history, and durable frontier are recoverable."},"1665":{"id":"/docs/clustering/durability-43","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#persisted-completion","content":"Prepares can be forwarded while local persistence is pending. Once enough\nreplicas have met the required barrier, the operation can commit and the\nprimary can apply it and reply. An acknowledged message can be recovered\nthrough the WAL before ordinary segment materialization and index updates\nfinish; recovery does not depend on first reaching a segment flush threshold."},"1666":{"id":"/docs/clustering/durability-44","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#persisted-completion","content":"The WAL also retains predecessors across message and offset operations.\nConsequently:"},"1667":{"id":"/docs/clustering/durability-45","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#persisted-completion","content":"durability=persisted does not make an offset response persisted when\nconsumer_offset_durability=replicated."},"1668":{"id":"/docs/clustering/durability-46","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#persisted-completion","content":"consumer_offset_durability=persisted with replicated messages still\nretains message payloads through WAL segment references. A durable offset's predecessor history must\nremain recoverable."},"1669":{"id":"/docs/clustering/durability-47","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#persisted-completion","content":"A shared barrier can also persist co-batched operations with the weaker\npolicy. That incidental persistence does not strengthen what their earlier\nreplicated acknowledgements promised."},"1670":{"id":"/docs/clustering/durability-48","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#persisted-completion","content":"Only the replicated / replicated combination avoids the disk prepare\nWAL entirely."},"1671":{"id":"/docs/clustering/durability-49","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#persisted-completion","content":"WAL history is reclaimed only after the materialized segment and offset\nstate needed to replace it has been synchronized. The server's\n[partition] wal_bytes_max setting, default 256 MiB, bounds retained\nand queued/in-flight prepare bytes per partition. The accounting includes\nmessage bodies even when the WAL stores only references to them. Capacity pressure causes\ncheckpointing and backpressure; it does not downgrade a persisted operation.\nTemporary rewrites need additional disk space."},"1672":{"id":"/docs/clustering/durability-50","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#recovery-and-failure-limits","content":"A restarting replica loads segment and offset state and, when enabled,\nreconciles the durable prepare WAL with that state. It also restores durable\nconsensus state and follows the recovery protocol before serving as a healthy\nreplica. It does not treat every locally recovered prepare as committed."},"1673":{"id":"/docs/clustering/durability-51","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#recovery-and-failure-limits","content":"Missing required history, checksum failures, or contradictory materialized\nstate must not become an empty healthy partition. Recovery can fence a\npartition and repair it from peers. Storage errors withhold successful\ncompletion; a locally failed application of a committed operation fences the\npartition and initiates server shutdown."},"1674":{"id":"/docs/clustering/durability-52","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#recovery-and-failure-limits","content":"persisted protects acknowledged operations across process and power\nfailures when the required storage copies remain intact and the storage\nhonors synchronization. Recovery and availability still require the\nprotocol's quorums. It cannot protect against destruction of all durable\ncopies, nor does it prevent configured retention or explicit deletion."},"1675":{"id":"/docs/clustering/durability-53","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#choosing-the-policies","content":"Use replicated when the workload accepts the risk of losing acknowledged\noperations after correlated failures in exchange for avoiding a required\nstorage barrier at completion. Isolate replicas across failure domains; see\nDeployment."},"1676":{"id":"/docs/clustering/durability-54","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#choosing-the-policies","content":"Use durability=persisted when acknowledged messages must be recoverable\nafter volatile copies are lost. Select\nconsumer_offset_durability=persisted independently when explicit offset\nstores and deletes need the same guarantee. Ordinary flush thresholds can\nremain at their defaults."},"1677":{"id":"/docs/clustering/durability-55","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#choosing-the-policies","content":"Neither policy turns HTTP ack=none or a poll's auto-commit into an awaited\ndurable result. See Which responses prove completion."},"1678":{"id":"/docs/clustering/durability-56","page_id":"/docs/clustering/durability","tags":[],"type":"text","url":"/docs/clustering/durability#choosing-the-policies","content":"The storage mechanisms are implemented in the\npartition persistence worker\nand prepare journal.\nThe crash-recovery tests\nexercise acknowledged persisted messages and offsets below ordinary flush\nthresholds, on both a singleton and a three-replica cluster."},"1679":{"id":"/docs/clustering/security","page_id":"/docs/clustering/security","type":"page","content":"Cluster Security","breadcrumbs":["Documentation","Clustering"],"tags":[],"url":"/docs/clustering/security"},"1680":{"id":"/docs/clustering/security-0","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security","content":"Replica authentication, shared-secret rotation, and TLS for replica traffic"},"1681":{"id":"/docs/clustering/security-1","page_id":"/docs/clustering/security","type":"heading","tags":[],"url":"/docs/clustering/security#replica-authentication","content":"Replica authentication"},"1682":{"id":"/docs/clustering/security-2","page_id":"/docs/clustering/security","type":"heading","tags":[],"url":"/docs/clustering/security#rotating-the-shared-secret","content":"Rotating the shared secret"},"1683":{"id":"/docs/clustering/security-3","page_id":"/docs/clustering/security","type":"heading","tags":[],"url":"/docs/clustering/security#replica-tls","content":"Replica TLS"},"1684":{"id":"/docs/clustering/security-4","page_id":"/docs/clustering/security","type":"heading","tags":[],"url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"HTTP tokens across the cluster"},"1685":{"id":"/docs/clustering/security-5","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security","content":"Replica-to-replica security has two layers, both in the [cluster] configuration: a pre-shared-key handshake that authenticates peers ([cluster.auth]) and optional TLS that encrypts the replica connection ([cluster.tls])."},"1686":{"id":"/docs/clustering/security-6","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-authentication","content":"Replica authentication uses a cluster-wide pre-shared key (PSK) and a BLAKE3 keyed-MAC handshake. With cluster.auth.enabled = true, every replica peer must complete the authenticated handshake or be rejected:"},"1687":{"id":"/docs/clustering/security-7","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-authentication","content":"The secret must be at least 32 bytes of CSPRNG output and byte-identical on every node."},"1688":{"id":"/docs/clustering/security-8","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-authentication","content":"Prefer the IGGY_CLUSTER_AUTH_SHARED_SECRET environment variable over storing the secret in TOML. The value is masked in logs and never written into the runtime configuration snapshot."},"1689":{"id":"/docs/clustering/security-9","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-authentication","content":"Authentication is off by default, which leaves replica traffic unauthenticated. Enabling it is a coordinated-restart change: flip every node in one restart."},"1690":{"id":"/docs/clustering/security-10","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-authentication","content":"The 32-byte minimum is enforced whenever the cluster is enabled, even with auth.enabled = false: a configured non-empty secret shorter than 32 bytes fails boot."},"1691":{"id":"/docs/clustering/security-11","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#rotating-the-shared-secret","content":"previous_shared_secret enables a rolling key rotation without an authentication outage. The retiring key is accepted for verification only. Every MAC a node produces uses shared_secret. Rotate in three rolls, restarting every node after each step:"},"1692":{"id":"/docs/clustering/security-12","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#rotating-the-shared-secret","content":"shared_secret = old, previous_shared_secret = new on every node"},"1693":{"id":"/docs/clustering/security-13","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#rotating-the-shared-secret","content":"shared_secret = new, previous_shared_secret = old on every node"},"1694":{"id":"/docs/clustering/security-14","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#rotating-the-shared-secret","content":"shared_secret = new alone, closing the window"},"1695":{"id":"/docs/clustering/security-15","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#rotating-the-shared-secret","content":"Leave previous_shared_secret empty outside a rotation. It has the same 32-byte floor and the same environment-variable preference as the primary key (IGGY_CLUSTER_AUTH_PREVIOUS_SHARED_SECRET), and it must differ from shared_secret. An identical value is refused at boot because the rotation would be a no-op."},"1696":{"id":"/docs/clustering/security-16","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-tls","content":"[cluster.tls] wraps every replica connection on the tcp_replica port in TLS 1.3 (ALPN iggy-replica) before the replica handshake runs:"},"1697":{"id":"/docs/clustering/security-17","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-tls","content":"TLS requires cluster.auth.enabled = true, and the server refuses to start otherwise. The reason: replica TLS carries no client certificates, so it authenticates the acceptor only. The PSK handshake authenticates the peer. TLS supplies confidentiality. Without the PSK requirement, any TLS-capable host could register as a replica."},"1698":{"id":"/docs/clustering/security-18","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-tls","content":"Enabling TLS is also a coordinated-restart change: a TLS dialer can't talk to a plaintext acceptor or vice versa."},"1699":{"id":"/docs/clustering/security-19","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-tls","content":"Two certificate modes exist:"},"1700":{"id":"/docs/clustering/security-20","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-tls","content":"CA mode (self_signed = false, the default): cert_file, key_file, and ca_file are all required. Each node presents cert_file on its acceptor side, and dialers verify peer certificates against the ca_file trust anchors. The dialer verifies each peer against the ip string from that peer's cluster.nodes entry, so certificates need matching IP SANs."},"1701":{"id":"/docs/clustering/security-21","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#replica-tls","content":"Self-signed mode (self_signed = true): the node auto-generates a certificate at boot and the dialer accepts ANY peer certificate. This gives you encrypted replica traffic without certificate management, but no acceptor authentication at all: peer authenticity rests entirely on the PSK handshake. Use CA mode when the replica network is not trusted."},"1702":{"id":"/docs/clustering/security-22","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"Follower nodes forward control-plane HTTP requests (stream, topic, user, and similar metadata operations) to the current metadata primary, so any node can answer any control-plane request. This requires JWT key material that every node can verify, from either of two sources:"},"1703":{"id":"/docs/clustering/security-23","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"explicitly configured http.jwt signing secrets, identical on every node, or"},"1704":{"id":"/docs/clustering/security-24","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"the cluster PSK: when HTTP is enabled, cluster auth is enabled, and no http.jwt secrets are configured, the signing key is derived from shared_secret."},"1705":{"id":"/docs/clustering/security-25","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"Either way, matching JWT key material lets a bearer token minted on one node verify on another. If JWT keys are derived from the PSK, rotating the PSK also changes the JWT key: previous_shared_secret applies only to replica authentication. Use independently configured, shared JWT keys when HTTP tokens must remain valid across PSK rotation. Forwarded requests dial the primary at its roster ip and ports.http. The follower verifies the caller's bearer locally before forwarding, and the primary re-authenticates the request through its normal stack."},"1706":{"id":"/docs/clustering/security-26","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"Acknowledged partition-plane writes over HTTP (producing messages, storing or deleting consumer offsets) first run on the contacted node. If it returns TransientNotAccepted, the server tries the other configured HTTP nodes at most once each, within a bounded retry window. That response proves the operation was never admitted. Ambiguous outcomes are returned without replay, and ack=none does not provide an acknowledgement for this fallback. Each partition is its own consensus group, so its primary can differ from the metadata primary. See Client failover for how clients find it."},"1707":{"id":"/docs/clustering/security-27","page_id":"/docs/clustering/security","tags":[],"type":"text","url":"/docs/clustering/security#http-tokens-across-the-cluster","content":"When HTTP TLS is enabled, forwarding uses HTTPS and pins the destination certificate to the forwarding node's own HTTP leaf certificate. All nodes therefore need the same HTTP certificate for forwarding; distinct per-node HTTP certificates fail verification. Replica TLS is configured separately and does not encrypt the HTTP forwarding hop."},"1708":{"id":"/docs/clustering/vsr","page_id":"/docs/clustering/vsr","type":"page","content":"Viewstamped Replication","breadcrumbs":["Documentation","Clustering"],"tags":[],"url":"/docs/clustering/vsr"},"1709":{"id":"/docs/clustering/vsr-0","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr","content":"How Apache Iggy replicates data across a cluster with VSR"},"1710":{"id":"/docs/clustering/vsr-1","page_id":"/docs/clustering/vsr","type":"heading","tags":[],"url":"/docs/clustering/vsr#current-implementation","content":"Current implementation"},"1711":{"id":"/docs/clustering/vsr-2","page_id":"/docs/clustering/vsr","type":"heading","tags":[],"url":"/docs/clustering/vsr#replication-model","content":"Replication model"},"1712":{"id":"/docs/clustering/vsr-3","page_id":"/docs/clustering/vsr","type":"heading","tags":[],"url":"/docs/clustering/vsr#failure-handling","content":"Failure handling"},"1713":{"id":"/docs/clustering/vsr-4","page_id":"/docs/clustering/vsr","type":"heading","tags":[],"url":"/docs/clustering/vsr#wire-protocol-and-sdks","content":"Wire protocol and SDKs"},"1714":{"id":"/docs/clustering/vsr-5","page_id":"/docs/clustering/vsr","type":"heading","tags":[],"url":"/docs/clustering/vsr#status","content":"Status"},"1715":{"id":"/docs/clustering/vsr-6","page_id":"/docs/clustering/vsr","type":"heading","tags":[],"url":"/docs/clustering/vsr#next-steps","content":"Next steps"},"1716":{"id":"/docs/clustering/vsr-7","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr","content":"Apache Iggy replicates clusters with Viewstamped Replication Revisited (VSR). VSR keeps an ordered state machine consistent across replicas and elects a new primary when the current primary fails."},"1717":{"id":"/docs/clustering/vsr-8","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr","content":"Clustering is built into the standard iggy-server binary. There's no separate build, binary, or Cargo feature: the same server runs single-node or clustered, and cluster.enabled in the configuration decides which one you get. Clustering is disabled by default."},"1718":{"id":"/docs/clustering/vsr-9","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr","content":"Read the VSR paper used by the project for the protocol specification."},"1719":{"id":"/docs/clustering/vsr-10","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr","content":"Iggy hasn't reached a 1.0 production release yet. The cluster protocol and configuration described here can still change between pre-release versions."},"1720":{"id":"/docs/clustering/vsr-11","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"The implementation includes:"},"1721":{"id":"/docs/clustering/vsr-12","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"normal operation with quorum commits"},"1722":{"id":"/docs/clustering/vsr-13","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"view changes and deterministic primary selection"},"1723":{"id":"/docs/clustering/vsr-14","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"metadata and partition replication"},"1724":{"id":"/docs/clustering/vsr-15","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"persistent WAL recovery and snapshots"},"1725":{"id":"/docs/clustering/vsr-16","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"replica rejoin with journal repair"},"1726":{"id":"/docs/clustering/vsr-17","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"client sessions, request fencing, and duplicate detection"},"1727":{"id":"/docs/clustering/vsr-18","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"replica authentication and optional TLS"},"1728":{"id":"/docs/clustering/vsr-19","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"leader redirection in the client SDKs"},"1729":{"id":"/docs/clustering/vsr-20","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"deterministic simulation and cross-SDK BDD coverage"},"1730":{"id":"/docs/clustering/vsr-21","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"The main components are:"},"1731":{"id":"/docs/clustering/vsr-22","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"Component"},"1732":{"id":"/docs/clustering/vsr-23","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"Source"},"1733":{"id":"/docs/clustering/vsr-24","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"Responsibility"},"1734":{"id":"/docs/clustering/vsr-25","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"Server"},"1735":{"id":"/docs/clustering/vsr-26","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"core/server"},"1736":{"id":"/docs/clustering/vsr-27","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"Sharded runtime, listeners, recovery, and request dispatch"},"1737":{"id":"/docs/clustering/vsr-28","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"Consensus"},"1738":{"id":"/docs/clustering/vsr-29","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"core/consensus"},"1739":{"id":"/docs/clustering/vsr-30","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"VSR state machine, quorum, view changes, and timeouts"},"1740":{"id":"/docs/clustering/vsr-31","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"Wire protocol"},"1741":{"id":"/docs/clustering/vsr-32","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"core/binary_protocol/src/consensus"},"1742":{"id":"/docs/clustering/vsr-33","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"Fixed-size VSR headers and replica messages"},"1743":{"id":"/docs/clustering/vsr-34","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"Simulator"},"1744":{"id":"/docs/clustering/vsr-35","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"core/simulator"},"1745":{"id":"/docs/clustering/vsr-36","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"Deterministic failures, delays, and network partitions"},"1746":{"id":"/docs/clustering/vsr-37","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"Rust SDK"},"1747":{"id":"/docs/clustering/vsr-38","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"core/sdk"},"1748":{"id":"/docs/clustering/vsr-39","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#current-implementation","content":"VSR framing, sessions, retries, and leader redirection"},"1749":{"id":"/docs/clustering/vsr-40","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Iggy splits replication by namespace:"},"1750":{"id":"/docs/clustering/vsr-41","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Plane"},"1751":{"id":"/docs/clustering/vsr-42","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Consensus group"},"1752":{"id":"/docs/clustering/vsr-43","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Replicated work"},"1753":{"id":"/docs/clustering/vsr-44","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Metadata"},"1754":{"id":"/docs/clustering/vsr-45","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"One group on shard 0"},"1755":{"id":"/docs/clustering/vsr-46","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Streams, topics, users, permissions, consumer groups, and access tokens"},"1756":{"id":"/docs/clustering/vsr-47","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Partition"},"1757":{"id":"/docs/clustering/vsr-48","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"One group per partition"},"1758":{"id":"/docs/clustering/vsr-49","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Messages and consumer offsets"},"1759":{"id":"/docs/clustering/vsr-50","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Each group can have a different primary. Metadata writes route through the metadata primary. Partition writes route through the primary for that partition."},"1760":{"id":"/docs/clustering/vsr-51","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#replication-model","content":"Reads use the local replicated state where possible. Writes return after the required VSR commit or return a retryable error when the replica is changing view or catching up. See Client failover for how the SDKs handle both."},"1761":{"id":"/docs/clustering/vsr-52","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#failure-handling","content":"VSR uses three main flows:"},"1762":{"id":"/docs/clustering/vsr-53","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#failure-handling","content":"Normal operation: the primary assigns an operation number, sends Prepare, and commits after a quorum sends PrepareOk."},"1763":{"id":"/docs/clustering/vsr-54","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#failure-handling","content":"View change: replicas exchange StartViewChange and DoViewChange, then the new primary sends StartView."},"1764":{"id":"/docs/clustering/vsr-55","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#failure-handling","content":"Recovery: a restarted or lagging replica requests the current view and repairs missing WAL ranges before serving current state."},"1765":{"id":"/docs/clustering/vsr-56","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#failure-handling","content":"Three replicas tolerate one unavailable replica; five tolerate two. Larger groups use a capped replication quorum and a growing view-change quorum, so the usual 2f + 1 rule does not apply to every group size. See Cluster durability for the quorum rules. Use at least three replicas for one-node fault tolerance. A two-node cluster is useful for development, but it cannot make progress after either node fails."},"1766":{"id":"/docs/clustering/vsr-57","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#wire-protocol-and-sdks","content":"VSR framing is the only binary wire protocol, used by TCP, QUIC, and WebSocket connections. HTTP uses the REST API. Every SDK (Rust, Go, Java, C#, C++, Node.js, Python) speaks it, and every BDD suite runs against the clustered-capable iggy-server. Binary clients built before the VSR migration cannot talk to current servers."},"1767":{"id":"/docs/clustering/vsr-58","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#wire-protocol-and-sdks","content":"The Rust SDK needs no feature flags. Depend on the published crate:"},"1768":{"id":"/docs/clustering/vsr-59","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#wire-protocol-and-sdks","content":"or track the repository directly with iggy = { git = \"https://github.com/apache/iggy\" }."},"1769":{"id":"/docs/clustering/vsr-60","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#wire-protocol-and-sdks","content":"The client API is the same in single-node and cluster mode. This example uses the iggy / iggy credentials explicitly provisioned in Getting started:"},"1770":{"id":"/docs/clustering/vsr-61","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#status","content":"VSR started as a parallel server-ng implementation behind a vsr build feature. That phase is over. The VSR server moved into the mainline core/server crate and the iggy-server binary, the feature flag is gone, and the legacy server and its wire format were deleted. What this page describes is the only server implementation."},"1771":{"id":"/docs/clustering/vsr-62","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#next-steps","content":"Deploy a cluster: build the binaries and run a three-node cluster"},"1772":{"id":"/docs/clustering/vsr-63","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#next-steps","content":"Configuration: every [cluster] setting and its validation rules"},"1773":{"id":"/docs/clustering/vsr-64","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#next-steps","content":"Security: replica authentication, key rotation, and TLS"},"1774":{"id":"/docs/clustering/vsr-65","page_id":"/docs/clustering/vsr","tags":[],"type":"text","url":"/docs/clustering/vsr#next-steps","content":"Client failover: reads, writes, and leader redirection from the client side"},"1775":{"id":"/docs/faq/faq","page_id":"/docs/faq/faq","type":"page","content":"FAQ","breadcrumbs":["Documentation","FAQ"],"tags":[],"url":"/docs/faq/faq"},"1776":{"id":"/docs/faq/faq-0","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq","content":"Common questions about Apache Iggy, including how it compares to Kafka and other message brokers."},"1777":{"id":"/docs/faq/faq-1","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-what-is-the-difference-between-iggy-and-traditional-message-brokers-like-kafka","content":"Q: What is the difference between Iggy and traditional message brokers like Kafka?"},"1778":{"id":"/docs/faq/faq-2","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-are-there-plans-to-support-kafka-protocol-in-iggy","content":"Q: Are there plans to support Kafka protocol in Iggy?"},"1779":{"id":"/docs/faq/faq-3","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-what-transport-protocol-should-i-use","content":"Q: What transport protocol should I use?"},"1780":{"id":"/docs/faq/faq-4","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-what-are-the-system-requirements","content":"Q: What are the system requirements?"},"1781":{"id":"/docs/faq/faq-5","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-how-does-consumer-group-rebalancing-work","content":"Q: How does consumer group rebalancing work?"},"1782":{"id":"/docs/faq/faq-6","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-does-iggy-support-exactly-once-delivery","content":"Q: Does Iggy support exactly-once delivery?"},"1783":{"id":"/docs/faq/faq-7","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-how-do-i-secure-my-iggy-deployment","content":"Q: How do I secure my Iggy deployment?"},"1784":{"id":"/docs/faq/faq-8","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-can-i-use-iggy-with-my-existing-tooling","content":"Q: Can I use Iggy with my existing tooling?"},"1785":{"id":"/docs/faq/faq-9","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-what-happened-to-the-tokio-based-runtime","content":"Q: What happened to the Tokio-based runtime?"},"1786":{"id":"/docs/faq/faq-10","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-is-clusteringreplication-available","content":"Q: Is clustering/replication available?"},"1787":{"id":"/docs/faq/faq-11","page_id":"/docs/faq/faq","type":"heading","tags":[],"url":"/docs/faq/faq#q-what-examples-are-available","content":"Q: What examples are available?"},"1788":{"id":"/docs/faq/faq-12","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-what-is-the-difference-between-iggy-and-traditional-message-brokers-like-kafka","content":"Iggy is a persistent message streaming platform that stores messages in an append-only log format, similar to Kafka. However, Iggy is designed for high performance and low latency using io_uring and a thread-per-core architecture. Iggy uses its own binary protocol rather than the Kafka protocol. Clients can use an Iggy SDK, implement the documented binary protocol, or use the HTTP API."},"1789":{"id":"/docs/faq/faq-13","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-are-there-plans-to-support-kafka-protocol-in-iggy","content":"Currently, Iggy does not support the Kafka protocol. Our focus is on providing a high-performance native protocol that leverages the strengths of Iggy's architecture. However, we are open to community contributions (in fact there is an discussion about it)."},"1790":{"id":"/docs/faq/faq-14","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-what-transport-protocol-should-i-use","content":"For maximum throughput and lowest latency, use TCP. If you need built-in encryption without configuring TLS separately, QUIC is a good choice. WebSocket works well for browser-based clients. HTTP is the most accessible but has the highest overhead due to JSON serialization. HTTP connections can be reused. Consumer groups can be created, inspected, and deleted, but there is no join/leave membership over HTTP."},"1791":{"id":"/docs/faq/faq-15","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-what-are-the-system-requirements","content":"Iggy runs as a single server process without an external coordination service; native library requirements depend on the build. The provided Linux images include hwloc and udev libraries. The Linux shard runtime requires io_uring flags introduced in kernel 5.19. The server starts with around 20 MB of RAM; the default 4 GiB memory-pool setting is a budget, with buffers allocated on demand and fallback allocations outside the pool."},"1792":{"id":"/docs/faq/faq-16","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-what-are-the-system-requirements","content":"Docker must allow the required io_uring calls and provide enough locked-memory allowance. The supplied Compose configuration uses SYS_NICE, seccomp:unconfined and unlimited memlock; those settings are not universal requirements for every host. See Docker and configuration."},"1793":{"id":"/docs/faq/faq-17","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-how-does-consumer-group-rebalancing-work","content":"When consumers join or leave a consumer group, the server triggers cooperative partition rebalancing. Partitions are redistributed among active members. During rebalancing, a pending revocation phase fences new polls from the previous owner. Its configurable timeout defaults to 30s, after which the server can force a transfer. This coordinates polling ownership; it does not prove that application processing has finished."},"1794":{"id":"/docs/faq/faq-18","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-does-iggy-support-exactly-once-delivery","content":"Committing an offset before application processing, including poll-time auto-commit, can provide at-most-once processing: a crash can lose unprocessed messages. Committing only after successful processing supports at-least-once processing, with duplicates possible after a crash. Recovery also depends on retention and the configured message and consumer-offset durability. Iggy does not provide an atomic transaction between a consumer offset and an external side effect. Exactly-once application effects require an idempotent operation or an atomic deduplication-and-effect transaction; unique message IDs alone do not provide that guarantee."},"1795":{"id":"/docs/faq/faq-19","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-how-do-i-secure-my-iggy-deployment","content":"Iggy supports TLS on all transport protocols, Argon2id password hashing, granular per-stream/per-topic permissions, Personal Access Tokens for programmatic access, and optional AES-256-GCM message-payload encryption. For the HTTP API, JWT tokens are used for session management. See the Security documentation for details."},"1796":{"id":"/docs/faq/faq-20","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-can-i-use-iggy-with-my-existing-tooling","content":"Iggy provides a Model Context Protocol (MCP) server with 40+ tools for LLM integration, connectors for piping data to/from external systems (e.g. PostgreSQL, MongoDB, Elasticsearch, ClickHouse, InfluxDB, S3, Delta Lake, Apache Iceberg, Quickwit), Prometheus metrics, and OpenTelemetry traces/logs in the connectors runtime. Broker OpenTelemetry export has runtime limitations described in configuration. The HTTP API works with REST clients."},"1797":{"id":"/docs/faq/faq-21","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-what-happened-to-the-tokio-based-runtime","content":"Iggy migrated from Tokio to a thread-per-core architecture with compio (which uses io_uring on Linux) starting with version 0.6.0. The published v0.5.0 versus v0.7.0 comparison reports 92% lower P9999 latency for its 16-producer, 16-stream, 40-million-message workload, and 18% higher throughput for the corresponding fsync workload. These are historical workload results, not a guarantee for 0.9.0. You can read the full story in the thread-per-core io_uring blog post."},"1798":{"id":"/docs/faq/faq-22","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-is-clusteringreplication-available","content":"Yes. Replication based on Viewstamped Replication (VSR) is built into the server. Multi-node clustering is configured via the [cluster] section (single-node mode is the default, enabled = false). It covers consensus, view changes, node authentication, and TLS between nodes, and is maturing toward production readiness. See the Clustering documentation for the protocol and Deploy for setting up a cluster."},"1799":{"id":"/docs/faq/faq-23","page_id":"/docs/faq/faq","tags":[],"type":"text","url":"/docs/faq/faq#q-what-examples-are-available","content":"Examples are available in the repository for multiple languages: Rust (basic, getting-started, message-envelope, message-headers, multi-tenant, new-sdk, sink-data-producer, stream-builder, tcp-tls), C#, Go, Java, Node.js, PHP, and Python. Docker Compose files and Helm charts are also provided."},"1800":{"id":"/docs/connectors/introduction","page_id":"/docs/connectors/introduction","type":"page","content":"Introduction","breadcrumbs":["Documentation","Connectors"],"tags":[],"url":"/docs/connectors/introduction"},"1801":{"id":"/docs/connectors/introduction-0","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction","content":"The connector runtime: dynamically loaded source and sink plugins, how data flows through them, and what ships today."},"1802":{"id":"/docs/connectors/introduction-1","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#architecture","content":"Architecture"},"1803":{"id":"/docs/connectors/introduction-2","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#data-flow","content":"Data Flow"},"1804":{"id":"/docs/connectors/introduction-3","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#available-connectors","content":"Available Connectors"},"1805":{"id":"/docs/connectors/introduction-4","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#transforms","content":"Transforms"},"1806":{"id":"/docs/connectors/introduction-5","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#supported-schemas","content":"Supported Schemas"},"1807":{"id":"/docs/connectors/introduction-6","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#features","content":"Features"},"1808":{"id":"/docs/connectors/introduction-7","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#quick-start","content":"Quick Start"},"1809":{"id":"/docs/connectors/introduction-8","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#configuration","content":"Configuration"},"1810":{"id":"/docs/connectors/introduction-9","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#runtime","content":"Runtime"},"1811":{"id":"/docs/connectors/introduction-10","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#sink","content":"Sink"},"1812":{"id":"/docs/connectors/introduction-11","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#source","content":"Source"},"1813":{"id":"/docs/connectors/introduction-12","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#building-the-connectors","content":"Building the connectors"},"1814":{"id":"/docs/connectors/introduction-13","page_id":"/docs/connectors/introduction","type":"heading","tags":[],"url":"/docs/connectors/introduction#transformations","content":"Transformations"},"1815":{"id":"/docs/connectors/introduction-14","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction","content":"The highly performant and modular runtime for statically typed, yet dynamically loaded connectors. Ingest the data from the external sources and push it further to the Iggy streams, or fetch the data from the Iggy streams and push it further to the external sources. Create your own Rust plugins by simply implementing either the Source or Sink trait and build custom pipelines for the data processing."},"1816":{"id":"/docs/connectors/introduction-15","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction","content":"The docker image is available, and can be fetched via docker pull apache/iggy-connect:0.5.0."},"1817":{"id":"/docs/connectors/introduction-16","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#architecture","content":"Connectors are dynamically loaded shared libraries (.so on Linux, .dylib on macOS, .dll on Windows) loaded at runtime via dlopen2. Message batches and metadata crossing the FFI boundary between the runtime and plugins are serialized using postcard, a compact binary format. Plugin configuration is passed as JSON. The SDK initializes one Tokio runtime per loaded plugin library, shared by its connector instances. All plugins run in the same process."},"1818":{"id":"/docs/connectors/introduction-17","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"The connector runtime operates in two directions - source (ingest) and sink (egress):"},"1819":{"id":"/docs/connectors/introduction-18","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"Key details:"},"1820":{"id":"/docs/connectors/introduction-19","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"Transforms run inside the runtime process, not inside the plugins. They are applied after decoding for sources (before sending to Iggy) and after consuming from Iggy for sinks (before forwarding to the external system)."},"1821":{"id":"/docs/connectors/introduction-20","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"State persistence applies to source connectors and stores the optional checkpoint bytes supplied by the plugin, using a local file or an HTTP backend. The SDK provides MessagePack helpers. The runtime acknowledges a source batch after forwarding it to Iggy and saving its optional checkpoint. See state storage."},"1822":{"id":"/docs/connectors/introduction-21","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#data-flow","content":"Consumer groups track sink offsets automatically. Offsets are committed when messages are polled, before processing by the external sink completes."},"1823":{"id":"/docs/connectors/introduction-22","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"Type"},"1824":{"id":"/docs/connectors/introduction-23","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"Connectors"},"1825":{"id":"/docs/connectors/introduction-24","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"Source"},"1826":{"id":"/docs/connectors/introduction-25","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"Elasticsearch, InfluxDB, PostgreSQL, Random"},"1827":{"id":"/docs/connectors/introduction-26","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"Sink"},"1828":{"id":"/docs/connectors/introduction-27","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#available-connectors","content":"ClickHouse, Delta Lake, Apache Doris, Elasticsearch, HTTP, Apache Iceberg, InfluxDB, Meilisearch, MongoDB, PostgreSQL, Quickwit, RabbitMQ, Redshift, S3, Stdout, SurrealDB"},"1829":{"id":"/docs/connectors/introduction-28","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"The following built-in transforms are available:"},"1830":{"id":"/docs/connectors/introduction-29","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"add_fields - add new fields to the message payload."},"1831":{"id":"/docs/connectors/introduction-30","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"delete_fields - remove existing fields from the message payload."},"1832":{"id":"/docs/connectors/introduction-31","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"filter_fields - keep or drop fields based on key and value patterns."},"1833":{"id":"/docs/connectors/introduction-32","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"update_fields - update existing fields with static or computed values such as timestamp_millis or uuid_v7."},"1834":{"id":"/docs/connectors/introduction-33","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"proto_convert - convert messages between Protocol Buffers and other formats."},"1835":{"id":"/docs/connectors/introduction-34","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"flat_buffer_convert - convert messages between FlatBuffers and other formats."},"1836":{"id":"/docs/connectors/introduction-35","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"avro_convert - convert messages between Avro and other formats."},"1837":{"id":"/docs/connectors/introduction-36","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"unwrap_envelope - promote a nested field of a JSON envelope to the top-level payload."},"1838":{"id":"/docs/connectors/introduction-37","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transforms","content":"See the Transforms documentation for the configuration of each transform."},"1839":{"id":"/docs/connectors/introduction-38","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#supported-schemas","content":"Messages can be decoded and encoded using the following formats: JSON, Raw bytes, Text, Protocol Buffers, FlatBuffers, and Avro. For Avro, the schema can be provided per stream via the avro_schema_json or avro_schema_path keys in the [[streams]] section."},"1840":{"id":"/docs/connectors/introduction-39","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"High Performance: Utilizes Rust's performance characteristics to ensure fast data ingestion and egress."},"1841":{"id":"/docs/connectors/introduction-40","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Low memory footprint: Designed with memory efficiency in mind, minimizing the memory footprint of the connectors."},"1842":{"id":"/docs/connectors/introduction-41","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Modular Design: Designed with modularity in mind, allowing for easy extension and customization."},"1843":{"id":"/docs/connectors/introduction-42","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Dynamic Loading: Supports dynamic loading of plugins, allowing integration with various data sources and sinks at runtime."},"1844":{"id":"/docs/connectors/introduction-43","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Statically Typed: Ensures type safety and compile-time checks, reducing runtime errors."},"1845":{"id":"/docs/connectors/introduction-44","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Easy Customization: Provides a simple interface for implementing custom connectors, making it easy to create new plugins."},"1846":{"id":"/docs/connectors/introduction-45","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Data transformation: Supports data transformation with the help of existing functions."},"1847":{"id":"/docs/connectors/introduction-46","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Powerful configuration: Define your sinks, sources, and transformations in the configuration file or fetch them from a remote HTTP API."},"1848":{"id":"/docs/connectors/introduction-47","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#features","content":"Flexible configuration providers: Support for local file-based and HTTP-based configuration providers for centralized configuration management."},"1849":{"id":"/docs/connectors/introduction-48","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Run these commands from the root of the same Iggy source checkout used for the server and plugins. This guide targets server 0.9.0, including its edge builds."},"1850":{"id":"/docs/connectors/introduction-49","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Build the server, CLI, runtime and quick-start plugins:"},"1851":{"id":"/docs/connectors/introduction-50","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"For a debug build, omit --release and replace target/release with target/debug in both the commands and plugin paths. Make sure that the plugins specified in core/connectors/runtime/example_config/connectors/ directory under path are available. The configuration must be provided in toml format.\nThe example directory also enables connectors for ClickHouse, Delta Lake, Apache Doris, Apache Iceberg, and InfluxDB. Without their backing services (or their compiled plugins) these are reported with the Error status, but they don't block the remaining connectors. Set enabled = false in their files to skip them entirely."},"1852":{"id":"/docs/connectors/introduction-51","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Run docker compose -f examples/rust/src/sink-data-producer/docker-compose.yml up -d, which will start the Quickwit server to be used by an example sink connector. At this point, you can access the Quickwit UI at http://localhost:7280 - check this dashboard again later on, after the events index will be created."},"1853":{"id":"/docs/connectors/introduction-52","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"In the terminal that will run the connectors, set the runtime configuration path:"},"1854":{"id":"/docs/connectors/introduction-53","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Start the Iggy server in a separate terminal with credentials matching the sample connector configuration:"},"1855":{"id":"/docs/connectors/introduction-54","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"With the server running, create the example streams and topics using the CLI from this checkout. An existing server must have these credentials, or you must adjust the commands and connector configuration to match it."},"1856":{"id":"/docs/connectors/introduction-55","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Execute cargo run --example sink-data-producer --release, which sends 100 batches of messages to previously created qw stream and records topic (this will be used by the Quickwit sink connector)."},"1857":{"id":"/docs/connectors/introduction-56","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#quick-start","content":"Start the connector runtime cargo run --bin iggy-connectors --release in the terminal configured in step 3. The Quickwit sink indexes the produced records in the events index. At the same time, you should see the new messages being added to the example_stream stream and example_topic topic by the Random source connector - you can start the Iggy Web UI to browse the data. The messages will have applied the basic fields transformations."},"1858":{"id":"/docs/connectors/introduction-57","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#configuration","content":"Overriding the configuration via environment variables follows the same rules as the main Iggy server."},"1859":{"id":"/docs/connectors/introduction-58","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#configuration","content":"You can provide the following envs during the runtime startup:"},"1860":{"id":"/docs/connectors/introduction-59","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#configuration","content":"Supported scalar fields and indexed list entries can be overridden with the IGGY_CONNECTORS_ prefix, followed by section and key names joined by underscores, e.g. IGGY_CONNECTORS_IGGY_USERNAME. Header and URL-template maps are configured in TOML. Local connector settings use a per-connector prefix, described in the runtime configuration guide."},"1861":{"id":"/docs/connectors/introduction-60","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#runtime","content":"All the connectors are implemented as Rust libraries and can be used as a part of the connector runtime. The runtime is responsible for managing the lifecycle of the connectors and providing the necessary infrastructure for the connectors to run. For more information, please refer to the runtime documentation."},"1862":{"id":"/docs/connectors/introduction-61","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#sink","content":"Sinks are responsible for consuming the messages from the configured stream(s) and topic(s) and sending them further to the specified destination. For example, the Quickwit sink connector is responsible for sending the messages to the Quickwit indexer."},"1863":{"id":"/docs/connectors/introduction-62","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#sink","content":"Please refer to the Sink documentation for the details about the configuration and the sample implementation."},"1864":{"id":"/docs/connectors/introduction-63","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#sink","content":"When implementing Sink, make sure to use the sink_connector! macro to expose the FFI interface and allow the connector runtime to register the sink with the runtime.\nEach sink should have its own, custom configuration, which is passed along with the unique plugin ID via expected new() method."},"1865":{"id":"/docs/connectors/introduction-64","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#source","content":"Sources produce messages to an Iggy stream and topic. Configure one [[streams]] entry per source instance: the runtime currently retains only the last configured producer. For example, the Random source connector generates random messages that are then sent to the configured stream and topic."},"1866":{"id":"/docs/connectors/introduction-65","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#source","content":"Please refer to the Source documentation for the details about the configuration and the sample implementation."},"1867":{"id":"/docs/connectors/introduction-66","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#building-the-connectors","content":"New connector can be built simply by implementing either Sink or Source trait. Please check the sink or source documentation, as well as the existing examples under core/connectors/sinks and core/connectors/sources."},"1868":{"id":"/docs/connectors/introduction-67","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transformations","content":"Field transformations (depending on the supported payload formats) can be applied to the messages either before they are sent to the specified topic (e.g. when produced by the source connectors), or before consumed by the sink connectors. To add a new transformation, implement the Transform trait in a new module under the SDK's transforms directory, add a variant to the TransformType enum, and extend its from_config function - the runtime picks it up without any further changes. Each transform may have its own, custom configuration."},"1869":{"id":"/docs/connectors/introduction-68","page_id":"/docs/connectors/introduction","tags":[],"type":"text","url":"/docs/connectors/introduction#transformations","content":"To find out more about the transforms, please refer to the Transforms documentation. For the stream decoders and encoders, see the SDK documentation."},"1870":{"id":"/docs/connectors/observability","page_id":"/docs/connectors/observability","type":"page","content":"Observability","breadcrumbs":["Documentation","Connectors"],"tags":[],"url":"/docs/connectors/observability"},"1871":{"id":"/docs/connectors/observability-0","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability","content":"Logs, Prometheus metrics, the stats endpoint, OpenTelemetry export and per-source state files for the connector runtime."},"1872":{"id":"/docs/connectors/observability-1","page_id":"/docs/connectors/observability","type":"heading","tags":[],"url":"/docs/connectors/observability#logging","content":"Logging"},"1873":{"id":"/docs/connectors/observability-2","page_id":"/docs/connectors/observability","type":"heading","tags":[],"url":"/docs/connectors/observability#prometheus-metrics","content":"Prometheus metrics"},"1874":{"id":"/docs/connectors/observability-3","page_id":"/docs/connectors/observability","type":"heading","tags":[],"url":"/docs/connectors/observability#runtime-stats","content":"Runtime stats"},"1875":{"id":"/docs/connectors/observability-4","page_id":"/docs/connectors/observability","type":"heading","tags":[],"url":"/docs/connectors/observability#opentelemetry","content":"OpenTelemetry"},"1876":{"id":"/docs/connectors/observability-5","page_id":"/docs/connectors/observability","type":"heading","tags":[],"url":"/docs/connectors/observability#state-files","content":"State files"},"1877":{"id":"/docs/connectors/observability-6","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability","content":"The connector runtime exposes its health through logs, Prometheus metrics, a stats endpoint, OpenTelemetry export, and per-source state files."},"1878":{"id":"/docs/connectors/observability-7","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#logging","content":"The runtime logs via the tracing crate. Merge the runtime configuration snippets on this page into the minimal runtime configuration. The output format is configured in the [logging] section:"},"1879":{"id":"/docs/connectors/observability-8","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#logging","content":"Two per-connector flags, both disabled by default, add more detail. Set them at the top level of an existing connector configuration file, before any TOML section headers:"},"1880":{"id":"/docs/connectors/observability-9","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#logging","content":"verbose: logs additional per-batch details for the connector."},"1881":{"id":"/docs/connectors/observability-10","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#logging","content":"benchmark: emits per-batch timing events on the iggy_connectors::benchmark tracing target."},"1882":{"id":"/docs/connectors/observability-11","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"Metrics are served by the runtime HTTP API when the [http.metrics] section is enabled (the HTTP API itself is on by default at 127.0.0.1:8081). Metrics are disabled by default; change enabled to true to expose them:"},"1883":{"id":"/docs/connectors/observability-12","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"Runtime-level gauges:"},"1884":{"id":"/docs/connectors/observability-13","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connectors_sources_total - configured source connectors."},"1885":{"id":"/docs/connectors/observability-14","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connectors_sources_running - sources in the Running status."},"1886":{"id":"/docs/connectors/observability-15","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connectors_sinks_total - configured sink connectors."},"1887":{"id":"/docs/connectors/observability-16","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connectors_sinks_running - sinks in the Running status."},"1888":{"id":"/docs/connectors/observability-17","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"Per-connector counters, labeled with connector_key and connector_type (source or sink):"},"1889":{"id":"/docs/connectors/observability-18","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connector_messages_produced_total - messages received from a source plugin's poll."},"1890":{"id":"/docs/connectors/observability-19","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connector_messages_sent_total - messages sent to Iggy (source)."},"1891":{"id":"/docs/connectors/observability-20","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connector_messages_consumed_total - messages consumed from Iggy (sink)."},"1892":{"id":"/docs/connectors/observability-21","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connector_messages_processed_total - messages passed to the sink plugin in batches that returned success. A failed batch adds an error and no processed messages; the runtime cannot infer partial delivery inside the plugin."},"1893":{"id":"/docs/connectors/observability-22","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connector_messages_filtered_total - messages intentionally dropped by transforms returning Ok(None), excluding transform errors."},"1894":{"id":"/docs/connectors/observability-23","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"iggy_connector_errors_total - errors encountered."},"1895":{"id":"/docs/connectors/observability-24","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#prometheus-metrics","content":"Per-batch stage timings are recorded in the iggy_connector_stage_duration_seconds histogram independently of the benchmark flag, labeled with connector_key, connector_type, and stage. Both connector types record decode, prepare, and total; sinks also record ffi, while sources record iggy_send and successful checkpoint writes record state_save. Finite buckets range from 50 microseconds to 5 seconds."},"1896":{"id":"/docs/connectors/observability-25","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#runtime-stats","content":"GET /stats on the HTTP API returns a JSON snapshot of the runtime: version, process ID, CPU and memory usage (cgroup-aware in containers), uptime, the source/sink totals, and a connectors array with per-connector details - key, name, type, plugin version, enabled, message counters, error count, and the current status."},"1897":{"id":"/docs/connectors/observability-26","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#runtime-stats","content":"Memory values are in bytes. run_time is elapsed microseconds, and start_time is microseconds since the Unix epoch."},"1898":{"id":"/docs/connectors/observability-27","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#runtime-stats","content":"The JSON status values are starting, running, stopping, stopped, and error. A connector whose plugin fails to load (for example, a missing library) is reported with error without blocking the remaining connectors. Retrieve its last_error from GET /sources/{key} or GET /sinks/{key}; /stats does not include the failure message."},"1899":{"id":"/docs/connectors/observability-28","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#opentelemetry","content":"The [telemetry] section configures OTLP export of logs and traces. Set enabled = true to export to a running collector:"},"1900":{"id":"/docs/connectors/observability-29","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#opentelemetry","content":"For transport = \"http\", use complete signal URLs, for example http://localhost:4318/v1/logs for logs and http://localhost:4318/v1/traces for traces. The runtime does not append those paths."},"1901":{"id":"/docs/connectors/observability-30","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#state-files","content":"With the default file state backend, source plugins can supply checkpoints (see the SDK documentation) for the directory configured in the [state] section. An HTTP state backend is also available:"},"1902":{"id":"/docs/connectors/observability-31","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#state-files","content":"A source that supplies checkpoint bytes gets a file named source_{key}.state (e.g. local_state/source_random.state) holding the raw state bytes - by convention MessagePack produced by the SDK helpers. Sinks have no state files. Their progress lives in Iggy consumer groups."},"1903":{"id":"/docs/connectors/observability-32","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#state-files","content":"On Unix, the file backend writes and synchronizes a .tmp file, atomically renames it over the previous checkpoint, and synchronizes the parent directory. Newly created files have owner-only permissions (0600), since state may carry cursors or tokens."},"1904":{"id":"/docs/connectors/observability-33","page_id":"/docs/connectors/observability","tags":[],"type":"text","url":"/docs/connectors/observability#state-files","content":"An empty or missing state file supplies no previous checkpoint when the connector starts. Loading fails if the file cannot be read or its parent directory is unavailable at load time. Stop the runtime before deleting a checkpoint to reset that source on its next start; deleting it while the connector runs does not reset its in-memory position."},"1905":{"id":"/docs/connectors/runtime","page_id":"/docs/connectors/runtime","type":"page","content":"Runtime","breadcrumbs":["Documentation","Connectors"],"tags":[],"url":"/docs/connectors/runtime"},"1906":{"id":"/docs/connectors/runtime-0","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"How the connector runtime loads plugins, resolves its configuration, and manages connector lifecycles."},"1907":{"id":"/docs/connectors/runtime-1","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"How configuration is resolved"},"1908":{"id":"/docs/connectors/runtime-2","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"How plugins are resolved"},"1909":{"id":"/docs/connectors/runtime-3","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#minimal-configuration","content":"Minimal configuration"},"1910":{"id":"/docs/connectors/runtime-4","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#state-storage","content":"State storage"},"1911":{"id":"/docs/connectors/runtime-5","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#configuration-providers","content":"Configuration Providers"},"1912":{"id":"/docs/connectors/runtime-6","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#local-file-provider","content":"Local File Provider"},"1913":{"id":"/docs/connectors/runtime-7","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#http-configuration-provider","content":"HTTP Configuration Provider"},"1914":{"id":"/docs/connectors/runtime-8","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#configuration-options","content":"Configuration Options"},"1915":{"id":"/docs/connectors/runtime-9","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#default-url-templates","content":"Default URL Templates"},"1916":{"id":"/docs/connectors/runtime-10","page_id":"/docs/connectors/runtime","type":"heading","tags":[],"url":"/docs/connectors/runtime#http-api","content":"HTTP API"},"1917":{"id":"/docs/connectors/runtime-11","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"Runtime is responsible for managing the lifecycle of the connectors and providing the necessary infrastructure for the connectors to run."},"1918":{"id":"/docs/connectors/runtime-12","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"The runtime uses a shared Tokio runtime for its connector-management and forwarding tasks. Each loaded plugin library also has an SDK Tokio runtime shared by its instances. Additionally, it has built-in support for logging via tracing crate."},"1919":{"id":"/docs/connectors/runtime-13","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"The connector are implemented as Rust libraries, and these are loaded dynamically during the runtime initialization process."},"1920":{"id":"/docs/connectors/runtime-14","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"Internally, dlopen2 loads plugin libraries and resolves their C FFI symbols. Plugins execute inside the runtime process."},"1921":{"id":"/docs/connectors/runtime-15","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"By default, runtime will look for the configuration file, to decide which connectors to load and how to configure them."},"1922":{"id":"/docs/connectors/runtime-16","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"Set the broker credentials and connector configuration directory before starting the runtime. The embedded default has an empty connector directory and cannot start unchanged. For a complete setup, follow the quick start."},"1923":{"id":"/docs/connectors/runtime-17","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime","content":"The docker image is available, and can be fetched via docker pull apache/iggy-connect:0.5.0."},"1924":{"id":"/docs/connectors/runtime-18","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"The configuration file path defaults to core/connectors/runtime/config.toml and can be overridden by the IGGY_CONNECTORS_CONFIG_PATH environment variable."},"1925":{"id":"/docs/connectors/runtime-19","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"A default configuration is embedded in the binary and always merged as the base, so omitted settings inherit its values. A local provider still needs a nonempty connectors.config_dir."},"1926":{"id":"/docs/connectors/runtime-20","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"On startup the runtime loads environment variables from the first .env file found in the working directory or its parents, or from the file pointed to by IGGY_CONNECTORS_ENV_PATH."},"1927":{"id":"/docs/connectors/runtime-21","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-configuration-is-resolved","content":"Supported scalar fields and indexed list entries can be overridden by environment variables using the IGGY_CONNECTORS_<SECTION>_<KEY> convention (nested keys joined by underscores), e.g. IGGY_CONNECTORS_IGGY_USERNAME or IGGY_CONNECTORS_HTTP_ADDRESS."},"1928":{"id":"/docs/connectors/runtime-22","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"The path field of a connector configuration accepts both plugin.so and plugin - the OS-specific extension (.so / .dylib / .dll) is appended when missing. Absolute paths are checked at the literal location. Relative paths are searched in order:"},"1929":{"id":"/docs/connectors/runtime-23","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"Literal path (relative to the working directory)"},"1930":{"id":"/docs/connectors/runtime-24","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"Directory of the runtime binary (filename only)"},"1931":{"id":"/docs/connectors/runtime-25","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"Current working directory (filename only)"},"1932":{"id":"/docs/connectors/runtime-26","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"/usr/lib, /usr/lib64, /lib, /lib64, /usr/local/lib, /usr/local/lib64"},"1933":{"id":"/docs/connectors/runtime-27","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#how-plugins-are-resolved","content":"A connector whose plugin cannot be resolved or loaded is surfaced with the Error status via the HTTP API instead of blocking the remaining connectors."},"1934":{"id":"/docs/connectors/runtime-28","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#minimal-configuration","content":"The runtime opens two Iggy TCP clients, one for producers and one for consumers. Set credentials matching the broker and a connector configuration provider. Omitted settings use the embedded defaults, including file-based source state storage. Save this example as connectors.toml in the repository root and replace path/to/connectors with your connector configuration directory."},"1935":{"id":"/docs/connectors/runtime-29","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#minimal-configuration","content":"Start it from the repository root:"},"1936":{"id":"/docs/connectors/runtime-30","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#minimal-configuration","content":"Beyond these sections, the runtime configuration also supports [http] for the HTTP API (see below), and [telemetry], [logging], and [http.metrics] covered on the Observability page."},"1937":{"id":"/docs/connectors/runtime-31","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"Source plugins supply optional checkpoint bytes. The default file backend writes them to {state.path}/source_{key}.state using a temporary file, file synchronization and atomic rename. On Unix, it also synchronizes the parent directory. The runtime stores these bytes unchanged; the SDK provides MessagePack serialization helpers."},"1938":{"id":"/docs/connectors/runtime-32","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"To use an HTTP state server, replace the [state] section above and add:"},"1939":{"id":"/docs/connectors/runtime-33","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"The runtime appends source_{key} as a URL path segment, preserving any query string. URL query values are redacted from runtime configuration logs and transport errors. Static request headers are passed to the state server; configure this map in TOML. The other state settings support environment overrides such as IGGY_CONNECTORS_STATE_STORAGE and IGGY_CONNECTORS_STATE_HTTP_URL."},"1940":{"id":"/docs/connectors/runtime-34","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"The HTTP server must implement this checkpoint contract:"},"1941":{"id":"/docs/connectors/runtime-35","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"Load uses GET by default, or POST. Return 200 with the stored bytes and a strong ETag, or 404 when no state exists. An empty 200 body is valid state."},"1942":{"id":"/docs/connectors/runtime-36","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"Save uses PUT by default, or POST/PATCH, with Content-Type: application/octet-stream. Atomically enforce If-Match for a known ETag or If-None-Match: * for a new checkpoint. Successful 200, 201 or 204 responses must include the new strong ETag."},"1943":{"id":"/docs/connectors/runtime-37","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"Each logical save has an Idempotency-Key, reused across retries and resolution of an uncertain write. The server must replay the original outcome for that key without applying the write again."},"1944":{"id":"/docs/connectors/runtime-38","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"If-Match, If-None-Match, Idempotency-Key and Content-Type are managed by the runtime and cannot be overridden in request_headers."},"1945":{"id":"/docs/connectors/runtime-39","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"Timeouts, connection failures, 425, 429 and 5xx responses are retried. max_attempts counts retries after the first request, so the default 4 allows up to 5 requests. Integer-seconds Retry-After values are honored up to max_backoff. Other save failures, including version conflicts or missing ETags, latch the provider: further saves fail until the connector restarts. An HTTP state-load failure while an enabled source starts aborts runtime startup."},"1946":{"id":"/docs/connectors/runtime-40","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#state-storage","content":"The runtime forwards a source batch to Iggy, saves its optional checkpoint, then acknowledges the batch to the plugin. A failed send or checkpoint save produces a negative acknowledgement. Remote checkpoint durability depends on the state server. Connector lifecycle operations do not delete remote state."},"1947":{"id":"/docs/connectors/runtime-41","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-providers","content":"The runtime supports two types of configuration providers for managing connector configurations:"},"1948":{"id":"/docs/connectors/runtime-42","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#local-file-provider","content":"The default configuration provider reads connector configurations from local files. Each connector (source or sink) is configured in its own separate file within the directory specified by connectors.config_dir. An empty config_dir is a fatal startup error. A missing directory is created automatically with a warning, and no connectors are loaded from it."},"1949":{"id":"/docs/connectors/runtime-43","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#local-file-provider","content":"Additional mechanics of the local provider:"},"1950":{"id":"/docs/connectors/runtime-44","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#local-file-provider","content":"Only *.toml files directly inside the directory are loaded - hidden files (starting with .) and Cargo.toml are skipped."},"1951":{"id":"/docs/connectors/runtime-45","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#local-file-provider","content":"Multiple files sharing the same connector key form a version history (each file carries its own version). The active version of each connector is persisted in {config_dir}/.active_versions.toml and can be selected via the HTTP API for the next process startup. Without a saved selection, the highest version is used. Changing this selection does not update a running connector. The connector restart endpoint currently loads the highest local version, which can differ from the selected active version."},"1952":{"id":"/docs/connectors/runtime-46","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#local-file-provider","content":"Top-level plugin_config fields can be overridden per connector via environment variables using the IGGY_CONNECTORS_{SINK|SOURCE}_{KEY}_PLUGIN_CONFIG_<FIELD> convention, e.g. IGGY_CONNECTORS_SINK_QUICKWIT_PLUGIN_CONFIG_URL."},"1953":{"id":"/docs/connectors/runtime-47","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-configuration-provider","content":"The HTTP configuration provider allows the runtime to fetch connector configurations from a remote HTTP/REST API. The provider fetches active configurations at startup and handles configuration operations requested through the runtime API. It does not periodically poll for remote changes."},"1954":{"id":"/docs/connectors/runtime-48","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"base_url (required): Base URL of the configuration API endpoint"},"1955":{"id":"/docs/connectors/runtime-49","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"timeout (optional): HTTP request timeout (default: 10s)"},"1956":{"id":"/docs/connectors/runtime-50","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"request_headers (optional): Custom headers to include in all HTTP requests (e.g., authentication headers)"},"1957":{"id":"/docs/connectors/runtime-51","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"url_templates (optional): Custom URL templates for API endpoints. Supports variable substitution with {key} and {version} placeholders."},"1958":{"id":"/docs/connectors/runtime-52","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"response.data_path (optional): Dot-separated object keys or numeric array indexes used to extract data (e.g., data.config or data.0)."},"1959":{"id":"/docs/connectors/runtime-53","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#configuration-options","content":"response.error_path (optional): A path with the same syntax. Any non-null value at this path is treated as an error, including false or an empty string."},"1960":{"id":"/docs/connectors/runtime-54","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"If not customized, the HTTP provider uses the following RESTful URL patterns:"},"1961":{"id":"/docs/connectors/runtime-55","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Create sink config: POST {base_url}/sinks/{key}/configs"},"1962":{"id":"/docs/connectors/runtime-56","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Create source config: POST {base_url}/sources/{key}/configs"},"1963":{"id":"/docs/connectors/runtime-57","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get active configs: GET {base_url}/configs/active"},"1964":{"id":"/docs/connectors/runtime-58","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get active versions: GET {base_url}/configs/active/versions"},"1965":{"id":"/docs/connectors/runtime-59","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Set active sink version: PUT {base_url}/sinks/{key}/configs/active"},"1966":{"id":"/docs/connectors/runtime-60","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Set active source version: PUT {base_url}/sources/{key}/configs/active"},"1967":{"id":"/docs/connectors/runtime-61","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get sink configs: GET {base_url}/sinks/{key}/configs"},"1968":{"id":"/docs/connectors/runtime-62","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get sink config by version: GET {base_url}/sinks/{key}/configs/{version}"},"1969":{"id":"/docs/connectors/runtime-63","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get active sink config: GET {base_url}/sinks/{key}/configs/active"},"1970":{"id":"/docs/connectors/runtime-64","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get source configs: GET {base_url}/sources/{key}/configs"},"1971":{"id":"/docs/connectors/runtime-65","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get source config by version: GET {base_url}/sources/{key}/configs/{version}"},"1972":{"id":"/docs/connectors/runtime-66","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Get active source config: GET {base_url}/sources/{key}/configs/active"},"1973":{"id":"/docs/connectors/runtime-67","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Delete sink config: DELETE {base_url}/sinks/{key}/configs"},"1974":{"id":"/docs/connectors/runtime-68","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"Delete source config: DELETE {base_url}/sources/{key}/configs"},"1975":{"id":"/docs/connectors/runtime-69","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"The HTTP provider expects the remote API to implement these endpoints and return connector configuration data in the same format as used by the local provider."},"1976":{"id":"/docs/connectors/runtime-70","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"Connector runtime has an HTTP API which is enabled by default at 127.0.0.1:8081. It can be disabled by setting the enabled flag to false in the [http] section."},"1977":{"id":"/docs/connectors/runtime-71","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"When api_key is set, every request must carry it in the api-key header - except GET / and GET /health, which stay public. An empty key disables authentication. Configuration endpoints return plugin credentials and accept configuration changes, so set an API key before exposing this API to other hosts. Enable TLS or use a trusted TLS proxy for remote access."},"1978":{"id":"/docs/connectors/runtime-72","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"Currently, it does expose the following endpoints:"},"1979":{"id":"/docs/connectors/runtime-73","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /: welcome message."},"1980":{"id":"/docs/connectors/runtime-74","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /health: process liveness response. It does not check connector health; inspect /stats, /sources or /sinks for connector status."},"1981":{"id":"/docs/connectors/runtime-75","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /stats: runtime statistics (process info plus per-connector status and message counters)."},"1982":{"id":"/docs/connectors/runtime-76","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /metrics: Prometheus metrics, available when [http.metrics] is enabled (path configurable via its endpoint key)."},"1983":{"id":"/docs/connectors/runtime-77","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sinks: list of sinks."},"1984":{"id":"/docs/connectors/runtime-78","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sinks/{key}: sink details."},"1985":{"id":"/docs/connectors/runtime-79","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sinks/{key}/configs: list of configuration versions for the sink."},"1986":{"id":"/docs/connectors/runtime-80","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"POST /sinks/{key}/configs: add a new configuration version for the sink."},"1987":{"id":"/docs/connectors/runtime-81","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"DELETE /sinks/{key}/configs: delete one configuration version, chosen by the version query parameter or the locally saved active selection."},"1988":{"id":"/docs/connectors/runtime-82","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sinks/{key}/configs/{version}: configuration details for a specific version."},"1989":{"id":"/docs/connectors/runtime-83","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sinks/{key}/configs/active: active configuration details."},"1990":{"id":"/docs/connectors/runtime-84","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"PUT /sinks/{key}/configs/active: activate a specific configuration version for the sink."},"1991":{"id":"/docs/connectors/runtime-85","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sinks/{key}/configs/plugin: sink plugin config, including the optional format query parameter to specify the config format."},"1992":{"id":"/docs/connectors/runtime-86","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sinks/{key}/transforms: sink transforms to be applied to the fields."},"1993":{"id":"/docs/connectors/runtime-87","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"POST /sinks/{key}/restart: restart the sink connector."},"1994":{"id":"/docs/connectors/runtime-88","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sources: list of sources."},"1995":{"id":"/docs/connectors/runtime-89","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sources/{key}: source details."},"1996":{"id":"/docs/connectors/runtime-90","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sources/{key}/configs: list of configuration versions for the source."},"1997":{"id":"/docs/connectors/runtime-91","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"POST /sources/{key}/configs: add a new configuration version for the source."},"1998":{"id":"/docs/connectors/runtime-92","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"DELETE /sources/{key}/configs: delete one configuration version, chosen by the version query parameter or the locally saved active selection."},"1999":{"id":"/docs/connectors/runtime-93","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sources/{key}/configs/{version}: configuration details for a specific version."},"2000":{"id":"/docs/connectors/runtime-94","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sources/{key}/configs/active: active configuration details."},"2001":{"id":"/docs/connectors/runtime-95","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"PUT /sources/{key}/configs/active: activate a specific configuration version for the source."},"2002":{"id":"/docs/connectors/runtime-96","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sources/{key}/configs/plugin: source plugin config, including the optional format query parameter to specify the config format."},"2003":{"id":"/docs/connectors/runtime-97","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sources/{key}/transforms: source transforms to be applied to the fields."},"2004":{"id":"/docs/connectors/runtime-98","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"POST /sources/{key}/restart: restart the source connector."},"2005":{"id":"/docs/connectors/sdk","page_id":"/docs/connectors/sdk","type":"page","content":"SDK","breadcrumbs":["Documentation","Connectors"],"tags":[],"url":"/docs/connectors/sdk"},"2006":{"id":"/docs/connectors/sdk-0","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk","content":"The Sink and Source traits, the connector macros, and the decoders and encoders used to read and write Iggy streams."},"2007":{"id":"/docs/connectors/sdk-1","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#traits","content":"Traits"},"2008":{"id":"/docs/connectors/sdk-2","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#state","content":"State"},"2009":{"id":"/docs/connectors/sdk-3","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#retry-utilities","content":"Retry utilities"},"2010":{"id":"/docs/connectors/sdk-4","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#transforms","content":"Transforms"},"2011":{"id":"/docs/connectors/sdk-5","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#protocol-buffers-support","content":"Protocol Buffers Support"},"2012":{"id":"/docs/connectors/sdk-6","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#configuration-example","content":"Configuration Example"},"2013":{"id":"/docs/connectors/sdk-7","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#key-configuration-options","content":"Key Configuration Options"},"2014":{"id":"/docs/connectors/sdk-8","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#programmatic-encoder-and-decoder-configuration","content":"Programmatic Encoder and Decoder Configuration"},"2015":{"id":"/docs/connectors/sdk-9","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#transform-options","content":"Transform Options"},"2016":{"id":"/docs/connectors/sdk-10","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#supported-features","content":"Supported Features"},"2017":{"id":"/docs/connectors/sdk-11","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#programmatic-usage","content":"Programmatic Usage"},"2018":{"id":"/docs/connectors/sdk-12","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#dynamic-schema-loading","content":"Dynamic Schema Loading"},"2019":{"id":"/docs/connectors/sdk-13","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#creating-converters-with-schema","content":"Creating Converters with Schema"},"2020":{"id":"/docs/connectors/sdk-14","page_id":"/docs/connectors/sdk","type":"heading","tags":[],"url":"/docs/connectors/sdk#usage-notes","content":"Usage Notes"},"2021":{"id":"/docs/connectors/sdk-15","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk","content":"SDK provides the commonly used structs and traits such as Sink and Source, along with the sink_connector and source_connector macros to be used when developing connectors."},"2022":{"id":"/docs/connectors/sdk-16","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk","content":"Moreover, it contains both, the decoders and encoders modules, implementing either StreamDecoder or StreamEncoder traits, which are used when consuming or producing data from/to Iggy streams. All the supported schemas - JSON, Raw bytes, Text, Protocol Buffers, FlatBuffers, and Avro - have both a decoder and an encoder."},"2023":{"id":"/docs/connectors/sdk-17","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#traits","content":"A source produces messages to the configured stream and topic. A sink consumes messages from the configured stream(s) and topic(s):"},"2024":{"id":"/docs/connectors/sdk-18","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#traits","content":"Expose the implementation with sink_connector!(MySink) or source_connector!(MySource). The sink constructor has the signature new(id: u32, config: MySinkConfig) -> Self; the source constructor also takes state: Option<ConnectorState>. The sink guide and source guide provide complete plugin implementations and build setup."},"2025":{"id":"/docs/connectors/sdk-19","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#traits","content":"The macros generate the C FFI symbols loaded by the runtime: iggy_sink_open, iggy_sink_consume, iggy_sink_close, and iggy_sink_version for sinks, and iggy_source_open, iggy_source_handle_v2, iggy_source_batch_result, iggy_source_close, and iggy_source_version for sources. Configurations cross FFI as JSON, message batches and metadata use postcard, and source checkpoint bytes are opaque. The SDK creates one Tokio runtime per loaded plugin library, shared by that library's connector instances."},"2026":{"id":"/docs/connectors/sdk-20","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#state","content":"Source connectors can persist their position between restarts. Each batch of ProducedMessages may carry an optional ConnectorState. After processing and sending the batch to Iggy, the runtime saves that state through the configured file or HTTP backend before acknowledging the batch. The last saved state is passed to new() on the next startup. ConnectorState wraps raw bytes and provides serialize/deserialize helpers backed by MessagePack."},"2027":{"id":"/docs/connectors/sdk-21","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#state","content":"Sources with cursors or destructive operations must stage changes during poll() and apply them on SourceBatchResult::Ack; Nack discards staged progress so the batch can be polled again. The SDK allows one batch in flight and stops polling if on_batch_result() returns an error. Its default no-op is suitable only for sources without staged work."},"2028":{"id":"/docs/connectors/sdk-22","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#state","content":"Sinks can keep in-memory state, but the runtime does not persist it. Their consumer-group offsets are tracked by Iggy. See the Observability page for checkpoint storage and the sink guide for offset handling."},"2029":{"id":"/docs/connectors/sdk-23","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#retry-utilities","content":"The retry module ships helpers for connectors talking to flaky external systems: a CircuitBreaker, an HttpRetryMiddleware for reqwest-based clients, and a build_retry_client factory that wraps a reqwest client with the retry middleware (the circuit breaker is wired separately)."},"2030":{"id":"/docs/connectors/sdk-24","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#transforms","content":"Last but not least, the different transforms are available, to transform (add, update, delete etc.) the particular fields of the data being processed via external configuration. It's as simple as adding a new transform to the transforms section of the particular connector configuration file:"},"2031":{"id":"/docs/connectors/sdk-25","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#transforms","content":"All the available transforms and their configuration options are documented on the Transforms page."},"2032":{"id":"/docs/connectors/sdk-26","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#protocol-buffers-support","content":"The SDK includes support for Protocol Buffers (protobuf) format with both encoding and decoding capabilities. Protocol Buffers provide efficient serialization and are particularly useful for high-performance data streaming scenarios."},"2033":{"id":"/docs/connectors/sdk-27","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#configuration-example","content":"This example uses the Random source and Stdout sink from the matching checkout. Start a server using the getting-started guide, then build the plugins, runtime, and CLI from the repository root:"},"2034":{"id":"/docs/connectors/sdk-28","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#configuration-example","content":"The source's schema = \"proto\" selects the default protobuf encoder, which wraps each JSON record in a google.protobuf.StringValue inside google.protobuf.Any. The sink reads raw bytes and applies proto_convert to expose the Any envelope as JSON. This does not unpack a custom protobuf message schema."},"2035":{"id":"/docs/connectors/sdk-29","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#configuration-example","content":"Main runtime config (connectors.toml):"},"2036":{"id":"/docs/connectors/sdk-30","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#configuration-example","content":"Source connector config (connectors/protobuf_source.toml):"},"2037":{"id":"/docs/connectors/sdk-31","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#configuration-example","content":"Sink connector config (connectors/protobuf_sink.toml):"},"2038":{"id":"/docs/connectors/sdk-32","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#configuration-example","content":"Create the stream and topic, then start the runtime from the repository root:"},"2039":{"id":"/docs/connectors/sdk-33","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#configuration-example","content":"The source sends 100 records, then continues polling without new messages. Stdout logs message offsets and the serialized JSON envelope bytes, containing type_url and base64 value. The sink's raw schema also determines how the plugin receives those transformed bytes."},"2040":{"id":"/docs/connectors/sdk-34","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#configuration-example","content":"The format-conversion transforms define no per-key defaults. Every non-optional key shown above must be present, or the configuration fails to deserialize (schema_path, message_type, field_mappings, and descriptor_set are optional)."},"2041":{"id":"/docs/connectors/sdk-35","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#configuration-example","content":"The two [[streams]] shapes differ: a source produces to a single topic and can tune batching via batch_length and linger_time, while a sink consumes from a list of topics and can additionally set batch_length, poll_interval, and consumer_group."},"2042":{"id":"/docs/connectors/sdk-36","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#programmatic-encoder-and-decoder-configuration","content":"These are SDK configuration fields, not Random or Stdout plugin_config keys. The runtime's schema = \"proto\" uses the default encoder or decoder."},"2043":{"id":"/docs/connectors/sdk-37","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#programmatic-encoder-and-decoder-configuration","content":"schema_path: Path to the .proto file containing message definitions"},"2044":{"id":"/docs/connectors/sdk-38","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#programmatic-encoder-and-decoder-configuration","content":"message_type: Fully qualified name of the protobuf message type to use"},"2045":{"id":"/docs/connectors/sdk-39","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#programmatic-encoder-and-decoder-configuration","content":"use_any_wrapper: Selects the Any fallback when no message descriptor is loaded; a loaded descriptor takes precedence"},"2046":{"id":"/docs/connectors/sdk-40","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#transform-options","content":"proto_convert: Transform for converting between protobuf and other formats"},"2047":{"id":"/docs/connectors/sdk-41","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#transform-options","content":"source_format / target_format: Formats to convert between - any schema value (json, raw, text, proto, flat_buffer, avro)"},"2048":{"id":"/docs/connectors/sdk-42","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#transform-options","content":"preserve_unknown_fields: Accepted by proto_convert, but currently has no effect"},"2049":{"id":"/docs/connectors/sdk-43","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#transform-options","content":"include_paths: Additional directories searched for imported .proto files"},"2050":{"id":"/docs/connectors/sdk-44","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#transform-options","content":"field_mappings: Renames fields in a JSON input object before conversion (e.g., \"old_field\" = \"new_field\")"},"2051":{"id":"/docs/connectors/sdk-45","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#transform-options","content":"conversion_options: pretty_json controls JSON text output and include_metadata enriches supported protobuf-to-JSON paths. validate_messages, type_url_prefix, and strict_mode are accepted but currently have no effect"},"2052":{"id":"/docs/connectors/sdk-46","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#transform-options","content":"The schema_registry_url field is reserved and currently not implemented. The SDK never contacts a schema registry, and schemas are loaded only from schema_path or descriptor_set."},"2053":{"id":"/docs/connectors/sdk-47","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#supported-features","content":"Encoding: A loaded message descriptor encodes matching JSON fields. The encoder supports booleans, strings, all protobuf integer types, and base64 strings for bytes or already-encoded nested messages. Float, double, and enum fields are unsupported by the encoder; nested JSON objects, repeated fields, maps, and proto2 groups are not a general-purpose schema conversion path."},"2054":{"id":"/docs/connectors/sdk-48","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#supported-features","content":"Decoding: A loaded descriptor extracts present fields. Integer, boolean, and string fields become JSON values; bytes become base64 and nested messages become metadata with base64 content. Missing fields are not filled with protobuf defaults, and float/double fields produce unsupported_wire_type placeholders. Without a descriptor, the default decoder returns an Any envelope's type_url and base64 value."},"2055":{"id":"/docs/connectors/sdk-49","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#supported-features","content":"Transforms: proto_convert supports JSON-to-protobuf schema encoding for scalar fields, including floating-point numbers and numeric enum values; bytes and already-encoded nested messages use base64 strings. It logs and omits fields it cannot encode. Its protobuf-to-JSON path exposes Any metadata or raw-data metadata rather than decoding a custom message descriptor. Converting protobuf to flat_buffer or avro rewraps bytes without transcoding them."},"2056":{"id":"/docs/connectors/sdk-50","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#supported-features","content":"Field Mapping: Encoder/decoder mappings use protobuf field names as keys and JSON field names as values. The encoder applies that mapping in reverse. Transform mappings rename JSON input keys directly."},"2057":{"id":"/docs/connectors/sdk-51","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#supported-features","content":"Any Wrapper: The default encoder puts JSON/text in a google.protobuf.StringValue, or binary data in a google.protobuf.BytesValue, inside google.protobuf.Any. The default decoder exposes the envelope without unpacking its inner message."},"2058":{"id":"/docs/connectors/sdk-52","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#programmatic-usage","content":"From the matching repository root, create an example crate and schema directory:"},"2059":{"id":"/docs/connectors/sdk-53","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#programmatic-usage","content":"Save this as connector-sdk-example/Cargo.toml. The path dependency uses the SDK from the same checkout as the runtime:"},"2060":{"id":"/docs/connectors/sdk-54","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#programmatic-usage","content":"Save this as schemas/user.proto:"},"2061":{"id":"/docs/connectors/sdk-55","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#programmatic-usage","content":"Each Rust example below is a complete connector-sdk-example/src/main.rs. Run it from the repository root so the relative schema path resolves:"},"2062":{"id":"/docs/connectors/sdk-56","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#dynamic-schema-loading","content":"You can load or reload schemas programmatically:"},"2063":{"id":"/docs/connectors/sdk-57","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#dynamic-schema-loading","content":"The encoder follows the same pattern:"},"2064":{"id":"/docs/connectors/sdk-58","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#creating-converters-with-schema","content":"The loaded schema is used for JSON-to-protobuf conversion. This example maps user_id and full_name to the schema's field names:"},"2065":{"id":"/docs/connectors/sdk-59","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#usage-notes","content":"Automatic Loading: Constructors attempt to load schema_path or descriptor_set; schema_path takes precedence when both are set. Constructors log loading errors and return an instance without a loaded schema."},"2066":{"id":"/docs/connectors/sdk-60","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#usage-notes","content":"Manual Loading: load_schema() reloads the configured source. A returned error preserves an already-loaded schema. update_config(config, true) also restores the previous configuration on error; false changes the configuration while retaining the cached schema."},"2067":{"id":"/docs/connectors/sdk-61","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#usage-notes","content":"Fallbacks: Missing files, compilation failures, absent schema sources, or an unmatched message_type can return Ok(()) without an active message descriptor. Successful reloads into fallback mode clear the previous descriptor. Invalid protobuf syntax and malformed descriptor bytes return errors. Check the actual encoded/decoded result when validating a schema setup."},"2068":{"id":"/docs/connectors/sdk-62","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#usage-notes","content":"Encoding Errors: Errors encoding a loaded message descriptor are returned to the caller. The encoder does not retry that message as Any. The decoder attempts Any after a schema decoding error."},"2069":{"id":"/docs/connectors/sdk-63","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#usage-notes","content":"Transform Configuration: Create a new converter to change its configuration. load_schema() can reload its existing source. Without a descriptor, JSON-to-protobuf conversion produces JSON text in Payload::Proto, not a schema-encoded binary message."},"2070":{"id":"/docs/connectors/sdk-64","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#usage-notes","content":"Format Options: Encoder preserve_unknown_fields, compact_encoding, validate_message, and deterministic_encoding are accepted but have no effect. Decoder preserve_unknown_fields retains unknown varints as numbers and length-delimited data as base64; fixed-width unknown fields become placeholders. It does not retain the original wire encoding. See the Transforms page for conversion-specific limits."},"2071":{"id":"/docs/connectors/sdk-65","page_id":"/docs/connectors/sdk","tags":[],"type":"text","url":"/docs/connectors/sdk#usage-notes","content":"Protocol Buffers provide efficient binary serialization compared to JSON"},"2072":{"id":"/docs/connectors/transforms","page_id":"/docs/connectors/transforms","type":"page","content":"Transforms","breadcrumbs":["Documentation","Connectors"],"tags":[],"url":"/docs/connectors/transforms"},"2073":{"id":"/docs/connectors/transforms-0","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms","content":"Mutate, filter and convert messages as they pass through the connector runtime, and how each transform is configured."},"2074":{"id":"/docs/connectors/transforms-1","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#configuration","content":"Configuration"},"2075":{"id":"/docs/connectors/transforms-2","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#add_fields","content":"add_fields"},"2076":{"id":"/docs/connectors/transforms-3","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#delete_fields","content":"delete_fields"},"2077":{"id":"/docs/connectors/transforms-4","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#update_fields","content":"update_fields"},"2078":{"id":"/docs/connectors/transforms-5","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#filter_fields","content":"filter_fields"},"2079":{"id":"/docs/connectors/transforms-6","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#unwrap_envelope","content":"unwrap_envelope"},"2080":{"id":"/docs/connectors/transforms-7","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#proto_convert","content":"proto_convert"},"2081":{"id":"/docs/connectors/transforms-8","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#flat_buffer_convert","content":"flat_buffer_convert"},"2082":{"id":"/docs/connectors/transforms-9","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#avro_convert","content":"avro_convert"},"2083":{"id":"/docs/connectors/transforms-10","page_id":"/docs/connectors/transforms","type":"heading","tags":[],"url":"/docs/connectors/transforms#adding-a-new-transform","content":"Adding a new transform"},"2084":{"id":"/docs/connectors/transforms-11","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms","content":"Transforms mutate, filter, or convert messages as they flow through the connector runtime. They run inside the runtime process, not inside the plugins. For source connectors they're applied after the plugin's messages are decoded and before producing to Iggy. For sink connectors, after consuming from Iggy and before handing the messages to the plugin."},"2085":{"id":"/docs/connectors/transforms-12","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms","content":"A transform receives each decoded message and returns either the (possibly modified) message, or nothing - in which case the message is dropped from the batch. A transform can also return an error. A source rejects the whole batch and its checkpoint on a transform error; a sink drops the affected message and continues processing the batch."},"2086":{"id":"/docs/connectors/transforms-13","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#configuration","content":"Transforms are configured per connector in the transforms section of the connector configuration file. Each transform type is a table keyed by its name, so a connector can have at most one instance of each type:"},"2087":{"id":"/docs/connectors/transforms-14","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#configuration","content":"Two rules apply to every transform:"},"2088":{"id":"/docs/connectors/transforms-15","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#configuration","content":"The enabled key is required. A transform section without it fails to load, and a transform with enabled = false is skipped."},"2089":{"id":"/docs/connectors/transforms-16","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#configuration","content":"The order of the sections in the file doesn't determine the execution order, so don't rely on one transform seeing the output of another."},"2090":{"id":"/docs/connectors/transforms-17","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#configuration","content":"The field-level transforms (add_fields, delete_fields, filter_fields, update_fields, unwrap_envelope) operate on JSON objects only. Other JSON values and other payload formats pass through them unchanged."},"2091":{"id":"/docs/connectors/transforms-18","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"Adds top-level fields to the message payload, replacing any existing value with the same key. Each field has a key and a value, which is either static or computed at runtime:"},"2092":{"id":"/docs/connectors/transforms-19","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"The available computed values are:"},"2093":{"id":"/docs/connectors/transforms-20","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"Value"},"2094":{"id":"/docs/connectors/transforms-21","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"Result"},"2095":{"id":"/docs/connectors/transforms-22","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"date_time"},"2096":{"id":"/docs/connectors/transforms-23","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"Current date and time as an RFC 3339 string"},"2097":{"id":"/docs/connectors/transforms-24","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"timestamp_nanos"},"2098":{"id":"/docs/connectors/transforms-25","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"Current Unix timestamp in nanoseconds"},"2099":{"id":"/docs/connectors/transforms-26","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"timestamp_micros"},"2100":{"id":"/docs/connectors/transforms-27","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"Current Unix timestamp in microseconds"},"2101":{"id":"/docs/connectors/transforms-28","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"timestamp_millis"},"2102":{"id":"/docs/connectors/transforms-29","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"Current Unix timestamp in milliseconds"},"2103":{"id":"/docs/connectors/transforms-30","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"timestamp_seconds"},"2104":{"id":"/docs/connectors/transforms-31","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"Current Unix timestamp in seconds"},"2105":{"id":"/docs/connectors/transforms-32","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"uuid_v4"},"2106":{"id":"/docs/connectors/transforms-33","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"Random UUID (version 4)"},"2107":{"id":"/docs/connectors/transforms-34","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"uuid_v7"},"2108":{"id":"/docs/connectors/transforms-35","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#add_fields","content":"Time-ordered UUID (version 7)"},"2109":{"id":"/docs/connectors/transforms-36","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#delete_fields","content":"Removes the listed top-level fields from the message payload:"},"2110":{"id":"/docs/connectors/transforms-37","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#update_fields","content":"Sets fields to static or computed values, optionally guarded by a condition:"},"2111":{"id":"/docs/connectors/transforms-38","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#update_fields","content":"The condition values are always (the default when omitted - sets the field whether or not it exists), key_exists (update only when the field is already present), and key_not_exists (add only when the field is absent)."},"2112":{"id":"/docs/connectors/transforms-39","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#filter_fields","content":"Keeps or drops fields of the payload based on key and value patterns:"},"2113":{"id":"/docs/connectors/transforms-40","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#filter_fields","content":"keep_fields: fields that are always kept, regardless of the patterns."},"2114":{"id":"/docs/connectors/transforms-41","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#filter_fields","content":"patterns: a list of patterns. A field matches when any pattern matches. Within one pattern, key_pattern and value_pattern must both match when both are set (an omitted one matches everything)."},"2115":{"id":"/docs/connectors/transforms-42","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#filter_fields","content":"include_matching: true (default) keeps the matching fields and drops the rest. false drops the matching fields and keeps the rest."},"2116":{"id":"/docs/connectors/transforms-43","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#filter_fields","content":"An empty keep_fields list together with an empty patterns list leaves the payload unchanged. Invalid regular expressions fail configuration loading. Numeric between comparisons include both endpoints."},"2117":{"id":"/docs/connectors/transforms-44","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#filter_fields","content":"key_pattern variants: exact, starts_with, ends_with, contains, regex - each takes a string, e.g. key_pattern = { contains = \"name\" }."},"2118":{"id":"/docs/connectors/transforms-45","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#filter_fields","content":"value_pattern variants: equals (any JSON value), contains (substring), regex, greater_than, less_than, between (e.g. { between = [1.0, 10.0] }), and the parameterless checks is_null, is_not_null, is_string, is_number, is_boolean, is_object, is_array (written as plain strings, e.g. value_pattern = \"is_number\")."},"2119":{"id":"/docs/connectors/transforms-46","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#unwrap_envelope","content":"Promotes a nested field of a JSON envelope to the top-level payload. Given { \"table\": \"...\", \"operation\": \"...\", \"data\": { ... } }, setting field = \"data\" replaces the whole payload with the contents of data:"},"2120":{"id":"/docs/connectors/transforms-47","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#unwrap_envelope","content":"field must not be empty. Messages that aren't JSON objects, or that don't contain the field, pass through unchanged."},"2121":{"id":"/docs/connectors/transforms-48","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#proto_convert","content":"Converts messages between Protocol Buffers and other formats. This example exposes the type_url and base64 value of an Any envelope received as raw bytes. See the SDK documentation for a complete runtime configuration and the schema loading details:"},"2122":{"id":"/docs/connectors/transforms-49","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#proto_convert","content":"Optional keys: schema_path, message_type, field_mappings (rename JSON input fields, e.g. field_mappings = { \"old\" = \"new\" }), descriptor_set (pre-compiled descriptor bytes instead of a .proto file), and the inactive schema_registry_url."},"2123":{"id":"/docs/connectors/transforms-50","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#proto_convert","content":"A loaded descriptor is used for JSON-to-protobuf encoding. Without one, that direction produces JSON text in Payload::Proto. Protobuf-to-JSON conversion does not decode a custom message descriptor: it parses text as JSON, exposes an Any envelope, or returns metadata containing base64 raw data. Protobuf-to-Avro/FlatBuffers conversion only rewraps the bytes."},"2124":{"id":"/docs/connectors/transforms-51","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#proto_convert","content":"preserve_unknown_fields, validate_messages, type_url_prefix, and strict_mode are accepted but have no effect. pretty_json affects JSON text output, and include_metadata adds fields on the supported protobuf-to-JSON paths."},"2125":{"id":"/docs/connectors/transforms-52","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#flat_buffer_convert","content":"Converts JSON to the SDK's generic FlatBuffer representation, or exposes FlatBuffer bytes as metadata, base64 text, or raw bytes. It does not interpret an external .fbs schema. This example can be added to a JSON-producing source with streams.schema = \"flat_buffer\":"},"2126":{"id":"/docs/connectors/transforms-53","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#flat_buffer_convert","content":"Optional keys: schema_path, root_table_name, field_mappings. JSON encoding uses a generic key/value representation, so its output is not a buffer for an arbitrary generated table type. FlatBuffer-to-JSON returns buffer metadata and base64 bytes, not decoded table fields."},"2127":{"id":"/docs/connectors/transforms-54","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#flat_buffer_convert","content":"schema_path, include_paths, and preserve_unknown_fields have no effect. root_table_name only labels decoding metadata. verify_buffers checks the minimum buffer length (four bytes), not a schema-aware verifier; buffer_size_hint sets the initial encoder capacity. pretty_json, include_metadata, and strict_mode have no effect."},"2128":{"id":"/docs/connectors/transforms-55","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#flat_buffer_convert","content":"The input payload variant must match source_format. The default flat_buffer stream decoder already returns JSON metadata, so it does not supply Payload::FlatBuffer to a following reverse transform."},"2129":{"id":"/docs/connectors/transforms-56","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#avro_convert","content":"Converts JSON to a raw Avro datum and Avro data to JSON. The schema can be given inline (schema_json) or as a file (schema_path); the inline schema takes precedence. This example can be added to the Random source with streams.schema = \"avro\":"},"2130":{"id":"/docs/connectors/transforms-57","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#avro_convert","content":"Optional keys: schema_path, schema_json, field_mappings. JSON encoding and Avro-to-JSON decoding require a schema; input values must match its field types. The wire payload is one raw Avro datum, not an Avro object container file. Decoding rejects trailing bytes."},"2131":{"id":"/docs/connectors/transforms-58","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#avro_convert","content":"field_mappings renames input JSON fields or fields decoded from Avro. Text input is not field-mapped. Text-to-Avro parses JSON before encoding; Raw-to-Avro rewraps existing bytes without validating them. Avro-to-Text emits base64 and Avro-to-Raw preserves the bytes. All three conversion_options keys are accepted but have no effect. Unsupported conversion pairs pass their input through unchanged."},"2132":{"id":"/docs/connectors/transforms-59","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#avro_convert","content":"To consume raw Avro records in a sink, configure schema = \"avro\" and avro_schema_json or avro_schema_path in its [[streams]] entry. The runtime decodes the datum into JSON before running transforms. A following avro_convert with source_format = \"avro\" would therefore receive the wrong payload variant."},"2133":{"id":"/docs/connectors/transforms-60","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#avro_convert","content":"Unlike the field-level transforms, the three format-conversion transforms define no per-key defaults: every key shown in their examples (except the ones listed as optional) must be present, or the connector configuration fails to load. The source_format and target_format keys accept any schema value: json, raw, text, proto, flat_buffer, avro. The FlatBuffers transform additionally restricts the pair: only JSON to/from FlatBuffers, FlatBuffers to Text or Raw, and identity conversions are accepted. Any other combination fails the configuration load."},"2134":{"id":"/docs/connectors/transforms-61","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#adding-a-new-transform","content":"The extension point is the SDK (core/connectors/sdk/src/transforms/):"},"2135":{"id":"/docs/connectors/transforms-62","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#adding-a-new-transform","content":"Add a new module implementing the Transform trait."},"2136":{"id":"/docs/connectors/transforms-63","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#adding-a-new-transform","content":"Add a variant to the TransformType enum."},"2137":{"id":"/docs/connectors/transforms-64","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#adding-a-new-transform","content":"Add a match arm to the from_config function deserializing your config."},"2138":{"id":"/docs/connectors/transforms-65","page_id":"/docs/connectors/transforms","tags":[],"type":"text","url":"/docs/connectors/transforms#adding-a-new-transform","content":"The runtime loads transforms generically by TransformType, so no runtime changes are needed."},"2139":{"id":"/docs/introduction/about","page_id":"/docs/introduction/about","type":"page","content":"About","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/about"},"2140":{"id":"/docs/introduction/about-0","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about","content":"What Apache Iggy is: a persistent message streaming platform written in Rust, with QUIC, TCP, WebSocket and HTTP transports."},"2141":{"id":"/docs/introduction/about-1","page_id":"/docs/introduction/about","type":"heading","tags":[],"url":"/docs/introduction/about#features","content":"Features"},"2142":{"id":"/docs/introduction/about-2","page_id":"/docs/introduction/about","type":"heading","tags":[],"url":"/docs/introduction/about#supported-languages-sdk","content":"Supported languages SDK"},"2143":{"id":"/docs/introduction/about-3","page_id":"/docs/introduction/about","type":"heading","tags":[],"url":"/docs/introduction/about#cli","content":"CLI"},"2144":{"id":"/docs/introduction/about-4","page_id":"/docs/introduction/about","type":"heading","tags":[],"url":"/docs/introduction/about#web-ui","content":"Web UI"},"2145":{"id":"/docs/introduction/about-5","page_id":"/docs/introduction/about","type":"heading","tags":[],"url":"/docs/introduction/about#connectors","content":"Connectors"},"2146":{"id":"/docs/introduction/about-6","page_id":"/docs/introduction/about","type":"heading","tags":[],"url":"/docs/introduction/about#model-context-protocol","content":"Model Context Protocol"},"2147":{"id":"/docs/introduction/about-7","page_id":"/docs/introduction/about","type":"heading","tags":[],"url":"/docs/introduction/about#docker","content":"Docker"},"2148":{"id":"/docs/introduction/about-8","page_id":"/docs/introduction/about","type":"heading","tags":[],"url":"/docs/introduction/about#helm-charts","content":"Helm Charts"},"2149":{"id":"/docs/introduction/about-9","page_id":"/docs/introduction/about","type":"heading","tags":[],"url":"/docs/introduction/about#versioning","content":"Versioning"},"2150":{"id":"/docs/introduction/about-10","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about","content":"Iggy is a persistent message streaming platform written in Rust, supporting QUIC, TCP, WebSocket (custom binary specification) and HTTP (regular REST API) transport protocols, capable of processing millions of messages per second at ultra-low latency."},"2151":{"id":"/docs/introduction/about-11","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about","content":"Iggy provides exceptionally high throughput and performance while utilizing minimal computing resources."},"2152":{"id":"/docs/introduction/about-12","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about","content":"This is not yet another extension running on top of existing infrastructure, such as Kafka or SQL database."},"2153":{"id":"/docs/introduction/about-13","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about","content":"Iggy is a persistent message streaming log built from the ground up using low-level I/O with thread-per-core shared nothing architecture, io_uring and compio for maximum speed and efficiency."},"2154":{"id":"/docs/introduction/about-14","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about","content":"The name is an abbreviation for the Italian Greyhound - small yet extremely fast dogs, the best in their class. See the lovely Fabio & Cookie ❤️"},"2155":{"id":"/docs/introduction/about-15","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about","content":"Historical startup screenshot from server 0.5.0. See configuration for the 0.9.0 settings."},"2156":{"id":"/docs/introduction/about-16","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Highly performant, persistent append-only log for message streaming"},"2157":{"id":"/docs/introduction/about-17","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Very high throughput for both writes and reads"},"2158":{"id":"/docs/introduction/about-18","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Low latency and predictable resource usage thanks to the Rust compiled language (no GC) and io_uring"},"2159":{"id":"/docs/introduction/about-19","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Thread per core shared nothing design together with io_uring guarantee the best possible performance on modern Linux systems"},"2160":{"id":"/docs/introduction/about-20","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"NUMA-aware sharding with CPU affinity and memory binding per NUMA node for optimal hardware utilization"},"2161":{"id":"/docs/introduction/about-21","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"User authentication and authorization with granular permissions, Personal Access Tokens (PAT) and Argon2id password hashing"},"2162":{"id":"/docs/introduction/about-22","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Support for multiple streams, topics and partitions"},"2163":{"id":"/docs/introduction/about-23","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Support for multiple transport protocols (QUIC, TCP, WebSocket, HTTP)"},"2164":{"id":"/docs/introduction/about-24","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Fully operational RESTful API which can be optionally enabled"},"2165":{"id":"/docs/introduction/about-25","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Available client SDK in multiple languages"},"2166":{"id":"/docs/introduction/about-26","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Works directly with binary data, avoiding enforced schema and serialization/deserialization overhead"},"2167":{"id":"/docs/introduction/about-27","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Custom zero-copy (de)serialization, which greatly improves the performance and reduces memory usage"},"2168":{"id":"/docs/introduction/about-28","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Custom memory pool with 28 buckets (buffer sizes from 4 KiB to 512 MiB) for on-demand allocation, buffer reuse and sharing without copying buffer contents"},"2169":{"id":"/docs/introduction/about-29","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Configurable server features (e.g. caching and transport protocols), plus per-topic segment size, durability and flush thresholds"},"2170":{"id":"/docs/introduction/about-30","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Server-side storage of consumer offsets"},"2171":{"id":"/docs/introduction/about-31","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Multiple ways of polling the messages:"},"2172":{"id":"/docs/introduction/about-32","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"By offset (using the indexes)"},"2173":{"id":"/docs/introduction/about-33","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"By timestamp (using the time indexes)"},"2174":{"id":"/docs/introduction/about-34","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"First/Last N messages"},"2175":{"id":"/docs/introduction/about-35","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Next N messages for the specific consumer"},"2176":{"id":"/docs/introduction/about-36","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Optional poll auto-commit, with processing and failure semantics explained in concepts"},"2177":{"id":"/docs/introduction/about-37","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Consumer groups distributing partitions across connected clients for horizontal scaling; ordering is per partition, with cooperative partition rebalancing"},"2178":{"id":"/docs/introduction/about-38","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Message expiry with auto deletion based on the configurable retention policy"},"2179":{"id":"/docs/introduction/about-39","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Multi-tenant support via abstraction of streams which group topics"},"2180":{"id":"/docs/introduction/about-40","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"TLS support for all transport protocols (TCP, QUIC, WebSocket, HTTPS)"},"2181":{"id":"/docs/introduction/about-41","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Connectors - sinks, sources and data transformations based on the custom Rust plugins loaded dynamically at runtime"},"2182":{"id":"/docs/introduction/about-42","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Model Context Protocol - provide context to LLM with MCP server exposing 40+ tools for streaming management"},"2183":{"id":"/docs/introduction/about-43","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Optional server-side as well as client-side data encryption using AES-256-GCM"},"2184":{"id":"/docs/introduction/about-44","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Optional metadata support in the form of message headers"},"2185":{"id":"/docs/introduction/about-45","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Prometheus metrics and OpenTelemetry logs & traces in the connector runtime. Server export has known limitations."},"2186":{"id":"/docs/introduction/about-46","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Built-in CLI to manage the streaming server installable via cargo install iggy-cli --version 0.14.0 --locked"},"2187":{"id":"/docs/introduction/about-47","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Built-in Web UI dashboard (Svelte) that can be embedded directly in the server binary or run as a standalone container"},"2188":{"id":"/docs/introduction/about-48","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Built-in benchmarking app to test the performance, with published results on the benchmarks dashboard"},"2189":{"id":"/docs/introduction/about-49","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Single binary deployment without an external broker or database; operating-system libraries are still required by dynamically linked builds"},"2190":{"id":"/docs/introduction/about-50","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Accept-time connection distribution for plaintext TCP and WebSocket across shards via file descriptor transfer"},"2191":{"id":"/docs/introduction/about-51","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#features","content":"Built on Viewstamped Replication (VSR) consensus: runs as a single node by default, with multi-node clustering available via the [cluster] configuration"},"2192":{"id":"/docs/introduction/about-52","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"Language"},"2193":{"id":"/docs/introduction/about-53","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"Package"},"2194":{"id":"/docs/introduction/about-54","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"Registry"},"2195":{"id":"/docs/introduction/about-55","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"Rust"},"2196":{"id":"/docs/introduction/about-56","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"iggy"},"2197":{"id":"/docs/introduction/about-57","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"crates.io"},"2198":{"id":"/docs/introduction/about-58","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"C#"},"2199":{"id":"/docs/introduction/about-59","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"Apache.Iggy"},"2200":{"id":"/docs/introduction/about-60","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"NuGet"},"2201":{"id":"/docs/introduction/about-61","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"Java"},"2202":{"id":"/docs/introduction/about-62","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"iggy"},"2203":{"id":"/docs/introduction/about-63","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"Maven Central"},"2204":{"id":"/docs/introduction/about-64","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"Python"},"2205":{"id":"/docs/introduction/about-65","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"apache-iggy"},"2206":{"id":"/docs/introduction/about-66","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"PyPI"},"2207":{"id":"/docs/introduction/about-67","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"Node.js"},"2208":{"id":"/docs/introduction/about-68","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"apache-iggy"},"2209":{"id":"/docs/introduction/about-69","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"npm"},"2210":{"id":"/docs/introduction/about-70","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"Go"},"2211":{"id":"/docs/introduction/about-71","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"iggy-go"},"2212":{"id":"/docs/introduction/about-72","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"pkg.go.dev"},"2213":{"id":"/docs/introduction/about-73","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"PHP"},"2214":{"id":"/docs/introduction/about-74","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"apache/iggy-php"},"2215":{"id":"/docs/introduction/about-75","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"GitHub (source build)"},"2216":{"id":"/docs/introduction/about-76","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"C++"},"2217":{"id":"/docs/introduction/about-77","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"iggy-cpp"},"2218":{"id":"/docs/introduction/about-78","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"GitHub (WIP)"},"2219":{"id":"/docs/introduction/about-79","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#cli","content":"The interactive CLI is implemented under core/cli, to provide the best developer experience. This is a great addition to the Web UI, especially for developers who prefer using the console tools."},"2220":{"id":"/docs/introduction/about-80","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#cli","content":"Iggy CLI can be installed with cargo install iggy-cli --version 0.14.0 --locked and then simply accessed by typing iggy in your terminal. It supports named connection contexts (profiles) for managing multiple server connections, shell completions for bash/zsh/fish/elvish/powershell, and session-based login through platform credential stores on Linux, macOS and Windows when the default login-session feature is enabled."},"2221":{"id":"/docs/introduction/about-81","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#web-ui","content":"The Web UI provides a comprehensive dashboard for the Iggy server, built with SvelteKit and TypeScript. It can run in two modes:"},"2222":{"id":"/docs/introduction/about-82","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#web-ui","content":"Embedded - compiled into the server binary (with the iggy-web feature and built static assets), served at the /ui endpoint when http.web_ui = true"},"2223":{"id":"/docs/introduction/about-83","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#web-ui","content":"Standalone - as a separate container via docker pull apache/iggy-web-ui:0.4.0"},"2224":{"id":"/docs/introduction/about-84","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#web-ui","content":"Features include stream/topic/partition management, a message browser with JSON/string/XML decoders, and user listing and creation with initial permissions. Editing or deleting existing users and changing their permissions are placeholders. The logs and terminal pages are also placeholders, and the server settings page has a disabled Save action rather than an operational configuration editor."},"2225":{"id":"/docs/introduction/about-85","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#connectors","content":"Iggy provides a highly performant and modular runtime for statically typed, yet dynamically loaded connectors. You can ingest data from external sources and push the data to Iggy streams, or fetch data from Iggy streams and forward it to external systems. Create your own Rust plugins by simply implementing either the Source or Sink trait and build custom pipelines for the data processing."},"2226":{"id":"/docs/introduction/about-86","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#connectors","content":"The source tree contains 16 sinks and 4 sources. Sinks include PostgreSQL, MongoDB, Elasticsearch, ClickHouse, InfluxDB, Apache Iceberg, Delta Lake, Quickwit and S3. Sources include PostgreSQL, Elasticsearch, InfluxDB and random data generation. See the connectors documentation for the full catalog."},"2227":{"id":"/docs/introduction/about-87","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#connectors","content":"The docker image is available, and can be fetched via docker pull apache/iggy-connect:0.5.0."},"2228":{"id":"/docs/introduction/about-88","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#model-context-protocol","content":"The Model Context Protocol (MCP) is an open protocol that standardizes how applications provide context to LLMs. The Iggy MCP Server is an implementation of the MCP protocol for message streaming infrastructure. It exposes 40+ tools covering streams, topics, partitions, messages, consumer groups, users, and more. It supports both HTTP and stdio transports, making it compatible with tools like Claude Desktop and other MCP clients."},"2229":{"id":"/docs/introduction/about-89","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#model-context-protocol","content":"The docker image is available, and can be fetched via docker pull apache/iggy-mcp:0.5.0."},"2230":{"id":"/docs/introduction/about-90","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"The official Apache Iggy images can be found on Docker Hub. These docs target server 0.9.0. Use docker pull apache/iggy:0.9.0, or docker pull apache/iggy:edge for a development image. SDK and tooling versions are independent of the server version."},"2231":{"id":"/docs/introduction/about-91","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"You can also find the images for all the different tooling such as Connectors, MCP Server etc. here."},"2232":{"id":"/docs/introduction/about-92","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"Please note that the images tagged as latest are based on the official, stable releases, while the edge ones are updated directly from latest version of the master branch."},"2233":{"id":"/docs/introduction/about-93","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"You can find the development Dockerfile and docker-compose.yml in the root of the repository. Published server images use core/server/Dockerfile. To build and start the server, run: docker compose up."},"2234":{"id":"/docs/introduction/about-94","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"For the root Compose build, run the included CLI with docker exec -it iggy-server /iggy. In published images, its path is /usr/local/bin/iggy."},"2235":{"id":"/docs/introduction/about-95","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"Keep in mind that running the container on operating systems other than Linux, where the Docker is running in the VM, might result in the performance degradation."},"2236":{"id":"/docs/introduction/about-96","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"Also, when running the container, make sure to include the additional capabilities, as you can find in docker-compose file:"},"2237":{"id":"/docs/introduction/about-97","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"Or when running with docker run:"},"2238":{"id":"/docs/introduction/about-98","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#helm-charts","content":"Helm charts for Kubernetes deployment are available in the repository. The chart includes templates for Deployment, Service, ServiceAccount, Ingress, PersistentVolumeClaim, ServiceMonitor (for Prometheus), and root user credentials Secret."},"2239":{"id":"/docs/introduction/about-99","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#versioning","content":"The official releases follow the regular semver (0.5.0) or have a latest tag applied (apache/iggy:latest)."},"2240":{"id":"/docs/introduction/about-100","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#versioning","content":"We also publish edge/dev/nightly releases (e.g. 0.6.0-edge.1 or apache/iggy:edge), for both SDKs and the Docker images. These are typically compatible with the latest changes but are not guaranteed to be stable and, as the name suggests, are not recommended for production use."},"2241":{"id":"/docs/introduction/architecture","page_id":"/docs/introduction/architecture","type":"page","content":"Architecture","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/architecture"},"2242":{"id":"/docs/introduction/architecture-0","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture","content":"Inside the Iggy server: how work is scheduled across cores, how requests are routed, and how a message reaches disk."},"2243":{"id":"/docs/introduction/architecture-1","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#how-a-message-flows-through-iggy","content":"How a message flows through Iggy"},"2244":{"id":"/docs/introduction/architecture-2","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#thread-per-core-shared-nothing--io_uring","content":"Thread per core (shared nothing) + io_uring"},"2245":{"id":"/docs/introduction/architecture-3","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#how-it-works","content":"How it works"},"2246":{"id":"/docs/introduction/architecture-4","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#shard-roles-and-connection-distribution","content":"Shard roles and connection distribution"},"2247":{"id":"/docs/introduction/architecture-5","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#request-routing","content":"Request routing"},"2248":{"id":"/docs/introduction/architecture-6","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#iggynamespace","content":"IggyNamespace"},"2249":{"id":"/docs/introduction/architecture-7","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#cpu-allocation-modes","content":"CPU allocation modes"},"2250":{"id":"/docs/introduction/architecture-8","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#io_uring-and-compio","content":"io_uring and compio"},"2251":{"id":"/docs/introduction/architecture-9","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#performance-tokio-vs-thread-per-core","content":"Performance: Tokio vs Thread-per-Core"},"2252":{"id":"/docs/introduction/architecture-10","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#left-right-metadata","content":"Left-right metadata"},"2253":{"id":"/docs/introduction/architecture-11","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#clustering","content":"Clustering"},"2254":{"id":"/docs/introduction/architecture-12","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#storage-structure","content":"Storage structure"},"2255":{"id":"/docs/introduction/architecture-13","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#memory-pool","content":"Memory pool"},"2256":{"id":"/docs/introduction/architecture-14","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#write-pipeline","content":"Write pipeline"},"2257":{"id":"/docs/introduction/architecture-15","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture","content":"This page covers the internals of the Iggy server: how work is scheduled across CPU cores, how requests are routed, and how data ends up on disk. If you're looking for the domain model (streams, topics, partitions, consumer groups, message format), see concepts first."},"2258":{"id":"/docs/introduction/architecture-16","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#how-a-message-flows-through-iggy","content":"Before diving into the architecture details, here's an overview of a message's journey from client to disk:"},"2259":{"id":"/docs/introduction/architecture-17","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#thread-per-core-shared-nothing--io_uring","content":"Iggy uses a thread-per-core shared nothing architecture combined with io_uring for maximum performance. This design has been proven by systems like ScyllaDB and Redpanda, both built on the Seastar framework."},"2260":{"id":"/docs/introduction/architecture-18","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#how-it-works","content":"Each configured shard (an instance of IggyShard) has its own single-threaded compio async runtime. With pin_cores = true, Linux shard threads are pinned to their selected CPUs via sched_setaffinity. NUMA allocation modes also bind memory via hwlocality. Setting pin_cores = false disables both bindings; shared metadata and inter-shard communication still require synchronization."},"2261":{"id":"/docs/introduction/architecture-19","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#shard-roles-and-connection-distribution","content":"Shard 0 has a special role: it binds every listener - the replica plane and all client transports (TCP, QUIC, WebSocket, HTTP). Connections are then spread across shards at accept time:"},"2262":{"id":"/docs/introduction/architecture-20","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#shard-roles-and-connection-distribution","content":"TCP and WebSocket connections, plaintext or TLS, are handed off round-robin across the shards. Shard 0's coordinator duplicates the socket's file descriptor, ships a connection-setup frame to the target shard, and drops its own handle, so the owning shard serves the connection from then on - before a single byte is read. For TLS-wrapped TCP and secure WebSocket (WSS), the target shard runs the TLS handshake. Shard 0 is part of the rotation by default; skip_shard_zero_for_clients = true under [cluster.coordinator] takes it out."},"2263":{"id":"/docs/introduction/architecture-21","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#shard-roles-and-connection-distribution","content":"QUIC connections stay on shard 0, installed through its UDP endpoint. HTTP is also served on shard 0."},"2264":{"id":"/docs/introduction/architecture-22","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#shard-roles-and-connection-distribution","content":"All shards, including shard 0, own partitions and serve partition requests."},"2265":{"id":"/docs/introduction/architecture-23","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#request-routing","content":"Requests are routed between shards using message passing (via crossfire bounded mpsc channels), so partition state remains on its owning shard. The routing logic splits operations into two planes:"},"2266":{"id":"/docs/introduction/architecture-24","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#request-routing","content":"Metadata operations (create/delete stream/topic/user etc.) always execute on shard 0 - it is the only shard that commits metadata"},"2267":{"id":"/docs/introduction/architecture-25","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#request-routing","content":"Partition operations (send_messages, poll_messages, store_consumer_offset) are routed to the shard owning that partition via a lock-free concurrent map lookup. The request is sent into the owning shard's channel, whichever shard received it"},"2268":{"id":"/docs/introduction/architecture-26","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#request-routing","content":"Partition-to-shard assignment is deterministic: the packed IggyNamespace is hashed with Murmur3, and the upper 16 bits of the hash are taken modulo the shard count (the upper bits are used because Murmur3 has weak lower bits for small integer inputs)."},"2269":{"id":"/docs/introduction/architecture-27","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#iggynamespace","content":"The IggyNamespace packs stream_id (20 bits), topic_id (12 bits), and partition_id (20 bits) into a single u64 for efficient hashing and routing. This gives maximums of 1,048,576 streams, 4096 topics per stream, and 1,000,000 partitions per topic."},"2270":{"id":"/docs/introduction/architecture-28","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#cpu-allocation-modes","content":"The sharding system supports multiple allocation modes via the cpu_allocation config:"},"2271":{"id":"/docs/introduction/architecture-29","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#cpu-allocation-modes","content":"\"all\" - one shard per available CPU core"},"2272":{"id":"/docs/introduction/architecture-30","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#cpu-allocation-modes","content":"A numeric value (e.g. 4) - exactly N shards, pinned to the first N CPUs in the process's allowed CPU set when pinning is enabled"},"2273":{"id":"/docs/introduction/architecture-31","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#cpu-allocation-modes","content":"A range (e.g. \"5..8\") - shards on CPUs 5, 6 and 7 when pinning is enabled; those CPUs must be allowed for the process"},"2274":{"id":"/docs/introduction/architecture-32","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#cpu-allocation-modes","content":"\"numa:auto\" - automatically detect NUMA topology and select physical cores, avoiding sibling hyperthreads"},"2275":{"id":"/docs/introduction/architecture-33","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#cpu-allocation-modes","content":"\"numa:nodes=0,1;cores=4;no_ht=true\" - explicit NUMA nodes, with the same number of cores taken from each listed node and hyperthread avoidance"},"2276":{"id":"/docs/introduction/architecture-34","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"Traditional async runtimes like tokio use epoll which is readiness-based - you ask the kernel \"is this file descriptor ready?\" and then perform the I/O yourself. Regular files cannot be registered with epoll. Tokio runs file I/O on a blocking thread pool that grows on demand (up to 512 threads by default, configurable). This does not scale well."},"2277":{"id":"/docs/introduction/architecture-35","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"io_uring is completion-based - you submit I/O requests to a submission queue (SQ), and the kernel completes them and places results in a completion queue (CQ). Both queues are shared ring buffers between user space and kernel. Submissions and completions can be batched to reduce syscalls. This is fundamentally better for disk I/O."},"2278":{"id":"/docs/introduction/architecture-36","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"Iggy uses compio as its async runtime, which provides a driver-disaggregated architecture on top of io_uring (Linux) and IOCP (Windows). Each shard gets its own compio executor configured with:"},"2279":{"id":"/docs/introduction/architecture-37","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"Capacity: an io_uring submission queue of 4096 entries (by default)"},"2280":{"id":"/docs/introduction/architecture-38","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"Event interval: poll the I/O driver after 128 scheduler ticks (roughly task polls) by default"},"2281":{"id":"/docs/introduction/architecture-39","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"Cooperative task running enabled"},"2282":{"id":"/docs/introduction/architecture-40","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"IGGY_SHARD_RUNTIME_CAPACITY and IGGY_SHARD_EVENT_INTERVAL override the two numeric defaults. On macOS, compio uses its polling driver and a blocking pool for file I/O."},"2283":{"id":"/docs/introduction/architecture-41","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#performance-tokio-vs-thread-per-core","content":"The historical migration benchmarks compared v0.5.0 with v0.7.0 at approximately 1,000 MB/s per node. The chart shows selected latency reductions for 8, 16 and 32 producers, each using its own stream. The 8-producer case also reported higher P95 and P99 latency; these are not measurements of 0.9.0:"},"2284":{"id":"/docs/introduction/architecture-42","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#left-right-metadata","content":"Shared metadata (streams, topics, consumer groups) uses a left-right concurrent data structure. Shard 0 holds the single write handle and is the only shard that commits metadata mutations, while every shard holds a read handle. This provides:"},"2285":{"id":"/docs/introduction/architecture-43","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#left-right-metadata","content":"Lock-free reads on all shards (no contention on the hot path)"},"2286":{"id":"/docs/introduction/architecture-44","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#left-right-metadata","content":"Strongly consistent writes serialized through shard 0"},"2287":{"id":"/docs/introduction/architecture-45","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#clustering","content":"The server is built on the Viewstamped Replication (VSR) consensus protocol. Metadata operations are committed through the VSR write-ahead log even on a single node, which is the default deployment. Multi-node clustering is enabled via the [cluster] configuration (a node roster plus --replica-id to pick the local entry). See clustering for the details and maturity caveats."},"2288":{"id":"/docs/introduction/architecture-46","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#storage-structure","content":"Having in mind that stream consists of topics, which might have one or more partitions assigned, and each partition consists of segments, we can visualize the structure of the Iggy data directory as follows:"},"2289":{"id":"/docs/introduction/architecture-47","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#storage-structure","content":"This example shows a fresh partition with the default paths. The stream, topic and partition directories are named after their numeric IDs, assigned from 0. The metadata/journal.wal file is the VSR write-ahead log for metadata operations (stream/topic/user creation, etc.). Its index has 1024 slots by default (journal_slots under [metadata]). Before they run out, the server checkpoints the metadata into metadata/snapshot.bin, records the checkpoint in a superblock under metadata/, and drops the checkpointed operations from the log. On a single node, neither file exists until the first checkpoint. The runtime/current_config.toml file is rewritten at every boot with the configuration the server booted with and the addresses it actually bound. Secrets (the JWT secrets, the encryption key and the cluster shared secret) are left out. The state/log file is empty; the server creates it at boot and does not otherwise use it. Segment files are named by their 20-digit start offset. Recovery can create an empty active segment at a reserved offset beyond the last stored message; partition superblocks record the recovery frontiers. A superblock is written to two files in turn, superblock.a and superblock.b. A fresh partition has only superblock.a; superblock.b appears at the next superblock write, for example after a restart or a topic purge. The .index file is created automatically and speeds up searches by keeping track of the offsets and timestamps of the records. The offsets/ directory holds the server-side consumer and consumer group offsets."},"2290":{"id":"/docs/introduction/architecture-48","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#memory-pool","content":"Iggy uses a custom memory pool with 28 buckets holding buffer sizes from 4 KiB to 512 MiB. The default pool size is 4 GiB with up to 8192 buffers per bucket. Buffers are allocated on demand and reused; requests that exceed the pool budget can allocate outside it. Frozen buffers can be shared between components without copying their contents. The pool is page-aligned (4096-byte multiples) and requires a minimum of 512 MiB."},"2291":{"id":"/docs/introduction/architecture-49","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"Messages flow through a multi-stage write pipeline:"},"2292":{"id":"/docs/introduction/architecture-50","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"Messages arrive on the owning shard and are buffered in the partition journal."},"2293":{"id":"/docs/introduction/architecture-51","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"Partition VSR replicates prepares. With durability=persisted, a multi-replica group requires recoverable prepare-WAL copies at the replication quorum before commit."},"2294":{"id":"/docs/introduction/architecture-52","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"Awaited writes apply committed operations before success is returned. A singleton with durability=persisted synchronizes local segment state before replying."},"2295":{"id":"/docs/introduction/architecture-53","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"Ordinary segment writes use per-topic count and byte thresholds (defaults: 1024 messages, 1 MiB); required persistence, capacity pressure, and lifecycle work can flush earlier. The MessagesWriter uses vectored I/O in chunks of up to 1024 buffers. Partial writes can require more than one I/O submission."},"2296":{"id":"/docs/introduction/architecture-54","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"When a segment reaches or passes the topic's segment size (default 1 GiB), it is sealed and a new segment is created. The batch that crosses the size is written whole, so a sealed segment can exceed it by up to one batch."},"2297":{"id":"/docs/introduction/architecture-55","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"Message durability and consumer_offset_durability default independently to replicated. Both policies write data to disk; persisted adds a stable-storage requirement at completion. See Durability."},"2298":{"id":"/docs/introduction/coming-from-kafka","page_id":"/docs/introduction/coming-from-kafka","type":"page","content":"Coming from Apache Kafka","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/coming-from-kafka"},"2299":{"id":"/docs/introduction/coming-from-kafka-0","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka","content":"How Apache Kafka's topics, partitions, consumer groups and offsets map to Apache Iggy, and what works differently."},"2300":{"id":"/docs/introduction/coming-from-kafka-1","page_id":"/docs/introduction/coming-from-kafka","type":"heading","tags":[],"url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"How the terms map"},"2301":{"id":"/docs/introduction/coming-from-kafka-2","page_id":"/docs/introduction/coming-from-kafka","type":"heading","tags":[],"url":"/docs/introduction/coming-from-kafka#what-works-differently","content":"What works differently"},"2302":{"id":"/docs/introduction/coming-from-kafka-3","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka","content":"If you already know Apache Kafka, most of Apache Iggy will feel familiar. This page maps the Kafka terms you know to Iggy's and lists what works differently. For when to choose one or the other, see Apache Iggy or Apache Kafka."},"2303":{"id":"/docs/introduction/coming-from-kafka-4","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Kafka"},"2304":{"id":"/docs/introduction/coming-from-kafka-5","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Iggy"},"2305":{"id":"/docs/introduction/coming-from-kafka-6","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"What to know"},"2306":{"id":"/docs/introduction/coming-from-kafka-7","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"No equivalent"},"2307":{"id":"/docs/introduction/coming-from-kafka-8","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Stream"},"2308":{"id":"/docs/introduction/coming-from-kafka-9","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"A container for related topics. For example, a dev stream and a production stream can each have their own orders topic."},"2309":{"id":"/docs/introduction/coming-from-kafka-10","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Topic"},"2310":{"id":"/docs/introduction/coming-from-kafka-11","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Topic"},"2311":{"id":"/docs/introduction/coming-from-kafka-12","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Belongs to one stream."},"2312":{"id":"/docs/introduction/coming-from-kafka-13","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Partition"},"2313":{"id":"/docs/introduction/coming-from-kafka-14","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Partition"},"2314":{"id":"/docs/introduction/coming-from-kafka-15","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Where messages are stored, as in Kafka."},"2315":{"id":"/docs/introduction/coming-from-kafka-16","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Consumer group"},"2316":{"id":"/docs/introduction/coming-from-kafka-17","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Consumer group"},"2317":{"id":"/docs/introduction/coming-from-kafka-18","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Each partition goes to one member of the group, and the server rebalances when members join or leave."},"2318":{"id":"/docs/introduction/coming-from-kafka-19","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Offset"},"2319":{"id":"/docs/introduction/coming-from-kafka-20","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Offset"},"2320":{"id":"/docs/introduction/coming-from-kafka-21","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Starts at 0 in each partition, but can skip numbers after a recovery."},"2321":{"id":"/docs/introduction/coming-from-kafka-22","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Retention"},"2322":{"id":"/docs/introduction/coming-from-kafka-23","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Retention policy"},"2323":{"id":"/docs/introduction/coming-from-kafka-24","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Set per topic. Whole segments are deleted once all their messages have expired."},"2324":{"id":"/docs/introduction/coming-from-kafka-25","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#how-the-terms-map","content":"Concepts explains each of these in more detail."},"2325":{"id":"/docs/introduction/coming-from-kafka-26","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#what-works-differently","content":"Iggy has its own protocol. A Kafka client can't talk to Iggy yet, so you use an Iggy SDK, the HTTP API or the binary protocol. A Kafka protocol gateway is being built (see issue #3421), but it can't serve consumers yet."},"2326":{"id":"/docs/introduction/coming-from-kafka-27","page_id":"/docs/introduction/coming-from-kafka","tags":[],"type":"text","url":"/docs/introduction/coming-from-kafka#what-works-differently","content":"There is an extra level above topics. Every topic lives in a stream, so you create a stream before you create its topics."},"2327":{"id":"/docs/introduction/concepts","page_id":"/docs/introduction/concepts","type":"page","content":"Concepts","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/concepts"},"2328":{"id":"/docs/introduction/concepts-0","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts","content":"The domain model behind Iggy, and how an append-only streaming log differs from a message broker."},"2329":{"id":"/docs/introduction/concepts-1","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#message-streaming","content":"Message streaming"},"2330":{"id":"/docs/introduction/concepts-2","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#append-only-log","content":"Append-only log"},"2331":{"id":"/docs/introduction/concepts-3","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#stream","content":"Stream"},"2332":{"id":"/docs/introduction/concepts-4","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#topic","content":"Topic"},"2333":{"id":"/docs/introduction/concepts-5","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#partition","content":"Partition"},"2334":{"id":"/docs/introduction/concepts-6","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#segment","content":"Segment"},"2335":{"id":"/docs/introduction/concepts-7","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#polling-messages","content":"Polling messages"},"2336":{"id":"/docs/introduction/concepts-8","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#consumer-groups","content":"Consumer groups"},"2337":{"id":"/docs/introduction/concepts-9","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#message-format","content":"Message format"},"2338":{"id":"/docs/introduction/concepts-10","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts","content":"Iggy is a persistent message streaming platform: messages are stored in a form of an append-only log. You can create multiple streams, consisting of topics, which might have one or more partitions assigned, e.g. to divide consumption among independent consumers. Multi-node replication provides redundancy. You can think of Iggy as an alternative to Kafka or RabbitMQ streams."},"2339":{"id":"/docs/introduction/concepts-11","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-streaming","content":"You've probably used RabbitMQ or Kafka already. They look similar at the first glance, and you can achieve the similar results with both (e.g. publishing and consuming the events by the different applications built on top of microservices architecture), but they work differently underneath."},"2340":{"id":"/docs/introduction/concepts-12","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-streaming","content":"RabbitMQ is a message broker with both queues and streams. Traditional queues deliver messages to consumers and remove them after acknowledgement, or on delivery when automatic acknowledgement is used, so acknowledged messages cannot be replayed from the queue. Multiple consumers can share a queue and divide its messages. Independent subscribers that each need a copy use separate queues bound to an exchange. Queues normally use FIFO (First In, First Out) order, but priorities, redelivery and competing consumers can affect the observed order. See RabbitMQ's queue semantics. The typical message broker follows the so-called smart pipes and dumb endpoints pattern."},"2341":{"id":"/docs/introduction/concepts-13","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-streaming","content":"On the other hand, Kafka is a message streaming platform that stores messages in an append-only log and serves consumer fetch requests. The consumers are responsible for reading the messages from the log and processing them. Multiple consumer groups can read the same retained log without a separate stored copy for each group, although their fetch requests still consume CPU and network resources. The consumers can read the messages from the beginning, or from the specific offset, thus you can replay the messages. The typical message streaming platform follows the so-called dumb pipes and smart endpoints pattern."},"2342":{"id":"/docs/introduction/concepts-14","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-streaming","content":"Both approaches have advantages and disadvantages. The message broker is a more mature concept, but the message streaming platform is gaining more and more popularity, especially in the cloud-native world. And you can achieve much higher performance and throughput with the message streaming platform, since it acts as a simple database, being optimized for the append-only operations and can be queried in a very efficient way."},"2343":{"id":"/docs/introduction/concepts-15","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-streaming","content":"Iggy is the latter, a message streaming platform."},"2344":{"id":"/docs/introduction/concepts-16","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#append-only-log","content":"The append-only log is the core concept of Iggy. It's a simple data structure, which is optimized for the append-only operations. It's a sequence of records, that are being appended to the end of the log. The records are immutable, so that they can't be changed once they are written to the log. Records within a partition follow the order admitted by that partition's primary. There is no global ordering across partitions."},"2345":{"id":"/docs/introduction/concepts-17","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#append-only-log","content":"You address the log by offset, the position of the record in the log. Offsets start from 0 and increase within a partition. They are not guaranteed to be contiguous: after recovery, the server can skip reserved offsets to avoid reusing them. When the client reads the records, it specifies the offset to start from and the maximum number of records it wants. Starting from the beginning, or from any earlier offset, is how you replay the messages."},"2346":{"id":"/docs/introduction/concepts-18","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#stream","content":"While we could put an equal sign between the log and the stream, they are not the same, at least in a case of Iggy streaming server.\nThe stream is a logical concept, and you might think of it as a namespace. For example, you could have a single stream for the whole system, or multiple streams e.g. representing the different environments, such as dev, staging and production. The stream is identified by its unique ID. The stream can have zero or more topics assigned, which results in the records being published to the specific topics that belong to the particular stream."},"2347":{"id":"/docs/introduction/concepts-19","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#topic","content":"The topic is also the logical concept, which is a part of the stream. The topic is identified by its ID, which is unique within its stream. You could think of topic as an entity being responsible for storing the specific type of the records. For example, you could have a topic for the user events, and another topic for the order events, etc."},"2348":{"id":"/docs/introduction/concepts-20","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#topic","content":"The messages are not being stored in the topic directly, but rather in the partitions, which are assigned to the topic. The topic can have one or more partitions assigned, that could help achieve higher parallelism and throughput. The topic can also have a retention policy. Expiry removes whole sealed segments after their newest message has expired, subject to the stored consumer-offset barrier; it does not delete each message immediately at its expiry time. See topic options for expiry and size-limit behavior. Topics also support maximum size limits and per-topic storage options (segment_size, durability, consumer_offset_durability, and flush thresholds) set at creation, plus a compression_algorithm option (a placeholder today: no compression is applied yet). Both durability policies independently default to replicated."},"2349":{"id":"/docs/introduction/concepts-21","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#partition","content":"The partition has its own unique ID and belongs to the topic. The partition is responsible for storing the records. The records are being distributed between the partitions, therefore the partition acts as a simple database, which is optimized for the append-only operations. The partition is identified by its unique ID, which is an integer. Stream, topic and partition IDs are assigned starting from 0. Deleted stream and topic IDs can be reused. New partitions use IDs above the highest remaining partition ID, so deleting the highest partitions can also allow their IDs to be reused. The partition ID is unique per topic, thus the same partition ID can be used in multiple topics."},"2350":{"id":"/docs/introduction/concepts-22","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#partition","content":"Thanks to having multiple partitions, we can achieve the horizontal scalability between many independent consumers, since each consumer can read the messages from the different partitions. This can be achieved by using more advanced concepts such as consumer groups."},"2351":{"id":"/docs/introduction/concepts-23","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#partition","content":"Each partition in the thread-per-core architecture is owned by exactly one shard per replica and includes:"},"2352":{"id":"/docs/introduction/concepts-24","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#partition","content":"A SegmentedLog with sealed segments and one active segment"},"2353":{"id":"/docs/introduction/concepts-25","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#partition","content":"Consumer offsets and consumer group offsets"},"2354":{"id":"/docs/introduction/concepts-26","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#segment","content":"The segment, being a part of the partition, is the actual physical layer which stores the records in the binary format in a form of the files. Each segment has a soft size limit (1 GiB unless the topic sets its own segment_size). A segment can exceed it by one whole batch before it is sealed and a new segment is created. The segment name is based on the start offset of the first record in the segment and is unique per partition."},"2355":{"id":"/docs/introduction/concepts-27","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#segment","content":"Each segment consists of:"},"2356":{"id":"/docs/introduction/concepts-28","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#segment","content":".log file - the actual message data"},"2357":{"id":"/docs/introduction/concepts-29","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#segment","content":".index file - positional and time indexes for fast lookups"},"2358":{"id":"/docs/introduction/concepts-30","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#polling-messages","content":"Consumers can poll the messages in multiple ways:"},"2359":{"id":"/docs/introduction/concepts-31","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#polling-messages","content":"By offset - start reading from the specified offset. The client tracks its own position."},"2360":{"id":"/docs/introduction/concepts-32","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#polling-messages","content":"By timestamp - start reading from the first message at or after the given timestamp."},"2361":{"id":"/docs/introduction/concepts-33","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#polling-messages","content":"First / Last - start from the beginning or the end of the partition."},"2362":{"id":"/docs/introduction/concepts-34","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#polling-messages","content":"Next - continue from the consumer offset stored on the server side. The server tracks the cursor. On the primary, auto_commit: true submits an offset update before the poll response is delivered, without waiting for that update to commit. Follower polls do not advance it. This alone guarantees neither at-most-once nor at-least-once processing. For processing-before-commit ordering, explicitly store the offset after processing, using store_consumer_offset() in the Rust SDK."},"2363":{"id":"/docs/introduction/concepts-35","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#consumer-groups","content":"Consumer groups provide horizontal scaling for message consumption. When multiple consumers join the same consumer group, the server automatically distributes partitions among group members so that each partition has at most one member permitted to poll it within that group. When members join or leave, the server triggers a cooperative partition rebalancing with a pending revocation phase (configurable timeout, default 30s) to let the previous owner finish processing and commit before handoff. Application processing and offset-commit ordering still determine whether failures cause skips or duplicates."},"2364":{"id":"/docs/introduction/concepts-36","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"The Rust SDK's IggyMessageHeader::to_bytes() representation is 64 bytes, with little-endian fields. The diagram and table describe that SDK representation, not Rust struct memory layout. On the wire and on disk, messages travel inside batch records with a compact 48-byte per-message frame header. See the Binary Protocol section for the exact encodings."},"2365":{"id":"/docs/introduction/concepts-37","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Field"},"2366":{"id":"/docs/introduction/concepts-38","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Bytes"},"2367":{"id":"/docs/introduction/concepts-39","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Type"},"2368":{"id":"/docs/introduction/concepts-40","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Description"},"2369":{"id":"/docs/introduction/concepts-41","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"checksum"},"2370":{"id":"/docs/introduction/concepts-42","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"0-8"},"2371":{"id":"/docs/introduction/concepts-43","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"u64"},"2372":{"id":"/docs/introduction/concepts-44","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"xxHash3 integrity checksum"},"2373":{"id":"/docs/introduction/concepts-45","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"id"},"2374":{"id":"/docs/introduction/concepts-46","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"8-24"},"2375":{"id":"/docs/introduction/concepts-47","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"u128"},"2376":{"id":"/docs/introduction/concepts-48","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Client-supplied 128-bit ID; generated as UUIDv4 when omitted by the Rust SDK"},"2377":{"id":"/docs/introduction/concepts-49","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"offset"},"2378":{"id":"/docs/introduction/concepts-50","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs