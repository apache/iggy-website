nary-protocol/cluster#command-discriminants","content":"28"},"343":{"id":"/docs/binary-protocol/cluster-127","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#command-discriminants","content":"ForwardLogout"},"344":{"id":"/docs/binary-protocol/cluster-128","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#command-discriminants","content":"backup to primary"},"345":{"id":"/docs/binary-protocol/cluster-129","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#command-discriminants","content":"Forward a logout"},"346":{"id":"/docs/binary-protocol/cluster-130","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#command-discriminants","content":"29"},"347":{"id":"/docs/binary-protocol/cluster-131","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#command-discriminants","content":"ForwardLogoutResult"},"348":{"id":"/docs/binary-protocol/cluster-132","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#command-discriminants","content":"primary to backup"},"349":{"id":"/docs/binary-protocol/cluster-133","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#command-discriminants","content":"Logout outcome"},"350":{"id":"/docs/binary-protocol/cluster-134","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#command-discriminants","content":"There is no dedicated replica heartbeat: liveness is the Commit broadcast, sent on cluster.commit_broadcast_interval."},"351":{"id":"/docs/binary-protocol/cluster-135","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#frame-integrity","content":"The checksum and checksum_body fields that client frames leave zero are live on the replica plane:"},"352":{"id":"/docs/binary-protocol/cluster-136","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#frame-integrity","content":"Frame seal (checksum, bytes 0..16): XxHash3-64 over header bytes 16..256, widened to u128. Sealed on replica control messages. Request is unsealed; Prepare and RepairPrepare use an identity hash instead. Handshake frames use a keyed MAC when authentication is enabled. Verified at typed decode before field validation; a mismatch drops the frame."},"353":{"id":"/docs/binary-protocol/cluster-137","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#frame-integrity","content":"Prepare identity (Prepare / RepairPrepare only): those two spend checksum on an identity hash instead - XxHash3-64 over the whole 256-byte header computed with checksum = 0 and view = 0, so a retransmit that re-stamps view keeps the same identity. RepairPrepare retains the original identity; the receiver restores command Prepare before integrity validation. PrepareOk echoes it in prepare_checksum, and each prepare's parent field carries the previous prepare's identity, forming a hash chain."},"354":{"id":"/docs/binary-protocol/cluster-138","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#frame-integrity","content":"Body seal (checksum_body, bytes 16..32): three regimes. Metadata-plane prepares seal their body with XxHash3-64. Partition-plane prepares leave it zero. SendMessages carries its own batch_checksum, verified at network ingress; consumer-offset writes have no message batch checksum. DoViewChange and StartView seal their suffix bodies. Every other message leaves it zero (state-transfer bodies are verified per artifact, not per frame)."},"355":{"id":"/docs/binary-protocol/cluster-139","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#frame-integrity","content":"The seals are unkeyed integrity checks, not authentication. Peer authentication comes from the handshake below; without cluster.auth and TLS enabled, the replica port trusts any peer that can reach it. Do not expose tcp_replica beyond the cluster network."},"356":{"id":"/docs/binary-protocol/cluster-140","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#frame-integrity","content":"Prepare and RepairPrepare validate their common and per-command reserved regions as zero. Session-forwarding headers validate their per-command reserved tails. Other reserved bytes in sealed control headers are covered by the frame seal."},"357":{"id":"/docs/binary-protocol/cluster-141","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#handshake","content":"With cluster.auth.enabled = true, commands 14-16 are exchanged before any consensus traffic. With authentication disabled, the dialer sends only ReplicaHello. These are raw GenericHeader frames (size = 256) using the per-command area at bytes 128..256:"},"358":{"id":"/docs/binary-protocol/cluster-142","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#handshake","content":"Offset"},"359":{"id":"/docs/binary-protocol/cluster-143","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#handshake","content":"Size"},"360":{"id":"/docs/binary-protocol/cluster-144","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#handshake","content":"Content"},"361":{"id":"/docs/binary-protocol/cluster-145","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#handshake","content":"128"},"362":{"id":"/docs/binary-protocol/cluster-146","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#handshake","content":"32"},"363":{"id":"/docs/binary-protocol/cluster-147","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#handshake","content":"Nonce (dialer's in Hello, acceptor's in Challenge)"},"364":{"id":"/docs/binary-protocol/cluster-148","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#handshake","content":"160"},"365":{"id":"/docs/binary-protocol/cluster-149","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#handshake","content":"32"},"366":{"id":"/docs/binary-protocol/cluster-150","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#handshake","content":"BLAKE3 keyed MAC (acceptor's in Challenge, dialer's in Finish)"},"367":{"id":"/docs/binary-protocol/cluster-151","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#handshake","content":"192"},"368":{"id":"/docs/binary-protocol/cluster-152","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#handshake","content":"1"},"369":{"id":"/docs/binary-protocol/cluster-153","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#handshake","content":"Challenge only: handshake status"},"370":{"id":"/docs/binary-protocol/cluster-154","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#handshake","content":"Statuses: 0 Ok, 1 UnknownCommand, 2 ClusterMismatch, 3 DirectionalRule; 4 AuthRequired and 5 MacMismatch are log-only labels (never sent), and a dialer treats any unknown status byte as a rejection. The MAC key derives from cluster.auth.shared_secret (32+ bytes; previous_shared_secret gives a rotation window), and with cluster TLS enabled (TLS 1.3 only, ALPN iggy-replica) the TLS exporter is folded into every MAC as channel binding. The handshake authenticates cluster membership, not per-replica identity: one shared secret for the whole cluster."},"371":{"id":"/docs/binary-protocol/cluster-155","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#handshake","content":"The cluster header field (bytes 32..48) is the first 16 bytes of blake3(cluster_name) as a little-endian u128 on every replica frame, checked during the handshake, so nodes from a differently named cluster cannot connect even with auth disabled."},"372":{"id":"/docs/binary-protocol/cluster-156","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"Per-command fields (bytes 128..256):"},"373":{"id":"/docs/binary-protocol/cluster-157","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"Offset"},"374":{"id":"/docs/binary-protocol/cluster-158","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"Size"},"375":{"id":"/docs/binary-protocol/cluster-159","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"Field"},"376":{"id":"/docs/binary-protocol/cluster-160","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"Description"},"377":{"id":"/docs/binary-protocol/cluster-161","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"128"},"378":{"id":"/docs/binary-protocol/cluster-162","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"16"},"379":{"id":"/docs/binary-protocol/cluster-163","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"client"},"380":{"id":"/docs/binary-protocol/cluster-164","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"Originating client id"},"381":{"id":"/docs/binary-protocol/cluster-165","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"144"},"382":{"id":"/docs/binary-protocol/cluster-166","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"16"},"383":{"id":"/docs/binary-protocol/cluster-167","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"parent"},"384":{"id":"/docs/binary-protocol/cluster-168","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"Previous prepare's identity checksum (hash chain)"},"385":{"id":"/docs/binary-protocol/cluster-169","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"160"},"386":{"id":"/docs/binary-protocol/cluster-170","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"16"},"387":{"id":"/docs/binary-protocol/cluster-171","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"request_checksum"},"388":{"id":"/docs/binary-protocol/cluster-172","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"Verbatim from the admitted request"},"389":{"id":"/docs/binary-protocol/cluster-173","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"176"},"390":{"id":"/docs/binary-protocol/cluster-174","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"8"},"391":{"id":"/docs/binary-protocol/cluster-175","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"op"},"392":{"id":"/docs/binary-protocol/cluster-176","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"Log position"},"393":{"id":"/docs/binary-protocol/cluster-177","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"184"},"394":{"id":"/docs/binary-protocol/cluster-178","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"8"},"395":{"id":"/docs/binary-protocol/cluster-179","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"commit"},"396":{"id":"/docs/binary-protocol/cluster-180","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"Primary's commit point when the prepare was built"},"397":{"id":"/docs/binary-protocol/cluster-181","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"192"},"398":{"id":"/docs/binary-protocol/cluster-182","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"8"},"399":{"id":"/docs/binary-protocol/cluster-183","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"timestamp"},"400":{"id":"/docs/binary-protocol/cluster-184","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"Primary-assigned monotonic timestamp"},"401":{"id":"/docs/binary-protocol/cluster-185","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"200"},"402":{"id":"/docs/binary-protocol/cluster-186","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"8"},"403":{"id":"/docs/binary-protocol/cluster-187","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"request"},"404":{"id":"/docs/binary-protocol/cluster-188","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"Client request number"},"405":{"id":"/docs/binary-protocol/cluster-189","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"208"},"406":{"id":"/docs/binary-protocol/cluster-190","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"1"},"407":{"id":"/docs/binary-protocol/cluster-191","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"operation"},"408":{"id":"/docs/binary-protocol/cluster-192","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"Operation discriminant (+7 padding)"},"409":{"id":"/docs/binary-protocol/cluster-193","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"216"},"410":{"id":"/docs/binary-protocol/cluster-194","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"8"},"411":{"id":"/docs/binary-protocol/cluster-195","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"group"},"412":{"id":"/docs/binary-protocol/cluster-196","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"Consensus group (see planes)"},"413":{"id":"/docs/binary-protocol/cluster-197","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"224"},"414":{"id":"/docs/binary-protocol/cluster-198","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"4"},"415":{"id":"/docs/binary-protocol/cluster-199","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"user_id"},"416":{"id":"/docs/binary-protocol/cluster-200","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"Authenticated user"},"417":{"id":"/docs/binary-protocol/cluster-201","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"228"},"418":{"id":"/docs/binary-protocol/cluster-202","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"28"},"419":{"id":"/docs/binary-protocol/cluster-203","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"reserved"},"420":{"id":"/docs/binary-protocol/cluster-204","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"Zero"},"421":{"id":"/docs/binary-protocol/cluster-205","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepare-6","content":"Metadata bodies contain the server-prepared payload, which may differ from the client request. For example, topic creation adds partition assignments before replication. For SendMessages it is the message batch as stamped by the primary at journal append (base_offset, base_timestamp, and the recomputed batch_checksum are final); each backup re-derives the expected stamp from its own position and refuses a mismatch. Replication is chain-form: the primary sends to (replica + 1) % replica_count, each backup forwards to its own successor, and disconnected peers are skipped. The chain stops before returning to the primary. RepairPrepare (19) is byte-identical to a journaled prepare with only the command byte rewritten."},"422":{"id":"/docs/binary-protocol/cluster-206","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#prepareok-7","content":"Header-only. parent (echo) at 128, prepare_checksum (echo of the prepare's identity) at 144, then op 160, commit 168, timestamp 176, request 184, operation 192, group 200. Two fields are the acker's own, not echoes: header view is the acking replica's view, and commit is its own commit point. Sent to the view's primary."},"423":{"id":"/docs/binary-protocol/cluster-207","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#commit-9","content":"Header-only broadcast; validation rejects size != 256. timestamp_monotonic at 144 is the liveness token (a receiver resets its heartbeat timer only on a strictly newer value), commit at 152 is the commit point, group at 168. Bytes 128..144 and 160..168 are declared (commit_checksum, checkpoint_op) but currently unused."},"424":{"id":"/docs/binary-protocol/cluster-208","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#view-changes","content":"StartViewChange (10): header-only, just group at 128. Broadcast when a replica suspects the primary."},"425":{"id":"/docs/binary-protocol/cluster-209","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#view-changes","content":"DoViewChange (11): op (highest op) 128, commit 136, group 144, log_view 152 (view when the sender was last in Normal status), nack_bitset 224 (bit i = \"I never prepared suffix entry i\"; truncation authority), present_bitset 240 (bit i = \"I can serve entry i's body\"). Body = the log suffix as up to 128 packed 256-byte PrepareHeaders, headers only. Broadcast."},"426":{"id":"/docs/binary-protocol/cluster-210","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#view-changes","content":"StartView (12): op 128, commit 136 (max over the DVC quorum), group 144, incarnation 240 (echo of a RequestStartView incarnation, zero when unsolicited). Body = the view's suffix as packed PrepareHeaders, highest op first; empty is legal. Unicast when answering a probe, broadcast otherwise."},"427":{"id":"/docs/binary-protocol/cluster-211","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#view-changes","content":"RequestStartView (17): header-only recovery probe with group 128 and incarnation 240. A restarted replica broadcasts it instead of trusting stale local state; only the current view's primary answers, with a targeted StartView."},"428":{"id":"/docs/binary-protocol/cluster-212","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#journal-repair","content":"A replica missing committed prepares (rejoin window or interior hole) pulls them from a Normal-status peer (the metadata plane also serves repair during a view change, so a forming primary cannot deadlock):"},"429":{"id":"/docs/binary-protocol/cluster-213","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#journal-repair","content":"RequestPrepares (18): nonce 128, from_op 144, to_op 152, group 160. from_op = 0 or from_op > to_op is rejected."},"430":{"id":"/docs/binary-protocol/cluster-214","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#journal-repair","content":"RepairPrepare (19): the journaled prepares, streamed in op order."},"431":{"id":"/docs/binary-protocol/cluster-215","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#journal-repair","content":"RepairDone (20) / RangeEvicted (21): one shared layout (nonce 128, op 144, group 152) under two command bytes. RepairDone.op = last op served; RangeEvicted.op = oldest op the peer still retains, the honest answer when the front of the range is gone."},"432":{"id":"/docs/binary-protocol/cluster-216","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#journal-repair","content":"Pacing is bounded by cluster.repair_chunk_max, which must stay below message_bus.peer_queue_capacity: per-peer send queues drop overruns silently."},"433":{"id":"/docs/binary-protocol/cluster-217","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"Bulk catch-up for a replica too far behind for journal repair. Pull-based and lockstep (at most one chunk in flight per artifact), because per-peer queues drop overruns:"},"434":{"id":"/docs/binary-protocol/cluster-218","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"RequestStateTransfer (22): nonce 128, group 144."},"435":{"id":"/docs/binary-protocol/cluster-219","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"StateTransferTarget (23): nonce 128, commit_op 144, group 152, available 160, unavailable_transient 161, commit_max 168. available = 0 is a header-only refusal. Body = the state manifest."},"436":{"id":"/docs/binary-protocol/cluster-220","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"RequestStateChunk (24): nonce 128, offset 144, group 152, len 160, artifact 164. len describes the reply and is clamped by the server."},"437":{"id":"/docs/binary-protocol/cluster-221","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"StateChunk (25): nonce 128, offset 144, group 152, artifact 160. Body = raw artifact bytes. Chunks carry no per-chunk integrity; each artifact is verified whole, by length and XxHash3-64, against its manifest entry."},"438":{"id":"/docs/binary-protocol/cluster-222","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"The manifest (little-endian):"},"439":{"id":"/docs/binary-protocol/cluster-223","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"At most 65536 entries. Entries longer than 25 bytes decode with the tail skipped (forward compatibility); shorter entries are rejected."},"440":{"id":"/docs/binary-protocol/cluster-224","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"Artifact kinds:"},"441":{"id":"/docs/binary-protocol/cluster-225","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"Kind"},"442":{"id":"/docs/binary-protocol/cluster-226","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"Artifact"},"443":{"id":"/docs/binary-protocol/cluster-227","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"Plane"},"444":{"id":"/docs/binary-protocol/cluster-228","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"Content"},"445":{"id":"/docs/binary-protocol/cluster-229","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"0"},"446":{"id":"/docs/binary-protocol/cluster-230","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"METADATA_SNAPSHOT"},"447":{"id":"/docs/binary-protocol/cluster-231","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"metadata"},"448":{"id":"/docs/binary-protocol/cluster-232","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"snapshot.bin verbatim (MessagePack, snapshot format version 5; readers accept versions 3 through 5); frontier = sequence number"},"449":{"id":"/docs/binary-protocol/cluster-233","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"1"},"450":{"id":"/docs/binary-protocol/cluster-234","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"CLIENT_TABLE"},"451":{"id":"/docs/binary-protocol/cluster-235","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"metadata"},"452":{"id":"/docs/binary-protocol/cluster-236","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"Client table encoding (magic ICT3, including dedup fences); readers also accept ICT2 without fences; frontier = mutation frontier"},"453":{"id":"/docs/binary-protocol/cluster-237","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"2"},"454":{"id":"/docs/binary-protocol/cluster-238","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"SEGMENT_LOG"},"455":{"id":"/docs/binary-protocol/cluster-239","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"partition"},"456":{"id":"/docs/binary-protocol/cluster-240","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"One retained segment's .log verbatim; frontier = segment base offset"},"457":{"id":"/docs/binary-protocol/cluster-241","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"3"},"458":{"id":"/docs/binary-protocol/cluster-242","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"CONSUMER_OFFSETS"},"459":{"id":"/docs/binary-protocol/cluster-243","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"partition"},"460":{"id":"/docs/binary-protocol/cluster-244","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#state-transfer","content":"ICO1 version 1: consumer/group offsets, purge generation, next message offset, dedup window, prepare-chain checksum and checkpoint prepare; frontier = offer's commit_op"},"461":{"id":"/docs/binary-protocol/cluster-245","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#session-forwarding","content":"A client may dial a backup; authentication happens there, and only the verified identity travels to the primary (login credentials never cross the replica plane):"},"462":{"id":"/docs/binary-protocol/cluster-246","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#session-forwarding","content":"ForwardRegister (26): client 128, nonce 144, user_id 160."},"463":{"id":"/docs/binary-protocol/cluster-247","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#session-forwarding","content":"ForwardRegisterResult (27): nonce 128, client 144, epoch 160, watermark 168, outcome byte at 255: 0 Ok, 1 NotPrimary, 2 NotCaughtUp (reserved), 3 PipelineFull, 4 InProgress, 5 Canceled, 6 ClientIdOwnedByAnotherUser. epoch and watermark must be zero on any non-Ok outcome."},"464":{"id":"/docs/binary-protocol/cluster-248","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#session-forwarding","content":"ForwardLogout (28): client 128, nonce 144, session 160, request 168."},"465":{"id":"/docs/binary-protocol/cluster-249","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#session-forwarding","content":"ForwardLogoutResult (29): nonce 128, client 144, commit 160, outcome at 255: 0 Ok, 1 NotPrimary, 2 PipelineFull, 3 InProgress, 4 Canceled."},"466":{"id":"/docs/binary-protocol/cluster-250","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#consensus-planes","content":"Two consensus planes share this one message set; there are no plane-specific commands. Routing is by the group: u64 field carried on every consensus header except the handshake and session-forwarding frames (those are implicitly metadata-plane):"},"467":{"id":"/docs/binary-protocol/cluster-251","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#consensus-planes","content":"group = 1 << 63 is the metadata plane (streams, topics, users, consumer groups; durable on-disk journal)."},"468":{"id":"/docs/binary-protocol/cluster-252","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#consensus-planes","content":"Any other value is a packed stream/topic/partition key: a partition plane group (message batches, consumer offsets). Completion and recovery depend on the independent message and offset durability policies."},"469":{"id":"/docs/binary-protocol/cluster-253","page_id":"/docs/binary-protocol/cluster","tags":[],"type":"text","url":"/docs/binary-protocol/cluster#consensus-planes","content":"Same wire, a few divergent semantics: partition-plane prepares leave checksum_body zero, with message integrity supplied by the batch's own checksums; their prepare identity covers the header alone, and StateTransferTarget.unavailable_transient / commit_max are read only by the partition arm."},"470":{"id":"/docs/binary-protocol/commands","page_id":"/docs/binary-protocol/commands","type":"page","content":"Commands","breadcrumbs":["Documentation","Binary Protocol"],"tags":[],"url":"/docs/binary-protocol/commands"},"471":{"id":"/docs/binary-protocol/commands-0","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands","content":"The catalog of command codes, their operation bytes, and which commands are replicated."},"472":{"id":"/docs/binary-protocol/commands-1","page_id":"/docs/binary-protocol/commands","type":"heading","tags":[],"url":"/docs/binary-protocol/commands#catalog","content":"Catalog"},"473":{"id":"/docs/binary-protocol/commands-2","page_id":"/docs/binary-protocol/commands","type":"heading","tags":[],"url":"/docs/binary-protocol/commands#payloads","content":"Payloads"},"474":{"id":"/docs/binary-protocol/commands-3","page_id":"/docs/binary-protocol/commands","type":"heading","tags":[],"url":"/docs/binary-protocol/commands#system","content":"System"},"475":{"id":"/docs/binary-protocol/commands-4","page_id":"/docs/binary-protocol/commands","type":"heading","tags":[],"url":"/docs/binary-protocol/commands#streams","content":"Streams"},"476":{"id":"/docs/binary-protocol/commands-5","page_id":"/docs/binary-protocol/commands","type":"heading","tags":[],"url":"/docs/binary-protocol/commands#topics","content":"Topics"},"477":{"id":"/docs/binary-protocol/commands-6","page_id":"/docs/binary-protocol/commands","type":"heading","tags":[],"url":"/docs/binary-protocol/commands#partitions","content":"Partitions"},"478":{"id":"/docs/binary-protocol/commands-7","page_id":"/docs/binary-protocol/commands","type":"heading","tags":[],"url":"/docs/binary-protocol/commands#segments","content":"Segments"},"479":{"id":"/docs/binary-protocol/commands-8","page_id":"/docs/binary-protocol/commands","type":"heading","tags":[],"url":"/docs/binary-protocol/commands#messages","content":"Messages"},"480":{"id":"/docs/binary-protocol/commands-9","page_id":"/docs/binary-protocol/commands","type":"heading","tags":[],"url":"/docs/binary-protocol/commands#consumer-offsets","content":"Consumer offsets"},"481":{"id":"/docs/binary-protocol/commands-10","page_id":"/docs/binary-protocol/commands","type":"heading","tags":[],"url":"/docs/binary-protocol/commands#consumer-groups","content":"Consumer groups"},"482":{"id":"/docs/binary-protocol/commands-11","page_id":"/docs/binary-protocol/commands","type":"heading","tags":[],"url":"/docs/binary-protocol/commands#users","content":"Users"},"483":{"id":"/docs/binary-protocol/commands-12","page_id":"/docs/binary-protocol/commands","type":"heading","tags":[],"url":"/docs/binary-protocol/commands#authentication","content":"Authentication"},"484":{"id":"/docs/binary-protocol/commands-13","page_id":"/docs/binary-protocol/commands","type":"heading","tags":[],"url":"/docs/binary-protocol/commands#personal-access-tokens","content":"Personal access tokens"},"485":{"id":"/docs/binary-protocol/commands-14","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#catalog","content":"The u32 command codes. Replicated commands are identified on the wire by their operation byte (see Operation discriminants). The code column below is the protocol-level registry and, for non-replicated commands, the value carried in header bytes 196..200."},"486":{"id":"/docs/binary-protocol/commands-15","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#catalog","content":"FLUSH_UNSAVED_BUFFER still decodes on the wire, but the server has no on-demand flush primitive and answers every call with FeatureUnavailable. Per-topic message completion is configured with the durability topic option."},"487":{"id":"/docs/binary-protocol/commands-16","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#payloads","content":"Payloads below are the request body (the bytes after the 256-byte header). Types reference the shared encodings. Empty payload means the body has zero bytes."},"488":{"id":"/docs/binary-protocol/commands-17","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"Ping. Code: 1. Empty payload. The only command accepted before login."},"489":{"id":"/docs/binary-protocol/commands-18","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"Get stats. Code: 10. Empty payload."},"490":{"id":"/docs/binary-protocol/commands-19","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"Get snapshot. Code: 11."},"491":{"id":"/docs/binary-protocol/commands-20","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"Compression codes: 1 = Stored, 2 = Deflated, 3 = Bzip2, 4 = Zstd, 5 = Lzma, 6 = Xz. Snapshot type codes: 1 = FilesystemOverview, 2 = ProcessList, 3 = ResourceUsage, 4 = Test, 5 = ServerLogs, 6 = ServerConfig, 100 = All."},"492":{"id":"/docs/binary-protocol/commands-21","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"Get cluster metadata. Code: 12. Empty payload."},"493":{"id":"/docs/binary-protocol/commands-22","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"Describe options. Code: 13."},"494":{"id":"/docs/binary-protocol/commands-23","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"Scope: 1 = topic, 2 = stream, 3 = user. Returns the option catalog for the scope: keys, value kinds, defaults, and descriptions. See Options block."},"495":{"id":"/docs/binary-protocol/commands-24","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"Get me. Code: 20. Empty payload."},"496":{"id":"/docs/binary-protocol/commands-25","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"Get client. Code: 21."},"497":{"id":"/docs/binary-protocol/commands-26","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#system","content":"Get clients. Code: 22. Empty payload."},"498":{"id":"/docs/binary-protocol/commands-27","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#streams","content":"Get stream. Code: 200."},"499":{"id":"/docs/binary-protocol/commands-28","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#streams","content":"Get streams. Code: 201. Empty payload."},"500":{"id":"/docs/binary-protocol/commands-29","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#streams","content":"Create stream. Code: 202."},"501":{"id":"/docs/binary-protocol/commands-30","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#streams","content":"The stream option catalog is empty, so the block is normally empty (zero bytes)."},"502":{"id":"/docs/binary-protocol/commands-31","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#streams","content":"Delete stream. Code: 203."},"503":{"id":"/docs/binary-protocol/commands-32","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#streams","content":"Update stream. Code: 204."},"504":{"id":"/docs/binary-protocol/commands-33","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#streams","content":"Patch semantics: absent option keys are left unchanged."},"505":{"id":"/docs/binary-protocol/commands-34","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#streams","content":"Purge stream. Code: 205."},"506":{"id":"/docs/binary-protocol/commands-35","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#topics","content":"Get topic. Code: 300."},"507":{"id":"/docs/binary-protocol/commands-36","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#topics","content":"Get topics. Code: 301."},"508":{"id":"/docs/binary-protocol/commands-37","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#topics","content":"Create topic. Code: 302."},"509":{"id":"/docs/binary-protocol/commands-38","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#topics","content":"The fixed fields are the shape of the operation: which stream, how many partitions, what name. Every topic setting (compression_algorithm, message_expiry, max_topic_size, segment_size, durability, consumer_offset_durability, messages_required_to_save, size_of_messages_required_to_save, preallocate_segments) rides the options block. See Topic options. partitions_count is an argument, not a setting: it is consumed at admission and never persisted as an option."},"510":{"id":"/docs/binary-protocol/commands-39","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#topics","content":"Delete topic. Code: 303."},"511":{"id":"/docs/binary-protocol/commands-40","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#topics","content":"Update topic. Code: 304."},"512":{"id":"/docs/binary-protocol/commands-41","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#topics","content":"Only compression_algorithm, message_expiry, and max_topic_size are updatable. Absent keys are left unchanged."},"513":{"id":"/docs/binary-protocol/commands-42","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#topics","content":"Purge topic. Code: 305."},"514":{"id":"/docs/binary-protocol/commands-43","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#partitions","content":"Create partitions. Code: 402."},"515":{"id":"/docs/binary-protocol/commands-44","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#partitions","content":"Delete partitions. Code: 403."},"516":{"id":"/docs/binary-protocol/commands-45","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#segments","content":"Delete segments. Code: 503."},"517":{"id":"/docs/binary-protocol/commands-46","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#segments","content":"Deletes up to segments_count oldest sealed segments of the partition. The active segment is retained."},"518":{"id":"/docs/binary-protocol/commands-47","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#messages","content":"Poll messages. Code: 100."},"519":{"id":"/docs/binary-protocol/commands-48","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#messages","content":"strategy is a polling strategy. count is the requested number of messages. auto_commit = 1 asks the server to advance the consumer offset. A primary submits a quorum offset write before replying, but the poll does not wait for that write to commit. A follower-served poll does not advance the durable offset. See Client failover."},"520":{"id":"/docs/binary-protocol/commands-49","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#messages","content":"The response body:"},"521":{"id":"/docs/binary-protocol/commands-50","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#messages","content":"The 16-byte prefix is followed by a stream of batch records: each record's header carries the stamped base_offset and base_timestamp, and each frame's deltas resolve against them. A record may be a server-sliced view of a larger stored batch, so the first polled offset is base_offset + offset_delta of the first frame, not necessarily base_offset itself. current_offset is the partition's newest offset at poll time. The server rebuilds records when decrypting encrypted payloads."},"522":{"id":"/docs/binary-protocol/commands-51","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#messages","content":"Send messages. Code: 101."},"523":{"id":"/docs/binary-protocol/commands-52","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#messages","content":"metadata_length counts the bytes from stream_id through messages_count inclusive, so a reader can skip straight to the batch. The producer leaves partition_id, base_offset, and base_timestamp zero in the batch header, and the server stamps them. Every checksum is producer-computed and verified at admission. The reserved regions must be zero."},"524":{"id":"/docs/binary-protocol/commands-53","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#messages","content":"A committed append returns offset confirmations without a metadata result section:"},"525":{"id":"/docs/binary-protocol/commands-54","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#messages","content":"Each confirmation is 20 bytes. The server reports one partition per append. A zero count or an empty successful body supplies no offset information; deduplicated requests receive an empty body. Retry coverage is bounded, and crash durability depends on the topic's durability policy."},"526":{"id":"/docs/binary-protocol/commands-55","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#messages","content":"Flush unsaved buffer. Code: 102."},"527":{"id":"/docs/binary-protocol/commands-56","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#messages","content":"Parses, but the server always answers FeatureUnavailable: there is no on-demand flush primitive. Select durability=persisted at topic creation to require recoverable stable-storage copies before successful message completion."},"528":{"id":"/docs/binary-protocol/commands-57","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"Get consumer offset. Code: 120."},"529":{"id":"/docs/binary-protocol/commands-58","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"When an offset is stored, the response body is 20 bytes. When none is stored, a successful reply has an empty body."},"530":{"id":"/docs/binary-protocol/commands-59","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"Store consumer offset. Code: 121."},"531":{"id":"/docs/binary-protocol/commands-60","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"Delete consumer offset. Code: 122."},"532":{"id":"/docs/binary-protocol/commands-61","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"The trailing ack byte is mandatory on both write commands. A payload without it fails to decode. Ack levels:"},"533":{"id":"/docs/binary-protocol/commands-62","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"Value"},"534":{"id":"/docs/binary-protocol/commands-63","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"Level"},"535":{"id":"/docs/binary-protocol/commands-64","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"Meaning"},"536":{"id":"/docs/binary-protocol/commands-65","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"0"},"537":{"id":"/docs/binary-protocol/commands-66","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"NoAck"},"538":{"id":"/docs/binary-protocol/commands-67","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"Local write on a single-replica partition; replicated partitions use the same consensus path as Quorum"},"539":{"id":"/docs/binary-protocol/commands-68","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"1"},"540":{"id":"/docs/binary-protocol/commands-69","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"Quorum"},"541":{"id":"/docs/binary-protocol/commands-70","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-offsets","content":"Replicate through partition consensus; respond after a quorum commit (default for explicit writes)"},"542":{"id":"/docs/binary-protocol/commands-71","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-groups","content":"Get consumer group. Code: 600."},"543":{"id":"/docs/binary-protocol/commands-72","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-groups","content":"Get consumer groups. Code: 601."},"544":{"id":"/docs/binary-protocol/commands-73","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-groups","content":"Create consumer group. Code: 602."},"545":{"id":"/docs/binary-protocol/commands-74","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-groups","content":"Delete consumer group. Code: 603."},"546":{"id":"/docs/binary-protocol/commands-75","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","url":"/docs/binary-protocol/commands#consumer-groups","content":"Join consumer group. Code: 604."},"547":{"id":"/docs/binary-protocol/commands-76","page_id":"/docs/binary-protocol/commands","tags":[],"type":"text","ur