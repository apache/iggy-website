"/docs/connectors/sinks/postgres#plugin-config-options","content":"max_retries"},"6097":{"id":"/docs/connectors/sinks/postgres-66","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"u32"},"6098":{"id":"/docs/connectors/sinks/postgres-67","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"3"},"6099":{"id":"/docs/connectors/sinks/postgres-68","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"Total attempts per transiently failing insert, including the first. 0 and 1 both allow one attempt"},"6100":{"id":"/docs/connectors/sinks/postgres-69","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"retry_delay"},"6101":{"id":"/docs/connectors/sinks/postgres-70","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"string"},"6102":{"id":"/docs/connectors/sinks/postgres-71","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"\"1s\""},"6103":{"id":"/docs/connectors/sinks/postgres-72","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#plugin-config-options","content":"Base for linear retry delays. Invalid values silently fall back to 1s"},"6104":{"id":"/docs/connectors/sinks/postgres-73","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"The payload_format option determines the type of the payload column and how the message payload is stored:"},"6105":{"id":"/docs/connectors/sinks/postgres-74","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"Format"},"6106":{"id":"/docs/connectors/sinks/postgres-75","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"Column Type"},"6107":{"id":"/docs/connectors/sinks/postgres-76","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"Description"},"6108":{"id":"/docs/connectors/sinks/postgres-77","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"bytea"},"6109":{"id":"/docs/connectors/sinks/postgres-78","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"BYTEA"},"6110":{"id":"/docs/connectors/sinks/postgres-79","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"Bytes after stream decoding and transforms (default). Use schema = \"raw\" and no payload-changing transform to preserve original bytes."},"6111":{"id":"/docs/connectors/sinks/postgres-80","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"json / jsonb"},"6112":{"id":"/docs/connectors/sinks/postgres-81","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"JSONB"},"6113":{"id":"/docs/connectors/sinks/postgres-82","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"Native JSON. Enables JSON operators and GIN indexing. Payload must be valid JSON accepted by PostgreSQL JSONB."},"6114":{"id":"/docs/connectors/sinks/postgres-83","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"text"},"6115":{"id":"/docs/connectors/sinks/postgres-84","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"TEXT"},"6116":{"id":"/docs/connectors/sinks/postgres-85","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"UTF-8 text. Payload must be valid UTF-8 accepted by PostgreSQL TEXT."},"6117":{"id":"/docs/connectors/sinks/postgres-86","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"Format names are case-insensitive. Unrecognized names silently use bytea. JSONB accepts objects, arrays and scalars, but PostgreSQL rejects \\u0000 in JSONB and zero bytes in TEXT. JSON decoding and JSONB storage can change the original representation. Message headers are not stored. See PostgreSQL JSON types for JSONB restrictions."},"6118":{"id":"/docs/connectors/sinks/postgres-87","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#payload-format","content":"With the default bytea format, valid UTF-8 JSON payloads can still be queried by converting the bytes: convert_from(payload, 'UTF8')::jsonb->>'user_id'. With json, the native operators apply directly: payload->>'user_id'."},"6119":{"id":"/docs/connectors/sinks/postgres-88","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#table-schema","content":"With auto_create_table = true and all three metadata flags enabled, the connector creates the following structure if the table is absent. The payload column type follows payload_format:"},"6120":{"id":"/docs/connectors/sinks/postgres-89","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#table-schema","content":"Disabling include_metadata omits the five offset/timestamp/stream/topic/partition columns. Checksum and origin timestamp flags work independently. id, payload and created_at are always created. With auto_create_table = false, provision a compatible table yourself. Startup does not check its existence or schema."},"6121":{"id":"/docs/connectors/sinks/postgres-90","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#table-schema","content":"id stores the full unsigned 128-bit message ID as a decimal, without stream, topic, partition or offset in the key. Offset and checksum values are cast to signed 64-bit integers, and partition IDs to signed 32-bit integers. Values above those signed ranges appear negative. Message and origin timestamps are interpreted as Unix microseconds. Zero becomes the Unix epoch. A timestamp outside the date library's range falls back to the current time. created_at is generated by PostgreSQL when inserting."},"6122":{"id":"/docs/connectors/sinks/postgres-91","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#querying-the-data","content":"Run these queries with docker exec -it iggy-postgres psql -U iggy -d iggy, or your PostgreSQL client:"},"6123":{"id":"/docs/connectors/sinks/postgres-92","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#querying-the-data","content":"For a JSONB query example, a TEXT search example, and recommended indexes, see the upstream postgres_sink README."},"6124":{"id":"/docs/connectors/sinks/postgres-93","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#delivery-semantics","content":"Each poll is split into chunks of at most batch_size messages. One multi-row INSERT writes each chunk. A duplicate primary key, incompatible table, invalid payload or other terminal error rejects that chunk. Later chunks are still attempted. The plugin logs failures, increments its private insertion-error count by the failed chunk size, and returns success after attempting all chunks. Both its processed count and runtime's processed count can therefore include messages that were never stored. Runtime error counts do not expose these insert failures."},"6125":{"id":"/docs/connectors/sinks/postgres-94","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#delivery-semantics","content":"Transient insert failures are retried within the chunk. max_retries counts total attempts, and waits grow linearly as retry_delay, twice that delay, and so on. Retried SQLSTATEs are 40001, 40P01, 57P01, 57P02, 57P03, 08000, 08003 and 08006. SQLx I/O and pool-acquisition timeouts are also retried. Other errors stop that chunk's retry loop. Startup has no plugin retry loop."},"6126":{"id":"/docs/connectors/sinks/postgres-95","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#delivery-semantics","content":"The sink uses plain INSERT, with no conflict-ignore or upsert clause. Reusing an ID already in the table rejects the entire chunk, including any new IDs alongside it. There is no transaction covering the complete poll. The runtime auto-commits while polling and does not replay failed chunks. A connection failure can leave the write outcome uncertain. These retries do not provide an end-to-end at-least-once guarantee."},"6127":{"id":"/docs/connectors/sinks/postgres-96","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#performance-considerations","content":"Use an appropriate batch_size for your workload (larger batches give better throughput)"},"6128":{"id":"/docs/connectors/sinks/postgres-97","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#performance-considerations","content":"Create indexes on frequently queried columns (iggy_stream, iggy_topic, created_at)"},"6129":{"id":"/docs/connectors/sinks/postgres-98","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#performance-considerations","content":"Set the pool limit with max_connections. It does not report pool usage"},"6130":{"id":"/docs/connectors/sinks/postgres-99","page_id":"/docs/connectors/sinks/postgres","tags":[],"type":"text","url":"/docs/connectors/sinks/postgres#performance-considerations","content":"Keep each actual chunk within PostgreSQL's 65,535 query-parameter limit. Each row binds 2 + 5 * include_metadata + include_checksum + include_origin_timestamp parameters, so the default flags allow at most 7,281 rows per statement. Larger chunks are rejected by SQLx. batch_length also limits how many rows reach a poll."},"6131":{"id":"/docs/connectors/sinks/quickwit","page_id":"/docs/connectors/sinks/quickwit","type":"page","content":"Quickwit Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/quickwit"},"6132":{"id":"/docs/connectors/sinks/quickwit-0","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit","content":"Send messages from Iggy streams to a Quickwit index over HTTP, creating the index when it does not exist."},"6133":{"id":"/docs/connectors/sinks/quickwit-1","page_id":"/docs/connectors/sinks/quickwit","type":"heading","tags":[],"url":"/docs/connectors/sinks/quickwit#configuration","content":"Configuration"},"6134":{"id":"/docs/connectors/sinks/quickwit-2","page_id":"/docs/connectors/sinks/quickwit","type":"heading","tags":[],"url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Plugin config options"},"6135":{"id":"/docs/connectors/sinks/quickwit-3","page_id":"/docs/connectors/sinks/quickwit","type":"heading","tags":[],"url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"Payload Shapes"},"6136":{"id":"/docs/connectors/sinks/quickwit-4","page_id":"/docs/connectors/sinks/quickwit","type":"heading","tags":[],"url":"/docs/connectors/sinks/quickwit#delivery-semantics","content":"Delivery Semantics"},"6137":{"id":"/docs/connectors/sinks/quickwit-5","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit","content":"The Quickwit connector allows you to send data to the Quickwit API using HTTP. At startup it checks readiness, creates a missing index, and appends messages as newline-delimited JSON (NDJSON). Each poll can become multiple requests, each limited to 8 MiB including document newlines."},"6138":{"id":"/docs/connectors/sinks/quickwit-6","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.10.0 Iggy checkout root, build the plugin:"},"6139":{"id":"/docs/connectors/sinks/quickwit-7","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"For a local Quickwit instance with support for the example's 0.9 index configuration:"},"6140":{"id":"/docs/connectors/sinks/quickwit-8","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"Wait for readiness, then save this connector file in the runtime's connector directory. index is a YAML string following the Quickwit index configuration format. Use a format version supported by your Quickwit server. The sink sends this YAML when creating a missing index. It does not update or compare an existing index's mapping."},"6141":{"id":"/docs/connectors/sinks/quickwit-9","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"Create the Iggy resources and send a document that matches the strict mapping:"},"6142":{"id":"/docs/connectors/sinks/quickwit-10","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"Indexing happens asynchronously. Search after the split has committed:"},"6143":{"id":"/docs/connectors/sinks/quickwit-11","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#configuration","content":"commit_timeout_secs = 10 requests a time-based commit. It is not a ten-second delivery deadline. Retention uses the document's timestamp field. The example requests seven-day retention checked daily. The timestamp mapping accepts Unix timestamps and formats search results as nanoseconds, with millisecond fast-field precision."},"6144":{"id":"/docs/connectors/sinks/quickwit-12","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Option"},"6145":{"id":"/docs/connectors/sinks/quickwit-13","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Default"},"6146":{"id":"/docs/connectors/sinks/quickwit-14","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Description"},"6147":{"id":"/docs/connectors/sinks/quickwit-15","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"url"},"6148":{"id":"/docs/connectors/sinks/quickwit-16","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"required"},"6149":{"id":"/docs/connectors/sinks/quickwit-17","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"HTTP(S) base URL with a host. Path prefixes/trailing slashes work, query strings and fragments are rejected"},"6150":{"id":"/docs/connectors/sinks/quickwit-18","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"index"},"6151":{"id":"/docs/connectors/sinks/quickwit-19","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"required"},"6152":{"id":"/docs/connectors/sinks/quickwit-20","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"YAML index configuration containing a nonempty index_id"},"6153":{"id":"/docs/connectors/sinks/quickwit-21","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"verbose_logging"},"6154":{"id":"/docs/connectors/sinks/quickwit-22","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"false"},"6155":{"id":"/docs/connectors/sinks/quickwit-23","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Log received/submitted document counts at info instead of debug"},"6156":{"id":"/docs/connectors/sinks/quickwit-24","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"max_retries"},"6157":{"id":"/docs/connectors/sinks/quickwit-25","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"3"},"6158":{"id":"/docs/connectors/sinks/quickwit-26","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Total HTTP attempts including the first. 0 and 1 both allow one attempt"},"6159":{"id":"/docs/connectors/sinks/quickwit-27","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"retry_delay"},"6160":{"id":"/docs/connectors/sinks/quickwit-28","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"\"1s\""},"6161":{"id":"/docs/connectors/sinks/quickwit-29","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Base exponential delay for HTTP retries and readiness probes"},"6162":{"id":"/docs/connectors/sinks/quickwit-30","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"retry_max_delay"},"6163":{"id":"/docs/connectors/sinks/quickwit-31","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"\"5s\""},"6164":{"id":"/docs/connectors/sinks/quickwit-32","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Cap for calculated HTTP retry delays. A valid Retry-After on HTTP 429 overrides it"},"6165":{"id":"/docs/connectors/sinks/quickwit-33","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"max_open_retries"},"6166":{"id":"/docs/connectors/sinks/quickwit-34","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"10"},"6167":{"id":"/docs/connectors/sinks/quickwit-35","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Total attempts per readiness check including the first. 0 and 1 both allow one attempt"},"6168":{"id":"/docs/connectors/sinks/quickwit-36","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"open_retry_max_delay"},"6169":{"id":"/docs/connectors/sinks/quickwit-37","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"\"30s\""},"6170":{"id":"/docs/connectors/sinks/quickwit-38","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Cap for calculated readiness retry delays"},"6171":{"id":"/docs/connectors/sinks/quickwit-39","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"timeout"},"6172":{"id":"/docs/connectors/sinks/quickwit-40","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"\"30s\""},"6173":{"id":"/docs/connectors/sinks/quickwit-41","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Timeout per HTTP attempt. Retries and their waits can make an operation take longer"},"6174":{"id":"/docs/connectors/sinks/quickwit-42","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Durations require units and must be positive. Invalid or zero durations prevent startup. Unknown plugin keys are rejected. There is no plugin batch_size option: batch_length limits the polled batch, and the sink splits it by serialized byte size without accumulating across polls."},"6175":{"id":"/docs/connectors/sinks/quickwit-43","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Readiness uses GET /health/readyz, retrying any failed probe. The index check uses GET /api/v1/indexes/<index_id>. Only a 404 triggers creation with POST /api/v1/indexes. If creation receives an error status, a successful index recheck allows startup to continue. A successful existence check does not validate the supplied mapping against the existing one. Requests retain any path prefix from url."},"6176":{"id":"/docs/connectors/sinks/quickwit-44","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"After verifying or creating the index, the sink probes the ingest endpoint with an empty body before accepting messages. This waits for the queue on Quickwit versions that return 404 while it starts. These probes submit no documents and retry HTTP 404, 429, 5xx and network failures. Each readiness check uses max_open_retries and open_retry_max_delay."},"6177":{"id":"/docs/connectors/sinks/quickwit-45","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"The sink does not add Iggy IDs, offsets, timestamps or headers. It serializes the payload after runtime decoding and transforms:"},"6178":{"id":"/docs/connectors/sinks/quickwit-46","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"Payload"},"6179":{"id":"/docs/connectors/sinks/quickwit-47","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"Document sent to Quickwit"},"6180":{"id":"/docs/connectors/sinks/quickwit-48","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"JSON object, or a JSON object parsed from raw bytes"},"6181":{"id":"/docs/connectors/sinks/quickwit-49","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"The object itself"},"6182":{"id":"/docs/connectors/sinks/quickwit-50","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"JSON array or scalar"},"6183":{"id":"/docs/connectors/sinks/quickwit-51","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"{\"data\":[1,2],\"data_type\":\"json\"} or {\"data\":42,\"data_type\":\"json\"}"},"6184":{"id":"/docs/connectors/sinks/quickwit-52","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"Other raw UTF-8"},"6185":{"id":"/docs/connectors/sinks/quickwit-53","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"{\"data\":\"hello\",\"data_type\":\"raw\",\"data_encoding\":\"utf8\"}"},"6186":{"id":"/docs/connectors/sinks/quickwit-54","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"Raw non-UTF-8 bytes"},"6187":{"id":"/docs/connectors/sinks/quickwit-55","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"Base64 under data, with data_type = \"raw\" and data_encoding = \"base64\""},"6188":{"id":"/docs/connectors/sinks/quickwit-56","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"Text"},"6189":{"id":"/docs/connectors/sinks/quickwit-57","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"{\"text\":\"hello\",\"data_type\":\"text\"}"},"6190":{"id":"/docs/connectors/sinks/quickwit-58","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"Raw arrays, scalars and malformed JSON retain their original bytes in the raw wrapper. Avro and FlatBuffer payload variants use that raw path. Proto uses the text wrapper. Which variant arrives depends on the runtime decoder and transforms."},"6191":{"id":"/docs/connectors/sinks/quickwit-59","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"The strict mapping above accepts only mapped fields and requires timestamp. To use wrapper documents, map their fields or use mode: dynamic, and remove timestamp_field and its dependent retention section unless every document supplies a timestamp. The add_fields transform enriches JSON objects. It does not add timestamps to raw/text wrappers created later by this sink."},"6192":{"id":"/docs/connectors/sinks/quickwit-60","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#delivery-semantics","content":"The sink calls POST /api/v1/<index_id>/ingest?commit=auto. HTTP success means submission for indexing, not search visibility or acceptance of every document. The sink checks the status and does not inspect per-document rejection counts in the response. See the Quickwit ingest API."},"6193":{"id":"/docs/connectors/sinks/quickwit-61","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#delivery-semantics","content":"HTTP 429, 5xx and network failures can retry. Calculated waits use exponential backoff with jitter and the configured cap. A valid Retry-After on 429 replaces that wait. Other HTTP statuses stop that request's retry loop. Readiness has its separate attempt budget. There is no circuit breaker or sink deduplication key, so retrying an accepted request can produce duplicates. max_retries = 1 disables the sink's HTTP retry loop."},"6194":{"id":"/docs/connectors/sinks/quickwit-62","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#delivery-semantics","content":"An individual serialized document exceeding 8 MiB, including its newline, is logged and skipped. Other documents and later chunks are still attempted, and the last error is returned. Successful chunks are not rolled back. The runtime logs/counts plugin callback errors and continues without replaying the failed batch. It auto-commits while polling. A failed callback can therefore coexist with stored documents, and a successful callback can include documents rejected by Quickwit. Runtime processed counts do not prove successful indexing. The sink provides no end-to-end at-least-once guarantee."},"6195":{"id":"/docs/connectors/sinks/rabbitmq","page_id":"/docs/connectors/sinks/rabbitmq","type":"page","content":"RabbitMQ","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/rabbitmq"},"6196":{"id":"/docs/connectors/sinks/rabbitmq-0","page_id":"/docs/connectors/sinks/rabbitmq","tags":[],"type":"text","url":"/docs/connectors/sinks/rabbitmq","content":"Send Iggy messages to RabbitMQ with the connector runtime."},"6197":{"id":"/docs/connectors/sinks/rabbitmq-1","page_id":"/docs/connectors/sinks/rabbitmq","type":"heading","tags":[],"url":"/docs/connectors/sinks/rabbitmq#configuration","content":"Configuration"},"6198":{"id":"/docs/connectors/sinks/rabbitmq-2","page_id":"/docs/connectors/sinks/rabbitmq","type":"heading","tags":[],"url":"/docs/connectors/sinks/rabbitmq#headers-and-failure-handling","content":"Headers and failure handling"},"6199":{"id":"/docs/connectors/sinks/rabbitmq-3","page_id":"/docs/connectors/sinks/rabbitmq","tags":[],"type":"text","url":"/docs/connectors/sinks/rabbitmq","content":"The RabbitMQ sink publishes messages to an AMQP 0.9.1 exchange. It declares the configured exchange, enables publisher confirmations and uses mandatory publishing. Configure a queue and binding that match the routing key before sending messages."},"6200":{"id":"/docs/connectors/sinks/rabbitmq-4","page_id":"/docs/connectors/sinks/rabbitmq","tags":[],"type":"text","url":"/docs/connectors/sinks/rabbitmq#configuration","content":"Use the sink runtime setup and build iggy_connector_rabbitmq_sink. Its plugin configuration is:"},"6201":{"id":"/docs/connectors/sinks/rabbitmq-5","page_id":"/docs/connectors/sinks/rabbitmq","tags":[],"type":"text","url":"/docs/connectors/sinks/rabbitmq#configuration","content":"Use the guest credentials only with a local broker. Exchange type accepts direct, topic, fanout or headers. Exchange durability must match an existing exchange. Delivery mode accepts persistent or non_persistent. Durable delivery also depends on the broker and queue configuration."},"6202":{"id":"/docs/connectors/sinks/rabbitmq-6","page_id":"/docs/connectors/sinks/rabbitmq","tags":[],"type":"text","url":"/docs/connectors/sinks/rabbitmq#headers-and-failure-handling","content":"User headers are preserved. With metadata enabled, the sink also adds iggy_stream, iggy_topic, iggy_partition_id and iggy_offset. String headers become AMQP LongString and raw headers become ByteArray."},"6203":{"id":"/docs/connectors/sinks/rabbitmq-7","page_id":"/docs/connectors/sinks/rabbitmq","tags":[],"type":"text","url":"/docs/connectors/sinks/rabbitmq#headers-and-failure-handling","content":"The sink pipelines publishes and waits for confirmations. Transient failures retry from the first unconfirmed message. An in-flight tail can already be delivered, so retries can duplicate it. An unroutable mandatory publish fails the batch and forces a new connection before the next poll."},"6204":{"id":"/docs/connectors/sinks/rabbitmq-8","page_id":"/docs/connectors/sinks/rabbitmq","tags":[],"type":"text","url":"/docs/connectors/sinks/rabbitmq#headers-and-failure-handling","content":"The runtime commits Iggy offsets on read and does not replay a failed callback after its retry budget. Publisher confirmations do not provide an end-to-end exactly-once guarantee. See the source reference."},"6205":{"id":"/docs/connectors/sinks/redshift","page_id":"/docs/connectors/sinks/redshift","type":"page","content":"Redshift","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/redshift"},"6206":{"id":"/docs/connectors/sinks/redshift-0","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift","content":"Send Iggy messages to Redshift with the connector runtime."},"6207":{"id":"/docs/connectors/sinks/redshift-1","page_id":"/docs/connectors/sinks/redshift","type":"heading","tags":[],"url":"/docs/connectors/sinks/redshift#configuration","content":"Configuration"},"6208":{"id":"/docs/connectors/sinks/redshift-2","page_id":"/docs/connectors/sinks/redshift","type":"heading","tags":[],"url":"/docs/connectors/sinks/redshift#payloads-and-delivery","content":"Payloads and delivery"},"6209":{"id":"/docs/connectors/sinks/redshift-3","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift","content":"The Redshift sink serializes batches to Parquet, stages them in S3 and loads an existing Redshift table with COPY. Configure both the Redshift connection and S3 access before starting the runtime."},"6210":{"id":"/docs/connectors/sinks/redshift-4","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"Use the sink runtime setup and build iggy_connector_redshift_sink. The plugin requires connection_string, target_table, aws_iam_role, s3_bucket, s3_prefix and aws_region. Supply S3 credentials through the supported credential configuration for your deployment."},"6211":{"id":"/docs/connectors/sinks/redshift-5","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"Setting"},"6212":{"id":"/docs/connectors/sinks/redshift-6","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"Default"},"6213":{"id":"/docs/connectors/sinks/redshift-7","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"Purpose"},"6214":{"id":"/docs/connectors/sinks/redshift-8","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"batch_size"},"6215":{"id":"/docs/connectors/sinks/redshift-9","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"100"},"6216":{"id":"/docs/connectors/sinks/redshift-10","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"Messages buffered per Parquet file and COPY operation"},"6217":{"id":"/docs/connectors/sinks/redshift-11","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"max_connections"},"6218":{"id":"/docs/connectors/sinks/redshift-12","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"5"},"6219":{"id":"/docs/connectors/sinks/redshift-13","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"Redshift connection pool size"},"6220":{"id":"/docs/connectors/sinks/redshift-14","page_id":"/docs/connectors/sinks/redshift","tags":[],"type":"text","url":"/docs/connectors/sinks/redshift#configuration","content":"include_metadata"},"6221":{"id":"/docs/connec