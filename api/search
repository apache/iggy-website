cs/server/configuration-392","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#data_maintenancemessages","content":"Run the segment cleaner. It deletes the oldest sealed segments of topics with a finite message_expiry or max_topic_size, per partition, best-effort. The active segment is never touched."},"2963":{"id":"/docs/server/configuration-393","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#data_maintenancemessages","content":"interval"},"2964":{"id":"/docs/server/configuration-394","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#data_maintenancemessages","content":"\"1 m\""},"2965":{"id":"/docs/server/configuration-395","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#data_maintenancemessages","content":"Cleaner run interval."},"2966":{"id":"/docs/server/configuration-396","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"Key"},"2967":{"id":"/docs/server/configuration-397","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"Default"},"2968":{"id":"/docs/server/configuration-398","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"Description"},"2969":{"id":"/docs/server/configuration-399","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"enabled"},"2970":{"id":"/docs/server/configuration-400","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"true"},"2971":{"id":"/docs/server/configuration-401","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"Verify client heartbeats."},"2972":{"id":"/docs/server/configuration-402","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"interval"},"2973":{"id":"/docs/server/configuration-403","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"\"30 s\""},"2974":{"id":"/docs/server/configuration-404","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"Expected heartbeat interval."},"2975":{"id":"/docs/server/configuration-405","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"When enabled, a connection that sends nothing (no request, no PING) for 1.2 x interval (36 s at the default) and still holds a consumer group membership has its session released, so its groups rebalance off it. A connection holding no membership is left alone and reaped when its socket closes."},"2976":{"id":"/docs/server/configuration-406","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#heartbeat","content":"The Rust, Go, Python, Node, and async Java SDKs ping automatically every 5 s, well inside the staleness window, but only from a connected high-level client: the Rust and async Java pingers are armed by connect(), so a session that logs in without it never pings. The blocking Java and C# SDKs have no automatic heartbeat, only a manual ping. Wherever nothing pings, an idle consumer group member is evicted, and only the application can keep it alive (ping) or bring it back (reconnect)."},"2977":{"id":"/docs/server/configuration-407","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content":"Key"},"2978":{"id":"/docs/server/configuration-408","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#telemetry","content"