s/sources/postgres#plugin-config-options","content":"bool"},"3771":{"id":"/docs/connectors/sources/postgres-98","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"false"},"3772":{"id":"/docs/connectors/sources/postgres-99","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"Log at info level instead of debug"},"3773":{"id":"/docs/connectors/sources/postgres-100","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"max_retries"},"3774":{"id":"/docs/connectors/sources/postgres-101","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"u32"},"3775":{"id":"/docs/connectors/sources/postgres-102","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"3"},"3776":{"id":"/docs/connectors/sources/postgres-103","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"Max retry attempts for transient errors"},"3777":{"id":"/docs/connectors/sources/postgres-104","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"retry_delay"},"3778":{"id":"/docs/connectors/sources/postgres-105","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"string"},"3779":{"id":"/docs/connectors/sources/postgres-106","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"\"1s\""},"3780":{"id":"/docs/connectors/sources/postgres-107","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#plugin-config-options","content":"Base delay between retries"},"3781":{"id":"/docs/connectors/sources/postgres-108","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#output-format","content":"By default (no payload_column), each row is wrapped in a JSON envelope:"},"3782":{"id":"/docs/connectors/sources/postgres-109","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#output-format","content":"The stream config should use schema = \"json\". Flat-schema sinks such as Iceberg need the unwrap_envelope transform to extract the data field. See the transforms documentation."},"3783":{"id":"/docs/connectors/sources/postgres-110","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#payload-column-extraction","content":"When payload_column is set, the connector skips the envelope and emits that column directly as the message payload. payload_format controls how the column is read: bytea passes raw bytes through (use schema = \"raw\"), text reads UTF-8 text, and json_direct serializes a JSONB column to JSON bytes. See the upstream README for schema pairing and round-trip recipes with the PostgreSQL sink."},"3784":{"id":"/docs/connectors/sources/postgres-111","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"With mode = \"cdc\" the connector reads changes from a logical replication slot instead of polling tables:"},"3785":{"id":"/docs/connectors/sources/postgres-112","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"The builtin backend creates (or reuses) a logical replication slot using the test_decoding output plugin. The default slot name is iggy_slot. No publication is created or required, since test_decoding ignores publications entirely."},"3786":{"id":"/docs/connectors/sources/postgres-113","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"PostgreSQL must run with wal_level = logical, and the connection must be direct (no pooler) where replication requires it."},"3787":{"id":"/docs/connectors/sources/postgres-114","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"capture_operations filters which operations (INSERT, UPDATE, DELETE) are emitted."},"3788":{"id":"/docs/connectors/sources/postgres-115","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"The pg_replicate backend (based on Supabase's ETL framework) is not implemented: selecting cdc_backend = \"pg_replicate\" fails at startup unless the cdc_pg_replicate build feature is enabled, and the backend returns an error even when it is."},"3789":{"id":"/docs/connectors/sources/postgres-116","page_id":"/docs/connectors/sources/postgres","tags":[],"type":"text","url":"/docs/connectors/sources/postgres#cdc-mode","content":"When decommissioning a CDC connector, drop the replication slot to stop WAL retention. See the upstream README for details."},"3790":{"id":"/docs/connectors/sources/random","page_id":"/docs/connectors/sources/random","type":"page","content":"Random Source","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/random"},"3791":{"id":"/docs/connectors/sources/random-0","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random","content":"Generate random messages into Iggy streams for testing, benchmarking and verifying a connector pipeline."},"3792":{"id":"/docs/connectors/sources/random-1","page_id":"/docs/connectors/sources/random","type":"heading","tags":[],"url":"/docs/connectors/sources/random#configuration","content":"Configuration"},"3793":{"id":"/docs/connectors/sources/random-2","page_id":"/docs/connectors/sources/random","type":"heading","tags":[],"url":"/docs/connectors/sources/random#plugin-config-options","content":"Plugin config options"},"3794":{"id":"/docs/connectors/sources/random-3","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random","content":"The random source connector generates random messages and sends them to Iggy streams. This is useful for testing, benchmarking, and verifying that your connector pipeline is working correctly without needing an external data source."},"3795":{"id":"/docs/connectors/sources/random-4","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Option"},"3796":{"id":"/docs/connectors/sources/random-5","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Type"},"3797":{"id":"/docs/connectors/sources/random-6","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Default"},"3798":{"id":"/docs/connectors/sources/random-7","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Description"},"3799":{"id":"/docs/connectors/sources/random-8","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"interval"},"3800":{"id":"/docs/connectors/sources/random-9","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"string"},"3801":{"id":"/docs/connectors/sources/random-10","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"\"1s\""},"3802":{"id":"/docs/connectors/sources/random-11","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Delay before each message generation cycle"},"3803":{"id":"/docs/connectors/sources/random-12","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"max_count"},"3804":{"id":"/docs/connectors/sources/random-13","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"usize"},"3805":{"id":"/docs/connectors/sources/random-14","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"unlimited"},"3806":{"id":"/docs/connectors/sources/random-15","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Stop producing after this many messages in total; omit for unlimited"},"3807":{"id":"/docs/connectors/sources/random-16","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"messages_range"},"3808":{"id":"/docs/connectors/sources/random-17","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"[u32, u32]"},"3809":{"id":"/docs/connectors/sources/random-18","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"[10, 50]"},"3810":{"id":"/docs/connectors/sources/random-19","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Min (inclusive) / max (exclusive) messages per batch (random within range)"},"3811":{"id":"/docs/connectors/sources/random-20","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"payload_size"},"3812":{"id":"/docs/connectors/sources/random-21","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"u32"},"3813":{"id":"/docs/connectors/sources/random-22","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"100"},"3814":{"id":"/docs/connectors/sources/random-23","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Number of random characters in the text field of each message"},"3815":{"id":"/docs/connectors/sources/random-24","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"Setting max_count = 0 stops production immediately (the connector produces zero messages). To generate messages without a limit, leave the key out."},"3816":{"id":"/docs/connectors/sources/random-25","page_id":"/docs/connectors/sources/random","tags":[],"type":"text","url":"/docs/connectors/sources/random#plugin-config-options","content":"The connector persists the total number of produced messages as its state, so max_count is enforced across runtime restarts."},"3817":{"id":"/docs/connectors/sources/source","page_id":"/docs/connectors/sources/source","type":"page","content":"Source","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/source"},"3818":{"id":"/docs/connectors/sources/source-0","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source","content":"What source connectors do, and the Source trait every one of them implements."},"3819":{"id":"/docs/connectors/sources/source-1","page_id":"/docs/connectors/sources/source","type":"heading","tags":[],"url":"/docs/connectors/sources/source#overview","content":"Overview"},"3820":{"id":"/docs/connectors/sources/source-2","page_id":"/docs/connectors/sources/source","type":"heading","tags":[],"url":"/docs/connectors/sources/source#configuration","content":"Configuration"},"3821":{"id":"/docs/connectors/sources/source-3","page_id":"/docs/connectors/sources/source","type":"heading","tags":[],"url":"/docs/connectors/sources/source#environment-variable-overrides","content":"Environment Variable Overrides"},"3822":{"id":"/docs/connectors/sources/source-4","page_id":"/docs/connectors/sources/source","type":"heading","tags":[],"url":"/docs/connectors/sources/source#sample-implementation","content":"Sample implementation"},"3823":{"id":"/docs/connectors/sources/source-5","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#overview","content":"Source connectors are responsible for ingesting data from external sources into Apache Iggy. They provide a way to integrate Apache Iggy with various data sources, such as databases, message queues, or file systems."},"3824":{"id":"/docs/connectors/sources/source-6","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#overview","content":"The source is represented by the single Source trait, which defines the basic interface for all source connectors. It provides methods for initializing the source, reading data from it, and closing the source."},"3825":{"id":"/docs/connectors/sources/source-7","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Each source connector is configured in its own separate configuration file within the connectors directory specified in the main runtime config."},"3826":{"id":"/docs/connectors/sources/source-8","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"verbose and benchmark are optional and default to false. verbose switches the connector's per-batch logging to info level, and benchmark emits per-batch timing events for performance measurement."},"3827":{"id":"/docs/connectors/sources/source-9","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Main runtime config (config.toml):"},"3828":{"id":"/docs/connectors/sources/source-10","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#configuration","content":"Source connector config (connectors/random.toml):"},"3829":{"id":"/docs/connectors/sources/source-11","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#environment-variable-overrides","content":"Configuration properties can be overridden using environment variables. The pattern follows: IGGY_CONNECTORS_SOURCE_[KEY]_[PROPERTY]"},"3830":{"id":"/docs/connectors/sources/source-12","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#environment-variable-overrides","content":"For example, to override the enabled property for a source with ID random:"},"3831":{"id":"/docs/connectors/sources/source-13","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#environment-variable-overrides","content":"Top-level fields of plugin_config can be overridden (or injected) the same way with the IGGY_CONNECTORS_SOURCE_[KEY]_PLUGIN_CONFIG_[FIELD] pattern. This is the recommended way to pass credentials without writing them into the TOML file:"},"3832":{"id":"/docs/connectors/sources/source-14","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Let's implement the example source connector, which generates a random batch of messages at the configured interval and optionally stops after a total message limit."},"3833":{"id":"/docs/connectors/sources/source-15","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Additionally, our source connector will have its own state, which can be used e.g. to track the overall progress or store some relevant information when producing the data from the actual external sources or tooling."},"3834":{"id":"/docs/connectors/sources/source-16","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Keep in mind, that the produced messages will be sent further to the specified stream, however it's already the responsibility of the runtime to handle the delivery."},"3835":{"id":"/docs/connectors/sources/source-17","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Also, when implementing the source connector, make sure to use the source_connector! macro to expose the FFI interface and allow the connector runtime to register the source with the runtime."},"3836":{"id":"/docs/connectors/sources/source-18","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"And finally, each source should have its own, custom configuration, which is passed along with the unique plugin ID and optional state via expected new() method."},"3837":{"id":"/docs/connectors/sources/source-19","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"The full, compiling implementation lives in the repository at core/connectors/sources/random_source. The snippets below mirror it."},"3838":{"id":"/docs/connectors/sources/source-20","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Let's start by defining the internal state and the public source connector along with its own configuration."},"3839":{"id":"/docs/connectors/sources/source-21","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"At this point, we can expose the required new() method, which will be used by the runtime to create a new instance of the source connector. The id is assigned by the runtime, and represents the unique identifier of the source connector. The state is an optional connector state (e.g. persisted in the local file), which will be provided by the runtime, given that the connector has persisted its own state before the runtime was restarted. The ConnectorState::deserialize() helper decodes the MessagePack bytes back into our State struct, falling back to a fresh state when nothing was persisted or decoding fails."},"3840":{"id":"/docs/connectors/sources/source-22","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"We can invoke the expected macro to expose the FFI interface and allow the connector runtime to register the source within the runtime."},"3841":{"id":"/docs/connectors/sources/source-23","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"At a bare minimum, we need to add the following dependencies to the Cargo.toml file to compile the plugin at all:"},"3842":{"id":"/docs/connectors/sources/source-24","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"async-trait"},"3843":{"id":"/docs/connectors/sources/source-25","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"dashmap"},"3844":{"id":"/docs/connectors/sources/source-26","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"iggy_connector_sdk"},"3845":{"id":"/docs/connectors/sources/source-27","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"serde"},"3846":{"id":"/docs/connectors/sources/source-28","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"tokio"},"3847":{"id":"/docs/connectors/sources/source-29","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"tracing"},"3848":{"id":"/docs/connectors/sources/source-30","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"This example also uses humantime, rand, rmp-serde, simd-json, and uuid."},"3849":{"id":"/docs/connectors/sources/source-31","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Before we make use of the Source trait, let's define the internal payload of the message that will be produced (e.g. as if it was pulled from some external database or so)."},"3850":{"id":"/docs/connectors/sources/source-32","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"serialize_state() encodes the state to MessagePack via ConnectorState::serialize(). generate_messages() builds a random number of messages (within messages_range), each carrying a JSON-serialized Record with payload_size random characters of text."},"3851":{"id":"/docs/connectors/sources/source-33","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Now, let's implement the Source trait for our RandomSource struct. Each poll() waits for the configured interval to mimic a real-world external source, stops producing once max_count messages have been generated (if it's set), and returns the updated state along with the ProducedMessages. The runtime persists that state and hands it back to new() after a restart."},"3852":{"id":"/docs/connectors/sources/source-34","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"As you can see, the ProducedMessage can be customized to fit your needs, as all the fields will be directly mapped to the existing Iggy message struct."},"3853":{"id":"/docs/connectors/sources/source-35","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"It's also important to note, that the supported format(s) might vary depending on the connector implementation. For example, you might use JSON as the payload format, which can be then easily parsed and processed by downstream components such as data transforms, but at the same time, you could support the other formats and let the user decide which one to use."},"3854":{"id":"/docs/connectors/sources/source-36","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"While the final schema of messages (that will be appended to the Iggy stream), can be controlled with the built-in configuration (the particular StreamEncoder will be used), keep in mind, that it might be sometimes difficult/impossible e.g. to transform one format to another e.g. JSON to SBE or so, and in such a case, the produced messages will be ignored."},"3855":{"id":"/docs/connectors/sources/source-37","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"Eventually, compile the source code and create a separate connector configuration file in the connectors directory (as specified in the main runtime config.toml). Make sure that path points to the existing plugin."},"3856":{"id":"/docs/connectors/sources/source-38","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"And before starting the runtime, do not forget to create the specified stream and topic e.g. via Iggy CLI."},"3857":{"id":"/docs/connectors/sources/source-39","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"And that's all, enjoy using the source connector!"},"3858":{"id":"/docs/connectors/sources/source-40","page_id":"/docs/connectors/sources/source","tags":[],"type":"text","url":"/docs/connectors/sources/source#sample-implementation","content":"On a side note, if you'd like to process the messages consumed from the Iggy stream instead, you can implement your own Sink connector too :)"},"3859":{"id":"/docs/connectors/sinks/clickhouse","page_id":"/docs/connectors/sinks/clickhouse","type":"page","content":"ClickHouse Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/clickhouse"},"3860":{"id":"/docs/connectors/sinks/clickhouse-0","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse","content":"Insert messages from Iggy streams into ClickHouse tables over the HTTP interface."},"3861":{"id":"/docs/connectors/sinks/clickhouse-1","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#configuration","content":"Configuration"},"3862":{"id":"/docs/connectors/sinks/clickhouse-2","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#options","content":"Options"},"3863":{"id":"/docs/connectors/sinks/clickhouse-3","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#insert-formats","content":"Insert Formats"},"3864":{"id":"/docs/connectors/sinks/clickhouse-4","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#error-handling--delivery-semantics","content":"Error Handling & Delivery Semantics"},"3865":{"id":"/docs/connectors/sinks/clickhouse-5","page_id":"/docs/connectors/sinks/clickhouse","type":"heading","tags":[],"url":"/docs/connectors/sinks/clickhouse#transforms","content":"Transforms"},"3866":{"id":"/docs/connectors/sinks/clickhouse-6","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse","content":"The ClickHouse sink connector consumes messages from Iggy streams and inserts them into ClickHouse tables over the HTTP interface. It supports three insert formats: json_each_row (default), row_binary, and string passthrough for pre-formatted CSV/TSV/JSON payloads."},"3867":{"id":"/docs/connectors/sinks/clickhouse-7","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url":"/docs/connectors/sinks/clickhouse","content":"This page is a curated subset of the documentation. The canonical reference is the upstream clickhouse_sink README in the apache/iggy repository."},"3868":{"id":"/docs/connectors/sinks/clickhouse-8","page_id":"/docs/connectors/sinks/clickhouse","tags":[],"type":"text","url