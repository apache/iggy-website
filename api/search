onnectors/sources/elasticsearch-24","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"username / password"},"5225":{"id":"/docs/connectors/sources/elasticsearch-25","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"string"},"5226":{"id":"/docs/connectors/sources/elasticsearch-26","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"none"},"5227":{"id":"/docs/connectors/sources/elasticsearch-27","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Basic authentication is enabled only when both are present"},"5228":{"id":"/docs/connectors/sources/elasticsearch-28","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"query"},"5229":{"id":"/docs/connectors/sources/elasticsearch-29","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"table"},"5230":{"id":"/docs/connectors/sources/elasticsearch-30","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"match_all"},"5231":{"id":"/docs/connectors/sources/elasticsearch-31","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Elasticsearch query DSL applied on each poll"},"5232":{"id":"/docs/connectors/sources/elasticsearch-32","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"polling_interval"},"5233":{"id":"/docs/connectors/sources/elasticsearch-33","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"string"},"5234":{"id":"/docs/connectors/sources/elasticsearch-34","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"\"10s\""},"5235":{"id":"/docs/connectors/sources/elasticsearch-35","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Delay before each poll cycle; invalid strings fall back to 10s, and zero is accepted"},"5236":{"id":"/docs/connectors/sources/elasticsearch-36","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"batch_size"},"5237":{"id":"/docs/connectors/sources/elasticsearch-37","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"integer"},"5238":{"id":"/docs/connectors/sources/elasticsearch-38","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"100"},"5239":{"id":"/docs/connectors/sources/elasticsearch-39","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Search size per poll; 0 returns no hits, and Elasticsearch enforces its own result-window limit"},"5240":{"id":"/docs/connectors/sources/elasticsearch-40","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"timestamp_field"},"5241":{"id":"/docs/connectors/sources/elasticsearch-41","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"string"},"5242":{"id":"/docs/connectors/sources/elasticsearch-42","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"none"},"5243":{"id":"/docs/connectors/sources/elasticsearch-43","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Top-level RFC3339 string field used to advance the watermark"},"5244":{"id":"/docs/connectors/sources/elasticsearch-44","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"A custom query must be a structured object. In TOML that means nested tables (an inline JSON string won't work):"},"5245":{"id":"/docs/connectors/sources/elasticsearch-45","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"The connector file remains TOML. plugin_config_format = \"json\" only selects the default format of the HTTP API's plugin-config response; it does not change how the local file is parsed. The upstream config example also uses TOML with a structured [plugin_config] table."},"5246":{"id":"/docs/connectors/sources/elasticsearch-46","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#how-polling-works","content":"Each cycle the connector waits polling_interval, then runs a search against index with the configured query, size = batch_size, sorted ascending by timestamp_field (@timestamp when unset). Every hit with _source becomes one JSON message. Elasticsearch _id is not copied into the payload or used as the Iggy message ID; headers and timestamps are also unset by this plugin."},"5247":{"id":"/docs/connectors/sources/elasticsearch-47","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#how-polling-works","content":"When timestamp_field is set, the query is also filtered to values strictly greater than the last acknowledged timestamp. Only top-level strings that parse as RFC3339 update the watermark; numeric timestamps, date-only strings and nested paths do not. Without a timestamp_field there is no incremental cursor and each poll returns the first batch_size matching documents."},"5248":{"id":"/docs/connectors/sources/elasticsearch-48","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#how-polling-works","content":"The connector does not use scroll, search_after or a document-ID tiebreaker. If a timestamp group spans multiple batches, advancing past that timestamp skips the remaining tied documents. Late arrivals and updates at or below the watermark are also skipped. scroll_timeout is accepted but unused. Without a usable timestamp, repeated polls can produce duplicates; the default @timestamp sort still requires a sortable field in the index mapping."},"5249":{"id":"/docs/connectors/sources/elasticsearch-49","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#how-polling-works","content":"Search and JSON-decoding failures, timed_out: true, and a nonzero _shards.failed count are returned as poll errors without advancing the watermark. The next polling cycle retries from the previous watermark. Poll errors are logged by the SDK; they do not increment the runtime's forwarding-error counter or change the runtime connector status. There is no per-query retry loop or configured HTTP request timeout. The source stages a candidate watermark and applies it only after runtime Ack; Nack keeps the previous watermark so the next search can fetch the rejected records again. Fetched-document and byte counters include these repeated attempts. This does not remove the timestamp limitations above or provide exactly-once delivery."},"5250":{"id":"/docs/connectors/sources/elasticsearch-50","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#state","content":"Along with each successful poll, including an empty one, the connector returns a MessagePack checkpoint containing its timestamp watermark and counters. After sending the batch, the runtime saves that checkpoint and acknowledges it. With the default file state backend, it uses source_<key>.state under the runtime [state] path (default local_state); the runtime also supports an HTTP state backend. On restart, the saved checkpoint is passed to the plugin. Invalid MessagePack state logs a warning and starts fresh."},"5251":{"id":"/docs/connectors/sources/elasticsearch-51","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#state","content":"Runtime state persistence requires no plugin configuration. To reset its position with the file backend, stop the runtime and delete the source's state file."},"5252":{"id":"/docs/connectors/sources/elasticsearch-52","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#state","content":"The optional [plugin_config.state] enables a separate JSON snapshot loaded during open() and saved during close(). Its loaded values can override the runtime checkpoint. It defaults to ./connector_states/elasticsearch_source_<numeric_id>.json; state_id and storage_config.base_path customize that location. Only file storage is implemented. Selecting elasticsearch, redis or an unknown storage type warns and falls back to ./connector_states, ignoring the supplied backend location."},"5253":{"id":"/docs/connectors/sources/elasticsearch-53","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#state","content":"state.auto_save_interval and state.tracked_fields do not affect the runtime plugin. Its JSON snapshot is a direct file write, separate from the runtime's atomic checkpoint protocol, and snapshot errors only warn. If enabled, account for this second snapshot when resetting or restoring progress; removing only the runtime state file does not reset the plugin snapshot."},"5254":{"id":"/docs/connectors/sources/elasticsearch-54","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#state","content":"The saved counters include fetched documents, successful polls (including empty polls), empty polls, serialized payload bytes, errors and the last error text. The average successful-poll duration includes the configured polling delay. Document-ID, scroll-ID and offset fields are retained in state but do not drive polling. These plugin counters are separate from the runtime's sent/error metrics."},"5255":{"id":"/docs/connectors/sources/influxdb","page_id":"/docs/connectors/sources/influxdb","type":"page","content":"InfluxDB Source","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/influxdb"},"5256":{"id":"/docs/connectors/sources/influxdb-0","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb","content":"Poll InfluxDB on an interval and produce the resulting rows into an Iggy stream, on both InfluxDB V2 and V3."},"5257":{"id":"/docs/connectors/sources/influxdb-1","page_id":"/docs/connectors/sources/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sources/influxdb#configuration","content":"Configuration"},"5258":{"id":"/docs/connectors/sources/influxdb-2","page_id":"/docs/connectors/sources/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sources/influxdb#common-options","content":"Common Options"},"5259":{"id":"/docs/connectors/sources/influxdb-3","page_id":"/docs/connectors/sources/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sources/influxdb#cursor-based-polling","content":"Cursor-Based Polling"},"5260":{"id":"/docs/connectors/sources/influxdb-4","page_id":"/docs/connectors/sources/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sources/influxdb#payload-formats","content":"Payload Formats"},"5261":{"id":"/docs/connectors/sources/influxdb-5","page_id":"/docs/connectors/sources/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sources/influxdb#state-and-failures","content":"State and Failures"},"5262":{"id":"/docs/connectors/sources/influxdb-6","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb","content":"The InfluxDB source connector polls InfluxDB on an interval and produces the resulting rows as messages into an Iggy stream. It supports both InfluxDB V2 (OSS 2.x / Cloud, Flux queries) and InfluxDB V3 (Core / Enterprise, SQL queries), selected with the version option. An acknowledged timestamp cursor and row offset are stored in connector state. Restarts resume from that checkpoint, subject to the ordering and late-arrival limits below."},"5263":{"id":"/docs/connectors/sources/influxdb-7","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb","content":"This page is a curated subset of the documentation. The canonical reference, including the full cursor semantics and stuck-timestamp handling, is the upstream influxdb_source README in the apache/iggy repository."},"5264":{"id":"/docs/connectors/sources/influxdb-8","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#configuration","content":"Use the broker credentials and main runtime configuration from the source guide. Build the plugin from the matching 0.9.0/edge checkout root:"},"5265":{"id":"/docs/connectors/sources/influxdb-9","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#configuration","content":"The V2 example requires an existing telemetry bucket in iggy_org, a token with read access, and cpu points with a numeric usage field and a host tag. Save this entry in the runtime's connector directory and start the runtime from the checkout root."},"5266":{"id":"/docs/connectors/sources/influxdb-10","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#configuration","content":"Create the destination before starting the runtime:"},"5267":{"id":"/docs/connectors/sources/influxdb-11","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#configuration","content":"InfluxDB V2 takes an org and a Flux query. For V3, replace the entire [plugin_config] section below, including the V2-only org. The my-db database must contain a cpu table; this example assumes host is its only tag."},"5268":{"id":"/docs/connectors/sources/influxdb-12","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#configuration","content":"Omitting the plugin version defaults to \"v2\" for backward compatibility; it is separate from the connector entry's numeric configuration version. Unknown plugin keys and unsupported versions are rejected. The query must contain $cursor outside comments. Keep $limit in the query so the connector can control its size. With stuck-batch detection enabled, V3 also requires $offset and an ascending ORDER BY. Startup checks use text matching, so they do not prove that a query implements the required ordering."},"5269":{"id":"/docs/connectors/sources/influxdb-13","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#configuration","content":"Start the runtime as described in the source guide. After a polling cycle, read the produced records:"},"5270":{"id":"/docs/connectors/sources/influxdb-14","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"Option"},"5271":{"id":"/docs/connectors/sources/influxdb-15","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"Type"},"5272":{"id":"/docs/connectors/sources/influxdb-16","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"Default"},"5273":{"id":"/docs/connectors/sources/influxdb-17","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"Description"},"5274":{"id":"/docs/connectors/sources/influxdb-18","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"version"},"5275":{"id":"/docs/connectors/sources/influxdb-19","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"string"},"5276":{"id":"/docs/connectors/sources/influxdb-20","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"v2"},"5277":{"id":"/docs/connectors/sources/influxdb-21","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sources/influxdb#common-options","content":"v2 or v3"},"5278":{"id":"/docs/connectors/sources/influxdb-22","page_id":"/docs/connectors/sources/influxdb","tags":[],"type":"text","url":"/docs/connectors/sour