e":"text","url":"/docs/connectors/sinks/http#common-options","content":"individual, ndjson, json_array, or raw"},"4459":{"id":"/docs/connectors/sinks/http-35","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"include_metadata"},"4460":{"id":"/docs/connectors/sinks/http-36","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"bool"},"4461":{"id":"/docs/connectors/sinks/http-37","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"true"},"4462":{"id":"/docs/connectors/sinks/http-38","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"Wrap payload in metadata envelope"},"4463":{"id":"/docs/connectors/sinks/http-39","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"headers"},"4464":{"id":"/docs/connectors/sinks/http-40","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"table"},"4465":{"id":"/docs/connectors/sinks/http-41","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"{}"},"4466":{"id":"/docs/connectors/sinks/http-42","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"Custom HTTP headers (e.g. Authorization)"},"4467":{"id":"/docs/connectors/sinks/http-43","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"timeout"},"4468":{"id":"/docs/connectors/sinks/http-44","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"string"},"4469":{"id":"/docs/connectors/sinks/http-45","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"30s"},"4470":{"id":"/docs/connectors/sinks/http-46","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"Request timeout (e.g. 10s, 500ms)"},"4471":{"id":"/docs/connectors/sinks/http-47","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"Further options cover retries (max_retries, retry_delay, retry_backoff_multiplier, max_retry_delay), success status codes, payload size limits, TLS, connection pooling, health checks, and verbose logging. See the upstream http_sink README for the full list with defaults."},"4472":{"id":"/docs/connectors/sinks/http-48","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"The body size limit defaults to 10 MiB and applies after serialization: per message in individual/raw, or to the whole batch in ndjson/json_array. Setting max_payload_size_bytes = 0 disables it. Oversized bodies fail without being sent. Optional startup health checks use the same URL, retry policy and success codes, with HEAD as the default method."},"4473":{"id":"/docs/connectors/sinks/http-49","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#common-options","content":"GET and HEAD are accepted but unusual for delivering data: the request still carries a body, which some servers reject. The sink logs a warning at startup when GET or HEAD is combined with a batch mode other than individual."},"4474":{"id":"/docs/connectors/sinks/http-50","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#batch-modes","content":"The batch_mode option controls how messages from one poll cycle are delivered to the endpoint."},"4475":{"id":"/docs/connectors/sinks/http-51","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#batch-modes","content":"individual (default): one HTTP request per message. Best for webhooks and endpoints that accept single events. With batch_length = 50, a full poll can produce 50 sequential requests, before retries; shorter polls and failures can produce fewer."},"4476":{"id":"/docs/connectors/sinks/http-52","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#batch-modes","content":"ndjson: all messages in one request, newline-delimited JSON. Best for bulk-ingestion endpoints. Content-Type: application/x-ndjson."},"4477":{"id":"/docs/connectors/sinks/http-53","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#batch-modes","content":"json_array: all messages as a single JSON array. Best for APIs that expect array payloads. Content-Type: application/json."},"4478":{"id":"/docs/connectors/sinks/http-54","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#batch-modes","content":"raw: raw bytes, one request per message. For non-JSON payloads (Protobuf, FlatBuffers, binary). The metadata envelope is not applied. Content-Type: application/octet-stream."},"4479":{"id":"/docs/connectors/sinks/http-55","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#batch-modes","content":"For production throughput with JSON-representable payloads, prefer ndjson or json_array, which collapse N round trips per poll cycle into one."},"4480":{"id":"/docs/connectors/sinks/http-56","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"When include_metadata = true (default), the JSON-mode payload is wrapped:"},"4481":{"id":"/docs/connectors/sinks/http-57","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"iggy_id is a 32-character lowercase hex string (no dashes)."},"4482":{"id":"/docs/connectors/sinks/http-58","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"iggy_timestamp is the message timestamp in Unix epoch microseconds. include_checksum and include_origin_timestamp add the corresponding metadata fields; both default to false."},"4483":{"id":"/docs/connectors/sinks/http-59","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"Nonempty message headers become iggy_headers: non-raw values are strings, and raw values use a base64 data object with iggy_header_encoding = \"base64\"."},"4484":{"id":"/docs/connectors/sinks/http-60","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"Set include_metadata = false to send the payload without wrapping (useful when the downstream service expects bare JSON, e.g. Slack webhooks)."},"4485":{"id":"/docs/connectors/sinks/http-61","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"In JSON batch modes, raw, FlatBuffer, Protobuf and Avro payload variants are base64-encoded with an explicit marker:"},"4486":{"id":"/docs/connectors/sinks/http-62","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"With the envelope enabled, this object becomes the payload field shown above. JSON values are reserialized and text payloads become JSON strings."},"4487":{"id":"/docs/connectors/sinks/http-63","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"The runtime applies stream decoding and configured transforms before the sink formats its requests. To forward opaque message bytes, use schema = \"raw\" with batch_mode = \"raw\" and no transforms. See the SDK format limits when selecting other schemas."},"4488":{"id":"/docs/connectors/sinks/http-64","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#metadata-envelope","content":"The connector doesn't expect the metadata envelope on input; it adds it on the way out. Producers must supply payloads accepted by the configured stream decoder and the receiving endpoint."},"4489":{"id":"/docs/connectors/sinks/http-65","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#authentication","content":"The HTTP sink supports authentication via custom headers under [plugin_config.headers]. Custom headers are sent with data requests and health checks, except Content-Type: the sink ignores a configured value and sets it from the batch mode for data requests."},"4490":{"id":"/docs/connectors/sinks/http-66","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#authentication","content":"Other valid headers work the same way: use x-api-key = \"my-secret-api-key\" for API-key schemes, or Authorization = \"Basic dXNlcm5hbWU6cGFzc3dvcmQ=\" (base64 of username:password) for basic auth. Multiple headers are combined per request. Configure header secrets in a protected connector TOML file. The local provider supports environment overrides for flat plugin fields, such as URL, but not nested headers or JSON objects. HEADERS_AUTHORIZATION creates an unused flat field, and a JSON object supplied through HEADERS is parsed as a string and fails plugin initialization."},"4491":{"id":"/docs/connectors/sinks/http-67","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"Transient failures allow up to max_retries additional attempts after the initial request: the default 3 means at most four attempts. Retry delays use full jitter from zero up to min(retry_delay * retry_backoff_multiplier^n, max_retry_delay), where n starts at zero for the first retry. With the defaults, the three delay caps are 1, 2 and 4 seconds."},"4492":{"id":"/docs/connectors/sinks/http-68","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"Transient errors (retried): network errors, HTTP 429, 500, 502, 503, 504."},"4493":{"id":"/docs/connectors/sinks/http-69","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"Non-transient errors (fail immediately): HTTP 400, 401, 403, 404, 405, etc."},"4494":{"id":"/docs/connectors/sinks/http-70","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"success_status_codes (default [200, 201, 202, 204]) short-circuits retries: any status code in this set is treated as success and is never retried, even codes that are normally transient. Placing 429 in the set makes the sink accept rate-limited responses as delivered. The sink warns at startup about such overlaps."},"4495":{"id":"/docs/connectors/sinks/http-71","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"HTTP 429 Retry-After: on unsuccessful responses, the header is logged but not honored. Retry timing always uses the computed backoff."},"4496":{"id":"/docs/connectors/sinks/http-72","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"Partial delivery (individual/raw modes): after a fixed number of consecutive HTTP failures (3 at the time of writing, not configurable), the remainder of the batch is aborted to avoid hammering a dead endpoint."},"4497":{"id":"/docs/connectors/sinks/http-73","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"The connector runtime uses consumer auto-commit before consume() completes. A plugin error is logged and counted, the failed batch adds no processed messages, and polling continues without replaying that batch. Earlier messages or requests from the same batch may already have succeeded. A crash or exhausted retry budget can lose messages; a retry after an ambiguous response can deliver them again. There is no end-to-end at-least-once or exactly-once guarantee."},"4498":{"id":"/docs/connectors/sinks/http-74","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#retry--delivery-semantics","content":"HTTP success is determined by the response status. The sink does not inspect a successful response body for per-item failures."},"4499":{"id":"/docs/connectors/sinks/http-75","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#example-configurations","content":"Replace the corresponding blocks in the complete configuration above, and supply your own endpoint URLs and credentials."},"4500":{"id":"/docs/connectors/sinks/http-76","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#webhook-slack","content":"Use schema = \"json\" and publish JSON in the shape Slack expects, for example {\"text\":\"hello\"}. include_metadata = false skips the envelope, but JSON is still reserialized; the original bytes and whitespace are not preserved."},"4501":{"id":"/docs/connectors/sinks/http-77","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#deployment--performance","content":"One iggy-connectors runtime process can host many connectors: the local config provider imports every connector TOML file under its config_dir, and each entry gets its own plugin instance and consume tasks in the same process. Each connector entry has exactly one [plugin_config] block and therefore one destination URL. To send to multiple destinations, add multiple HTTP sink entries with distinct keys and URLs (in the same runtime or separate ones). For fan-out from a single topic to multiple endpoints, point multiple sink entries at the same topic with different consumer_group names so each maintains its own offset."},"4502":{"id":"/docs/connectors/sinks/http-78","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#deployment--performance","content":"Throughput is dominated by batch-mode choice: the runtime calls consume() sequentially within each topic task, so a full N-message batch uses N requests in individual/raw, or one in ndjson/json_array, before retries or skipped messages. Connection pooling and HTTP keep-alive are enabled by default. max_connections limits idle connections retained per host, not concurrent requests. Topic tasks can issue requests concurrently; each topic awaits its own batch before continuing. Tune pooling and batch_length for the receiving service."},"4503":{"id":"/docs/connectors/sinks/http-79","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#deployment--performance","content":"For multi-instance deployment patterns (Docker, Kubernetes, fan-out topologies), connection pool tuning, and full performance analysis, see the upstream http_sink README."},"4504":{"id":"/docs/connectors/sinks/http-80","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"No Retry-After honoring: the header is logged but doesn't influence retry timing."},"4505":{"id":"/docs/connectors/sinks/http-81","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"No dead-letter queue: failed messages are logged at error! level but not persisted."},"4506":{"id":"/docs/connectors/sinks/http-82","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"No request signing: AWS SigV4, HMAC, and similar schemes aren't supported. Use custom headers or a signing proxy."},"4507":{"id":"/docs/connectors/sinks/http-83","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"No per-topic URL routing: all topics in one connector instance share the same url. For routing, deploy multiple instances."},"4508":{"id":"/docs/connectors/sinks/http-84","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"No OAuth2 / OIDC token refresh: bearer tokens are static. Use an auth proxy for services that require token rotation."},"4509":{"id":"/docs/connectors/sinks/http-85","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"No mTLS client certificates: terminate mTLS at a sidecar proxy for production use."},"4510":{"id":"/docs/connectors/sinks/http-86","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"Plaintext secrets in config: header values are stored verbatim in config.toml. Mount or generate a protected connector TOML file containing the required header values before starting the runtime."},"4511":{"id":"/docs/connectors/sinks/http-87","page_id":"/docs/connectors/sinks/http","tags":[],"type":"text","url":"/docs/connectors/sinks/http#known-limitations","content":"For the complete list and implementation context, see the upstream http_sink README."},"4512":{"id":"/docs/connectors/sinks/iceberg","page_id":"/docs/connectors/sinks/iceberg","type":"page","content":"Iceberg Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/iceberg"},"4513":{"id":"/docs/connectors/sinks/iceberg-0","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg","content":"Consume messages from Iggy topics and store them in Iceberg tables, with REST catalogs and S3-compatible storage."},"4514":{"id":"/docs/connectors/sinks/iceberg-1","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#features","content":"Features"},"4515":{"id":"/docs/connectors/sinks/iceberg-2","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#configuration-example","content":"Configuration example"},"4516":{"id":"/docs/connectors/sinks/iceberg-3","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#configuration-options","content":"Configuration Options"},"4517":{"id":"/docs/connectors/sinks/iceberg-4","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#static-routing","content":"Static Routing"},"4518":{"id":"/docs/connectors/sinks/iceberg-5","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"Dynamic Routing"},"4519":{"id":"/docs/connectors/sinks/iceberg-6","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#dynamic-routing-configuration-example","content":"Dynamic routing configuration example"},"4520":{"id":"/docs/connectors/sinks/iceberg-7","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#batches-and-table-commits","content":"Batches and table commits"},"4521":{"id":"/docs/connectors/sinks/iceberg-8","page_id":"/docs/connectors/sinks/iceberg","type":"heading","tags":[],"url":"/docs/connectors/sinks/iceberg#source-compatibility","content":"Source Compatibility"},"4522":{"id":"/docs/connectors/sinks/iceberg-9","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg","content":"The Iceberg Sink Connector allows you to consume messages from Iggy topics and store them in Iceberg tables."},"4523":{"id":"/docs/connectors/sinks/iceberg-10","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#features","content":"Support for S3-compatible storage"},"4524":{"id":"/docs/connectors/sinks/iceberg-11","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#features","content":"Support for REST catalogs"},"4525":{"id":"/docs/connectors/sinks/iceberg-12","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#features","content":"Single destination table"},"4526":{"id":"/docs/connectors/sinks/iceberg-13","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#features","content":"Multiple-table fan-out static routing"},"4527":{"id":"/docs/connectors/sinks/iceberg-14","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#features","content":"Multiple-table fan-out dynamic routing"},"4528":{"id":"/docs/connectors/sinks/iceberg-15","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-example","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.9.0/edge repository root, build the plugin:"},"4529":{"id":"/docs/connectors/sinks/iceberg-16","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-example","content":"The example requires a REST catalog at http://localhost:8181 and S3-compatible storage at http://localhost:9000, configured with the credentials below. Create the storage bucket, namespace and target table before starting the connector. The sink does not create them."},"4530":{"id":"/docs/connectors/sinks/iceberg-17","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-example","content":"For a local catalog without authentication, create nyc.users with id (long) and name (string):"},"4531":{"id":"/docs/connectors/sinks/iceberg-18","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-example","content":"Save this complete connector file in the runtime's connector directory:"},"4532":{"id":"/docs/connectors/sinks/iceberg-19","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-example","content":"Create the Iggy resources and send a row:"},"4533":{"id":"/docs/connectors/sinks/iceberg-20","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"All options below are required except the credential pair and store_path_style_access. tables and dynamic_route_field must be present even when the selected routing mode does not use them."},"4534":{"id":"/docs/connectors/sinks/iceberg-21","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"tables: The names of the Iceberg tables you want to statically route Iggy messages to. The name should include the table’s namespace, separated by a dot (.). Ignored when dynamic_routing = true."},"4535":{"id":"/docs/connectors/sinks/iceberg-22","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"catalog_type: The type of catalog you are routing data to. Currently, only REST catalogs are fully supported."},"4536":{"id":"/docs/connectors/sinks/iceberg-23","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"warehouse: The warehouse value sent to the REST catalog. Its meaning depends on the catalog service; data file destinations come from each table’s metadata."},"4537":{"id":"/docs/connectors/sinks/iceberg-24","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"uri: The URI of the Iceberg catalog."},"4538":{"id":"/docs/connectors/sinks/iceberg-25","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"dynamic_routing: Enables dynamic routing. See more details later in this document."},"4539":{"id":"/docs/connectors/sinks/iceberg-26","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"dynamic_route_field: The top-level message field that specifies the Iceberg table to route data to. Ignored in static mode. See more details below."},"4540":{"id":"/docs/connectors/sinks/iceberg-27","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"store_url: The URL of the object storage for data uploads."},"4541":{"id":"/docs/connectors/sinks/iceberg-28","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"store_access_key_id: The optional access key ID of the object storage."},"4542":{"id":"/docs/connectors/sinks/iceberg-29","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"store_secret_access_key: The optional secret key used to upload data to the object storage. Supply both credential fields or omit both to use the default AWS credential provider chain."},"4543":{"id":"/docs/connectors/sinks/iceberg-30","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"store_region: The region of the object storage. Required. For S3-compatible stores that ignore it, supply any placeholder value."},"4544":{"id":"/docs/connectors/sinks/iceberg-31","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"store_class: The storage class to use. Currently, only S3-compatible storage is supported."},"4545":{"id":"/docs/connectors/sinks/iceberg-32","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#configuration-options","content":"store_path_style_access: Use path-style S3 URLs (http://host/bucket/key). Defaults to true; set to false for stores that require virtual-hosted-style URLs."},"4546":{"id":"/docs/connectors/sinks/iceberg-33","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#static-routing","content":"With dynamic_routing = false, every batch is copied to every successfully loaded table in tables. Invalid names and tables that cannot be loaded are skipped at startup. Startup fails if no table can be loaded. The writer uses each table's schema and default partition spec captured at startup, so restart the connector after changing them."},"4547":{"id":"/docs/connectors/sinks/iceberg-34","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"If you don't know the names of the Iceberg tables you want to route data to in advance, you can use the dynamic routing feature.\nInsert a top-level field in your JSON messages with the name of the Iceberg table the message should be routed to. The Iggy connector will parse this field at runtime and route the message to the correct table."},"4548":{"id":"/docs/connectors/sinks/iceberg-35","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"The Iggy Iceberg Connector will skip messages in the following cases:"},"4549":{"id":"/docs/connectors/sinks/iceberg-36","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"The table declared in the message field cannot be loaded, including missing tables and catalog lookup failures."},"4550":{"id":"/docs/connectors/sinks/iceberg-37","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"The table name has no namespace or contains an empty name component."},"4551":{"id":"/docs/connectors/sinks/iceberg-38","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"The message does not contain the field specified in the dynamic_route_field configuration option, or is not a JSON object."},"4552":{"id":"/docs/connectors/sinks/iceberg-39","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing","content":"A lookup failure skips the affected message; it does not fail the batch. Each batch loads its destination tables again. The route field is included in the JSON row, but is ignored by the writer if the target schema has no matching column."},"4553":{"id":"/docs/connectors/sinks/iceberg-40","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing-configuration-example","content":"Replace [plugin_config] in the complete connector file above and append the transform below. tables = [] is intentional: the route field chooses the destination in this mode."},"4554":{"id":"/docs/connectors/sinks/iceberg-41","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing-configuration-example","content":"Transforms are declared at the top level of the connector file, next to [plugin_config], and every [transforms.*] section requires enabled = true. See the transforms documentation for details."},"4555":{"id":"/docs/connectors/sinks/iceberg-42","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing-configuration-example","content":"Note: The value in the message field must contain both the namespace and the table name, separated by a dot (.).\nExample:"},"4556":{"id":"/docs/connectors/sinks/iceberg-43","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing-configuration-example","content":"Namespace: nyc"},"4557":{"id":"/docs/connectors/sinks/iceberg-44","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#dynamic-routing-configuration-example","content":"Table name: users"},"4558":{"id":"/docs/connectors/sinks/iceberg-45","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#batches-and-table-commits","content":"Rows are converted to Arrow using the target table schema, written to Parquet, then appended in an Iceberg transaction per destination table. Partitioned tables split a batch by the default partition spec. Writers can roll over into multiple files, so there is no fixed one-file-per-batch guarantee for either partitioned or unpartitioned tables."},"4559":{"id":"/docs/connectors/sinks/iceberg-46","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#batches-and-table-commits","content":"Fan-out is not atomic across tables. A write or commit error stops work on the remaining tables in that batch; an earlier table may already be committed. The Iceberg library refreshes metadata before committing and retries eligible commit errors according to the table's retry properties. The plugin does not replay a failed batch. The runtime records a plugin error and continues polling with consumer auto-commit, so messages can be lost after a failed or skipped write. Replaying an already committed batch can create duplicates."},"4560":{"id":"/docs/connectors/sinks/iceberg-47","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#source-compatibility","content":"Use schema = \"json\" on the stream. Each JSON object represents a table row; nested objects and arrays are supported when they match the table schema. Unknown fields are ignored. Missing nullable fields become null; missing required fields or incompatible values fail the table write."},"4561":{"id":"/docs/connectors/sinks/iceberg-48","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#source-compatibility","content":"Sources that wrap row data in an envelope need a transform when the table schema describes the inner row. Otherwise, the Arrow JSON reader maps envelope keys to table columns, producing nulls or schema errors."},"4562":{"id":"/docs/connectors/sinks/iceberg-49","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#source-compatibility","content":"If your source emits envelope-wrapped JSON, use the unwrap_envelope transform to extract the inner data field before it reaches the sink:"},"4563":{"id":"/docs/connectors/sinks/iceberg-50","page_id":"/docs/connectors/sinks/iceberg","tags":[],"type":"text","url":"/docs/connectors/sinks/iceberg#source-compatibility","content":"Set field to the envelope key that holds the row data. See the transforms documentation and your source connector's documentation for details on the envelope shape."},"4564":{"id":"/docs/connectors/sinks/influxdb","page_id":"/docs/connectors/sinks/influxdb","type":"page","content":"InfluxDB Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/influxdb"},"4565":{"id":"/docs/connectors/sinks/influxdb-0","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb","content":"Write messages from Iggy streams to InfluxDB as line-protocol points, on both InfluxDB V2 and V3."},"4566":{"id":"/docs/connectors/sinks/influxdb-1","page_id":"/docs/connectors/sinks/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/influxdb#configuration","content":"Configuration"},"4567":{"id":"/docs/connectors/sinks/influxdb-2","page_id":"/docs/connectors/sinks/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/influxdb#common-options","content":"Common Options"},"4568":{"id":"/docs/connectors/sinks/influxdb-3","page_id":"/docs/connectors/sinks/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/influxdb#payload-formats","content":"Payload Formats"},"4569":{"id":"/docs/connectors/sinks/influxdb-4","page_id":"/docs/connectors/sinks/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/influxdb#reliability","content":"Reliability"},"4570":{"id":"/docs/connectors/sinks/influxdb-5","page_id":"/docs/connectors/sinks/influxdb","type":"heading","tags":[],"url":"/docs/connectors/sinks/influxdb#transforms","content":"Transforms"},"4571":{"id":"/docs/connectors/sinks/influxdb-6","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb","content":"The InfluxDB sink connector consumes messages from Iggy streams and writes them to InfluxDB as line-protocol points. It supports both InfluxDB V2 (OSS 2.x / Cloud) and InfluxDB V3 (Core / Enterprise), selected with the version option."},"4572":{"id":"/docs/connectors/sinks/influxdb-7","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb","content":"This page is a curated subset of the documentation. The canonical reference is the upstream influxdb_sink README in the apache/iggy repository."},"4573":{"id":"/docs/connectors/sinks/influxdb-8","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.9.0/edge repository root, build the plugin:"},"4574":{"id":"/docs/connectors/sinks/influxdb-9","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#configuration","content":"Create the InfluxDB organization and bucket (V2), or database (V3), and provide a token with write access. Save the following connector file in the runtime's connector directory, replacing the URL and token for your deployment. Startup checks GET /health with the configured token, using Token authentication for V2 and Bearer for V3. A successful health check does not verify write permissions."},"4575":{"id":"/docs/connectors/sinks/influxdb-10","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#configuration","content":"Create the Iggy resources and send a row:"},"4576":{"id":"/docs/connectors/sinks/influxdb-11","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#configuration","content":"InfluxDB V2 organizes data as org + bucket. V3 uses a single db field instead. Omitting version defaults to \"v2\" for backward compatibility. The write body, batching, and retry behavior are identical between versions. The connector handles the differing endpoints, auth header styles, and precision spellings internally."},"4577":{"id":"/docs/connectors/sinks/influxdb-12","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#configuration","content":"For V3, replace the entire [plugin_config] section. Unknown options are rejected, so remove the V2 org and bucket fields:"},"4578":{"id":"/docs/connectors/sinks/influxdb-13","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"Option"},"4579":{"id":"/docs/connectors/sinks/influxdb-14","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"Type"},"4580":{"id":"/docs/connectors/sinks/influxdb-15","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"Default"},"4581":{"id":"/docs/connectors/sinks/influxdb-16","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"Description"},"4582":{"id":"/docs/connectors/sinks/influxdb-17","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"version"},"4583":{"id":"/docs/connectors/sinks/influxdb-18","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"string"},"4584":{"id":"/docs/connectors/sinks/influxdb-19","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"v2"},"4585":{"id":"/docs/connectors/sinks/influxdb-20","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"v2 or v3"},"4586":{"id":"/docs/connectors/sinks/influxdb-21","page_id":"/docs/connectors/sinks/influxdb","tags":[],"type":"text","url":"/docs/connectors/sinks/influxdb#common-options","content":"url"},"4587":{"id":"/docs/connectors/sinks/influxdb-22","page_id":"/docs/connectors/s