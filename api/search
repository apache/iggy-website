/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"Python"},"2032":{"id":"/docs/introduction/about-64","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"apache-iggy"},"2033":{"id":"/docs/introduction/about-65","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"PyPI"},"2034":{"id":"/docs/introduction/about-66","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"Node.js"},"2035":{"id":"/docs/introduction/about-67","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"apache-iggy"},"2036":{"id":"/docs/introduction/about-68","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"npm"},"2037":{"id":"/docs/introduction/about-69","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"Go"},"2038":{"id":"/docs/introduction/about-70","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"iggy-go"},"2039":{"id":"/docs/introduction/about-71","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"pkg.go.dev"},"2040":{"id":"/docs/introduction/about-72","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"PHP"},"2041":{"id":"/docs/introduction/about-73","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"apache/iggy-php"},"2042":{"id":"/docs/introduction/about-74","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"Packagist"},"2043":{"id":"/docs/introduction/about-75","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"C++"},"2044":{"id":"/docs/introduction/about-76","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"iggy-cpp"},"2045":{"id":"/docs/introduction/about-77","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#supported-languages-sdk","content":"GitHub (WIP)"},"2046":{"id":"/docs/introduction/about-78","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#cli","content":"The interactive CLI is implemented under the cli project, to provide the best developer experience. This is a great addition to the Web UI, especially for developers who prefer using the console tools."},"2047":{"id":"/docs/introduction/about-79","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#cli","content":"Iggy CLI can be installed with cargo install iggy-cli and then simply accessed by typing iggy in your terminal. It supports named connection contexts (profiles) for managing multiple server connections, shell completions for bash/zsh/fish/elvish/powershell, and session-based login on Linux."},"2048":{"id":"/docs/introduction/about-80","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#web-ui","content":"The Web UI provides a comprehensive dashboard for the Iggy server, built with SvelteKit and TypeScript. It can run in two modes:"},"2049":{"id":"/docs/introduction/about-81","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#web-ui","content":"Embedded - compiled into the server binary (with iggy-web feature flag), served at the /ui endpoint"},"2050":{"id":"/docs/introduction/about-82","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#web-ui","content":"Standalone - as a separate container via docker pull apache/iggy-web-ui"},"2051":{"id":"/docs/introduction/about-83","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#web-ui","content":"Features include stream/topic/partition management, message browser with JSON/string/XML decoders, user management, server logs viewer, real-time terminal, and server configuration overview."},"2052":{"id":"/docs/introduction/about-84","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#connectors","content":"Iggy provides a highly performant and modular runtime for statically typed, yet dynamically loaded connectors. You can ingest data from external sources and push the data to Iggy streams, or fetch data from Iggy streams and forward it to external systems. Create your own Rust plugins by simply implementing either the Source or Sink trait and build custom pipelines for the data processing."},"2053":{"id":"/docs/introduction/about-85","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#connectors","content":"There are currently 14 sinks and 4 sources available. Sinks include PostgreSQL, MongoDB, Elasticsearch, ClickHouse, InfluxDB, Apache Iceberg, Delta Lake, Quickwit and S3. Sources include PostgreSQL, Elasticsearch, InfluxDB and random data generation. See the connectors documentation for the full catalog."},"2054":{"id":"/docs/introduction/about-86","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#connectors","content":"The docker image is available, and can be fetched via docker pull apache/iggy-connect."},"2055":{"id":"/docs/introduction/about-87","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#model-context-protocol","content":"The Model Context Protocol (MCP) is an open protocol that standardizes how applications provide context to LLMs. The Iggy MCP Server is an implementation of the MCP protocol for message streaming infrastructure. It exposes 40+ tools covering streams, topics, partitions, messages, consumer groups, users, and more. It supports both HTTP and stdio transports, making it compatible with tools like Claude Desktop and other MCP clients."},"2056":{"id":"/docs/introduction/about-88","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#model-context-protocol","content":"The docker image is available, and can be fetched via docker pull apache/iggy-mcp."},"2057":{"id":"/docs/introduction/about-89","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"The official Apache Iggy images can be found on Docker Hub. Simply type docker pull apache/iggy to pull the image."},"2058":{"id":"/docs/introduction/about-90","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"You can also find the images for all the different tooling such as Connectors, MCP Server etc. here."},"2059":{"id":"/docs/introduction/about-91","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"Please note that the images tagged as latest are based on the official, stable releases, while the edge ones are updated directly from latest version of the master branch."},"2060":{"id":"/docs/introduction/about-92","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"You can find the Dockerfile and docker-compose in the root of the repository. To build and start the server, run: docker compose up."},"2061":{"id":"/docs/introduction/about-93","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"Additionally, you can run the CLI which is available in the running container, by executing: docker exec -it iggy-server /iggy."},"2062":{"id":"/docs/introduction/about-94","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"Keep in mind that running the container on operating systems other than Linux, where the Docker is running in the VM, might result in the performance degradation."},"2063":{"id":"/docs/introduction/about-95","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"Also, when running the container, make sure to include the additional capabilities, as you can find in docker-compose file:"},"2064":{"id":"/docs/introduction/about-96","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#docker","content":"Or when running with docker run:"},"2065":{"id":"/docs/introduction/about-97","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#helm-charts","content":"Helm charts for Kubernetes deployment are available in the repository. The chart includes templates for Deployment, Service, ServiceAccount, HPA (Horizontal Pod Autoscaler), Ingress, PersistentVolumeClaim, ServiceMonitor (for Prometheus), and root user credentials Secret."},"2066":{"id":"/docs/introduction/about-98","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#versioning","content":"The official releases follow the regular semver (0.5.0) or have a latest tag applied (apache/iggy:latest)."},"2067":{"id":"/docs/introduction/about-99","page_id":"/docs/introduction/about","tags":[],"type":"text","url":"/docs/introduction/about#versioning","content":"We also publish edge/dev/nightly releases (e.g. 0.6.0-edge.1 or apache/iggy:edge), for both SDKs and the Docker images. These are typically compatible with the latest changes but are not guaranteed to be stable and, as the name suggests, are not recommended for production use."},"2068":{"id":"/docs/introduction/architecture","page_id":"/docs/introduction/architecture","type":"page","content":"Architecture","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/architecture"},"2069":{"id":"/docs/introduction/architecture-0","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture","content":"Inside the Iggy server: how work is scheduled across cores, how requests are routed, and how a message reaches disk."},"2070":{"id":"/docs/introduction/architecture-1","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#how-a-message-flows-through-iggy","content":"How a message flows through Iggy"},"2071":{"id":"/docs/introduction/architecture-2","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#thread-per-core-shared-nothing--io_uring","content":"Thread per core (shared nothing) + io_uring"},"2072":{"id":"/docs/introduction/architecture-3","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#how-it-works","content":"How it works"},"2073":{"id":"/docs/introduction/architecture-4","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#shard-roles-and-connection-distribution","content":"Shard roles and connection distribution"},"2074":{"id":"/docs/introduction/architecture-5","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#request-routing","content":"Request routing"},"2075":{"id":"/docs/introduction/architecture-6","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#iggynamespace","content":"IggyNamespace"},"2076":{"id":"/docs/introduction/architecture-7","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#cpu-allocation-modes","content":"CPU allocation modes"},"2077":{"id":"/docs/introduction/architecture-8","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#io_uring-and-compio","content":"io_uring and compio"},"2078":{"id":"/docs/introduction/architecture-9","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#performance-tokio-vs-thread-per-core","content":"Performance: Tokio vs Thread-per-Core"},"2079":{"id":"/docs/introduction/architecture-10","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#left-right-metadata","content":"Left-right metadata"},"2080":{"id":"/docs/introduction/architecture-11","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#clustering","content":"Clustering"},"2081":{"id":"/docs/introduction/architecture-12","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#storage-structure","content":"Storage structure"},"2082":{"id":"/docs/introduction/architecture-13","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#memory-pool","content":"Memory pool"},"2083":{"id":"/docs/introduction/architecture-14","page_id":"/docs/introduction/architecture","type":"heading","tags":[],"url":"/docs/introduction/architecture#write-pipeline","content":"Write pipeline"},"2084":{"id":"/docs/introduction/architecture-15","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture","content":"This page covers the internals of the Iggy server: how work is scheduled across CPU cores, how requests are routed, and how data ends up on disk. If you're looking for the domain model (streams, topics, partitions, consumer groups, message format), see concepts first."},"2085":{"id":"/docs/introduction/architecture-16","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#how-a-message-flows-through-iggy","content":"Before diving into the architecture details, here's the complete journey of a message from client to disk:"},"2086":{"id":"/docs/introduction/architecture-17","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#thread-per-core-shared-nothing--io_uring","content":"Iggy uses a thread-per-core shared nothing architecture combined with io_uring for maximum performance. This design has been proven by systems like ScyllaDB and Redpanda, and is inspired by the Seastar framework."},"2087":{"id":"/docs/introduction/architecture-18","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#how-it-works","content":"Each CPU core runs its own shard (an instance of IggyShard), pinned to a specific core via sched_setaffinity on Linux. Each shard has its own single-threaded compio async runtime, which means there is no cross-thread synchronization needed within a shard. Memory is bound to the NUMA node of the core via hwlocality for optimal memory access latency."},"2088":{"id":"/docs/introduction/architecture-19","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#shard-roles-and-connection-distribution","content":"Shard 0 has a special role: it binds every listener - the replica plane and all client transports (TCP, QUIC, WebSocket, HTTP). Connections are then spread across shards at accept time:"},"2089":{"id":"/docs/introduction/architecture-20","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#shard-roles-and-connection-distribution","content":"Plaintext TCP and WebSocket connections are handed off round-robin to peer shards. Shard 0's coordinator duplicates the socket's file descriptor, ships a connection-setup frame to the target shard, and drops its own handle, so the owning shard serves the connection from then on - before a single byte is read."},"2090":{"id":"/docs/introduction/architecture-21","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#shard-roles-and-connection-distribution","content":"QUIC and TLS-wrapped TCP connections terminate on shard 0, because their per-connection state cannot be moved between shards."},"2091":{"id":"/docs/introduction/architecture-22","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#shard-roles-and-connection-distribution","content":"All shards, including shard 0, own partitions and serve partition requests."},"2092":{"id":"/docs/introduction/architecture-23","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#request-routing","content":"Requests are routed between shards using message passing (via crossfire bounded mpsc channels), which avoids locking entirely. The routing logic splits operations into two planes:"},"2093":{"id":"/docs/introduction/architecture-24","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#request-routing","content":"Metadata operations (create/delete stream/topic/user etc.) always execute on shard 0 - it is the only shard that commits metadata"},"2094":{"id":"/docs/introduction/architecture-25","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#request-routing","content":"Partition operations (send_messages, poll_messages, store_consumer_offset) are routed to the shard owning that partition via a lock-free concurrent map lookup. A request that lands on a non-owning shard rides the inter-shard message bus to the owner"},"2095":{"id":"/docs/introduction/architecture-26","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#request-routing","content":"Partition-to-shard assignment is deterministic: the packed IggyNamespace is hashed with Murmur3, and the upper 16 bits of the hash are taken modulo the shard count (the upper bits are used because Murmur3 has weak lower bits for small integer inputs)."},"2096":{"id":"/docs/introduction/architecture-27","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#iggynamespace","content":"The IggyNamespace packs stream_id (20 bits), topic_id (12 bits), and partition_id (20 bits) into a single u64 for efficient hashing and routing. This gives maximums of 1,048,576 streams, 4096 topics per stream, and 1,000,000 partitions per topic."},"2097":{"id":"/docs/introduction/architecture-28","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#cpu-allocation-modes","content":"The sharding system supports multiple allocation modes via the cpu_allocation config:"},"2098":{"id":"/docs/introduction/architecture-29","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#cpu-allocation-modes","content":"\"all\" - one shard per available CPU core"},"2099":{"id":"/docs/introduction/architecture-30","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#cpu-allocation-modes","content":"A numeric value (e.g. 4) - exactly N shards pinned to cores 0..N"},"2100":{"id":"/docs/introduction/architecture-31","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#cpu-allocation-modes","content":"A range (e.g. \"5..8\") - shards on specified core range"},"2101":{"id":"/docs/introduction/architecture-32","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#cpu-allocation-modes","content":"\"numa:auto\" - automatically detect NUMA topology and bind accordingly"},"2102":{"id":"/docs/introduction/architecture-33","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#cpu-allocation-modes","content":"\"numa:nodes=0,1;cores=4;no_ht=true\" - fine-grained NUMA control per node with hyperthread avoidance"},"2103":{"id":"/docs/introduction/architecture-34","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"Traditional async runtimes like tokio use epoll which is readiness-based - you ask the kernel \"is this file descriptor ready?\" and then perform the I/O yourself. The Linux kernel considers regular files \"always ready\" for epoll, which means tokio has to outsource file I/O to a blocking thread pool (up to 512 threads). This does not scale well."},"2104":{"id":"/docs/introduction/architecture-35","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"io_uring is completion-based - you submit I/O requests to a submission queue (SQ), and the kernel completes them and places results in a completion queue (CQ). Both queues are lock-free ring buffers shared between user space and kernel. This is fundamentally better for disk I/O."},"2105":{"id":"/docs/introduction/architecture-36","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"Iggy uses compio as its async runtime, which provides a driver-disaggregated architecture on top of io_uring (Linux) and IOCP (Windows). Each shard gets its own compio executor configured with:"},"2106":{"id":"/docs/introduction/architecture-37","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"Capacity: 4096 concurrent I/O operations (by default)"},"2107":{"id":"/docs/introduction/architecture-38","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"Event interval: 128 events per loop iteration"},"2108":{"id":"/docs/introduction/architecture-39","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#io_uring-and-compio","content":"Cooperative task running enabled"},"2109":{"id":"/docs/introduction/architecture-40","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#performance-tokio-vs-thread-per-core","content":"The migration from Tokio to thread-per-core with compio delivered significant latency improvements across the board:"},"2110":{"id":"/docs/introduction/architecture-41","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#left-right-metadata","content":"Shared metadata (streams, topics, consumer groups) uses a left-right concurrent data structure. Shard 0 holds the single write handle and is the only shard that commits metadata mutations, while every shard holds a read handle. This provides:"},"2111":{"id":"/docs/introduction/architecture-42","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#left-right-metadata","content":"Lock-free reads on all shards (no contention on the hot path)"},"2112":{"id":"/docs/introduction/architecture-43","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#left-right-metadata","content":"Strongly consistent writes serialized through shard 0"},"2113":{"id":"/docs/introduction/architecture-44","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#clustering","content":"The server is built on the Viewstamped Replication (VSR) consensus protocol. Metadata operations are committed through the VSR write-ahead log even on a single node, which is the default deployment. Multi-node clustering is enabled via the [cluster] configuration (a node roster plus --replica-id to pick the local entry). See clustering for the details and maturity caveats."},"2114":{"id":"/docs/introduction/architecture-45","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#storage-structure","content":"Having in mind that stream consists of topics, which might have one or more partitions assigned, and each partition consists of segments, we can visualize the structure of the Iggy data directory as follows:"},"2115":{"id":"/docs/introduction/architecture-46","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#storage-structure","content":"The stream, topic and partition directories are named after their numeric IDs, assigned from 0. The metadata/journal.wal file is the VSR write-ahead log that persists all metadata operations (stream/topic/user creation, etc.). The runtime/current_config.toml file captures the configuration the server actually booted with. Segment files are named by the 20-digit start offset of their first record. The .index file is created automatically and speeds up searches by keeping track of the offsets and timestamps of the records. The offsets/ directory holds the server-side consumer and consumer group offsets."},"2116":{"id":"/docs/introduction/architecture-47","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#memory-pool","content":"Iggy uses a custom memory pool with 28 buckets holding buffer sizes from 4 KiB to 512 MiB. The default pool size is 4 GiB with up to 8192 buffers per bucket. This eliminates allocation overhead on the hot path and enables zero-copy message passing between components. The pool is page-aligned (4096-byte multiples) and requires a minimum of 512 MiB."},"2117":{"id":"/docs/introduction/architecture-48","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"Messages flow through a multi-stage write pipeline:"},"2118":{"id":"/docs/introduction/architecture-49","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"Messages arrive on the owning shard and are buffered in the partition journal"},"2119":{"id":"/docs/introduction/architecture-50","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"A flush is triggered when either the message count threshold or the size threshold is reached - both are per-topic options set at topic creation (defaults: 1024 messages, 1 MiB)"},"2120":{"id":"/docs/introduction/architecture-51","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"The MessagesWriter uses vectored I/O with up to 1024 buffers per syscall"},"2121":{"id":"/docs/introduction/architecture-52","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"fsync per write is a per-topic option (enforce_fsync) for durability guarantees"},"2122":{"id":"/docs/introduction/architecture-53","page_id":"/docs/introduction/architecture","tags":[],"type":"text","url":"/docs/introduction/architecture#write-pipeline","content":"When a segment reaches the topic's segment size (default 1 GiB), it is sealed and a new segment is created"},"2123":{"id":"/docs/introduction/concepts","page_id":"/docs/introduction/concepts","type":"page","content":"Concepts","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/concepts"},"2124":{"id":"/docs/introduction/concepts-0","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts","content":"The domain model behind Iggy, and how an append-only streaming log differs from a message broker."},"2125":{"id":"/docs/introduction/concepts-1","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#message-streaming","content":"Message streaming"},"2126":{"id":"/docs/introduction/concepts-2","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#append-only-log","content":"Append-only log"},"2127":{"id":"/docs/introduction/concepts-3","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#stream","content":"Stream"},"2128":{"id":"/docs/introduction/concepts-4","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#topic","content":"Topic"},"2129":{"id":"/docs/introduction/concepts-5","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#partition","content":"Partition"},"2130":{"id":"/docs/introduction/concepts-6","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#segment","content":"Segment"},"2131":{"id":"/docs/introduction/concepts-7","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#polling-messages","content":"Polling messages"},"2132":{"id":"/docs/introduction/concepts-8","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#consumer-groups","content":"Consumer groups"},"2133":{"id":"/docs/introduction/concepts-9","page_id":"/docs/introduction/concepts","type":"heading","tags":[],"url":"/docs/introduction/concepts#message-format","content":"Message format"},"2134":{"id":"/docs/introduction/concepts-10","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts","content":"Iggy is a persistent message streaming platform: messages are stored in a form of an append-only log. You can create multiple streams, consisting of topics, which might have one or more partitions assigned, e.g. to achieve the horizontal scalability between many independent consumers or higher system resiliency. You can think of Iggy as an alternative to Kafka or RabbitMQ streams."},"2135":{"id":"/docs/introduction/concepts-11","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-streaming","content":"You've probably used RabbitMQ or Kafka already. They look similar at the first glance, and you can achieve the similar results with both (e.g. publishing and consuming the events by the different applications built on top of microservices architecture), but they work differently underneath."},"2136":{"id":"/docs/introduction/concepts-12","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-streaming","content":"The main difference is that RabbitMQ (except the recently released Streams plugin) is the message broker, which means that it's responsible for delivering the messages to the consumers. It works in the FIFO (First In, First Out) manner and the messages are being kept in the queues. For example, if you have multiple, distinct consumers, then each one would create its own queue, the message would be replicated between each queue and each consumer would be responsible for reading the messages from its own queue. Once the message is processed, it's gone from the queue, so there's no built-in way to replay past the messages. The more consumers you have, the more queues you have to create, which might result in more resources being used. The typical message broker follows the so-called smart pipes and dumb endpoints pattern."},"2137":{"id":"/docs/introduction/concepts-13","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-streaming","content":"On the other hand, Kafka is a message streaming platform, meaning that it's not responsible for delivering the messages to the consumers, but rather it's storing them in a form of an append-only log. The consumers are responsible for reading the messages from the log and processing them. You might have multiple distinct consumers, and it doesn't affect the resource usage as there's only one log. The consumers can read the messages from the beginning, or from the specific offset, thus you can replay the messages. The typical message streaming platform follows the so-called dumb pipes and smart endpoints pattern."},"2138":{"id":"/docs/introduction/concepts-14","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-streaming","content":"Both approaches have advantages and disadvantages. The message broker is a more mature concept, but the message streaming platform is gaining more and more popularity, especially in the cloud-native world. And you can achieve much higher performance and throughput with the message streaming platform, since it acts as a simple database, being optimized for the append-only operations and can be queried in a very efficient way."},"2139":{"id":"/docs/introduction/concepts-15","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-streaming","content":"Iggy is the latter, a message streaming platform."},"2140":{"id":"/docs/introduction/concepts-16","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#append-only-log","content":"The append-only log is the core concept of Iggy. It's a simple data structure, which is optimized for the append-only operations. It's a sequence of records, that are being appended to the end of the log. The records are immutable, so that they can't be changed once they are written to the log. The records are being written in the order they are received, which results in the log being ordered."},"2141":{"id":"/docs/introduction/concepts-17","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#append-only-log","content":"You address the log by offset, the position of the record in the log. The offset is a simple integer that starts from 0 and is incremented by 1 for each record. When the client reads the records, it specifies the offset to start from and the maximum number of records it wants. Starting from the beginning, or from any earlier offset, is how you replay the messages."},"2142":{"id":"/docs/introduction/concepts-18","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#stream","content":"While we could put an equal sign between the log and the stream, they are not the same, at least in a case of Iggy streaming server.\nThe stream is a logical concept, and you might think of it as a namespace. For example, you could have a single stream for the whole system, or multiple streams e.g. representing the different environments, such as dev, staging and production. The stream is identified by its unique ID. The stream can have one or more topics assigned, which results in the records being published to the specific topics that belong to the particular stream."},"2143":{"id":"/docs/introduction/concepts-19","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#topic","content":"The topic is also the logical concept, which is a part of the stream. The topic is identified by its unique ID. You could think of topic as an entity being responsible for storing the specific type of the records. For example, you could have a topic for the user events, and another topic for the order events, etc."},"2144":{"id":"/docs/introduction/concepts-20","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#topic","content":"The messages are not being stored in the topic directly, but rather in the partitions, which are assigned to the topic. The topic can have one or more partitions assigned, that could help achieve higher parallelism and throughput. The topic can also have the retention policy assigned, which means that the records are being deleted automatically once they are older than the specified retention period. Topics also support maximum size limits and per-topic durability options (segment_size, enforce_fsync, flush thresholds) set at creation, plus a compression_algorithm option (a placeholder today: no compression is applied yet)."},"2145":{"id":"/docs/introduction/concepts-21","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#partition","content":"The partition has its own unique ID and belongs to the topic. The partition is responsible for storing the records. The records are being distributed between the partitions, therefore the partition acts as a simple database, which is optimized for the append-only operations. The partition is identified by its unique ID, which is an integer. Stream, topic and partition IDs are all assigned starting from 0, incremented by 1 for each new one. The partition ID is unique per topic, thus the same partition ID can be used in multiple topics."},"2146":{"id":"/docs/introduction/concepts-22","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#partition","content":"Thanks to having multiple partitions, we can achieve the horizontal scalability between many independent consumers, since each consumer can read the messages from the different partitions. This can be achieved by using more advanced concepts such as consumer groups."},"2147":{"id":"/docs/introduction/concepts-23","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#partition","content":"Each partition in the thread-per-core architecture is owned by exactly one shard and includes:"},"2148":{"id":"/docs/introduction/concepts-24","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#partition","content":"A SegmentedLog with sealed segments and one active segment"},"2149":{"id":"/docs/introduction/concepts-25","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#partition","content":"Consumer offsets and consumer group offsets"},"2150":{"id":"/docs/introduction/concepts-26","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#segment","content":"The segment, being a part of the partition, is the actual physical layer which stores the records in the binary format in a form of the files. Each segment has the limited size (1 GiB unless the topic sets its own segment_size) and once it's full, the new segment is being created automatically. The segment name is based on the start offset of the first record in the segment and is unique per partition."},"2151":{"id":"/docs/introduction/concepts-27","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#segment","content":"Each segment consists of:"},"2152":{"id":"/docs/introduction/concepts-28","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#segment","content":".log file - the actual message data"},"2153":{"id":"/docs/introduction/concepts-29","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#segment","content":".index file - positional and time indexes for fast lookups"},"2154":{"id":"/docs/introduction/concepts-30","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#polling-messages","content":"Consumers can poll the messages in multiple ways:"},"2155":{"id":"/docs/introduction/concepts-31","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#polling-messages","content":"By offset - start reading from the specified offset. The client tracks its own position."},"2156":{"id":"/docs/introduction/concepts-32","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#polling-messages","content":"By timestamp - start reading from the first message at or after the given timestamp."},"2157":{"id":"/docs/introduction/concepts-33","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#polling-messages","content":"First / Last - start from the beginning or the end of the partition."},"2158":{"id":"/docs/introduction/concepts-34","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#polling-messages","content":"Next - continue from the consumer offset stored on the server side. The client no longer needs to track the offset itself. Combine it with auto_commit: true to commit the offset automatically once the messages are fetched (at-most-once delivery), or call store_offset() explicitly after processing."},"2159":{"id":"/docs/introduction/concepts-35","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#consumer-groups","content":"Consumer groups provide horizontal scaling for message consumption. When multiple consumers join the same consumer group, the server automatically distributes partitions among group members so that each partition is consumed by exactly one member. When members join or leave, the server triggers a cooperative partition rebalancing with a pending revocation phase (configurable timeout, default 30s) to ensure smooth transitions without message loss."},"2160":{"id":"/docs/introduction/concepts-36","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"In the SDKs, each message carries a 64-byte in-memory header (little-endian fields). On the wire and on disk, messages travel inside batch records with a compact 48-byte per-message frame. See the Binary Protocol section for the exact encodings."},"2161":{"id":"/docs/introduction/concepts-37","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Field"},"2162":{"id":"/docs/introduction/concepts-38","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Bytes"},"2163":{"id":"/docs/introduction/concepts-39","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Type"},"2164":{"id":"/docs/introduction/concepts-40","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Description"},"2165":{"id":"/docs/introduction/concepts-41","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"checksum"},"2166":{"id":"/docs/introduction/concepts-42","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"0-8"},"2167":{"id":"/docs/introduction/concepts-43","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"u64"},"2168":{"id":"/docs/introduction/concepts-44","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"xxHash3 integrity checksum"},"2169":{"id":"/docs/introduction/concepts-45","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"id"},"2170":{"id":"/docs/introduction/concepts-46","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"8-24"},"2171":{"id":"/docs/introduction/concepts-47","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"u128"},"2172":{"id":"/docs/introduction/concepts-48","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Unique message ID (UUIDv4)"},"2173":{"id":"/docs/introduction/concepts-49","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"offset"},"2174":{"id":"/docs/introduction/concepts-50","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"24-32"},"2175":{"id":"/docs/introduction/concepts-51","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"u64"},"2176":{"id":"/docs/introduction/concepts-52","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Sequential offset in partition"},"2177":{"id":"/docs/introduction/concepts-53","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"timestamp"},"2178":{"id":"/docs/introduction/concepts-54","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"32-40"},"2179":{"id":"/docs/introduction/concepts-55","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"u64"},"2180":{"id":"/docs/introduction/concepts-56","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Server-assigned timestamp"},"2181":{"id":"/docs/introduction/concepts-57","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"origin_timestamp"},"2182":{"id":"/docs/introduction/concepts-58","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"40-48"},"2183":{"id":"/docs/introduction/concepts-59","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"u64"},"2184":{"id":"/docs/introduction/concepts-60","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Client-provided timestamp"},"2185":{"id":"/docs/introduction/concepts-61","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"user_headers_length"},"2186":{"id":"/docs/introduction/concepts-62","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"48-52"},"2187":{"id":"/docs/introduction/concepts-63","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"u32"},"2188":{"id":"/docs/introduction/concepts-64","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Length of optional headers"},"2189":{"id":"/docs/introduction/concepts-65","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"payload_length"},"2190":{"id":"/docs/introduction/concepts-66","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"52-56"},"2191":{"id":"/docs/introduction/concepts-67","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"u32"},"2192":{"id":"/docs/introduction/concepts-68","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Length of payload"},"2193":{"id":"/docs/introduction/concepts-69","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"reserved"},"2194":{"id":"/docs/introduction/concepts-70","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"56-64"},"2195":{"id":"/docs/introduction/concepts-71","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"u64"},"2196":{"id":"/docs/introduction/concepts-72","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"Reserved (must be 0)"},"2197":{"id":"/docs/introduction/concepts-73","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"After the header comes the optional user headers bytes, followed by the payload bytes."},"2198":{"id":"/docs/introduction/concepts-74","page_id":"/docs/introduction/concepts","tags":[],"type":"text","url":"/docs/introduction/concepts#message-format","content":"To see how the server schedules these concepts across CPU cores and stores them on disk, head over to architecture."},"2199":{"id":"/docs/introduction/getting-started","page_id":"/docs/introduction/getting-started","type":"page","content":"Getting started","breadcrumbs":["Documentation","Introduction"],"tags":[],"url":"/docs/introduction/getting-started"},"2200":{"id":"/docs/introduction/getting-started-0","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started","content":"A first program with the low-level Rust SDK: create a stream and topic, send messages, then poll them back."},"2201":{"id":"/docs/introduction/getting-started-1","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#before-we-start","content":"Before we start"},"2202":{"id":"/docs/introduction/getting-started-2","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#what-we-will-build","content":"What we will build"},"2203":{"id":"/docs/introduction/getting-started-3","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"Starting the Iggy server"},"2204":{"id":"/docs/introduction/getting-started-4","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#setting-up-the-project","content":"Setting up the project"},"2205":{"id":"/docs/introduction/getting-started-5","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#building-the-producer","content":"Building the producer"},"2206":{"id":"/docs/introduction/getting-started-6","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#building-the-consumer","content":"Building the consumer"},"2207":{"id":"/docs/introduction/getting-started-7","page_id":"/docs/introduction/getting-started","type":"heading","tags":[],"url":"/docs/introduction/getting-started#summary","content":"Summary"},"2208":{"id":"/docs/introduction/getting-started-8","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#before-we-start","content":"This tutorial uses the low-level Rust SDK to show how things work under the hood - creating streams, topics, sending and polling messages step by step. This is great for understanding the fundamentals."},"2209":{"id":"/docs/introduction/getting-started-9","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#before-we-start","content":"For real-world applications, you might typically prefer the high-level SDK, which provides IggyProducer and IggyConsumer builders with auto-batching, consumer groups, offset management, reconnection, and retry logic out of the box. Check the Stream Builder docs for the most ergonomic API."},"2210":{"id":"/docs/introduction/getting-started-10","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#before-we-start","content":"For examples in other programming languages, see the SDK section."},"2211":{"id":"/docs/introduction/getting-started-11","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#what-we-will-build","content":"We will build a producer (publishing messages to a stream) and a consumer (reading those messages back). In a real system, a service can be both at the same time - publishing its own events while consuming events from other services."},"2212":{"id":"/docs/introduction/getting-started-12","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#what-we-will-build","content":"The completed sample can be found in the repository. We will go through the implementation step by step so you get a clear understanding of how it all fits together."},"2213":{"id":"/docs/introduction/getting-started-13","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"For our purpose, we will focus on the basic scenario in order to keep things simple. Before we begin implementing the consumer and producer apps, we need to start the Iggy streaming server."},"2214":{"id":"/docs/introduction/getting-started-14","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"The quickest way is Docker, using the official images:"},"2215":{"id":"/docs/introduction/getting-started-15","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"SYS_NICE, the seccomp setting and the memlock limit are all required by io_uring and the thread-per-core architecture; see Docker & Helm for the details. IGGY_TCP_ADDRESS is needed because the server binds to 127.0.0.1 inside the container by default, which a published port cannot reach. IGGY_NODE_ADVERTISED_ADDRESS is needed because that wildcard leaves the server with no address to give clients, and it refuses to start rather than publish one nobody can dial. Here the port is published to the host, so localhost is that address. Setting the root credentials explicitly means the username and password used later in this guide will work."},"2216":{"id":"/docs/introduction/getting-started-16","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"Alternatively, build from source by cloning the repository and running:"},"2217":{"id":"/docs/introduction/getting-started-17","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"A bare iggy-server boot does not create the root user with the well-known iggy/iggy pair. It generates a random password and prints it exactly once to the logs. The --with-default-root-credentials flag switches to the development credentials (username: iggy, password: iggy), and --fresh wipes the data directory first, so the root user is created anew with them. You can also set IGGY_ROOT_USERNAME and IGGY_ROOT_PASSWORD yourself. The environment takes precedence over the flag, and only the first boot on an empty data directory reads these values."},"2218":{"id":"/docs/introduction/getting-started-18","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"All the data used by the server will be persisted under the local_data directory, unless specified differently in the configuration."},"2219":{"id":"/docs/introduction/getting-started-19","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#starting-the-iggy-server","content":"As long as the Iggy server is running, we're good to go. If you'd like to play with the configuration (e.g. change the addresses, ports, caching or so) you will find config.toml under core/server in the repository."},"2220":{"id":"/docs/introduction/getting-started-20","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#setting-up-the-project","content":"Let's start by creating a new project - simply type cargo new iggy-sample and open your newly created project with the favorite code editor."},"2221":{"id":"/docs/introduction/getting-started-21","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#setting-up-the-project","content":"At the very beginning, we will organize the files a little bit differently - create a new consumer directory under src and move the main.rs file here. You should have the following project structure:"},"2222":{"id":"/docs/introduction/getting-started-22","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#setting-up-the-project","content":"Then, open Cargo.toml and add the following code before the [dependencies]"},"2223":{"id":"/docs/introduction/getting-started-23","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#setting-up-the-project","content":"Just to make sure that everything is set correctly, try to run the app with cargo r --bin consumer."},"2224":{"id":"/docs/introduction/getting-started-24","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#setting-up-the-project","content":"Now, let's do the same for the producer part. Create a new producer directory, copy & paste the existing main.rs, and update the Cargo.toml with the following code:"},"2225":{"id":"/docs/introduction/getting-started-25","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#setting-up-the-project","content":"You should have the project structure as shown below:"},"2226":{"id":"/docs/introduction/getting-started-26","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#setting-up-the-project","content":"From that point on, we will focus on implementing the message streaming between our applications, starting with the producer."},"2227":{"id":"/docs/introduction/getting-started-27","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"We will begin with installing the Iggy client crate - execute cargo add iggy in your terminal. Next, install tokio.rs dependency with cargo add tokio as we will use the asynchronous runtime. Eventually, modify your main.rs, so it looks like this:"},"2228":{"id":"/docs/introduction/getting-started-28","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Let's instantiate a new connection to the server. As the description states, Iggy does support different transport protocols such as TCP, QUIC, WebSocket and HTTP, which is entirely true. Yet remember, we want to keep things as simple as possible here, thus, we will make use of the default implementation of IggyClient struct, which wraps the underlying raw client for one of the selected transports (in our scenario, this will be TcpClient)."},"2229":{"id":"/docs/introduction/getting-started-29","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"The default server address being 127.0.0.1:8090 is configured on the server side, and can be easily adjusted by updating config.toml in the core/server directory."},"2230":{"id":"/docs/introduction/getting-started-30","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"We could make use of more advanced components such as ClientProvider, pass the custom configuration built via console args to choose between the different protocols as all the available clients implement the same Client trait and so on."},"2231":{"id":"/docs/introduction/getting-started-31","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"If you're eager to find out how to build more advanced (and configurable) applications, check the Rust examples. Nevertheless, let's focus on implementing our producer side :)"},"2232":{"id":"/docs/introduction/getting-started-32","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Next, we need to authenticate the user, as all the available actions (except the ping and login) require the user to be authenticated and have the appropriate permissions e.g. you might be able to send or poll the messages, but you won't be able to create the stream or topic. For the sake of simplicity, we will use the development credentials for the root user (username: iggy, password: iggy), that can do anything and cannot be deleted. These credentials exist only because we started the server with them (the Docker env vars or the --with-default-root-credentials flag above). A server booted without them generates a random root password and prints it once to the logs. You can easily create more users and assign the specific permissions to them, however, this is out of scope for this tutorial."},"2233":{"id":"/docs/introduction/getting-started-33","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"When you start the application now, by running cargo r --bin producer it will execute immediately, however, you should be able to see the logs on Iggy server - connection should be accepted, user logged in, and then connection should be closed right away, meaning that we've just established our very first communication with the streaming server."},"2234":{"id":"/docs/introduction/getting-started-34","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Before we will move on with the code, let's include some logging in our apps as well (Iggy client already has some logging in place on different levels). Let's make use of the tracing.rs crates: cargo add tracing tracing_subscriber."},"2235":{"id":"/docs/introduction/getting-started-35","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"To make use of logging, simply invoke tracing_subscriber::fmt::init() at the beginning of main() method:"},"2236":{"id":"/docs/introduction/getting-started-36","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"From that point on, when starting the application, you should be able to see at least the basic logs, for example regarding the connection status. Keep in mind, that you can change the default log level by setting RUST_LOG environment variable, e.g. export RUST_LOG=trace (or other command depending on OS)."},"2237":{"id":"/docs/introduction/getting-started-37","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"So far, so good, however, before we will be able to publish any messages to our streaming server, at first, we need to create the stream, topic and partition(s) - if you're unfamiliar with these concepts, please refer to concepts where all of them are described in-depth."},"2238":{"id":"/docs/introduction/getting-started-38","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Since our IggyClient implements the common Client trait, you can find lots of the different methods to interact with the server, also from the administrative point of view, e.g. creating the streams, topics etc."},"2239":{"id":"/docs/introduction/getting-started-39","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"These methods are not idempotent - for example, if you were to try creating the stream with the same name which already exists on the server, you would receive the specific error. In such a case, you can simply check for an error and move on. When creating a stream, we only provide its name - the server assigns the numeric ID automatically. Stream, topic and partition IDs are all assigned starting from 0. Let's do this then :)"},"2240":{"id":"/docs/introduction/getting-started-40","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Every field of TopicCreateOptions left as None resolves to the server defaults. It's also where the per-topic durability knobs live: segment_size, enforce_fsync and the flush thresholds (messages_required_to_save, size_of_messages_required_to_save) can all be set at topic creation."},"2241":{"id":"/docs/introduction/getting-started-41","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Finally, let's send some messages into our stream. We will implement the basic loop with an interval between each iteration to simulate publishing the batch of messages. Since the streaming server works directly with the binary data, and couldn't care less about the (de)serialization format for the message payload, it's really up to you, how to efficiently stream the messages for your use case."},"2242":{"id":"/docs/introduction/getting-started-42","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"In our example, we will simply use the string payload, and pass it via from_str trait to construct the IggyMessage."},"2243":{"id":"/docs/introduction/getting-started-43","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Next, we need to call the appropriate method to send the messages to the server:"},"2244":{"id":"/docs/introduction/getting-started-44","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"As you might've already noticed, there are quite a few fields to be assigned. While some of them should be rather self-descriptive, let's discuss the identifier (created implicitly by using TryFrom on top of STREAM_NAME and TOPIC_NAME) and the partitioning which might be a little bit confusing at first, starting with the former."},"2245":{"id":"/docs/introduction/getting-started-45","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Whenever we interact with the streaming server in terms of e.g. sending or polling the messages, managing the streams, topics etc. we need to provide the unique identifier of the stream and the topic that we want to use. Since each stream and topic have a unique numeric ID, as well as a unique name, we can use either of them. Here, we use the string name by calling Identifier::named() (implicitly via TryFrom on a &str), however, you can also use the numeric identifier by invoking the Identifier::numeric() method instead. It's up to your preference if you'd rather work with the identifier being a number or string when building your applications."},"2246":{"id":"/docs/introduction/getting-started-46","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Next, let's move onto the partitioning field:"},"2247":{"id":"/docs/introduction/getting-started-47","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"In our scenario, we simply make use of PartitioningKind::PartitionId (by invoking the helper method partition_id()) meaning that we want to send the messages to the specified partition ID - in that case, the length will be 4 bytes (as the partition ID is of type u32), and the value will be the actual partition ID encoded as the bytes array."},"2248":{"id":"/docs/introduction/getting-started-48","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"However, once your system grows, you might want to parallelize the messages across the independent consumers, in order to achieve the horizontal scaling, higher resiliency etc. In that case, you might consider using either PartitioningKind::Balanced (the SDK picks the next partition using a client-local round-robin e.g. 0->1->2->0->1->2 etc.) or PartitioningKind::MessagesKey instead (e.g. by invoking one of the helper methods messages_key()), where the value wouldn't be a partition ID anymore (the SDK hashes the provided value with xxHash32 modulo the partition count), but, as the name states, some kind of identifier, which is unique for all the messages that should have guaranteed ordering. The HTTP API instead sends the chosen strategy to the server, which resolves it at admission."},"2249":{"id":"/docs/introduction/getting-started-49","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"For example, given that you process the set of messages related to the specific order ID (e.g. created, confirmed, paid, delivered etc.), you could use that as a key value to ensure that all the messages which are part of the specific workflow, will always be put onto the same partition. The value of the key can be anything (e.g. string, number) with the maximum length of 255 bytes."},"2250":{"id":"/docs/introduction/getting-started-50","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Anyway, let's get back to our scenario, and consider the following code responsible for publishing the messages:"},"2251":{"id":"/docs/introduction/getting-started-51","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"The reason behind passing a mutable reference is that the underlying client (especially when using the IggyClient wrapper on top of the low-level client) might want to modify the command before sending it to the server. For example, the client might want to encrypt the payload, include the default headers, or provide a custom Partitioner implementation etc. thus by using &mut we can avoid copying the command each time."},"2252":{"id":"/docs/introduction/getting-started-52","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-producer","content":"Finally, let's complete the implementation of the producer - once you start the application after the latest changes, you shall see the messages being sent to the newly created stream."},"2253":{"id":"/docs/introduction/getting-started-53","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"The consumer part will be rather easy to implement. Just like on the producer side, we want to make use of the asynchronous runtime, logging and last but not least, the same Client trait. Let's find out, how we can make use of the poll_messages method, to fetch the messages from the stream. Consider the following code:"},"2254":{"id":"/docs/introduction/getting-started-54","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"At the first glance, it might look a bit more complicated than send_messages function, so let's discuss the fields one by one:"},"2255":{"id":"/docs/introduction/getting-started-55","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"stream_id - the ID of the stream (numeric or string) from which we want to poll the messages."},"2256":{"id":"/docs/introduction/getting-started-56","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"topic_id - the ID of the topic (numeric or string) from which we want to poll the messages."},"2257":{"id":"/docs/introduction/getting-started-57","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"partition_id - the ID of the partition from which we want to poll the messages. The partition has to be specified for the regular Consumer, while for the ConsumerGroup it's ignored (None value), as the server will automatically assign the partition to the consumer from the group."},"2258":{"id":"/docs/introduction/getting-started-58","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"consumer - the type of the consumer (kind + ID), either the default Consumer means the standalone client which does the message polling on its own, independently of the other consumers (unless they would use the same ID), or the ConsumerGroup which might be used to create the group of consumers sharing the common identifier - this is especially useful in the case of the horizontal scaling, where we want to ensure, that the same (and only one) consumer, will poll the messages from the specific partition, and there will be no overlap with the other consumers from the same group. For example, when scaling out (by adding more instances) the group of payment processing microservices, we probably don't want the multiple instances to process the same payment."},"2259":{"id":"/docs/introduction/getting-started-59","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"strategy - the way in which we want to poll the messages. The default one being Offset (underlying PollingKind enum) means that we will start polling the messages from the particular offset provided in the value field - it's on the client, to keep track of the most recent offset. On the other hand, we could also use the different kind, for example Next, which means, that the next messages will be returned to the client, depending on the so-called consumer offset value stored on the server side. The client may not need to track the offset on its own anymore, but instead, call store_offset() to save it on the server (e.g. after each processed message or the whole batch), or make use of  auto_commit: true, to automatically commit the offset on the server side, once the messages are fetched (this one results in the so called at-most-once delivery mode)."},"2260":{"id":"/docs/introduction/getting-started-60","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"count - amount of the messages that the consumer would like to receive in the single response from the server."},"2261":{"id":"/docs/introduction/getting-started-61","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"auto_commit - whether the consumer offset should be automatically committed on the server side, once the messages are fetched."},"2262":{"id":"/docs/introduction/getting-started-62","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"Next, let's take a look at the following method responsible for polling the messages based on the specified interval."},"2263":{"id":"/docs/introduction/getting-started-63","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"And here's the final code for our consumer application:"},"2264":{"id":"/docs/introduction/getting-started-64","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#building-the-consumer","content":"Start the Iggy server, and then producer and consumer applications respectively - you should observe your messages being streamed flawlessly :)"},"2265":{"id":"/docs/introduction/getting-started-65","page_id":"/docs/introduction/getting-started","tags":[],"type":"text","url":"/docs/introduction/getting-started#summary","content":"What we've just achieved is merely the tip of an iceberg, however, it should give you a good understanding of what Iggy is all about, and hopefully, it wasn't too difficult to follow and get things up and running for the first time. Feel free to take a look at the more advanced examples, how to make use of IggyClient wrapper on top of the existing implementations of the Client trait, what happens when you start multiple producers and consumers and so on. Happy tweaking! :)"},"2266":{"id":"/docs/sdk/connection-strings","page_id":"/docs/sdk/connection-strings","type":"page","content":"Connection Strings","breadcrumbs":["Documentation","SDK"],"tags":[],"url":"/docs/sdk/connection-strings"},"2267":{"id":"/docs/sdk/connection-strings-0","page_id":"/docs/sdk/connection-strings","tags":[],"type":"text","url":"/docs/sdk/connection-strings","content":"The canonical reference for Iggy connection strings, covering every scheme, credential form and option."},"2268":{"id":"/docs/sdk/connection-strings-1","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#format","content":"Format"},"2269":{"id":"/docs/sdk/connection-strings-2","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#transport-selection","content":"Transport selection"},"2270":{"id":"/docs/sdk/connection-strings-3","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#credentials","content":"Credentials"},"2271":{"id":"/docs/sdk/connection-strings-4","page_id":"/docs/sdk/connection-strings","type":"heading","tags":[],"url":"/docs/sdk/connection-strings#duration-values","content":"Duration values"},"2272":{"id":"/docs/sdk/connection-strings-5","page_id":"/docs/sdk/