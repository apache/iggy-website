s/connectors/sinks/doris#common-options","content":"required"},"4339":{"id":"/docs/connectors/sinks/doris-35","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Doris user password, never logged"},"4340":{"id":"/docs/connectors/sinks/doris-36","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"batch_size"},"4341":{"id":"/docs/connectors/sinks/doris-37","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"u32"},"4342":{"id":"/docs/connectors/sinks/doris-38","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"1000"},"4343":{"id":"/docs/connectors/sinks/doris-39","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Maximum messages per Stream Load request; 0 is treated as 1"},"4344":{"id":"/docs/connectors/sinks/doris-40","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"output_format"},"4345":{"id":"/docs/connectors/sinks/doris-41","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"4346":{"id":"/docs/connectors/sinks/doris-42","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"json"},"4347":{"id":"/docs/connectors/sinks/doris-43","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"json or csv; CSV is opt-in for throughput and requires columns"},"4348":{"id":"/docs/connectors/sinks/doris-44","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"columns"},"4349":{"id":"/docs/connectors/sinks/doris-45","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"4350":{"id":"/docs/connectors/sinks/doris-46","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"unset"},"4351":{"id":"/docs/connectors/sinks/doris-47","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Forwarded as the columns Stream Load header; pins column order for CSV"},"4352":{"id":"/docs/connectors/sinks/doris-48","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"timeout"},"4353":{"id":"/docs/connectors/sinks/doris-49","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"string"},"4354":{"id":"/docs/connectors/sinks/doris-50","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"30s"},"4355":{"id":"/docs/connectors/sinks/doris-51","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Per-request HTTP timeout, including each redirect request"},"4356":{"id":"/docs/connectors/sinks/doris-52","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"max_retries"},"4357":{"id":"/docs/connectors/sinks/doris-53","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"u32"},"4358":{"id":"/docs/connectors/sinks/doris-54","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"3"},"4359":{"id":"/docs/connectors/sinks/doris-55","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Total Stream Load attempts per chunk on transient failures; 0 or 1 means one attempt"},"4360":{"id":"/docs/connectors/sinks/doris-56","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#common-options","content":"Further options cover the label prefix, connect timeout, retry backoff (retry_delay, max_retry_delay), max_filter_ratio, a where filter, and redirect security (allow_insecure_redirect, allowed_redirect_hosts). See the upstream doris_sink README for the full table with defaults."},"4361":{"id":"/docs/connectors/sinks/doris-57","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#output-formats","content":"json (default): payloads are sent as a JSON array with strip_outer_array: true. Values map to columns by name, so the JSON shape must match the table (use columns if the JSON field names differ from the table columns or you need derived expressions)."},"4362":{"id":"/docs/connectors/sinks/doris-58","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#output-formats","content":"csv: opt-in for throughput. Doris CSV is positional, so output_format = \"csv\" requires columns to pin the column order. Startup fails without it. List bare JSON field names in order before any derived expressions in columns; CSV reads only the leading names before the first = expression. Rows are framed with control-character separators and quoted with enclose/escape, so embedded commas and newlines are safe. JSON null and missing keys become SQL NULL, empty strings remain empty, and nested objects or arrays are stringified as JSON. The target Doris column types must accept the resulting values."},"4363":{"id":"/docs/connectors/sinks/doris-59","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#delivery-semantics","content":"Each poll is split into chunks of at most batch_size messages. Each chunk gets a deterministic label based on label_prefix, the target table, stream, topic, partition, and first/last offsets. Transient failures (HTTP 5xx/408/429, transport errors, empty or unreadable successful responses) are retried under the same label. Backoff starts at retry_delay, doubles for each retry, applies ±20% jitter, and never exceeds max_retry_delay. Other HTTP 4xx responses, Fail status, and nonempty malformed responses are permanent errors and are not retried."},"4364":{"id":"/docs/connectors/sinks/doris-60","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#delivery-semantics","content":"Label Already Exists is accepted only when the existing job is FINISHED; RUNNING and CANCELLED are retried. Publish Timeout is accepted as committed, although rows may not yet be visible. Deduplication lasts only while Doris retains the label. Check the retention settings for your Doris version; Doris 4.0.3 uses streaming_label_keep_max_second (default 12 hours) for Stream Load. See Doris FE configuration."},"4365":{"id":"/docs/connectors/sinks/doris-61","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#delivery-semantics","content":"The runtime uses consumer auto-commit before the sink finishes. After a chunk fails, the plugin still attempts later chunks and returns the first error. The runtime logs and counts that error, adds no processed messages for the failed batch, and continues polling without replaying it. A crash or exhausted retry budget can therefore lose data. A non-JSON payload aborts the remaining chunks immediately."},"4366":{"id":"/docs/connectors/sinks/doris-62","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#delivery-semantics","content":"For a manual redrive, preserve the label inputs and chunk boundaries, including both batch_length and batch_size. Poll sizes can also vary, so unchanged settings alone do not guarantee the same labels. Changed boundaries or expired labels can produce duplicates. This is not an end-to-end exactly-once guarantee."},"4367":{"id":"/docs/connectors/sinks/doris-63","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#delivery-semantics","content":"If max_filter_ratio permits malformed rows, Doris can accept a load while dropping those rows; the plugin logs a warning when Doris reports them. The where option deliberately excludes rows before loading."},"4368":{"id":"/docs/connectors/sinks/doris-64","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#security-notes","content":"Use https:// for fe_url in production: credentials travel as HTTP Basic auth."},"4369":{"id":"/docs/connectors/sinks/doris-65","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#security-notes","content":"The connector preserves the Authorization header across Doris FE-to-BE 307/308 redirects, validating each target first. When fe_url uses HTTPS, an HTTP redirect target is refused unless allow_insecure_redirect = true. Location must be absolute, and at most five redirects are followed per attempt. A nonempty allowed_redirect_hosts list restricts destinations to the listed hosts or host:port endpoints; an unset or empty list does not restrict hosts."},"4370":{"id":"/docs/connectors/sinks/doris-66","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#security-notes","content":"columns and where are forwarded verbatim to Doris and evaluated as SQL expressions. Keep this config trusted."},"4371":{"id":"/docs/connectors/sinks/doris-67","page_id":"/docs/connectors/sinks/doris","tags":[],"type":"text","url":"/docs/connectors/sinks/doris#transforms","content":"Transforms can be applied before loading into Doris. See the transforms documentation for the available types and their configuration."},"4372":{"id":"/docs/connectors/sinks/elasticsearch","page_id":"/docs/connectors/sinks/elasticsearch","type":"page","content":"Elasticsearch Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/elasticsearch"},"4373":{"id":"/docs/connectors/sinks/elasticsearch-0","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch","content":"Index messages from Iggy streams into an Elasticsearch index using the bulk API."},"4374":{"id":"/docs/connectors/sinks/elasticsearch-1","page_id":"/docs/connectors/sinks/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/elasticsearch#configuration","content":"Configuration"},"4375":{"id":"/docs/connectors/sinks/elasticsearch-2","page_id":"/docs/connectors/sinks/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/elasticsearch#plugin-config-options","content":"Plugin config options"},"4376":{"id":"/docs/connectors/sinks/elasticsearch-3","page_id":"/docs/connectors/sinks/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/elasticsearch#index-mapping","content":"Index mapping"},"4377":{"id":"/docs/connectors/sinks/elasticsearch-4","page_id":"/docs/connectors/sinks/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sinks/elasticsearch#payload-handling","content":"Payload handling"},"4378":{"id":"/docs/connectors/sinks/elasticsearch-5","page_id":"/docs/connectors/sinks/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sinks/elasticsearch","content":"The Elasticsearch sink connector consumes messages from Iggy streams and indexes them into an Elasticsearch index using the bulk API."},"4379":{"id":"/docs/connectors/sinks/elasticsearch-6","page_id":"/docs/connectors/sink