tion#systemsharding","content":"Per-shard inter-shard inbox capacity. Bounded by design; size for the consensus working set plus peak client-reply fan-out. Raising [metadata] or [partition] prepare_queue_depth raises the capacity needed here."},"3010":{"id":"/docs/server/configuration-440","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#systemsharding","content":"shutdown_drain_timeout"},"3011":{"id":"/docs/server/configuration-441","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#systemsharding","content":"\"10 s\""},"3012":{"id":"/docs/server/configuration-442","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#systemsharding","content":"Per-shard bus drain budget on shutdown. Slow-fsync hosts may need more."},"3013":{"id":"/docs/server/configuration-443","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#systemsharding","content":"shutdown_poll_interval"},"3014":{"id":"/docs/server/configuration-444","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#systemsharding","content":"\"50 ms\""},"3015":{"id":"/docs/server/configuration-445","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#systemsharding","content":"Poll cadence for the shutdown flag. Must be less than or equal to shutdown_drain_timeout."},"3016":{"id":"/docs/server/configuration-446","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#systemsharding","content":"shutdown_join_timeout"},"3017":{"id":"/docs/server/configuration-447","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#systemsharding","content":"\"30 s\""},"3018":{"id":"/docs/server/configuration-448","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#systemsharding","content":"Hard deadline for joining shard threads at exit; a wedged shard is abandoned with an error log. Must be at least shutdown_drain_timeout."},"3019":{"id":"/docs/server/configuration-449","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#systemsharding","content":"reconcile_periodic_interval"},"3020":{"id":"/docs/server/configuration-450","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#systemsharding","content":"\"1 s\""},"3021":{"id":"/docs/server/configuration-451","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#systemsharding","content":"Safety tick for the partition reconciliation loop, which also wakes on every metadata commit."},"3022":{"id":"/docs/server/configuration-452","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#systemsharding","content":"Valid cpu_allocation syntaxes:"},"3023":{"id":"/docs/server/configuration-453","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#systemsharding","content":"\"all\": one shard per available CPU core"},"3024":{"id":"/docs/server/configuration-454","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#systemsharding","content":"a number, e.g. 4: four shards pinned to cores 0 to 3"},"3025":{"id":"/docs/server/configuration-455","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#systemsharding","content":"a range, e.g. \"5..8\": three shards on cores 5, 6, 7"},"3026":{"id":"/docs/server/configuration-456","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#systemsharding","content":"\"numa:auto\": all NUMA nodes and cores, NUMA-aware"},"3027":{"id":"/docs/server/configuration-457","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#systemsharding","content":"\"numa:nodes=0,1;cores=4;no_ht=true\": NUMA nodes 0 and 1, four cores each, no hyperthreads"},"3028":{"id":"/docs/server/configuration-458","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"Tunables for the metadata consensus plane (shard 0's VSR replica: users, streams, topics, sessions)."},"3029":{"id":"/docs/server/configuration-459","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"Key"},"3030":{"id":"/docs/server/configuration-460","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"Default"},"3031":{"id":"/docs/server/configuration-461","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"Description"},"3032":{"id":"/docs/server/configuration-462","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"prepare_queue_depth"},"3033":{"id":"/docs/server/configuration-463","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"32"},"3034":{"id":"/docs/server/configuration-464","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"Uncommitted metadata ops in flight at once. Submits beyond it are rejected with a transient error the SDKs retry. Capped at 127 by the view-change wire format."},"3035":{"id":"/docs/server/configuration-465","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"journal_slots"},"3036":{"id":"/docs/server/configuration-466","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"1024"},"3037":{"id":"/docs/server/configuration-467","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"In-memory index of the metadata WAL, in slots. Larger buys more headroom between forced checkpoints at the cost of memory and bigger WAL rewrites. Boot enforces journal_slots >= 4 x max(64, prepare_queue_depth)."},"3038":{"id":"/docs/server/configuration-468","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"clients_table_max"},"3039":{"id":"/docs/server/configuration-469","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"8192"},"3040":{"id":"/docs/server/configuration-470","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#metadata","content":"Slots in the VSR client table: how many distinct clients (TCP/QUIC/WebSocket virtual clients and HTTP sessions together) hold live session state. When full, the client with the oldest last commit is evicted and re-registers on its next request. The HTTP session cap tracks this at half. Must be between 2 and 65536."},"3041":{"id":"/docs/server/configuration-471","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Per-partition consensus plane tunables. Unlike [metadata] (one plane on shard 0), a pipeline exists per partition, so raising these multiplies pinned memory by the partition count."},"3042":{"id":"/docs/server/configuration-472","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Key"},"3043":{"id":"/docs/server/configuration-473","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Default"},"3044":{"id":"/docs/server/configuration-474","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Description"},"3045":{"id":"/docs/server/configuration-475","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"prepare_queue_depth"},"3046":{"id":"/docs/server/configuration-476","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"32"},"3047":{"id":"/docs/server/configuration-477","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Uncommitted produce and consumer-offset ops in flight per partition. Submits past it spill into a request queue of twice this depth; once both are full the server drops the request without a reply and the client retries on its own timeout. Must be between 1 and 127."},"3048":{"id":"/docs/server/configuration-478","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"evicted_ring_capacity"},"3049":{"id":"/docs/server/configuration-479","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"4096"},"3050":{"id":"/docs/server/configuration-480","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Entries retained per multi-replica partition for journal repair after a peer rejoins. Must be between 1 and 65536. Single-replica partitions retain nothing."},"3051":{"id":"/docs/server/configuration-481","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"evicted_ring_bytes_max"},"3052":{"id":"/docs/server/configuration-482","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"\"16 MiB\""},"3053":{"id":"/docs/server/configuration-483","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Byte ceiling for the evicted ring; whichever ring cap trips first evicts. At most \"256 MiB\"."},"3054":{"id":"/docs/server/configuration-484","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"transfer_served_cache_bytes_max"},"3055":{"id":"/docs/server/configuration-485","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"\"2176 MiB\""},"3056":{"id":"/docs/server/configuration-486","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Byte budget, per shard, for segment payloads kept resident to serve state-transfer chunk requests. The default fits two sealed segments at the 1 GiB ceiling, each with one max-message overshoot. Serving concurrency is floor(this / max(transfer_artifact_bytes_max, 1 GiB + 64 MiB)), minimum one; boot warns when it drops below two. At most \"64 GiB\"."},"3057":{"id":"/docs/server/configuration-487","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"transfer_artifact_bytes_max"},"3058":{"id":"/docs/server/configuration-488","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"\"1088 MiB\""},"3059":{"id":"/docs/server/configuration-489","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#partition","content":"Allocation ceiling for one received state-transfer artifact, per shard (up to four transfers run at once). Boot enforces the floor 1 GiB + message_bus.max_message_size; the shipped value sits exactly at it. Raising message_bus.max_message_size alone therefore refuses boot: raise this by the same amount in the same edit. At most \"64 GiB\"."},"3060":{"id":"/docs/server/configuration-490","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Tunables for the internal bus that ships consensus traffic between replicas and client traffic between shards."},"3061":{"id":"/docs/server/configuration-491","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Key"},"3062":{"id":"/docs/server/configuration-492","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Default"},"3063":{"id":"/docs/server/configuration-493","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Description"},"3064":{"id":"/docs/server/configuration-494","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"max_batch"},"3065":{"id":"/docs/server/configuration-495","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"256"},"3066":{"id":"/docs/server/configuration-496","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Messages coalesced into one writev(2) call. Hard upper bound 512 (IOV_MAX/2 on Linux)."},"3067":{"id":"/docs/server/configuration-497","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"max_message_size"},"3068":{"id":"/docs/server/configuration-498","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"\"64 MiB\""},"3069":{"id":"/docs/server/configuration-499","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Wire-level cap on a single framed message. Coupled to partition.transfer_artifact_bytes_max and websocket.max_message_size (see those keys)."},"3070":{"id":"/docs/server/configuration-500","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"peer_queue_capacity"},"3071":{"id":"/docs/server/configuration-501","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"256"},"3072":{"id":"/docs/server/configuration-502","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Bound on the per-peer queue. cluster.repair_chunk_max must stay strictly below it."},"3073":{"id":"/docs/server/configuration-503","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"reconnect_period"},"3074":{"id":"/docs/server/configuration-504","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"\"5 s\""},"3075":{"id":"/docs/server/configuration-505","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Interval between outbound reconnect attempts to peers."},"3076":{"id":"/docs/server/configuration-506","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"close_peer_timeout"},"3077":{"id":"/docs/server/configuration-507","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"\"2 s\""},"3078":{"id":"/docs/server/configuration-508","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Per-peer close drain budget before force-cancellation."},"3079":{"id":"/docs/server/configuration-509","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"close_grace"},"3080":{"id":"/docs/server/configuration-510","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"\"2 s\""},"3081":{"id":"/docs/server/configuration-511","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Bound on a single stream shutdown in the TLS-family transports."},"3082":{"id":"/docs/server/configuration-512","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"handshake_grace"},"3083":{"id":"/docs/server/configuration-513","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"\"10 s\""},"3084":{"id":"/docs/server/configuration-514","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#message_bus","content":"Bound on a connection's handshake phase, so a slowloris peer cannot pin per-connection resources indefinitely."},"3085":{"id":"/docs/server/configuration-515","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"Key"},"3086":{"id":"/docs/server/configuration-516","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"Default"},"3087":{"id":"/docs/server/configuration-517","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"Description"},"3088":{"id":"/docs/server/configuration-518","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"max_tokens_per_user"},"3089":{"id":"/docs/server/configuration-519","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"100"},"3090":{"id":"/docs/server/configuration-520","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"Maximum active tokens per user."},"3091":{"id":"/docs/server/configuration-521","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"personal_access_token.cleaner.enabled"},"3092":{"id":"/docs/server/configuration-522","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"true"},"3093":{"id":"/docs/server/configuration-523","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"Periodically remove expired tokens."},"3094":{"id":"/docs/server/configuration-524","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"personal_access_token.cleaner.interval"},"3095":{"id":"/docs/server/configuration-525","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"\"1 m\""},"3096":{"id":"/docs/server/configuration-526","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#personal_access_token","content":"Cleaner run interval."},"3097":{"id":"/docs/server/configuration-527","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#consumer_group","content":"Key"},"3098":{"id":"/docs/server/configuration-528","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#consumer_group","content":"Default"},"3099":{"id":"/docs/server/configuration-529","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#consumer_group","content":"Description"},"3100":{"id":"/docs/server/configuration-530","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#consumer_group","content":"rebalancing_timeout"},"3101":{"id":"/docs/server/configuration-531","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#consumer_group","content":"\"30s\""},"3102":{"id":"/docs/server/configuration-532","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#consumer_group","content":"Maximum time a partition can remain in pending revocation before being force-transferred to the target member."},"3103":{"id":"/docs/server/configuration-533","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#node","content":"This node's own client-facing identity. The address is read only while cluster.enabled = false: in cluster mode the roster answers the same question per node, so the address itself is ignored and the server says so at startup. The key is still validated in every mode, so a malformed value refuses boot even with cluster.enabled = true."},"3104":{"id":"/docs/server/configuration-534","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#node","content":"Key"},"3105":{"id":"/docs/server/configuration-535","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#node","content":"Default"},"3106":{"id":"/docs/server/configuration-536","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#node","content":"Description"},"3107":{"id":"/docs/server/configuration-537","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#node","content":"advertised_address"},"3108":{"id":"/docs/server/configuration-538","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#node","content":"unset"},"3109":{"id":"/docs/server/configuration-539","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#node","content":"The address clients dial, published in cluster metadata. A literal IP or a DNS hostname. Left unset, the server derives it from the bind address of the first enabled listener; that fails when the listener binds a wildcard, and the server refuses to start rather than publish an address no client can use. Declaring the unspecified address (0.0.0.0, ::) is refused for the same reason."},"3110":{"id":"/docs/server/configuration-540","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Cluster mode is configured here but documented in Clustering. The section contains:"},"3111":{"id":"/docs/server/configuration-541","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Key"},"3112":{"id":"/docs/server/configuration-542","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Default"},"3113":{"id":"/docs/server/configuration-543","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"One-liner"},"3114":{"id":"/docs/server/configuration-544","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"enabled"},"3115":{"id":"/docs/server/configuration-545","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"false"},"3116":{"id":"/docs/server/configuration-546","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Participate in a cluster. Requires --replica-id at launch."},"3117":{"id":"/docs/server/configuration-547","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"name"},"3118":{"id":"/docs/server/configuration-548","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"iggy-cluster\""},"3119":{"id":"/docs/server/configuration-549","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Permanent cluster identity, hashed into every superblock on first boot. Renaming against existing data refuses start."},"3120":{"id":"/docs/server/configuration-550","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"heartbeat_timeout"},"3121":{"id":"/docs/server/configuration-551","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"5s\""},"3122":{"id":"/docs/server/configuration-552","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Primary liveness window; a silent primary triggers a view change. At least \"2s\" and at least 4 x commit_broadcast_interval."},"3123":{"id":"/docs/server/configuration-553","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"commit_broadcast_interval"},"3124":{"id":"/docs/server/configuration-554","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"500ms\""},"3125":{"id":"/docs/server/configuration-555","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"How often the primary broadcasts its commit point; this is the liveness signal."},"3126":{"id":"/docs/server/configuration-556","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"prepare_retransmit_interval"},"3127":{"id":"/docs/server/configuration-557","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"250ms\""},"3128":{"id":"/docs/server/configuration-558","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Retransmit cadence for unacknowledged prepares."},"3129":{"id":"/docs/server/configuration-559","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"view_change_retransmit_interval"},"3130":{"id":"/docs/server/configuration-560","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"500ms\""},"3131":{"id":"/docs/server/configuration-561","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Retransmit cadence during a view change."},"3132":{"id":"/docs/server/configuration-562","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"view_change_status_timeout"},"3133":{"id":"/docs/server/configuration-563","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"5s\""},"3134":{"id":"/docs/server/configuration-564","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Backstop for a stalled view change; escalates to a fresh election. At least 4 x view_change_retransmit_interval."},"3135":{"id":"/docs/server/configuration-565","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"request_start_view_retransmit_interval"},"3136":{"id":"/docs/server/configuration-566","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"1s\""},"3137":{"id":"/docs/server/configuration-567","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Re-request cadence for the current view's StartView."},"3138":{"id":"/docs/server/configuration-568","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"view_probe_attempts_max"},"3139":{"id":"/docs/server/configuration-569","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"5"},"3140":{"id":"/docs/server/configuration-570","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Unanswered probes a recovering replica tolerates before electing on its recovered log. Between 1 and 100."},"3141":{"id":"/docs/server/configuration-571","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"repair_retry_interval"},"3142":{"id":"/docs/server/configuration-572","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"\"1s\""},"3143":{"id":"/docs/server/configuration-573","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Re-request cadence for a stalled journal-repair stream."},"3144":{"id":"/docs/server/configuration-574","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"repair_chunk_max"},"3145":{"id":"/docs/server/configuration-575","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"128"},"3146":{"id":"/docs/server/configuration-576","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Prepares served per repair round. Must stay strictly below message_bus.peer_queue_capacity. Between 1 and 1024."},"3147":{"id":"/docs/server/configuration-577","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Durations are rounded down to the consensus 10 ms tick. Values under 10 ms become one tick."},"3148":{"id":"/docs/server/configuration-578","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"Sub-sections:"},"3149":{"id":"/docs/server/configuration-579","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"[cluster.auth]: replica-to-replica authentication (PSK plus BLAKE3 keyed-MAC handshake). shared_secret must be at least 32 bytes of CSPRNG output, identical on every node. Prefer IGGY_CLUSTER_AUTH_SHARED_SECRET. previous_shared_secret enables rolling key rotation."},"3150":{"id":"/docs/server/configuration-580","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"[cluster.tls]: TLS 1.3 on the replica port. Requires cluster.auth.enabled. The PSK authenticates the peer, TLS supplies confidentiality."},"3151":{"id":"/docs/server/configuration-581","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#cluster","content":"[[cluster.nodes]]: the full roster, byte-identical on every node. Each entry has name, ip, replica_id, and ports (tcp, quic, http, websocket, tcp_replica). In cluster mode ports is the single source of listener ports: every enabled transport needs an explicit per-node port or the server refuses to start. advertised_address and per-CIDR advertised_addresses selectors control what clients are told to dial."},"3152":{"id":"/docs/server/docker","page_id":"/docs/server/docker","type":"page","content":"Docker & Helm","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/docker"},"3153":{"id":"/docs/server/docker-0","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker","content":"Run the Iggy server from the official Docker images, and deploy it with the Helm chart."},"3154":{"id":"/docs/server/docker-1","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#docker","content":"Docker"},"3155":{"id":"/docs/server/docker-2","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#why-these-capabilities","content":"Why these capabilities?"},"3156":{"id":"/docs/server/docker-3","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#available-images","content":"Available images"},"3157":{"id":"/docs/server/docker-4","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#building-from-source","content":"Building from source"},"3158":{"id":"/docs/server/docker-5","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#running-the-cli-inside-the-container","content":"Running the CLI inside the container"},"3159":{"id":"/docs/server/docker-6","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#helm-charts","content":"Helm charts"},"3160":{"id":"/docs/server/docker-7","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#quick-start","content":"Quick start"},"3161":{"id":"/docs/server/docker-8","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#chart-components","content":"Chart components"},"3162":{"id":"/docs/server/docker-9","page_id":"/docs/server/docker","type":"heading","tags":[],"url":"/docs/server/docker#key-values","content":"Key values"},"3163":{"id":"/docs/server/docker-10","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"You can easily run the Iggy server with Docker - the official images can be found here, simply type docker pull apache/iggy."},"3164":{"id":"/docs/server/docker-11","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"Two properties of the published image matter for any deployment:"},"3165":{"id":"/docs/server/docker-12","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"The working directory is /app and the iggy-server and iggy binaries are on PATH (/usr/local/bin). The default data directory local_data therefore resolves to /app/local_data - mount your volume there, or set IGGY_SYSTEM_PATH and mount that path instead."},"3166":{"id":"/docs/server/docker-13","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"The image bakes in no address overrides, so the server binds the loopback defaults (127.0.0.1) and is unreachable from outside the container even with published ports. Set IGGY_TCP_ADDRESS=0.0.0.0:8090 (and the equivalent for every other transport you expose) alongside the -p flags."},"3167":{"id":"/docs/server/docker-14","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"The wildcard says nothing about where clients reach the container, so the server refuses to start until IGGY_NODE_ADVERTISED_ADDRESS supplies that address. Use localhost when the ports are published to the host, the compose service name when the clients are containers on the same network, and the external hostname or load balancer name when they are further away. The value reaches clients through cluster metadata, where it is the endpoint they reconnect through."},"3168":{"id":"/docs/server/docker-15","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"Below is an example docker-compose.yml which overrides the default configuration (see Configuration) with environment variables. If you prefer using the configuration file, you can mount it as a volume and provide the path to it with the IGGY_CONFIG_PATH environment variable."},"3169":{"id":"/docs/server/docker-16","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"When running the container, make sure to include the additional capabilities required by io_uring and CPU affinity:"},"3170":{"id":"/docs/server/docker-17","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#docker","content":"Or when running with docker run:"},"3171":{"id":"/docs/server/docker-18","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#why-these-capabilities","content":"SYS_NICE - required for setting CPU affinity (sched_setaffinity) in the thread-per-core architecture"},"3172":{"id":"/docs/server/docker-19","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#why-these-capabilities","content":"seccomp:unconfined - required for io_uring syscalls which are blocked by Docker's default seccomp profile"},"3173":{"id":"/docs/server/docker-20","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#why-these-capabilities","content":"memlock: -1 - io_uring needs to lock memory pages shared between user space and kernel"},"3174":{"id":"/docs/server/docker-21","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Image"},"3175":{"id":"/docs/server/docker-22","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Description"},"3176":{"id":"/docs/server/docker-23","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"apache/iggy"},"3177":{"id":"/docs/server/docker-24","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Server + CLI"},"3178":{"id":"/docs/server/docker-25","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"apache/iggy-web-ui"},"3179":{"id":"/docs/server/docker-26","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Standalone Web UI"},"3180":{"id":"/docs/server/docker-27","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"apache/iggy-connect"},"3181":{"id":"/docs/server/docker-28","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Connectors runtime"},"3182":{"id":"/docs/server/docker-29","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"apache/iggy-mcp"},"3183":{"id":"/docs/server/docker-30","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"MCP server"},"3184":{"id":"/docs/server/docker-31","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"apache/iggy-bench-dashboard"},"3185":{"id":"/docs/server/docker-32","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Benchmark dashboard (server + WASM frontend)"},"3186":{"id":"/docs/server/docker-33","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#available-images","content":"Images tagged latest are based on stable releases. Images tagged edge are built from the latest master branch."},"3187":{"id":"/docs/server/docker-34","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#building-from-source","content":"The repository root carries its own Dockerfile and docker-compose.yml for building from source (a multi-stage build: Rust compilation including the Web UI, then a minimal runtime image):"},"3188":{"id":"/docs/server/docker-35","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#building-from-source","content":"Or use docker compose up directly from the repository root. That image differs from the published one: it sets the 0.0.0.0 address of all four listeners via ENV and keeps its data at /local_data. Those wildcards are baked into the image, so a plain docker run of it refuses to start until you pass IGGY_NODE_ADVERTISED_ADDRESS yourself. The repository's compose file publishes the ports to the host, so it declares IGGY_NODE_ADVERTISED_ADDRESS=localhost."},"3189":{"id":"/docs/server/docker-36","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#running-the-cli-inside-the-container","content":"The iggy CLI is on PATH in the official image. With the compose example above (container iggy, password Secret123):"},"3190":{"id":"/docs/server/docker-37","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#helm-charts","content":"Helm charts for Kubernetes deployment are available in the repository. Almost everything server-related nests under the server: key in values.yaml. The chart also bundles a Web UI deployment under ui:."},"3191":{"id":"/docs/server/docker-38","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"Server Deployment - runs apache/iggy with the pod security context the server needs: seccomp profile Unconfined (for io_uring) plus the IPC_LOCK capability (for memory locking). Listener addresses are set to 0.0.0.0 via server.env, and the data volume mounts at /app/local_data. The chart supplies IGGY_NODE_ADVERTISED_ADDRESS as the in-cluster Service DNS name; override it with server.advertisedAddress when clients arrive through a LoadBalancer or an Ingress. Images that predate the setting, including the 0.7.0 pinned by default, log the variable as unknown and start anyway."},"3192":{"id":"/docs/server/docker-39","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"Server Service - exposes the http (3000), quic (8080), and tcp (8090) ports. WebSocket is not exposed by the chart."},"3193":{"id":"/docs/server/docker-40","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"Web UI Deployment + Service - a separate apache/iggy-web-ui deployment on port 3050, enabled by default (ui.enabled)."},"3194":{"id":"/docs/server/docker-41","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"Secret - root user credentials from server.users.root (default iggy/changeit). Point existingSecret at your own Secret in production."},"3195":{"id":"/docs/server/docker-42","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"PersistentVolumeClaim - storage for /app/local_data, disabled by default (server.persistence.enabled), 8Gi when enabled."},"3196":{"id":"/docs/server/docker-43","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"ServiceAccount, HPA, Ingress - the usual optional plumbing, for both server and UI."},"3197":{"id":"/docs/server/docker-44","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#chart-components","content":"ServiceMonitor - Prometheus scrape config (optional). The /metrics endpoint requires a bearer credential like every other read, so wire a token (e.g. a personal access token stored in a Secret) into server.serviceMonitor.authorization - an unauthenticated scrape gets 401."},"3198":{"id":"/docs/server/docker-45","page_id":"/docs/server/docker","tags":[],"type":"text","url":"/docs/server/docker#key-values","content":"Customize the values file for your environment and deploy with:"},"3199":{"id":"/docs/server/introduction","page_id":"/docs/server/introduction","type":"page","content":"Introduction","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/introduction"},"3200":{"id":"/docs/server/introduction-0","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"What the Iggy server does, and where its releases and Docker images are published."},"3201":{"id":"/docs/server/introduction-1","page_id":"/docs/server/introduction","type":"heading","tags":[],"url":"/docs/server/introduction#running-the-server","content":"Running the server"},"3202":{"id":"/docs/server/introduction-2","page_id":"/docs/server/introduction","type":"heading","tags":[],"url":"/docs/server/introduction#authentication","content":"Authentication"},"3203":{"id":"/docs/server/introduction-3","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"Iggy server is the most important part of the system as it's responsible for handling all the incoming connections, managing the data and providing the API for the clients. The server is written in Rust and can be run on any platform that supports it."},"3204":{"id":"/docs/server/introduction-4","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"The releases are published to GitHub and can be found here. The official Docker images can be found here, simply type docker pull apache/iggy."},"3205":{"id":"/docs/server/introduction-5","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction","content":"If you compile the source code in release mode, the longer compilation time comes from LTO enabled in the [profile.release] section of the workspace Cargo.toml."},"3206":{"id":"/docs/server/introduction-6","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"One iggy-server binary serves both the single-node and the clustered deployment. The loaded configuration decides which one you get. The server accepts three CLI flags:"},"3207":{"id":"/docs/server/introduction-7","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"Flag"},"3208":{"id":"/docs/server/introduction-8","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"Purpose"},"3209":{"id":"/docs/server/introduction-9","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"--fresh"},"3210":{"id":"/docs/server/introduction-10","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"Delete the data directory before starting. This wipes all data on that node."},"3211":{"id":"/docs/server/introduction-11","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"--with-default-root-credentials"},"3212":{"id":"/docs/server/introduction-12","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"Set the root credentials to iggy/iggy on first start, unless IGGY_ROOT_USERNAME/IGGY_ROOT_PASSWORD are already set. Development only."},"3213":{"id":"/docs/server/introduction-13","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"--replica-id <N>"},"3214":{"id":"/docs/server/introduction-14","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"Select this node's entry in cluster.nodes. Required when cluster.enabled = true. See Clustering."},"3215":{"id":"/docs/server/introduction-15","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"Configuration comes from the TOML file named by IGGY_CONFIG_PATH. Without one, the server boots on the defaults embedded in the binary. Any key can be overridden with an IGGY_-prefixed environment variable, and a .env file in the working directory (or the file named by IGGY_ENV_PATH) is loaded at startup. See Configuration for the full reference."},"3216":{"id":"/docs/server/introduction-16","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"When no root credentials are provided on the very first start, the server generates a random root password and prints it to the log. That's the only time it can be read."},"3217":{"id":"/docs/server/introduction-17","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"The HTTP API endpoints can be found in server.http file, which can be used with REST Client extension for VS Code."},"3218":{"id":"/docs/server/introduction-18","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"In order to see the detailed logs from the server, run it with RUST_LOG=trace environment variable."},"3219":{"id":"/docs/server/introduction-19","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"To seed the example data, start the server with known credentials, then run the seeder from the root of the repository:"},"3220":{"id":"/docs/server/introduction-20","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#running-the-server","content":"The seeder logs in as iggy/iggy by default. Pass --username and --password to use other credentials."},"3221":{"id":"/docs/server/introduction-21","page_id":"/docs/server/introduction","tags":[],"type":"text","url":"/docs/server/introduction#authentication","content":"Only the ping liveness probe and the login handshake itself (username/password, personal access token, or HTTP token refresh, all of which prove a credential) are served without an authenticated session. Every other request requires one and is subject to permissions: fetching server stats, for example, needs the read_servers permission (the root user has it), and even the Prometheus /metrics scrape must present a bearer credential. A session is created by logging in with the user's credentials or personal access token and is valid for the duration of the connection or until the user logs out. Over the HTTP API, authentication is done by providing the Authorization header with the Bearer token."},"3222":{"id":"/docs/server/networking","page_id":"/docs/server/networking","type":"page","content":"Networking","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/networking"},"3223":{"id":"/docs/server/networking-0","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking","content":"The four transports Iggy serves simultaneously, TCP, QUIC, WebSocket and HTTP, and what each is best suited to."},"3224":{"id":"/docs/server/networking-1","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#transport-protocols","content":"Transport protocols"},"3225":{"id":"/docs/server/networking-2","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#binary-protocol","content":"Binary protocol"},"3226":{"id":"/docs/server/networking-3","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#connection-handling-across-shards","content":"Connection handling across shards"},"3227":{"id":"/docs/server/networking-4","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#tcp","content":"TCP"},"3228":{"id":"/docs/server/networking-5","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#quic","content":"QUIC"},"3229":{"id":"/docs/server/networking-6","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#http","content":"HTTP"},"3230":{"id":"/docs/server/networking-7","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#websocket","content":"WebSocket"},"3231":{"id":"/docs/server/networking-8","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#tls","content":"TLS"},"3232":{"id":"/docs/server/networking-9","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#heartbeat","content":"Heartbeat"},"3233":{"id":"/docs/server/networking-10","page_id":"/docs/server/networking","type":"heading","tags":[],"url":"/docs/server/networking#cluster-networking","content":"Cluster networking"},"3234":{"id":"/docs/server/networking-11","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking","content":"Iggy supports four transport protocols simultaneously, each optimized for different use cases. All stateful protocols (TCP, QUIC, WebSocket) use the same custom binary wire protocol, while HTTP provides a standard REST API."},"3235":{"id":"/docs/server/networking-12","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Protocol"},"3236":{"id":"/docs/server/networking-13","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Default Address"},"3237":{"id":"/docs/server/networking-14","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Implementation"},"3238":{"id":"/docs/server/networking-15","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Best for"},"3239":{"id":"/docs/server/networking-16","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"TCP"},"3240":{"id":"/docs/server/networking-17","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"127.0.0.1:8090"},"3241":{"id":"/docs/server/networking-18","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"compio + custom binary protocol"},"3242":{"id":"/docs/server/networking-19","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Highest throughput, lowest latency"},"3243":{"id":"/docs/server/networking-20","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"QUIC"},"3244":{"id":"/docs/server/networking-21","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"127.0.0.1:8080"},"3245":{"id":"/docs/server/networking-22","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"compio-quic (quinn)"},"3246":{"id":"/docs/server/networking-23","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Secure connections out of the box"},"3247":{"id":"/docs/server/networking-24","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"HTTP"},"3248":{"id":"/docs/server/networking-25","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"127.0.0.1:3000"},"3249":{"id":"/docs/server/networking-26","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"axum"},"3250":{"id":"/docs/server/networking-27","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"REST API, web integrations"},"3251":{"id":"/docs/server/networking-28","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"WebSocket"},"3252":{"id":"/docs/server/networking-29","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"127.0.0.1:8092"},"3253":{"id":"/docs/server/networking-30","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"compio-ws"},"3254":{"id":"/docs/server/networking-31","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Browser clients, bidirectional streaming"},"3255":{"id":"/docs/server/networking-32","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#transport-protocols","content":"Performance ranking (lowest to highest overhead): TCP > QUIC > WebSocket > HTTP"},"3256":{"id":"/docs/server/networking-33","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#binary-protocol","content":"Every request and reply on the stateful transports starts with a fixed 256-byte header (the same Viewstamped Replication header layout the cluster uses internally), followed by the command payload. The iggy_binary_protocol crate provides zero-copy serialization for these headers, and foreign SDKs implement the same contract natively. See the Binary Protocol section for the full specification."},"3257":{"id":"/docs/server/networking-34","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#connection-handling-across-shards","content":"The server runs one shard per core (thread-per-core, shared-nothing). All listeners (every client transport) bind on shard 0 only. Shard 0's coordinator hands accepted plaintext TCP and WebSocket connections to peer shards round-robin by transferring the file descriptor at accept time. From then on the connection lives entirely on its shard. QUIC, TCP with TLS, and HTTP terminate on shard 0, because their per-connection state cannot move between threads. Sockets never migrate after accept: an operation that touches a partition owned by another shard rides the internal message bus instead."},"3258":{"id":"/docs/server/networking-35","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tcp","content":"TCP provides the highest performance as it works directly with binary data without the overhead of HTTP or TLS handshakes (unless TLS is enabled). The full set of keys:"},"3259":{"id":"/docs/server/networking-36","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"QUIC runs the same binary protocol over UDP, on top of the quinn library, with TLS built in. It isn't quite as fast as TCP, but security comes out of the box (TLS is mandatory). Defaults:"},"3260":{"id":"/docs/server/networking-37","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"A few of these are deliberate rather than arbitrary:"},"3261":{"id":"/docs/server/networking-38","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"max_concurrent_bidi_streams = 1: the SDK opens a fresh stream per command and the server accepts one at a time, so a connection carries one in-flight command. Raising the cap does not make handlers concurrent."},"3262":{"id":"/docs/server/networking-39","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"initial_mtu = \"1200 B\" is the QUIC minimum. MTU discovery probes upward automatically, and boot rejects values below 1200."},"3263":{"id":"/docs/server/networking-40","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"stream_receive_window is the per-stream slice of receive_window, equal to it because there is a single stream. Lower it if you ever raise the stream cap."},"3264":{"id":"/docs/server/networking-41","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#quic","content":"keep_alive_interval is one third of max_idle_timeout, so two consecutive lost keep-alives fit before the idle timer closes the connection."},"3265":{"id":"/docs/server/networking-42","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"The HTTP API is built on axum and provides a standard REST interface. It includes JWT authentication, CORS configuration, and optional TLS."},"3266":{"id":"/docs/server/networking-43","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"HTTP is the most accessible protocol but has the highest overhead due to JSON serialization and the stateless nature of HTTP (no persistent connections for consumer groups). You can find all the available endpoints in the server.http file."},"3267":{"id":"/docs/server/networking-44","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"The HTTP server also hosts:"},"3268":{"id":"/docs/server/networking-45","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"Prometheus metrics at /metrics (endpoint configurable via [http.metrics]). The route authenticates like every other read: scrapers must present a bearer credential (JWT or personal access token). /ping is the only route that requires no credential at all."},"3269":{"id":"/docs/server/networking-46","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#http","content":"Embedded Web UI at /ui, which requires web_ui = true in [http] (off by default) on a server built with the iggy-web feature (part of the default build)."},"3270":{"id":"/docs/server/networking-47","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"WebSocket provides bidirectional streaming over HTTP upgrade. Iggy uses its own compio-ws implementation that bridges tungstenite's poll-based model with compio's completion-based I/O, reading frames through a buffered stream with a 128 KiB base buffer that can grow to a 64 MiB cap."},"3271":{"id":"/docs/server/networking-48","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"The [websocket] section exposes the frame-tuning knobs (read_buffer_size, write_buffer_size, max_write_buffer_size, max_message_size, max_frame_size, accept_unmasked_frames). See Configuration. TLS for WebSocket has its own [websocket.tls] section."},"3272":{"id":"/docs/server/networking-49","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"Benchmark comparison (AWS i3en.3xlarge, fsync per message, 4 producers, 40M messages):"},"3273":{"id":"/docs/server/networking-50","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"Producer avg latency: TCP 2.61ms vs WebSocket 3.43ms (+31%)"},"3274":{"id":"/docs/server/networking-51","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#websocket","content":"Consumer avg latency: TCP 0.70ms vs WebSocket 1.44ms (+106%)"},"3275":{"id":"/docs/server/networking-52","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Each transport configures TLS in its own section, and the self_signed semantics differ per transport:"},"3276":{"id":"/docs/server/networking-53","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Transport"},"3277":{"id":"/docs/server/networking-54","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Section"},"3278":{"id":"/docs/server/networking-55","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Behavior"},"3279":{"id":"/docs/server/networking-56","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"TCP"},"3280":{"id":"/docs/server/networking-57","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"[tcp.tls]"},"3281":{"id":"/docs/server/networking-58","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"self_signed = true generates an ephemeral certificate only while cert_file does not exist; an existing PEM pair is loaded instead."},"3282":{"id":"/docs/server/networking-59","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"WebSocket"},"3283":{"id":"/docs/server/networking-60","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"[websocket.tls]"},"3284":{"id":"/docs/server/networking-61","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"Same load-or-generate rule as TCP."},"3285":{"id":"/docs/server/networking-62","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"QUIC"},"3286":{"id":"/docs/server/networking-63","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"[quic.certificate]"},"3287":{"id":"/docs/server/networking-64","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"TLS is mandatory (part of the QUIC spec). self_signed = true always generates an ephemeral certificate and ignores cert_file/key_file, logging a warning if the files exist."},"3288":{"id":"/docs/server/networking-65","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"HTTP"},"3289":{"id":"/docs/server/networking-66","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"[http.tls]"},"3290":{"id":"/docs/server/networking-67","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"No self_signed option: HTTPS requires real cert_file/key_file."},"3291":{"id":"/docs/server/networking-68","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#tls","content":"With self_signed = false, cert_file and key_file must both exist. For production, provide proper certificate files everywhere. Ephemeral certificates change on every start and cannot be verified by clients."},"3292":{"id":"/docs/server/networking-69","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#heartbeat","content":"A connection that sends nothing (no request, no ping) for 1.2x the interval has its session released so its consumer groups rebalance off it. Only connections holding a consumer-group membership are evicted. Others are left alone until their socket closes."},"3293":{"id":"/docs/server/networking-70","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#heartbeat","content":"Most SDKs (Rust, Go, Python, Node, async Java) ping automatically every 5 seconds from a connected high-level client, well inside the resulting 36-second window. The blocking Java and C# SDKs have no automatic heartbeat, so an idle consumer-group member there must ping manually or reconnect after eviction."},"3294":{"id":"/docs/server/networking-71","page_id":"/docs/server/networking","tags":[],"type":"text","url":"/docs/server/networking#cluster-networking","content":"In cluster mode, listener ports come exclusively from each node's cluster.nodes ports entry, including the tcp_replica port for the consensus plane, and nodes can advertise different client-facing addresses per client network. Replica-to-replica traffic can be authenticated with a pre-shared key and wrapped in TLS 1.3. See Clustering configuration and Clustering security."},"3295":{"id":"/docs/server/security","page_id":"/docs/server/security","type":"page","content":"Security","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/security"},"3296":{"id":"/docs/server/security-0","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security","content":"Authentication, authorization, transport encryption and encryption at rest in the Iggy server."},"3297":{"id":"/docs/server/security-1","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#authentication","content":"Authentication"},"3298":{"id":"/docs/server/security-2","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#username-and-password","content":"Username and password"},"3299":{"id":"/docs/server/security-3","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#personal-access-tokens-pat","content":"Personal Access Tokens (PAT)"},"3300":{"id":"/docs/server/security-4","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#authorization","content":"Authorization"},"3301":{"id":"/docs/server/security-5","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#permission-matrix","content":"Permission matrix"},"3302":{"id":"/docs/server/security-6","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#scoped-permissions","content":"Scoped permissions"},"3303":{"id":"/docs/server/security-7","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#how-permissions-cascade","content":"How permissions cascade"},"3304":{"id":"/docs/server/security-8","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#transport-encryption-tls","content":"Transport encryption (TLS)"},"3305":{"id":"/docs/server/security-9","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#data-encryption-at-rest","content":"Data encryption at rest"},"3306":{"id":"/docs/server/security-10","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#jwt-http-api","content":"JWT (HTTP API)"},"3307":{"id":"/docs/server/security-11","page_id":"/docs/server/security","type":"heading","tags":[],"url":"/docs/server/security#cluster-security","content":"Cluster security"},"3308":{"id":"/docs/server/security-12","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security","content":"Iggy provides multiple layers of security covering authentication, authorization, transport encryption, and data encryption at rest."},"3309":{"id":"/docs/server/security-13","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authentication","content":"Iggy supports two authentication mechanisms:"},"3310":{"id":"/docs/server/security-14","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#username-and-password","content":"Users authenticate with a username and password via login_user(). Passwords are hashed using Argon2id (a memory-hard hashing algorithm). On first startup, the server generates a random password for the root user and logs it to the console. You can override this by setting environment variables:"},"3311":{"id":"/docs/server/security-15","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#username-and-password","content":"Or use the --with-default-root-credentials flag for development (sets root credentials to iggy/iggy)."},"3312":{"id":"/docs/server/security-16","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#username-and-password","content":"Important: once the data directory exists, environment variable credentials are ignored. To reset credentials, you must use the --fresh flag (which deletes all data)."},"3313":{"id":"/docs/server/security-17","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#username-and-password","content":"The root user cannot be deleted, and its permissions are fixed: it always holds every permission."},"3314":{"id":"/docs/server/security-18","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#personal-access-tokens-pat","content":"PATs provide programmatic access with optional expiry. Each user can have up to max_tokens_per_user (default 100) active tokens. Tokens are hashed before storage and can be revoked at any time."},"3315":{"id":"/docs/server/security-19","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#personal-access-tokens-pat","content":"An automatic cleaner removes expired tokens at a configurable interval."},"3316":{"id":"/docs/server/security-20","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#personal-access-tokens-pat","content":"Only the ping liveness probe and the login endpoints themselves are served without authentication. Everything else - including the Prometheus /metrics scrape - requires an authenticated session or bearer credential."},"3317":{"id":"/docs/server/security-21","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"Iggy provides granular permissions at three levels:"},"3318":{"id":"/docs/server/security-22","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"Global permissions - apply to the whole server and all streams"},"3319":{"id":"/docs/server/security-23","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"Stream permissions - scoped to one stream and all its topics"},"3320":{"id":"/docs/server/security-24","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"Topic permissions - scoped to one topic within a stream"},"3321":{"id":"/docs/server/security-25","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#authorization","content":"The root user has full access to everything and bypasses all permission checks. Other users can be assigned specific permissions using the CLI, HTTP API, SDK, or Web UI."},"3322":{"id":"/docs/server/security-26","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"The global permissions and the operations they unlock:"},"3323":{"id":"/docs/server/security-27","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Operation"},"3324":{"id":"/docs/server/security-28","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Required global permission"},"3325":{"id":"/docs/server/security-29","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Get server stats"},"3326":{"id":"/docs/server/security-30","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"read_servers"},"3327":{"id":"/docs/server/security-31","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"List clients, get client"},"3328":{"id":"/docs/server/security-32","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"read_servers"},"3329":{"id":"/docs/server/security-33","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Create, update, delete users; update permissions; change passwords"},"3330":{"id":"/docs/server/security-34","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"manage_users"},"3331":{"id":"/docs/server/security-35","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Get user, list users"},"3332":{"id":"/docs/server/security-36","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"read_users"},"3333":{"id":"/docs/server/security-37","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Create, update, delete streams"},"3334":{"id":"/docs/server/security-38","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"manage_streams"},"3335":{"id":"/docs/server/security-39","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Get stream, list streams"},"3336":{"id":"/docs/server/security-40","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"read_streams"},"3337":{"id":"/docs/server/security-41","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Create, update, delete topics"},"3338":{"id":"/docs/server/security-42","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"manage_topics"},"3339":{"id":"/docs/server/security-43","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Get topic, list topics"},"3340":{"id":"/docs/server/security-44","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"read_topics"},"3341":{"id":"/docs/server/security-45","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Consumer groups: create, delete, join, leave, get"},"3342":{"id":"/docs/server/security-46","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"read_topics"},"3343":{"id":"/docs/server/security-47","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Poll messages"},"3344":{"id":"/docs/server/security-48","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"poll_messages"},"3345":{"id":"/docs/server/security-49","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Send messages"},"3346":{"id":"/docs/server/security-50","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"send_messages"},"3347":{"id":"/docs/server/security-51","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Two kinds of implication apply on top of the table:"},"3348":{"id":"/docs/server/security-52","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Supersets: every manage_* permission includes its read_* counterpart. In addition manage_streams includes manage_topics, read_streams includes read_topics, and read_topics includes poll_messages."},"3349":{"id":"/docs/server/security-53","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#permission-matrix","content":"Self-service: an authenticated user can always read their own account, change their own password, and manage their own personal access tokens, without any of the user permissions above."},"3350":{"id":"/docs/server/security-54","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#scoped-permissions","content":"Instead of (or in addition to) global grants, permissions can be scoped per stream and per topic:"},"3351":{"id":"/docs/server/security-55","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#scoped-permissions","content":"Stream scope: manage_stream, read_stream, manage_topics, read_topics, poll_messages, send_messages, plus an optional per-topic map. read_stream includes read_topics and poll_messages within that stream."},"3352":{"id":"/docs/server/security-56","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#scoped-permissions","content":"Topic scope: manage_topic, read_topic, poll_messages, send_messages. read_topic includes poll_messages on that topic."},"3353":{"id":"/docs/server/security-57","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"Permissions are checked from top to bottom: global, then stream, then topic. A permission granted at a higher level covers everything below it:"},"3354":{"id":"/docs/server/security-58","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"Global poll_messages lets the user poll messages from all streams and topics."},"3355":{"id":"/docs/server/security-59","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"Stream-scoped poll_messages on stream 1 lets the user poll from all topics in stream 1, but not from other streams."},"3356":{"id":"/docs/server/security-60","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"Topic-scoped poll_messages on topic 5 of stream 1 lets the user poll only from that topic."},"3357":{"id":"/docs/server/security-61","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"If a stream has no entry in the user's stream permissions, only global permissions apply to it. The same holds for topics within a stream."},"3358":{"id":"/docs/server/security-62","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#how-permissions-cascade","content":"For example, a user that may only consume from stream 42 needs no global permissions at all: grant stream-scoped read_stream and poll_messages on stream 42, and the user can read that stream, list its topics, and poll messages from any topic in it. Nothing else."},"3359":{"id":"/docs/server/security-63","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"Each transport configures TLS in its own section, and the self_signed semantics differ per transport:"},"3360":{"id":"/docs/server/security-64","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"Transport"},"3361":{"id":"/docs/server/security-65","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"Section"},"3362":{"id":"/docs/server/security-66","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"Behavior"},"3363":{"id":"/docs/server/security-67","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"TCP"},"3364":{"id":"/docs/server/security-68","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"[tcp.tls]"},"3365":{"id":"/docs/server/security-69","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"self_signed = true generates an ephemeral certificate only while cert_file does not exist; an existing PEM pair is loaded instead."},"3366":{"id":"/docs/server/security-70","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"WebSocket"},"3367":{"id":"/docs/server/security-71","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"[websocket.tls]"},"3368":{"id":"/docs/server/security-72","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"Same load-or-generate rule as TCP."},"3369":{"id":"/docs/server/security-73","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"QUIC"},"3370":{"id":"/docs/server/security-74","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"[quic.certificate]"},"3371":{"id":"/docs/server/security-75","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"TLS is mandatory (part of the QUIC spec). self_signed = true always generates an ephemeral certificate and ignores cert_file/key_file, logging a warning if the files exist."},"3372":{"id":"/docs/server/security-76","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"HTTP"},"3373":{"id":"/docs/server/security-77","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"[http.tls]"},"3374":{"id":"/docs/server/security-78","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"No self_signed option: HTTPS requires real cert_file/key_file."},"3375":{"id":"/docs/server/security-79","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#transport-encryption-tls","content":"For production deployments, provide proper certificates via cert_file and key_file. Ephemeral certificates change on every start and cannot be verified by clients. See Networking for the surrounding transport configuration."},"3376":{"id":"/docs/server/security-80","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#data-encryption-at-rest","content":"Iggy supports optional AES-256-GCM encryption for message payloads and state commands. When enabled, all data is encrypted before being written to disk and decrypted when read. The encryption key must be a 32-byte base64-encoded string."},"3377":{"id":"/docs/server/security-81","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#jwt-http-api","content":"The HTTP API uses JWT (JSON Web Tokens) for session management. Tokens are signed with HS256 by default and have configurable expiry, clock skew tolerance, and audience/issuer validation:"},"3378":{"id":"/docs/server/security-82","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#jwt-http-api","content":"Further keys (valid_issuers, valid_audiences, not_before, use_base64_secret, the signing secrets) are covered in Configuration."},"3379":{"id":"/docs/server/security-83","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#jwt-http-api","content":"Signing secrets: encoding_secret and decoding_secret default to empty, which makes the server generate a secure random secret on every start. That's a safe single-node default with two consequences: issued tokens die on restart, and in a cluster each node signs with its own key, so bearers are node-local and follower-to-primary request forwarding stays disabled. For clusters, configure an identical secret on every node (prefer the IGGY_HTTP_JWT_ENCODING_SECRET/IGGY_HTTP_JWT_DECODING_SECRET environment variables over on-disk config), or enable cluster.auth so the JWT key derives from the cluster's shared PSK."},"3380":{"id":"/docs/server/security-84","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#jwt-http-api","content":"Refresh tokens: POST /users/refresh-token re-issues an access token from a still-valid one presented in the request body, answering the same identity shape as login, so HTTP clients can extend a session without re-sending credentials."},"3381":{"id":"/docs/server/security-85","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#jwt-http-api","content":"Federated issuers: the opt-in [[http.jwt.trusted_issuers]] list accepts tokens minted by external identity providers for application-to-application flows. Each entry names an issuer, audience, and jwks_url. Signatures are verified against the issuer's JWKS (fetches are rate-limited), and every token from that issuer is remapped onto the configured non-root user_id. With no entries configured, the listener accepts only self-issued tokens. See Configuration for the key reference."},"3382":{"id":"/docs/server/security-86","page_id":"/docs/server/security","tags":[],"type":"text","url":"/docs/server/security#cluster-security","content":"In cluster mode, replica-to-replica traffic can require an authenticated handshake based on a pre-shared key (with a documented rolling rotation procedure) and can be wrapped in TLS 1.3. With cluster.auth enabled and no JWT secrets configured, the PSK also becomes the cluster-wide JWT key source. See Clustering security."},"3383":{"id":"/docs/server/storage-engine","page_id":"/docs/server/storage-engine","type":"page","content":"Storage Engine","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/storage-engine"},"3384":{"id":"/docs/server/storage-engine-0","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine","content":"The segmented append-only log, and how streams, topics, partitions and segments map onto files on disk."},"3385":{"id":"/docs/server/storage-engine-1","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#directory-layout","content":"Directory layout"},"3386":{"id":"/docs/server/storage-engine-2","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#segmented-log","content":"Segmented log"},"3387":{"id":"/docs/server/storage-engine-3","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#on-disk-batch-format","content":"On-disk batch format"},"3388":{"id":"/docs/server/storage-engine-4","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#indexes","content":"Indexes"},"3389":{"id":"/docs/server/storage-engine-5","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#write-pipeline","content":"Write pipeline"},"3390":{"id":"/docs/server/storage-engine-6","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#boot-time-segment-recovery","content":"Boot-time segment recovery"},"3391":{"id":"/docs/server/storage-engine-7","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#read-integrity","content":"Read integrity"},"3392":{"id":"/docs/server/storage-engine-8","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#memory-pool","content":"Memory pool"},"3393":{"id":"/docs/server/storage-engine-9","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#retention-and-cleanup","content":"Retention and cleanup"},"3394":{"id":"/docs/server/storage-engine-10","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#metadata-plane","content":"Metadata plane"},"3395":{"id":"/docs/server/storage-engine-11","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#encryption","content":"Encryption"},"3396":{"id":"/docs/server/storage-engine-12","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#compression","content":"Compression"},"3397":{"id":"/docs/server/storage-engine-13","page_id":"/docs/server/storage-engine","type":"heading","tags":[],"url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"Removed and relocated settings"},"3398":{"id":"/docs/server/storage-engine-14","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine","content":"Iggy's storage engine is built around the concept of a segmented append-only log. Every piece of data flows through a well-defined hierarchy: System -> Streams -> Topics -> Partitions -> Segments. This page covers how data is stored, indexed, flushed, recovered, and cleaned up on disk."},"3399":{"id":"/docs/server/storage-engine-15","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#directory-layout","content":"All data lives under the system.path directory (default local_data):"},"3400":{"id":"/docs/server/storage-engine-16","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#directory-layout","content":"Stream, topic, and partition ids are numeric and 0-based. Each partition directory holds pairs of .log and .index files. The filename is the start offset of the segment's first message, zero-padded to 20 digits. Next to the segments, every partition keeps its own superblock pair (replica identity and consensus state for that partition) and an offsets/ tree for consumer offset storage."},"3401":{"id":"/docs/server/storage-engine-17","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#segmented-log","content":"Each partition is a segmented log: an ordered list of sealed (read-only) segments plus one active (writable) segment. When the active segment reaches the topic's segment_size (default 1 GiB), it is sealed and a new active segment starts at the next offset."},"3402":{"id":"/docs/server/storage-engine-18","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#segmented-log","content":"segment_size is a per-topic creation option, bounded to a 512-byte multiple between 1 MiB and 1 GiB. It's a soft limit: rotation fires after the append that crosses it, so the crossing batch lands whole and a sealed segment may run one batch past the configured size. preallocate_segments (also per topic) reserves each segment's bytes up front on filesystems that support it. See Topic options."},"3403":{"id":"/docs/server/storage-engine-19","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#on-disk-batch-format","content":"Segments store batch records, not individual messages. The record is byte-identical to the wire encoding: the one layout a SendMessages body, the replicated prepare, the persisted segment record, and the poll reply all share. There is no other message encoding."},"3404":{"id":"/docs/server/storage-engine-20","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#on-disk-batch-format","content":"The 256-byte batch header carries partition_id, base_offset, base_timestamp, origin_timestamp, batch_length, batch_checksum (XxHash3-64), and message_count. The rest is reserved and must be zero. Each 48-byte frame header carries checksum (XxHash3-64), id (u128), offset_delta (u32), timestamp_delta (u32), and the two lengths. A message's absolute offset is base_offset + offset_delta; its server timestamp is the flat base_timestamp, while timestamp_delta resolves producer time against origin_timestamp. All fields are little-endian, and records are stored contiguously with no padding."},"3405":{"id":"/docs/server/storage-engine-21","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#on-disk-batch-format","content":"The full byte-level tables live on the Message batches page. Absent at-rest encryption, what lands on disk is exactly what the producer sent, with the server stamping partition_id at admission and base_offset / base_timestamp (plus a batch_checksum recompute) at journal append."},"3406":{"id":"/docs/server/storage-engine-22","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Each segment has an accompanying .index file holding a sparse index: one 24-byte entry per flushed write, not per message."},"3407":{"id":"/docs/server/storage-engine-23","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Field"},"3408":{"id":"/docs/server/storage-engine-24","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Bytes"},"3409":{"id":"/docs/server/storage-engine-25","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Type"},"3410":{"id":"/docs/server/storage-engine-26","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Description"},"3411":{"id":"/docs/server/storage-engine-27","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"offset"},"3412":{"id":"/docs/server/storage-engine-28","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"0..8"},"3413":{"id":"/docs/server/storage-engine-29","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"u64"},"3414":{"id":"/docs/server/storage-engine-30","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Absolute offset of the flushed batch"},"3415":{"id":"/docs/server/storage-engine-31","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"timestamp"},"3416":{"id":"/docs/server/storage-engine-32","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"8..16"},"3417":{"id":"/docs/server/storage-engine-33","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"u64"},"3418":{"id":"/docs/server/storage-engine-34","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Timestamp of the flushed batch"},"3419":{"id":"/docs/server/storage-engine-35","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"position"},"3420":{"id":"/docs/server/storage-engine-36","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"16..24"},"3421":{"id":"/docs/server/storage-engine-37","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"u64"},"3422":{"id":"/docs/server/storage-engine-38","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Byte position of the batch start in the .log file"},"3423":{"id":"/docs/server/storage-engine-39","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"Little-endian, no header, no padding. To serve a poll, the server binary-searches the index for the closest entry at or below the target offset (or timestamp), seeks to its position, and walks batch records from there. Because the index is a sparse hint, a lookup below the indexed range falls back to the segment start rather than failing."},"3424":{"id":"/docs/server/storage-engine-40","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#indexes","content":"There is no index caching configuration: the in-memory index cache is an internal per-segment structure the server manages itself."},"3425":{"id":"/docs/server/storage-engine-41","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"Messages are admitted, stamped, and buffered in the partition journal, then replicated; committed batches reach a segment once a flush trigger fires:"},"3426":{"id":"/docs/server/storage-engine-42","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"The flush thresholds and fsync policy are per-topic creation options (they used to be server-wide config):"},"3427":{"id":"/docs/server/storage-engine-43","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"messages_required_to_save (default 1024): count threshold."},"3428":{"id":"/docs/server/storage-engine-44","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"size_of_messages_required_to_save (default 1 MiB): byte threshold."},"3429":{"id":"/docs/server/storage-engine-45","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"enforce_fsync (default false): fdatasync the .log and .index on every flush."},"3430":{"id":"/docs/server/storage-engine-46","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"A third trigger is independent of these options: when buffered journal bytes reach the active segment's segment_size, the flush fires. Whichever trigger trips first flushes. These are soft limits: a flush writes whole batches, so the actual flushed count or size can overshoot. The gate is evaluated on commit events, so a sub-threshold batch stays buffered until a later commit trips it (shutdown flushes unconditionally). The MessagesWriter uses vectored I/O (writev) with up to MAX_IOV_COUNT = 1024 buffers per syscall, so many buffered batches land in one write."},"3431":{"id":"/docs/server/storage-engine-47","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#write-pipeline","content":"Every partition belongs to a consensus group (Viewstamped Replication), and writes are prepared and quorum-acknowledged before commit. Stamping happens at journal-append time, before replication acks: the primary stamps base_offset from the log position and base_timestamp from the prepare timestamp, forwards the stamped bytes verbatim, and each backup re-derives the expected pair and refuses a mismatch, so the batch (and its recomputed batch_checksum) is byte-identical across replicas. At HEAD the partition-plane consensus journal is in-memory. Durability of message data comes from segment persistence and, in clusters, from the copies on other replicas. The metadata plane (below) has a durable on-disk journal."},"3432":{"id":"/docs/server/storage-engine-48","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#boot-time-segment-recovery","content":"At startup the server recovers every partition from its files, tolerating a torn tail from a crash:"},"3433":{"id":"/docs/server/storage-engine-49","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#boot-time-segment-recovery","content":"Sweep leftovers: .staging files and orphan .index files (an index without its .log) are deleted. A .log is never deleted."},"3434":{"id":"/docs/server/storage-engine-50","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#boot-time-segment-recovery","content":"For each segment, read the segment's bounds (offsets, timestamps, size) from the 24-byte sparse index."},"3435":{"id":"/docs/server/storage-engine-51","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#boot-time-segment-recovery","content":"If the index is missing or torn, walk the .log batch by batch and recover the bounds from the records themselves. This isn't tail-only: with the default enforce_fsync = false, a torn index can appear mid-chain, and the log walk recovers it."},"3436":{"id":"/docs/server/storage-engine-52","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#boot-time-segment-recovery","content":"If neither the index nor the log holds one whole batch, the segment is recovered as empty: sizes are zeroed so the next append overwrites the torn bytes instead of stranding undecodable garbage inside the readable range."},"3437":{"id":"/docs/server/storage-engine-53","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#boot-time-segment-recovery","content":"The last segment is left unsealed and becomes the active segment."},"3438":{"id":"/docs/server/storage-engine-54","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#boot-time-segment-recovery","content":"An index entry pointing past the end of its .log file (a torn write mid-chain that cannot be reconciled) refuses recovery for that partition rather than serving corrupt data."},"3439":{"id":"/docs/server/storage-engine-55","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#read-integrity","content":"Disk reads are verified before they reach a consumer:"},"3440":{"id":"/docs/server/storage-engine-56","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#read-integrity","content":"With validate_checksum = true (the default), every batch a disk poll reads is re-hashed and compared against its stored checksum. A mismatch fails the poll closed, so a segment damaged at rest is reported instead of served. Setting it to false skips the re-hash and serves whatever decodes, which can hand a consumer bytes provably not the ones written. Only disable it with a corruption guard elsewhere in the stack."},"3441":{"id":"/docs/server/storage-engine-57","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#read-integrity","content":"Polls serve stored batch records as-is (a reply may be a server-sliced view of a larger stored batch), so there is no re-encoding on the read path."},"3442":{"id":"/docs/server/storage-engine-58","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#memory-pool","content":"Iggy includes a custom memory pool to eliminate allocation overhead on the hot path. The pool has 28 buckets with buffer sizes from 4 KiB up to 512 MiB (non-uniform spacing, denser around common message sizes, with sizes above 2 MiB rounded to hugepage-friendly steps). Components request a buffer from the appropriate bucket and return it when done."},"3443":{"id":"/docs/server/storage-engine-59","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#memory-pool","content":"This avoids heap allocations during message processing and enables zero-copy message passing between internal components."},"3444":{"id":"/docs/server/storage-engine-60","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#retention-and-cleanup","content":"Two independent retention policies exist, both per-topic creation options (see Topic options). The segment cleaner enforces them:"},"3445":{"id":"/docs/server/storage-engine-61","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#retention-and-cleanup","content":"Size-based retention (max_topic_size): the cluster has no single owner of a topic-wide total, so each partition enforces an equal share: max_topic_size / partition_count, counted over sealed bytes. The share is floored at one sealed-segment ceiling (segment_size plus the maximum message-bus frame, since a sealed segment can overshoot by one batch). A cap that divides below that floor is raised to it, so the policy always means at least \"keep the newest sealed segment\". Once sealed bytes exceed the budget, the oldest sealed segments are trimmed. There is no percentage-based early trigger."},"3446":{"id":"/docs/server/storage-engine-62","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#retention-and-cleanup","content":"Time-based retention (message_expiry): sealed segments whose newest message is older than the expiry are deleted."},"3447":{"id":"/docs/server/storage-engine-63","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#retention-and-cleanup","content":"Both policies can be active at once. They only ever touch sealed segments. The active segment is never deleted, even if its messages have expired."},"3448":{"id":"/docs/server/storage-engine-64","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#metadata-plane","content":"Metadata operations (create stream, delete topic, create user, and so on) do not use the partition storage above. They replicate through the metadata consensus group and persist in local_data/metadata/:"},"3449":{"id":"/docs/server/storage-engine-65","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#metadata-plane","content":"journal.wal: the prepare journal. Each entry is a 256-byte PrepareHeader (the consensus header carrying checksums, view, op and commit numbers, operation discriminant, and acting user) followed by the operation's wire-format body, exactly as replicated. This is the write-ahead log: an operation is journaled before it is applied."},"3450":{"id":"/docs/server/storage-engine-66","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#metadata-plane","content":"snapshot.bin: a MessagePack (rmp-serde) snapshot of the whole metadata state machine, written at checkpoints so the journal can be truncated. Recovery loads the snapshot, then replays journal entries newer than it, rebuilding the client session table alongside."},"3451":{"id":"/docs/server/storage-engine-67","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#metadata-plane","content":"superblock.a / superblock.b: a ping-pong pair of checkpoint records, where the newest valid slot wins by sequence number. The superblock records which checkpoint is current and the snapshot's checksum. Boot cross-checks the pairing: a superblock pointing at a checkpoint newer than the on-disk snapshot, or a snapshot whose checksum doesn't match the record, refuses to boot rather than silently rewinding committed state."},"3452":{"id":"/docs/server/storage-engine-68","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#metadata-plane","content":"Partition directories carry the same superblock mechanism for their own consensus state (replica identity, view), which is how a restarted replica proves it is itself rather than a blank impostor."},"3453":{"id":"/docs/server/storage-engine-69","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#encryption","content":"Iggy supports optional AES-256-GCM encryption for message payloads and state commands. When enabled, data is encrypted before being written to disk and decrypted when read. The key is a 32-byte, base64-encoded string."},"3454":{"id":"/docs/server/storage-engine-70","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#compression","content":"The compression_algorithm topic option accepts none (default) and gzip, but it is a placeholder today: the value is persisted and reported back, and no compression is applied anywhere - segments store payloads exactly as sent. To compress today, do it client-side and tag messages via user headers - see the message headers examples in the Iggy repo."},"3455":{"id":"/docs/server/storage-engine-71","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"Earlier releases documented several storage features and [system.*] keys that no longer exist:"},"3456":{"id":"/docs/server/storage-engine-72","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"cache_indexes: removed. Index caching is internal now (see Indexes)."},"3457":{"id":"/docs/server/storage-engine-73","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"[system.message_deduplication]: the server-side deduplicator was removed entirely."},"3458":{"id":"/docs/server/storage-engine-74","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"Segment archiving / S3 backup: removed. [system.segment] archive_expired must stay false. Setting it to true aborts boot."},"3459":{"id":"/docs/server/storage-engine-75","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"[system.topic] / [system.partition] / [system.segment] storage knobs (max_size, message_expiry, enforce_fsync, messages_required_to_save, size_of_messages_required_to_save, size, preallocate): relocated to per-topic options."},"3460":{"id":"/docs/server/storage-engine-76","page_id":"/docs/server/storage-engine","tags":[],"type":"text","url":"/docs/server/storage-engine#removed-and-relocated-settings","content":"The config loader refuses to boot while any relocated or removed key is still set, in the file or the environment, so stale configs fail fast instead of silently ignoring a knob. The full mapping is in Relocated configuration keys."},"3461":{"id":"/docs/server/topic-options","page_id":"/docs/server/topic-options","type":"page","content":"Topic Options","breadcrumbs":["Documentation","Server"],"tags":[],"url":"/docs/server/topic-options"},"3462":{"id":"/docs/server/topic-options-0","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options","content":"Per-topic retention, durability and segment layout options, set when the topic is created."},"3463":{"id":"/docs/server/topic-options-1","page_id":"/docs/server/topic-options","type":"heading","tags":[],"url":"/docs/server/topic-options#the-catalog","content":"The catalog"},"3464":{"id":"/docs/server/topic-options-2","page_id":"/docs/server/topic-options","type":"heading","tags":[],"url":"/docs/server/topic-options#setting-options","content":"Setting options"},"3465":{"id":"/docs/server/topic-options-3","page_id":"/docs/server/topic-options","type":"heading","tags":[],"url":"/docs/server/topic-options#create-only-vs-updatable","content":"Create-only vs updatable"},"3466":{"id":"/docs/server/topic-options-4","page_id":"/docs/server/topic-options","type":"heading","tags":[],"url":"/docs/server/topic-options#discovering-the-catalog","content":"Discovering the catalog"},"3467":{"id":"/docs/server/topic-options-5","page_id":"/docs/server/topic-options","type":"heading","tags":[],"url":"/docs/server/topic-options#durability","content":"Durability"},"3468":{"id":"/docs/server/topic-options-6","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options","content":"Retention, durability, and segment layout are per-topic decisions, made when the topic is created. They used to be server-wide [system.*] keys, which gave every knob two homes. The server now refuses to boot on the old keys, and each topic carries its own values instead."},"3469":{"id":"/docs/server/topic-options-7","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options","content":"Options are key-value pairs sent with CreateTopic. Unknown keys are rejected at the edge, never skipped: a silently ignored knob would leave the client on server defaults with no way to find out. The same mechanism exists for streams and users, but their catalogs are empty today. Only topics have option keys."},"3470":{"id":"/docs/server/topic-options-8","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Option"},"3471":{"id":"/docs/server/topic-options-9","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Default"},"3472":{"id":"/docs/server/topic-options-10","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Constraints"},"3473":{"id":"/docs/server/topic-options-11","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Description"},"3474":{"id":"/docs/server/topic-options-12","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"max_topic_size"},"3475":{"id":"/docs/server/topic-options-13","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"unlimited"},"3476":{"id":"/docs/server/topic-options-14","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Delete the oldest sealed segments once the topic grows past this size."},"3477":{"id":"/docs/server/topic-options-15","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"message_expiry"},"3478":{"id":"/docs/server/topic-options-16","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"none"},"3479":{"id":"/docs/server/topic-options-17","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Delete sealed segments older than this."},"3480":{"id":"/docs/server/topic-options-18","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"compression_algorithm"},"3481":{"id":"/docs/server/topic-options-19","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"none"},"3482":{"id":"/docs/server/topic-options-20","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"none or gzip"},"3483":{"id":"/docs/server/topic-options-21","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Placeholder: stored and reported, no compression applied yet."},"3484":{"id":"/docs/server/topic-options-22","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"segment_size"},"3485":{"id":"/docs/server/topic-options-23","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"1 GiB"},"3486":{"id":"/docs/server/topic-options-24","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"512-byte multiple, at least 1 MiB, at most 1 GiB"},"3487":{"id":"/docs/server/topic-options-25","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Soft size limit per segment: a segment may close one whole batch past it."},"3488":{"id":"/docs/server/topic-options-26","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"enforce_fsync"},"3489":{"id":"/docs/server/topic-options-27","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"false"},"3490":{"id":"/docs/server/topic-options-28","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"fsync every write to this topic's partitions."},"3491":{"id":"/docs/server/topic-options-29","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"messages_required_to_save"},"3492":{"id":"/docs/server/topic-options-30","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"1024"},"3493":{"id":"/docs/server/topic-options-31","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"non-zero, at most 16777216"},"3494":{"id":"/docs/server/topic-options-32","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Flush the journal once it holds this many messages."},"3495":{"id":"/docs/server/topic-options-33","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"size_of_messages_required_to_save"},"3496":{"id":"/docs/server/topic-options-34","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"1 MiB"},"3497":{"id":"/docs/server/topic-options-35","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"at most 1 GiB"},"3498":{"id":"/docs/server/topic-options-36","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Flush the journal once it holds this many bytes. Paired with the message count; whichever threshold trips first flushes."},"3499":{"id":"/docs/server/topic-options-37","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"preallocate_segments"},"3500":{"id":"/docs/server/topic-options-38","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"false"},"3501":{"id":"/docs/server/topic-options-39","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"segment_size x partitions at most 64 GiB per create"},"3502":{"id":"/docs/server/topic-options-40","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Reserve each segment's bytes up front where the filesystem supports it."},"3503":{"id":"/docs/server/topic-options-41","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Both retention policies can be active at once. The active segment is never touched. Deletion is done by the server's segment cleaner ([data_maintenance.messages], enabled by default)."},"3504":{"id":"/docs/server/topic-options-42","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"Value forms are forgiving: byte sizes accept a raw number of bytes or a string like \"128 MiB\", expiry accepts microseconds or a humantime string like \"7 days\", booleans accept true/false. Create admission re-parses and re-encodes what you send, so a string segment_size=128MiB is stored as the number it names."},"3505":{"id":"/docs/server/topic-options-43","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#the-catalog","content":"preallocate_segments reserves exactly segment_size of real disk per partition the moment the topic is created (and again as segments rotate). With the default 1 GiB segment size that's 1 GiB per partition up front, which is why it's opt-in and why one create is capped at 64 GiB of total reservation."},"3506":{"id":"/docs/server/topic-options-44","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#setting-options","content":"At creation, every interface takes the same keys:"},"3507":{"id":"/docs/server/topic-options-45","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#setting-options","content":"In the CLI, compression_algorithm, message_expiry, and max_topic_size also have first-class parameters on iggy topic create. --set covers the storage knobs that have no named parameter of their own. Values are sent as strings and parsed server-side, so iggy options topic (below) tells you exactly what this server accepts."},"3508":{"id":"/docs/server/topic-options-46","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#setting-options","content":"SDKs pass options as a parameter on the create call (TopicCreateOptions::raw in Rust, an options dictionary or list in Node, Python, Go, Java, C#, and C++). The HTTP API takes them as a plain string map in the create body."},"3509":{"id":"/docs/server/topic-options-47","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#setting-options","content":"Keys you don't send are resolved to the defaults above by the admitting server and stored as derived entries. GetTopic returns both blocks, explicit and derived, so the effective value of every knob is always visible, along with who chose it."},"3510":{"id":"/docs/server/topic-options-48","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#create-only-vs-updatable","content":"Only three options can change after creation, via UpdateTopic:"},"3511":{"id":"/docs/server/topic-options-49","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#create-only-vs-updatable","content":"compression_algorithm"},"3512":{"id":"/docs/server/topic-options-50","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#create-only-vs-updatable","content":"message_expiry"},"3513":{"id":"/docs/server/topic-options-51","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#create-only-vs-updatable","content":"max_topic_size"},"3514":{"id":"/docs/server/topic-options-52","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#create-only-vs-updatable","content":"Updates are patches: a key you don't send keeps its current value."},"3515":{"id":"/docs/server/topic-options-53","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#create-only-vs-updatable","content":"The storage knobs (segment_size, enforce_fsync, messages_required_to_save, size_of_messages_required_to_save, preallocate_segments) are create-only. They describe how a partition's storage is laid down: changing segment_size mid-segment would leave segments sized by different caps, and preallocation can only act on a file not yet opened. A topic gets them at creation and keeps them, so its segments stay uniform. This is also why the server refuses to boot on the old config keys instead of ignoring them: a topic created while an old key was silently dropped could never be given the setting afterwards."},"3516":{"id":"/docs/server/topic-options-54","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#discovering-the-catalog","content":"Ask the server which keys it accepts, with their types, defaults, and descriptions:"},"3517":{"id":"/docs/server/topic-options-55","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#discovering-the-catalog","content":"SDKs expose the same call as describe_options. The scope is topic, stream, or user."},"3518":{"id":"/docs/server/topic-options-56","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#discovering-the-catalog","content":"Discovery matters most on the binary transports: TCP, QUIC, and WebSocket carry only an error code for a rejected key, not its name, so the catalog is how a client finds out what this server supports. Over HTTP the error message names the offending key directly."},"3519":{"id":"/docs/server/topic-options-57","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#durability","content":"Single-node durability is a per-topic decision. For the strongest guarantee, create the topic with enforce_fsync=true. Every write is then fsynced before it is acknowledged. Without it, the flush thresholds (messages_required_to_save, size_of_messages_required_to_save) bound how much buffered data a crash can lose, at much higher throughput."},"3520":{"id":"/docs/server/topic-options-58","page_id":"/docs/server/topic-options","tags":[],"type":"text","url":"/docs/server/topic-options#durability","content":"In cluster mode, durability comes from quorum replication: a write is acknowledged once a majority of replicas hold it. See Clustering."},"3521":{"id":"/docs/web_ui/start","page_id":"/docs/web_ui/start","type":"page","content":"Iggy Web UI","breadcrumbs":["Documentation","Web UI"],"tags":[],"url":"/docs/web_ui/start"},"3522":{"id":"/docs/web_ui/start-0","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start","content":"The Iggy Web UI dashboard, for monitoring server health and browsing streams, topics, messages and users."},"3523":{"id":"/docs/web_ui/start-1","page_id":"/docs/web_ui/start","type":"heading","tags":[],"url":"/docs/web_ui/start#how-it-connects","content":"How it connects"},"3524":{"id":"/docs/web_ui/start-2","page_id":"/docs/web_ui/start","type":"heading","tags":[],"url":"/docs/web_ui/start#running-modes","content":"Running modes"},"3525":{"id":"/docs/web_ui/start-3","page_id":"/docs/web_ui/start","type":"heading","tags":[],"url":"/docs/web_ui/start#embedded-mode","content":"Embedded mode"},"3526":{"id":"/docs/web_ui/start-4","page_id":"/docs/web_ui/start","type":"heading","tags":[],"url":"/docs/web_ui/start#standalone-mode","content":"Standalone mode"},"3527":{"id":"/docs/web_ui/start-5","page_id":"/docs/web_ui/start","type":"heading","tags":[],"url":"/docs/web_ui/start#local-development","content":"Local development"},"3528":{"id":"/docs/web_ui/start-6","page_id":"/docs/web_ui/start","type":"heading","tags":[],"url":"/docs/web_ui/start#features","content":"Features"},"3529":{"id":"/docs/web_ui/start-7","page_id":"/docs/web_ui/start","type":"heading","tags":[],"url":"/docs/web_ui/start#docker-compose-example","content":"Docker Compose example"},"3530":{"id":"/docs/web_ui/start-8","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start","content":"Iggy Web UI provides a comprehensive dashboard for Iggy server. It allows you to monitor the server's health, streams, topics, browse the messages, users and more. The dashboard is built with SvelteKit and TypeScript and is available as open-source as well as the Docker image on Docker Hub."},"3531":{"id":"/docs/web_ui/start-9","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#how-it-connects","content":"The Web UI is a purely client-side application: every call to the Iggy HTTP API is issued by your browser, not by the Web UI container or server. Two things follow from this:"},"3532":{"id":"/docs/web_ui/start-10","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#how-it-connects","content":"PUBLIC_IGGY_API_URL must be a URL that the browser can reach (e.g. http://localhost:3010), not an internal Docker network hostname like http://iggy:80."},"3533":{"id":"/docs/web_ui/start-11","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#how-it-connects","content":"The Iggy server must allow cross-origin requests from the Web UI origin. CORS is enabled for all origins by default ([http.cors] in the server config). If you restricted allowed_origins, add the Web UI origin."},"3534":{"id":"/docs/web_ui/start-12","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#how-it-connects","content":"In embedded mode neither applies: the UI is served from the same origin as the HTTP API and uses relative URLs."},"3535":{"id":"/docs/web_ui/start-13","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#embedded-mode","content":"The Web UI is compiled directly into the Iggy server binary via the iggy-web cargo feature, which is enabled by default (official binaries and Docker images include it). To serve it at the /ui endpoint, flip the web_ui flag (disabled by default):"},"3536":{"id":"/docs/web_ui/start-14","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#embedded-mode","content":"If the server is compiled without the iggy-web feature and web_ui = true, a warning is logged but the server continues to run normally."},"3537":{"id":"/docs/web_ui/start-15","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#standalone-mode","content":"Run the Web UI as a separate container:"},"3538":{"id":"/docs/web_ui/start-16","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#standalone-mode","content":"PUBLIC_IGGY_API_URL is consumed by the browser: if the Iggy server also runs in Docker, use the host-published HTTP port here, not the container's network alias."},"3539":{"id":"/docs/web_ui/start-17","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#local-development","content":"The Web UI lives in the web/ folder of the repository. Use a Node.js version supported by the frontend toolchain (Vite requires ^20.19.0 || >=22.12.0, so 22 LTS is a safe default) and npm (pnpm and yarn are not part of the supported workflow):"},"3540":{"id":"/docs/web_ui/start-18","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#local-development","content":"Point the UI at your Iggy server's HTTP API via a .env file in the web/ folder, e.g. PUBLIC_IGGY_API_URL=http://127.0.0.1:3000."},"3541":{"id":"/docs/web_ui/start-19","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"The Web UI provides the following pages and functionality:"},"3542":{"id":"/docs/web_ui/start-20","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"Overview - server health and key metrics"},"3543":{"id":"/docs/web_ui/start-21","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"Streams - list, create, and manage streams"},"3544":{"id":"/docs/web_ui/start-22","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"Topics - manage topics per stream (create, update, delete, purge)"},"3545":{"id":"/docs/web_ui/start-23","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"Partitions - view partition details per topic"},"3546":{"id":"/docs/web_ui/start-24","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"Messages - browse messages per partition with built-in decoders:"},"3547":{"id":"/docs/web_ui/start-25","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"JSON decoder (formatted JSON output)"},"3548":{"id":"/docs/web_ui/start-26","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"String decoder (UTF-8 text)"},"3549":{"id":"/docs/web_ui/start-27","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"XML decoder"},"3550":{"id":"/docs/web_ui/start-28","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"Users - user management (create, update, delete, permissions)"},"3551":{"id":"/docs/web_ui/start-29","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"Settings - Web UI preferences"},"3552":{"id":"/docs/web_ui/start-30","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#features","content":"Some pages visible in the navigation (Clients, Logs, terminal, server settings) are placeholders that aren't functional yet. See the roadmap for what is planned."},"3553":{"id":"/docs/web_ui/start-31","page_id":"/docs/web_ui/start","tags":[],"type":"text","url":"/docs/web_ui/start#docker-compose-example","content":"Here's the full example of the docker-compose.yml file that starts the Iggy server, initializes it with the my-stream stream and my-topic topic with the help of Iggy CLI, and starts the Iggy Web UI:"},"3554":{"id":"/docs/connectors/sources/elasticsearch","page_id":"/docs/connectors/sources/elasticsearch","type":"page","content":"Elasticsearch Source","breadcrumbs":["Documentation","Connectors","Sources"],"tags":[],"url":"/docs/connectors/sources/elasticsearch"},"3555":{"id":"/docs/connectors/sources/elasticsearch-0","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch","content":"Poll documents from an Elasticsearch index into Iggy streams, incrementally when a timestamp field is configured."},"3556":{"id":"/docs/connectors/sources/elasticsearch-1","page_id":"/docs/connectors/sources/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sources/elasticsearch#configuration","content":"Configuration"},"3557":{"id":"/docs/connectors/sources/elasticsearch-2","page_id":"/docs/connectors/sources/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Plugin config options"},"3558":{"id":"/docs/connectors/sources/elasticsearch-3","page_id":"/docs/connectors/sources/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sources/elasticsearch#how-polling-works","content":"How Polling Works"},"3559":{"id":"/docs/connectors/sources/elasticsearch-4","page_id":"/docs/connectors/sources/elasticsearch","type":"heading","tags":[],"url":"/docs/connectors/sources/elasticsearch#state","content":"State"},"3560":{"id":"/docs/connectors/sources/elasticsearch-5","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch","content":"The Elasticsearch source connector polls documents from an Elasticsearch index and produces them to Iggy streams. With a timestamp field configured, each poll only fetches documents newer than the last one seen, giving incremental, restart-safe ingestion."},"3561":{"id":"/docs/connectors/sources/elasticsearch-6","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Option"},"3562":{"id":"/docs/connectors/sources/elasticsearch-7","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Type"},"3563":{"id":"/docs/connectors/sources/elasticsearch-8","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Default"},"3564":{"id":"/docs/connectors/sources/elasticsearch-9","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Description"},"3565":{"id":"/docs/connectors/sources/elasticsearch-10","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"url"},"3566":{"id":"/docs/connectors/sources/elasticsearch-11","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"string"},"3567":{"id":"/docs/connectors/sources/elasticsearch-12","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"required"},"3568":{"id":"/docs/connectors/sources/elasticsearch-13","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content":"Elasticsearch cluster URL"},"3569":{"id":"/docs/connectors/sources/elasticsearch-14","page_id":"/docs/connectors/sources/elasticsearch","tags":[],"type":"text","url":"/docs/connectors/sources/elasticsearch#plugin-config-options","content"