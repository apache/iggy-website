{key}/configs"},"1796":{"id":"/docs/connectors/runtime-57","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#default-url-templates","content":"The HTTP provider expects the remote API to implement these endpoints and return connector configuration data in the same format as used by the local provider."},"1797":{"id":"/docs/connectors/runtime-58","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"Connector runtime has an HTTP API which is enabled by default at 127.0.0.1:8081. It can be disabled by setting the enabled flag to false in the [http] section."},"1798":{"id":"/docs/connectors/runtime-59","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"When api_key is set, every request must carry it in the api-key header - except GET / and GET /health, which stay public."},"1799":{"id":"/docs/connectors/runtime-60","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"Currently, it does expose the following endpoints:"},"1800":{"id":"/docs/connectors/runtime-61","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /: welcome message."},"1801":{"id":"/docs/connectors/runtime-62","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /health: health status of the runtime."},"1802":{"id":"/docs/connectors/runtime-63","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /stats: runtime statistics (process info plus per-connector status and message counters)."},"1803":{"id":"/docs/connectors/runtime-64","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /metrics: Prometheus metrics, available when [http.metrics] is enabled (path configurable via its endpoint key)."},"1804":{"id":"/docs/connectors/runtime-65","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sinks: list of sinks."},"1805":{"id":"/docs/connectors/runtime-66","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sinks/{key}: sink details."},"1806":{"id":"/docs/connectors/runtime-67","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sinks/{key}/configs: list of configuration versions for the sink."},"1807":{"id":"/docs/connectors/runtime-68","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"POST /sinks/{key}/configs: add a new configuration version for the sink."},"1808":{"id":"/docs/connectors/runtime-69","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"DELETE /sinks/{key}/configs: delete the sink configuration."},"1809":{"id":"/docs/connectors/runtime-70","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sinks/{key}/configs/{version}: configuration details for a specific version."},"1810":{"id":"/docs/connectors/runtime-71","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GET /sinks/{key}/configs/active: active configuration details."},"1811":{"id":"/docs/connectors/runtime-72","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"PUT /sinks/{key}/configs/active: activate a specific configuration version for the sink."},"1812":{"id":"/docs/connectors/runtime-73","page_id":"/docs/connectors/runtime","tags":[],"type":"text","url":"/docs/connectors/runtime#http-api","content":"GE