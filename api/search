","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"Type"},"6646":{"id":"/docs/sdk/csharp/guide-111","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"Default"},"6647":{"id":"/docs/sdk/csharp/guide-112","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"Description"},"6648":{"id":"/docs/sdk/csharp/guide-113","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"Enabled"},"6649":{"id":"/docs/sdk/csharp/guide-114","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"bool"},"6650":{"id":"/docs/sdk/csharp/guide-115","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"true"},"6651":{"id":"/docs/sdk/csharp/guide-116","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"Enable automatic reconnection when the connection drops"},"6652":{"id":"/docs/sdk/csharp/guide-117","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"MaxRetries"},"6653":{"id":"/docs/sdk/csharp/guide-118","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"int"},"6654":{"id":"/docs/sdk/csharp/guide-119","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"0"},"6655":{"id":"/docs/sdk/csharp/guide-120","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"Maximum failed passes through the known address roster (0 = unlimited)"},"6656":{"id":"/docs/sdk/csharp/guide-121","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"InitialDelay"},"6657":{"id":"/docs/sdk/csharp/guide-122","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"TimeSpan"},"6658":{"id":"/docs/sdk/csharp/guide-123","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"5s"},"6659":{"id":"/docs/sdk/csharp/guide-124","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"Delay before the first reconnection attempt"},"6660":{"id":"/docs/sdk/csharp/guide-125","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"MaxDelay"},"6661":{"id":"/docs/sdk/csharp/guide-126","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"TimeSpan"},"6662":{"id":"/docs/sdk/csharp/guide-127","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"30s"},"6663":{"id":"/docs/sdk/csharp/guide-128","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"Maximum delay between attempts"},"6664":{"id":"/docs/sdk/csharp/guide-129","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"WaitAfterReconnect"},"6665":{"id":"/docs/sdk/csharp/guide-130","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"TimeSpan"},"6666":{"id":"/docs/sdk/csharp/guide-131","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"1s"},"6667":{"id":"/docs/sdk/csharp/guide-132","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"Pause after a successful reconnect (e.g. to rejoin a consumer group)"},"6668":{"id":"/docs/sdk/csharp/guide-133","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"UseExponentialBackoff"},"6669":{"id":"/docs/sdk/csharp/guide-134","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"bool"},"6670":{"id":"/docs/sdk/csharp/guide-135","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"true"},"6671":{"id":"/docs/sdk/csharp/guide-136","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"Use exponential backoff for delays"},"6672":{"id":"/docs/sdk/csharp/guide-137","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"BackoffMultiplier"},"6673":{"id":"/docs/sdk/csharp/guide-138","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"double"},"6674":{"id":"/docs/sdk/csharp/guide-139","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"2.0"},"6675":{"id":"/docs/sdk/csharp/guide-140","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"Multiplier for exponential backoff"},"6676":{"id":"/docs/sdk/csharp/guide-141","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#reconnectionsettings","content":"Warning: TCP reconnection is on by default with unlimited retries. A failed pass tries the known roster addresses before consuming one retry. Connection and TLS handshake failures can be retried. An invalid local CA file stops after the pass, and rejected login credentials are surfaced. Pass a CancellationToken or set MaxRetries to bound connection attempts, or set Enabled = false to disable reconnection. Request replay also has its own deadline and requires configured or remembered login credentials."},"6677":{"id":"/docs/sdk/csharp/guide-142","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Property"},"6678":{"id":"/docs/sdk/csharp/guide-143","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Type"},"6679":{"id":"/docs/sdk/csharp/guide-144","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Default"},"6680":{"id":"/docs/sdk/csharp/guide-145","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Description"},"6681":{"id":"/docs/sdk/csharp/guide-146","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Enabled"},"6682":{"id":"/docs/sdk/csharp/guide-147","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"bool"},"6683":{"id":"/docs/sdk/csharp/guide-148","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"false"},"6684":{"id":"/docs/sdk/csharp/guide-149","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Log in automatically once connected"},"6685":{"id":"/docs/sdk/csharp/guide-150","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Username"},"6686":{"id":"/docs/sdk/csharp/guide-151","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"string"},"6687":{"id":"/docs/sdk/csharp/guide-152","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"\"\""},"6688":{"id":"/docs/sdk/csharp/guide-153","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Username for auto-login"},"6689":{"id":"/docs/sdk/csharp/guide-154","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Password"},"6690":{"id":"/docs/sdk/csharp/guide-155","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"string"},"6691":{"id":"/docs/sdk/csharp/guide-156","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"\"\""},"6692":{"id":"/docs/sdk/csharp/guide-157","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Password for auto-login"},"6693":{"id":"/docs/sdk/csharp/guide-158","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"PersonalAccessToken"},"6694":{"id":"/docs/sdk/csharp/guide-159","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"string"},"6695":{"id":"/docs/sdk/csharp/guide-160","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"\"\""},"6696":{"id":"/docs/sdk/csharp/guide-161","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"Personal access token to sign in with instead of a username and password. Takes precedence over them when set"},"6697":{"id":"/docs/sdk/csharp/guide-162","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#autologinsettings","content":"All properties are init-only: build the settings with an object initializer or the static factories AutoLoginSettings.For(username, password) and AutoLoginSettings.ForPersonalAccessToken(token). TCP reconnects use configured auto-login credentials first, then credentials remembered from a successful manual login. Without either, a reconnect cannot restore the authenticated session."},"6698":{"id":"/docs/sdk/csharp/guide-163","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#message-encryption","content":"Set IggyClientConfigurator.MessageEncryptor to encrypt message payloads and user headers client-side. They are encrypted on send and decrypted on poll. Routing information and message metadata remain visible to the server. The built-in AesMessageEncryptor uses AES-GCM (confidentiality + authenticity) and takes a 16-, 24-, or 32-byte key for AES-128/192/256:"},"6699":{"id":"/docs/sdk/csharp/guide-164","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#message-encryption","content":"Keep the same key for clients that exchange encrypted messages and for later reads. The generated key above lasts only for this example. For a custom scheme, implement IMessageEncryptor."},"6700":{"id":"/docs/sdk/csharp/guide-165","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#message-encryption","content":"Things to know:"},"6701":{"id":"/docs/sdk/csharp/guide-166","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#message-encryption","content":"The encryptor applies to every message on the connection - topics mixing encrypted and plaintext messages are not supported."},"6702":{"id":"/docs/sdk/csharp/guide-167","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#message-encryption","content":"You own the encryptor and must dispose it once the client is done with it."},"6703":{"id":"/docs/sdk/csharp/guide-168","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#message-encryption","content":"With an encryptor configured, polling with autoCommit: true throws InvalidOperationException by default: the server commits the offset before the client decrypts, so a decryption failure would silently skip the whole batch. Poll with autoCommit: false and store offsets after processing, or opt in with AllowAutoCommitWithEncryptor = true. IggyConsumer separately rejects wire auto-commit with encryption. Use AfterReceive or Disabled there."},"6704":{"id":"/docs/sdk/csharp/guide-169","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#message-encryption","content":"On the high-level builders, WithEncryptor(...) is only valid when the builder creates its own client. For an external client, set MessageEncryptor on the configurator instead."},"6705":{"id":"/docs/sdk/csharp/guide-170","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#connection-events","content":"TCP clients publish connection state changes, useful for reacting to reconnects. HTTP subscription methods are no-ops:"},"6706":{"id":"/docs/sdk/csharp/guide-171","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#identifiers","content":"Streams, topics, users, and consumer groups are referenced by an Identifier, which can be either numeric or a name:"},"6707":{"id":"/docs/sdk/csharp/guide-172","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#identifiers","content":"Server-assigned ids are 0-based: the first stream, topic, partition, or consumer group gets id 0. The root user has id 0 as well."},"6708":{"id":"/docs/sdk/csharp/guide-173","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#user-login","content":"Use the credentials configured when the server was initialized. These examples use the iggy / iggy setup from the introduction:"},"6709":{"id":"/docs/sdk/csharp/guide-174","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#creating-users","content":"Create new users with customizable permissions:"},"6710":{"id":"/docs/sdk/csharp/guide-175","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#creating-users","content":"Besides Global, Permissions.Streams scopes permissions to specific streams (keyed by numeric stream id), and each StreamPermissions can in turn scope down to specific topics:"},"6711":{"id":"/docs/sdk/csharp/guide-176","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#personal-access-tokens","content":"Create and use Personal Access Tokens (PAT) for programmatic access:"},"6712":{"id":"/docs/sdk/csharp/guide-177","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#topics","content":"Create a topic with typed TopicOptions. Fields left null use the server default. Compression, durability, partition resize policy and replication factor are fixed at creation."},"6713":{"id":"/docs/sdk/csharp/guide-178","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#topic-options","content":"DescribeOptionsAsync(OptionsScope.Topic) returns the catalog. Set fields in TopicUpdate to change them. Reset returns a supported key to its server default. Omitted fields keep their stored values. Compression cannot be updated. See Topic options."},"6714":{"id":"/docs/sdk/csharp/guide-179","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#topic-options","content":"Stream and topic purge are removed. DeleteTopicAsync deletes the topic and its data. There is no on-demand flush command. Select both durability policies when creating the topic."},"6715":{"id":"/docs/sdk/csharp/guide-180","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#partitions","content":"Add partitions to or remove them from an existing topic:"},"6716":{"id":"/docs/sdk/csharp/guide-181","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#sending-messages","content":"A Message takes an id (Guid or UInt128) and a payload:"},"6717":{"id":"/docs/sdk/csharp/guide-182","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#sending-messages","content":"SendMessagesAsync returns a SendMessagesResponse whose Confirmations carry StreamId, TopicId, PartitionId, and BaseOffset (the offset of the first message of the batch) per committed batch. An empty list reports no assigned offsets. A single-message overload is also available: SendMessagesAsync(streamId, topicId, partitioning, message)."},"6718":{"id":"/docs/sdk/csharp/guide-183","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#sending-messages","content":"To send many payloads without a byte[] allocation per message, build them into a single pooled buffer with RentedMessageBatchBuilder - see Publishing with rented batches."},"6719":{"id":"/docs/sdk/csharp/guide-184","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#partitioning-strategies","content":"Control which partition receives each message:"},"6720":{"id":"/docs/sdk/csharp/guide-185","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#partitioning-strategies","content":"Partition selection is resolved client-side on both transports. Balanced partitioning round-robins over the topic's partitions, and key-based routing hashes the key with xxHash32 modulo the partition count, consistent with the Rust SDK for the same encoded key bytes and partition count. Strings use UTF-8, integers use little-endian bytes, and GUID keys use Guid.ToByteArray()."},"6721":{"id":"/docs/sdk/csharp/guide-186","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#user-defined-headers","content":"Add typed custom headers to messages. Build keys with HeaderKey.FromString and values with the HeaderValue.From* factories:"},"6722":{"id":"/docs/sdk/csharp/guide-187","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#user-defined-headers","content":"Available value factories: FromString, FromBool, FromBytes, FromUInt8, FromInt32, FromInt64, FromInt128, FromUInt32, FromUInt64, FromUInt128, FromFloat, FromDouble, FromGuid."},"6723":{"id":"/docs/sdk/csharp/guide-188","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#fetching-messages","content":"A poll reads one explicit partition. Use a reader for several partitions or a consumer group assignment. PollOptions defaults to no wait and manual commits."},"6724":{"id":"/docs/sdk/csharp/guide-189","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#fetching-messages","content":"A checkpoint retains the partition history and owner. A commit after a partition recreation or ownership change is refused. polled.Continuation continues the same partition without losing that context."},"6725":{"id":"/docs/sdk/csharp/guide-190","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#fetching-messages","content":"CommitPolicy.OnRead submits the offset with the read, before application processing. CommitPolicy.Auto() is available to readers and consumers, but not a one-shot poll. The deferred polling guide explains limits and cancellation."},"6726":{"id":"/docs/sdk/csharp/guide-191","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#partition-reader","content":"TCP groups reads by primary. HTTP uses one poll per partition and supports standalone consumers only. A group reader joins and follows its assignment. ReadException reports the partition and any continuation that skips an undecodable record. A stopped partition needs an explicit seek before reading resumes."},"6727":{"id":"/docs/sdk/csharp/guide-192","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#polling-with-rented-buffers","content":"The rental API returns payload slices backed by a pooled buffer. Dispose each rental and copy any bytes that must outlive it. Do not retain a payload or raw-header reference after disposal. The high-level consumer exposes ReceiveRentedAsync for this path."},"6728":{"id":"/docs/sdk/csharp/guide-193","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#polling-strategies","content":"Control where consumption starts:"},"6729":{"id":"/docs/sdk/csharp/guide-194","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#offset-management","content":"Consumer offsets are keyed by consumer + stream + topic + partition. Note the argument order - the Consumer comes first:"},"6730":{"id":"/docs/sdk/csharp/guide-195","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#consumer-groups","content":"Consumer groups coordinate message consumption across multiple consumers, load-balancing partitions between members."},"6731":{"id":"/docs/sdk/csharp/guide-196","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#joining-and-leaving","content":"Note: Join/Leave are TCP-only and throw FeatureUnavailableException on HTTP."},"6732":{"id":"/docs/sdk/csharp/guide-197","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#system-operations","content":"PingAsync is more than a bare ping over TCP: it also re-syncs the assignment of every consumer group this client has joined, at the cost of one extra round trip per joined group. The client already pings on its own every HeartbeatInterval, so an explicit ping is only needed to force an assignment refresh sooner. GetCurrentAddress() is useful under leader redirection, when the client may have followed the cluster roster to a different node than the one it was configured with (see Connection semantics)."},"6733":{"id":"/docs/sdk/csharp/guide-198","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#option-catalog","content":"DescribeOptionsAsync enumerates the option keys a server accepts for a resource scope (OptionsScope.Topic, OptionsScope.Stream, or OptionsScope.User), with the kind, default, and description of each. This is the discovery surface for the topic options dictionary:"},"6734":{"id":"/docs/sdk/csharp/guide-199","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#raw-binary-requests","content":"SendBinaryRequestAsync is an escape hatch that sends a raw command code with a prebuilt payload and returns the raw response bytes, for commands the typed API does not cover:"},"6735":{"id":"/docs/sdk/csharp/guide-200","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#raw-binary-requests","content":"Session-control codes (login, logout, and the like) are rejected with an invalid-command error, and the operation is TCP-only: HTTP clients throw FeatureUnavailableException."},"6736":{"id":"/docs/sdk/csharp/guide-201","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#snapshots","content":"Capture a system snapshot as a compressed archive:"},"6737":{"id":"/docs/sdk/csharp/guide-202","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#snapshots","content":"Compression methods: Stored, Deflated, Bzip2, Zstd, Lzma, Xz. Snapshot types: FilesystemOverview, ProcessList, ResourceUsage, Test, ServerLogs, ServerConfig, All."},"6738":{"id":"/docs/sdk/csharp/guide-203","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#snapshots","content":"A full snapshot can exceed the default 64 MiB reply-frame bound, in which case the reply is refused and the connection dropped. Raise MaxResponseFrameSize before requesting large snapshots."},"6739":{"id":"/docs/sdk/csharp/guide-204","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#segment-management","content":"Delete up to N of the oldest sealed segments from a partition. The active segment is retained:"},"6740":{"id":"/docs/sdk/csharp/guide-205","page_id":"/docs/sdk/csharp/guide","tags":[],"type":"text","url":"/docs/sdk/csharp/guide#segment-management","content":"Note: TCP-only - throws FeatureUnavailableException on HTTP."},"6741":{"id":"/docs/sdk/csharp/high-level-sdk","page_id":"/docs/sdk/csharp/high-level-sdk","type":"page","content":"High-level SDK","breadcrumbs":["Documentation","SDK","C#"],"tags":[],"url":"/docs/sdk/csharp/high-level-sdk"},"6742":{"id":"/docs/sdk/csharp/high-level-sdk-0","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk","content":"IggyPublisher and IggyConsumer for C#, with background batching, retries and automatic offset commits."},"6743":{"id":"/docs/sdk/csharp/high-level-sdk-1","page_id":"/docs/sdk/csharp/high-level-sdk","type":"heading","tags":[],"url":"/docs/sdk/csharp/high-level-sdk#iggypublisher","content":"IggyPublisher"},"6744":{"id":"/docs/sdk/csharp/high-level-sdk-2","page_id":"/docs/sdk/csharp/high-level-sdk","type":"heading","tags":[],"url":"/docs/sdk/csharp/high-level-sdk#publisher-builder-options","content":"Publisher builder options"},"6745":{"id":"/docs/sdk/csharp/high-level-sdk-3","page_id":"/docs/sdk/csharp/high-level-sdk","type":"heading","tags":[],"url":"/docs/sdk/csharp/high-level-sdk#publishing-with-rented-batches","content":"Publishing with rented batches"},"6746":{"id":"/docs/sdk/csharp/high-level-sdk-4","page_id":"/docs/sdk/csharp/high-level-sdk","type":"heading","tags":[],"url":"/docs/sdk/csharp/high-level-sdk#typed-publisher","content":"Typed publisher"},"6747":{"id":"/docs/sdk/csharp/high-level-sdk-5","page_id":"/docs/sdk/csharp/high-level-sdk","type":"heading","tags":[],"url":"/docs/sdk/csharp/high-level-sdk#iggyconsumer","content":"IggyConsumer"},"6748":{"id":"/docs/sdk/csharp/high-level-sdk-6","page_id":"/docs/sdk/csharp/high-level-sdk","type":"heading","tags":[],"url":"/docs/sdk/csharp/high-level-sdk#consumer-groups","content":"Consumer groups"},"6749":{"id":"/docs/sdk/csharp/high-level-sdk-7","page_id":"/docs/sdk/csharp/high-level-sdk","type":"heading","tags":[],"url":"/docs/sdk/csharp/high-level-sdk#consumer-builder-options","content":"Consumer builder options"},"6750":{"id":"/docs/sdk/csharp/high-level-sdk-8","page_id":"/docs/sdk/csharp/high-level-sdk","type":"heading","tags":[],"url":"/docs/sdk/csharp/high-level-sdk#consuming-with-rented-buffers","content":"Consuming with rented buffers"},"6751":{"id":"/docs/sdk/csharp/high-level-sdk-9","page_id":"/docs/sdk/csharp/high-level-sdk","type":"heading","tags":[],"url":"/docs/sdk/csharp/high-level-sdk#typed-consumer","content":"Typed consumer"},"6752":{"id":"/docs/sdk/csharp/high-level-sdk-10","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk","content":"The per-call IIggyClient API is explicit but verbose - you manage partitioning, batching, retries, and offsets yourself. The high-level IggyPublisher and IggyConsumer wrap that surface with fluent builders that handle:"},"6753":{"id":"/docs/sdk/csharp/high-level-sdk-11","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk","content":"Background sending with buffering, batching, and retries"},"6754":{"id":"/docs/sdk/csharp/high-level-sdk-12","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk","content":"Automatic stream/topic/consumer-group creation"},"6755":{"id":"/docs/sdk/csharp/high-level-sdk-13","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk","content":"Automatic offset commits (on each poll, after each received message, or manual)"},"6756":{"id":"/docs/sdk/csharp/high-level-sdk-14","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk","content":"Consuming a topic as an async stream (IAsyncEnumerable)"},"6757":{"id":"/docs/sdk/csharp/high-level-sdk-15","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk","content":"Typed message (de)serialization"},"6758":{"id":"/docs/sdk/csharp/high-level-sdk-16","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk","content":"Sending and receiving over rented, pooled buffers to avoid separate payload copies on TCP"},"6759":{"id":"/docs/sdk/csharp/high-level-sdk-17","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk","content":"The fragments below reuse an authenticated client and the imports in the first example. The named streams/topics must already exist unless the snippet creates them. Both abstractions can be built from an existing connected client via IggyPublisherBuilder.Create(...) / IggyConsumerBuilder.Create(...), or equivalently via the client.CreatePublisherBuilder(...) / client.CreateConsumerBuilder(...) extension methods from Apache.Iggy.Extensions."},"6760":{"id":"/docs/sdk/csharp/high-level-sdk-18","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk#iggypublisher","content":"Configure a publisher, initialize it, then send. InitAsync validates (and optionally creates) the stream and topic:"},"6761":{"id":"/docs/sdk/csharp/high-level-sdk-19","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk#publisher-builder-options","content":"Method"},"6762":{"id":"/docs/sdk/csharp/high-level-sdk-20","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk#publisher-builder-options","content":"Description"},"6763":{"id":"/docs/sdk/csharp/high-level-sdk-21","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk#publisher-builder-options","content":"WithConnection(protocol, address, login, password, receiveBufferSize = null, sendBufferSize = null, reconnectionSettings = null)"},"6764":{"id":"/docs/sdk/csharp/high-level-sdk-22","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk#publisher-builder-options","content":"Connection settings - only used when the builder creates its own client (i.e. the Create(streamId, topicId) overload, without an existing client). A builder-created TCP client auto-logs in and reuses the credentials across reconnects. For HTTP, supply an explicitly authenticated client"},"6765":{"id":"/docs/sdk/csharp/high-level-sdk-23","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk#publisher-builder-options","content":"WithConnection(protocol, address, personalAccessToken, receiveBufferSize = null, sendBufferSize = null, reconnectionSettings = null)"},"6766":{"id":"/docs/sdk/csharp/high-level-sdk-24","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk#publisher-builder-options","content":"Same, authenticating with a personal access token instead of a username and password"},"6767":{"id":"/docs/sdk/csharp/high-level-sdk-25","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk#publisher-builder-options","content":"WithPartitioning(partitioning)"},"6768":{"id":"/docs/sdk/csharp/high-level-sdk-26","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk#publisher-builder-options","content":"Routing strategy for produced messages (default: balanced)"},"6769":{"id":"/docs/sdk/csharp/high-level-sdk-27","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk#publisher-builder-options","content":"CreateStreamIfNotExists(name)"},"6770":{"id":"/docs/sdk/csharp/high-level-sdk-28","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk#publisher-builder-options","content":"Auto-create the stream on InitAsync if missing"},"6771":{"id":"/docs/sdk/csharp/high-level-sdk-29","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk#publisher-builder-options","content":"CreateTopicIfNotExists(name, topicPartitionsCount = 1, compressionAlgorithm = None, messageExpiry = TimeSpan.Zero, maxTopicSize = 0)"},"6772":{"id":"/docs/sdk/csharp/high-level-sdk-30","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk#publisher-builder-options","content":"Auto-create the topic on InitAsync if missing"},"6773":{"id":"/docs/sdk/csharp/high-level-sdk-31","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk#publisher-builder-options","content":"WithRetry(enabled = true, maxAttempts = 3, initialDelay = 100ms, maxDelay = 10s, backoffMultiplier = 2.0)"},"6774":{"id":"/docs/sdk/csharp/high-level-sdk-32","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk#publisher-builder-options","content":"Retry background sends with exponential backoff. Direct sends surface errors"},"6775":{"id":"/docs/sdk/csharp/high-level-sdk-33","page_id":"/docs/sdk/csharp/high-level-sdk","tags":[],"type":"text","url":"/docs/sdk/csharp/high-level-sdk#publisher-builder-options","content":"WithBackgroundSending(enabled = true, queueCapacity = 10000, batchSize = 100, fl