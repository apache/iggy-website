s/server/schema-70","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema","content":"The binary format is more compact and efficient, but it is not human-readable - it's being used by TCP and QUIC transports. The JSON format is used by HTTP transport - all the existing endpoints are available in the server.http."},"1192":{"id":"/docs/server/schema-71","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema","content":"All multi-byte integer fields use little-endian encoding throughout."},"1193":{"id":"/docs/server/schema-72","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#request-schema","content":"All the requests are represented as a binary message. The message consists of 3 parts: length, code and payload:"},"1194":{"id":"/docs/server/schema-73","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#request-schema","content":"length - 4-byte integer (u32) which represents the total length: code (4 bytes) + payload (N bytes)"},"1195":{"id":"/docs/server/schema-74","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#request-schema","content":"code - 4-byte integer (u32) which represents the request code"},"1196":{"id":"/docs/server/schema-75","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#request-schema","content":"payload - binary data of N bytes length"},"1197":{"id":"/docs/server/schema-76","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#request-schema","content":"For example, if the payload is 100 bytes, the length will have a value of 104 (100 bytes for payload + 4 const bytes for the code). The message as whole will have 108 (4 + 4 + 100) bytes size."},"1198":{"id":"/docs/server/schema-77","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#response-schema","content":"All the responses are represented as a binary message. The message consists of 3 parts: status, length and payload:"},"1199":{"id":"/docs/server/schema-78","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#response-schema","content":"status - 4-byte integer (u32) which represents the status code. The status code is 0 for success and any other value for an error."},"1200":{"id":"/docs/server/schema-79","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#response-schema","content":"length - 4-byte integer (u32) which represents the total length: status (4 bytes) + payload (N bytes)"},"1201":{"id":"/docs/server/schema-80","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#response-schema","content":"payload - binary data of N bytes length"},"1202":{"id":"/docs/server/schema-81","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#response-schema","content":"In case of errors, the length will be always equal to 0 and the payload will be empty."},"1203":{"id":"/docs/server/schema-82","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#response-schema","content":"When trying to fetch the resource which may not exist, such as a stream, topic, user etc., the response will have a status code 0 (OK), but the payload will be empty, as there's no data to return."},"1204":{"id":"/docs/server/schema-83","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#identifier","content":"The Identifier is a struct which represents the identifier of a stream, topic, user, or consumer group. It consists of the kind (numeric or string), length (length of the identifier value) and value (actual value of the identifier). The value is a vector of bytes, which can be either a numeric value (e.g. 1 encoded as const 4 bytes for u32 type) or a string (e.g. \"my-stream\") with variable length of UTF-8 string, maximum 255 bytes (chars)."},"1205":{"id":"/docs/server/schema-84","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#identifier","content":"Serialization"},"1206":{"id":"/docs/server/schema-85","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#identifier","content":"kind - 1 byte"},"1207":{"id":"/docs/server/schema-86","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#identifier","content":"length - 1 byte"},"1208":{"id":"/docs/server/schema-87","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#identifier","content":"value - N bytes (4 bytes for numeric, 1-255 bytes for string)"},"1209":{"id":"/docs/server/schema-88","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#consumer","content":"The Consumer represents the type of the consumer. It can be either a consumer or a consumer group. This type is used when interacting with the messages related commands such as PollMessages, GetConsumerOffset, StoreConsumerOffset and DeleteConsumerOffset."},"1210":{"id":"/docs/server/schema-89","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#consumer","content":"Serialization"},"1211":{"id":"/docs/server/schema-90","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#consumer","content":"kind - 1 byte"},"1212":{"id":"/docs/server/schema-91","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#consumer","content":"id - variable (Identifier: 2 + N bytes)"},"1213":{"id":"/docs/server/schema-92","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#iggymessage","content":"Each message consists of a fixed 64-byte header followed by optional user headers and the payload."},"1214":{"id":"/docs/server/schema-93","page_id":"/docs/server/schema","tags":[],"type":"text","url":"/docs/server/schema#iggymessage","content":"Serialization (64-byte header + variable