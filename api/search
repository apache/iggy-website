-33","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"max_open_retries"},"4923":{"id":"/docs/connectors/sinks/quickwit-34","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"10"},"4924":{"id":"/docs/connectors/sinks/quickwit-35","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Total attempts per readiness check including the first; 0 and 1 both allow one attempt"},"4925":{"id":"/docs/connectors/sinks/quickwit-36","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"open_retry_max_delay"},"4926":{"id":"/docs/connectors/sinks/quickwit-37","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"\"30s\""},"4927":{"id":"/docs/connectors/sinks/quickwit-38","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Cap for calculated readiness retry delays"},"4928":{"id":"/docs/connectors/sinks/quickwit-39","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"timeout"},"4929":{"id":"/docs/connectors/sinks/quickwit-40","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"\"30s\""},"4930":{"id":"/docs/connectors/sinks/quickwit-41","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Timeout per HTTP attempt; retries and their waits can make an operation take longer"},"4931":{"id":"/docs/connectors/sinks/quickwit-42","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Durations require units and must be positive; invalid or zero durations prevent startup. Unknown plugin keys are rejected. There is no plugin batch_size option: batch_length limits the polled batch, and the sink splits it by serialized byte size without accumulating across polls."},"4932":{"id":"/docs/connectors/sinks/quickwit-43","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"Readiness uses GET /health/readyz, retrying any failed probe. The index check uses GET /api/v1/indexes/<index_id>; only a 404 triggers creation with POST /api/v1/indexes. If creation receives an error status, a successful index recheck allows startup to continue. A successful existence check does not validate the supplied mapping against the existing one. Requests retain any path prefix from url."},"4933":{"id":"/docs/connectors/sinks/quickwit-44","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#plugin-config-options","content":"After verifying or creating the index, the sink probes the ingest endpoint with an empty body before accepting messages. This waits for the queue on Quickwit versions that return 404 while it starts. These probes submit no documents and retry HTTP 404, 429, 5xx and network failures. Each readiness check uses max_open_retries and open_retry_max_delay."},"4934":{"id":"/docs/connectors/sinks/quickwit-45","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"The sink does not add Iggy IDs, offsets, timestamps or headers. It serializes the payload after runtime decoding and transforms:"},"4935":{"id":"/docs/connectors/sinks/quickwit-46","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"Payload"},"4936":{"id":"/docs/connectors/sinks/quickwit-47","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"Document sent to Quickwit"},"4937":{"id":"/docs/connectors/sinks/quickwit-48","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"JSON object, or a JSON object parsed from raw bytes"},"4938":{"id":"/docs/connectors/sinks/quickwit-49","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"The object itself"},"4939":{"id":"/docs/connectors/sinks/quickwit-50","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"JSON array or scalar"},"4940":{"id":"/docs/connectors/sinks/quickwit-51","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"{\"data\":[1,2],\"data_type\":\"json\"} or {\"data\":42,\"data_type\":\"json\"}"},"4941":{"id":"/docs/connectors/sinks/quickwit-52","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"Other raw UTF-8"},"4942":{"id":"/docs/connectors/sinks/quickwit-53","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"{\"data\":\"hello\",\"data_type\":\"raw\",\"data_encoding\":\"utf8\"}"},"4943":{"id":"/docs/connectors/sinks/quickwit-54","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"Raw non-UTF-8 bytes"},"4944":{"id":"/docs/connectors/sinks/quickwit-55","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"Base64 under data, with data_type = \"raw\" and data_encoding = \"base64\""},"4945":{"id":"/docs/connectors/sinks/quickwit-56","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"Text"},"4946":{"id":"/docs/connectors/sinks/quickwit-57","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"{\"text\":\"hello\",\"data_type\":\"text\"}"},"4947":{"id":"/docs/connectors/sinks/quickwit-58","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"Raw arrays, scalars and malformed JSON retain their original bytes in the raw wrapper. Avro and FlatBuffer payload variants use that raw path; Proto uses the text wrapper. Which variant arrives depends on the runtime decoder and transforms."},"4948":{"id":"/docs/connectors/sinks/quickwit-59","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#payload-shapes","content":"The strict mapping above accepts only mapped fields and requires timestamp. To use wrapper documents, map their fields or use mode: dynamic, and remove timestamp_field and its dependent retention section unless every document supplies a timestamp. The add_fields transform enriches JSON objects; it does not add timestamps to raw/text wrappers created later by this sink."},"4949":{"id":"/docs/connectors/sinks/quickwit-60","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#delivery-semantics","content":"The sink calls POST /api/v1/<index_id>/ingest?commit=auto. HTTP success means submission for indexing, not search visibility or acceptance of every document. The sink checks the status and does not inspect per-document rejection counts in the response. See the Quickwit ingest API."},"4950":{"id":"/docs/connectors/sinks/quickwit-61","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#delivery-semantics","content":"HTTP 429, 5xx and network failures can retry. Calculated waits use exponential backoff with jitter and the configured cap; a valid Retry-After on 429 replaces that wait. Other HTTP statuses stop that request's retry loop. Readiness has its separate attempt budget. There is no circuit breaker or sink deduplication key, so retrying an accepted request can produce duplicates. max_retries = 1 disables the sink's HTTP retry loop."},"4951":{"id":"/docs/connectors/sinks/quickwit-62","page_id":"/docs/connectors/sinks/quickwit","tags":[],"type":"text","url":"/docs/connectors/sinks/quickwit#delivery-semantics","content":"An individual serialized document exceeding 8 MiB, including its newline, is logged and skipped. Other documents and later chunks are still attempted, and the last error is returned. Successful chunks are not rolled back. The runtime logs/counts plugin callback errors and continues without replaying the failed batch; it auto-commits while polling. A failed callback can therefore coexist with stored documents, and a successful callback can include documents rejected by Quickwit. Runtime processed counts do not prove successful indexing. The sink provides no end-to-end at-least-once guarantee."},"4952":{"id":"/docs/connectors/sinks/s3","page_id":"/docs/connectors/sinks/s3","type":"page","content":"S3 Sink","breadcrumbs":["Documentation","Connectors","Sinks"],"tags":[],"url":"/docs/connectors/sinks/s3"},"4953":{"id":"/docs/connectors/sinks/s3-0","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3","content":"Write messages from Iggy streams to Amazon S3 and S3-compatible object stores such as MinIO, R2, Spaces and B2."},"4954":{"id":"/docs/connectors/sinks/s3-1","page_id":"/docs/connectors/sinks/s3","type":"heading","tags":[],"url":"/docs/connectors/sinks/s3#configuration","content":"Configuration"},"4955":{"id":"/docs/connectors/sinks/s3-2","page_id":"/docs/connectors/sinks/s3","type":"heading","tags":[],"url":"/docs/connectors/sinks/s3#common-options","content":"Common Options"},"4956":{"id":"/docs/connectors/sinks/s3-3","page_id":"/docs/connectors/sinks/s3","type":"heading","tags":[],"url":"/docs/connectors/sinks/s3#credentials","content":"Credentials"},"4957":{"id":"/docs/connectors/sinks/s3-4","page_id":"/docs/connectors/sinks/s3","type":"heading","tags":[],"url":"/docs/connectors/sinks/s3#minio-example","content":"MinIO example"},"4958":{"id":"/docs/connectors/sinks/s3-5","page_id":"/docs/connectors/sinks/s3","type":"heading","tags":[],"url":"/docs/connectors/sinks/s3#output-formats","content":"Output Formats"},"4959":{"id":"/docs/connectors/sinks/s3-6","page_id":"/docs/connectors/sinks/s3","type":"heading","tags":[],"url":"/docs/connectors/sinks/s3#delivery-semantics","content":"Delivery Semantics"},"4960":{"id":"/docs/connectors/sinks/s3-7","page_id":"/docs/connectors/sinks/s3","type":"heading","tags":[],"url":"/docs/connectors/sinks/s3#transforms","content":"Transforms"},"4961":{"id":"/docs/connectors/sinks/s3-8","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3","content":"The S3 sink connector writes messages from Iggy streams to Amazon S3 and S3-compatible object stores (MinIO, Cloudflare R2, DigitalOcean Spaces, Backblaze B2). Messages are buffered in memory and uploaded as files, rotated by size or message count, under configurable path templates with offset ranges in the object names."},"4962":{"id":"/docs/connectors/sinks/s3-9","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3","content":"This page is a curated subset of the documentation. The canonical reference is the upstream s3_sink README in the apache/iggy repository."},"4963":{"id":"/docs/connectors/sinks/s3-10","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#configuration","content":"Use the broker credentials and runtime setup from the sink guide. From the matching 0.9.0/edge Iggy checkout root, build the plugin:"},"4964":{"id":"/docs/connectors/sinks/s3-11","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#configuration","content":"Create the bucket separately, then save this connector file in the runtime's connector directory. The plugin does not create buckets. Paths below assume the runtime starts from the checkout root."},"4965":{"id":"/docs/connectors/sinks/s3-12","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"Option"},"4966":{"id":"/docs/connectors/sinks/s3-13","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"Type"},"4967":{"id":"/docs/connectors/sinks/s3-14","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"Default"},"4968":{"id":"/docs/connectors/sinks/s3-15","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"Description"},"4969":{"id":"/docs/connectors/sinks/s3-16","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"bucket"},"4970":{"id":"/docs/connectors/sinks/s3-17","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"string"},"4971":{"id":"/docs/connectors/sinks/s3-18","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-options","content":"required"},"4972":{"id":"/docs/connectors/sinks/s3-19","page_id":"/docs/connectors/sinks/s3","tags":[],"type":"text","url":"/docs/connectors/sinks/s3#common-optio